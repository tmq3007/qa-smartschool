<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vỏ kính tròn tối sang trọng -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#F00F172A"
                android:endColor="#F01E293B" />
            <stroke
                android:width="1.8dp"
                android:color="#9993C5FD" />
        </shape>
    </item>

    <!-- Vòng đồng tâm ngoài chuẩn iOS AssistiveTouch -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#22FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>

    <!-- Vòng đồng tâm giữa -->
    <item
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#38FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#88FFFFFF" />
        </shape>
    </item>

    <!-- Nhân sáng trung tâm -->
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFE0E7FF" />
        </shape>
    </item>
</layer-list>

