<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vỏ kính tròn sáng ngọc trai Sky-Indigo hiện đại (Không dùng theme đen) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#F238BDF8"
                android:centerColor="#F23B82F6"
                android:endColor="#F26366F1" />
            <stroke
                android:width="2dp"
                android:color="#EEFFFFFF" />
        </shape>
    </item>

    <!-- Vòng đồng tâm ngoài pha lê sáng -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#2BFFFFFF" />
            <stroke
                android:width="1.3dp"
                android:color="#88FFFFFF" />
        </shape>
    </item>

    <!-- Vòng đồng tâm giữa ngọc trai -->
    <item
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#48FFFFFF" />
            <stroke
                android:width="1.3dp"
                android:color="#BBFFFFFF" />
        </shape>
    </item>

    <!-- Nhân sáng trắng trung tâm -->
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFEEF2FF" />
        </shape>
    </item>
</layer-list>
