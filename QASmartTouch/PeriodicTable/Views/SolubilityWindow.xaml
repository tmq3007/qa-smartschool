<Window FontFamily="Segoe UI" x:Class="QASmartTouch.PeriodicTable.Views.SolubilityWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:vm="clr-namespace:QASmartTouch.PeriodicTable.ViewModels"

        xmlns:conv="clr-namespace:QASmartTouch.PeriodicTable.Converters"

        Title="Bảng tính tan - Tra cứu tính tan của muối và bazơ" 

        Height="700" Width="1200"

        WindowStartupLocation="CenterScreen"

        Background="#F5F5F5">



    <Window.DataContext>

        <vm:SolubilityViewModel/>

    </Window.DataContext>



    <Window.Resources>

        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Style cho header -->

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Foreground" Value="#333333"/>

            <Setter Property="Margin" Value="0,0,0,10"/>

        </Style>



        <!-- Style cho label -->

        <Style x:Key="LabelStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Foreground" Value="#555555"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Margin" Value="0,0,10,0"/>

        </Style>



        <!-- Style cho button -->

        <Style x:Key="ButtonStyle" TargetType="Button">

            <Setter Property="Padding" Value="15,8"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Background" Value="#2196F3"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                                CornerRadius="4" 

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#1976D2"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>



    <Grid Margin="15">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="BẢNG TÍNH TAN" 

                       FontSize="24" 

                       FontWeight="Bold" 

                       Foreground="#1976D2"

                       HorizontalAlignment="Center"/>

            <TextBlock Text="Tra cứu tính tan của 238 muối vô cơ" 

                       FontSize="14" 

                       Foreground="#666666"

                       HorizontalAlignment="Center"

                       Margin="0,5,0,0"/>

        </StackPanel>



        <!-- Filter Panel -->

        <Border Grid.Row="1" 

                Background="White" 

                CornerRadius="8" 

                Padding="15" 

                Margin="0,0,0,15"

                BorderBrush="#E0E0E0" 

                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Search box -->

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

                    <TextBlock Text="🔍 Tìm kiếm:" Style="{StaticResource LabelStyle}"/>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 

                             Width="300" 

                             Height="30" 

                             VerticalContentAlignment="Center"

                             Padding="8,0"

                             FontSize="12"/>

                    <TextBlock Text="(Tìm theo công thức, tên, ghi chú)" 

                               FontSize="11" 

                               Foreground="#999999" 

                               VerticalAlignment="Center"

                               Margin="10,0,0,0"/>

                </StackPanel>



                <!-- Filters -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="200"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="200"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="150"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <TextBlock Grid.Column="0" Text="Cation:" Style="{StaticResource LabelStyle}"/>

                    <ComboBox Grid.Column="1" 

                              ItemsSource="{Binding CationsList}" 

                              SelectedItem="{Binding SelectedCationFilter}"

                              Height="30"

                              VerticalContentAlignment="Center"

                              FontSize="12"

                              Margin="0,0,15,0"/>



                    <TextBlock Grid.Column="2" Text="Anion:" Style="{StaticResource LabelStyle}"/>

                    <ComboBox Grid.Column="3" 

                              ItemsSource="{Binding AnionsList}" 

                              SelectedItem="{Binding SelectedAnionFilter}"

                              Height="30"

                              VerticalContentAlignment="Center"

                              FontSize="12"

                              Margin="0,0,15,0"/>



                    <TextBlock Grid.Column="4" Text="Trạng thái:" Style="{StaticResource LabelStyle}"/>

                    <ComboBox Grid.Column="5" 

                              ItemsSource="{Binding StatusList}" 

                              SelectedItem="{Binding SelectedStatusFilter}"

                              Height="30"

                              VerticalContentAlignment="Center"

                              FontSize="12"

                              Margin="0,0,15,0"/>



                    <!-- Nút Quy tắc tan, Mô phỏng và Xóa bộ lọc -->

                    <StackPanel Grid.Column="7" Orientation="Horizontal">

                        <Button Content="💡 Quy tắc tan" 

                                Command="{Binding OpenRulesCommand}"

                                Background="#9C27B0"

                                Foreground="White"

                                FontWeight="Bold"

                                Padding="12,6"

                                Margin="0,0,8,0"

                                Cursor="Hand">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}" 

                                                        CornerRadius="4" 

                                                        Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="Background" Value="#7B1FA2"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                        </Button>



                        <Button Content="🧪 Mô phỏng Thí nghiệm kết tủa" 

                                Command="{Binding OpenSimulationCommand}"

                                Background="#FF5722"

                                Foreground="White"

                                FontWeight="Bold"

                                Padding="12,6"

                                Margin="0,0,8,0"

                                Cursor="Hand"

                                ToolTip="Mô phỏng với hiệu ứng particles rơi từ từ (Phương án 2 - Advanced Physics)">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}" 

                                                        CornerRadius="4" 

                                                        Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="Background" Value="#E64A19"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                        </Button>

                        

                        <Button Content="Xóa bộ lọc" 

                                Command="{Binding ClearFiltersCommand}"

                                Style="{StaticResource ButtonStyle}"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>



        <!-- Main Content -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="10"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- DataGrid -->

            <Border Grid.Column="0" 

                    Background="White" 

                    CornerRadius="8" 

                    BorderBrush="#E0E0E0" 

                    BorderThickness="1">

                <DataGrid ItemsSource="{Binding FilteredSalts}" 

                          SelectedItem="{Binding SelectedSalt}"

                          AutoGenerateColumns="False" 

                          IsReadOnly="True"

                          GridLinesVisibility="Horizontal"

                          HeadersVisibility="Column"

                          SelectionMode="Single"

                          CanUserResizeColumns="True"

                          CanUserSortColumns="True"

                          AlternatingRowBackground="#F9F9F9"

                          RowHeight="35"

                          FontSize="12"

                          Margin="10">

                    

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Cation" Binding="{Binding Cation}" Width="70"/>

                        <DataGridTextColumn Header="Anion" Binding="{Binding Anion}" Width="70"/>

                        <DataGridTextColumn Header="Công thức" Binding="{Binding SaltFormula}" Width="100" FontWeight="SemiBold"/>

                        <DataGridTextColumn Header="Tên muối" Binding="{Binding SaltName}" Width="150"/>

                        

                        <!-- Trạng thái với màu sắc -->

                        <DataGridTemplateColumn Header="Tính tan" Width="100">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border Background="{Binding Color}" 

                                            CornerRadius="4" 

                                            Padding="6,3"

                                            Margin="2">

                                        <TextBlock Text="{Binding SolubilityValue}" 

                                                   Foreground="White"

                                                   FontWeight="SemiBold"

                                                   HorizontalAlignment="Center"

                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        

                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/>

                    </DataGrid.Columns>



                    <DataGrid.ColumnHeaderStyle>

                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background" Value="#1976D2"/>

                            <Setter Property="Foreground" Value="White"/>

                            <Setter Property="FontWeight" Value="Bold"/>

                            <Setter Property="FontSize" Value="13"/>

                            <Setter Property="Padding" Value="10,8"/>

                            <Setter Property="HorizontalContentAlignment" Value="Center"/>

                        </Style>

                    </DataGrid.ColumnHeaderStyle>

                </DataGrid>

            </Border>



            <!-- Detail Panel -->

            <Border Grid.Column="2" 

                    Background="White" 

                    CornerRadius="8" 

                    Padding="15" 

                    BorderBrush="#E0E0E0" 

                    BorderThickness="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="CHI TIẾT MUỐI" Style="{StaticResource HeaderTextStyle}"/>



                        <StackPanel DataContext="{Binding SelectedSalt}">

                            <!-- Hiển thị khi có muối được chọn -->

                            <StackPanel Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">

                                

                                <!-- Công thức -->

                                <TextBlock Text="Công thức hóa học:" 

                                           FontWeight="SemiBold" 

                                           FontSize="11" 

                                           Foreground="#666666"

                                           Margin="0,10,0,5"/>

                                <TextBlock Text="{Binding SaltFormula}" 

                                           FontSize="20" 

                                           FontWeight="Bold" 

                                           Foreground="#1976D2"/>



                                <!-- Tên -->

                                <TextBlock Text="Tên muối:" 

                                           FontWeight="SemiBold" 

                                           FontSize="11" 

                                           Foreground="#666666"

                                           Margin="0,15,0,5"/>

                                <TextBlock Text="{Binding SaltName}" 

                                           FontSize="14"/>



                                <!-- Ion -->

                                <TextBlock Text="Thành phần ion:" 

                                           FontWeight="SemiBold" 

                                           FontSize="11" 

                                           Foreground="#666666"

                                           Margin="0,15,0,5"/>

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding Cation}" 

                                               FontSize="16" 

                                               FontWeight="SemiBold"

                                               Margin="0,0,10,0"/>

                                    <TextBlock Text="+" 

                                               FontSize="16" 

                                               Foreground="#999999"

                                               Margin="0,0,10,0"/>

                                    <TextBlock Text="{Binding Anion}" 

                                               FontSize="16" 

                                               FontWeight="SemiBold"/>

                                </StackPanel>



                                <!-- Tính tan -->

                                <TextBlock Text="Tính tan:" 

                                           FontWeight="SemiBold" 

                                           FontSize="11" 

                                           Foreground="#666666"

                                           Margin="0,15,0,5"/>

                                <Border Background="{Binding Color}" 

                                        CornerRadius="6" 

                                        Padding="10,8"

                                        HorizontalAlignment="Left">

                                    <TextBlock Text="{Binding SolubilityValue}" 

                                               Foreground="White"

                                               FontWeight="Bold"

                                               FontSize="14"/>

                                </Border>



                                <!-- Ghi chú -->

                                <TextBlock Text="Ghi chú:" 

                                           FontWeight="SemiBold" 

                                           FontSize="11" 

                                           Foreground="#666666"

                                           Margin="0,15,0,5"/>

                                <TextBlock Text="{Binding Note}" 

                                           FontSize="12" 

                                           TextWrapping="Wrap"

                                           LineHeight="20"/>



                                <!-- Chú thích màu -->

                                <Border Background="#F5F5F5" 

                                        CornerRadius="6" 

                                        Padding="10" 

                                        Margin="0,20,0,0">

                                    <StackPanel>

                                        <TextBlock Text="Chú thích màu sắc:" 

                                                   FontWeight="SemiBold" 

                                                   FontSize="11"

                                                   Margin="0,0,0,8"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,3">

                                            <Border Background="#4CAF50" Width="20" Height="20" CornerRadius="3" Margin="0,0,8,0"/>

                                            <TextBlock Text="Tan" FontSize="11"/>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,3">

                                            <Border Background="#FFC107" Width="20" Height="20" CornerRadius="3" Margin="0,0,8,0"/>

                                            <TextBlock Text="Ít tan" FontSize="11"/>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,3">

                                            <Border Background="#F44336" Width="20" Height="20" CornerRadius="3" Margin="0,0,8,0"/>

                                            <TextBlock Text="Không tan" FontSize="11"/>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,3">

                                            <Border Background="#9C27B0" Width="20" Height="20" CornerRadius="3" Margin="0,0,8,0"/>

                                            <TextBlock Text="Phản ứng" FontSize="11"/>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,3">

                                            <Border Background="#9E9E9E" Width="20" Height="20" CornerRadius="3" Margin="0,0,8,0"/>

                                            <TextBlock Text="Không tồn tại" FontSize="11"/>

                                        </StackPanel>

                                    </StackPanel>

                                </Border>

                            </StackPanel>



                            <!-- Hiển thị khi chưa chọn muối -->

                            <TextBlock Text="Chọn một muối từ danh sách để xem chi tiết" 

                                       FontSize="12" 

                                       Foreground="#999999"

                                       TextWrapping="Wrap"

                                       Margin="0,50,0,0"

                                       HorizontalAlignment="Center"

                                       TextAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                                <Setter Property="Visibility" Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>



        <!-- Footer with statistics -->

        <Border Grid.Row="3" 

                Background="White" 

                CornerRadius="8" 

                Padding="15" 

                Margin="0,15,0,0"

                BorderBrush="#E0E0E0" 

                BorderThickness="1">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBlock FontSize="12" Foreground="#666666">

                    <Run Text="Tổng số muối:"/>

                    <Run Text="{Binding Salts.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#1976D2"/>

                    <Run Text=" | Kết quả lọc:"/>

                    <Run Text="{Binding FilteredSalts.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#4CAF50"/>

                    <Run Text=" | Cation:"/>

                    <Run Text="{Binding Data.Metadata.TotalCations, Mode=OneWay}" FontWeight="Bold"/>

                    <Run Text=" | Anion:"/>

                    <Run Text="{Binding Data.Metadata.TotalAnions, Mode=OneWay}" FontWeight="Bold"/>

                </TextBlock>

            </StackPanel>

        </Border>

    </Grid>

</Window>





