                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <UniformGrid Columns="3" HorizontalAlignment="Stretch"/>

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border CornerRadius="12" 

                                                            Padding="20,25"

                                                            Margin="5"

                                                            Background="White"

                                                            BorderBrush="#E5E7EB"

                                                            BorderThickness="1">

                                                        <StackPanel>

                                                            <TextBlock Text="{Binding Icon}" 

                                                                       FontSize="36" 

                                                                       HorizontalAlignment="Center" 

                                                                       Margin="0,0,0,10"/>

                                                            <TextBlock Text="{Binding Name}" 

                                                                       FontSize="16" 

                                                                       FontWeight="Bold" 

                                                                       Foreground="#1F2937"

                                                                       TextAlignment="Center"

                                                                       Margin="0,0,0,8"

                                                                       TextWrapping="Wrap"/>

                                                            <TextBlock Text="{Binding Description}"

                                                                       FontSize="13"

                                                                       Foreground="#6B7280"

                                                                       TextWrapping="Wrap"

                                                                       TextAlignment="Center"

                                                                       LineHeight="18"/>

                                                        </StackPanel>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>



                        <!-- B. Global Production Stats -->

                        <TextBlock Text="📊 Thống kê sản xuất toàn cầu" 

                                   Style="{StaticResource SectionTitleStyle}"

                                   Margin="0,10,0,15"/>

                        

                        <Border Background="White" 

                                CornerRadius="12" 

                                BorderThickness="1"

                                BorderBrush="#E0E0E0"

                                Padding="30"

                                Margin="0,0,0,30">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>



                                <!-- Annual Production -->

                                <StackPanel Grid.Row="0" Margin="0,0,0,20">

                                    <TextBlock Text="Sản lượng hàng năm:" 

                                               FontSize="14" 

                                               Foreground="#6B7280"

                                               Margin="0,0,0,8"/>

                                    <TextBlock FontSize="32" 

                                               FontWeight="Bold" 

                                               Foreground="#667EEA">

                                        <Run Text="{Binding CurrentElement.ProductionStats.AnnualProduction, StringFormat={}{0:N0}}"/>

                                        <Run Text=" " FontSize="18"/>

                                        <Run Text="{Binding CurrentElement.ProductionStats.AnnualProductionUnit}" FontSize="18"/>

                                    </TextBlock>

                                </StackPanel>



                                <!-- Top Producers -->

                                <StackPanel Grid.Row="1" Margin="0,0,0,20">

                                    <TextBlock Text="Quốc gia sản xuất lớn nhất:" 

                                               FontSize="14" 

                                               Foreground="#6B7280"

                                               Margin="0,0,0,12"/>

                                    <ItemsControl ItemsSource="{Binding CurrentElement.ProductionStats.TopProducers}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Grid Margin="0,0,0,8">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="150"/>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="60"/>

                                                    </Grid.ColumnDefinitions>



                                                    <TextBlock Grid.Column="0" 

                                                               Text="{Binding Country}" 

                                                               FontSize="14" 

                                                               FontWeight="SemiBold"

                                                               Foreground="#374151"

                                                               VerticalAlignment="Center"/>



                                                    <Grid Grid.Column="1" VerticalAlignment="Center">

                                                        <Border Background="#F3F4F6" 

                                                                Height="20" 

                                                                CornerRadius="4"/>

                                                        <Border Background="#667EEA" 

                                                                Height="20" 

                                                                CornerRadius="4"

                                                                HorizontalAlignment="Left"

                                                                Width="{Binding Percentage, Converter={StaticResource MultiplierToWidthConverter}, ConverterParameter=3}"/>

                                                    </Grid>



                                                    <TextBlock Grid.Column="2" 

                                                               FontSize="14" 

                                                               FontWeight="Bold"

                                                               Foreground="#667EEA"

                                                               HorizontalAlignment="Right"

                                                               VerticalAlignment="Center">

                                                        <Run Text="{Binding Percentage, StringFormat={}{0:F0}}"/>

                                                        <Run Text="%"/>

                                                    </TextBlock>

                                                </Grid>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>



                                <!-- Market Price -->

                                <Border Grid.Row="2" 

                                        Background="#F0F9FF" 

                                        CornerRadius="8" 

                                        Padding="15">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <TextBlock Text="💰 Giá thị trường: " 

                                                   FontSize="14" 

                                                   Foreground="#0369A1"

                                                   FontWeight="SemiBold"

                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding CurrentElement.ProductionStats.MarketPrice}" 

                                                   FontSize="18" 

                                                   FontWeight="Bold"

                                                   Foreground="#0284C7"

                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>



                        <!-- C. Future Trends -->

                        <TextBlock Text="🔮 Xu hướng tương lai" 

                                   Style="{StaticResource SectionTitleStyle}"

                                   Margin="0,0,0,15"/>

                        

                        <Border Background="#FEF7E0" 

                                BorderBrush="#F59E0B"

                                BorderThickness="1"

                                CornerRadius="12" 

                                Padding="25"

                                Margin="0,0,0,30">

                            <ItemsControl ItemsSource="{Binding CurrentElement.FutureTrends}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                            <TextBlock Text="• " 

                                                       FontSize="18" 

                                                       Foreground="#92400E"

                                                       FontWeight="Bold"

                                                       Margin="0,0,8,0"/>

                                            <TextBlock Text="{Binding}" 

                                                       FontSize="15" 

                                                       Foreground="#78350F"

                                                       TextWrapping="Wrap"

                                                       LineHeight="22"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Border>



                        <!-- Importance Description Box -->

                        <Border Background="#EEF2FF" 

                                BorderBrush="#818CF8" 

                                BorderThickness="2"

                                CornerRadius="16" 

                                Padding="30,25"

                                Margin="0,10,0,0">

                            <Border.Effect>

                                <DropShadowEffect Color="#D1D5DB" 

                                                  BlurRadius="15" 

                                                  ShadowDepth="2" 

                                                  Opacity="0.3"/>

                            </Border.Effect>

                            <StackPanel>

                                <TextBlock FontSize="20" 

                                           FontWeight="Bold" 

                                           Foreground="#4338CA"

                                           Margin="0,0,0,15">

                                    <Run Text="⚡"/>

                                    <Run Text="{Binding CurrentElement.ImportanceTitle, FallbackValue='Tầm quan trọng'}"/>

                                </TextBlock>

                                <TextBlock Text="{Binding CurrentElement.ImportanceDescription}" 

                                           FontSize="15" 

                                           Foreground="#374151"

                                           TextWrapping="Wrap"

                                           LineHeight="24"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

          

            <!-- TAB 6: LỊCH SỬ -->

            <TabItem>

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="📜" FontSize="18" Margin="0,0,8,0"/>

                        <TextBlock Text="Lịch sử" Style="{StaticResource TabHeaderStyle}"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,35" Background="White">

                    <StackPanel>

                        <TextBlock Text="📜 Lịch sử khám phá" Style="{StaticResource SectionTitleStyle}"/>



                        <!-- Timeline Events -->

                        <ItemsControl ItemsSource="{Binding CurrentElement.HistoryEvents}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="0,0,0,30">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="80"/>

                                            <ColumnDefinition Width="40"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>



                                        <!-- Year -->

                                        <TextBlock Grid.Column="0" 

                                                   Text="{Binding Year}" 

                                                   FontSize="20" 

                                                   FontWeight="Bold"

                                                   Foreground="#3B82F6"

                                                   VerticalAlignment="Top"

                                                   Margin="0,5,0,0"/>



                                        <!-- Timeline Circle and Line -->

                                        <Canvas Grid.Column="1" Width="40" HorizontalAlignment="Center">

                                            <!-- Vertical Line -->

                                            <Rectangle Canvas.Left="18" 

                                                       Canvas.Top="0"

                                                       Width="4" 

                                                       Height="1000"

                                                       Fill="#E5E7EB"/>

                                            

                                            <!-- Circle -->

                                            <Ellipse Canvas.Left="11" 

                                                     Canvas.Top="5"

                                                     Width="18" 

                                                     Height="18" 

                                                     Fill="#3B82F6"

                                                     Stroke="White"

                                                     StrokeThickness="3"/>

                                        </Canvas>



                                        <!-- Content -->

                                        <Border Grid.Column="2" 

                                                Background="#F9FAFB" 

                                                CornerRadius="12" 

                                                Padding="20">

                                            <StackPanel>

                                                <TextBlock Text="{Binding Title}" 

                                                           FontSize="16" 

                                                           FontWeight="Bold"

                                                           Foreground="#1F2937"

                                                           TextWrapping="Wrap"

                                                           Margin="0,0,0,8"/>

                                                <TextBlock Text="{Binding Description}" 

                                                           FontSize="15" 

                                                           Foreground="#4B5563"

                                                           TextWrapping="Wrap"

                                                           LineHeight="22"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>



            <!-- TAB 7: LIÊN QUAN -->

            <TabItem>

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🔗" FontSize="18" Margin="0,0,8,0"/>

                        <TextBlock Text="Liên quan" Style="{StaticResource TabHeaderStyle}"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,35" Background="White">

                    <StackPanel>

                        <!-- A. Mini Periodic Table Visualization -->

                        <TextBlock Text="🗺️ Bảng tuần hoàn mini" Style="{StaticResource SectionTitleStyle}"/>

                        

                        <Border Background="White" 

                                CornerRadius="12" 

                                BorderThickness="1"

                                BorderBrush="#E0E0E0"

                                Padding="20"

                                Margin="0,0,0,30">

                            <StackPanel>

                                <TextBlock Text="[Mini periodic table]" 

                                           FontSize="14" 

                                           Foreground="#6B7280"

                                           Margin="0,0,0,10"

                                           FontFamily="Segoe UI"/>

                                <ItemsControl ItemsSource="{Binding CurrentElement.RelatedElementSymbols}">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border Background="#667EEA" 

                                                    CornerRadius="6" 

                                                    Padding="10,8"

                                                    Margin="0,0,5,5">

                                                <TextBlock Text="{Binding}" 

                                                           FontSize="14" 

                                                           FontWeight="Bold"

                                                           Foreground="White"/>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                

                                <TextBlock Margin="0,15,0,0" 

                                           FontSize="13" 

                                           Foreground="#6B7280">

                                    <Run Text="• Highlight nguyên tố hiện tại"/>

                                    <LineBreak/>

                                    <Run Text="• Highlight các nguyên tố liên quan (cùng nhóm/chu kỳ)"/>

                                    <LineBreak/>

                                    <Run Text="• Click vào nguyên tố → Chuyển sang chi tiết nguyên tố đó"/>

                                </TextBlock>

                            </StackPanel>

                        </Border>



                        <!-- B. Comparison Table (Dynamic) -->

                        <TextBlock Text="📊 Bảng so sánh" Style="{StaticResource SectionTitleStyle}"/>

                        

                        <Border Background="White" 

                                CornerRadius="12" 

                                BorderThickness="1"

                                BorderBrush="#E0E0E0"

                                Margin="0,0,0,30">

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

                                <StackPanel Name="ComparisonTablePanel" Orientation="Vertical">

                                    <!-- Dynamic content will be generated in code-behind -->

                                </StackPanel>

                            </ScrollViewer>

                        </Border>



                        <!-- C. Trend Explanation -->

                        <TextBlock Text="📈 Giải thích xu hướng" Style="{StaticResource SectionTitleStyle}"/>

                        

                        <Border Background="#FEF7E0" 

                                BorderBrush="#F59E0B"

                                BorderThickness="1"

                                CornerRadius="12" 

                                Padding="25"

                                Margin="0,0,0,30">

                            <ItemsControl ItemsSource="{Binding CurrentElement.TrendExplanations}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                            <TextBlock Text="• " 

                                                       FontSize="18" 

                                                       Foreground="#92400E"

                                                       FontWeight="Bold"

                                                       Margin="0,0,8,0"/>

                                            <TextBlock Text="{Binding}" 

                                                       FontSize="15" 

                                                       Foreground="#78350F"

                                                       TextWrapping="Wrap"

                                                       LineHeight="22"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Border>



                        <!-- Related Element Groups -->

                        <TextBlock Text="🔗 Nguyên tố liên quan" Style="{StaticResource SectionTitleStyle}"/>

                        

                        <ItemsControl ItemsSource="{Binding CurrentElement.RelatedElementGroups}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel Margin="0,0,0,25">

                                        <!-- Group Title -->

                                        <TextBlock Text="{Binding GroupName}" 

                                         FontSize="16" 

                                         FontWeight="Bold"

                                         Foreground="#374151"

                                         Margin="0,0,0,15"/>



                                        <!-- Elements Grid -->

                                        <ItemsControl ItemsSource="{Binding Elements}">

                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <UniformGrid Columns="4" HorizontalAlignment="Left"/>

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Background="#EEF2FF" 

                                                  CornerRadius="12" 

                                                  Padding="20,15"

                                                  Margin="0,0,10,10"

                                                  Width="200">

                                                        <StackPanel HorizontalAlignment="Center">

                                                            <TextBlock Text="{Binding Symbol}" 

                                                             FontSize="32" 

                                                             FontWeight="Bold"

                                                             Foreground="#4F46E5"

                                                             HorizontalAlignment="Center"

                                                             Margin="0,0,0,5"/>

                                                            <TextBlock Text="{Binding Name}" 

                                                             FontSize="14" 

                                                             Foreground="#6B7280"

                                                             HorizontalAlignment="Center"/>

                                                        </StackPanel>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>



                        <!-- Comparison Notes Box -->

                        <Border Background="#DBEAFE" 

                      BorderBrush="#3B82F6" 

                      BorderThickness="2"

                      CornerRadius="16" 

                      Padding="30,25"

                      Margin="0,10,0,0">

                            <Border.Effect>

                                <DropShadowEffect Color="#D1D5DB" 

                                        BlurRadius="15" 

                                        ShadowDepth="2" 

                                        Opacity="0.3"/>

                            </Border.Effect>

                            <StackPanel>

                                <TextBlock FontSize="20" 

                                 FontWeight="Bold" 

                                 Foreground="#1E40AF"

                                 Margin="0,0,0,20">

                          <Run Text="💡"/>

                          <Run Text=" So sánh với các nguyên tố khác"/>

                                </TextBlock>



                                <!-- Comparison Items -->

                                <ItemsControl ItemsSource="{Binding CurrentElement.ComparisonNotes}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <StackPanel Margin="0,0,0,20">

                                                <TextBlock Text="{Binding Title}" 

                                                 FontSize="16" 

                                                 FontWeight="Bold"

                                                 Foreground="#1E40AF"

                                                 Margin="0,0,0,8"/>

                                                <TextBlock Text="{Binding Description}" 

                                                 FontSize="15" 

                                                 Foreground="#374151"

                                                 TextWrapping="Wrap"

                                                 LineHeight="24"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>







        </TabControl>

    </Grid>

</Window>





