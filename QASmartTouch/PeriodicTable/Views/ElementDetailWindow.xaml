<Window FontFamily="Segoe UI" x:Class="QASmartTouch.PeriodicTable.Views.ElementDetailWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:converters="clr-namespace:QASmartTouch.PeriodicTable.Converters"

        Title="Chi Tiết Nguyên Tố" 

        Height="800" 

        Width="1200"

        ResizeMode="CanResize"

        WindowStartupLocation="CenterScreen"

        Background="#F5F5F5">



    <Window.Resources>

        <!-- Converters -->

        <converters:StabilityColorConverter x:Key="StabilityColorConverter"/>

        <converters:MultiplierToWidthConverter x:Key="MultiplierToWidthConverter"/>

        <converters:ValueWithUnitConverter x:Key="ValueWithUnitConverter"/>

        <!-- Tab Header Style -->

        <Style x:Key="TabHeaderStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Padding" Value="20,10"/>

        </Style>



        <!-- Section Title Style -->

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="20"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Foreground" Value="#333333"/>

            <Setter Property="Margin" Value="0,0,0,15"/>

        </Style>



        <!-- Property Label Style -->

        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Foreground" Value="#666666"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

        </Style>



        <!-- Property Value Style -->

        <Style x:Key="PropertyValueStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="15"/>

            <Setter Property="Foreground" Value="#333333"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="TextWrapping" Value="Wrap"/>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="150"/>

            <!-- Header -->

            <RowDefinition Height="*"/>

            <!-- Content Tabs -->

        </Grid.RowDefinitions>



        <!-- HEADER SECTION -->

        <Border Grid.Row="0">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                    <GradientStop Color="#667EEA" Offset="0"/>

                    <GradientStop Color="#764BA2" Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

            <Border.Effect>

                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4"/>

            </Border.Effect>



            <Grid Margin="30,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <!-- Element Card (Left) -->

                <Border Grid.Column="0" 

                        Background="White" 

                        CornerRadius="12" 

                        Padding="20"

                        Width="110"

                        Height="110"

                        VerticalAlignment="Center">

                    <Border.Effect>

                        <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.3" Color="#667EEA"/>

                    </Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>



                        <!-- Atomic Number -->

                        <TextBlock Grid.Row="0" 

                                   Text="{Binding CurrentElement.AtomicNumber, FallbackValue=1}"

                                   FontSize="13"

                                   FontWeight="Bold"

                                   Foreground="#999999"

                                   HorizontalAlignment="Left"

                                   Margin="0,0,0,3"/>



                        <!-- Symbol -->

                        <TextBlock Grid.Row="1" 

                                   Text="{Binding CurrentElement.Symbol, FallbackValue=H}"

                                   FontSize="48"

                                   FontWeight="Bold"

                                   HorizontalAlignment="Center"

                                   VerticalAlignment="Center">

                            <TextBlock.Foreground>

                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                    <GradientStop Color="#667EEA" Offset="0"/>

                                    <GradientStop Color="#764BA2" Offset="1"/>

                                </LinearGradientBrush>

                            </TextBlock.Foreground>

                        </TextBlock>



                        <!-- Atomic Mass -->

                        <TextBlock Grid.Row="2" 

                                   Text="{Binding CurrentElement.AtomicMass, StringFormat={}{0:F3}, FallbackValue=1.008}"

                                   FontSize="12"

                                   Foreground="#666666"

                                   HorizontalAlignment="Center"/>

                    </Grid>

                </Border>



                <!-- Element Info (Center) -->

                <StackPanel Grid.Column="1" 

                            VerticalAlignment="Center" 

                            Margin="25,0,0,0">

                    <!-- Vietnamese Name -->

                    <TextBlock Text="{Binding CurrentElement.Name, FallbackValue=Hydro}"

                               FontSize="32"

                               FontWeight="Bold"

                               Foreground="White"

                               Margin="0,0,0,5"/>



                    <!-- English Name -->

                    <TextBlock Text="{Binding CurrentElement.NameEn, FallbackValue=Hydrogen}"

                               FontSize="16"

                               Foreground="#E8E8E8"

                               FontStyle="Italic"

                               Margin="0,0,0,12"/>



                    <!-- Quick Info Tags -->

                    <StackPanel Orientation="Horizontal">

                        <!-- Category -->

                        <Border Background="White" 

                                CornerRadius="14" 

                                Padding="12,5"

                                Margin="0,0,8,0">

                            <TextBlock Text="{Binding CurrentElement.Category, FallbackValue=Phi kim}"

                                       FontSize="12"

                                       FontWeight="SemiBold">

                                <TextBlock.Foreground>

                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                                        <GradientStop Color="#667EEA" Offset="0"/>

                                        <GradientStop Color="#764BA2" Offset="1"/>

                                    </LinearGradientBrush>

                                </TextBlock.Foreground>

                            </TextBlock>

                        </Border>



                        <!-- Phase -->

                        <Border Background="White" 

                                CornerRadius="14" 

                                Padding="12,5"

                                Margin="0,0,8,0">

                            <TextBlock Text="{Binding CurrentElement.PhaseAtSTP, FallbackValue=Khí}"

                                       FontSize="12"

                                       FontWeight="SemiBold"

                                       Foreground="#555555"/>

                        </Border>



                        <!-- Group & Period -->

                        <Border Background="White" 

                                CornerRadius="14" 

                                Padding="12,5">

                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#555555">

                                <Run Text="Nhóm "/>

                                <Run Text="{Binding CurrentElement.Group, FallbackValue=1}"/>

                                <Run Text=", Chu kỳ "/>

                                <Run Text="{Binding CurrentElement.Period, FallbackValue=1}"/>

                            </TextBlock>

                        </Border>

                    </StackPanel>

                </StackPanel>



                <!-- Navigation & Close Buttons (Right) -->

                <StackPanel Grid.Column="2" 

                           Orientation="Horizontal" 

                           VerticalAlignment="Top"

                           HorizontalAlignment="Right">

                    

                    <!-- Previous Button -->

                    <Button x:Name="PrevButton"

                            Content="◀"

                            FontSize="18"

                            FontWeight="Bold"

                            Width="45"

                            Height="45"

                            Background="Transparent"

                            Foreground="White"

                            BorderThickness="0"

                            Cursor="Hand"

                            Click="PrevButton_Click"

                            Margin="0,0,6,0"

                            ToolTip="Nguyên tố trước">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="22"

                                                    BorderThickness="2"

                                                    BorderBrush="#88FFFFFF">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#44FFFFFF"/>

                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">

                                        <Setter Property="Opacity" Value="0.3"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>



                    <!-- Next Button -->

                    <Button x:Name="NextButton"

                            Content="▶"

                            FontSize="18"

                            FontWeight="Bold"

                            Width="45"

                            Height="45"

                            Background="Transparent"

                            Foreground="White"

                            BorderThickness="0"

                            Cursor="Hand"

                            Click="NextButton_Click"

                            Margin="0,0,6,0"

                            ToolTip="Nguyên tố tiếp theo">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="22"

                                                    BorderThickness="2"

                                                    BorderBrush="#88FFFFFF">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#44FFFFFF"/>

                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">

                                        <Setter Property="Opacity" Value="0.3"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>



                    <!-- Close Button -->

                    <Button Content="✕"

                            FontSize="24"

                            FontWeight="Bold"

                            Width="45"

                            Height="45"

                            Background="Transparent"

                            Foreground="White"

                            BorderThickness="0"

                            Cursor="Hand"

                            Click="CloseButton_Click"

                            ToolTip="Đóng">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="22"

                                                    BorderThickness="2"

                                                    BorderBrush="Transparent">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#44FFFFFF"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>



        <!-- TABS SECTION -->

        <TabControl Grid.Row="1" 

                    Margin="0"

                    Background="#F5F5F5"

                    BorderThickness="0">

            <TabControl.Resources>

                <Style TargetType="TabItem">

                    <Setter Property="Template">

                        <Setter.Value>

                            <ControlTemplate TargetType="TabItem">

                                <Border Name="Border" 

                                        Background="White" 

                                        BorderThickness="0,0,0,4"

                                        BorderBrush="Transparent"

                                        Padding="28,18"

                                        Margin="0,0,2,0">

                                    <ContentPresenter ContentSource="Header" 

                                                    HorizontalAlignment="Center"

                                                    VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsSelected" Value="True">

                                        <Setter TargetName="Border" Property="Background" Value="White"/>

                                        <Setter TargetName="Border" Property="BorderBrush">

                                            <Setter.Value>

                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                                                    <GradientStop Color="#667EEA" Offset="0"/>

                                                    <GradientStop Color="#764BA2" Offset="1"/>

                                                </LinearGradientBrush>

                                            </Setter.Value>

                                        </Setter>

                                    </Trigger>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter TargetName="Border" Property="Background" Value="#F8F9FA"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Setter.Value>

                    </Setter>

                </Style>

            </TabControl.Resources>



            <!-- TAB 1: TỔNG QUAN -->

            <TabItem>

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0"/>

                        <TextBlock Text="Tổng quan" Style="{StaticResource TabHeaderStyle}"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,35" Background="White">

                    <StackPanel>

                        <!-- Description Box -->

                        <Border Background="#F8F9FA" 

                                CornerRadius="12" 

                                Padding="25"

                                Margin="0,0,0,30"

                                BorderThickness="1"

                                BorderBrush="#E0E0E0">

                            <TextBlock Text="{Binding CurrentElement.Description, FallbackValue=Mô tả nguyên tố...}"

                                       FontSize="16"

                                       Foreground="#333333"

                                       TextWrapping="Wrap"

                                       LineHeight="28"/>

                        </Border>



                        <!-- Quick Facts Cards -->

                        <Grid Margin="0,0,0,30">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>



                            <!-- Card 1: Trạng thái ở STP -->

                            <Border Grid.Column="0" 

                                    Background="#E3F2FD" 

                                    CornerRadius="12" 

                                    Padding="18,15"

                                    Margin="0,0,8,0">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="Trạng thái ở STP" 

                                               FontSize="11" 

                                               Foreground="#1976D2"

                                               HorizontalAlignment="Center"

                                               Margin="0,0,0,5"/>

                                    <TextBlock Text="{Binding CurrentElement.PhaseAtSTP, FallbackValue=Khí}" 

                                               FontSize="16" 

                                               FontWeight="Bold" 

                                               Foreground="#0D47A1"

                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>



                            <!-- Card 2: Màu sắc -->

                            <Border Grid.Column="1" 

                                    Background="#FFF3E0" 

                                    CornerRadius="12" 

                                    Padding="18,15"

                                    Margin="4,0,4,0">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="Màu sắc" 

                                               FontSize="11" 

                                               Foreground="#F57C00"

                                               HorizontalAlignment="Center"

                                               Margin="0,0,0,5"/>

                                    <TextBlock Text="{Binding CurrentElement.Color, FallbackValue=Không màu}" 

                                               FontSize="16" 

                                               FontWeight="Bold" 

                                               Foreground="#E65100"

                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>



                            <!-- Card 3: Độc/An toàn -->

                            <Border Grid.Column="2" 

                                    Background="#E8F5E9" 

                                    CornerRadius="12" 

                                    Padding="18,15"

                                    Margin="4,0,4,0">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="Độc tính" 

                                               FontSize="11" 

                                               Foreground="#388E3C"

                                               HorizontalAlignment="Center"

                                               Margin="0,0,0,5"/>

                                    <TextBlock Text="An toàn" 

                                               FontSize="16" 

                                               FontWeight="Bold" 

                                               Foreground="#1B5E20"

                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>



                            <!-- Card 4: Độ phổ biến -->

                            <Border Grid.Column="3" 

                                    Background="#FCE4EC" 

                                    CornerRadius="12" 

                                    Padding="18,15"

                                    Margin="8,0,0,0">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="Độ phổ biến" 

                                               FontSize="11" 

                                               Foreground="#C2185B"

                                               HorizontalAlignment="Center"

                                               Margin="0,0,0,5"/>

                                    <TextBlock Text="{Binding CurrentElement.Abundance, FallbackValue=Rất phổ biến}" 

                                               FontSize="16" 

                                               FontWeight="Bold" 

                                               Foreground="#880E4F"

                                               HorizontalAlignment="Center"

                                               TextWrapping="Wrap"

                                               TextAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </Grid>



                        <!-- Section 1: Định danh (Identity) -->

                        <TextBlock Text="🔖 Định danh (Identity)" Style="{StaticResource SectionTitleStyle}"/>



                        <!-- Quick Facts Grid - 3 columns -->

                        <Grid Margin="0,0,0,30">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>



                            <!-- Row 0: Atomic Number, Mass, Category -->

                            <Border Grid.Row="0" Grid.Column="0" 

                                    Background="White" 

                                    CornerRadius="10" 

                                    Padding="20"

                                    Margin="0,0,10,10"

                                    BorderThickness="1"

                                    BorderBrush="#E0E0E0">

                                <StackPanel>

                                    <TextBlock Text="⚛️ Số hiệu nguyên tử" Style="{StaticResource PropertyLabelStyle}" Foreground="#667EEA"/>

                                    <TextBlock Text="{Binding CurrentElement.AtomicNumber, FallbackValue=1}" 

                                               FontSize="28" 

                                               FontWeight="Bold" 

                                               Foreground="#667EEA" 

                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>



                            <Border Grid.Row="0" Grid.Column="1" 

                                    Background="White" 

                                    CornerRadius="10" 

                                    Padding="20"

                                    Margin="5,0,5,10"

                                    BorderThickness="1"

                                    BorderBrush="#E0E0E0">

                                <StackPanel>

                                    <TextBlock Text="⚖️ Khối lượng nguyên tử" Style="{StaticResource PropertyLabelStyle}" Foreground="#667EEA"/>

                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="#667EEA" Margin="0,8,0,0">

                                        <Run Text="{Binding CurrentElement.AtomicMass, StringFormat={}{0:F3}, FallbackValue=1.008}"/>

                                        <Run Text=" u" FontSize="16" Foreground="#999999"/>

                                    </TextBlock>

                                </StackPanel>

                            </Border>



                            <Border Grid.Row="0" Grid.Column="2" 

                                    Background="White" 

                                    CornerRadius="10" 

                                    Padding="20"

                                    Margin="10,0,0,10"

                                    BorderThickness="1"

                                    BorderBrush="#E0E0E0">

                                <StackPanel>

                                    <TextBlock Text="🔬 Phân loại" Style="{StaticResource PropertyLabelStyle}" Foreground="#667EEA"/>

                                    <TextBlock Text="{Binding CurrentElement.Category, FallbackValue=Phi kim}" 

                                               FontSize="20" 

                                               FontWeight="Bold" 

                                               Foreground="#667EEA" 

                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>



                        <!-- Section 2: Vị trí bảng tuần hoàn (Position) -->

                        <TextBlock Text="📍 Vị trí bảng tuần hoàn (Position)" Style="{StaticResource SectionTitleStyle}"/>



                        <Grid Margin="0,0,0,30">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>



                            <!-- Row 1: Group, Period, Block -->

                            <Border Grid.Row="1" Grid.Column="0" 

                                    Background="#F8F9FA" 

                                    CornerRadius="10" 

                                    Padding="20"

                                    Margin="0,0,10,10">

                                <StackPanel>

                                    <TextBlock Text="Nhóm" Style="{StaticResource PropertyLabelStyle}"/>

                                    <TextBlock Text="{Binding CurrentElement.Group, FallbackValue=1}" 

                                               FontSize="24" 

                                               FontWeight="Bold" 

                                               Foreground="#333333" 

                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </Border>



                            <Border Grid.Row="1" Grid.Column="1" 

                                    Background="#F8F9FA" 

                                    CornerRadius="10" 

                                    Padding="20"

                                    Margin="5,0,5,10">

                                <StackPanel>

                                    <TextBlock Text="Chu kỳ" Style="{StaticResource PropertyLabelStyle}"/>

                                    <TextBlock Text="{Binding CurrentElement.Period, FallbackValue=1}" 

                                               FontSize="24" 

                                               FontWeight="Bold" 

                                               Foreground="#333333" 

                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </Border>



                            <Border Grid.Row="1" Grid.Column="2" 

                                    Background="#F8F9FA" 

                                    CornerRadius="10" 

                                    Padding="20"

                                    Margin="10,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="Khối" Style="{StaticResource PropertyLabelStyle}"/>

                                    <TextBlock Text="{Binding CurrentElement.Block, FallbackValue=s}" 

                                               FontSize="24" 

                                               FontWeight="Bold" 

                                               Foreground="#333333" 

                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </Border>



                            <!-- Row 2: Electron Config (Full width) -->

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 

                                    Background="White" 

                                    CornerRadius="10" 

                                    Padding="20"

                                    Margin="0,0,0,10"

                                    BorderThickness="1"

                                    BorderBrush="#E0E0E0">

                                <StackPanel>

                                    <TextBlock Text="⚛️ Cấu hình electron" Style="{StaticResource PropertyLabelStyle}" Foreground="#667EEA"/>

                                    <TextBlock Text="{Binding CurrentElement.ElectronConfig, FallbackValue=1s¹}" 

                                               FontSize="20" 

                                               FontWeight="SemiBold" 

                                               Foreground="#333333" 

                                               FontFamily="Cambria Math, Segoe UI"

                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>



                        <!-- Natural State and Isotopes Box -->

                        <Border Background="#F3E5F5" 

                                BorderBrush="#9C27B0"

                                BorderThickness="2"

                                CornerRadius="12" 

                                Padding="20"

                                Margin="0,10,0,20">

                            <StackPanel>

                                <TextBlock Text="🔬 Trạng thái tự nhiên và đồng vị" 

                                           FontSize="16"

                                           FontWeight="Bold"

                                           Foreground="#7B1FA2"

                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding CurrentElement.NaturalStateInfo}"

                                           FontSize="15"

                                           Foreground="#333333"

                                           TextWrapping="Wrap"

                                           LineHeight="24"/>

                            </StackPanel>

                        </Border>



                        <!-- Etymology Box -->

                        <Border Background="#E3F2FD" 

                                BorderBrush="#2196F3"

                                BorderThickness="2"

                                CornerRadius="12" 

                                Padding="20"

                                Margin="0,0,0,0">

                            <StackPanel>

                                <TextBlock Text="📚 Nguồn gốc tên gọi" 

                                           FontSize="16"

                                           FontWeight="Bold"

                                           Foreground="#1565C0"

                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding CurrentElement.Etymology, FallbackValue=Nguồn gốc tên gọi...}"

                                           FontSize="15"

                                           Foreground="#333333"

                                           TextWrapping="Wrap"

                                           LineHeight="24"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>



            <!-- TAB 2: CẤU TRÚC -->

            <TabItem>

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="⚛️" FontSize="18" Margin="0,0,8,0"/>

                        <TextBlock Text="Cấu trúc" Style="{StaticResource TabHeaderStyle}"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,35" Background="White">

                    <StackPanel>

                        <TextBlock Text="⚛️ Cấu hình electron" Style="{StaticResource SectionTitleStyle}"/>



                        <!-- Electron Configuration Box -->

                        <Border Background="#EEF2FF" 

                                CornerRadius="12" 

                                Padding="25"

                                Margin="0,0,0,25">

                            <StackPanel>

                                <TextBlock Text="Cấu hình đầy đủ" 

                                           FontSize="16"

                                           FontWeight="SemiBold"

                                           Foreground="#667EEA"

                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{Binding CurrentElement.ElectronConfig, FallbackValue=1s¹}"

                                           FontSize="32"

                                           FontWeight="Bold"

                                           Foreground="#333333"

                                           FontFamily="Cambria Math, Segoe UI"/>

                            </StackPanel>

                        </Border>



                        <!-- Atomic Structure Visualization -->

                        <TextBlock Text="🔬 Mô hình cấu trúc nguyên tử" 

                                   FontSize="16"

                                   FontWeight="SemiBold"

                                   Foreground="#667EEA"

                                   Margin="0,10,0,15"/>



                        <Border Background="#F8F9FA" 

                                BorderBrush="#667EEA"

                                BorderThickness="2"

                                CornerRadius="12" 

                                Padding="40"

                                Margin="0,0,0,30"

                                HorizontalAlignment="Center">

                            <StackPanel HorizontalAlignment="Center">

                                <!-- Title -->

                                <TextBlock Text="Phân bố electron theo lớp" 

                                           FontSize="14"

                                           FontWeight="SemiBold"

                                           Foreground="#667EEA"

                                           HorizontalAlignment="Center"

                                           Margin="0,0,0,20"/>

                                

