<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Tối ưu hóa hiệu suất & khởi động -->
    <TieredCompilation>true</TieredCompilation>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en;vi</SatelliteResourceLanguages>

    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>QASmartTouch</AssemblyName>
    <RootNamespace>QASmartTouch</RootNamespace>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <AssemblyTitle>QA Smart Touch</AssemblyTitle>
    <Product>QA Smart Touch - Interactive Whiteboard</Product>
    <Company>QA Education Technology</Company>
    <Copyright>Copyright © 2025-2026</Copyright>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <NoWarn>NU1701;NU1603;NETSDK1206;NETSDK1086;CS0414;CS0169;CS0067;CS0649;CS8618;CS8600;CS8601;CS8602;CS8604;CS8625</NoWarn>
    <CodePage>65001</CodePage>
    <DefineConstants>SMARTTOUCH_STANDALONE;NO_SMARTSCHOOL</DefineConstants>
  </PropertyGroup>

  <!-- Cấu hình Bảo vệ Mã nguồn & Chống Dịch ngược (Release / Publish) -->
  <PropertyGroup>
    <_RequiresILLinkPack>false</_RequiresILLinkPack>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Thư viện phụ thuộc cho Bảng vẽ, STEM Tools, Đồ thị, 3D, Âm thanh & Nhận dạng AI -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="EPPlus" Version="8.5.4" />
    <PackageReference Include="Google.Cloud.Vision.V1" Version="3.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="HelixToolkit.Wpf" Version="2.25.0" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="Imazen.WebP" Version="1.0.29" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20241117" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20241117" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20241117" />
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.Wpf" />
  </ItemGroup>

  <!-- Cấu hình Version Management & App Settings -->
  <ItemGroup>
    <None Update="config\VersionStatus.json" CopyToOutputDirectory="Always" />
    <None Update="config\VersionDetail.json" CopyToOutputDirectory="Always" />
    <None Update="config\AppBranding.json" CopyToOutputDirectory="Always" />
    <None Update="config\5_UserSettings.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tài nguyên Fonts & Hình ảnh giao diện nhúng -->
  <ItemGroup>
    <Resource Include="QA-file-goc-2-03.ico" />
    <Resource Include="Resources\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\periodic_table_overview.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- Sao chép đúng các Assets & Tài nguyên học cụ mà QA Smart Touch sử dụng -->
  <ItemGroup>
    <None Update="Assets\Images\app_periodictable_*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Data\Language\VocabularyData.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="PeriodicTable\Data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Modules\InteractiveBooks\Data\books.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Modules\InteractiveBooks\Data\images\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Calculator\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Simulations\Physics\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\EnglishCards\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tự động chạy Obfuscar làm rối mã IL & mã hóa chuỗi trước khi đóng gói Single-File ở chế độ Release -->
  <Target Name="ObfuscateReleaseAssembly" AfterTargets="CopyFilesToOutputDirectory" BeforeTargets="PrepareForPublish;_ComputeFilesToBundle" Condition="'$(Configuration)' == 'Release' and Exists('$(MSBuildThisFileDirectory)..\.tools\obfuscar.console.exe')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)obfuscate.ps1&quot; -TargetDllPath &quot;@(IntermediateAssembly)&quot; -ReferenceDir &quot;$(TargetDir).&quot; -SecondaryTargetDllPath &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
