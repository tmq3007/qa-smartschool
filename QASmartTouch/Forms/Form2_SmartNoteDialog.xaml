<Window x:Class="QASmartTouch.Forms.Form2_SmartNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thẻ Ghi Chú Thông Minh"
        Width="920" Height="680"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Pill Preset Button Style -->
        <Style x:Key="PillPresetButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Format Toggle Button Style -->
        <Style x:Key="FormatToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Style -->
        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBorder" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Body: 2 Columns -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📌" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thẻ Ghi Chú Thông Minh (Smart Note Card)" 
                                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#E0F2F1" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MATHCARD STYLE" FontSize="11" FontWeight="Bold" Foreground="#00796B"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Định dạng thẻ bài giảng phong cách MathCard, hỗ trợ phông chữ viết tay Canva &amp; 8 bảng màu sinh động" 
                               FontSize="12" Foreground="#64748B" Margin="32,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="btnCancel_Click" Background="Transparent" BorderThickness="0" 
                        Foreground="#64748B" FontSize="18" FontWeight="Bold" Cursor="Hand" Padding="8,4" Content="✕"/>
            </Grid>
        </Border>

        <!-- ================= 2. MAIN BODY ================= -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="340"/> <!-- Left: Configuration -->
                <ColumnDefinition Width="16"/>                 <!-- Spacer -->
                <ColumnDefinition Width="*" MinWidth="320"/>   <!-- Right: Live Preview -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Controls (Scrollable) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- A. Nội dung ghi chú -->
                    <TextBlock Text="1. Nội dung ghi chú:" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="6">
                        <TextBox x:Name="txtContentInput" 
                                 Height="110" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.PanningMode="None"
                                 Stylus.IsFlicksEnabled="False"
                                 BorderThickness="0" 
                                 Background="Transparent"
                                 FontSize="15" 
                                 TextChanged="OnInputChanged"/>
                    </Border>

                    <!-- B. Tiêu đề & Mẫu nhanh -->
                    <TextBlock Text="2. Tiêu đề thẻ:" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,14,0,6"/>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="8,4">
                        <TextBox x:Name="txtTitleInput" Text="GHI CHÚ BÀI HỌC" BorderThickness="0" Background="Transparent" FontSize="14" FontWeight="SemiBold" TextChanged="OnInputChanged"/>
                    </Border>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource PillPresetButton}" Content="📌 Ghi chú" Click="PresetTitle_Click" Tag="GHI CHÚ BÀI HỌC"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="💡 Lưu ý" Click="PresetTitle_Click" Tag="LƯU Ý QUAN TRỌNG"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="⚡ Công thức" Click="PresetTitle_Click" Tag="CÔNG THỨC TOÁN HỌC"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="❓ Bài tập" Click="PresetTitle_Click" Tag="BÀI TẬP VẬN DỤNG"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="📖 Định nghĩa" Click="PresetTitle_Click" Tag="ĐỊNH NGHĨA - KHÁI NIỆM"/>
                    </WrapPanel>

                    <!-- C. Nhãn Badge & Mẫu nhanh -->
                    <TextBlock Text="3. Nhãn Badge góc phải:" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,12,0,6"/>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="8,4">
                        <TextBox x:Name="txtBadgeInput" Text="LƯU Ý" BorderThickness="0" Background="Transparent" FontSize="13" FontWeight="Bold" TextChanged="OnInputChanged"/>
                    </Border>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource PillPresetButton}" Content="LƯU Ý" Click="PresetBadge_Click" Tag="LƯU Ý"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="QUAN TRỌNG" Click="PresetBadge_Click" Tag="QUAN TRỌNG"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="CÔNG THỨC" Click="PresetBadge_Click" Tag="CÔNG THỨC"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="ĐỊNH LÝ" Click="PresetBadge_Click" Tag="ĐỊNH LÝ"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="VÍ DỤ" Click="PresetBadge_Click" Tag="VÍ DỤ"/>
                        <Button Style="{StaticResource PillPresetButton}" Content="MẸO HAY" Click="PresetBadge_Click" Tag="MẸO HAY"/>
                    </WrapPanel>

                    <!-- D. Phông chữ (NoteBoard) -->
                    <TextBlock Text="4. Phông chữ (Bộ phông NoteBoard):" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,14,0,6"/>
                    <ComboBox x:Name="cboFonts" Height="36" FontSize="14" SelectionChanged="cboFonts_SelectionChanged"
                              Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5"/>

                    <!-- E. Cỡ chữ & Kiểu dáng -->
                    <TextBlock Text="5. Cỡ chữ &amp; Định dạng:" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FormatToggleBtn}" Content="A-" Click="btnSizeDown_Click" ToolTip="Giảm cỡ chữ"/>
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Width="52" Height="38" Margin="0,0,6,0">
                            <TextBlock x:Name="txtFontSizeDisplay" Text="24" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource FormatToggleBtn}" Content="A+" Click="btnSizeUp_Click" ToolTip="Tăng cỡ chữ"/>

                        <Border Width="1" Height="28" Background="#CBD5E1" Margin="6,0,10,0"/>

                        <Button x:Name="btnBold" Style="{StaticResource FormatToggleBtn}" Content="B" FontWeight="Bold" Click="btnBold_Click" ToolTip="In đậm"/>
                        <Button x:Name="btnItalic" Style="{StaticResource FormatToggleBtn}" Content="I" FontStyle="Italic" Click="btnItalic_Click" ToolTip="In nghiêng"/>
                    </StackPanel>

                    <!-- F. 8 Màu Thẻ (Themes) -->
                    <TextBlock Text="6. Màu sắc thẻ (8 Tone màu NoteBoard):" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,14,0,8"/>
                    <WrapPanel x:Name="themeWrapPanel">
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFFFFF" BorderBrush="#168B82" Tag="White" Click="ThemeColor_Click" ToolTip="Trắng Tinh Khôi"/>
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#FEF9C3" BorderBrush="#D97706" Tag="Yellow" Click="ThemeColor_Click" ToolTip="Vàng Note"/>
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#DCFCE7" BorderBrush="#16A34A" Tag="Mint" Click="ThemeColor_Click" ToolTip="Xanh Mint"/>
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#E0F2FE" BorderBrush="#0284C7" Tag="Sky" Click="ThemeColor_Click" ToolTip="Xanh Da Trời"/>
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFEDD5" BorderBrush="#EA580C" Tag="Peach" Click="ThemeColor_Click" ToolTip="Cam Phấn"/>
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#F3E8FF" BorderBrush="#9333EA" Tag="Purple" Click="ThemeColor_Click" ToolTip="Tím Mộng Mơ"/>
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#FCE7F3" BorderBrush="#DB2777" Tag="Pink" Click="ThemeColor_Click" ToolTip="Hồng Phấn"/>
                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#1E293B" BorderBrush="#64748B" Tag="Dark" Click="ThemeColor_Click" ToolTip="Bảng Tối"/>
                    </WrapPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: Live Preview -->
            <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBlock Text="👁️" FontSize="16" Margin="0,0,6,0"/>
                        <TextBlock Text="XEM TRƯỚC TRÊN BẢNG VẼ" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    </StackPanel>

                    <!-- Preview Container -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                            <!-- Target Note Card Border -->
                            <Border x:Name="previewCardBorder" 
                                    Background="#FFFFFF"
                                    BorderBrush="#168B82"
                                    BorderThickness="2.5"
                                    CornerRadius="12"
                                    Padding="18,14,18,16"
                                    MinWidth="320"
                                    MaxWidth="500">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.20"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📌" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="previewTitle" Text="GHI CHÚ BÀI HỌC" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border x:Name="previewBadgeBorder" Grid.Column="1" Background="#E0F2F1" CornerRadius="10" Padding="10,3,10,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="previewBadgeText" Text="LƯU Ý" FontSize="11" FontWeight="Bold" Foreground="#00796B"/>
                                        </Border>
                                    </Grid>

                                    <!-- Divider -->
                                    <Line x:Name="previewDivider" Grid.Row="1" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#E2E8F0" StrokeThickness="1" Margin="0,0,0,10"/>

                                    <!-- Content -->
                                    <TextBlock x:Name="previewContent" Grid.Row="2" 
                                               Text="Nhập nội dung ghi chú tại đây..." 
                                               FontSize="24" 
                                               TextWrapping="Wrap" 
                                               Foreground="#1E293B"
                                               LineHeight="32"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 3. FOOTER ================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock Text="💡 Bạn có thể kéo di chuyển, xoay hoặc chạm đúp vào thẻ trên bảng để sửa lại bất cứ lúc nào." 
                           FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel" Click="btnCancel_Click" Content="Hủy bỏ" Width="100" Height="40" Margin="0,0,10,0"
                            Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnConfirm" Click="btnConfirm_Click" Content="Đưa lên bảng" Width="150" Height="40"
                            Background="#168B82" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="14">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

