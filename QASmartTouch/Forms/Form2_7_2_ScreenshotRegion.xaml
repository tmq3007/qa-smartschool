<Window x:Class="QASmartTouch.Forms.Form2_7_2_ScreenshotRegion"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Chụp ảnh vùng" 

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        Topmost="True"

        Cursor="Cross"

        MouseDown="Window_MouseDown"

        MouseMove="Window_MouseMove"

        MouseUp="Window_MouseUp"

        KeyDown="Window_KeyDown"

        FontFamily="{StaticResource InterFont}">



    <Grid x:Name="MainGrid">

        <!-- ✨ NEW: 4 dark rectangles surrounding the selection (spotlight effect) -->

        <!-- Initially covers entire screen, will be updated when selection starts -->

        

        <!-- Top rectangle -->

        <Rectangle x:Name="OverlayTop"

                   Fill="#80000000"

                   VerticalAlignment="Stretch"

                   IsHitTestVisible="False"/>

        

        <!-- Bottom rectangle -->

        <Rectangle x:Name="OverlayBottom"

                   Fill="#80000000"

                   Height="0"

                   VerticalAlignment="Bottom"

                   IsHitTestVisible="False"/>

        

        <!-- Left rectangle -->

        <Rectangle x:Name="OverlayLeft"

                   Fill="#80000000"

                   Width="0"

                   HorizontalAlignment="Left"

                   IsHitTestVisible="False"/>

        

        <!-- Right rectangle -->

        <Rectangle x:Name="OverlayRight"

                   Fill="#80000000"

                   Width="0"

                   HorizontalAlignment="Right"

                   IsHitTestVisible="False"/>

        <!-- ✨ NEW: Crosshair Lines to show cursor position -->

        <Line x:Name="CrosshairH" 

              Stroke="White" 

              StrokeThickness="1"

              Opacity="0.6"

              X1="0" Y1="0" X2="10000" Y2="0"

              IsHitTestVisible="False"

              Visibility="Visible"/>

        

        <Line x:Name="CrosshairV" 

              Stroke="White" 

              StrokeThickness="1"

              Opacity="0.6"

              X1="0" Y1="0" X2="0" Y2="10000"

              IsHitTestVisible="False"

              Visibility="Visible"/>

        

        

        <!-- ✨ FIX: Canvas wrapper for SelectionRect (Canvas.SetLeft/SetTop only works in Canvas!) -->

        <Canvas x:Name="SelectionCanvas" 

                Background="Transparent"

                IsHitTestVisible="False">

            <!-- Selection Rectangle -->

            <Rectangle x:Name="SelectionRect"

                       Stroke="#5C6BC0"

                       StrokeThickness="1"

                       StrokeDashArray="5,3"

                       Fill="Transparent"

                       SnapsToDevicePixels="True"

                       UseLayoutRounding="True"

                       Visibility="Collapsed"/>

            

            <!-- Size Label -->

            <Border x:Name="SizeLabel"

                    Background="#2F3542"

                    CornerRadius="4"

                    Padding="8,4"

                    Visibility="Collapsed">

                <TextBlock x:Name="txtSize"

                          Text="0 × 0"

                          FontSize="11"

                          Foreground="White"

                          FontWeight="Bold"/>

            </Border>

        </Canvas>



        <!-- Instructions -->

        <Border x:Name="InstructionPanel"

                Background="#2F3542"

                CornerRadius="8"

                Padding="20,15"

                HorizontalAlignment="Center"

                VerticalAlignment="Top"

                Margin="0,50,0,0">

            <StackPanel>

                <TextBlock Text="Chụp ảnh vùng" 

                          FontSize="16" 

                          FontWeight="Bold" 

                          Foreground="White"

                          HorizontalAlignment="Center"

                          Margin="0,0,0,10"/>

                <TextBlock Foreground="#DFE4EA" 

                          FontSize="12"

                          TextAlignment="Center">

                    <Run Text="• Kéo ngón tay hoặc bút cảm ứng để chọn vùng cần chụp"/><LineBreak/>

                    <Run Text="• Sau khi chọn: 📋 Đặt lên bảng | 💾 Lưu (Ctrl+S) | 📎 Copy (Ctrl+C)"/><LineBreak/>

                    <Run Text="• Nhấn ESC để hủy"/>

                </TextBlock>

            </StackPanel>

        </Border>



        <!-- Action Panel (appears after selection) -->

        <Border x:Name="ActionPanel"

                Background="White"

                CornerRadius="8"

                Padding="10"

                Visibility="Collapsed"

                HorizontalAlignment="Left"

                VerticalAlignment="Top">

            <Border.Effect>

                <DropShadowEffect Color="#000000" 

                                Direction="270" 

                                ShadowDepth="2" 

                                BlurRadius="10" 

                                Opacity="0.3"/>

            </Border.Effect>

            

            <StackPanel Orientation="Horizontal">

                <!-- ✨ NEW: Place on Board Button -->

                <Button x:Name="btnPlaceOnBoard"

                       Width="40" Height="40"

                       Margin="2"

                       Background="#9C27B0"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnPlaceOnBoard_Click"

                       ToolTip="Đặt lên bảng">

                    <Path Fill="White" 

                         Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M13.96,12.29L11.21,15.83L9.25,13.47L6.5,17H17.5L13.96,12.29Z"

                         Width="20" Height="20"/>

                </Button>

                

                <!-- Save Button -->

                <Button x:Name="btnSave"

                       Width="40" Height="40"

                       Margin="2"

                       Background="#4CAF50"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnSave_Click"

                       ToolTip="Lưu file (Ctrl+S)">

                    <Path Fill="White" 

                         Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"

                         Width="20" Height="20"/>

                </Button>



                <!-- Copy Button -->

                <Button x:Name="btnCopy"

                       Width="40" Height="40"

                       Margin="2"

                       Background="#2196F3"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnCopy_Click"

                       ToolTip="Copy (Ctrl+C)">

                    <Path Fill="White" 

                         Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"

                         Width="20" Height="20"/>

                </Button>



                <!-- Cancel Button -->

                <Button x:Name="btnCancel"

                       Width="40" Height="40"

                       Margin="2"

                       Background="#EE5A6F"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnCancel_Click"

                       ToolTip="Hủy (ESC)">

                    <Path Fill="White" 

                         Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                         Width="20" Height="20"/>

                </Button>

            </StackPanel>

        </Border>



    </Grid>

</Window>

