<Window x:Class="QASmartTouch.Forms.CountdownOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#800A0E1A"
        Topmost="True" 
        ShowInTaskbar="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Vòng tròn hiển thị số đếm -->
            <Border x:Name="circleBadge" 
                    Width="160" Height="160" 
                    CornerRadius="80" 
                    Background="#1E293B" 
                    BorderBrush="#EF4444" 
                    BorderThickness="5"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="badgeScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#EF4444" BlurRadius="30" Opacity="0.8" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <TextBlock x:Name="txtCount" 
                               Text="3" 
                               FontSize="88" 
                               FontWeight="ExtraBold" 
                               Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Nhãn hướng dẫn -->
            <TextBlock Text="Chuẩn bị ghi hình bài giảng..." 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       Foreground="#F1F5F9" 
                       HorizontalAlignment="Center" 
                       Margin="0,30,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Nhấn ESC hoặc chạm để hủy" 
                       FontSize="13" 
                       Foreground="#94A3B8" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
