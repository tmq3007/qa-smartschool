<Window x:Class="QASmartTouch.Forms.Form2_GraphEditorUnified"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:oxy="http://oxyplot.org/wpf"

        xmlns:helix="http://helix-toolkit.org/wpf"

        xmlns:local="clr-namespace:QASmartTouch.Forms"

        xmlns:models="clr-namespace:QASmartTouch.Models"

        Title="Chức Năng Vẽ Đồ Thị Hàm Số" 

        Width="1600" Height="900"

        WindowStartupLocation="CenterScreen"

        Background="#F8F9FA"

        WindowStyle="SingleBorderWindow"

        ResizeMode="CanResize">



    <Window.Resources>

        <!-- Color to Brush Converter -->

        <local:GraphEditorColorToBrushConverter x:Key="ColorToBrushConverter"/>



        <!-- Function Type to Formula Converter -->

        <local:FunctionTypeToFormulaConverter x:Key="FunctionTypeToFormulaConverter"/>



        <!-- Function Type Enum Values -->

        <ObjectDataProvider x:Key="FunctionTypeValues" 

                           MethodName="GetValues" 

                           ObjectType="{x:Type models:FunctionType}">

            <ObjectDataProvider.MethodParameters>

                <x:Type TypeName="models:FunctionType"/>

            </ObjectDataProvider.MethodParameters>

        </ObjectDataProvider>



        <!-- Mode Button Style -->

        <Style x:Key="ModeButtonStyle" TargetType="Button">

            <Setter Property="Padding" Value="24,12"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Foreground" Value="#495057"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="BorderBrush" Value="#DEE2E6"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                               BorderBrush="{TemplateBinding BorderBrush}"

                               BorderThickness="{TemplateBinding BorderThickness}"

                               CornerRadius="6"

                               Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#E9ECEF"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Modern Button Style -->

        <Style x:Key="ModernButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#0D6EFD"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Padding" Value="8,6"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                               CornerRadius="4"

                               Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#0B5ED7"/>

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background" Value="#0A58CA"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Add Button Style -->

        <Style x:Key="AddButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#0D6EFD"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Padding" Value="16,10"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                               CornerRadius="6"

                               Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#0B5ED7"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Remove Button Style -->

        <Style x:Key="RemoveButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#DC3545"/>

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="FontWeight" Value="Normal"/>

            <Setter Property="Padding" Value="6"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Content" Value="✕"/>

            <Setter Property="Width" Value="28"/>

            <Setter Property="Height" Value="28"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Foreground" Value="#BB2D3B"/>

                    <Setter Property="Background" Value="#F8D7DA"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Insert Button Style -->

        <Style x:Key="InsertButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#198754"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Padding" Value="32,12"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="HorizontalAlignment" Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                               CornerRadius="6"

                               Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#157347"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>



    <Grid Margin="0">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="88"/>

            <ColumnDefinition Width="292"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- LEFT PANEL: Controls -->

        <Border Grid.Column="0" Background="White" 

                BorderBrush="#DEE2E6" BorderThickness="0,0,1,0"

                Padding="20" Grid.ColumnSpan="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>



                    <!-- Title -->

                    <TextBlock Text="Đồ Thị Hàm Số" 

                              FontSize="18" 

                              FontWeight="SemiBold" 

                              Foreground="#212529"

                              Margin="0,0,0,20"/>



                    <!-- Mode Selector -->

                    <Border Background="#F8F9FA" 

                           CornerRadius="8" 

                           Padding="14"

                           Margin="0,0,0,18"

                           BorderBrush="#DEE2E6"

                           BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="Chế Độ Hiển Thị" 

                                      FontSize="12" 

                                      FontWeight="SemiBold"

                                      Foreground="#6C757D"

                                      Margin="0,0,0,10"/>



                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <Button x:Name="btn2DMode" 

                                       Grid.Column="0"

                                       Content="📊 2D" 

                                       Style="{StaticResource ModeButtonStyle}"

                                       Margin="0,0,5,0"

                                       Click="Btn2DMode_Click"/>



                                <Button x:Name="btn3DMode" 

                                       Grid.Column="1"

                                       Content="🎨 3D" 

                                       Style="{StaticResource ModeButtonStyle}"

                                       Margin="5,0,0,0"

                                       Click="Btn3DMode_Click"/>

                            </Grid>

                        </StackPanel>

                    </Border>



                    <!-- Add Graph Button -->

                    <Button x:Name="btnAddGraph"

                           Content="➕ Thêm Hàm Số" 

                           Style="{StaticResource AddButtonStyle}"

                           HorizontalAlignment="Stretch"

                           Margin="0,0,0,18"

                           Click="BtnAddGraph_Click"/>



                    <!-- Graph List -->

                    <TextBlock Text="Danh Sách Hàm Số" 

                              FontSize="12" 

                              FontWeight="SemiBold"

                              Foreground="#6C757D"

                              Margin="0,0,0,10"/>



                    <Border Background="White" 

                           CornerRadius="8" 

                           BorderBrush="#DEE2E6"

                           BorderThickness="1"

                           MaxHeight="380"

                           Margin="0,0,0,18">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <ItemsControl x:Name="graphsList">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="White" 

                                               BorderBrush="#E9ECEF"

                                               BorderThickness="0,0,0,1"

                                               Padding="12,10">

                                            <StackPanel>

                                                <!-- Header -->

                                                <Grid Margin="0,0,0,8">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>



                                                    <CheckBox Grid.Column="0" 

                                                             IsChecked="{Binding IsVisible, Mode=TwoWay}"

                                                             VerticalAlignment="Center"

                                                             Margin="0,0,8,0"/>



                                                    <Border Grid.Column="1" 

                                                           Width="18" Height="18" 

                                                           Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"

                                                           CornerRadius="3"

                                                           Margin="0,0,8,0"/>



                                                    <TextBlock Grid.Column="2" 

                                                              Text="{Binding Id, StringFormat='Hàm số #{0}'}"

                                                              FontSize="12"

                                                              FontWeight="SemiBold"

                                                              Foreground="#212529"

                                                              VerticalAlignment="Center"/>



                                                    <Button Grid.Column="3"

                                                           Content="📊"

                                                           FontSize="14"

                                                           Padding="4"

                                                           Margin="0,0,4,0"

                                                           Background="Transparent"

                                                           BorderThickness="0"

                                                           Foreground="#6C757D"

                                                           Cursor="Hand"

                                                           ToolTip="Xem thông tin toán học"

                                                           Tag="{Binding}"

                                                           Click="BtnShowMathInfo_Click">

                                                        <Button.Style>

                                                            <Style TargetType="Button">

                                                                <Style.Triggers>

                                                                    <Trigger Property="IsMouseOver" Value="True">

                                                                        <Setter Property="Foreground" Value="#0D6EFD"/>

                                                                    </Trigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Button.Style>

                                                    </Button>



                                                    <Button Grid.Column="4"

                                                           Style="{StaticResource RemoveButtonStyle}"

                                                           Tag="{Binding Id}"

                                                           Click="BtnRemoveGraph_Click"/>

                                                </Grid>



                                                <!-- Function Type -->

                                                <ComboBox ItemsSource="{Binding Source={StaticResource FunctionTypeValues}}"

                                                         SelectedItem="{Binding Type, Mode=TwoWay}"

                                                         FontSize="11"

                                                         Padding="8,5"

                                                         Margin="0,0,0,6"

                                                         Background="White"

                                                         Foreground="#212529"

                                                         BorderBrush="#CED4DA"

                                                         BorderThickness="1">

                                                    <ComboBox.ItemTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding Converter={StaticResource FunctionTypeToFormulaConverter}}" 

                                                                      FontFamily="Segoe UI"

                                                                      FontSize="11"/>

                                                        </DataTemplate>

                                                    </ComboBox.ItemTemplate>

                                                </ComboBox>



                                                <!-- Actual Formula Display -->

                                                <Border Background="#F0F4FF" 

                                                       BorderBrush="#B8D4FF" 

                                                       BorderThickness="1" 

                                                       CornerRadius="4" 

                                                       Padding="8,6"

                                                       Margin="0,0,0,10">

                                                    <TextBlock Text="{Binding FormulaString}" 

                                                              Foreground="#0D47A1"

                                                              FontSize="11"

                                                              FontWeight="SemiBold"

                                                              TextWrapping="Wrap"/>

                                                </Border>



                                                <!-- Parameters -->

                                                <StackPanel Margin="0">

                                                    <Grid Margin="0,0,0,8">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="55"/>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="65"/>

                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Foreground="#495057" FontSize="10" VerticalAlignment="Center">

                                                            <Run Text="a = " FontWeight="SemiBold"/>

                                                            <Run Text="{Binding A, StringFormat='{}{0:F1}'}" FontWeight="Bold" Foreground="#0D6EFD"/>

                                                        </TextBlock>

                                                        <Slider Grid.Column="1" Value="{Binding A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-5" Maximum="5" 

                                                               TickFrequency="0.1" IsSnapToTickEnabled="True"

                                                               Margin="8,0,8,0"/>

                                                        <TextBlock Grid.Column="2" Text="[-5 → 5]" Foreground="#ADB5BD" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                    </Grid>



                                                    <Grid Margin="0,0,0,8">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="55"/>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="65"/>

                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Foreground="#495057" FontSize="10" VerticalAlignment="Center">

                                                            <Run Text="b = " FontWeight="SemiBold"/>

                                                            <Run Text="{Binding B, StringFormat='{}{0:F1}'}" FontWeight="Bold" Foreground="#0D6EFD"/>

                                                        </TextBlock>

                                                        <Slider Grid.Column="1" Value="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-5" Maximum="5" 

                                                               TickFrequency="0.1" IsSnapToTickEnabled="True"

                                                               Margin="8,0,8,0"/>

                                                        <TextBlock Grid.Column="2" Text="[-5 → 5]" Foreground="#ADB5BD" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                    </Grid>



                                                    <Grid Margin="0,0,0,8">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="55"/>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="65"/>

                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Foreground="#495057" FontSize="10" VerticalAlignment="Center">

                                                            <Run Text="c = " FontWeight="SemiBold"/>

                                                            <Run Text="{Binding C, StringFormat='{}{0:F1}'}" FontWeight="Bold" Foreground="#0D6EFD"/>

                                                        </TextBlock>

                                                        <Slider Grid.Column="1" Value="{Binding C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-5" Maximum="5" 

                                                               TickFrequency="0.1" IsSnapToTickEnabled="True"

                                                               Margin="8,0,8,0"/>

                                                        <TextBlock Grid.Column="2" Text="[-5 → 5]" Foreground="#ADB5BD" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                    </Grid>



                                                    <Grid Margin="0,0,0,0">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="55"/>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="65"/>

                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Foreground="#495057" FontSize="10" VerticalAlignment="Center">

                                                            <Run Text="d = " FontWeight="SemiBold"/>

                                                            <Run Text="{Binding D, StringFormat='{}{0:F1}'}" FontWeight="Bold" Foreground="#0D6EFD"/>

                                                        </TextBlock>

                                                        <Slider Grid.Column="1" Value="{Binding D, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-5" Maximum="5" 

                                                               TickFrequency="0.1" IsSnapToTickEnabled="True"

                                                               Margin="8,0,8,0"/>

                                                        <TextBlock Grid.Column="2" Text="[-5 → 5]" Foreground="#ADB5BD" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                    </Grid>

                                                </StackPanel>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Border>



                    <!-- Guide Panel -->

                    <Border Background="#E7F5FF" 

                           CornerRadius="8" 

                           Padding="14"

                           Margin="0,0,0,12"

                           BorderBrush="#74C0FC"

                           BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="Hướng Dẫn Sử Dụng" 

                                      FontSize="11" 

                                      FontWeight="SemiBold"

                                      Foreground="#1971C2"

                                      Margin="0,0,0,8"/>



                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" Margin="0,0,0,4" LineHeight="16">

                                • Chuyển đổi giữa chế độ 2D và 3D

                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" Margin="0,0,0,4" LineHeight="16">

                                • Tick/untick để hiện/ẩn hàm số

                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" Margin="0,0,0,4" LineHeight="16">

                                • Điều chỉnh 4 tham số a, b, c, d

                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" Margin="0,0,0,4" LineHeight="16">

                                • 🔍 Zoom: Lăn chuột hoặc Ctrl + Scroll

                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" Margin="0,0,0,4" LineHeight="16">

                                • ↔️ Di chuyển: Kéo chuột phải

                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" Margin="0,0,0,4" LineHeight="16">

                                • 📍 Hover chuột để xem giá trị chính xác

                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" Margin="0,0,0,4" LineHeight="16">

                                • Chế độ 3D: Kéo chuột xoay góc nhìn

                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Foreground="#495057" FontSize="10" LineHeight="16">

                                • Nhấn "Chèn đồ thị lên bảng" để lưu

                            </TextBlock>

                        </StackPanel>

                    </Border>



                    <!-- Math Info Panel -->

                    <Border x:Name="mathInfoPanel"

                           Background="#FFF8E1" 

                           CornerRadius="8" 

                           Padding="14"

                           BorderBrush="#FFD54F"

                           BorderThickness="1"

                           Visibility="Collapsed">

                        <StackPanel>

                            <TextBlock Text="Thông Tin Toán Học" 

                                      FontSize="11" 

                                      FontWeight="SemiBold"

                                      Foreground="#F57F17"

                                      Margin="0,0,0,8"/>



                            <TextBlock x:Name="mathInfoText"

                                      TextWrapping="Wrap" 

                                      Foreground="#5D4037" 

                                      FontSize="10" 

                                      FontFamily="Cambria Math, Segoe UI"

                                      LineHeight="18"/>

                        </StackPanel>

                    </Border>



                </StackPanel>

            </ScrollViewer>

        </Border>



        <!-- RIGHT PANEL: Graph Display -->

        <Grid Grid.Column="2" Background="White">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <!-- Title -->

            <Border Grid.Row="0" 

                    Background="White" 

                    BorderBrush="#DEE2E6"

                    BorderThickness="0,0,0,1"

                    Padding="20,14">

                <TextBlock x:Name="graphTitle"

                          Text="Biểu Đồ 2D" 

                          FontSize="16" 

                          FontWeight="SemiBold" 

                          Foreground="#212529"

                          HorizontalAlignment="Center"/>

            </Border>



            <!-- 2D Plot Container -->

            <Border x:Name="plot2DContainer" 

                   Grid.Row="1"

                   Background="White"

                   BorderBrush="#DEE2E6"

                   BorderThickness="1"

                   CornerRadius="8"

                   Margin="20,16,20,16"

                   Visibility="Visible">

                <Grid>

                    <oxy:PlotView x:Name="GraphPlotView" Background="White"/>



                    <!-- Reset View Button -->

                    <Button Content="🔄 Đặt Lại Khung Nhìn"

                           HorizontalAlignment="Right"

                           VerticalAlignment="Bottom"

                           Margin="0,0,16,16"

                           Padding="10,6"

                           FontSize="10"

                           FontWeight="SemiBold"

                           Background="White"

                           Foreground="#6C757D"

                           BorderBrush="#DEE2E6"

                           BorderThickness="1"

                           Cursor="Hand"

                           Click="BtnResetView_Click">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"

                                                   BorderBrush="{TemplateBinding BorderBrush}"

                                                   BorderThickness="{TemplateBinding BorderThickness}"

                                                   CornerRadius="4"

                                                   Padding="{TemplateBinding Padding}">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="#F8F9FA"/>

                                                    <Setter Property="BorderBrush" Value="#0D6EFD"/>

                                                    <Setter Property="Foreground" Value="#0D6EFD"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </Button.Style>

                    </Button>

                </Grid>

            </Border>



            <!-- 3D Plot Container -->

            <Border x:Name="plot3DContainer"

                   Grid.Row="1"

                   Background="White"

                   BorderBrush="#DEE2E6"

                   BorderThickness="1"

                   CornerRadius="8"

                   Margin="20,16,20,16"

                   Visibility="Collapsed">

                <Grid>

                    <helix:HelixViewport3D x:Name="viewport3D" 

                                          Background="#F8F9FA"

                                          ShowCoordinateSystem="False"

                                          ShowViewCube="True"

                                          CameraRotationMode="Turntable"

                                          ZoomExtentsWhenLoaded="True">

                        <!-- Custom lighting setup for professional appearance -->

                        <ModelVisual3D>

                            <ModelVisual3D.Content>

                                <Model3DGroup>

                                    <!-- Key Light (main light from front-top) -->

                                    <DirectionalLight Color="#B3FFFFFF" Direction="5,5,10"/>



                                    <!-- Fill Light (softer light from back to reduce shadows) -->

                                    <DirectionalLight Color="#4CFFFFFF" Direction="-5,-5,-10"/>



                                    <!-- Rim Light (subtle highlight from side) -->

                                    <DirectionalLight Color="#33FFFFFF" Direction="10,-5,0"/>



                                    <!-- Ambient Light (overall base illumination) -->

                                    <AmbientLight Color="#66FFFFFF"/>

                                </Model3DGroup>

                            </ModelVisual3D.Content>

                        </ModelVisual3D>



                        <ModelVisual3D x:Name="modelContainer"/>

                    </helix:HelixViewport3D>



                    <!-- Toggle Control Panel Button -->

                    <Button x:Name="btnToggleControlPanel"

                           HorizontalAlignment="Left"

                           VerticalAlignment="Top"

                           Margin="250,16,0,0"

                           Width="60"

                           Height="32"

                           Content="◀ Ẩn"

                           FontSize="11"

                           FontWeight="SemiBold"

                           Click="BtnToggleControlPanel_Click"

                           Style="{StaticResource ModernButtonStyle}"

                           ToolTip="Ẩn bảng điều khiển"/>



                    <!-- 3D Controls Panel -->

                    <Border x:Name="controlPanel3D"

                           HorizontalAlignment="Left" 

                           VerticalAlignment="Top" 

                           Margin="16,16,0,0"

                           Background="White"

                           Width="220"

                           MaxHeight="600"

                           BorderBrush="#DEE2E6"

                           BorderThickness="1"

                           CornerRadius="8">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"

                                     HorizontalScrollBarVisibility="Disabled"

                                     Padding="12">

                            <StackPanel>

                                <!-- Title -->

                                <TextBlock Text="Điều Khiển 3D" 

                                          FontSize="12" 

                                          FontWeight="SemiBold"

                                          Foreground="#495057"

                                          Margin="0,0,0,12"/>



                                <!-- Zoom Controls -->

                                <TextBlock Text="Zoom" 

                                          FontSize="10" 

                                          Foreground="#6C757D"

                                          Margin="0,0,0,4"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                    <Button Content="-" 

                                           Width="30" Height="30"

                                           FontSize="16" FontWeight="Bold"

                                           Margin="0,0,4,0"

                                           Click="BtnZoomOut_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Thu nhỏ (Zoom out)"/>

                                    <Slider x:Name="zoomSlider"

                                           Width="110"

                                           Minimum="0.2" Maximum="5.0" Value="1.0"

                                           VerticalAlignment="Center"

                                           ValueChanged="ZoomSlider_ValueChanged"

                                           TickFrequency="0.1" IsSnapToTickEnabled="True"

                                           ToolTip="Kéo để thu phóng"/>

                                    <Button Content="+" 

                                           Width="30" Height="30"

                                           FontSize="16" FontWeight="Bold"

                                           Margin="4,0,0,0"

                                           Click="BtnZoomIn_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Phóng to (Zoom in)"/>

                                </StackPanel>



                                <!-- Rotation X -->

                                <TextBlock Text="↔️ Xoay Trái/Phải (X)" 

                                          FontSize="10" 

                                          Foreground="#6C757D"

                                          Margin="0,0,0,4"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                    <Button Content="◄" 

                                           Width="30" Height="30"

                                           FontSize="12" FontWeight="Bold"

                                           Margin="0,0,4,0"

                                           Click="BtnRotateLeft_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Xoay trái 15°"/>

                                    <Slider x:Name="rotationXSlider"

                                           Width="110"

                                           Minimum="-180" Maximum="180" Value="0"

                                           VerticalAlignment="Center"

                                           ValueChanged="RotationXSlider_ValueChanged"

                                           TickFrequency="15" IsSnapToTickEnabled="True"

                                           ToolTip="Kéo để xoay trái/phải"/>

                                    <Button Content="►" 

                                           Width="30" Height="30"

                                           FontSize="12" FontWeight="Bold"

                                           Margin="4,0,0,0"

                                           Click="BtnRotateRight_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Xoay phải 15°"/>

                                </StackPanel>



                                <!-- Rotation Y -->

                                <TextBlock Text="↕️ Xoay Lên/Xuống (Y)" 

                                          FontSize="10" 

                                          Foreground="#6C757D"

                                          Margin="0,0,0,4"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                    <Button Content="▲" 

                                           Width="30" Height="30"

                                           FontSize="12" FontWeight="Bold"

                                           Margin="0,0,4,0"

                                           Click="BtnRotateUp_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Xoay lên 15°"/>

                                    <Slider x:Name="rotationYSlider"

                                           Width="110"

                                           Minimum="-180" Maximum="180" Value="-30"

                                           VerticalAlignment="Center"

                                           ValueChanged="RotationYSlider_ValueChanged"

                                           TickFrequency="15" IsSnapToTickEnabled="True"

                                           ToolTip="Kéo để xoay lên/xuống"/>

                                    <Button Content="▼" 

                                           Width="30" Height="30"

                                           FontSize="12" FontWeight="Bold"

                                           Margin="4,0,0,0"

                                           Click="BtnRotateDown_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Xoay xuống 15°"/>

                                </StackPanel>



                                <!-- Rotation Z -->

                                <TextBlock Text="Xoay Nghêng (Z)" 

                                          FontSize="10" 

                                          Foreground="#6C757D"

                                          Margin="0,0,0,4"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                    <Button Content="↶" 

                                           Width="30" Height="30"

                                           FontSize="16" FontWeight="Bold"

                                           Margin="0,0,4,0"

                                           Click="BtnRotateCounterClockwise_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Xoay ngược chiều kim đồng hồ 15°"/>

                                    <Slider x:Name="rotationZSlider"

                                           Width="110"

                                           Minimum="-180" Maximum="180" Value="0"

                                           VerticalAlignment="Center"

                                           ValueChanged="RotationZSlider_ValueChanged"

                                           TickFrequency="15" IsSnapToTickEnabled="True"

                                           ToolTip="Kéo để xoay nghêng"/>

                                    <Button Content="↷" 

                                           Width="30" Height="30"

                                           FontSize="16" FontWeight="Bold"

                                           Margin="4,0,0,0"

                                           Click="BtnRotateClockwise_Click"

                                           Style="{StaticResource ModernButtonStyle}"

                                           ToolTip="Xoay cùng chiều kim đồng hồ 15°"/>

                                </StackPanel>



                                <!-- Reset Button (Prominent) -->

                                <Button x:Name="btnResetView"

                                       Content="🔄 Trở Về Mặc Định"

                                       Padding="12,8"

                                       FontSize="11"

                                       FontWeight="Bold"

                                       Click="BtnReset3DView_Click"

                                       Margin="0,8,0,0"

                                       Background="#FEF3C7"

                                       Foreground="#92400E"

                                       BorderBrush="#FCD34D"

                                       BorderThickness="2"

                                       ToolTip="Khôi phục về góc nhìn và zoom mặc định">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"

                                                               BorderBrush="{TemplateBinding BorderBrush}"

                                                               BorderThickness="{TemplateBinding BorderThickness}"

                                                               CornerRadius="6"

                                                               Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="Center" 

                                                                            VerticalAlignment="Center"/>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="IsMouseOver" Value="True">

                                                                <Setter Property="Background" Value="#FDE68A"/>

                                                                <Setter Property="BorderBrush" Value="#F59E0B"/>

                                                                <Setter Property="Cursor" Value="Hand"/>

                                                            </Trigger>

                                                            <Trigger Property="IsPressed" Value="True">

                                                                <Setter Property="Background" Value="#FCD34D"/>

                                                                <Setter Property="BorderBrush" Value="#D97706"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </Button.Style>

                                </Button>



                                <!-- Auto-Rotate Section -->

                                <Border Background="#F0F9FF" 

                                       BorderBrush="#3B82F6" 

                                       BorderThickness="1" 

                                       CornerRadius="4"

                                       Padding="8"

                                       Margin="0,12,0,0">

                                    <StackPanel>

                                        <TextBlock Text="Tự Động Xoay" 

                                                  FontSize="10" 

                                                  FontWeight="SemiBold"

                                                  Foreground="#3B82F6"

                                                  Margin="0,0,0,6"/>



                                        <!-- Toggle Button -->

                                        <Button x:Name="btnToggleAutoRotate"

                                               Content="▶️ Tự Động Xoay"

                                               Padding="8,6"

                                               FontSize="10"

                                               FontWeight="SemiBold"

                                               Click="BtnToggleAutoRotate_Click"

                                               Style="{StaticResource ModernButtonStyle}"

                                               Margin="0,0,0,8"

                                               ToolTip="Bật/tắt chế độ tự động xoay"/>



                                        <!-- Speed Controls -->

                                        <TextBlock Text="Tốc độ X (Trái/Phải):" 

                                                  FontSize="9" 

                                                  Foreground="#6C757D"

                                                  Margin="0,0,0,2"/>

                                        <Slider x:Name="autoRotateSpeedXSlider"

                                               Minimum="-5" Maximum="5" Value="1"

                                               TickFrequency="0.5" 

                                               IsSnapToTickEnabled="True"

                                               ValueChanged="AutoRotateSpeedXSlider_ValueChanged"

                                               Margin="0,0,0,6"

                                               ToolTip="Tốc độ xoay trái/phải (°/khung hình)"/>



                                        <TextBlock Text="Tốc độ Y (Lên/Xuống):" 

                                                  FontSize="9" 

                                                  Foreground="#6C757D"

                                                  Margin="0,0,0,2"/>

                                        <Slider x:Name="autoRotateSpeedYSlider"

                                               Minimum="-5" Maximum="5" Value="0"

                                               TickFrequency="0.5" 

                                               IsSnapToTickEnabled="True"

                                               ValueChanged="AutoRotateSpeedYSlider_ValueChanged"

                                               Margin="0,0,0,6"

                                               ToolTip="Tốc độ xoay lên/xuống (°/khung hình)"/>



                                        <TextBlock Text="Tốc độ Z (Nghiêng):" 

                                                  FontSize="9" 

                                                  Foreground="#6C757D"

                                                  Margin="0,0,0,2"/>

                                        <Slider x:Name="autoRotateSpeedZSlider"

                                               Minimum="-5" Maximum="5" Value="0"

                                               TickFrequency="0.5" 

                                               IsSnapToTickEnabled="True"

                                               ValueChanged="AutoRotateSpeedZSlider_ValueChanged"

                                               ToolTip="Tốc độ xoay nghiêng (°/khung hình)"/>

                                    </StackPanel>

                                </Border>



                                <!-- Mouse Instructions -->

                                <Border Background="#E8F4FD" 

                                       BorderBrush="#0D6EFD" 

                                       BorderThickness="1" 

                                       CornerRadius="4"

                                       Padding="8"

                                       Margin="0,12,0,0">

                                    <StackPanel>

                                        <TextBlock Text="Điều Khiển Bằng Chuột:" 

                                                  FontSize="10" 

                                                  FontWeight="SemiBold"

                                                  Foreground="#0D6EFD"

                                                  Margin="0,0,0,4"/>

                                        <TextBlock Text="🖱️ Kéo chuột trái: Xoay đồ thị" 

                                                  FontSize="9" 

                                                  Foreground="#495057"

                                                  Margin="0,2"/>

                                        <TextBlock Text="🖱️ Cuộn chuột: Zoom in/out" 

                                                  FontSize="9" 

                                                  Foreground="#495057"

                                                  Margin="0,2"/>

                                        <TextBlock Text="Bút cảm ứng: Như chuột" 

                                                  FontSize="9" 

                                                  Foreground="#495057"

                                                  Margin="0,2"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </Border>



            <!-- Insert Button -->

            <Border Grid.Row="2"

                    Background="White"

                    BorderBrush="#DEE2E6"

                    BorderThickness="0,1,0,0"

                    Padding="20,14">

                <Button x:Name="btnInsert"

                       Content="✓ Chèn đồ thị lên bảng" 

                       Style="{StaticResource InsertButtonStyle}"

                       Click="BtnInsert_Click"/>

            </Border>

        </Grid>

    </Grid>

</Window>

