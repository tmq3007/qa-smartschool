<Window x:Class="QASmartTouch.Forms.Form2_TableEditorDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:controls="clr-namespace:QASmartTouch.Controls"

        Title="Chỉnh sửa bảng" 

        Width="900" Height="650"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="CanResize"

        Topmost="True"

        ShowInTaskbar="False"

        WindowStartupLocation="CenterOwner">



    <Border Background="White" 

            CornerRadius="12" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="5" 

                            BlurRadius="20" 

                            Opacity="0.4"/>

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <!-- Header -->

                <RowDefinition Height="*"/>

                <!-- Content -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Border Grid.Row="0" 

                    Background="#2E86DE" 

                    CornerRadius="12,12,0,0"

                    Padding="20,15">

                <Grid>

                    <StackPanel Orientation="Horizontal">

                        <Path Fill="White" 

                              Data="M3,3H21V21H3V3M5,5V9H11V5H5M13,5V9H19V5H13M5,11V15H11V11H5M13,11V15H19V11H13M5,17V19H11V17H5M13,17V19H19V17H13Z"

                              Width="24" Height="24"

                              VerticalAlignment="Center"

                              Margin="0,0,12,0"/>

                        <TextBlock Text="Chỉnh sửa bảng" 

                                  FontSize="18" 

                                  FontWeight="SemiBold" 

                                  Foreground="White"

                                  VerticalAlignment="Center"/>

                    </StackPanel>

                    

                    <Button x:Name="btnClose" 

                           Width="32" Height="32"

                           HorizontalAlignment="Right"

                           Background="#FFFFFF20"

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btnClose_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" 

                                       CornerRadius="6">

                                    <Path Fill="White" 

                                         Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                                         Width="16" Height="16"

                                         Stretch="Uniform"

                                         HorizontalAlignment="Center"

                                         VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Background" Value="#FFFFFF20"/>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#FFFFFF40"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </Grid>

            </Border>



            <!-- CONTENT -->

            <controls:TableEditorControl x:Name="tableEditor" 

                                        Grid.Row="1"

                                        InsertRequested="TableEditor_InsertRequested"

                                        CancelRequested="TableEditor_CancelRequested"/>

        </Grid>

    </Border>

</Window>

