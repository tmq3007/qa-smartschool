<Window x:Class="QASmartTouch.Forms.Form2_23_YouTubeBrowser"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

        Title="YouTube"

        Width="1400" Height="900"

        WindowStartupLocation="CenterScreen"

        Background="#F5F6FA">



    <Window.Resources>

        <!-- Modern Button Style -->

        <Style x:Key="ModernButton" TargetType="Button">

            <Setter Property="Background" Value="#FF0000"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="20,12"/>

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="8"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"

                                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#CC0000"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <!-- Header -->

            <RowDefinition Height="*"/>

            <!-- WebView -->

            <RowDefinition Height="Auto"/>

            <!-- Footer -->

        </Grid.RowDefinitions>



        <!-- Header -->

        <Border Grid.Row="0" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">

            <Grid Margin="20,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <!-- Title -->

                <StackPanel Grid.Column="0" Orientation="Horizontal">

                    <TextBlock Text="📺" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel>

                        <TextBlock Text="YouTube"

                                   FontSize="18"

                                   FontWeight="Bold"

                                   Foreground="#2F3542"/>

                        <TextBlock Text="Xem và tìm kiếm video giáo dục"

                                   FontSize="12"

                                   Foreground="#747D8C"

                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>



                <!-- Close Button -->

                <Button x:Name="btnClose"

                        Grid.Column="1"

                        Content="✕"

                        Width="36" Height="36"

                        FontSize="18"

                        FontWeight="Bold"

                        Background="#EE5A6F"

                        Foreground="White"

                        BorderThickness="0"

                        Cursor="Hand"

                        Click="btnClose_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"

                                    CornerRadius="18">

                                <ContentPresenter HorizontalAlignment="Center"

                                                VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Background" Value="#EE5A6F"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter Property="Background" Value="#D63447"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

            </Grid>

        </Border>



        <!-- WebView2 Container -->

        <Border Grid.Row="1" Background="White" Margin="10">

            <Grid>

                <!-- Loading Indicator -->

                <Border x:Name="LoadingPanel"

                        Background="White"

                        Visibility="Visible">

                    <StackPanel HorizontalAlignment="Center"

                                VerticalAlignment="Center">

                        <TextBlock Text="⏳"

                                   FontSize="48"

                                   HorizontalAlignment="Center"

                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Đang tải YouTube..."

                                   FontSize="16"

                                   Foreground="#747D8C"

                                   HorizontalAlignment="Center"/>

                        <ProgressBar IsIndeterminate="True"

                                     Width="200"

                                     Height="4"

                                     Margin="0,15,0,0"

                                     Foreground="#FF0000"/>

                    </StackPanel>

                </Border>



                <!-- WebView2 -->

                <wv2:WebView2 x:Name="webView"

                              Source="https://www.youtube.com/"

                              NavigationCompleted="WebView_NavigationCompleted"/>

            </Grid>

        </Border>



        <!-- Footer Actions -->

        <Border Grid.Row="2" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,1,0,0">

            <Grid Margin="20,15">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Selected Video Info (Hidden by default) -->

                <Border x:Name="SelectedVideoPanel"

                        Grid.Row="0"

                        Background="#FFEBEE"

                        BorderBrush="#FF0000"

                        BorderThickness="2"

                        CornerRadius="8"

                        Padding="15,10"

                        Margin="0,0,0,10"

                        Visibility="Collapsed">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>



                        <!-- Video Icon -->

                        <Border Grid.Column="0"

                                Width="60" Height="60"

                                Background="#FF0000"

                                CornerRadius="8"

                                Margin="0,0,15,0">

                            <TextBlock Text="▶"

                                       FontSize="32"

                                       Foreground="White"

                                       HorizontalAlignment="Center"

                                       VerticalAlignment="Center"/>

                        </Border>



                        <!-- Video Info -->

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                            <TextBlock Text="Đã chọn video"

                                     FontSize="12"

                                     FontWeight="Bold"

                                     Foreground="#C62828"/>

                            <TextBlock x:Name="SelectedVideoTitle"

                                     Text="Tiêu đề video sẽ hiển thị ở đây"

                                     FontSize="11"

                                     Foreground="#666"

                                     TextTrimming="CharacterEllipsis"

                                     Margin="0,2,0,0"/>

                            <TextBlock x:Name="SelectedVideoUrl"

                                     Text="URL sẽ hiển thị ở đây"

                                     FontSize="10"

                                     Foreground="#999"

                                     TextTrimming="CharacterEllipsis"

                                     Margin="0,2,0,0"/>

                        </StackPanel>



                        <!-- Insert Button -->

                        <Button x:Name="btnInsertVideo"

                                Grid.Column="2"

                                Content="📥 Chèn vào bảng"

                                Width="140"

                                Height="50"

                                Background="#FF0000"

                                Foreground="White"

                                FontSize="14"

                                FontWeight="Bold"

                                BorderThickness="0"

                                Cursor="Hand"

                                Click="btnInsertVideo_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"

                                            CornerRadius="8"

                                            Padding="15,10">

                                        <ContentPresenter HorizontalAlignment="Center"

                                                        VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Background" Value="#FF0000"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="Background" Value="#CC0000"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                        </Button>

                    </Grid>

                </Border>



                <!-- Default Info & Done Button -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <!-- Info Text -->

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">

                        <TextBlock Text="Mẹo: Chạm vào video để chọn, sau đó nhấn 'Chèn vào bảng'"

                                   FontSize="12"

                                   Foreground="#747D8C"/>

                        <TextBlock Text="Video sẽ được nhúng vào giữa bảng với YouTube player"

                                   FontSize="11"

                                   Foreground="#95A5A6"

                                   Margin="0,2,0,0"/>

                    </StackPanel>



                    <!-- Done Button -->

                    <Button x:Name="btnDone"

                            Grid.Column="1"

                            Content="✓ Hoàn tất"

                            Width="120"

                            Background="#FF0000"

                            Click="btnDone_Click">

                        <Button.Style>

                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">

                                <Setter Property="Background" Value="#FF0000"/>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#CC0000"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>

