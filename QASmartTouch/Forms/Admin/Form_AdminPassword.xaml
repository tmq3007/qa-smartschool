<Window x:Class="QASmartTouch.Forms.Admin.Form_AdminPassword"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Admin Authentication" 

        Width="380" Height="280"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        WindowStartupLocation="CenterScreen"

        Topmost="True">



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#888888" 

                            Direction="270" 

                            ShadowDepth="5" 

                            BlurRadius="20" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid Margin="20">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <!-- Header -->

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">

                <TextBlock Text="🔐" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Admin Authentication" 

                              FontSize="18" 

                              FontWeight="Bold" 

                              Foreground="#2F3542"/>

                    <TextBlock Text="Vui lòng nhập mật khẩu quản trị" 

                              FontSize="12" 

                              Foreground="#888"/>

                </StackPanel>

            </StackPanel>



            <!-- Password Input -->

            <Border Grid.Row="1" 

                   Background="#F8F9FA" 

                   CornerRadius="10" 

                   Padding="12" 

                   Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="Mật khẩu Admin:" 

                              FontWeight="SemiBold" 

                              Foreground="#555" 

                              Margin="0,0,0,6"/>

                    <PasswordBox x:Name="txtPassword" 

                                Height="36" 

                                FontSize="14"

                                Padding="10,8"

                                VerticalContentAlignment="Center"/>

                </StackPanel>

            </Border>



            <!-- Remember Me -->

            <CheckBox x:Name="chkRemember" 

                     Grid.Row="2" 

                     Content="Ghi nhớ trong phiên làm việc này" 

                     Foreground="#666"

                     Margin="0,0,0,10"/>



            <!-- Error Message -->

            <TextBlock x:Name="txtError" 

                      Grid.Row="3" 

                      Text="" 

                      Foreground="#EE5A6F" 

                      FontWeight="SemiBold"

                      HorizontalAlignment="Center"

                      Margin="0,0,0,10"/>



            <!-- Buttons -->

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="btnCancel" 

                       Content="❌ Hủy"

                       Width="100" Height="36"

                       Background="#F0F0F0"

                       Foreground="#555"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnCancel_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="8">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

                

                <Button x:Name="btnLogin" 

                       Content="🔓 Xác nhận"

                       Width="120" Height="36"

                       Margin="10,0,0,0"

                       Background="#4CAF50"

                       Foreground="White"

                       FontWeight="SemiBold"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnLogin_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="8">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</Window>

