<Window x:Class="QASmartTouch.Forms.Form2_24_PhETCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Học Liệu Mô Phỏng GDPT 2018 (PhET &amp; STEM)"
        Width="1280" Height="820"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F4F7F6"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid>
        <!-- ==================== 1. GIAO DIỆN DANH MỤC THƯ VIỆN ==================== -->
        <Grid x:Name="viewLibrary" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                <RowDefinition Height="*"/>    <!-- Cards List -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#168B82" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌍" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Học Liệu Mô Phỏng GDPT 2018 (PhET &amp; STEM)" 
                                       FontSize="20" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Border Background="#26A69A" CornerRadius="12" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtTotalBadge" Text="98 Mô Phỏng Chuẩn SGK" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Thư viện mô phỏng tương tác trực quan theo chương trình GDPT 2018 các môn Toán, Vật lý, Hóa học, Sinh học"
                                   FontSize="12" Foreground="#B2DFDB" Margin="34,4,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnCloseLibrary"
                            Grid.Column="1"
                            Width="44" Height="44"
                            Background="#D32F2F"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Search & Filters -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Border Background="#F5F7F8" CornerRadius="8" BorderBrush="#B2DFDB" BorderThickness="1" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="15" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtSearch" Grid.Column="1"
                                         FontSize="14" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center"
                                         TextChanged="txtSearch_TextChanged"/>
                                <TextBlock x:Name="txtSearchPlaceholder" Grid.Column="1" 
                                           Text="Tìm kiếm mô phỏng theo tên bài, chủ đề (phân số, parabol, con lắc, mạch điện, nguyên tử, gene...)"
                                           FontSize="13" Foreground="#9E9E9E" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="btnClearSearch" Grid.Column="2" Content="✕" Width="24" Height="24"
                                        Background="Transparent" BorderThickness="0" Foreground="#757575"
                                        Cursor="Hand" Visibility="Collapsed" Click="btnClearSearch_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Filter Pills Row (Subject Pills + Level Pills) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Subject Pills -->
                            <StackPanel x:Name="pnlSubjectCategories" Orientation="Horizontal"/>

                            <Border Width="1" Height="24" Background="#CFD8DC" Margin="10,0,14,0" VerticalAlignment="Center"/>

                            <!-- Level Pills -->
                            <StackPanel x:Name="pnlLevelCategories" Orientation="Horizontal"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Cards Container -->
            <ScrollViewer Grid.Row="2" Padding="24,16" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="pnlCards" Orientation="Horizontal" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 2. GIAO DIỆN TRÌNH PHÁT MÔ PHỎNG ==================== -->
        <Grid x:Name="viewPlayer" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar -->
                <RowDefinition Height="*"/>    <!-- Simulation Area -->
            </Grid.RowDefinitions>

            <!-- Top Control Bar -->
            <Border Grid.Row="0" Background="#004D40" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back Button -->
                    <Button x:Name="btnBackToLibrary" Grid.Column="0"
                            Padding="14,8" Background="#00796B" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="btnBackToLibrary_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="←" FontSize="16" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock Text="Danh mục học liệu" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Active Title -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock x:Name="txtPlayerTitle" Text="Mô phỏng PhET"
                                   FontSize="15" FontWeight="Bold" Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="txtPlayerCategory" Text="Môn học · GDPT 2018"
                                   FontSize="11" Foreground="#80CBC4"/>
                    </StackPanel>

                    <!-- Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Ghim vào bảng -->
                        <Button x:Name="btnPinToBoard"
                                Padding="12,8" Background="#43A047" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="Ghim mô phỏng đang chạy thành cửa sổ tương tác trực tiếp trên bảng vẽ"
                                Click="btnPinToBoard_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📌" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Ghim lên bảng" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Tải lại -->
                        <Button x:Name="btnReload"
                                Width="38" Height="36" Background="#546E7A" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="Tải lại mô phỏng"
                                Click="btnReload_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="↺" FontSize="16" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Đóng -->
                        <Button x:Name="btnClosePlayer"
                                Width="38" Height="36" Background="#D32F2F" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView Area -->
            <Grid Grid.Row="1" Background="#1E1E1E">
                <wv2:WebView2 x:Name="webViewPlayer"/>

                <!-- Player Loading Overlay -->
                <Border x:Name="playerLoadingOverlay" Background="#004D40" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🌍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Đang khởi tạo mô phỏng PhET..."
                                   FontSize="16" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Đang tải học liệu tương tác chuẩn GDPT 2018 (HTML5)"
                                   FontSize="12" Foreground="#80CBC4"
                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

