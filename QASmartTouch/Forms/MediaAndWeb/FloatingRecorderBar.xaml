<Window x:Class="QASmartTouch.Forms.FloatingRecorderBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghi hình bài giảng"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Inter, Arial, sans-serif"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Style cho các nút điều khiển trên thanh ghi hình -->
        <Style x:Key="RecorderControlBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style đặc biệt cho nút Dừng & Lưu (Nổi bật màu đỏ) -->
        <Style x:Key="RecorderStopBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1.5"
                CornerRadius="26"
                Padding="14,6">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A"
                                  Direction="270"
                                  ShadowDepth="5"
                                  BlurRadius="16"
                                  Opacity="0.45"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Icon Grip / Handle kéo thả -->
                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.5" Cursor="SizeAll">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#94A3B8" Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z"/>
                    </Canvas>
                </Viewbox>

                <!-- Đèn tín hiệu nhấp nháy REC -->
                <Ellipse x:Name="recDot"
                         Width="10" Height="10"
                         Fill="#EF4444"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center"/>

                <TextBlock x:Name="txtRecLabel"
                           Text="REC"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#EF4444"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- Bộ đếm thời gian (Định dạng hh:mm:ss hoặc mm:ss) -->
                <TextBlock x:Name="txtDuration"
                           Text="00:00:00"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F8FAFC"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           FontFamily="Consolas, Segoe UI, sans-serif"/>

                <!-- Đường kẻ phân cách dọc -->
                <Border Width="1" Height="22" Background="#334155" Margin="0,0,10,0"/>

                <!-- Nút Tạm dừng / Tiếp tục -->
                <Button x:Name="btnPauseResume"
                        Style="{StaticResource RecorderControlBtn}"
                        Click="btnPauseResume_Click"
                        ToolTip="Tạm dừng / Tiếp tục ghi">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="iconPauseResume" Fill="#F8FAFC" Data="M14,19H18V5H14M6,19H10V5H6V19Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Nút Bật / Tắt Mic nhanh -->
                <Button x:Name="btnToggleMic"
                        Style="{StaticResource RecorderControlBtn}"
                        Click="btnToggleMic_Click"
                        ToolTip="Bật / Tắt Microphone">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="iconMic" Fill="#F8FAFC" Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Nút Ẩn / Hiện Camera nhanh -->
                <Button x:Name="btnToggleCam"
                        Style="{StaticResource RecorderControlBtn}"
                        Click="btnToggleCam_Click"
                        ToolTip="Ẩn / Hiện Camera giáo viên">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="iconCam" Fill="#F8FAFC" Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Nút Dừng & Lưu (Màu đỏ nổi bật) -->
                <Button x:Name="btnStop"
                        Style="{StaticResource RecorderStopBtn}"
                        Click="btnStop_Click"
                        ToolTip="Dừng ghi &amp; Lưu video">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#FFFFFF" Data="M18,18H6V6H18V18Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Nút Mở thư mục Video -->
                <Button x:Name="btnOpenFolder"
                        Style="{StaticResource RecorderControlBtn}"
                        Click="btnOpenFolder_Click"
                        ToolTip="Mở thư mục video đã lưu">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#94A3B8" Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Nút Hủy / Đóng -->
                <Button x:Name="btnCancel"
                        Style="{StaticResource RecorderControlBtn}"
                        Click="btnCancel_Click"
                        ToolTip="Hủy phiên quay">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#94A3B8" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
