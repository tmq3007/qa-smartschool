<Window x:Class="QASmartTouch.Forms.Form2_26_YooBookBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YooBook - Kho Học Liệu Số 3D/XR &amp; Phòng Thí Nghiệm Ảo"
        Width="1280" Height="820"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="White"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Window.Resources>
        <!-- Style cho nút Chuyên mục nhanh (Chuẩn cảm ứng 86 inch) -->
        <Style x:Key="CategoryPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#CCFBF1"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#99F6E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút điều hướng dưới Footer -->
        <Style x:Key="FooterActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/> <!-- Row 0: Header -->
            <RowDefinition Height="52"/> <!-- Row 1: Quick Category Bar (Kho dữ liệu) -->
            <RowDefinition Height="*"/>  <!-- Row 2: WebView2 Kho dữ liệu 3D -->
            <RowDefinition Height="66"/> <!-- Row 3: Footer Controls -->
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: HEADER ==================== -->
        <Border Grid.Row="0" Background="#0F766E" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon 3D Cube -->
                    <Path Fill="White"
                          Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z"
                          Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>

                    <TextBlock Text="Kho Học Liệu 3D &amp; Phòng Thí Nghiệm Ảo YooBook"
                               FontSize="17" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <Border Background="#115E59" CornerRadius="6" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtStatusBadge"
                                   Text="Chế độ: Chỉ hiển thị Kho dữ liệu"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#99F6E4"/>
                    </Border>
                </StackPanel>

                <!-- Cụm nút bên phải Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnConfigAccount"
                            Style="{StaticResource FooterActionButtonStyle}"
                            Height="38" Padding="14,0" Margin="0,0,12,0"
                            Background="#134E4A" BorderBrush="#2DD4BF" BorderThickness="1"
                            Click="btnConfigAccount_Click"
                            ToolTip="Cấu hình Tài khoản Demo tự động đăng nhập hoặc Partner API Key">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#5EEAD4"
                                  Data="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Tài khoản Demo / API" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnClose"
                            Width="40" Height="40"
                            Background="#E11D48"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            Stylus.IsPressAndHoldEnabled="False"
                            Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <Path Fill="White"
                                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: QUICK CATEGORY BAR (CHỈ DUYỆT KHO DỮ LIỆU) ==================== -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Danh mục kho:" FontSize="12.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button x:Name="btnCatAll"
                            Content="📚 Tất cả học liệu"
                            Style="{StaticResource CategoryPillButtonStyle}"
                            Click="btnCatAll_Click"/>

                    <Button x:Name="btnCatVirtualLab"
                            Content="🧪 Kho thí nghiệm K12"
                            Style="{StaticResource CategoryPillButtonStyle}"
                            Click="btnCatVirtualLab_Click"/>

                    <Button x:Name="btnCat3DScene"
                            Content="🧊 Cảnh 3D theo bài K12"
                            Style="{StaticResource CategoryPillButtonStyle}"
                            Click="btnCat3DScene_Click"/>

                    <Button x:Name="btnCatNaturalSci"
                            Content="🔬 Khoa học tự nhiên"
                            Style="{StaticResource CategoryPillButtonStyle}"
                            Click="btnCatNaturalSci_Click"/>

                    <Button x:Name="btnCatSocialSci"
                            Content="🌍 Khoa học xã hội"
                            Style="{StaticResource CategoryPillButtonStyle}"
                            Click="btnCatSocialSci_Click"/>

                    <Button x:Name="btnCatSandbox"
                            Content="🛠️ STEM &amp; Sandbox 3D"
                            Style="{StaticResource CategoryPillButtonStyle}"
                            Click="btnCatSandbox_Click"/>

                    <Button x:Name="btnCatCulture"
                            Content="🏛️ Văn hóa - Lịch sử"
                            Style="{StaticResource CategoryPillButtonStyle}"
                            Click="btnCatCulture_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== ROW 2: WEBVIEW2 & CONFIG OVERLAY ==================== -->
        <Border Grid.Row="2" Background="White">
            <Grid>
                <!-- WebView2 Control (luôn giữ Visible để tránh lỗi render của nhân Chromium) -->
                <wv2:WebView2 x:Name="webView" Visibility="Visible"/>

                <!-- Lớp phủ Loading khi đang tải hoặc đang Tự động đăng nhập -->
                <Border x:Name="loadingPanel"
                        Background="#F8FAFC"
                        Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="34" Background="#CCFBF1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Fill="#0F766E"
                                  Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z"
                                  Width="34" Height="34" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtLoadingTitle"
                                   Text="Đang mở Kho dữ liệu 3D YooBook..."
                                   FontSize="16" FontWeight="Bold" Foreground="#0F172A"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtLoadingSubtitle"
                                   Text="Vui lòng đợi trong giây lát..."
                                   FontSize="13" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Hộp thoại cấu hình Tài khoản Demo Tự động đăng nhập & Partner API Key -->
                <Border x:Name="configOverlay"
                        Background="#990F172A"
                        Visibility="Collapsed">
                    <Border Width="540"
                            Background="White"
                            CornerRadius="14"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Padding="24"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="🔑 Cấu hình Tài khoản Demo &amp; Cổng API YooBook"
                                       FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                            <TextBlock Text="Khi điền tài khoản Demo dưới đây (hoặc điền hằng số DEFAULT_DEMO_USERNAME trong YooBookPartnerApiService.cs), phần mềm sẽ tự động đăng nhập mặc định và chỉ hiển thị duy nhất trang Kho dữ liệu."
                                       FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="1. Tài khoản Demo YooBook (Email hoặc Số điện thoại):"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtDemoUsername"
                                     Height="38" Padding="10,6" FontSize="13.5"
                                     BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12"/>

                            <TextBlock Text="2. Mật khẩu Tài khoản Demo:"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="pwdDemoPassword"
                                         Height="38" Padding="10,6" FontSize="13.5"
                                         BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,14"/>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="3. Mã X-Api-Key Đối tác B2B (Tùy chọn - nếu YooTek cấp khóa API riêng):"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtPartnerApiKey"
                                                 Grid.Column="0" Height="34" Padding="8,4" FontSize="12.5"
                                                 BorderBrush="#CBD5E1" BorderThickness="1"/>
                                        <Button x:Name="btnTestApiKey"
                                                Grid.Column="1" Content="Kiểm tra API"
                                                Style="{StaticResource FooterActionButtonStyle}"
                                                Height="34" Padding="12,0" Margin="8,0,0,0"
                                                Background="#0284C7" Foreground="White" BorderThickness="0"
                                                FontSize="12" FontWeight="SemiBold"
                                                Click="btnTestApiKey_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="txtApiTestResult"
                                               Text="" FontSize="11.5" Foreground="#0F766E"
                                               TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button x:Name="btnCancelConfig"
                                        Content="Đóng"
                                        Style="{StaticResource FooterActionButtonStyle}"
                                        Height="38" Width="90" Margin="0,0,10,0"
                                        Background="#E2E8F0" Foreground="#334155" BorderThickness="0"
                                        FontSize="13" FontWeight="SemiBold"
                                        Click="btnCancelConfig_Click"/>

                                <Button x:Name="btnSaveAndLogin"
                                        Content="Lưu &amp; Tự động đăng nhập ngay"
                                        Style="{StaticResource FooterActionButtonStyle}"
                                        Height="38" Padding="18,0"
                                        Background="#0F766E" Foreground="White" BorderThickness="0"
                                        FontSize="13" FontWeight="SemiBold"
                                        Click="btnSaveAndLogin_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== ROW 3: FOOTER CONTROLS ==================== -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <!-- Cụm nút điều hướng bên trái -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="btnBack"
                            Style="{StaticResource FooterActionButtonStyle}"
                            Width="115" Margin="0,0,10,0"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                            Click="btnBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#334155"
                                  Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Quay lại" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnRefresh"
                            Style="{StaticResource FooterActionButtonStyle}"
                            Width="110" Margin="0,0,10,0"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                            Click="btnRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#334155"
                                  Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Tải lại" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnHomeExplore"
                            Style="{StaticResource FooterActionButtonStyle}"
                            Padding="14,0"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                            Click="btnHomeExplore_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#0F766E"
                                  Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Về Kho dữ liệu" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Cụm nút tương tác với Bảng viết bên phải -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnEmbed"
                            Style="{StaticResource FooterActionButtonStyle}"
                            Padding="18,0"
                            Background="#2563EB" BorderThickness="0"
                            Click="btnEmbed_Click"
                            ToolTip="Nhúng trực tiếp khung mô hình 3D / thí nghiệm hiện tại lên mặt bảng viết">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="White"
                                  Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                  Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Nhúng vào bảng" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

