<Window x:Class="QASmartTouch.Forms.Form2_6_SubMenuSelectionRecognition"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn vùng" 
        Width="420" Height="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Window.Resources>
        <!-- Style thống nhất cho các nút công cụ chọn vùng (Touch Friendly IFP) -->
        <Style x:Key="SelectionToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E86DE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="15" 
            BorderBrush="#E1E8ED" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC" 
                            Direction="270" 
                            ShadowDepth="3" 
                            BlurRadius="15" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#2E86DE" 
                                  Data="M18,14H10.5L12.5,12H18M6,14V11.5L12.88,4.64C13.07,4.45 13.39,4.45 13.59,4.64L15.35,6.41C15.55,6.61 15.55,6.92 15.35,7.12L8.47,14M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Chọn vùng" 
                               FontSize="15" 
                               FontWeight="Bold" 
                               Foreground="#2F3542"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnClose" 
                        Style="{StaticResource CloseButton}"
                        Click="btnClose_Click"/>
            </Grid>

            <!-- CONTENT: 3 Cột cân đối cho Chữ nhật, Tự do (Lasso) và Đũa phép -->
            <Grid Grid.Row="1">
                <UniformGrid Columns="3" Rows="1">
                    <!-- Nút Chọn chữ nhật -->
                    <Button x:Name="btnSelectRect" 
                            Style="{StaticResource SelectionToolButtonStyle}"
                            Click="btnSelectRect_Click"
                            ToolTip="Chọn đối tượng bằng khung hình chữ nhật">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#2196F3" 
                                          Data="M3,3H21V21H3V3M5,5V19H19V5H5Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Chữ nhật" 
                                       FontSize="12.5" 
                                       FontWeight="SemiBold"
                                       Foreground="#2F3542"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Chọn tự do (Lasso) -->
                    <Button x:Name="btnSelectLasso" 
                            Style="{StaticResource SelectionToolButtonStyle}"
                            Click="btnSelectLasso_Click"
                            ToolTip="Khoanh vùng tự do quanh các đối tượng cần chọn (Lasso)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#20BF6B" 
                                          Data="M15.44,13.5C16.4,12.61 17,11.36 17,10C17,7.24 14.76,5 12,5C9.24,5 7,7.24 7,10C7,11.36 7.6,12.61 8.56,13.5C6.1,14.63 4.28,17.07 4.04,20H6.06C6.34,17.78 7.91,15.93 10,15.35V17H14V15.35C16.09,15.93 17.66,17.78 17.94,20H19.96C19.72,17.07 17.9,14.63 15.44,13.5M12,7C13.66,7 15,8.34 15,10C15,11.66 13.66,13 12,13C10.34,13 9,11.66 9,10C9,8.34 10.34,7 12,7Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Tự do" 
                                       FontSize="12.5" 
                                       FontWeight="SemiBold"
                                       Foreground="#2F3542"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Chọn đũa phép (Chọn cùng màu) -->
                    <Button x:Name="btnSelectMagic" 
                            Style="{StaticResource SelectionToolButtonStyle}"
                            Click="btnSelectMagic_Click"
                            ToolTip="Tự động chọn tất cả đối tượng CÙNG MÀU trên bảng">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#9C27B0" 
                                          Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4,23.1 3.63,22.71L1.29,20.37C0.9,20 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Đũa phép" 
                                       FontSize="12.5" 
                                       FontWeight="SemiBold"
                                       Foreground="#2F3542"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- =========================================================================
                     TẠM ẨN: Các tính năng AI/OCR chưa kích hoạt (bảo toàn code-behind)
                ========================================================================= -->
                <StackPanel Visibility="Collapsed">
                    <Button x:Name="btnOCR" Click="btnOCR_Click"/>
                    <Button x:Name="btnTranslate" Click="btnTranslate_Click"/>
                    <Button x:Name="btnTextToSpeech" Click="btnTextToSpeech_Click"/>
                    <Button x:Name="btnSearch" Click="btnSearch_Click"/>
                    <Button x:Name="btnAIChat" Click="btnAIChat_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
