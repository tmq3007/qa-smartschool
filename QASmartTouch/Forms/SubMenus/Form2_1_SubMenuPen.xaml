<Window x:Class="QASmartTouch.Forms.Form2_1_SubMenuPen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Công cụ Bút viết" 
        Width="320" Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Style tùy chỉnh cho các nút chọn màu để không bị mất màu khi click/hover -->
        <Style x:Key="ColorPaletteButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#2E86DE"/>
                                <Setter TargetName="buttonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#2E86DE"/>
                                <Setter TargetName="buttonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="14" 
            BorderBrush="#E1E8ED" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#888888" 
                              Direction="270" 
                              ShadowDepth="3" 
                              BlurRadius="12" 
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Brush Types -->
                <RowDefinition Height="Auto"/> <!-- 2: Pen Size -->
                <RowDefinition Height="Auto"/> <!-- 3: Colors -->
                <RowDefinition Height="Auto"/> <!-- 4: Preview -->
                <RowDefinition Height="Auto"/> <!-- 5: Footer -->
            </Grid.RowDefinitions>

            <!-- 0: HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Fill="#2E86DE" 
                          Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                    <TextBlock Text="Công cụ Bút viết" 
                              FontSize="14" 
                              FontWeight="Bold" 
                              Foreground="#2F3542"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnClose" 
                        Style="{StaticResource CloseButton}"
                        Click="btnClose_Click"/>
            </Grid>

            <!-- 1: BRUSH TYPES (Single horizontal row of 4 buttons) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="Loại bút" 
                          FontSize="11" 
                          FontWeight="SemiBold" 
                          Foreground="#57606F"
                          Margin="0,0,0,4"/>

                <UniformGrid Rows="1" Columns="4">
                    <!-- 1. Bút viết bảng (Normal) -->
                    <Button x:Name="btnBrushNormal"
                            Height="46" Margin="2"
                            Background="#FFF4E6" BorderThickness="0" Cursor="Hand"
                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"
                            Tag="Normal" ToolTip="Bút viết thường">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="18" Height="18" Margin="0,0,0,2">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#FFA500" Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Bút viết" FontSize="10" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. Bút nhận diện hình (Shape) -->
                    <Button x:Name="btnBrushShape"
                            Height="46" Margin="2"
                            Background="#F3E5F5" BorderThickness="0" Cursor="Hand"
                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"
                            Tag="Shape" ToolTip="Bút nhận diện hình học">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="18" Height="18" Margin="0,0,0,2">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#AB47BC" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Bút hình" FontSize="10" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 3. Bút dạ quang (Highlighter) -->
                    <Button x:Name="btnBrushHighlighter"
                            Height="46" Margin="2"
                            Background="#FFFDE7" BorderThickness="0" Cursor="Hand"
                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"
                            Tag="Highlighter" ToolTip="Bút dạ quang đánh dấu">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="18" Height="18" Margin="0,0,0,2">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#FBC02D" Data="M18.5,1.15C17.97,1.15 17.46,1.34 17.07,1.73L11.26,7.55L16.91,13.2L22.73,7.39C23.5,6.61 23.5,5.35 22.73,4.56L19.89,1.73C19.5,1.34 19,1.15 18.5,1.15M10.3,8.5L4.41,14.39L4.37,14.43L4.35,14.45C4.16,14.65 4.05,14.91 4.05,15.19C4.05,15.46 4.16,15.72 4.35,15.92L6.12,17.69C6.31,17.88 6.57,17.99 6.84,17.99C7.12,17.99 7.38,17.88 7.57,17.69L7.59,17.67L7.64,17.63L13.5,11.7L10.3,8.5M2,21.5H10L8,19.5H4L2,21.5Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Dạ quang" FontSize="10" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. Bút laser (Laser) -->
                    <Button x:Name="btnBrushLaser"
                            Height="46" Margin="2"
                            Background="#FFEBEE" BorderThickness="0" Cursor="Hand"
                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"
                            Tag="Laser" ToolTip="Bút laser tự xóa">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="18" Height="18" Margin="0,0,0,2">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#E53935" Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10.02 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4.02,23.1 3.63,22.71L1.29,20.37C0.9,19.98 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 13.98,6.9 14.37,7.29Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Laser" FontSize="10" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <!-- 2: PEN SIZE -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Kích thước nét" 
                          FontSize="11" 
                          FontWeight="SemiBold" 
                          Foreground="#57606F"
                          Margin="0,0,0,2"/>

                <Slider x:Name="sliderPenSize" 
                        Minimum="1" Maximum="16" 
                        Value="5" 
                        TickFrequency="1" 
                        IsSnapToTickEnabled="True" 
                        ValueChanged="sliderPenSize_ValueChanged" 
                        Height="22"/>

                <UniformGrid x:Name="panelSizeIndicators" 
                            Rows="1" Columns="16" 
                            Height="10" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 3: PEN COLOR (High-Contrast Educational Palette: 2x6 grid) -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="Màu bút" 
                          FontSize="11" 
                          FontWeight="SemiBold" 
                          Foreground="#57606F"
                          Margin="0,0,0,4"/>

                <UniformGrid Rows="2" Columns="6" Height="56">
                    <!-- Row 1: 6 màu cơ bản thiết yếu -->
                    <Button Background="#FFFFFF" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#BDC3C7" BorderThickness="1" Click="btnColor_Click" Tag="#FFFFFF" Margin="2" Cursor="Hand" ToolTip="Trắng"/>
                    <Button Background="#000000" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#333333" BorderThickness="1" Click="btnColor_Click" Tag="#000000" Margin="2" Cursor="Hand" ToolTip="Đen"/>
                    <Button Background="#FF0000" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#FF0000" BorderThickness="1" Click="btnColor_Click" Tag="#FF0000" Margin="2" Cursor="Hand" ToolTip="Đỏ"/>
                    <Button Background="#F1C40F" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#F1C40F" BorderThickness="1" Click="btnColor_Click" Tag="#F1C40F" Margin="2" Cursor="Hand" ToolTip="Vàng tươi"/>
                    <Button Background="#2980B9" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#2980B9" BorderThickness="1" Click="btnColor_Click" Tag="#2980B9" Margin="2" Cursor="Hand" ToolTip="Xanh dương"/>
                    <Button Background="#27AE60" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#27AE60" BorderThickness="1" Click="btnColor_Click" Tag="#27AE60" Margin="2" Cursor="Hand" ToolTip="Xanh lá"/>

                    <!-- Row 2: 6 màu bổ trợ tiêu chuẩn -->
                    <Button Background="#E67E22" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#E67E22" BorderThickness="1" Click="btnColor_Click" Tag="#E67E22" Margin="2" Cursor="Hand" ToolTip="Cam"/>
                    <Button Background="#8E44AD" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#8E44AD" BorderThickness="1" Click="btnColor_Click" Tag="#8E44AD" Margin="2" Cursor="Hand" ToolTip="Tím"/>
                    <Button Background="#16A085" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#16A085" BorderThickness="1" Click="btnColor_Click" Tag="#16A085" Margin="2" Cursor="Hand" ToolTip="Xanh ngọc"/>
                    <Button Background="#E84393" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#E84393" BorderThickness="1" Click="btnColor_Click" Tag="#E84393" Margin="2" Cursor="Hand" ToolTip="Hồng"/>
                    <Button Background="#795548" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#795548" BorderThickness="1" Click="btnColor_Click" Tag="#795548" Margin="2" Cursor="Hand" ToolTip="Nâu"/>
                    <Button Background="#7F8C8D" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#7F8C8D" BorderThickness="1" Click="btnColor_Click" Tag="#7F8C8D" Margin="2" Cursor="Hand" ToolTip="Xám ghi"/>
                </UniformGrid>

                <!-- Custom Color Row -->
                <Grid Margin="0,4,0,0" Height="28">
                    <Border Background="#2E86DE" 
                            Height="28" 
                            CornerRadius="6" 
                            Margin="0,0,110,0">
                        <TextBlock x:Name="txtCustomColorHex" 
                                  Text="#FFFFFF" 
                                  FontSize="11" 
                                  FontWeight="SemiBold" 
                                  Foreground="White" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center"/>
                    </Border>

                    <Button Content="Chọn màu khác" 
                            Width="105" 
                            Height="28" 
                            HorizontalAlignment="Right" 
                            Background="#F1F2F6" 
                            Foreground="#2F3542" 
                            BorderThickness="0" 
                            FontSize="11" 
                            FontWeight="SemiBold" 
                            Cursor="Hand" 
                            Click="btnColorPicker_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6" 
                                        Padding="4">
                                    <TextBlock Text="{TemplateBinding Content}" 
                                              Foreground="{TemplateBinding Foreground}" 
                                              FontSize="{TemplateBinding FontSize}" 
                                              FontWeight="{TemplateBinding FontWeight}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 4: PREVIEW -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <Border Background="#F8F9FA" 
                        Height="22" 
                        CornerRadius="6" 
                        BorderBrush="#E1E8ED" 
                        BorderThickness="1">
                    <Rectangle x:Name="rectStrokePreview" 
                               Fill="#FFFFFF" 
                               Height="4" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Stretch" 
                               Margin="12,0"/>
                </Border>
            </StackPanel>

            <!-- 5: FOOTER BUTTONS -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnReset" 
                        Grid.Column="0" 
                        Height="32" 
                        Margin="0,0,4,0" 
                        Background="#F1F2F6" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        Click="btnReset_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="Đặt lại" FontSize="12" FontWeight="SemiBold" Foreground="#57606F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnApply" 
                        Grid.Column="1" 
                        Height="32" 
                        Margin="4,0,0,0" 
                        Background="#2E86DE" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        Click="btnApply_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="Áp dụng" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
