<Window x:Class="QASmartTouch.Forms.Form2_5_SubMenuDrawShapes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chèn hình" 
        Width="520" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Window.Resources>
        <!-- Style nút chuyển danh mục môn học (Pill style chuẩn NoteBoard) -->
        <Style x:Key="CategoryTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17"
                                BorderThickness="1"
                                BorderBrush="#DFE4EA"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút chuyên đề con (Sub-category Pills) -->
        <Style x:Key="SubCategoryTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho các ô hình vẽ trong ShapeGallery (Touch Friendly IFP) -->
        <Style x:Key="ShapeItemButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF3FC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E86DE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D6E4F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="15" 
            BorderBrush="#E1E8ED" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC" 
                            Direction="270" 
                            ShadowDepth="3" 
                            BlurRadius="15" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Categories & Subjects -->
                <RowDefinition Height="*"/>    <!-- Shape Gallery -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#2E86DE" 
                                  Data="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.14L2,9.27L8.91,8.26L12,2Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Thư viện hình vẽ &amp; Môn học" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#2F3542"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnClose" 
                        Style="{StaticResource CloseButton}"
                        Click="btnClose_Click"/>
            </Grid>

            <!-- CATEGORIES: Danh mục chính 2 cấp (Touch Friendly) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <!-- Hàng 1: Tabs Chính 4 Môn học dàn đều 100% không cuộn -->
                <UniformGrid x:Name="SubjectTabBar" Rows="1" Columns="4" Margin="0,0,0,6">
                    <Button x:Name="btnMath" Content="📐 Toán" 
                            Style="{StaticResource CategoryTabButtonStyle}"
                            Background="#81C784" Foreground="#1B5E20"
                            Click="btnSubject_Click" Tag="math"/>
                    <Button x:Name="btnPhysics" Content="🧲 Vật lí" 
                            Style="{StaticResource CategoryTabButtonStyle}"
                            Background="#F1F2F6" Foreground="#2F3542"
                            Click="btnSubject_Click" Tag="physics"/>
                    <Button x:Name="btnChem" Content="🧪 Hóa học" 
                            Style="{StaticResource CategoryTabButtonStyle}"
                            Background="#F1F2F6" Foreground="#2F3542"
                            Click="btnSubject_Click" Tag="chem"/>
                    <Button x:Name="btnBio" Content="🧬 Sinh học" 
                            Style="{StaticResource CategoryTabButtonStyle}"
                            Background="#F1F2F6" Foreground="#2F3542"
                            Click="btnSubject_Click" Tag="bio"/>
                </UniformGrid>

                <!-- Hàng 2: Danh mục Chuyên đề con (Segment control style chuẩn NoteBoard) -->
                <Border x:Name="SubCategoryContainer" Background="#F1F4F6" CornerRadius="16" Padding="4,3" Margin="0,2,0,4">
                    <ScrollViewer x:Name="SubCategoryScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly" Visibility="Visible">
                        <StackPanel x:Name="SubCategoryTabBar" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- SHAPE GALLERY -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="Both" PanningDeceleration="0.002">
                <WrapPanel x:Name="ShapeGallery" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Shapes will be populated dynamically -->
                </WrapPanel>
            </ScrollViewer>

            <!-- FOOTER INFO -->
            <Border Grid.Row="3" 
                    Background="#F8F9FA"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#57606F" 
                                      Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Click để chèn hình vào bảng" 
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#57606F"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Ctrl + Shift + S" 
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#2E86DE"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>