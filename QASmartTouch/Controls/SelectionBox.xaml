<UserControl x:Class="QASmartTouch.Controls.SelectionBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="300"
             Background="Transparent">
    
    <!-- Selection Box Container with Dashed Border -->
    <Grid x:Name="SelectionBorder"
          IsManipulationEnabled="True"
          ManipulationStarting="SelectionBorder_ManipulationStarting"
          ManipulationDelta="SelectionBorder_ManipulationDelta"
          ManipulationCompleted="SelectionBorder_ManipulationCompleted">
        
        <!-- Dashed Rectangle Border (QC_4.2_IFP86) -->
        <Rectangle Stroke="#FF00BFFF"
                   StrokeThickness="3"
                   StrokeDashArray="6 3"
                   RadiusX="2"
                   RadiusY="2"
                   Fill="Transparent"/>
        
        <!-- Smart Snap Guide Line (Visible when snapping to 0/90/180/270 degrees) -->
        <Line x:Name="SnapLine"
              X1="0" Y1="0" X2="0" Y2="0"
              Stroke="#2ECC71"
              StrokeThickness="2"
              StrokeDashArray="4 2"
              Visibility="Collapsed"
              IsHitTestVisible="False"/>

        <!-- Live Scaling Tooltip (% and px size) -->
        <Border x:Name="ScaleTooltip"
                Background="#D9000000"
                CornerRadius="6"
                Padding="8,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-36,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="txtScaleTooltip"
                       Text="100% (0 x 0 px)"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Live Rotation Angle Tooltip (Degree °) -->
        <Border x:Name="AngleTooltip"
                Background="#D9000000"
                CornerRadius="6"
                Padding="8,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-56,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="txtAngleTooltip"
                       Text="0°"
                       Foreground="#2ECC71"
                       FontSize="12"
                       FontWeight="Bold"/>
        </Border>
        
        <!-- 4 Corner Square Resize Handles (44x44 Touch Target, 16x16 Visual DeepSkyBlue) -->
        <Grid x:Name="TopLeftHandle"
              Width="44" Height="44"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="-22,-22,0,0"
              Background="Transparent"
              Cursor="SizeNWSE"
              MouseDown="ResizeHandle_MouseDown"
              MouseMove="ResizeHandle_MouseMove"
              MouseUp="ResizeHandle_MouseUp"
              TouchDown="ResizeHandle_TouchDown"
              TouchMove="ResizeHandle_TouchMove"
              TouchUp="ResizeHandle_TouchUp"
              LostTouchCapture="Handle_LostTouchCapture"
              Tag="TopLeft">
            <Rectangle Width="16" Height="16"
                       Fill="#FF00BFFF"
                       Stroke="White"
                       StrokeThickness="2"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
            
        <Grid x:Name="TopRightHandle"
              Width="44" Height="44"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,-22,-22,0"
              Background="Transparent"
              Cursor="SizeNESW"
              MouseDown="ResizeHandle_MouseDown"
              MouseMove="ResizeHandle_MouseMove"
              MouseUp="ResizeHandle_MouseUp"
              TouchDown="ResizeHandle_TouchDown"
              TouchMove="ResizeHandle_TouchMove"
              TouchUp="ResizeHandle_TouchUp"
              LostTouchCapture="Handle_LostTouchCapture"
              Tag="TopRight">
            <Rectangle Width="16" Height="16"
                       Fill="#FF00BFFF"
                       Stroke="White"
                       StrokeThickness="2"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
            
        <Grid x:Name="BottomLeftHandle"
              Width="44" Height="44"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="-22,0,0,-22"
              Background="Transparent"
              Cursor="SizeNESW"
              MouseDown="ResizeHandle_MouseDown"
              MouseMove="ResizeHandle_MouseMove"
              MouseUp="ResizeHandle_MouseUp"
              TouchDown="ResizeHandle_TouchDown"
              TouchMove="ResizeHandle_TouchMove"
              TouchUp="ResizeHandle_TouchUp"
              LostTouchCapture="Handle_LostTouchCapture"
              Tag="BottomLeft">
            <Rectangle Width="16" Height="16"
                       Fill="#FF00BFFF"
                       Stroke="White"
                       StrokeThickness="2"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
            
        <Grid x:Name="BottomRightHandle"
              Width="44" Height="44"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,-22,-22"
              Background="Transparent"
              Cursor="SizeNWSE"
              MouseDown="ResizeHandle_MouseDown"
              MouseMove="ResizeHandle_MouseMove"
              MouseUp="ResizeHandle_MouseUp"
              TouchDown="ResizeHandle_TouchDown"
              TouchMove="ResizeHandle_TouchMove"
              TouchUp="ResizeHandle_TouchUp"
              LostTouchCapture="Handle_LostTouchCapture"
              Tag="BottomRight">
            <Rectangle Width="16" Height="16"
                       Fill="#FF00BFFF"
                       Stroke="White"
                       StrokeThickness="2"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
            
        <!-- Rotate Handle (44x44 Touch Target, 20x20 Visual) -->
        <Grid x:Name="RotateHandle"
              Width="44" Height="44"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,-46,0,0"
              Background="Transparent"
              Cursor="Hand"
              MouseDown="RotateHandle_MouseDown"
              MouseMove="RotateHandle_MouseMove"
              MouseUp="RotateHandle_MouseUp"
              TouchDown="RotateHandle_TouchDown"
              TouchMove="RotateHandle_TouchMove"
              TouchUp="RotateHandle_TouchUp"
              LostTouchCapture="Handle_LostTouchCapture">
            <Grid.ToolTip>
                <ToolTip Content="Kéo để xoay"/>
            </Grid.ToolTip>
            <Ellipse Width="20" Height="20"
                     Fill="#FF00BFFF"
                     Stroke="White"
                     StrokeThickness="2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"/>
        </Grid>
            
        <!-- Connection Line from Rotate Handle -->
        <Line x:Name="RotateConnectionLine"
              X1="0" Y1="-34"
              X2="0" Y2="0"
              Stroke="#FF00BFFF"
              StrokeThickness="1.5"
              StrokeDashArray="3 2"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              IsHitTestVisible="False"/>
    </Grid>
</UserControl>
