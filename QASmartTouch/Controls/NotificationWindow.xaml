<Window x:Class="QASmartClass.Controls.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="400" Height="Auto" SizeToContent="Height"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Nút Đóng Phẳng -->
        <Style x:Key="FlatCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C62828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Gửi Lại Nhỏ -->
        <Style x:Key="ResendButton" TargetType="Button">
            <Setter Property="Background" Value="#E0F2F1"/>
            <Setter Property="Foreground" Value="#00796B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B2DFDB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút OK Tiêu Chuẩn -->
        <Style x:Key="BrandSolidButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6,14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Viền Hướng Dẫn -->
        <Style x:Key="BrandOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F8E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Name="MainBorder" CornerRadius="12" BorderThickness="1.5" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar Thương Hiệu -->
                <RowDefinition Height="Auto"/> <!-- Content (Icon + Text) -->
                <RowDefinition Height="Auto"/> <!-- ProgressBar -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                <RowDefinition Height="Auto"/> <!-- Inline Error Message -->
                <RowDefinition Height="Auto"/> <!-- Troubleshooting Panel -->
            </Grid.RowDefinitions>

            <!-- 1. Title Bar -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                <!-- Vạch màu nhận diện thương hiệu nhỏ góc trái -->
                <Border Width="4" Height="14" Background="{Binding ElementName=MainBorder, Path=BorderBrush}" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="QA SmartClass - Kết quả tác vụ" FontSize="11" FontWeight="SemiBold" 
                           Foreground="#777777" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click" Style="{StaticResource FlatCloseButton}" Width="20" Height="20"/>
            </DockPanel>

            <!-- 2. Content -->
            <Grid Grid.Row="1" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="txtIcon" Text="🔄" FontFamily="Segoe UI Emoji" FontSize="32" 
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="lblTitle" Text="Đang xử lý tác vụ..." FontSize="14" FontWeight="Bold" Foreground="#333333"/>
                    <TextBlock Name="lblDescription" Text="Vui lòng chờ phản hồi từ các thiết bị học sinh..." FontSize="12" Foreground="#666666" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- 3. Progress Bar -->
            <ProgressBar Name="progressAction" Grid.Row="2" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,4" Background="#E0E0E0" Foreground="#2E7D32" BorderThickness="0" Visibility="Collapsed"/>

            <!-- 4. Action Buttons -->
            <StackPanel Name="panelActions" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Name="btnResendAll" Content="Gửi lại tất cả lỗi 🔄" Click="ResendAll_Click" Style="{StaticResource BrandOutlineButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button Name="btnTroubleshoot" Content="Xem hướng dẫn" Click="Troubleshoot_Click" Style="{StaticResource BrandOutlineButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button Name="btnOk" Content="OK" Click="Ok_Click" Width="70" Style="{StaticResource BrandSolidButton}"/>
            </StackPanel>

            <!-- 4.5. Inline Error Message -->
            <TextBlock Name="lblError" Grid.Row="4" FontSize="11" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

            <!-- 5. Troubleshooting Panel (Mở rộng khi có lỗi) -->
            <Grid Name="panelTroubleshoot" Grid.Row="5" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Danh sách học sinh lỗi -->
                <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="6" BorderThickness="1" BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock Text="Danh sách thiết bị gặp sự cố:" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="failedStudentsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2,0,2">
                                            <TextBlock Text="❌" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <Button Content="Gửi lại 🔄" DockPanel.Dock="Right" Style="{StaticResource ResendButton}" Click="ResendItem_Click" Tag="{Binding Code}"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding Code}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Chỉ dẫn khắc phục nhanh -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="💡 Hướng dẫn khắc phục sự cố nhanh:" FontSize="11" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock Text="1. Nhắc học sinh kiểm tra kết nối mạng (Wi-Fi của lớp học)." FontSize="11" Foreground="#555555" Margin="0,2,0,0"/>
                    <TextBlock Text="2. Yêu cầu học sinh làm mới: F5 (Web Browser) hoặc restart App (TCP Client)." FontSize="11" Foreground="#555555" Margin="0,1,0,0"/>
                    <TextBlock Text="3. Nhấn nút 'Gửi lại' ở trên để thử phát riêng cho học sinh đó." FontSize="11" Foreground="#555555" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
