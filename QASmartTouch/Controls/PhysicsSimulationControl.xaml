<UserControl x:Class="QASmartTouch.Controls.PhysicsSimulationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Width="720" Height="520">

    <Grid>
        <Border Background="White"
                BorderBrush="#00897B"
                BorderThickness="2"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  Direction="270"
                                  ShadowDepth="3"
                                  BlurRadius="10"
                                  Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar (Draggable) -->
                <Border x:Name="titleBar"
                        Grid.Row="0"
                        Background="#00897B"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        Cursor="SizeAll">
                    <Grid Margin="10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔬"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtTitle"
                                       Text="Mô phỏng Thí nghiệm Vật lý"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnCapture"
                                    Content="📸"
                                    Width="28" Height="26"
                                    Background="#26A69A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Margin="0,0,6,0"
                                    ToolTip="Chụp ảnh mô phỏng vào bài giảng"
                                    Click="btnCapture_Click"/>

                            <Button x:Name="btnReload"
                                    Content="↺"
                                    Width="28" Height="26"
                                    Background="#26A69A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Margin="0,0,6,0"
                                    ToolTip="Tải lại mô phỏng"
                                    Click="btnReload_Click"/>

                            <Button x:Name="btnDelete"
                                    Content="✕"
                                    Width="28" Height="26"
                                    Background="#E53935"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Đóng mô phỏng"
                                    Click="btnDelete_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WebView Container -->
                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="webView"/>

                    <!-- Loading Indicator -->
                    <Border x:Name="loadingOverlay"
                            Background="#F0FDFC"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Đang khởi chạy thí nghiệm..."
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#00796B"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Vui lòng đợi trong giây lát"
                                       FontSize="12"
                                       Foreground="#80CBC4"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Resize Handle at Bottom Right -->
                    <Border x:Name="resizeHandle"
                            Width="20" Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Cursor="SizeNWSE"
                            MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                            MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                            MouseMove="ResizeHandle_MouseMove">
                        <Path Fill="#00897B"
                              Data="M 16,4 L 16,16 L 4,16 Z"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,2,2"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
