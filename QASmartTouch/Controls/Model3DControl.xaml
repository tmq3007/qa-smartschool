<UserControl x:Class="QASmartTouch.Controls.Model3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="http://helix-toolkit.org/wpf"
             Width="720" Height="500"
             Tag="Interactive3DModel"
             Background="Transparent"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False"
             Stylus.IsTapFeedbackEnabled="False"
             Stylus.IsTouchFeedbackEnabled="False">

    <UserControl.Resources>
        <!-- UMind Unified Header Action Button Style -->
        <Style x:Key="HeaderActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Stylus.IsTapFeedbackEnabled" Value="False"/>
            <Setter Property="Stylus.IsTouchFeedbackEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#48484A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#636366"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UMind Unified Close/Delete Button Style -->
        <Style x:Key="HeaderCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource HeaderActionBtnStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- UMind Unified Container Outer Border -->
    <Border x:Name="mainBorder"
            Background="#0F172A"
            BorderBrush="#8B5CF6"
            BorderThickness="2"
            CornerRadius="10"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Unified Dark Header Bar (Drag Handle + Quick Controls) -->
            <Border x:Name="titleBar"
                    Grid.Row="0"
                    Background="#1C1C1E"
                    CornerRadius="8,8,0,0"
                    Padding="10,0"
                    Cursor="SizeAll"
                    Tag="DragHandle"
                    Stylus.IsPressAndHoldEnabled="False"
                    Stylus.IsFlicksEnabled="False"
                    Stylus.IsTapFeedbackEnabled="False"
                    Stylus.IsTouchFeedbackEnabled="False">
                <Grid>
                    <!-- Left: Grip + Badge + Model Name -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="⠿"
                                   Foreground="#8E8E93"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0"/>
                        <Border Background="#8B5CF6"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="🎲 3D MODEL"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="txtTitle"
                                   Text="Mô hình 3D"
                                   Foreground="#E5E5EA"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="195"/>
                    </StackPanel>

                    <!-- Right: Camera View Presets + Auto-Rotate + Zoom + Close -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="btnTopView"
                                Content="Top"
                                ToolTip="Góc nhìn từ trên xuống (Top View)"
                                Click="BtnTopView_Click"
                                Style="{StaticResource HeaderActionBtnStyle}"/>
                        <Button x:Name="btnFrontView"
                                Content="Front"
                                ToolTip="Góc nhìn chính diện (Front View)"
                                Click="BtnFrontView_Click"
                                Style="{StaticResource HeaderActionBtnStyle}"/>
                        <Button x:Name="btnSideView"
                                Content="Side"
                                ToolTip="Góc nhìn mặt bên (Side View)"
                                Click="BtnSideView_Click"
                                Style="{StaticResource HeaderActionBtnStyle}"/>
                        <Button x:Name="btnAutoRotate"
                                Content="🔄"
                                Width="28"
                                Padding="0"
                                FontSize="13"
                                ToolTip="Bật/Tắt tự động xoay mô hình 360°"
                                Click="BtnAutoRotate_Click"
                                Style="{StaticResource HeaderActionBtnStyle}"/>
                        <Button x:Name="btnResetView"
                                Content="⌖"
                                Width="28"
                                Padding="0"
                                FontSize="14"
                                Margin="0,0,6,0"
                                ToolTip="Đặt lại góc nhìn mặc định (Reset View)"
                                Click="BtnResetView_Click"
                                Style="{StaticResource HeaderActionBtnStyle}"/>

                        <!-- Divider -->
                        <Border Width="1"
                                Height="18"
                                Background="#3A3A3C"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"/>

                        <Button x:Name="btnZoomOut"
                                Content="－"
                                Width="28"
                                Padding="0"
                                FontSize="13"
                                ToolTip="Thu nhỏ khung mô hình (Zoom -)"
                                Click="BtnZoomOut_Click"
                                Style="{StaticResource HeaderActionBtnStyle}"/>
                        <Button x:Name="btnZoomIn"
                                Content="＋"
                                Width="28"
                                Padding="0"
                                FontSize="13"
                                Margin="0,0,6,0"
                                ToolTip="Phóng to khung mô hình (Zoom +)"
                                Click="BtnZoomIn_Click"
                                Style="{StaticResource HeaderActionBtnStyle}"/>
                        <Button x:Name="btnDelete"
                                Content="✕"
                                ToolTip="Đóng mô hình 3D"
                                Click="btnDelete_Click"
                                Style="{StaticResource HeaderCloseBtnStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: 3D Viewport Area -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <helix:HelixViewport3D x:Name="viewport3D"
                                       Background="#F8FAFC"
                                       CameraRotationMode="Trackball"
                                       ShowCoordinateSystem="False"
                                       ShowViewCube="True"
                                       ZoomExtentsWhenLoaded="True"
                                       Stylus.IsPressAndHoldEnabled="False"
                                       Stylus.IsFlicksEnabled="False"
                                       Stylus.IsTapFeedbackEnabled="False"
                                       Stylus.IsTouchFeedbackEnabled="False">
                    <!-- Camera -->
                    <helix:HelixViewport3D.Camera>
                        <PerspectiveCamera Position="10,10,10"
                                           LookDirection="-10,-10,-10"
                                           UpDirection="0,0,1"
                                           FieldOfView="45"/>
                    </helix:HelixViewport3D.Camera>

                    <!-- Studio Lighting -->
                    <helix:DefaultLights/>

                    <!-- Model Container -->
                    <ModelVisual3D x:Name="modelVisual"/>
                </helix:HelixViewport3D>

                <!-- Subtle Non-Intrusive Touch/Mouse Hint Pill -->
                <Border Background="#B80F172A"
                        CornerRadius="6"
                        Padding="10,4"
                        Margin="10,0,0,8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False">
                    <TextBlock Text="👆 Kéo 1 ngón / Chuột trái: Xoay 3D  •  2 ngón / Cuộn chuột: Thu phóng"
                               Foreground="#E2E8F0"
                               FontSize="11"
                               FontWeight="Medium"/>
                </Border>

                <!-- Corner Resize Handle (Bottom-Right) -->
                <Thumb x:Name="resizeThumb"
                       Tag="ResizeHandle"
                       Width="24" Height="24"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       Margin="0,0,4,4"
                       ToolTip="Kéo góc để thay đổi kích thước khung 3D"
                       DragDelta="resizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="#CC8B5CF6" CornerRadius="5">
                                <Path Data="M2,12 L12,2 M6,12 L12,6 M10,12 L12,10"
                                      Stroke="White"
                                      StrokeThickness="1.6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="4"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</UserControl>
