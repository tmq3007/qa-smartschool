<UserControl x:Class="QASmartTouch.Controls.RichTextBoxControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             MinWidth="300" MinHeight="150"

             Background="White">

    

    <UserControl.Resources>

        <!-- Button Style -->

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="32"/>

            <Setter Property="Height" Value="32"/>

            <Setter Property="Margin" Value="2"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                                CornerRadius="4"

                                BorderBrush="#E1E8ED"

                                BorderThickness="1">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#F0F0F0"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter Property="Background" Value="#E0E0E0"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    

    <Border BorderBrush="#2E86DE" BorderThickness="2" CornerRadius="8">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/> <!-- Toolbar -->

                <RowDefinition Height="*"/>    <!-- Content -->

            </Grid.RowDefinitions>

            

            <!-- Formatting Toolbar -->

            <Border Grid.Row="0" Background="#F5F6FA" BorderBrush="#E1E8ED" 

                    BorderThickness="0,0,0,1" Padding="8,4">

                <StackPanel Orientation="Horizontal">

                    

                    <!-- Font Family -->

                    <ComboBox x:Name="cmbFontFamily" Width="120" Height="28" Margin="2"

                              SelectionChanged="FontFamily_Changed">

                        <ComboBoxItem Content="Arial" IsSelected="True"/>

                        <ComboBoxItem Content="Times New Roman"/>

                        <ComboBoxItem Content="Segoe UI"/>

                        <ComboBoxItem Content="Calibri"/>

                        <ComboBoxItem Content="Verdana"/>

                        <ComboBoxItem Content="Comic Sans MS"/>

                    </ComboBox>

                    

                    <!-- Font Size -->

                    <ComboBox x:Name="cmbFontSize" Width="60" Height="28" Margin="2"

                              SelectionChanged="FontSize_Changed">

                        <ComboBoxItem Content="8"/>

                        <ComboBoxItem Content="10"/>

                        <ComboBoxItem Content="12"/>

                        <ComboBoxItem Content="14" IsSelected="True"/>

                        <ComboBoxItem Content="16"/>

                        <ComboBoxItem Content="18"/>

                        <ComboBoxItem Content="20"/>

                        <ComboBoxItem Content="24"/>

                        <ComboBoxItem Content="28"/>

                        <ComboBoxItem Content="36"/>

                        <ComboBoxItem Content="48"/>

                        <ComboBoxItem Content="72"/>

                    </ComboBox>

                    

                    <Separator Width="1" Margin="4,0" Background="#E1E8ED"/>

                    

                    <!-- Bold -->

                    <Button x:Name="btnBold" Style="{StaticResource ToolbarButtonStyle}"

                            Click="Bold_Click" ToolTip="Đậm (Ctrl+B)">

                        <TextBlock Text="B" FontWeight="Bold" FontSize="14"/>

                    </Button>

                    

                    <!-- Italic -->

                    <Button x:Name="btnItalic" Style="{StaticResource ToolbarButtonStyle}"

                            Click="Italic_Click" ToolTip="Nghiêng (Ctrl+I)">

                        <TextBlock Text="I" FontStyle="Italic" FontSize="14"/>

                    </Button>

                    

                    <!-- Underline -->

                    <Button x:Name="btnUnderline" Style="{StaticResource ToolbarButtonStyle}"

                            Click="Underline_Click" ToolTip="Gạch chân (Ctrl+U)">

                        <TextBlock Text="U" TextDecorations="Underline" FontSize="14"/>

                    </Button>

                    

                    <Separator Width="1" Margin="4,0" Background="#E1E8ED"/>

                    

                    <!-- Text Color -->

                    <Button x:Name="btnTextColor" Style="{StaticResource ToolbarButtonStyle}"

                            Click="TextColor_Click" ToolTip="Màu chữ">

                        <Grid>

                            <TextBlock Text="A" FontSize="14" FontWeight="Bold"/>

                            <Rectangle Height="3" VerticalAlignment="Bottom" 

                                     Fill="{Binding ElementName=txtContent, Path=Foreground}"

                                     Margin="0,0,0,2"/>

                        </Grid>

                    </Button>

                    

                    <!-- Background Color -->

                    <Button x:Name="btnBgColor" Style="{StaticResource ToolbarButtonStyle}"

                            Click="BgColor_Click" ToolTip="Màu nền">

                        <Grid>

                            <Rectangle Width="20" Height="20" 

                                     Fill="{Binding ElementName=txtContent, Path=Background}"

                                     Stroke="#666" StrokeThickness="1"/>

                        </Grid>

                    </Button>

                    

                    <Separator Width="1" Margin="4,0" Background="#E1E8ED"/>

                    

                    <!-- Align Left -->

                    <Button x:Name="btnAlignLeft" Style="{StaticResource ToolbarButtonStyle}"

                            Click="AlignLeft_Click" ToolTip="Căn trái">

                        <TextBlock Text="≡" FontSize="16"/>

                    </Button>

                    

                    <!-- Align Center -->

                    <Button x:Name="btnAlignCenter" Style="{StaticResource ToolbarButtonStyle}"

                            Click="AlignCenter_Click" ToolTip="Căn giữa">

                        <TextBlock Text="≡" FontSize="16" TextAlignment="Center"/>

                    </Button>

                    

                    <!-- Align Right -->

                    <Button x:Name="btnAlignRight" Style="{StaticResource ToolbarButtonStyle}"

                            Click="AlignRight_Click" ToolTip="Căn phải">

                        <TextBlock Text="≡" FontSize="16" TextAlignment="Right"/>

                    </Button>

                    

                </StackPanel>

            </Border>

            

            <!-- Rich Text Content -->

            <RichTextBox x:Name="txtContent" Grid.Row="1"

                         Padding="12"

                         BorderThickness="0"

                         VerticalScrollBarVisibility="Auto"

                         AcceptsReturn="True"

                         AcceptsTab="True"

                         FontFamily="Arial"

                         FontSize="14"

                         TextChanged="Content_TextChanged"
                         GotFocus="txtContent_GotFocus"
                         LostFocus="txtContent_LostFocus">

                <FlowDocument>

                    <Paragraph>

                        <Run Text="Nhập nội dung văn bản..."/>

                    </Paragraph>

                </FlowDocument>

            </RichTextBox>

            

        </Grid>

    </Border>

</UserControl>

