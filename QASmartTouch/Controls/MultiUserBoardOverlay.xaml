<UserControl x:Class="QASmartTouch.Controls.MultiUserBoardOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="#3D6D64"
             FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <UserControl.Resources>
        <!-- Glassmorphism Toolbars Shadow -->
        <DropShadowEffect x:Key="FloatingShadow" 
                          Color="Black" 
                          Opacity="0.35" 
                          BlurRadius="16" 
                          ShadowDepth="4" 
                          Direction="270"/>

        <!-- Mini Toolbar Button Style -->
        <Style x:Key="MiniToolBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#222F3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="21" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Top Control Bar -->
            <RowDefinition Height="*"/>  <!-- Dual Canvas Area -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: TOP CONTROL BAR                      -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="#1E272E" BorderBrush="#353B48" BorderThickness="0,0,0,1" Panel.ZIndex="10">
            <Grid Margin="16,0">
                <!-- Left Title & Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#2E86DE" Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="BẢNG THI ĐUA ĐA NGƯỜI DÙNG" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                    <Border Background="#2E86DE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SMART TOUCH" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Center: Timer Display -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Background="#2F3542" CornerRadius="16" Padding="14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱️" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTimer" Text="00:00" FontSize="16" FontWeight="Bold" Foreground="#00D2D3" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right: Finish Button -->
                <Button x:Name="btnFinish" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Height="38" 
                        Padding="16,0"
                        Background="#EE5253" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="13"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="btnFinish_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏁" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hoàn thành &amp; Thoát" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 1: DUAL BOARD AREA (50:50 SPLIT)       -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" x:Name="boardGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Student 1 Area -->
                <ColumnDefinition Width="4"/>   <!-- Divider Line -->
                <ColumnDefinition Width="*"/>   <!-- Student 2 Area -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT ZONE: STUDENT 1 ── -->
            <Grid Grid.Column="0" x:Name="gridLeft" ClipToBounds="True">
                <!-- Native Multi-Touch Canvas for Student 1 -->
                <Canvas x:Name="canvasLeft" 
                        Background="Transparent" 
                        ClipToBounds="True"
                        PreviewTouchDown="CanvasLeft_PreviewTouchDown"
                        PreviewTouchMove="CanvasLeft_PreviewTouchMove"
                        PreviewTouchUp="CanvasLeft_PreviewTouchUp"
                        LostTouchCapture="CanvasLeft_LostTouchCapture"
                        MouseDown="CanvasLeft_MouseDown"
                        MouseMove="CanvasLeft_MouseMove"
                        MouseUp="CanvasLeft_MouseUp"/>

                <!-- Student 1 Badge Header (Top Left) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Margin="20,16,0,0" 
                        Background="#1E272ECC" 
                        CornerRadius="20" 
                        Padding="14,6"
                        IsHitTestVisible="False"
                        Effect="{StaticResource FloatingShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="dotStudent1" Width="12" Height="12" Fill="#2E86DE" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblStudent1" Text="Học sinh 1" FontWeight="Bold" FontSize="15" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Mini Floating Toolbar (Bottom Left) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                        Margin="20,0,0,24" 
                        Background="#1E272EF0" 
                        CornerRadius="26" 
                        Padding="8,5"
                        Effect="{StaticResource FloatingShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Color 1: Blue -->
                        <Button x:Name="btnLeftColor1" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#2E86DE" Tag="#2E86DE" Click="btnLeftColor_Click"/>
                        <!-- Quick Color 2: Red -->
                        <Button x:Name="btnLeftColor2" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#EE5253" Tag="#EE5253" Click="btnLeftColor_Click"/>
                        <!-- Quick Color 3: Yellow -->
                        <Button x:Name="btnLeftColor3" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#F39C12" Tag="#F39C12" Click="btnLeftColor_Click"/>
                        <!-- Quick Color 4: Green -->
                        <Button x:Name="btnLeftColor4" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#10AC84" Tag="#10AC84" Click="btnLeftColor_Click"/>

                        <!-- Divider -->
                        <Border Width="1" Height="24" Background="#576574" Margin="6,0"/>

                        <!-- Pen Tool -->
                        <Button x:Name="btnLeftPen" Style="{StaticResource MiniToolBtnStyle}" Background="#2E86DE" Click="btnLeftPen_Click" ToolTip="Bút viết">
                            <TextBlock Text="✏️" FontSize="16"/>
                        </Button>

                        <!-- Eraser Tool -->
                        <Button x:Name="btnLeftEraser" Style="{StaticResource MiniToolBtnStyle}" Background="#2F3542" Click="btnLeftEraser_Click" ToolTip="Tẩy nét">
                            <TextBlock Text="🧹" FontSize="16"/>
                        </Button>

                        <!-- Divider -->
                        <Border Width="1" Height="24" Background="#576574" Margin="6,0"/>

                        <!-- Undo Button -->
                        <Button x:Name="btnLeftUndo" Style="{StaticResource MiniToolBtnStyle}" Background="#2F3542" Click="btnLeftUndo_Click" ToolTip="Hoàn tác">
                            <TextBlock Text="↩️" FontSize="16"/>
                        </Button>

                        <!-- Clear Canvas -->
                        <Button x:Name="btnLeftClear" Style="{StaticResource MiniToolBtnStyle}" Background="#2F3542" Click="btnLeftClear_Click" ToolTip="Xóa bảng của em">
                            <TextBlock Text="🗑️" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CENTER DIVIDER LINE ── -->
            <Border Grid.Column="1" Background="#FFFFFF" Opacity="0.35">
                <Border.Effect>
                    <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
            </Border>

            <!-- ── RIGHT ZONE: STUDENT 2 ── -->
            <Grid Grid.Column="2" x:Name="gridRight" ClipToBounds="True">
                <!-- Native Multi-Touch Canvas for Student 2 -->
                <Canvas x:Name="canvasRight" 
                        Background="Transparent" 
                        ClipToBounds="True"
                        PreviewTouchDown="CanvasRight_PreviewTouchDown"
                        PreviewTouchMove="CanvasRight_PreviewTouchMove"
                        PreviewTouchUp="CanvasRight_PreviewTouchUp"
                        LostTouchCapture="CanvasRight_LostTouchCapture"
                        MouseDown="CanvasRight_MouseDown"
                        MouseMove="CanvasRight_MouseMove"
                        MouseUp="CanvasRight_MouseUp"/>

                <!-- Student 2 Badge Header (Top Left of Zone 2) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Margin="20,16,0,0" 
                        Background="#1E272ECC" 
                        CornerRadius="20" 
                        Padding="14,6"
                        IsHitTestVisible="False"
                        Effect="{StaticResource FloatingShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="dotStudent2" Width="12" Height="12" Fill="#EE5253" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblStudent2" Text="Học sinh 2" FontWeight="Bold" FontSize="15" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Mini Floating Toolbar (Bottom Right of Zone 2) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                        Margin="0,0,20,24" 
                        Background="#1E272EF0" 
                        CornerRadius="26" 
                        Padding="8,5"
                        Effect="{StaticResource FloatingShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Color 1: Blue -->
                        <Button x:Name="btnRightColor1" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#2E86DE" Tag="#2E86DE" Click="btnRightColor_Click"/>
                        <!-- Quick Color 2: Red -->
                        <Button x:Name="btnRightColor2" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#EE5253" Tag="#EE5253" Click="btnRightColor_Click"/>
                        <!-- Quick Color 3: Yellow -->
                        <Button x:Name="btnRightColor3" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#F39C12" Tag="#F39C12" Click="btnRightColor_Click"/>
                        <!-- Quick Color 4: Green -->
                        <Button x:Name="btnRightColor4" Style="{StaticResource MiniToolBtnStyle}" Width="32" Height="32" Background="#10AC84" Tag="#10AC84" Click="btnRightColor_Click"/>

                        <!-- Divider -->
                        <Border Width="1" Height="24" Background="#576574" Margin="6,0"/>

                        <!-- Pen Tool -->
                        <Button x:Name="btnRightPen" Style="{StaticResource MiniToolBtnStyle}" Background="#EE5253" Click="btnRightPen_Click" ToolTip="Bút viết">
                            <TextBlock Text="✏️" FontSize="16"/>
                        </Button>

                        <!-- Eraser Tool -->
                        <Button x:Name="btnRightEraser" Style="{StaticResource MiniToolBtnStyle}" Background="#2F3542" Click="btnRightEraser_Click" ToolTip="Tẩy nét">
                            <TextBlock Text="🧹" FontSize="16"/>
                        </Button>

                        <!-- Divider -->
                        <Border Width="1" Height="24" Background="#576574" Margin="6,0"/>

                        <!-- Undo Button -->
                        <Button x:Name="btnRightUndo" Style="{StaticResource MiniToolBtnStyle}" Background="#2F3542" Click="btnRightUndo_Click" ToolTip="Hoàn tác">
                            <TextBlock Text="↩️" FontSize="16"/>
                        </Button>

                        <!-- Clear Canvas -->
                        <Button x:Name="btnRightClear" Style="{StaticResource MiniToolBtnStyle}" Background="#2F3542" Click="btnRightClear_Click" ToolTip="Xóa bảng của em">
                            <TextBlock Text="🗑️" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- CONFIRMATION DIALOG OVERLAY (UMIND STYLE)  -->
        <!-- ========================================== -->
        <Grid x:Name="confirmDialogOverlay" 
              Grid.RowSpan="2" 
              Background="#99000000" 
              Visibility="Collapsed" 
              Panel.ZIndex="100">
            <Border Width="480" 
                    Background="#1E272E" 
                    BorderBrush="#353B48" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Padding="28"
                    Effect="{StaticResource FloatingShadow}">
                <StackPanel>
                    <!-- Icon Question -->
                    <TextBlock Text="💾" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Title -->
                    <TextBlock Text="Hoàn thành bài làm" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,10"/>

                    <!-- Message -->
                    <TextBlock x:Name="txtConfirmMessage"
                               Text="Bạn có muốn lưu kết quả làm bài của 2 học sinh thành một trang trong bài giảng không?" 
                               FontSize="14" 
                               Foreground="#C8D6E5" 
                               TextAlignment="Center" 
                               TextWrapping="Wrap" 
                               LineHeight="22"
                               Margin="0,0,0,24"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Vertical">
                        <!-- Save to Lecture Page -->
                        <Button x:Name="btnSaveAndExit" 
                                Height="44" 
                                Background="#10AC84" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="14" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Margin="0,0,0,10"
                                Click="btnSaveAndExit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="💾" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Lưu thành trang mới trong bài giảng" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Discard and Exit -->
                        <Button x:Name="btnDiscardAndExit" 
                                Height="40" 
                                Background="#485460" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                FontSize="13" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Margin="0,0,0,10"
                                Click="btnDiscardAndExit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="❌" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Không lưu (Quay về bài giảng)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Cancel/Continue Writing -->
                        <Button x:Name="btnContinueSession" 
                                Height="36" 
                                Background="Transparent" 
                                Foreground="#8395A7" 
                                FontWeight="Normal" 
                                FontSize="13" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                Click="btnContinueSession_Click">
                            <TextBlock Text="Tiếp tục làm bài (Hủy thao tác)" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
