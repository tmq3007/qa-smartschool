<UserControl x:Class="QASmartTouch.Controls.Graph3DControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

             Width="600" Height="450">

    

    <Grid>

        <!-- Main Border with Shadow -->

        <Border Background="White"

                BorderBrush="#2196F3"

                BorderThickness="2"

                CornerRadius="8">

            <Border.Effect>

                <DropShadowEffect Color="#000000"

                                Direction="270"

                                ShadowDepth="3"

                                BlurRadius="10"

                                Opacity="0.3"/>

            </Border.Effect>



            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <!-- Title Bar -->

                    <RowDefinition Height="*"/>

                    <!-- WebView -->

                </Grid.RowDefinitions>



                <!-- Title Bar (Draggable) -->

                <Border x:Name="InternalTitleBar"
                        Grid.Row="0"

                        Background="#2196F3"

                        CornerRadius="6,6,0,0"

                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"

                        Cursor="SizeAll">

                    <Grid Margin="10,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>



                        <!-- Title -->

                        <StackPanel Grid.Column="0" Orientation="Horizontal">

                            <TextBlock Text="📊"

                                       FontSize="14"

                                       VerticalAlignment="Center"

                                       Margin="0,0,6,0"/>

                            <TextBlock Text="Đồ thị 3D - Graph"

                                       FontSize="13"

                                       FontWeight="SemiBold"

                                       Foreground="White"

                                       VerticalAlignment="Center"/>

                        </StackPanel>



                        <!-- Control Buttons -->

                        <StackPanel Grid.Column="1"

                                    Orientation="Horizontal">

                            <!-- Delete Button -->

                            <Button x:Name="btnDelete"

                                    Content="🗑️"

                                    Width="28" Height="28"

                                    FontSize="12"

                                    Background="#EF5350"

                                    Foreground="White"

                                    BorderThickness="0"

                                    Cursor="Hand"

                                    Margin="0,0,4,0"

                                    Click="btnDelete_Click"

                                    ToolTip="Xóa">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"

                                                CornerRadius="4">

                                            <ContentPresenter HorizontalAlignment="Center"

                                                            VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                                <Button.Style>

                                    <Style TargetType="Button">

                                        <Setter Property="Background" Value="#EF5350"/>

                                        <Style.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter Property="Background" Value="#D32F2F"/>

                                            </Trigger>

                                        </Style.Triggers>

                                    </Style>

                                </Button.Style>

                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- WebView Content -->

                <Border Grid.Row="1" Background="White" CornerRadius="0,0,6,6">

                    <wv2:WebView2 x:Name="webView"/>

                </Border>



                <!-- Resize Handles -->

                <!-- Bottom-Right Corner -->

                <Rectangle x:Name="resizeHandle"

                           Grid.Row="1"

                           Width="20" Height="20"

                           Fill="#2196F3"

                           HorizontalAlignment="Right"

                           VerticalAlignment="Bottom"

                           Cursor="SizeNWSE"

                           Opacity="0.7"

                           MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"

                           MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"

                           MouseMove="ResizeHandle_MouseMove">

                    <Rectangle.ToolTip>

                        <ToolTip Content="Kéo để thay đổi kích thước"/>

                    </Rectangle.ToolTip>

                </Rectangle>

            </Grid>

        </Border>

    </Grid>

</UserControl>



