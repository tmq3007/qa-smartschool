        [Fact]
        public void FormatEq_NghiemKepStepFormat_IsCorrect()
        {
            // Verify that we can format terms correctly for our delta = 0 case
            double a = 1;
            double b = -6;
            string aStr = QASmartClass.LearningTools.Views.Math.QuadraticTool.FormatTerm(a);
            string negBStr = b < 0 ? $"−({b:G6})" : $"−{b:G6}";
            double x1 = 3;

            string stepDetail = $"x₁ = x₂ = −b / 2a = {negBStr} / (2·{aStr}) = {x1:G8}";

            Assert.Equal("x₁ = x₂ = −b / 2a = −(-6) / (2·1) = 3", stepDetail);
        }

        [Fact]
        public void FormatEq_ParabolVertexFormula_IsCorrect()
        {
            // Verify that the parabol vertex formula details are formatted correctly
            double a = 1;
            double b = -6;
            double c = 9;
            double xV = 3;
            double yV = 0;
            string aStr = QASmartClass.LearningTools.Views.Math.QuadraticTool.FormatTerm(a);
            string negBStrVertex = b < 0 ? $"−({b:G6})" : $"−{b:G6}";
            string bStrVertex = QASmartClass.LearningTools.Views.Math.QuadraticTool.FormatTerm(b);
            string cStrVertex = QASmartClass.LearningTools.Views.Math.QuadraticTool.FormatTerm(c);

            string stepDetail = $"xᵥ = −b/2a = {negBStrVertex}/(2·{aStr}) = {xV:G6}\n" +
                               $"yᵥ = −Δ/4a = f(xᵥ) = {aStr}·({xV:G6})² + {bStrVertex}·({xV:G6}) + {cStrVertex} = {yV:G8}";

            string expected = "xᵥ = −b/2a = −(-6)/(2·1) = 3\nyᵥ = −Δ/4a = f(xᵥ) = 1·(3)² + (-6)·(3) + 9 = 0";
            Assert.Equal(expected, stepDetail);
        }

