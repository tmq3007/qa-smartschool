        [Fact]
        public void MathCurriculumTool_CSV_EscapeAndParse_Verify()
        {
            var escapeMethod = typeof(QASmartClass.LearningTools.Views.Math.MathCurriculumTool)
                .GetMethod("EscapeCSV", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(escapeMethod);

            var parseMethod = typeof(QASmartClass.LearningTools.Views.Math.MathCurriculumTool)
                .GetMethod("ParseCSVLine", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(parseMethod);

            // Test EscapeCSV
            var esc1 = escapeMethod.Invoke(null, new object[] { "Nguyen Van An" }) as string;
            Assert.Equal("\"Nguyen Van An\"", esc1);

            var esc2 = escapeMethod.Invoke(null, new object[] { "Nguyen, Van An" }) as string;
            Assert.Equal("\"Nguyen, Van An\"", esc2);

            var esc3 = escapeMethod.Invoke(null, new object[] { "An \"Pro\" Nguyen" }) as string;
            Assert.Equal("\"An \"\"Pro\"\" Nguyen\"", esc3);

            // Test ParseCSVLine
            string csvLine = "2026-06-10 06:00:00,\"Nguyễn Văn An, Jr.\",\"HS01\",\"10\",\"Chương 1, bài 1\",\"Dễ\",10,8,80.0,45,\"Luyện tập\",\"Giỏi\",\"abcdef\"";
            var parsed = parseMethod.Invoke(null, new object[] { csvLine }) as List<string>;
            Assert.NotNull(parsed);
            Assert.Equal(13, parsed.Count);
            Assert.Equal("2026-06-10 06:00:00", parsed[0]);
            Assert.Equal("Nguyễn Văn An, Jr.", parsed[1]);
            Assert.Equal("HS01", parsed[2]);
            Assert.Equal("10", parsed[3]);
            Assert.Equal("Chương 1, bài 1", parsed[4]);
            Assert.Equal("Dễ", parsed[5]);
            Assert.Equal("10", parsed[6]);
            Assert.Equal("8", parsed[7]);
            Assert.Equal("80.0", parsed[8]);
            Assert.Equal("45", parsed[9]);
            Assert.Equal("Luyện tập", parsed[10]);
            Assert.Equal("Giỏi", parsed[11]);
            Assert.Equal("abcdef", parsed[12]);
        }

