        [Fact]
        public void SequenceTool_IsValidSequenceInput_ValidValues_ReturnsTrue()
        {
            Assert.True(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidSequenceInput("3", true, true, out double v1, out _));
            Assert.Equal(3.0, v1);
            Assert.True(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidSequenceInput("-12.5", true, true, out double v2, out _));
            Assert.Equal(-12.5, v2);
            Assert.True(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidSequenceInput("0", true, true, out double v3, out _));
            Assert.Equal(0.0, v3);
        }

        [Fact]
        public void SequenceTool_IsValidSequenceInput_InvalidValues_ReturnsFalse()
        {
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidSequenceInput("abc", true, true, out _, out string err1));
            Assert.NotEmpty(err1);
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidSequenceInput("1.2.3", true, true, out _, out string err2));
            Assert.NotEmpty(err2);
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidSequenceInput("-3", true, false, out _, out string err3));
            Assert.NotEmpty(err3);
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidSequenceInput("1.5", false, true, out _, out string err4));
            Assert.NotEmpty(err4);
        }

        [Fact]
        public void SequenceTool_IsValidNInput_ValidAndInvalidLimits_ReturnsCorrectly()
        {
            // Valid N
            Assert.True(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidNInput("10", 500, out int n1, out _));
            Assert.Equal(10, n1);
            Assert.True(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidNInput("500", 500, out int n2, out _));
            Assert.Equal(500, n2);

            // Invalid N
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidNInput("600", 500, out _, out string err1));
            Assert.NotEmpty(err1);
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidNInput("0", 500, out _, out string err2));
            Assert.NotEmpty(err2);
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidNInput("-5", 500, out _, out string err3));
            Assert.NotEmpty(err3);
            Assert.False(QASmartClass.LearningTools.Views.Math.SequenceTool.IsValidNInput("abc", 500, out _, out string err4));
            Assert.NotEmpty(err4);
        }

