        [Fact]
        public void GetCleanFormula_SupportsOrganicBondsAndBrackets()
        {
            // Coefficients, bonds, brackets
            Assert.Equal("CH3COOCHCH2", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("2 CH3COOCH=CH2"));
            Assert.Equal("CH3CH2OH", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("CH3-CH2-OH"));
            Assert.Equal("HCCH", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("HC#CH"));
            Assert.Equal("(Co(NH3)6)Cl3", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("[Co(NH3)6]Cl3"));
        }

        [Fact]
        public void GetCleanFormula_SupportsHydratedSalts()
        {
            // Hydrated salts
            Assert.Equal("CuSO4(H2O)5", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("CuSO4.5H2O"));
            Assert.Equal("CuSO4(H2O)5", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("CuSO4*5H2O"));
            Assert.Equal("CuSO4(H2O)", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("CuSO4.H2O"));
            Assert.Equal("FeSO4((NH4)2SO4)(H2O)6", QASmartClass.Classroom.Views.StemToolsPage.GetCleanFormula("FeSO4.(NH4)2SO4.6H2O"));
        }

