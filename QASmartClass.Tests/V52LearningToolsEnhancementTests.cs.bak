        [Fact]
        public void DerivativeTool_LanguageSuffixResolution_FallbackAndMatchesCorrectly()
        {
            // Test prefix & suffix resolution logic similar to what is used in Examples_SelectionChanged
            string defaultLang = null!;
            string langSuffixDefault = (defaultLang ?? "vi").ToLowerInvariant() == "en" ? "_EN" : "_VN";
            Assert.Equal("_VN", langSuffixDefault);

            string enLang = "en";
            string langSuffixEn = (enLang ?? "vi").ToLowerInvariant() == "en" ? "_EN" : "_VN";
            Assert.Equal("_EN", langSuffixEn);

            string viLang = "VI-VN";
            string langSuffixVi = (viLang ?? "vi").ToLowerInvariant() == "en" ? "_EN" : "_VN";
            Assert.Equal("_VN", langSuffixVi);
        }

