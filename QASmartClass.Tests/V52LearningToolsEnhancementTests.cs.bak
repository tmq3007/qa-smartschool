        [Fact]
        public void CubicTool_SolveCubic_ThreeDistinctRealRoots_Verify()
        {
            // Case: x³ − 6x² + 11x − 6 = 0 -> roots: 1, 2, 3
            QASmartClass.LearningTools.Views.Math.CubicTool.SolveCubicStatic(1, -6, 11, -6, false, out var steps, out var realRoots, out var complexRoots);
            Assert.Equal(3, realRoots.Count);
            Assert.Contains(1.0, realRoots);
            Assert.Contains(2.0, realRoots);
            Assert.Contains(3.0, realRoots);
            Assert.Empty(complexRoots);

            // Verify Horner and Viet in steps
            string stepsDetailStr = "";
            string stepsTitleStr = "";
            foreach (var step in steps)
            {
                stepsDetailStr += step.Detail + "\n";
                stepsTitleStr += step.Title + "\n";
            }
            stepsDetailStr = stepsDetailStr.Replace("−", "-");

            Assert.Contains("x₁ = 1", stepsDetailStr);
            Assert.Contains("Horner", stepsTitleStr);
            Assert.Contains("x₁ + x₂ + x₃ = -b/a = -(-6) / 1 = 6", stepsDetailStr);
        }

        [Fact]
        public void CubicTool_SolveCubic_DoubleRoot_Verify()
        {
            // Case: x³ + 3x² − 4 = 0 -> roots: 1 (single), -2 (double)
            QASmartClass.LearningTools.Views.Math.CubicTool.SolveCubicStatic(1, 3, 0, -4, false, out var steps, out var realRoots, out var complexRoots);
            Assert.Equal(2, realRoots.Count);
            Assert.Contains(1.0, realRoots);
            Assert.Contains(-2.0, realRoots);
            Assert.Empty(complexRoots);

            string stepsDetailStr = "";
            foreach (var step in steps)
            {
                stepsDetailStr += step.Detail + "\n";
            }
            stepsDetailStr = stepsDetailStr.Replace("−", "-");
            Assert.Contains("nghiệm kép", stepsDetailStr);
        }

        [Fact]
        public void CubicTool_SolveCubic_CardanoIrrationalRoots_Verify()
        {
            // Case: x³ − 2 = 0 -> roots: 2^(1/3) ~ 1.2599 and complex
            QASmartClass.LearningTools.Views.Math.CubicTool.SolveCubicStatic(1, 0, 0, -2, false, out var steps, out var realRoots, out var complexRoots);
            Assert.Single(realRoots);
            Assert.Equal(1.25992, realRoots[0], 5);
            Assert.Equal(2, complexRoots.Count);

            string stepsTitleStr = "";
            foreach (var step in steps)
            {
                stepsTitleStr += step.Title + "\n";
            }
            Assert.Contains("Cardano", stepsTitleStr);
        }

