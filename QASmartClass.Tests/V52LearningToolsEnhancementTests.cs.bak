        [Fact]
        public void CoordinateTool_SolveTwoPoints_DistinctPoints_Verify()
        {
            // Case: A(1; 2) and B(4; 6)
            QASmartClass.LearningTools.Views.Math.CoordinateTool.SolveTwoPointsStatic(1, 2, 4, 6, false, out var steps, out double dist, out double mx, out double my);
            Assert.Equal(5.0, dist);
            Assert.Equal(2.5, mx);
            Assert.Equal(4.0, my);

            string stepsDetailStr = "";
            foreach (var step in steps)
            {
                stepsDetailStr += step.Detail + "\n";
            }
            stepsDetailStr = stepsDetailStr.Replace("−", "-");

            Assert.Contains("u⃗_AB = (3; 4)", stepsDetailStr);
            Assert.Contains("M(2.5; 4)", stepsDetailStr);
            Assert.Contains("y = 1.3333", stepsDetailStr);
            Assert.Contains("4x - 3y + 2 = 0", stepsDetailStr);
        }

