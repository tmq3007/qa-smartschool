        [Fact]
        public void TryParseDouble_WithInvalidFractionOrRoot_ReturnsFalse()
        {
            Assert.False(ParsingHelper.TryParseDouble("1/0", out _));
            Assert.False(ParsingHelper.TryParseDouble("√-4", out _));
            Assert.False(ParsingHelper.TryParseDouble("1/2/3", out _));
