        [Fact]
        public void PrimeNumberTool_Initialization_DoesNotCrash()
        {
            Exception? exception = null;
            var thread = new System.Threading.Thread(() =>
            {
                try
                {
                    var app = System.Windows.Application.Current;
                    if (app == null)
                    {
                        app = new System.Windows.Application();
                        app.Resources.Add("Gray100", new System.Windows.Media.SolidColorBrush(System.Windows.Media.Colors.LightGray));
                    }
                    else if (!app.Resources.Contains("Gray100"))
                    {
                        app.Resources.Add("Gray100", new System.Windows.Media.SolidColorBrush(System.Windows.Media.Colors.LightGray));
                    }
                    var tool = new PrimeNumberTool();
                }
                catch (Exception ex)
                {
                    exception = ex;
                }
            });
            thread.SetApartmentState(System.Threading.ApartmentState.STA);
            thread.Start();
            thread.Join();
            Assert.Null(exception);
        }

        [Fact]
        public void PrimeNumberTool_TryParseLong_VerifiesDottedAndCommaFormat()
        {
            var tryParseMethod = typeof(PrimeNumberTool)
                .GetMethod("TryParseLong", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(tryParseMethod);

            // Test Vietnamese locale (using LanguageManager.SetLanguage)
            QASmartClass.Shared.LanguageManager.SetLanguage("vi");
            
            // "3.233" should parse to 3233 in Vietnamese locale
            var args1 = new object[] { "3.233", 0L };
            bool res1 = (bool)tryParseMethod.Invoke(null, args1)!;
            Assert.True(res1);
            Assert.Equal(3233L, (long)args1[1]);

            // "3,233" should fail in Vietnamese locale as it contains comma (decimal separator)
            var args2 = new object[] { "3,233", 0L };
            bool res2 = (bool)tryParseMethod.Invoke(null, args2)!;
            Assert.False(res2);

            // Test English locale
            QASmartClass.Shared.LanguageManager.SetLanguage("en");

            // "3,233" should parse to 3233 in English locale
            var args3 = new object[] { "3,233", 0L };
            bool res3 = (bool)tryParseMethod.Invoke(null, args3)!;
            Assert.True(res3);
            Assert.Equal(3233L, (long)args3[1]);

            // "3.233" should fail in English locale as it contains dot (decimal separator)
            var args4 = new object[] { "3.233", 0L };
            bool res4 = (bool)tryParseMethod.Invoke(null, args4)!;
            Assert.False(res4);

            // Restore default Vietnamese locale
            QASmartClass.Shared.LanguageManager.SetLanguage("vi");
        }

