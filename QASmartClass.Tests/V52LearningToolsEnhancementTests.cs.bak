            string result = CoordinateTool.FormatParametricLine(1, 2, 3, 4);
            Assert.Equal("PT tham số AB: { x = 1 + 3t; y = 2 + 4t }", result);

            // Point (1, 2), vector (0, -3)
            string result2 = CoordinateTool.FormatParametricLine(1, 2, 0, -3);
            Assert.Equal("PT tham số AB: { x = 1; y = 2 − 3t }", result2);
        }

        private static void EnsureWpfApplication()
        {
            if (System.Windows.Application.Current == null)
            {
                try
                {
                    new System.Windows.Application();
                }
                catch {}
            }
            if (System.Windows.Application.Current != null)
            {
                var resources = System.Windows.Application.Current.Resources;
                if (!resources.Contains("BrandPrimary"))
                {
                    resources.Add("BrandPrimary", new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(21, 101, 192)));
                }
                if (!resources.Contains("BrandSecondary"))
                {
                    resources.Add("BrandSecondary", new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(13, 71, 161)));
                }
                if (!resources.Contains("BrandAccent"))
                {
                    resources.Add("BrandAccent", new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(230, 81, 0)));
                }
                if (!resources.Contains("Gray100"))
                {
                    resources.Add("Gray100", new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(245, 245, 245)));
                }
            }
        }

        private static T GetPrivateField<T>(object obj, string name)
        {
            var field = obj.GetType().GetField(name, System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public);
            if (field != null) return (T)field.GetValue(obj)!;
            var prop = obj.GetType().GetProperty(name, System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public);
            return (T)prop?.GetValue(obj)!;
        }

        private static void InvokePrivateMethod(object obj, string name, params object[] args)
        {
            var method = obj.GetType().GetMethod(name, System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public);
            method?.Invoke(obj, args);
        }

        [Fact]
        public void LinearSystem_SolveUniqueSolution_ReturnsCorrectNghiem()
        {
            var thread = new System.Threading.Thread(() =>
            {
                EnsureWpfApplication();
                var tool = new LinearSystemTool();
                GetPrivateField<System.Windows.Controls.TextBox>(tool, "txtA1").Text = "2";
                GetPrivateField<System.Windows.Controls.TextBox>(tool, "txtB1").Text = "3";
                GetPrivateField<System.Windows.Controls.TextBox>(tool, "txtC1").Text = "8";
                GetPrivateField<System.Windows.Controls.TextBox>(tool, "txtA2").Text = "1";
                GetPrivateField<System.Windows.Controls.TextBox>(tool, "txtB2").Text = "-1";
                GetPrivateField<System.Windows.Controls.TextBox>(tool, "txtC2").Text = "1";

                InvokePrivateMethod(tool, "Solve");

                var txtResult = GetPrivateField<System.Windows.Controls.TextBlock>(tool, "txtResult");
                var txtClassify = GetPrivateField<System.Windows.Controls.TextBlock>(tool, "txtClassify");

                Assert.Equal("x = 2.2\ny = 1.2", txtResult.Text);
                Assert.Contains("Hệ có nghiệm duy nhất", txtClassify.Text);
            });
            thread.SetApartmentState(System.Threading.ApartmentState.STA);
            thread.Start();
            thread.Join();
        }

        [Fact]
        public void LinearSystem_SolveInfiniteSolutions_ReturnsCorrectClassification()
        {
            var thread = new System.Threading.Thread(() =>
            {
                EnsureWpfApplication();
