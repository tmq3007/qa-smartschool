        [Fact]
        public void CombinatoricsTool_SolveArrangementAndCombination_Verify()
        {
            // Case: A(6,3)
            QASmartClass.LearningTools.Views.Math.CombinatoricsTool.SolveArrangementStatic(6, 3, out string expA, out var resA);
            Assert.Equal(new System.Numerics.BigInteger(120), resA);
            Assert.Equal("6 × 5 × 4", expA);

            // Case: C(6,2)
