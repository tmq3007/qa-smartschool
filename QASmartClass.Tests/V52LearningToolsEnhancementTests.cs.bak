        [Fact]
        public void IdentityTool_RealWorldExamples_VerifyBilingualDataAndCoordinates()
        {
            var type = typeof(QASmartClass.LearningTools.Views.Math.IdentityTool);
            var field = type.GetField("IdentityExamples", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(field);

            var examples = field.GetValue(null) as System.Collections.IEnumerable;
            Assert.NotNull(examples);

            int count = 0;
            foreach (var ex in examples)
            {
                Assert.NotNull(ex);
                var tVi = ex.GetType().GetProperty("TitleVi")?.GetValue(ex) as string;
                var tEn = ex.GetType().GetProperty("TitleEn")?.GetValue(ex) as string;
                var dVi = ex.GetType().GetProperty("DescVi")?.GetValue(ex) as string;
                var dEn = ex.GetType().GetProperty("DescEn")?.GetValue(ex) as string;
                var img = ex.GetType().GetProperty("ImageBase")?.GetValue(ex) as string;
                var aVal = (double)ex.GetType().GetProperty("A")!.GetValue(ex)!;
                var bVal = (double)ex.GetType().GetProperty("B")!.GetValue(ex)!;

                Assert.False(string.IsNullOrWhiteSpace(tVi));
                Assert.False(string.IsNullOrWhiteSpace(tEn));
                Assert.False(string.IsNullOrWhiteSpace(dVi));
                Assert.False(string.IsNullOrWhiteSpace(dEn));
                Assert.False(string.IsNullOrWhiteSpace(img));
                Assert.True(aVal > 0);
                Assert.True(bVal >= 0);

                count++;
            }
            Assert.Equal(6, count);
        }

