        {
            // Case: |A| = 6, |Ω| = 36 (Simplifies to 1/6)
            QASmartClass.LearningTools.Views.Math.ProbabilityTool.SolveClassicStatic(6, 36, 
                out double p, out double pComp, out double odds, out int simNum, out int simDen);

