        [Fact]
        public void CombinatoricsTool_SolveNewton_Verify()
        {
            // Case: (2 - 1.5)³
            QASmartClass.LearningTools.Views.Math.CombinatoricsTool.SolveNewtonStatic(3, 2.0, -1.5, 
                out var terms, out double totalSum, out string algebraicFormula, out string sub1, out string sub2);

            Assert.Equal(0.125, totalSum, 5);
            Assert.Equal(4, terms.Count);
            Assert.Contains("a³ + 3a²b + 3ab² + b³", algebraicFormula);
            
            // Check that "+ -" is cleaned up and Unicode minus or formatted signs are clean
            Assert.DoesNotContain("+ -", sub1);
            Assert.DoesNotContain("+ -", sub2);
        }

