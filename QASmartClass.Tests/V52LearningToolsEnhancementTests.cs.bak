        [Fact]
        public void ComplexNumberTool_FormatSpecialAngle_FormatsCorrectly()
        {
            var method = typeof(ComplexNumberTool)
                .GetMethod("FormatSpecialAngle", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(method);

            var res0 = (string)method.Invoke(null, new object[] { 0.0 })!;
            Assert.Equal("0", res0);

            var resPi3 = (string)method.Invoke(null, new object[] { System.Math.PI / 3.0 })!;
            Assert.Equal("π/3", resPi3);

            var resNegPi4 = (string)method.Invoke(null, new object[] { -System.Math.PI / 4.0 })!;
            Assert.Equal("−π/4", resNegPi4);

            var resRegular = (string)method.Invoke(null, new object[] { 1.5 })!;
            Assert.Contains("rad =", resRegular);
        }

        [Fact]
        public void ComplexNumberTool_FmtComplex_VariousInputs_FormatsCorrectly()
        {
            var method = typeof(ComplexNumberTool)
                .GetMethod("FmtComplex", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(method);

            // 3 + 4i
            var res1 = (string)method.Invoke(null, new object[] { 3.0, 4.0 })!;
            Assert.Equal("3 + 4i", res1);

            // -3 - 4i -> should use math minus
            var res2 = (string)method.Invoke(null, new object[] { -3.0, -4.0 })!;
            Assert.Equal("−3 − 4i", res2);

            // 0 + i
            var res3 = (string)method.Invoke(null, new object[] { 0.0, 1.0 })!;
            Assert.Equal("i", res3);

            // 0 - i
            var res4 = (string)method.Invoke(null, new object[] { 0.0, -1.0 })!;
            Assert.Equal("−i", res4);
        }

