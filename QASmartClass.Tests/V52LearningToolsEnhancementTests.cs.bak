        }

        [Fact]
        public void ParsingHelper_TryParseDouble_WithRadicalCoefficients_ParsesCorrectly()
        {
            bool success1 = ParsingHelper.TryParseDouble("2√3", out double val1);
            Assert.True(success1);
            Assert.Equal(2.0 * System.Math.Sqrt(3.0), val1, 5);

            bool success2 = ParsingHelper.TryParseDouble("√3/2", out double val2);
            Assert.True(success2);
            Assert.Equal(System.Math.Sqrt(3.0) / 2.0, val2, 5);

            bool success3 = ParsingHelper.TryParseDouble("2√3/3", out double val3);
            Assert.True(success3);
            Assert.Equal(2.0 * System.Math.Sqrt(3.0) / 3.0, val3, 5);

            bool success4 = ParsingHelper.TryParseDouble("3/2√2", out double val4);
            Assert.True(success4);
            Assert.Equal(1.5 * System.Math.Sqrt(2.0), val4, 5);
        }

        [Fact]
        public void VectorTool_CalculateVectorAddition_2DAnd3D_Verify()
        {
            // 2D Addition: (3, 4) + (-1, 2) = (2, 6)
            double[] sum2D = VectorTool.Add2D(3, 4, -1, 2);
            Assert.Equal(2.0, sum2D[0]);
            Assert.Equal(6.0, sum2D[1]);

            // 3D Addition: (1, -2, 2) + (2, 3, -1) = (3, 1, 1)
            double[] sum3D = VectorTool.Add3D(1, -2, 2, 2, 3, -1);
            Assert.Equal(3.0, sum3D[0]);
            Assert.Equal(1.0, sum3D[1]);
            Assert.Equal(1.0, sum3D[2]);
        }

        [Fact]
        public void VectorTool_CalculateVectorDotProduct_2DAnd3D_Verify()
        {
            // 2D Dot Product: (3, 4) . (-1, 2) = -3 + 8 = 5
            double dot2D = VectorTool.Dot2D(3, 4, -1, 2);
            Assert.Equal(5.0, dot2D);

            // 3D Dot Product: (1, -2, 2) . (2, 3, -1) = 2 - 6 - 2 = -6
            double dot3D = VectorTool.Dot3D(1, -2, 2, 2, 3, -1);
            Assert.Equal(-6.0, dot3D);
        }

        [Fact]
        public void VectorTool_CalculateVectorCrossProduct_3D_Verify()
        {
            // 3D Cross Product: (1, -2, 1) x (2, 1, -1) = (1, 3, 5)
            double[] cross1 = VectorTool.Cross3D(1, -2, 1, 2, 1, -1);
            Assert.Equal(1.0, cross1[0]);
            Assert.Equal(3.0, cross1[1]);
            Assert.Equal(5.0, cross1[2]);

            // 3D Cross Product: (2, 0, 0) x (0, 0.5, 0) = (0, 0, 1)
            double[] cross2 = VectorTool.Cross3D(2, 0, 0, 0, 0.5, 0);
            Assert.Equal(0.0, cross2[0]);
            Assert.Equal(0.0, cross2[1]);
            Assert.Equal(1.0, cross2[2]);
        }

        [Fact]
        public void VectorTool_CalculateVectorAngle_2DAnd3D_Verify()
        {
            // 2D Perpendicular check: (1, 0) and (0, 1)
            double angle1 = VectorTool.Angle2D(1, 0, 0, 1, out double cos1);
            Assert.Equal(90.0, angle1, 5);
            Assert.Equal(0.0, cos1, 5);

            // 3D Perpendicular check: (1, 1, 0) and (1, -1, 5) -> dot = 1 - 1 + 0 = 0
            double angle2 = VectorTool.Angle3D(1, 1, 0, 1, -1, 5, out double cos2);
            Assert.Equal(90.0, angle2, 5);
            Assert.Equal(0.0, cos2, 5);

            // 2D Collinear check: (3, 4) and (6, 8)
            double angle3 = VectorTool.Angle2D(3, 4, 6, 8, out double cos3);
            Assert.Equal(0.0, angle3, 5);
            Assert.Equal(1.0, cos3, 5);
        }

        [Fact]
        public void ConicSectionTool_CalcEllipseParams_Horizontal()
        {
            // Horizontal Ellipse (a >= b): a = 5, b = 3
            double a = 5;
            double b = 3;
            double c, ecc;
            bool fociOnX;
            ConicSectionTool.CalcEllipseParams(a, b, out c, out ecc, out fociOnX);

            Assert.True(fociOnX);
            Assert.Equal(4.0, c, 5); // sqrt(25 - 9) = 4
            Assert.Equal(0.8, ecc, 5); // 4 / 5 = 0.8
        }

        [Fact]
        public void ConicSectionTool_CalcEllipseParams_Vertical()
        {
            // Vertical Ellipse (a < b): a = 3, b = 5
            double a = 3;
            double b = 5;
            double c, ecc;
            bool fociOnX;
            ConicSectionTool.CalcEllipseParams(a, b, out c, out ecc, out fociOnX);

            Assert.False(fociOnX);
            Assert.Equal(4.0, c, 5); // sqrt(25 - 9) = 4
            Assert.Equal(0.8, ecc, 5); // 4 / 5 = 0.8
        }

        [Fact]
        public void ConicSectionTool_CalcHyperbolaParams()
        {
            // Hyperbola: a = 3, b = 4
            double a = 3;
            double b = 4;
            double c, ecc;
            ConicSectionTool.CalcHyperbolaParams(a, b, out c, out ecc);

            Assert.Equal(5.0, c, 5); // sqrt(9 + 16) = 5
            Assert.Equal(1.6666666666666667, ecc, 5); // 5 / 3 = 1.6667
        }

        [Fact]
        public void ConicSectionTool_CalcParabolaParams()
        {
            // Parabola: p = 4
            double p = 4;
            double pHalf;
            ConicSectionTool.CalcParabolaParams(p, out pHalf);

            Assert.Equal(2.0, pHalf, 5); // 4 / 2 = 2.0
        }

        [Fact]
        public void SolidGeometryTool_CalcBoxParams_Verify()
        {
            // Box: a=3, b=4, c=5
            double a = 3, b = 4, c = 5;
            double v, stp, diag;
            SolidGeometryTool.CalcBoxParams(a, b, c, out v, out stp, out diag);

            Assert.Equal(60.0, v); // 3 * 4 * 5 = 60
            Assert.Equal(94.0, stp); // 2 * (12 + 20 + 15) = 94
            Assert.Equal(System.Math.Sqrt(50), diag, 5); // sqrt(9 + 16 + 25) = sqrt(50)
        }

        [Fact]
        public void SolidGeometryTool_CalcTriPyramidParams_Verify()
        {
            // Triangular Pyramid: a=6, h=8
            double a = 6, h = 8;
            double sBase, v, apothemBase, apothemPyramid, sxq, stp, edge;
            SolidGeometryTool.CalcTriPyramidParams(a, h, out sBase, out v, out apothemBase, out apothemPyramid, out sxq, out stp, out edge);

            // sBase = 36 * sqrt(3) / 4 = 9 * sqrt(3) ≈ 15.588457
            Assert.Equal(9.0 * System.Math.Sqrt(3.0), sBase, 5);
            // v = sBase * h / 3 = 24 * sqrt(3) ≈ 41.569219
            Assert.Equal(24.0 * System.Math.Sqrt(3.0), v, 5);
            // apothemBase = a * sqrt(3) / 6 = sqrt(3)
            Assert.Equal(System.Math.Sqrt(3.0), apothemBase, 5);
            // apothemPyramid = sqrt(h^2 + r_in^2) = sqrt(64 + 3) = sqrt(67) ≈ 8.18535
            Assert.Equal(System.Math.Sqrt(67.0), apothemPyramid, 5);
            // sxq = 0.5 * perimeter * apothemPyramid = 0.5 * 18 * sqrt(67) = 9 * sqrt(67) ≈ 73.66817
            Assert.Equal(9.0 * System.Math.Sqrt(67.0), sxq, 5);
        }

        [Fact]
        public void SolidGeometryTool_CalcConeParams_Verify()
        {
            // Cone: r=3, h=4
            double r = 3, h = 4;
            double l, v, sxq, stp;
            SolidGeometryTool.CalcConeParams(r, h, out l, out v, out sxq, out stp);

            Assert.Equal(5.0, l, 5); // sqrt(9 + 16) = 5
            Assert.Equal(12.0 * System.Math.PI, v, 5); // (1/3) * pi * 9 * 4 = 12 * pi
            Assert.Equal(15.0 * System.Math.PI, sxq, 5); // pi * 3 * 5 = 15 * pi
            Assert.Equal(24.0 * System.Math.PI, stp, 5); // pi * 3 * (3 + 5) = 24 * pi
        }

