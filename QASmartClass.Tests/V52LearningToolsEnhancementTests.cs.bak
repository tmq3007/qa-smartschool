        [Fact]
        public void LimitTool_SolvePolyLimitStatic_RemovableSingularity_ReturnsHoleCoordinates()
        {
            // lim_{x -> 1} (x^2 - 1) / (x - 1)
            // L'Hopital: 2x / 1 at x=1 -> 2
            LimitTool.SolvePolyLimitStatic(1, 0, -1, 0, 1, -1, 1, false, out var stepRows, out bool isHole, out double holeY, out bool isAsymptote);
            Assert.True(isHole);
            Assert.Equal(2.0, holeY, 5);
            Assert.False(isAsymptote);
        }

        [Fact]
        public void LimitTool_SolvePolyLimitStatic_VerticalAsymptote_ReturnsInfinite()
        {
            // lim_{x -> 1} (x^2 + 1) / (x - 1) -> infinite
            LimitTool.SolvePolyLimitStatic(1, 0, 1, 0, 1, -1, 1, false, out var stepRows, out bool isHole, out double holeY, out bool isAsymptote);
            Assert.False(isHole);
            Assert.True(isAsymptote);
        }

