        [Fact]
        public void Combinatorics_CombinationCalculation_ReturnsCorrectValue()
        {
            var factorialMethod = typeof(QASmartClass.LearningTools.Views.Math.CombinatoricsTool)
                .GetMethod("Factorial", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(factorialMethod);
            
            var f10 = (System.Numerics.BigInteger)factorialMethod.Invoke(null, new object[] { 10 })!;
            var f3 = (System.Numerics.BigInteger)factorialMethod.Invoke(null, new object[] { 3 })!;
            var f7 = (System.Numerics.BigInteger)factorialMethod.Invoke(null, new object[] { 7 })!;

            var result = f10 / (f3 * f7);
            Assert.Equal(new System.Numerics.BigInteger(120), result);
        }

        [Fact]
        public void Combinatorics_ArrangementCalculation_ReturnsCorrectValue()
        {
            var factorialMethod = typeof(QASmartClass.LearningTools.Views.Math.CombinatoricsTool)
                .GetMethod("Factorial", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(factorialMethod);
            
            var f10 = (System.Numerics.BigInteger)factorialMethod.Invoke(null, new object[] { 10 })!;
            var f7 = (System.Numerics.BigInteger)factorialMethod.Invoke(null, new object[] { 7 })!;

            var result = f10 / f7;
            Assert.Equal(new System.Numerics.BigInteger(720), result);
        }

        [Fact]
        public void CoordinateTool_SimplifyEquation_IntegersAndDecimals_SimplifiesCorrectly()
        {
            // Case 1: Decimals: -1.5, 1, 0 -> 1.5x - y = 0 -> 3x - 2y = 0
            CoordinateTool.SimplifyEquation(-1.5, 1, 0, out double sA, out double sB, out double sC);
            Assert.Equal(3.0, sA);
            Assert.Equal(-2.0, sB);
            Assert.Equal(0.0, sC);

            // Case 2: Negative leading coefficient: -2, -4, 6 -> 2x + 4y - 6 = 0 -> 1, 2, -3
            CoordinateTool.SimplifyEquation(-2, -4, 6, out sA, out sB, out sC);
            Assert.Equal(1.0, sA);
            Assert.Equal(2.0, sB);
            Assert.Equal(-3.0, sC);

            // Case 3: Decimals with scaling needed: 0.2, -0.4, 0.6 -> 1, -2, 3
            CoordinateTool.SimplifyEquation(0.2, -0.4, 0.6, out sA, out sB, out sC);
            Assert.Equal(1.0, sA);
            Assert.Equal(-2.0, sB);
            Assert.Equal(3.0, sC);
        }

