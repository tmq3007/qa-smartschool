        [Fact]
        public void LimitTool_SolvePolyLimitStatic_Rational_Verify()
        {
            // lim_{x -> 1} (x^2 - 3x + 2) / (x^2 - 1)
            // L'Hopital: (2x - 3) / (2x) at x=1 -> -0.5
            LimitTool.SolvePolyLimitStatic(1, -3, 2, 1, 0, -1, 1, false, out var stepRows, out bool isHole, out double holeY, out bool isAsymptote);

            Assert.True(isHole);
            Assert.Equal(-0.5, holeY, 5);
            Assert.False(isAsymptote);
            Assert.NotEmpty(stepRows);
            Assert.Contains("L'Hôpital = f'(1)/g'(1) = -1/2 = -0.5", string.Join("\n", stepRows).Replace("−", "-"));
        }

        [Fact]
        public void LimitTool_SolvePolyLimitStatic_Infinity_Verify()
        {
            // lim_{x -> infinity} (2x^2 + 5x) / (x^2 - 3) -> 2
            LimitTool.SolvePolyLimitStatic(2, 5, 0, 1, 0, -3, 0, true, out var stepRows, out bool isHole, out double holeY, out bool isAsymptote);

            Assert.False(isHole);
            Assert.False(isAsymptote);
            Assert.Contains("lim(x→∞) = 2", stepRows);
        }

