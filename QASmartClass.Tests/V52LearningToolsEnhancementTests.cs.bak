        [Fact]
        public void InequalityTool_SolveLinear_VariousCases_Verify()
        {
            // Case 1: 2x - 6 > 0
            InequalityTool.SolveLinearStatic(2, -6, 0, out string steps1, out string interval1, out string summary1);
            Assert.Contains("x > 3", steps1);
            Assert.Equal("(3; +∞)", interval1);

            // Case 2: -2x + 6 >= 0 (reverse direction)
            InequalityTool.SolveLinearStatic(-2, 6, 1, out string steps2, out string interval2, out string summary2);
            Assert.True(steps2.Contains("ĐỔI CHIỀU") || steps2.Contains("REVERSE"));
            Assert.Equal("(−∞; 3]", interval2);
        }

        [Fact]
        public void InequalityTool_SolveQuadratic_VariousDeltas_Verify()
        {
            // Case delta > 0: x^2 - 5x + 6 < 0
            InequalityTool.SolveQuadraticStatic(1, -5, 6, 2, out _, out string interval1, out _);
            Assert.Equal("(2; 3)", interval1);

            // Case delta = 0: x^2 - 6x + 9 > 0 (strictly positive, root is 3)
            InequalityTool.SolveQuadraticStatic(1, -6, 9, 0, out _, out string interval2, out _);
            Assert.Equal("(−∞; 3) ∪ (3; +∞)", interval2);

            // Case delta < 0: x^2 + x + 1 > 0
            InequalityTool.SolveQuadraticStatic(1, 1, 1, 0, out _, out string interval3, out _);
            Assert.Equal("(−∞; +∞)", interval3);
        }

        [Fact]
        public void InequalityTool_SolveQuadratic_SignChartAndSteps_Verify()
        {
            // Verify that delta > 0 generates sign chart and contains expected format
            InequalityTool.SolveQuadraticStatic(1, -5, 6, 0, out string steps, out _, out _);
            Assert.Contains("BẢNG XÉT DẤU", steps);
            Assert.Contains("f(x) │", steps);
        }

