        [Fact]
        public void MatrixTool_CalcDet_Verify()
        {
            // Arrange: 2x2 matrix
            double[,] m2 = { { 3, 5 }, { 1, 2 } };
            // Act
            double det2 = MatrixTool.DeterminantStatic(m2, 2, out var steps2);
            // Assert
            Assert.Equal(1.0, det2);
            Assert.NotEmpty(steps2);

            // Arrange: 3x3 matrix
            double[,] m3 = { { 2, 1, 3 }, { 0, 4, 1 }, { 5, 2, 0 } };
            // Act
            double det3 = MatrixTool.DeterminantStatic(m3, 3, out var steps3);
            // Assert: det = -59
            Assert.Equal(-59.0, det3);
            Assert.NotEmpty(steps3);
        }

        [Fact]
        public void MatrixTool_CalcInverse_Verify()
        {
            // Arrange: 2x2 invertible matrix
            double[,] m = { { 2, 5 }, { 1, 3 } };
            // Act
            double det = MatrixTool.DeterminantStatic(m, 2, out _);
            double[,] inv = MatrixTool.InverseStatic(m, 2, det, out string steps);
            // Assert
            Assert.NotNull(inv);
            Assert.Equal(3.0, inv[0, 0], 5);
            Assert.Equal(-5.0, inv[0, 1], 5);
            Assert.Equal(-1.0, inv[1, 0], 5);
            Assert.Equal(2.0, inv[1, 1], 5);
            Assert.True(steps.Contains("Ma trận phụ hợp") || steps.Contains("Adjugate Matrix"));

            // Arrange: 2x2 singular matrix
            double[,] mSing = { { 1, 2 }, { 2, 4 } };
            double detSing = MatrixTool.DeterminantStatic(mSing, 2, out _);
            double[,] invSing = MatrixTool.InverseStatic(mSing, 2, detSing, out string stepsSing);
            // Assert
            Assert.Null(invSing);
            Assert.True(stepsSing.Contains("suy biến") || stepsSing.Contains("Singular"));
        }

        [Fact]
        public void MatrixTool_CalcMultiply_Verify()
        {
            // Arrange
            double[,] a = { { 1, 2 }, { 3, 4 } };
            double[,] b = { { 2, 0 }, { 1, 2 } };
            // Act
            double[,] c = MatrixTool.MultiplyStatic(a, b, 2, out var steps);
            // Assert: [4, 4; 10, 8]
            Assert.Equal(4.0, c[0, 0]);
            Assert.Equal(4.0, c[0, 1]);
            Assert.Equal(10.0, c[1, 0]);
            Assert.Equal(8.0, c[1, 1]);
            Assert.NotEmpty(steps);
        }

        [Fact]
        public void MatrixTool_CalcAdd_Verify()
        {
            // Arrange
            double[,] a = { { 1, 2 }, { 3, 4 } };
            double[,] b = { { 5, 6 }, { 7, 8 } };
            // Act
            double[,] c = MatrixTool.AddStatic(a, b, 2, out var steps);
            // Assert
            Assert.Equal(6.0, c[0, 0]);
            Assert.Equal(8.0, c[0, 1]);
            Assert.Equal(10.0, c[1, 0]);
            Assert.Equal(12.0, c[1, 1]);
            Assert.NotEmpty(steps);
        }

