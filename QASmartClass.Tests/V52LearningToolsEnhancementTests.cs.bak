        [Fact]
        public void VectorTool_SolveTwoVecStatic_Verify()
        {
            // Vector a = (3, 4), Vector b = (-1, 2)
            double x1 = 3, y1 = 4, z1 = 0;
            double x2 = -1, y2 = 2, z2 = 0;
            bool is3D = false;

            VectorTool.SolveTwoVecStatic(
                x1, y1, z1, x2, y2, z2, is3D,
                out double[] sum, out double[] diff,
                out double magA, out double magB,
                out double dot, out double[] cross,
                out double angleDeg, out double cosAngle,
                out List<string> steps);

            Assert.Equal(2.0, sum[0]);
            Assert.Equal(6.0, sum[1]);
            Assert.Equal(4.0, diff[0]);
            Assert.Equal(2.0, diff[1]);
            Assert.Equal(5.0, magA, 5); // sqrt(9 + 16) = 5
            Assert.Equal(5.0, dot); // -3 + 8 = 5
            Assert.NotEmpty(steps);
            Assert.Contains("Phép cộng hai vectơ", steps[1]);
        }

