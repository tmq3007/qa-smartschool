        [Fact]
        public void IntegralTool_FormatAntideriv_FormatsCorrectly()
        {
            var method = typeof(IntegralTool)
                .GetMethod("FormatAntideriv", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(method);

            // A=1, B=-3, C=2, D=5 -> F(x) = (1/4)x⁴ − (3/3)x³ + (2/2)x² + 5x
            var res1 = (string)method.Invoke(null, new object[] { 1.0, -3.0, 2.0, 5.0 })!;
            Assert.Equal("(1/4)x⁴ − (3/3)x³ + (2/2)x² + 5x", res1);

            // A=-1, B=0, C=-2, D=-5 -> F(x) = −(1/4)x⁴ − (2/2)x² − 5x
            var res2 = (string)method.Invoke(null, new object[] { -1.0, 0.0, -2.0, -5.0 })!;
            Assert.Equal("−(1/4)x⁴ − (2/2)x² − 5x", res2);
        }

