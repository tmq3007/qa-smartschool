        [Fact]
        public void ToSuperscriptString_StandardAndNegativeExponents_FormatsCorrectly()
        {
            Assert.Equal("²", DerivativeTool.ToSuperscriptString(2));
            Assert.Equal("⁻³", DerivativeTool.ToSuperscriptString(-3));
            Assert.Equal("¹˙⁵", DerivativeTool.ToSuperscriptString(1.5));
        }

        [Fact]
        public void DerivativeTool_FormatTerm_StandardAndNegativeCoefficients_FormatsCorrectly()
        {
            var method = typeof(DerivativeTool)
                .GetMethod("FormatTerm", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(method);

            // 3x^2 -> 3x²
            var res1 = (string)method.Invoke(null, new object[] { 3.0, 2.0, "x" })!;
            Assert.Equal("3x²", res1);

            // -1x^3 -> −x³ (uses Unicode minus \u2212)
            var res2 = (string)method.Invoke(null, new object[] { -1.0, 3.0, "x" })!;
            Assert.Equal("−x³", res2);

            // 0.5x^-1 -> 0.5x⁻¹
            var res3 = (string)method.Invoke(null, new object[] { 0.5, -1.0, "x" })!;
            Assert.Equal("0.5x⁻¹", res3);
        }

        [Fact]
        public void DerivativeTool_FormatPoly_CubicPolynomials_FormatsCorrectly()
        {
            var method = typeof(DerivativeTool)
                .GetMethod("FormatPoly", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
            Assert.NotNull(method);

            // 1x^3 - 3x^2 + 2x -> x³ − 3x² + 2x
            var res1 = (string)method.Invoke(null, new object[] { 1.0, -3.0, 2.0, 0.0 })!;
            Assert.Equal("x³ − 3x² + 2x", res1);

            // -2x^3 + 0x^2 - 1x + 5 -> −2x³ − x + 5
            var res2 = (string)method.Invoke(null, new object[] { -2.0, 0.0, -1.0, 5.0 })!;
            Assert.Equal("−2x³ − x + 5", res2);
        }

