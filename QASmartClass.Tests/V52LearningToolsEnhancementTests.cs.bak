        [Fact]
        public void SequenceTool_SolveAP_VariousCases_Verify()
        {
            // Case: u1=3, d=5, n=10, isEn=false
            SequenceTool.SolveAPStatic(3, 5, 10, false, out string steps, out string terms, out string summary, out double un, out double sn);
            Assert.Equal(48, un);
            Assert.Equal(255, sn);
            Assert.Contains("U_10 = 3 + 9 · (5) = 48", steps.Replace("−", "-"));
            Assert.Contains("S_10 = 10 · (3 + 48) / 2", steps.Replace("−", "-"));
            Assert.Contains("S_10 = 10 · (51) / 2 = 255", steps.Replace("−", "-"));
            Assert.Equal("3, 8, 13, 18, 23, 28, 33, 38, ... , 48", terms.Replace("−", "-"));
        }

        [Fact]
        public void SequenceTool_SolveGP_VariousCases_Verify()
        {
            // Case: u1=2, q=3, n=8, isEn=false
            SequenceTool.SolveGPStatic(2, 3, 8, false, out string steps, out string terms, out string summary, out double un, out double sn);
            Assert.Equal(4374, un);
            Assert.Equal(6560, sn);
            Assert.Contains("U_8 = 2 · 3⁷", steps.Replace("−", "-"));
            Assert.Contains("U_8 = 2 · 2187 = 4374", steps.Replace("−", "-"));
            Assert.Contains("S_8 = 2 · (3⁸ - 1) / (3 - 1)", steps.Replace("−", "-"));
            Assert.Contains("S_8 = 2 · (6560) / (2) = 6560", steps.Replace("−", "-"));
            Assert.Equal("2, 6, 18, 54, 162, 486, 1458, 4374", terms.Replace("−", "-"));
        }

        [Fact]
        public void SequenceTool_SolveGP_InfiniteSum_Verify()
        {
            // Case: u1=10, q=0.5 (infinite GP), n=5, isEn=false
            SequenceTool.SolveGPStatic(10, 0.5, 5, false, out string steps, out _, out _, out _, out _);
            Assert.Contains("Tổng cấp số nhân lùi vô hạn", steps);
            Assert.Contains("S_∞ = U₁ / (1 - q) = 10 / (1 - 0.5) = 20", steps.Replace("−", "-"));
        }

