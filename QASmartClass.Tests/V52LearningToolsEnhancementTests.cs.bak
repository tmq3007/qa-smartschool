        [Fact]
        public void LimitTool_ParsingHelper_NormalizesAndParsesCorrectly()
        {
            // Verify that TryParseDouble replaces mathematical minus '−' (\u2212) with '-' and parses correctly
            bool success = ParsingHelper.TryParseDouble("−4.9", out double val);
            Assert.True(success);
            Assert.Equal(-4.9, val);

            bool successFraction = ParsingHelper.TryParseDouble("1/2", out double valFrac);
