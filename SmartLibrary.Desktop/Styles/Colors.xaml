<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu từ Mockup (Chuẩn Thương Mại UI 4X) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5" /> <!-- Indigo-600 -->
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#4338CA" /> <!-- Indigo-700 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#10B981" /> <!-- Emerald-500 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC" /> <!-- Slate-50 -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B" /> <!-- Slate-800 -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" /> <!-- Slate-500 -->
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#16A34A" />
    
    <!-- Success Button Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" /> <!-- Emerald-500 / Accent -->
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#059669" /> <!-- Emerald-600 -->
    
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#D97706" />

    <!-- Warning Button Brushes -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F97316" /> <!-- Orange-500 -->
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#EA580C" /> <!-- Orange-600 -->
    
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#DC2626" />

    <!-- Danger Button Brushes -->
    <SolidColorBrush x:Key="DangerHoverBgBrush" Color="#FECACA" /> <!-- Red-200 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" /> <!-- Red-500 -->
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626" /> <!-- Red-600 -->

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" /> <!-- Slate-200 -->
    
    <!-- Sidebar Items Background (Transparent effect) -->
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="DarkNavySidebarBrush" Color="#0B132B"/>

    <!-- Modern Dropdown Brushes -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#2563EB" />
    
    <!-- Eco-friendly Metrics Brushes -->
    <SolidColorBrush x:Key="CyanTextBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="BlueTextBrush" Color="#3B82F6" />
    
    <!-- Semi-transparent overlay brush -->
    <SolidColorBrush x:Key="PopupOverlayBrush" Color="#800F172A" />

    <!-- Màu nhiệt kệ sách (Đo lường mật độ & tần suất mượn trả) -->
    <SolidColorBrush x:Key="HeatmapEmptyBrush" Color="#1E293B"/> <!-- Slate (Trống) -->
    <SolidColorBrush x:Key="HeatmapColdBrush" Color="#1E3A8A"/>  <!-- Blue (Lạnh) -->
    <SolidColorBrush x:Key="HeatmapCoolBrush" Color="#065F46"/>  <!-- Green (Mát) -->
    <SolidColorBrush x:Key="HeatmapWarmBrush" Color="#B45309"/>  <!-- Amber (Ấm) -->
    <SolidColorBrush x:Key="HeatmapVeryHotBrush" Color="#991B1B"/> <!-- Red (Rất nóng) -->
</ResourceDictionary>
