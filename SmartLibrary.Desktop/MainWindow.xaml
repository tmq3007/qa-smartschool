<Window x:Class="SmartLibrary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartLibrary.Desktop"
        xmlns:auth="clr-namespace:SmartLibrary.Desktop.Views.Auth"
        xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
        mc:Ignorable="d"
        Title="Smart Library 4.0" Height="768" Width="1366" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    

    <Grid>
        <!-- Login View Container -->
        <ContentControl x:Name="LoginContainer">
            <auth:LoginView x:Name="LoginControl" />
        </ContentControl>

        <!-- Main Shell Container (Hidden initially) -->
        <DockPanel x:Name="MainShell" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}">
            <shared:SidebarControl DockPanel.Dock="Left" />
            <shared:AudioPlayerControl x:Name="AudioPlayer" DockPanel.Dock="Bottom" />
            
            <!-- Content Area -->
            <ContentControl Content="{Binding CurrentView}" Margin="0"/>
        </DockPanel>

        <!-- Offline Overlay Control (Covers everything) -->
        <shared:OfflineStateControl x:Name="OfflineOverlay" Visibility="Collapsed" Panel.ZIndex="1000"/>

        <!-- Dynamic Toast Container -->
        <StackPanel x:Name="ToastContainer" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,80,24,0" Panel.ZIndex="2000"/>

        <!-- Notification Toast Banner -->
        <Border x:Name="NotificationBanner" Background="{DynamicResource StateError}" CornerRadius="8" Padding="24,14" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,32,0,0" Panel.ZIndex="1001" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotificationText" Foreground="White" FontSize="15" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="✕" Click="CloseNotification_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14" Margin="16,0,0,0" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
