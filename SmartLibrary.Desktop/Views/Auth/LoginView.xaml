<UserControl x:Class="SmartLibrary.Desktop.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartLibrary.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <!-- Geometries for vector Path icons -->
        <Geometry x:Key="SchoolIcon">M12 3L1 9L5 11.18V17.18L1 18V20H23V18L19 17.18V11.18L23 9L12 3M12 6L19.5 10.09L12 14.18L4.5 10.09L12 6M7 12.27L11 14.45V18H7V12.27M13 14.45L17 12.27V18H13V14.45Z</Geometry>
        <Geometry x:Key="CameraIcon">M4 4H8L10 2H14L16 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4M12 9C10.3 9 9 10.3 9 12C9 13.7 10.3 15 12 15C13.7 15 15 13.7 15 12C15 10.3 13.7 9 12 9M12 7.3C14.6 7.3 16.7 9.4 16.7 12C16.7 14.6 14.6 16.7 12 16.7C9.4 16.7 7.3 14.6 7.3 12C7.3 9.4 9.4 7.3 12 7.3Z</Geometry>
        <Geometry x:Key="EyeOpenIcon">M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5M12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17M12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z</Geometry>
        <Geometry x:Key="EyeClosedIcon">M2 4.27L5.73 8C1.64 12.09 2.91 13.36 2.91 13.36L7 9.27L19.73 22L21 20.73L3.27 3L2 4.27M12 19.5C7 19.5 2.73 16.39 1 12C2.73 7.61 7 4.5 12 4.5C13.4 4.5 14.74 4.8 16 5.33L14.43 6.9C13.66 6.64 12.84 6.5 12 6.5C8.13 6.5 4.88 8.71 3.32 12C4.88 15.29 8.13 17.5 12 17.5C15.87 17.5 19.12 15.29 20.68 12C20.17 10.92 19.46 9.96 18.6 9.15L20.17 7.58C21.36 8.78 22.33 10.27 23 12C21.27 16.39 17 19.5 12 19.5M12 9A3 3 0 0 1 15 12A3 3 0 0 1 12 15A3 3 0 0 1 9 12A3 3 0 0 1 12 9Z</Geometry>
        <Geometry x:Key="SettingsIcon">M19.14 12.94C19.18 12.63 19.2 12.32 19.2 12C19.2 11.68 19.18 11.37 19.14 11.06L21.4 9.3C21.6 9.1 21.66 8.82 21.53 8.6L19.4 4.9C19.27 4.7 19 4.6 18.78 4.7L16.12 5.8C15.56 5.37 14.96 5 14.31 4.73L13.91 1.9C13.87 1.66 13.66 1.48 13.42 1.48H9.18C8.94 1.48 8.73 1.66 8.69 1.9L8.29 4.73C7.64 5 7.04 5.37 6.48 5.8L3.82 4.7C3.6 4.6 3.33 4.7 3.2 4.9L1.07 8.6C0.94 8.82 1 9.1 1.2 9.3L3.46 11.06C3.42 11.37 3.4 11.68 3.4 12C3.4 12.32 3.42 12.63 3.46 12.94M1.2 14.7C1 14.9 0.94 15.18 1.07 15.4L3.2 19.1C3.33 19.3 3.6 19.4 3.82 19.3L6.48 18.2C7.04 18.63 7.64 19 8.29 19.27L8.69 22.1C8.73 22.34 8.94 22.52 9.18 22.52H13.42C13.66 22.52 13.87 22.34 13.91 22.1L14.31 19.27C14.96 19 15.56 18.63 16.12 18.2L18.78 19.3C19 19.4 19.27 19.3 19.4 19.1L21.53 15.4C21.66 15.18 21.6 14.9 21.4 14.7L19.14 12.94M11.3 15.6C9.3 15.6 7.7 14 7.7 12C7.7 10 9.3 8.4 11.3 8.4C13.3 8.4 14.9 10 14.9 12C14.9 14 13.3 15.6 11.3 15.6Z</Geometry>
        <!-- Style cho các Input (SaaS/Enterprise) - Thừa hưởng từ App.xaml để hỗ trợ Dark Mode -->

        <!-- Style cho Gradient Button -->
        <Style x:Key="GradientButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#1E40AF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <StackPanel x:Name="normalContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
                                    <ContentPresenter />
                                </StackPanel>
                                <StackPanel x:Name="loadingContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16" Visibility="Collapsed">
                                    <!-- Spinner Arc -->
                                    <Path x:Name="spinnerPath" Data="M2,12A10,10 0 0,1 12,2V4A8,8 0 0,0 4,12H2Z" Fill="White" Width="20" Height="20" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="spinnerRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="ĐANG XÁC THỰC..." Foreground="White" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="normalContent" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="loadingContent" Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="spinStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="spinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="spinStoryboard"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Converter: Bool to Eye Icon -->
        <local:BoolToEyeIconConverter x:Key="BoolToEyeIconConverter"/>

        <!-- Shake Animation for Form Errors -->
        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FormTranslateTransform" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5.5*"/>
            <ColumnDefinition Width="4.5*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: BRANDING (55%) -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E3A8A" Offset="0"/> <!-- Dark Blue -->
                    <GradientStop Color="#312E81" Offset="1"/> <!-- Indigo -->
                </LinearGradientBrush>
            </Border.Background>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource SchoolIcon}" Fill="White" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="Smart Library" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="HỆ THỐNG QUẢN LÝ THƯ VIỆN THÔNG MINH" FontSize="20" FontWeight="SemiBold" Foreground="#93C5FD" HorizontalAlignment="Center" Margin="0,16,0,0" />
                
                <Border Background="#22FFFFFF" CornerRadius="12" Padding="24" Margin="0,48,0,0" Width="400">
                    <TextBlock Text="Đẳng cấp Enterprise. Ổn định. Bảo mật." Foreground="#E0E7FF" FontSize="16" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- CỘT PHẢI: LOGIN FORM (45%) -->
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <StackPanel x:Name="FormContainer" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="FormTranslateTransform" X="0" Y="0"/>
                </StackPanel.RenderTransform>
                
                <!-- Tên Trường học (Cá nhân hóa thương hiệu) -->
                <TextBlock Text="{Binding SchoolName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                
                <!-- Tiêu đề -->
                <TextBlock Text="Chào mừng trở lại!" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Vui lòng đăng nhập để vào hệ thống quản lý." FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                <!-- Danh ngôn khuyến đọc (YoY) -->
                <Border Background="#0D4F46E5" BorderBrush="#1A4F46E5" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,20" MaxWidth="400" HorizontalAlignment="Center" Opacity="0">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:1"
                                                     BeginTime="0:0:0.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <TextBlock Text="{Binding InspirationalQuote}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" FontStyle="Normal"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Báo lỗi -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,24" 
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="Medium"/>
                </Border>

                <!-- Input: Tài khoản -->
                <TextBlock Text="Mã định danh học sinh / cán bộ (SSO ID)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,24">
                    <TextBox x:Name="txtUsername" Text="{Binding SsoUserId, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" CharacterCasing="Upper" Style="{StaticResource ModernInputStyle}"/>
                    <TextBlock Text="Mã học sinh / giáo viên (SSO ID)..." IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SsoUserId}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SsoUserId}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Input: Mật khẩu (Show/Hide) -->
                <TextBlock Text="Mật khẩu" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,24">
                    <!-- PasswordBox (hidden mode) -->
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernInputStyle}" MaxLength="50"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                 PasswordChanged="txtPassword_PasswordChanged"/>
                    <!-- TextBox (visible mode) -->
                    <TextBox x:Name="txtPasswordVisible" Text="{Binding PasswordText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernInputStyle}" MaxLength="50"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- Watermark -->
                    <TextBlock Text="Mật khẩu..." IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PasswordText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PasswordText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Toggle button -->
                    <Button Command="{Binding TogglePasswordVisibilityCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Margin="0,0,12,0" Padding="4"
                            ToolTip="Hiện/ẩn mật khẩu">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Path x:Name="eyePath" Data="{StaticResource EyeClosedIcon}" Fill="{DynamicResource TextSecondaryBrush}" Width="20" Height="20" Stretch="Uniform"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter TargetName="eyePath" Property="Data" Value="{StaticResource EyeOpenIcon}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="eyePath" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Input: Vai trò -->
                <TextBlock Text="Đăng nhập với tư cách" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ComboBox SelectedItem="{Binding SelectedRole}" ItemsSource="{Binding AvailableRoles}" 
                          FontSize="16" Padding="12" Margin="0,0,0,32"
                          BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="48" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RoleToVietnameseConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Nút Đăng nhập -->
                <Button Content="ĐĂNG NHẬP HỆ THỐNG" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPassword}" Style="{StaticResource GradientButtonStyle}" IsDefault="True"/>

                 <!-- Phân cách -->
                <Grid Margin="0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource BorderBrush}"/>
                    <TextBlock Grid.Column="1" Text="Hoặc đăng nhập nhanh" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0" FontSize="14"/>
                    <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource BorderBrush}"/>
                </Grid>

                <!-- Nút Đăng nhập QR / Smart Card -->
                <Button Command="{Binding LoginWithQrCommand}" Background="Transparent" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" Foreground="{DynamicResource PrimaryBrush}" FontSize="16" FontWeight="SemiBold" Padding="16" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="qrBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <Path Data="{StaticResource CameraIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Sử dụng thẻ QR hoặc thẻ thông minh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="qrBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <!-- Rescue Link -->
                <TextBlock HorizontalAlignment="Center" Margin="0,24,0,0" FontSize="12">
                    <Hyperlink Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="None" Cursor="Hand">
                        <Hyperlink.Style>
                            <Style TargetType="Hyperlink">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Hyperlink.Style>
                        Quên mã định danh hoặc mật khẩu? Nhấp vào đây để xem hướng dẫn.
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Nút Cài đặt phần cứng (Gear) - Chỉ hiển thị cho Thủ thư / Admin -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Width="40" Height="40"
                    ToolTip="Cấu hình thiết bị phần cứng (Camera / RFID Reader)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="20" Width="40" Height="40">
                                        <Path x:Name="btnPath" Data="{StaticResource SettingsIcon}" Fill="{DynamicResource TextSecondaryBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            <Setter TargetName="btnPath" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedRole}" Value="Librarian">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedRole}" Value="Admin">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Lớp phủ Camera QR Code (Toàn màn hình) -->
        <Border Grid.ColumnSpan="2" Background="#DD0F172A" Visibility="{Binding IsScanningQr, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ĐƯA THẺ QR / SMART CARD VÀO CAMERA" FontSize="36" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,48" />
                
                <!-- Khung Camera ảo -->
                <Border Width="450" Height="450" BorderBrush="#38BDF8" BorderThickness="4" CornerRadius="24" Background="#1E293B">
                    <TextBlock Text="[ CAMERA FEED ]" Foreground="#38BDF8" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                
                <TextBlock Text="Đang đồng bộ phần cứng..." FontSize="20" Foreground="#94A3B8" TextAlignment="Center" Margin="0,32,0,0"/>

                <!-- Thông báo bảo mật tuân thủ Nghị định 13/2023/NĐ-CP -->
                <TextBlock Text="Hệ thống chỉ sử dụng camera để quét mã QR thẻ, không ghi nhận hay lưu trữ hình ảnh cá nhân của bạn." 
                           FontSize="13" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="450" Margin="0,16,0,0"/>

                <Button Content="HỦY QUÉT THẺ" Command="{Binding CancelQrCommand}" Background="{DynamicResource StateError}" Foreground="White" FontSize="18" FontWeight="Bold" Padding="32,16" Margin="0,48,0,0" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cancelBtn" Background="{TemplateBinding Background}" CornerRadius="30">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cancelBtn" Property="Background" Value="#DC2626"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
