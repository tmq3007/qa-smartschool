<UserControl x:Class="SmartLibrary.Desktop.Views.Teacher.ProposalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="📥 Đề xuất danh mục giáo trình" ActionButtonText=""/>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Form nhập đề xuất -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Gửi Đề Xuất Mới" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1">
                        <!-- Step 1: Nhập thông tin sách -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Background="{DynamicResource HoverBackgroundBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="P1" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bước 1: Chọn loại và tên danh mục" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                                
                                <TextBlock Text="Loại đề xuất" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ProposalTypes}" SelectedItem="{Binding ProposalType}" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" Style="{StaticResource ModernComboBox}"/>

                                <TextBlock Text="Tên thể loại / NXB / Bộ môn" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ProposalName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInputStyle}"/>
                                <TextBlock Text="Ví dụ: NXB Giáo dục, Sách tham khảo Toán 12, Bộ môn Khoa học tự nhiên..." FontSize="10.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12"/>
                            </StackPanel>
                        </Border>

                        <!-- Arrow 1 -->
                        <TextBlock Text="↓" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,-4,0,8"/>

                        <!-- Step 2: Lý do đề xuất -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Background="{DynamicResource HoverBackgroundBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="P2" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bước 2: Nêu lý do và thuyết minh" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>

                                <TextBlock Text="Lý do đề xuất / Ghi chú chi tiết" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ProposalReason, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource ModernInputStyle}"/>
                                <TextBlock Text="Ví dụ: Phục vụ chủ đề nghiên cứu khoa học tuần 25, bổ sung sách tham khảo ôn thi THPT Quốc gia..." FontSize="10.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Arrow 2 -->
                        <TextBlock Text="↓" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,-4,0,8"/>

                        <!-- Step 3: Gửi đề xuất -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Background="{DynamicResource HoverBackgroundBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource SuccessTextBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="P3" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bước 3: Xác nhận và gửi phê duyệt" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>

                                <Button Command="{Binding SubmitProposalCommand}" Content="📤 Gửi đề xuất danh mục" Height="38" Style="{StaticResource SuccessButton}" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Thông báo trạng thái -->
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cột phải: Lịch sử đề xuất -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lịch Sử Đề Xuất Của Bạn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding MyProposals}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại đề xuất" Binding="{Binding Type}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="Tên đề xuất" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Reason}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ngày gửi" Binding="{Binding SubmittedDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="1.5*"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#20F59E0B"/> <!-- 12% Orange (Pending) -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Đã duyệt">
                                                            <Setter Property="Background" Value="#2010B981"/> <!-- 12% Emerald -->
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Từ chối">
                                                            <Setter Property="Background" Value="#20EF4444"/> <!-- 12% Red -->
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Đã duyệt">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Từ chối">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
