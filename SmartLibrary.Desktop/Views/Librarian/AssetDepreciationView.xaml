<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.AssetDepreciationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="UserControl_Loaded" KeyDown="UserControl_KeyDown" Focusable="True">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="📉 Tính hao mòn tài sản cố định (TT 23/2023/TT-BTC)" ActionButtonText=""/>

        <shared:InstructionControl Grid.Row="1" Margin="24,24,24,0" Title="📖 Hướng dẫn quy trình tính hao mòn tài sản sách in (Thông tư 162)">
            <shared:InstructionControl.InnerContent>
                <StackPanel Margin="4,0">
                    <TextBlock Text="● Bước 1: Chọn năm báo cáo tính hao mòn tài sản cố định từ hộp chọn." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    <TextBlock Text="● Bước 2: Nhấn nút ⚡ Tính hao mòn để chạy thuật toán phân tích khấu hao lũy kế tự động." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    <TextBlock Text="● Bước 3: Xem tổng quan nguyên giá và giá trị còn lại (khống chế tối thiểu 10.000 VNĐ danh nghĩa)." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    <TextBlock Text="● Bước 4: Nhấp nút 📥 Xuất biểu mẫu Excel để tải báo cáo tài sản gửi lên Phòng/Sở Giáo dục đối soát." FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,2"/>
                </StackPanel>
            </shared:InstructionControl.InnerContent>
        </shared:InstructionControl>

        <Grid Grid.Row="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bộ điều khiển cấu hình -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16" Background="{DynamicResource CardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                     <TextBlock Grid.Column="0" Text="Năm tính khấu hao: " Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="ComboYear" Grid.Column="1" ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Style="{StaticResource ModernComboBox}" VerticalAlignment="Center" TabIndex="1" ToolTip="Nhấn Alt+Y để chọn năm" IsEnabled="{Binding IsNotBusy}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="24,0,0,0">
                        <Button Content="⚡ Tính hao mòn" Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryButton}" Width="140" Height="36" Cursor="Hand" Margin="0,0,12,0" TabIndex="2" IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="📥 Xuất biểu mẫu Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource SuccessButton}" Width="180" Height="36" Cursor="Hand" TabIndex="3" IsEnabled="{Binding IsNotBusy}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Busy Overlay -->
            <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource PopupOverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Panel.ZIndex="1000">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="4" Width="200" Margin="0,0,0,16" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource SuccessTextBrush}"/>
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Đang tính toán hao mòn tài sản...'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Thẻ thống kê tổng hợp (KPI Cards) -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nguyên giá sách in -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <TextBlock Text="Tổng nguyên giá tài sản sách in" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding TotalOriginalValue, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text=" VNĐ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Giá trị hao mòn còn lại -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <TextBlock Text="Giá trị còn lại sau hao mòn lũy kế" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding TotalRemainingValue, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text=" VNĐ" Foreground="{DynamicResource SuccessTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bảng dữ liệu chi tiết khấu hao -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" Background="{DynamicResource CardBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Chi tiết khấu hao sách in (Thời gian sử dụng hữu ích: 5 năm, Hao mòn: 20%/năm)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding DepreciationResults}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã sách (ISBN)" Binding="{Binding Isbn}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tên đầu sách" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Ngày mua" Binding="{Binding FormattedPurchaseDate}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nguyên giá" Binding="{Binding OriginalValueText}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Hao mòn lũy kế (%)" Binding="{Binding AccumulatedDepreciationPercentText}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Giá trị hao mòn" Binding="{Binding AccumulatedDepreciationValueText}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Giá trị còn lại" Binding="{Binding RemainingValueText}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
