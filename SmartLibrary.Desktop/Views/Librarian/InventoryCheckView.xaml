<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.InventoryCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Unloaded="UserControl_Unloaded"
             Loaded="UserControl_Loaded" KeyDown="UserControl_KeyDown" Focusable="True">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Border Viền Cảnh Báo Nhấp Nháy khi sách sai kệ -->
        <Border BorderBrush="#EF4444" BorderThickness="0" CornerRadius="0" Panel.ZIndex="99" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAlertFlashing}" Value="True">
                            <Setter Property="BorderThickness" Value="6"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="FlashStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        From="#EF4444" To="Transparent" Duration="0:0:0.5" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FlashStoryboard"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <shared:TopBarControl Title="📊 Kiểm kho thông minh (RFID)" />

        <shared:InstructionControl Grid.Row="1" Margin="24,24,24,0" Title="📖 Hướng dẫn quy trình kiểm kho thông minh (RFID)">
            <shared:InstructionControl.InnerContent>
                <StackPanel Margin="4,0">
                    <TextBlock Text="● Bước 1: Chọn tên kệ sách mục tiêu cần kiểm kê từ danh sách ComboBox." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    <TextBlock Text="● Bước 2: Nhấp chọn nút khởi động quét RFID liên tục để bắt đầu quét sóng không dây." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    <TextBlock Text="● Bước 3: Đưa thiết bị đọc dọc theo gáy sách. Nếu phát hiện viền đỏ nhấp nháy, hãy kiểm tra sách lệch kệ." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    <TextBlock Text="● Bước 4: Bấm 📊 Xuất báo cáo chênh lệch để trích xuất file thống kê Excel đối soát kho tài sản." FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,2"/>
                </StackPanel>
            </shared:InstructionControl.InnerContent>
        </shared:InstructionControl>

        <Grid Grid.Row="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Actions & Status -->
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{Binding IsScanning, Converter={StaticResource ScanningTextConverter}}" 
                                Command="{Binding ToggleScanCommand}" 
                                Padding="24,12" FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button Grid.Column="1" Command="{Binding ClearSessionCommand}" Style="{StaticResource WarningButton}" Content="🗑️ Làm mới và xóa phiên" Margin="16,0,0,0" Padding="16,12" FontSize="14"/>

                        <Button Grid.Column="2" Command="{Binding ExportVarianceReportCommand}" Content="📊 Xuất báo cáo chênh lệch" Margin="16,0,0,0" Padding="16,12" FontSize="14" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Cần quét UHF RFID tầm xa -->
                        <Button Grid.Column="3" Command="{Binding StartWandScanCommand}" Style="{StaticResource WarningButton}" Content="📡 Quét UHF tầm xa" Margin="16,0,0,0" Padding="16,12" FontSize="14" Cursor="Hand"/>

                        <!-- Toggles cho Âm thanh & TTS -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <CheckBox IsChecked="{Binding EnableBeeps}" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,12,0"/>
                            <TextBlock Text="🔊 Âm thanh" FontSize="13" VerticalAlignment="Center" Margin="-6,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            
                            <CheckBox IsChecked="{Binding EnableTts}" VerticalAlignment="Center" Cursor="Hand"/>
                            <TextBlock Text="🗣️ Giọng nói" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Bộ chọn tọa độ kệ mục tiêu -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Kệ mục tiêu X:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtTargetGridX" Width="70" Margin="0,4,0,0" Text="{Binding TargetGridX, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" TextAlignment="Center" ToolTip="Nhấn Alt+X để nhập nhanh kệ mục tiêu" MaxLength="3"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tầng mục tiêu Y:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtTargetGridY" Width="70" Margin="0,4,0,0" Text="{Binding TargetGridY, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" TextAlignment="Center" ToolTip="Nhấn Alt+Y để nhập nhanh tầng mục tiêu" MaxLength="3"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="24,0" HorizontalAlignment="Right">
                            <TextBlock Text="Trạng thái máy quét:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusState}" Value="Primary">
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusState}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusState}" Value="Danger">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusState}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Thanh tiến độ khi quét UHF RFID tầm xa -->
                    <ProgressBar Height="4" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource WarningTextBrush}" 
                                 Minimum="0" Maximum="100" Value="{Binding WandProgressValue}"
                                 Visibility="{Binding IsWandScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Warning Banner for Misplaced Book -->
            <Border Grid.Row="1" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningTextBrush}" BorderThickness="4,0,0,0" Padding="16,12" Margin="0,0,0,24" CornerRadius="4"
                    Visibility="{Binding HasMisplacedBook, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MisplacedBookMessage}" Foreground="{DynamicResource WarningTextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Đã hiểu ✕" Command="{Binding ClearMisplacedCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <shared:StatCardControl Grid.Column="0" Icon="📚" Label="Tổng sách hệ thống" Value="{Binding TotalSystemBooks}" ChangeText="Dữ liệu từ Database"/>
                <shared:StatCardControl Grid.Column="2" Icon="📡" Label="Sách đã quét" Value="{Binding TotalScannedBooks}" ChangeText="Đang quét..."/>
                <shared:StatCardControl Grid.Column="4" Icon="⚠️" Label="Sách thất lạc (chưa quét)" Value="{Binding MissingBooks}" ChangeText="Cần kiểm tra lại kệ"/>
            </Grid>

            <!-- Data Lists -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Scanned Tags -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🟢 Sách đã tìm thấy" Style="{StaticResource CardTitleText}" Foreground="{DynamicResource SuccessTextBrush}"/>
                        <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding ScannedTags}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMisplaced}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã RFID" Binding="{Binding Barcode}" Width="120"/>
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Trạng thái kệ" Binding="{Binding PlacementFeedback}" Width="250">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMisplaced}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMisplaced}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Missing Tags -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🔴 Sách thất lạc (Cần tìm)" Style="{StaticResource CardTitleText}" Foreground="{DynamicResource DangerTextBrush}"/>
                        <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding MissingTags}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã RFID" Binding="{Binding Barcode}" Width="150"/>
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Vị trí quy định" Binding="{Binding Location}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Busy Overlay Panel for Excel Export -->
        <Border Grid.RowSpan="3" Background="{DynamicResource PopupOverlayBrush}" Panel.ZIndex="1000"
                Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="32" Width="400" Height="200"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📊 ĐANG XUẤT BÁO CÁO EXCEL..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar Height="15" Minimum="0" Maximum="100" Value="{Binding ExportProgressValue}" Width="300" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="{Binding ExportProgressValue, StringFormat='{}Tiến độ: {0}%'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
