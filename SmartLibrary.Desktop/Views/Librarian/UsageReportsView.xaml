<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.UsageReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Loaded="UserControl_Loaded" KeyDown="UserControl_KeyDown" Focusable="True">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="📈 Báo cáo thống kê và hoạt động thư viện" ActionButtonText=""/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                
                <!-- Summary Stats Cards Row -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <shared:StatCardControl Grid.Column="0" Icon="📚" Label="Tổng đầu sách kho" Value="{Binding TotalBooks}" ChangeText="Đầu sách in và eBook"/>
                    <shared:StatCardControl Grid.Column="2" Icon="📖" Label="Sách đang mượn" Value="{Binding BorrowedBooks}" ChangeText="Phiên mượn đang kích hoạt"/>
                    <shared:StatCardControl Grid.Column="4" Icon="⏱️" Label="Sách đang quá hạn" Value="{Binding OverdueBooks}" ChangeText="Học sinh chưa hoàn trả"/>
                    <shared:StatCardControl Grid.Column="6" Icon="💰" Label="Phí hao mòn tài liệu tích lũy" Value="{Binding TotalRevenue, StringFormat='{}{0:N0} VNĐ'}" ChangeText="Phí mượn trễ và đền bù"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: 7-Day Borrow Trend -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Height="320">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="📊 Xu hướng mượn sách 7 ngày qua" Style="{StaticResource CardTitleText}"/>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding DailyBorrowCounts}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom" Margin="8,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Cột mượn (Emerald dynamic color) -->
                                            <Border Grid.Row="0" CornerRadius="4,4,0,0"
                                                    Height="{Binding BarHeight}" MaxHeight="150" VerticalAlignment="Bottom" Width="36"
                                                    Background="{DynamicResource SuccessTextBrush}">
                                                <Border.ToolTip>
                                                    <ToolTip Content="{Binding Count, StringFormat='Số lượng: {0} cuốn'}"/>
                                                </Border.ToolTip>
                                            </Border>

                                            <!-- Số lượng hiển thị phía trên/dưới -->
                                            <TextBlock Grid.Row="1" Text="{Binding Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                                            <!-- Nhãn Ngày -->
                                            <TextBlock Grid.Row="2" Text="{Binding DateLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Column 2: Export Reports Actions -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Height="320">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="🚀 Thao tác báo cáo" Style="{StaticResource CardTitleText}"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="Tạo và xuất báo cáo danh sách sách đang mượn hoạt động của thư viện ra file Excel định dạng .xlsx chuẩn." 
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                                <Button Content="📤 Xuất báo cáo mượn trả (Excel)" 
                                        Command="{Binding ExportReportCommand}"
                                        Style="{StaticResource PrimaryButton}" Height="45" FontSize="14" FontWeight="Bold"/>

                                <TextBlock Text="* Báo cáo tự động chèn chữ ký Hiệu trưởng và Kế toán trưởng dưới chân trang." 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ESG Green Carbon Reduction Metrics Section -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,24,0,0" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <TextBlock Text="🌱 Chỉ số bảo vệ môi trường thư viện số (ESG Metrics)" Style="{StaticResource CardTitleText}" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Thống kê đóng góp giảm thiểu carbon và tiết kiệm tài nguyên giấy nhờ chuyển đổi số tài liệu điện tử (Sách điện tử và sách nói)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ebook Read Card -->
                            <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📱" FontSize="28" Margin="0,0,0,8"/>
                                    <TextBlock Text="Ebook đã đọc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalEbooksRead, StringFormat='{}{0:N0} lượt'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Audiobook Heard Card -->
                            <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🎧" FontSize="28" Margin="0,0,0,8"/>
                                    <TextBlock Text="Audiobook đã nghe" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalAudiobooksHeard, StringFormat='{}{0:N0} lượt'}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Paper Saved Card -->
                            <Border Grid.Column="4" Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📄" FontSize="28" Margin="0,0,0,8"/>
                                    <TextBlock Text="Giấy tiết kiệm" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PaperSavedText}" Foreground="{DynamicResource WarningTextBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Trees Saved Card -->
                            <Border Grid.Column="6" Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🌳" FontSize="28" Margin="0,0,0,8"/>
                                    <TextBlock Text="Cây xanh bảo vệ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TreesSaved, StringFormat='{}{0:N3} cây'}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
