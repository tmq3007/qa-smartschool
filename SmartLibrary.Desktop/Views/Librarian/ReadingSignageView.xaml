<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.ReadingSignageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartLibrary.Desktop.Views.Librarian"
             xmlns:conv="clr-namespace:SmartLibrary.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="UserControl_Loaded" KeyDown="UserControl_KeyDown" Focusable="True"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <conv:IndexToColorConverter x:Key="IndexToColorConverter"/>
        
        <!-- Slide Visibility Style based on Index -->
        <Style x:Key="Slide0Style" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSlideIndex}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Slide1Style" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSlideIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Slide2Style" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSlideIndex}" Value="2">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndicatorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="12" Height="12" Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="20,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="🏫" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="TRƯỜNG HỌC THÔNG MINH QA SMART SCHOOL" Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="BẢNG VINH DANH ĐẠI SỨ VĂN HÓA ĐỌC" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="ExtraBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="☀️ / 🌙 Chế độ chiếu" Click="ToggleTheme_Click" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="0,0,12,0" Cursor="Hand" FontSize="11"/>
                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="TRÌNH CHIẾU" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Thư viện số 4.0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Slides Workspace -->
        <Grid Grid.Row="1" Margin="40">
            <!-- Slide 0: Top Students (Đại sứ văn hóa đọc) -->
            <Grid Style="{StaticResource Slide0Style}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                    <TextBlock Text="🏆" FontSize="96" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="ĐẠI SỨ TUẦN NÀY" Foreground="{DynamicResource WarningTextBrush}" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="Những gương mặt tích cực đọc sách nhiều nhất" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="24" Padding="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BẢNG XẾP HẠNG CÁ NHÂN TÍCH CỰC" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <ItemsControl ItemsSource="{Binding TopStudents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="RankIconBorder" Width="36" Height="36" Background="#F59E0B" CornerRadius="18" Margin="0,0,15,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="RankIconText" Text="⭐" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StudentName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ClassName, StringFormat='Lớp: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BooksCount}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text=" cuốn" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRank1}" Value="True">
                                            <Setter TargetName="RankIconBorder" Property="Background" Value="#EF4444"/>
                                            <Setter TargetName="RankIconText" Property="Text" Value="👑"/>
                                            <Setter TargetName="RankIconText" Property="FontSize" Value="20"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Slide 1: Top Classes (Lớp học sinh thái tích cực) -->
            <Grid Style="{StaticResource Slide1Style}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                    <TextBlock Text="🌱" FontSize="96" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="LỚP HỌC XUẤT SẮC" Foreground="{DynamicResource SuccessTextBrush}" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="Các tập thể lớp có phong trào tích lũy XP đọc sách sôi nổi" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="24" Padding="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BẢNG XẾP HẠNG TẬP THỂ LỚP XANH" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <ItemsControl ItemsSource="{Binding TopClasses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36" Background="{DynamicResource SuccessBrush}" CornerRadius="18" Margin="0,0,15,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🍀" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ClassName, StringFormat='Tập thể lớp {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Hạng học tập sinh thái" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BooksCount}" Foreground="{DynamicResource PrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text=" lượt đọc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Slide 2: Inspiring Quote (Danh ngôn truyền cảm hứng) -->
            <Grid Style="{StaticResource Slide2Style}">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="32" Padding="60" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
                    <StackPanel>
                        <TextBlock Text="“" Foreground="{DynamicResource WarningTextBrush}" FontSize="100" FontFamily="Georgia" Height="60" Margin="0,-40,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding CurrentQuote}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="SemiBold" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" LineHeight="42"/>
                        <TextBlock Text="{Binding CurrentQuoteAuthor, StringFormat='— {0}'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,30,40,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer slide indicators -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" Padding="0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding ChangeSlideCommand}" CommandParameter="0" Style="{StaticResource IndicatorButtonStyle}">
                    <Button.Content>
                        <Binding Path="CurrentSlideIndex" Converter="{StaticResource IndexToColorConverter}" ConverterParameter="0"/>
                    </Button.Content>
                </Button>
                <Button Command="{Binding ChangeSlideCommand}" CommandParameter="1" Style="{StaticResource IndicatorButtonStyle}">
                    <Button.Content>
                        <Binding Path="CurrentSlideIndex" Converter="{StaticResource IndexToColorConverter}" ConverterParameter="1"/>
                    </Button.Content>
                </Button>
                <Button Command="{Binding ChangeSlideCommand}" CommandParameter="2" Style="{StaticResource IndicatorButtonStyle}">
                    <Button.Content>
                        <Binding Path="CurrentSlideIndex" Converter="{StaticResource IndexToColorConverter}" ConverterParameter="2"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
