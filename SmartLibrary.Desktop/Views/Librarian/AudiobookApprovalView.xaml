<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.AudiobookApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="UserControl_Loaded" KeyDown="UserControl_KeyDown" Focusable="True">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="🎙️ Phê duyệt tệp sách nói đóng góp của học sinh" />

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Công cụ điều khiển và refresh -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Danh sách các tệp ghi âm sách nói đóng góp từ cộng đồng học sinh đang chờ phê duyệt. Vui lòng nghe thử trước khi duyệt." 
                               VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- TextBox Tìm kiếm nhanh với Placeholder chìm -->
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="36" VerticalContentAlignment="Center" Padding="8,0,28,0" TabIndex="1"
                                 ToolTip="Nhấn Ctrl+F để tìm kiếm nhanh (Giới hạn 100 ký tự)" MaxLength="100"/>
                        <TextBlock Text="🔍 Nhập tên học sinh, tác phẩm..." IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="3" Content="🔄 Làm mới" Command="{Binding LoadPendingAudiobooksCommand}" 
                            Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Cursor="Hand" TabIndex="2"/>
                </Grid>
            </Border>

            <!-- Bảng Danh sách chờ duyệt -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding PendingAudiobooks}" AutoGenerateColumns="False" IsReadOnly="True"
                              Visibility="{Binding IsListEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Người đóng góp" Binding="{Binding ContributorName}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding ContributorName}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tác phẩm" Binding="{Binding BookTitle}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding BookTitle}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ngày đóng góp" Binding="{Binding FormattedDate}" Width="150"/>
                            <DataGridTemplateColumn Header="Đường dẫn âm thanh" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AudioFilePath, Converter={StaticResource FileNameExtractConverter}}" 
                                                   ToolTip="{Binding AudioFilePath}" 
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Cột Nghe thử -->
                            <DataGridTemplateColumn Header="Nghe thử" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▶️ Nghe thử" Command="{Binding DataContext.PlayAudiobookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Height="26" Padding="8,0" Margin="0,0,8,0" Cursor="Hand"/>
                                            <Button Content="⏹️ Dừng" Command="{Binding DataContext.StopAudiobookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SecondaryButton}" Height="26" Padding="8,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Hành động -->
                            <DataGridTemplateColumn Header="Hành động" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✔️ Duyệt" Command="{Binding DataContext.ApproveAudiobookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SuccessButton}" Height="26" Padding="10,0" Margin="0,0,8,0" Cursor="Hand"/>
                                            <Button Content="❌ Từ chối" Command="{Binding DataContext.RejectAudiobookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="26" Padding="10,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Hiển thị khi trống -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding IsListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="✨ Tuyệt vời! Không có tệp đóng góp sách nói nào đang chờ phê duyệt. ✨" 
                                   FontSize="16" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
