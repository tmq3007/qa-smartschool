<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.ShelfHeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             xmlns:local="clr-namespace:SmartLibrary.Desktop.Views.Librarian"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="UserControl_Loaded" KeyDown="UserControl_KeyDown" Focusable="True">
    <UserControl.Resources>
        <local:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrushConverter"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="🗺️ Sơ đồ nhiệt kệ sách (Shelf Heatmap)" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                
                <!-- Mô tả & Bộ lọc -->
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20" Background="{DynamicResource CardBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Chọn kệ sách để trực quan hóa mật độ sách và tần suất mượn trả" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Di chuột vào mỗi ngăn kệ để xem chi tiết danh sách đầu sách đang nằm tại vị trí đó." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Kệ cần xem:" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ComboShelf" ItemsSource="{Binding AvailableShelves}" SelectedItem="{Binding SelectedShelf}" Width="150" Height="36" VerticalContentAlignment="Center" FontSize="13" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Nhấn Alt+K để chọn nhanh kệ sách"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lưới trực quan kệ sách & Chú thích -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column: Visual Grid (4x4) -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="24" Background="{DynamicResource CardBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedShelf, StringFormat='Sơ đồ lưới phân bổ của {0}'}" Style="{StaticResource CardTitleText}" Margin="0,0,0,20"/>
                            
                            <ItemsControl ItemsSource="{Binding ShelfCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" Rows="4" FirstColumn="0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6" CornerRadius="8" Padding="12" Height="100" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding HeatColor, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ToolTip>
                                                <ToolTip Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="12" BorderThickness="1" HasDropShadow="True">
                                                    <StackPanel Width="280">
                                                        <TextBlock Text="{Binding LocationName, StringFormat='Ngăn kệ: {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding HeatLevelText, StringFormat='Trạng thái: {0}'}" Foreground="{DynamicResource SelectedTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding BookCount, StringFormat='Số lượng sách: {0} cuốn'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                                        <TextBlock Text="{Binding TotalBorrows, StringFormat='Tổng lượt mượn: {0} lượt'}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>
                                                        <TextBlock Text="Các sách tại đây:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding BooksSummary}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding LocationName}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding BookCount, StringFormat='{}{0} cuốn'}" Foreground="#E2E8F0" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <TextBlock Text="🔥" FontSize="14" Margin="0,0,4,0" Visibility="{Binding TotalBorrows, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding TotalBorrows}" Foreground="#34D399" FontWeight="Bold" FontSize="14"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Right column: Legend and Actions -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorder}" Padding="20" Background="{DynamicResource CardBrush}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🎨 Chú giải mức nhiệt" Style="{StaticResource CardTitleText}" Margin="0,0,0,16"/>
                                
                                <!-- Red -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="24" Background="{DynamicResource HeatmapVeryHotBrush}" CornerRadius="4"/>
                                    <TextBlock Grid.Column="2" Text="Rất nóng (> 20 lượt mượn)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Amber -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="24" Background="{DynamicResource HeatmapWarmBrush}" CornerRadius="4"/>
                                    <TextBlock Grid.Column="2" Text="Ấm (12 - 20 lượt mượn)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Green -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="24" Background="{DynamicResource HeatmapCoolBrush}" CornerRadius="4"/>
                                    <TextBlock Grid.Column="2" Text="Mát (5 - 11 lượt mượn)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Blue -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="24" Background="{DynamicResource HeatmapColdBrush}" CornerRadius="4"/>
                                    <TextBlock Grid.Column="2" Text="Lạnh (1 - 4 lượt mượn)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Slate -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="24" Background="{DynamicResource HeatmapEmptyBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <TextBlock Grid.Column="2" Text="Ngăn trống (0 lượt mượn)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Padding="20" Background="{DynamicResource CardBrush}">
                            <StackPanel>
                                <TextBlock Text="💡 Phân tích và đề xuất" Style="{StaticResource CardTitleText}" Margin="0,0,0,12"/>
                                <TextBlock Text="Hệ thống tự động phát hiện các ngăn kệ 'quá tải' hoặc quá nóng để thủ thư thực hiện tái bố trí sách, dàn trải lượt mượn hợp lý." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                <Button Content="⚡ Tối ưu hóa phân bổ kệ sách" Command="{Binding OptimizeDistributionCommand}" Margin="0,16,0,0" Style="{StaticResource PrimaryButton}" Height="38"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
