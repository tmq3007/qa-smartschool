<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.LibrarianDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="📊 Báo cáo và thống kê thư viện" ActionButtonText="📤 Xuất báo cáo" OnActionClick="TopBarControl_OnActionClick"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                
                <!-- Loading & Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,0,0,16"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,0,0,16"/>

                <!-- Filter Section -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Thống kê hoạt động thư viện" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Bộ lọc thời gian: " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="150" SelectedItem="{Binding SelectedTimeRange}" ItemsSource="{Binding AvailableTimeRanges}" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Stats Grid -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <shared:StatCardControl Grid.Column="0" Icon="📚" Label="Tổng sách kho" Value="{Binding TotalBooks}" ChangeText="↑ 234 sách mới"
                                            ClickCommand="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" ClickCommandParameter="📚 Danh mục sách"/>
                    <shared:StatCardControl Grid.Column="2" Icon="📖" Label="Sách đang mượn" Value="{Binding BorrowedBooks}" ChangeText="↓ 3% so với tuần trước" ChangeBrush="{DynamicResource WarningTextBrush}"
                                            ClickCommand="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" ClickCommandParameter="📖 Mượn trả"/>
                    <shared:StatCardControl Grid.Column="4" Icon="⏱️" Label="Sách dự trữ" Value="{Binding ReservedBooks}" ChangeText="↑ 15 dự trữ mới"
                                            ClickCommand="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" ClickCommandParameter="⏱️ Dự trữ"/>
                    <shared:StatCardControl Grid.Column="6" Icon="💰" Label="Phí hao mòn tài liệu" Value="{Binding UnpaidFines}" ChangeText="↓ 50 thanh toán mới"
                                            ClickCommand="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" ClickCommandParameter="💰 Phí hao mòn tài liệu"/>
                </Grid>

                <!-- Alert Banner -->
                <Border Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningTextBrush}" BorderThickness="4,0,0,0" Padding="12" Margin="0,0,0,24" CornerRadius="4"
                        Visibility="{Binding HasOverdueBooks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding OverdueAlertMessage}" Foreground="{DynamicResource WarningTextBrush}" FontSize="13"/>
                </Border>

                <!-- Quick Actions Panel -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🚀 Thao tác nhanh" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📖 Mượn/trả nhanh" Command="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="📖 Mượn trả" Style="{StaticResource PrimaryButton}" Padding="24,14" Margin="0,0,16,0" FontSize="16" FontWeight="Bold"/>
                            <Button Content="📥 Thêm sách mới" Command="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="📥 Nhập kho" Style="{StaticResource SecondaryButton}" Padding="24,14" Margin="0,0,16,0" FontSize="16" FontWeight="Bold"/>
                            <Button Content="🖥️ Mở máy Kiosk" Command="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="🖥️ Kiosk (Tự phục vụ)" Style="{StaticResource SecondaryButton}" Padding="24,14" Margin="0,0,16,0" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Row of Charts and Checklist -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Book Borrow Stats (Bar Chart) -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Height="300">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="📊 Thống kê mượn sách theo thể loại" Style="{StaticResource CardTitleText}"/>
                            
                            <!-- Content Area -->
                            <Grid Grid.Row="1">
                                <!-- Simple WPF Bar Chart using ItemsControl -->
                                <ItemsControl ItemsSource="{Binding BorrowStats}" Margin="0,16,0,0"
                                              Visibility="{Binding IsBorrowStatsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Bottom" Margin="4,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Hai cột cạnh nhau -->
                                                <Grid Grid.Row="0" Height="160" VerticalAlignment="Bottom">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Cột năm nay (Emerald) -->
                                                    <Border Grid.Column="0" Background="{DynamicResource SuccessTextBrush}" CornerRadius="4,4,0,0"
                                                            Height="{Binding HeightPercentage}" MaxHeight="160" VerticalAlignment="Bottom">
                                                        <Border.ToolTip>
                                                            <ToolTip Content="{Binding Count, StringFormat='2026: {0} cuốn'}"/>
                                                        </Border.ToolTip>
                                                    </Border>
                                                    
                                                    <!-- Cột năm trước (Slate nhạt) -->
                                                    <Border Grid.Column="2" Background="{DynamicResource TextSecondaryBrush}" CornerRadius="4,4,0,0"
                                                            Height="{Binding PrevYearHeightPercentage}" MaxHeight="160" VerticalAlignment="Bottom">
                                                        <Border.ToolTip>
                                                            <ToolTip Content="{Binding PrevYearCount, StringFormat='2025: {0} cuốn'}"/>
                                                        </Border.ToolTip>
                                                    </Border>
                                                </Grid>
                                                
                                                <!-- Giá trị số lượng hiển thị -->
                                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Count}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PrevYearCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Label thể loại -->
                                                <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State when there is no data -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                            Visibility="{Binding IsBorrowStatsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="📊" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                                    <TextBlock Text="Chưa có dữ liệu thống kê mượn sách" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                             <!-- Legend phía dưới -->
                             <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                                  <Border Width="14" Height="14" Background="{DynamicResource SuccessTextBrush}" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                  <TextBlock Text="2026" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                  <Border Width="14" Height="14" Background="{DynamicResource TextSecondaryBrush}" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                  <TextBlock Text="2025" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                             </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Daily Tasks (Checklist) -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Height="300">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="📋 Nhiệm vụ thủ thư" Style="{StaticResource CardTitleText}"/>
                            
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsTasksEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding LibrarianTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <CheckBox IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        
                                                        <TextBlock Grid.Column="1" Text="{Binding TaskName}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                            Visibility="{Binding IsTasksEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                                    <TextBlock Text="Không có nhiệm vụ nào được giao hôm nay" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Two Column Layout -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Overdue Items -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="⚠️ Sách quá hạn" Style="{StaticResource CardTitleText}"/>
                            <Grid Margin="0,8,0,0">
                                <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding OverdueLoans}"
                                          Visibility="{Binding IsOverdueLoansEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Người mượn" Binding="{Binding StudentName}" Width="*"/>
                                        <DataGridTextColumn Header="Sách" Binding="{Binding BookTitle}" Width="*"/>
                                        <DataGridTemplateColumn Header="Quá hạn" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <shared:StatusBadgeControl Text="{Binding OverdueText}" BadgeType="Danger"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Hành động" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✉️ Nhắc nhở" 
                                                            Command="{Binding DataContext.SendReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Cursor="Hand"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                                            Visibility="{Binding IsOverdueLoansEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="⚠️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                                    <TextBlock Text="Không có sách nào quá hạn" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Activity Stream -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="⚡ Luồng hoạt động (Live)" Style="{StaticResource CardTitleText}"/>
                            <Grid Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding ActivityLogs}"
                                              Visibility="{Binding IsActivityLogsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Timeline Dot & Line -->
                                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource SuccessTextBrush}" VerticalAlignment="Top" Margin="0,4,0,0" Panel.ZIndex="2"/>
                                                <!-- Fake vertical line -->
                                                <Rectangle Grid.Column="0" Width="2" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center" Margin="0,14,0,-16" Panel.ZIndex="1"/>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                
                                                <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="12,8">
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                                            Visibility="{Binding IsActivityLogsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="⚡" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                                    <TextBlock Text="Không có hoạt động nào hôm nay" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
