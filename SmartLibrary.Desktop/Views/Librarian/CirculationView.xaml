<UserControl x:Class="SmartLibrary.Desktop.Views.Librarian.CirculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
             KeyDown="UserControl_KeyDown">
     <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveLoanCommand}"/>
        <KeyBinding Key="Esc" Command="{Binding SwitchModeCommand}" CommandParameter="Borrow"/>
        <KeyBinding Key="M" Modifiers="Alt" Command="{Binding SwitchModeCommand}" CommandParameter="Borrow"/>
        <KeyBinding Key="T" Modifiers="Alt" Command="{Binding SwitchModeCommand}" CommandParameter="Return"/>
     </UserControl.InputBindings>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="📖 Quản lý Lưu thông (Mượn/Trả)" />

        <!-- Status & Mode Switcher -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mode Tabs -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="📤 Mượn sách" Command="{Binding SwitchModeCommand}" CommandParameter="Borrow" 
                            Margin="0,0,8,0" 
                            ToolTip="Nhấn Alt+M để chuyển nhanh sang chế độ Mượn">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/> 
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsBorrowMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Content="📥 Trả sách" Command="{Binding SwitchModeCommand}" CommandParameter="Return" 
                            ToolTip="Nhấn Alt+T để chuyển nhanh sang chế độ Trả">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/> 
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsBorrowMode}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Hidden Input for Barcode (Fallback if needed, but we use Global Hook) -->
                <TextBox x:Name="HiddenBarcodeTextBox" Grid.Column="1" Width="0" Height="0" Opacity="0" IsTabStop="False"/>

                <!-- Status Banner -->
                <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Padding="16,8">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Primary">
                                        <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Success">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Danger">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <shared:InstructionControl Grid.Row="2" Margin="24,24,24,0" Title="📖 Hướng dẫn quy trình mượn/trả sách">
            <shared:InstructionControl.InnerContent>
                <Grid>
                    <!-- Hướng dẫn cho chế độ Mượn sách -->
                    <StackPanel Margin="4,0" Visibility="{Binding IsBorrowMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="● Bước 1: Quét thẻ RFID/mã QR của bạn đọc để nạp hồ sơ độc giả lên màn hình." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Text="● Bước 2: Quét mã vạch (Barcode) hoặc RFID của sách để đưa vào danh sách mượn tạm thời." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Text="● Bước 3: Xem xét thông điệp nhắc nhở màu đỏ (nếu bạn đọc bị tạm ngưng mượn hoặc còn phí hao mòn quá hạn)." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Text="● Bước 4: Nhấn nút 💾 Hoàn tất (Lưu lại) để ghi nhận vào cơ sở dữ liệu hệ thống." FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,2"/>
                        <TextBlock Text="● Chú ý: Hãy chuyển UniKey/EVKey sang chế độ tiếng Anh (E) khi quét mã vạch sách." FontStyle="Italic" Foreground="{DynamicResource WarningTextBrush}" Margin="0,4,0,2"/>
                    </StackPanel>

                    <!-- Hướng dẫn cho chế độ Trả sách -->
                    <StackPanel Margin="4,0" Visibility="{Binding IsBorrowMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="● Bước 1: Chọn tình trạng sách khi hoàn trả ở cột bên trái (Mặc định: Tốt / Bình thường)." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Text="● Bước 2: Quét mã vạch (Barcode) hoặc RFID của sách để thực hiện trả sách ngay lập tức." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Text="● Bước 3: Hệ thống sẽ tự động đối chiếu, cập nhật tình trạng kho và ghi nhận nhật ký trả sách thành công." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Text="● Bước 4: Bạn có thể xem lịch sử các cuốn sách đã trả thành công trong phiên hiện tại ở bảng bên phải." FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,2"/>
                        <TextBlock Text="● Chú ý: Hãy chuyển UniKey/EVKey sang chế độ tiếng Anh (E) khi quét mã vạch sách." FontStyle="Italic" Foreground="{DynamicResource WarningTextBrush}" Margin="0,4,0,2"/>
                    </StackPanel>
                </Grid>
            </shared:InstructionControl.InnerContent>
        </shared:InstructionControl>

        <Grid Grid.Row="3" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: User Info & Instructions -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,24" Visibility="{Binding IsBorrowMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="👤 Thông tin bạn đọc" Style="{StaticResource CardTitleText}"/>
                        
                        <Border Background="{DynamicResource BackgroundBrush}" Padding="16" CornerRadius="4" MinHeight="100">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsBatchMode}" Margin="0,0,0,12" VerticalContentAlignment="Center">
                                    <TextBlock Text="Mượn theo tập thể lớp (Batch Mode)" TextWrapping="Wrap" FontWeight="Bold" Foreground="{DynamicResource SelectedTextBrush}" FontSize="13"/>
                                </CheckBox>
                                
                                <!-- Mục đích mượn lô (Chỉ hiện khi IsBatchMode = True) -->
                                <StackPanel Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                    <TextBlock Text="Mục đích mượn lô *" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding BatchPurposes}" SelectedItem="{Binding BatchPurpose}" Padding="8" FontSize="13"/>
                                </StackPanel>

                                <!-- Vùng thông tin bạn đọc -->
                                <Grid Margin="0,0,0,4">
                                    <!-- Empty state when Reader is NOT scanned -->
                                    <StackPanel x:Name="EmptyReaderStatePanel" Margin="0,4">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReaderId}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="👤 Chưa nhận diện độc giả" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Vui lòng quét thẻ RFID bạn đọc hoặc mã QR lớp để bắt đầu..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Opacity="0.7" LineHeight="16"/>
                                    </StackPanel>

                                    <!-- Reader profile detail card when Reader IS scanned -->
                                    <Grid x:Name="ReaderDetailCard" Margin="0,4">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReaderId}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        
                                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                            <StackPanel>
                                                <!-- Reader Header -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Border Width="36" Height="36" Background="{DynamicResource PrimaryBrush}" CornerRadius="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="👤" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                                    </Border>
                                                    
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ReaderName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ReaderClass}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" Height="1"/>
                                                
                                                <!-- Detailed fields -->
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Row 0: ID -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã định danh:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,8,2" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReaderId}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,2" FontWeight="SemiBold"/>

                                                    <!-- Row 1: Active Loans -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sách đang giữ:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,8,2" FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ReaderActiveLoansCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SelectedTextBrush}"/>
                                                        <TextBlock Text="/5 cuốn" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Row 2: Status -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Trạng thái:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,8,2" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReaderStatusText}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                                
                                <!-- Nhắc nhở quy chế lưu thông khi bị khóa -->
                                <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerHoverBgBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BlockReason}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="⚠️ Nhắc nhở lưu thông" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding BlockReason}" FontSize="11" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Khu vực thu phí phạt trực tiếp -->
                                <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerHoverBgBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0" 
                                        Visibility="{Binding HasFine, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Phí hao mòn quá hạn:" FontSize="11" Foreground="{DynamicResource DangerTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CurrentStudentFine, StringFormat='{}{0:N0} VNĐ'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="💸 Thu phí" Command="{Binding PayFineCommand}" Style="{StaticResource SuccessButton}" Padding="8,4" FontSize="11" Cursor="Hand" BorderThickness="0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                
                                <!-- Nút Báo Mất Sách Độc Giả -->
                                <Button Content="⚠️ Báo thất lạc sách" Command="{Binding ReportLostCommand}" Style="{StaticResource SecondaryButton}" 
                                        Foreground="{DynamicResource WarningTextBrush}" BorderBrush="{DynamicResource WarningTextBrush}" Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Stretch" FontSize="13" FontWeight="Bold" Cursor="Hand"
                                        Visibility="{Binding IsStudentScanned, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tình trạng sách khi trả -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,24" Visibility="{Binding IsBorrowMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="🔧 Tình trạng sách khi trả" Style="{StaticResource CardTitleText}"/>
                        <ComboBox ItemsSource="{Binding AvailableConditions}" SelectedItem="{Binding SelectedBookCondition}" Padding="12" FontSize="14" Margin="0,8,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource BookConditionToVietnameseConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Hướng dẫn" Style="{StaticResource CardTitleText}"/>
                        
                        <!-- Hướng dẫn cho chế độ Mượn sách -->
                        <StackPanel Visibility="{Binding IsBorrowMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="1. Dùng súng quét mã vạch quét thẻ Học Sinh/Giáo viên." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="2. Quét liên tiếp mã vạch trên các cuốn sách." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="3. Thông tin tự động thêm vào danh sách." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="4. Bấm Hoàn tất (Lưu lại) để lưu phiếu mượn." TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Hướng dẫn cho chế độ Trả sách -->
                        <StackPanel Visibility="{Binding IsBorrowMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="1. Chọn tình trạng sách khi hoàn trả ở ô bên trên." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="2. Quét mã vạch sách cần trả bằng súng quét hoặc nhập thủ công ở bên phải." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="3. Hệ thống sẽ trả sách ngay lập tức và ghi lịch sử." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="4. Xem lịch sử các cuốn sách đã trả thành công ở bảng bên cạnh." TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Pending Items -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Visibility="{Binding IsBorrowMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 Danh sách sách chờ mượn" Style="{StaticResource CardTitleText}"/>

                    <!-- Vùng nhập liệu thủ công dự phòng cho Mượn sách -->
                    <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Ô nhập mã bạn đọc -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="👤 Mã thẻ độc giả:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtManualReaderId" Style="{StaticResource ModernInputStyle}" Height="32" Padding="6,4" MaxLength="30" KeyDown="TxtManualReaderId_KeyDown"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Nhận diện" Click="BtnManualReaderId_Click" Style="{StaticResource SecondaryButton}" Height="32" VerticalAlignment="Bottom" Margin="0,0,12,0" Padding="8,0" Cursor="Hand"/>

                            <!-- Ô nhập mã sách -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="📖 Mã vạch / RFID sách:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtManualBookBarcode" Style="{StaticResource ModernInputStyle}" Height="32" Padding="6,4" MaxLength="50" KeyDown="TxtManualBookBarcode_KeyDown"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Thêm sách" Click="BtnManualBookBarcode_Click" Style="{StaticResource PrimaryButton}" Height="32" VerticalAlignment="Bottom" Padding="8,0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding PendingBooks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã vạch" Binding="{Binding Barcode}" Width="150"/>
                                <DataGridTemplateColumn Header="Tên sách" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌" Command="{Binding DataContext.RemoveBookCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource DangerTextBrush}" FontSize="20"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Chưa quét sách nào. Vui lòng quét mã barcode/RFID của sách..."
                                   Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.7" FontSize="13" FontStyle="Italic"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingBooks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="Giữ thông tin độc giả" IsChecked="{Binding KeepBorrowerProfile}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <CheckBox Content="In biên lai giấy" IsChecked="{Binding PrintReceipt}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <Button Content="🖨️ In lại biên lai" Command="{Binding RetryPrintReceiptCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"/>
                            <Button Content="🗑️ Xóa trống danh sách" Command="{Binding ClearPendingBooksCommand}" Style="{StaticResource DangerButton}" />
                            <Button Content="💾 Hoàn tất (Lưu lại)" Command="{Binding SaveLoanCommand}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Column: Returned Items (History) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Visibility="{Binding IsBorrowMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 Danh sách sách vừa trả thành công (Phiên hiện tại)" Style="{StaticResource CardTitleText}"/>

                    <!-- Vùng nhập liệu thủ công dự phòng cho Trả sách (chỉ nhập mã sách) -->
                    <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="📖 Mã vạch / RFID sách cần trả:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtManualReturnBarcode" Style="{StaticResource ModernInputStyle}" Height="32" Padding="6,4" MaxLength="50" KeyDown="TxtManualReturnBarcode_KeyDown"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Trả sách" Click="BtnManualReturnBarcode_Click" Style="{StaticResource PrimaryButton}" Height="32" VerticalAlignment="Bottom" Padding="16,0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding ReturnedBooks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding ReturnTime}" Width="100"/>
                                <DataGridTextColumn Header="Mã vạch" Binding="{Binding Barcode}" Width="150"/>
                                <DataGridTemplateColumn Header="Tên sách" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tình trạng" Binding="{Binding Condition}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="Hỏng nhẹ">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Thất lạc">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Tốt">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Chưa có sách nào được trả trong phiên này. Hãy quét sách..."
                                   Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.7" FontSize="13" FontStyle="Italic"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReturnedBooks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Error Flash Overlay -->
        <Border Background="{DynamicResource StateError}" BorderBrush="{DynamicResource DangerTextBrush}" BorderThickness="8" IsHitTestVisible="False" Panel.ZIndex="100">
            <Grid>
                <TextBlock Text="🛑" FontSize="200" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
            </Grid>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" AutoReverse="True" RepeatBehavior="3x" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

    </Grid>
</UserControl>
