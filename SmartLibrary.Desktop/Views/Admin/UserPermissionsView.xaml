<UserControl x:Class="SmartLibrary.Desktop.Views.Admin.UserPermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             xmlns:converters="clr-namespace:SmartLibrary.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="UserControl_Loaded" KeyDown="UserControl_KeyDown" Focusable="True">
    <UserControl.Resources>
        <converters:RoleToVietnameseConverter x:Key="RoleToVietnameseConverter"/>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="🛡️ Phân quyền Người Dùng Hệ Thống" />

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter Toolbar -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tìm kiếm theo Tên hoặc Mã định danh liên thông (SSO)..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtSearch" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phòng ban / Tổ bộ môn" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox SelectedItem="{Binding SelectedDepartment}" ItemsSource="{Binding Departments}" Height="36" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="💾 Lưu cấu hình phân quyền" 
                            Command="{Binding SavePermissionsCommand}" 
                            Style="{StaticResource SuccessButton}" 
                            Height="36" Padding="16,0" VerticalAlignment="Bottom" FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Grid Data -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8">
                <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã định danh liên thông (SSO)" Binding="{Binding SsoId}" Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="2*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tổ bộ môn / Phòng ban" Binding="{Binding Department}" Width="2*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Vai trò phân quyền" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" Margin="2" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource RoleToVietnameseConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer Message -->
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
