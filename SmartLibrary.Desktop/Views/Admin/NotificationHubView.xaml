<UserControl x:Class="SmartLibrary.Desktop.Views.Admin.NotificationHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             KeyDown="UserControl_KeyDown" Focusable="True">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="🔔 Cổng Zalo/SMS nhắc trả sách quá hạn" />

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Tool Area -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Gửi tin nhắn tự động nhắc trả sách quá hạn trực tiếp đến Zalo hoặc SMS của phụ huynh học sinh." 
                               VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    
                    <Button Grid.Column="1" Content="🔄 Làm mới danh sách" Command="{Binding LoadOverdueStudentsCommand}" 
                            Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Main Layout (DataGrid on Left, Logs on Right) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Overdue Students List -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding OverdueStudents}" AutoGenerateColumns="False" IsReadOnly="True"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  Visibility="{Binding IsListEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Học sinh" Binding="{Binding StudentName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Mã học sinh" Binding="{Binding StudentSsoId}" Width="100"/>
                                <DataGridTextColumn Header="SĐT Phụ huynh" Binding="{Binding MaskedPhone}" Width="130"/>
                                <DataGridTextColumn Header="Tựa sách quá hạn" Binding="{Binding BookTitle}" Width="2*"/>
                                <DataGridTextColumn Header="Số ngày trễ" Binding="{Binding OverdueDays}" Width="100"/>
                                <DataGridTextColumn Header="Phí hao mòn tài liệu (VNĐ)" Binding="{Binding FineAmount, StringFormat='{}{0:N0}'}" Width="120"/>
                                <DataGridTemplateColumn Header="Hành động" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✉️ Gửi nhắc" Command="{Binding DataContext.SendReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SuccessButton}" Height="26" Padding="8,0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding IsListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✨ Không có học sinh nào bị trễ hạn hoặc mất sách chưa xử lý! ✨" 
                                       FontSize="16" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: Notification Logs -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📋 Nhật ký gửi thông báo (Zalo/SMS)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <ListView Grid.Row="1" ItemsSource="{Binding NotificationLogs}" Background="{DynamicResource BackgroundBrush}" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
