<Window x:Class="SmartLibrary.Desktop.Views.Shared.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle, RelativeSource={RelativeSource Self}}" 
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{Binding PromptText, RelativeSource={RelativeSource Self}}" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBox x:Name="InputTextBox" Text="{Binding InputText, RelativeSource={RelativeSource Self}, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#475569" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Xác nhận" IsDefault="True" Click="OkButton_Click" Width="90" Height="32" Background="{DynamicResource StateSuccess}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Hủy" IsCancel="True" Click="CancelButton_Click" Width="80" Height="32" Background="#475569" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
