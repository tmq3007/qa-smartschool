<UserControl x:Class="SmartLibrary.Desktop.Views.Shared.ToastNotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="300"
             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
             Name="thisControl">
    <UserControl.Resources>
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="translateTransform" Storyboard.TargetProperty="Y"
                             From="-50" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="thisControl" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation Storyboard.TargetName="translateTransform" Storyboard.TargetProperty="X"
                             From="0" To="350" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="thisControl" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="translateTransform" X="0" Y="0"/>
    </UserControl.RenderTransform>

    <Border x:Name="ToastBorder" Background="{DynamicResource StateSuccess}" CornerRadius="8" Padding="16,12" MaxWidth="320">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="8" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText" Text="✅" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
            
            <TextBlock x:Name="MessageText" Grid.Column="1" Text="Thông báo thành công!" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
            
            <Button Grid.Column="2" Content="✕" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF" Cursor="Hand" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
