<Window x:Class="SmartLibrary.Desktop.Views.Shared.BookReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đánh giá sách" Width="400" Height="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <Style x:Key="StarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F59E0B"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="📝 Đánh giá và cảm nhận sách" Foreground="{DynamicResource StateSuccess}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtBookTitle" Text="Tên cuốn sách..." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>

            <!-- Chọn Sao Đánh Giá -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button x:Name="BtnStar1" Content="★" Style="{StaticResource StarButtonStyle}" Click="Star_Click" Tag="1"/>
                <Button x:Name="BtnStar2" Content="★" Style="{StaticResource StarButtonStyle}" Click="Star_Click" Tag="2"/>
                <Button x:Name="BtnStar3" Content="★" Style="{StaticResource StarButtonStyle}" Click="Star_Click" Tag="3"/>
                <Button x:Name="BtnStar4" Content="★" Style="{StaticResource StarButtonStyle}" Click="Star_Click" Tag="4"/>
                <Button x:Name="BtnStar5" Content="★" Style="{StaticResource StarButtonStyle}" Click="Star_Click" Tag="5"/>
            </StackPanel>

            <!-- TextBox cảm nhận -->
            <TextBlock Text="Nội dung cảm nhận (tối thiểu 10 ký tự):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtContent" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                     Style="{StaticResource ModernInputStyle}"/>
            
            <TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource StateError}" FontSize="12" Margin="0,4,0,0" Height="16"/>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Gửi đánh giá" Width="120" Height="36" Background="{DynamicResource StateSuccess}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Submit_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Hủy" Width="80" Height="36" Margin="12,0,0,0" Background="#475569" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
