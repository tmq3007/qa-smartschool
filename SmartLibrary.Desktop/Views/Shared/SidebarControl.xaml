<UserControl x:Class="SmartLibrary.Desktop.Views.Shared.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="280"
             Name="root">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="0,0,1,0" Width="280" Background="{StaticResource DarkNavySidebarBrush}">
        
        <Grid Margin="20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Logo -->
                <RowDefinition Height="Auto"/> <!-- User Profile Widget -->
                <RowDefinition Height="*"/>    <!-- Menu ScrollViewer -->
            </Grid.RowDefinitions>
            
            <!-- Logo -->
            <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📚" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Smart Library" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- User Profile Widget (Premium card) -->
            <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="6" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Circular avatar with gradient -->
                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0" VerticalAlignment="Center"
                            BorderBrush="{Binding DataContext.EquippedBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            BorderThickness="{Binding DataContext.EquippedBorderThickness, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Effect="{Binding DataContext.EquippedBorderEffect, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/> <!-- Blue-500 -->
                                <GradientStop Color="#10B981" Offset="1"/> <!-- Emerald-500 -->
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding DataContext.EquippedAvatar, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataContext.UserName, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                   FontWeight="Bold" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="{DynamicResource StateSuccess}" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RoleToVietnameseConverter}}" 
                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <!-- Badge hiển thị cấp độ (Chỉ hiện khi là Student) -->
                            <Border Background="{DynamicResource StateInfo}" CornerRadius="4" Padding="6,2" Margin="4,0,0,0"
                                    Visibility="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StudentRoleToVisibilityConverter}}">
                                <TextBlock Text="{Binding DataContext.CurrentLevel, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <!-- Thanh tiến trình XP (Chỉ hiện khi là Student) -->
                        <Grid Margin="0,6,0,0" Height="6" Width="140" HorizontalAlignment="Left"
                              Visibility="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StudentRoleToVisibilityConverter}}">
                            <Border Background="#334155" CornerRadius="3"/>
                            <ProgressBar Value="{Binding DataContext.CurrentXP, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Maximum="{Binding DataContext.MaxXP, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Foreground="{DynamicResource StateSuccess}" Background="Transparent" BorderThickness="0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Logout Button -->
                    <Button Grid.Column="2" Content="🚪" 
                            Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource StateError}" FontSize="18" 
                            Cursor="Hand" VerticalAlignment="Center" ToolTip="Đăng xuất khỏi hệ thống"/>
                </Grid>
            </Border>
            
            <!-- Menu ScrollViewer -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding DataContext.MenuItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTitle}" Value="True">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <DataTemplate.Resources>
                                                                <Style x:Key="CategoryHeaderToggleStyle" TargetType="ToggleButton">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Padding" Value="8,10,8,10"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                                                            <ColumnDefinition Width="*"/>    <!-- Text -->
                                                                                            <ColumnDefinition Width="Auto"/> <!-- Chevron -->
                                                                                        </Grid.ColumnDefinitions>
                                                                                        
                                                                                        <!-- Category Icon -->
                                                                                        <TextBlock Text="{Binding Icon}" FontSize="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding Icon, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                                                        
                                                                                        <!-- Category Text -->
                                                                                        <TextBlock x:Name="CategoryText" Grid.Column="1" Text="{Binding Text}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                                                        
                                                                                        <!-- Chevron Icon -->
                                                                                        <TextBlock x:Name="Chevron" Grid.Column="2" Text="▶" Foreground="#94A3B8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#0DFFFFFF"/>
                                                                                        <Setter TargetName="CategoryText" Property="Foreground" Value="#F8FAFC"/>
                                                                                        <Setter TargetName="Chevron" Property="Foreground" Value="#F8FAFC"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="Chevron" Property="Text" Value="▼"/>
                                                                                        <Setter TargetName="Chevron" Property="Foreground" Value="#F8FAFC"/>
                                                                                        <Setter TargetName="CategoryText" Property="Foreground" Value="#F8FAFC"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </DataTemplate.Resources>

                                                            <StackPanel Margin="0,4">
                                                                <!-- Subtle separator line -->
                                                                <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Margin="4,8,4,8"/>
                                                                
                                                                <!-- ToggleButton for Expand/Collapse -->
                                                                <ToggleButton Style="{StaticResource CategoryHeaderToggleStyle}" 
                                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
                                                                
                                                                <!-- Collapsible SubItems list -->
                                                                <ItemsControl ItemsSource="{Binding SubItems}" Margin="12,4,0,0"
                                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                             <Button Command="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Text}"
                                                                                     Padding="14,10" HorizontalContentAlignment="Left" FontSize="13" Foreground="#E2E8F0" 
                                                                                     BorderThickness="3,0,0,0" Background="Transparent" BorderBrush="Transparent" Margin="0,2">
                                                                                  <StackPanel Orientation="Horizontal">
                                                                                      <TextBlock Text="{Binding Text}" 
                                                                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                                 FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                                     <Border Background="{DynamicResource StateError}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" 
                                                                                             Visibility="{Binding BadgeText, Converter={StaticResource StringToVisibilityConverter}}">
                                                                                         <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                                     </Border>
                                                                                 </StackPanel>
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button">
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                                                    </Border>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                        <Style.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#0DFFFFFF"/>
                                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                            </Trigger>
                                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                                <Setter Property="Background" Value="#1E293B"/>
                                                                                                <Setter Property="BorderBrush" Value="#10B981"/> <!-- Emerald indicator -->
                                                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTitle}" Value="False">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                             <Button Command="{Binding DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Text}"
                                                                     Padding="14,10" HorizontalContentAlignment="Left" FontSize="13" Foreground="#E2E8F0" 
                                                                     BorderThickness="3,0,0,0" Background="Transparent" BorderBrush="Transparent" Margin="0,2">
                                                                 <StackPanel Orientation="Horizontal">
                                                                     <TextBlock Text="{Binding Text}" 
                                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                     <Border Background="{DynamicResource StateError}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" 
                                                                             Visibility="{Binding BadgeText, Converter={StaticResource StringToVisibilityConverter}}">
                                                                         <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                     </Border>
                                                                 </StackPanel>
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#0DFFFFFF"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Background" Value="#1E293B"/>
                                                                                <Setter Property="BorderBrush" Value="#10B981"/> <!-- Emerald indicator -->
                                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
