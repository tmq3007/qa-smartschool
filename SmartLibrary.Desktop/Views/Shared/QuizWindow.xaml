<Window x:Class="SmartLibrary.Desktop.Views.Shared.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trắc nghiệm đọc hiểu" Width="600" Height="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content (Questions) -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📝 TRẮC NGHIỆM ĐỌC HIỂU" Foreground="{DynamicResource PrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtBookTitle" Text="Tên cuốn sách đang kiểm tra" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Đồng hồ đếm ngược -->
                <Border Grid.Column="1" Background="{DynamicResource StateError}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱️ " Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTimer" Text="01:00" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- QUESTIONS SCROLL -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel x:Name="QuestionsPanel">
                    <!-- Các câu hỏi sẽ được sinh động bằng mã hoặc ItemsControl -->
                    <!-- Để lập trình viên dễ làm việc, chúng tôi sẽ sinh ra giao diện câu hỏi động từ code-behind -->
                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtWarning" Text="⚠️ Trả lời đúng tối thiểu 4/5 câu để nhận 20 XP" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Nộp Bài" Click="BtnSubmit_Click" Style="{StaticResource SuccessButton}" Width="100" Height="36" Cursor="Hand"/>
                    <Button Content="Hủy bỏ" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Width="80" Height="36" Margin="8,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
