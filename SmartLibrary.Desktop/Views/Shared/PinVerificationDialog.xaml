<Window x:Class="SmartLibrary.Desktop.Views.Shared.PinVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác minh danh tính" Width="360" Height="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeypadDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource KeypadButtonStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="🔒 Nhập mã PIN để xem thông tin" 
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            
            <PasswordBox x:Name="PinBox" MaxLength="4" FontSize="24" 
                         HorizontalAlignment="Center" Width="160"
                         HorizontalContentAlignment="Center"
                         PasswordChar="●" 
                         Background="#0F172A" Foreground="#F1F5F9"
                         BorderBrush="#475569" Padding="6"/>
            
            <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource StateError}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,4,0,4" Height="16"/>
            
            <!-- Bàn phím số Touch Keypad -->
            <UniformGrid Rows="4" Columns="3" Width="240" Height="220" Margin="0,8,0,16">
                <Button Content="1" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="2" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="3" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="4" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="5" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="6" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="7" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="8" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="9" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="C" Click="Keypad_Click" Style="{StaticResource KeypadDangerButtonStyle}"/>
                <Button Content="0" Click="Keypad_Click" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="⌫" Click="Keypad_Click" Style="{StaticResource KeypadDangerButtonStyle}"/>
            </UniformGrid>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Xác nhận" x:Name="BtnConfirm" Width="110" Height="36"
                        Background="{DynamicResource StateSuccess}" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="BtnConfirm_Click"/>
                <Button Content="Hủy" x:Name="BtnCancel" Width="80" Height="36"
                        Background="#475569" Foreground="White" Margin="12,0,0,0"
                        BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
