<UserControl x:Class="SmartLibrary.Desktop.Views.Shared.TopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="800"
             Name="root">
    <Border Background="{DynamicResource CardBrush}" Padding="24,16">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" Direction="270" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ElementName=root, Path=Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                <!-- Gamification -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StudentVisibilityConverter}, FallbackValue=Visible}">
                    <ProgressBar Minimum="0" Maximum="{Binding DataContext.MaxXP, RelativeSource={RelativeSource AncestorType=Window}}" Value="{Binding DataContext.CurrentXP, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 Width="120" Height="6" Foreground="{DynamicResource StateSuccess}" Background="#E5E7EB" BorderThickness="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DataContext.CurrentXP, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0} XP}" 
                               FontSize="11" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="4,2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding DataContext.CurrentLevel, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/>
                    </Border>
                    <Button Content="❓" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource StateSuccess}" Click="HelpButton_Click" ToolTip="Quy chế tích điểm XP"/>
                </StackPanel>
            </StackPanel>
                 <!-- Global Search OPAC -->
            <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,4" Margin="24,0" MaxWidth="500" HorizontalAlignment="Center" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="8,0,0,0" 
                             FontSize="14" Width="300" MaxLength="100"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Text="{Binding DataContext.SearchKeyword, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DataContext.GlobalSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Grid.Column="1" Text="Tìm kiếm nhanh sách, kệ, mã vạch... (Enter)" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Popup hiển thị kết quả tìm kiếm OPAC nhanh -->
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" 
                           IsOpen="{Binding DataContext.IsSearchPopupOpen, RelativeSource={RelativeSource AncestorType=Window}}" 
                           StaysOpen="False" PopupAnimation="Fade" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Width="420" Padding="16" Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="12" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="📚 Kết quả tìm kiếm nhanh" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                            Command="{Binding DataContext.CloseSearchPopupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                                
                                <TextBlock Text="Không tìm thấy sách nào phù hợp." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,8"
                                           Visibility="{Binding DataContext.IsNoResultsFound, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <ItemsControl ItemsSource="{Binding DataContext.GlobalSearchResults, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding ShelfLocation}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding AvailabilityText}" FontSize="11" Foreground="{Binding AvailabilityColor}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Nút mượn nhanh tại quầy -->
                                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="Mượn" VerticalAlignment="Center" Padding="8,4" FontSize="11" Background="#1F51BA" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.BorrowFromSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Barcode}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Window}}" Value="Student">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Theme Toggle Button -->
                <Button x:Name="BtnToggleTheme" Content="🌙" Click="BtnToggleTheme_Click"
                        Background="Transparent" BorderThickness="0" FontSize="18" Margin="0,0,16,0" Cursor="Hand" ToolTip="Bấm để chuyển đổi giao diện Sáng hoặc Tối"/>

                <!-- Hardware Status LEDs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="LedCamera" Width="8" Height="8" Fill="#10B981" Margin="0,0,4,0" ToolTip="Camera QR: Kết nối tốt (Giả lập)"/>
                    <TextBlock Text="CAM" FontSize="9" Foreground="#94A3B8" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <Ellipse x:Name="LedBarcode" Width="8" Height="8" Fill="#10B981" Margin="0,0,4,0" ToolTip="Súng quét mã vạch: Kết nối tốt (Giả lập)"/>
                    <TextBlock Text="BAR" FontSize="9" Foreground="#94A3B8" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <Ellipse x:Name="LedRfid" Width="8" Height="8" Fill="#10B981" Margin="0,0,4,0" ToolTip="Đầu đọc RFID: Kết nối tốt (Giả lập)"/>
                    <TextBlock Text="RFID" FontSize="9" Foreground="#94A3B8" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <Ellipse x:Name="LedPrinter" Width="8" Height="8" Fill="#10B981" Margin="0,0,4,0" ToolTip="Máy in hóa đơn Zebra: Kết nối tốt (Giả lập)"/>
                    <TextBlock Text="PRN" FontSize="9" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Style="{StaticResource PrimaryButton}" 
                        Content="{Binding ElementName=root, Path=ActionButtonText}" 
                        Visibility="{Binding ElementName=root, Path=HasActionButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="ActionButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
