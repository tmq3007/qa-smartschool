<Window x:Class="SmartLibrary.Desktop.Views.Shared.StreakCelebrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ăn Mừng Độc Giả" Height="320" Width="450"
        WindowStartupLocation="CenterOwner" AllowsTransparency="True" WindowStyle="None" Background="Transparent" ShowInTaskbar="False">
    <Border CornerRadius="20" Background="#F00F172A" BorderBrush="#FF3B82F6" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="0" ShadowDepth="0" Color="#FF3B82F6" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="🎉 ĐỒNG HÀNH ĐỌC SÁCH" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#FFFFDF00"/>
            
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtStreakFire" Text="🔥 7 Ngày Liên Tiếp 🔥" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#FFEE5A24" Margin="10" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="TextBlock.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.8"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.95" To="1.05" Duration="0:0:0.8"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.95" To="1.05" Duration="0:0:0.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock x:Name="TxtMessage" Text="Cộng thêm 50 XP bonus!" HorizontalAlignment="Center" TextAlignment="Center" FontSize="14" Foreground="White" TextWrapping="Wrap" Margin="8,0"/>
            </StackPanel>
            
            <Button Grid.Row="2" Content="XÁC NHẬN" Width="140" Height="38" Background="#FF3B82F6" Foreground="White" FontWeight="Bold" Click="Confirm_Click" Cursor="Hand" BorderThickness="0" Focusable="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
