<UserControl x:Class="SmartLibrary.Desktop.Views.Student.LibraryNavigatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             >
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="📍 Bản đồ chỉ đường tìm sách (A* Pathfinder)" />

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- BẢN ĐỒ LƯỚI 12x12 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16" Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="🗺️ Sơ đồ bố trí kệ sách thư viện" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    
                    <!-- UniformGrid vẽ lưới 12x12 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding GridCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="12" Rows="12" FirstColumn="0" Background="{DynamicResource BackgroundBrush}" Margin="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="1" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStart}" Value="True">
                                                    <Setter Property="Background" Value="#1E3A8A"/> <!-- Dark Blue -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                    <Setter Property="Background" Value="#991B1B"/> <!-- Dark Red -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrentAgent}" Value="True">
                                                    <Setter Property="Background" Value="#065F46"/> <!-- Dark Green -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPath}" Value="True">
                                                    <Setter Property="Background" Value="#0F766E"/> <!-- Teal -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsVisited}" Value="True">
                                                    <Setter Property="Background" Value="#115E59"/> <!-- Dark Teal -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsObstacle}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/> <!-- Slate Grey -->
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CellIcon}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- BẢNG ĐIỀU KHIỂN & CHI TIẾT SÁCH -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bộ chọn sách & Chỉ đường -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🔍 Tra cứu vị trí sách" Style="{StaticResource CardTitleText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Chọn sách để định vị:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableBooks}"
                                  SelectedItem="{Binding SelectedBook}"
                                  DisplayMemberPath="Title"
                                  Style="{StaticResource ModernComboBox}"
                                  Padding="8" FontSize="13" Margin="0,0,0,16"/>

                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📍 Vị trí chỉ định:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TargetShelfText}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="14" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                
                                <TextBlock Text="Tác phẩm đang tìm:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TargetBookTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button Content="🚶 Mô phỏng di chuyển" 
                                Command="{Binding StartSimulationCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="40" FontSize="13" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,8"/>
                        
                        <Button Content="🔄 Reset bản đồ" 
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="36" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Trạng thái & Chú giải bản đồ -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="📋 Trạng thái và ký hiệu" Style="{StaticResource CardTitleText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        
                        <!-- Ký hiệu chú thích -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20" Background="#1E3A8A" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="🚪 Cửa ra vào (Điểm bắt đầu - 0,0)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20" Background="{DynamicResource BorderBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="📚" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="📚 Dãy Kệ Sách (Vật cản lối đi)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20" Background="#991B1B" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="🎯" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="🎯 Kệ sách đích cần tìm" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20" Background="#0F766E" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="•" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="🟢 Đường đi ngắn nhất (Thuật toán A*)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20" Background="#115E59" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="•" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="🐾 Đường đi thực tế đã qua (Visited)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20" Background="#065F46" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="🚶" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="🏃 Trạng thái di chuyển của Độc giả" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Trạng thái mô phỏng -->
                        <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Trạng thái: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SimulationStatus}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
