<UserControl x:Class="SmartLibrary.Desktop.Views.Student.StudentBookBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             xmlns:converters="clr-namespace:SmartLibrary.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             KeyDown="UserControl_KeyDown" Focusable="True">
    <UserControl.Resources>
        <converters:AvailabilityToBrushConverter x:Key="AvailabilityToBrushConverter"/>
        <converters:GenreToBrushConverter x:Key="GenreToBrushConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="📖 Tra cứu và tìm kiếm sách" ActionButtonText=""/>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Lọc và Toggle -->
                <RowDefinition Height="Auto"/> <!-- AI Khuyên đọc -->
                <RowDefinition Height="Auto"/> <!-- Nhiệm vụ đọc sách lớp học (Quests) -->
                <RowDefinition Height="*"/>    <!-- Content Area -->
            </Grid.RowDefinitions>

            <!-- Thanh trạng thái tải dữ liệu -->
            <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Margin="0,-4,0,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Thanh công cụ lọc & chuyển chế độ xem -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tìm kiếm theo Tên sách, Tác giả hoặc Thể loại..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtSearch" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInputStyle}" ToolTip="Nhấn Ctrl+F để tìm kiếm nhanh" MaxLength="100"/>
                    </StackPanel>

                    <!-- Toggle Button -->
                    <Button Grid.Column="1" Command="{Binding ToggleViewCommand}" Height="38" Padding="16,0" VerticalAlignment="Bottom" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Content" Value="📋 Xem dạng bảng"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="False">
                                        <Setter Property="Content" Value="🗂️ Xem dạng thẻ"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- AI Khuyên đọc đề xuất -->
            <Border Grid.Row="1" Padding="16" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecommendedBooks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="✨ Đề xuất riêng cho bạn (AI)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RecommendedBooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Width="200" Padding="12" Margin="0,0,12,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Category.Name}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" MaxHeight="36" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PublishYear, StringFormat='Năm XB: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Nhiệm vụ đọc sách lớp học (Quests) -->
            <Border Grid.Row="2" Margin="0,0,0,16" Padding="16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecommendedBags.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="🎯 Nhiệm vụ đọc sách của lớp" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RecommendedBags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource BackgroundBrush}" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Bag Header Info -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding BagTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="👤 Giáo viên giao: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding TeacherSsoId}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="  •  🎯 Tỷ lệ đạt Trắc nghiệm: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding RequiredPassRate, StringFormat='{}{0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- Deadline Badge -->
                                            <Border Grid.Column="1" Background="{StaticResource WarningBgBrush}" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📅 Hạn chót: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}"/>
                                                    <TextBlock Text="{Binding Deadline, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningTextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Books in Bag -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Books}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Width="280" Margin="0,4,12,4" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <TextBlock Grid.Column="0" Text="📖" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>
                                                                
                                                                <!-- Quest Status Badge -->
                                                                <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding QuestStatus}" Value="Completed">
                                                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding QuestStatus}" Value="Overdue">
                                                                                    <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                                                                <Setter Property="Text" Value="⏳ Chưa hoàn thành"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding QuestStatus}" Value="Completed">
                                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                                        <Setter Property="Text" Value="✅ Đã hoàn thành"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding QuestStatus}" Value="Overdue">
                                                                                        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                                                                        <Setter Property="Text" Value="⚠️ Quá hạn"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Vùng hiển thị sách -->
            <Grid Grid.Row="3">
                <!-- 1. Grid View (DataGrid) -->
                <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Books}" AutoGenerateColumns="False" IsReadOnly="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Tác giả" Binding="{Binding Author}" Width="1.5*"/>
                            <DataGridTextColumn Header="Thể loại" Binding="{Binding Category}" Width="*"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center"
                                                Background="{Binding AvailableCopies, Converter={StaticResource AvailabilityToBrushConverter}, ConverterParameter=Background}">
                                            <TextBlock Text="{Binding AvailabilityText}" FontWeight="Bold" FontSize="11"
                                                       Foreground="{Binding AvailableCopies, Converter={StaticResource AvailabilityToBrushConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Bản đồ" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📍 Định vị" Command="{Binding DataContext.NavigateToBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="26" Padding="6,0" FontSize="11" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Đánh giá" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⭐ Đánh giá" Command="{Binding DataContext.WriteReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="26" Padding="6,0" FontSize="11" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trắc nghiệm" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📝 Làm Trắc nghiệm" Command="{Binding DataContext.TakeQuizCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SuccessButton}" Height="26" Padding="6,0" FontSize="11" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Sách nói" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🎧 Nghe" Command="{Binding DataContext.PlayAudiobookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Height="26" Padding="6,0" FontSize="11" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Mã QR" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📤 Mã QR" Command="{Binding DataContext.GenerateQrCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="26" Padding="6,0" FontSize="11" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 2. Card View (WrapPanel) -->
                <ScrollViewer Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="-8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190" Height="280" Margin="8" CornerRadius="12" ClipToBounds="True"
                                        Background="{DynamicResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Ảnh bìa (hiển thị ảnh thực tế hoặc fallback 📚) -->
                                        <Border Grid.Row="0" Background="{Binding Category, Converter={StaticResource GenreToBrushConverter}}" CornerRadius="12,12,0,0">
                                            <Grid>
                                                <!-- Fallback 📚 -->
                                                <TextBlock Text="📚" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Actual Image -->
                                                <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <Trigger Property="Source" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                
                                                <!-- Category Badge -->
                                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Category}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Audiobook Status Badge -->
                                                <Border Background="{Binding AudiobookStatusColor}" CornerRadius="4" Padding="6,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Visibility="{Binding AudiobookStatusText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding AudiobookStatusText}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Thông tin sách -->
                                        <Grid Grid.Row="1" Margin="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Tên sách (Hàng 0) -->
                                                <RowDefinition Height="Auto"/> <!-- Tác giả (Hàng 1) -->
                                                <RowDefinition Height="*"/>    <!-- Khoảng cách đệm (Hàng 2) -->
                                                <RowDefinition Height="Auto"/> <!-- Trạng thái bản sao (Hàng 3) -->
                                                <RowDefinition Height="Auto"/> <!-- Nút hành động (Hàng 4) -->
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Author}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            
                                            <Border Grid.Row="3" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{Binding AvailableCopies, Converter={StaticResource AvailabilityToBrushConverter}, ConverterParameter=Background}">
                                                <TextBlock Text="{Binding AvailabilityText}" FontWeight="Bold" FontSize="10"
                                                           Foreground="{Binding AvailableCopies, Converter={StaticResource AvailabilityToBrushConverter}}"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
                                                <Button Content="📍" Command="{Binding DataContext.NavigateToBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="24" Width="24" FontSize="10" Style="{StaticResource SecondaryButton}" Padding="0" Cursor="Hand" ToolTip="Tìm vị trí sách trên bản đồ 3D"/>
                                                <Button Content="⭐" Command="{Binding DataContext.WriteReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="24" Width="24" Margin="2,0,0,0" FontSize="10" Style="{StaticResource SecondaryButton}" Padding="0" Cursor="Hand" ToolTip="Gửi đánh giá"/>
                                                <Button Content="📝" Command="{Binding DataContext.TakeQuizCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="24" Width="24" Margin="2,0,0,0" FontSize="10" Style="{StaticResource SuccessButton}" Padding="0" Cursor="Hand" ToolTip="Làm trắc nghiệm đọc hiểu"/>
                                                <Button Content="🎧" Command="{Binding DataContext.PlayAudiobookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="24" Width="24" Margin="2,0,0,0" FontSize="10" Style="{StaticResource PrimaryButton}" Padding="0" Cursor="Hand" ToolTip="Nghe sách nói"/>
                                                <Button Content="📱" Command="{Binding DataContext.GenerateQrCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="24" Width="24" Margin="2,0,0,0" FontSize="10" Style="{StaticResource SecondaryButton}" Padding="0" Cursor="Hand" ToolTip="Xuất Mã QR Ebook"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Cảnh báo khi không tìm thấy kết quả -->
                <TextBlock Text="✨ Không tìm thấy sách phù hợp. Bạn hãy kiểm tra lại từ khóa hoặc gửi đề xuất mua sách mới qua Email/Hotline tại mục 'Hỗ trợ độc giả' nhé! ✨" 
                           FontSize="16" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsNoResultsFound, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Grid>

        <!-- QR Code Dialog Overlay -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource PopupOverlayBrush}" Visibility="{Binding IsQrPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="380" Height="420" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="📤 Xuất Mã QR Ebook" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding QrCodeBookTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- QR Code Image Area -->
                    <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,16,0,16" Padding="16">
                        <Grid>
                            <Image Source="{Binding QrCodeImageUrl}" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="💾 Lưu hình ảnh" Command="{Binding SaveQrCodeCommand}" Style="{StaticResource SuccessButton}" Width="140" Height="36" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand"/>
                        <Button Content="Đóng" Command="{Binding CloseQrPopupCommand}" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
