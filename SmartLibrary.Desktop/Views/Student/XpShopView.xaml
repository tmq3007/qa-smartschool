<UserControl x:Class="SmartLibrary.Desktop.Views.Student.XpShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             xmlns:converters="clr-namespace:SmartLibrary.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             >
    <UserControl.Resources>
        <converters:XpRedeemAvailabilityConverter x:Key="XpRedeemAvailabilityConverter"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="🛍️ Cửa hàng đổi quà XP Shop" ActionButtonText=""/>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Danh mục quà tặng -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Thống kê điểm hiện có -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel>
                            <TextBlock Text="Điểm XP Tích Lũy Của Bạn" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CurrentXp}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text=" XP" Foreground="{DynamicResource SuccessTextBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentLevel}" Foreground="{DynamicResource WarningTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Mục tiêu cấp tiếp theo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                            <Grid Margin="0,6,0,0" Height="6" Width="150">
                                <Border Background="#334155" CornerRadius="3"/>
                                <ProgressBar Value="{Binding CurrentXp}" Maximum="{Binding MaxXp}" Foreground="{DynamicResource SuccessTextBrush}" Background="Transparent" BorderThickness="0"/>
                            </Grid>
                            <TextBlock Text="{Binding MaxXp, StringFormat='{}{0} XP'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Danh sách quà -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rewards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="0,0,-12,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Width="270" Height="220" Margin="0,0,12,12" Padding="16" Background="#1E293B">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon & Tên -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TypeIcon}" FontSize="24" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <Border Background="#334155" HorizontalAlignment="Left" CornerRadius="3" Padding="4,1" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TypeName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Body: Mô tả -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="34" Margin="0,10,0,10" VerticalAlignment="Top"/>

                                        <!-- Footer: Giá & Nút -->
                                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding XpCost, StringFormat='{}{0} XP'}" Foreground="#FBBF24" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding StockText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Đổi Quà" 
                                                    Command="{Binding DataContext.RedeemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SuccessButton}"
                                                    FontWeight="Bold" Padding="12,6" Cursor="Hand">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource XpRedeemAvailabilityConverter}">
                                                        <Binding Path="DataContext.CurrentXp" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Cột phải: Lịch sử & Nhật ký XP -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Tab 1: Lịch sử đổi quà -->
                    <TabItem Header="🎁 Lịch sử đổi quà" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" Padding="8,4">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Đổi tại quầy hoặc kích hoạt đặc quyền" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            
                            <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding MyRedemptions}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phần quà" Binding="{Binding RewardName}" Width="2*"/>
                                    <DataGridTextColumn Header="Phí XP" Binding="{Binding XpCost}" Width="60">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Trạng thái" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayStatus}" HorizontalAlignment="Center" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCollected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCollected}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab 2: Nhật ký điểm XP -->
                    <TabItem Header="⚡ Nhật ký XP" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" Padding="8,4">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Nhật ký biến động điểm số XP của bạn" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            
                            <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding XpTransactions}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <!-- Cột Ngày -->
                                    <DataGridTextColumn Header="Thời gian" Binding="{Binding FormattedDate}" Width="110"/>
                                    <!-- Cột Loại -->
                                    <DataGridTextColumn Header="Hoạt động" Binding="{Binding TypeName}" Width="120"/>
                                    <!-- Cột Điểm biến động -->
                                    <DataGridTemplateColumn Header="Thay đổi" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                 <TextBlock Text="{Binding AmountText}" Foreground="{Binding AmountColor}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Cột Chi tiết -->
                                    <DataGridTextColumn Header="Chi tiết" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab 3: Túi đồ & Trang trí Avatar -->
                    <TabItem Header="🎒 Túi đồ / Avatar" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" Padding="8,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>
                                <!-- Khung Preview Avatar & Viền -->
                                <TextBlock Text="🎭 Diện mạo đại diện của bạn" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource HoverBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="50" Height="50" CornerRadius="25" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EquippedBorder}" Value="Neon">
                                                            <Setter Property="BorderBrush" Value="#00F5FF"/>
                                                            <Setter Property="BorderThickness" Value="2.5"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#00F5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EquippedBorder}" Value="Gold">
                                                            <Setter Property="BorderBrush" Value="#FFD700"/>
                                                            <Setter Property="BorderThickness" Value="2.5"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#FFD700" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EquippedBorder}" Value="Mythic">
                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                            <Setter Property="BorderThickness" Value="3"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{DynamicResource PrimaryBrush}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource SuccessTextBrush}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding EquippedAvatar}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ĐANG TRANG BỊ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"/>
                                            <TextBlock Text="{Binding EquippedAvatar, StringFormat='Hình đại diện: {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding EquippedBorder, StringFormat='Khung viền: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Danh sách Avatar sở hữu -->
                                <TextBlock Text="👤 Hình đại diện sở hữu" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding OwnedAvatars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Ảnh đại diện" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Grid.Column="1" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="Trang bị" Height="26" Padding="12,0" FontSize="11"
                                                            Command="{Binding DataContext.EquipAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="{Binding DataContext.EquippedAvatar, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Content" Value="Đang dùng"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Danh sách Khung viền sở hữu -->
                                <TextBlock Text="🎨 Khung viền sở hữu" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,8"/>
                                <ItemsControl ItemsSource="{Binding OwnedBorders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="Neon">
                                                                        <Setter Property="BorderBrush" Value="#00F5FF"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="Gold">
                                                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="Mythic">
                                                                        <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="Trang bị" Height="26" Padding="12,0" FontSize="11"
                                                            Command="{Binding DataContext.EquipBorderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="{Binding DataContext.EquippedBorder, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Content" Value="Đang dùng"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
