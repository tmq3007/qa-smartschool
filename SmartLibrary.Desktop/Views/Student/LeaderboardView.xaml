<UserControl x:Class="SmartLibrary.Desktop.Views.Student.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SmartLibrary.Desktop.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:TopBarControl Title="🏆 Bảng vàng độc giả" ActionButtonText=""/>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Bảng xếp hạng Học sinh (Top 10) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Personal Stats Card -->
                    <Border Grid.Row="0" Background="{DynamicResource HoverBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center"
                                    BorderBrush="{Binding MyEquippedBorderBrush}"
                                    BorderThickness="{Binding MyEquippedBorderThickness}"
                                    Effect="{Binding MyEquippedBorderEffect}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#10B981" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding MyEquippedAvatar}" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MyName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource StateInfo}" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="{Binding MyLevel}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Xếp hạng: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MyRank}" Foreground="#FBBF24" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,6,0,0" Height="4" Width="180" HorizontalAlignment="Left">
                                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="2"/>
                                    <ProgressBar Value="{Binding MyXP}" Maximum="{Binding MyMaxXP}" Foreground="{DynamicResource StateSuccess}" Background="Transparent" BorderThickness="0"/>
                                </Grid>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding MyXP, StringFormat='{}{0} XP'}" Foreground="{DynamicResource StateSuccess}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="của bạn" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="🥇 Cá nhân tiêu biểu" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource StateSuccess}"/>
                        <TextBlock Text="Top 10 học sinh mượn sách nhiều nhất trong tháng" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding TopStudents}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                        <Setter Property="Background" Value="#15FBBF24"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rank}" Value="2">
                                        <Setter Property="Background" Value="#1594A3B8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rank}" Value="3">
                                        <Setter Property="Background" Value="#15D97706"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Huy hiệu" Binding="{Binding Trophy}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="16"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Hạng" Binding="{Binding Rank}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="2*"/>
                            <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="*"/>
                            <DataGridTextColumn Header="Số sách đã mượn" Binding="{Binding BooksCount, StringFormat='{}{0} cuốn'}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cột phải: Bảng xếp hạng Lớp học (Top 5) & Huy hiệu cá nhân -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bảng xếp hạng Lớp học -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="🏆 Tập thể tích cực" FontSize="16" FontWeight="Bold" Foreground="#FBBF24" />
                            <TextBlock Text="Top 5 lớp học mượn sách nhiều nhất" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" MaxHeight="180" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding TopClasses}" AutoGenerateColumns="False" IsReadOnly="True" >
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                            <Setter Property="Background" Value="#15FBBF24"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rank}" Value="2">
                                            <Setter Property="Background" Value="#1594A3B8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rank}" Value="3">
                                            <Setter Property="Background" Value="#15D97706"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Huy hiệu" Binding="{Binding Trophy}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="14"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Hạng" Binding="{Binding Rank}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="2*"/>
                                <DataGridTextColumn Header="Số sách mượn" Binding="{Binding BooksCount, StringFormat='{}{0} cuốn'}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#FBBF24"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Huy hiệu cá nhân -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="🏅 Huy hiệu cá nhân" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource StateSuccess}" />
                            <TextBlock Text="Mở khóa các mốc đóng góp và cấp độ học tập" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Badges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Background="{DynamicResource HoverBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" ToolTip="{Binding UnlockCondition}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon hình tròn -->
                                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Biểu tượng huy hiệu độc giả">
                                                    <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Nội dung thông tin -->
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"  TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"  TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Trạng thái -->
                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="5,2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="9.5" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
