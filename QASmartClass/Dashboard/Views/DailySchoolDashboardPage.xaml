<Page x:Class="QASmartClass.Dashboard.Views.DailySchoolDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="DailySchoolDashboardPage" FontFamily="Segoe UI" Background="#F8FAFC">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER & TITLE -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📅 DAILY SCHOOL DASHBOARD" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Hệ thống Lịch công việc hàng ngày chuyên nghiệp và đồng bộ" FontSize="14" Foreground="#93C5FD" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Hôm nay: " FontSize="16" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtToday" Text="26/10/2025" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CRITICAL OVERDUE SLA BANNER -->
        <Border Grid.Row="1" x:Name="BdrSlaWarning" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🚨" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtSlaWarningMsg" Text="Cảnh báo: Có công việc khẩn cấp (Critical) đã quá hạn SLA! Hệ thống đã gửi báo cáo leo thang cho Hiệu trưởng." FontSize="14" FontWeight="SemiBold" Foreground="#991B1B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold" Margin="10,6"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Padding" Value="10,6"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: LỊCH HOẠT ĐỘNG TOÀN TRƯỜNG -->
            <TabItem Header="🏛️ Lịch hoạt động toàn trường">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar Filters -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="LỌC THEO BỘ PHẬN" FontSize="14" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>
                            <Button x:Name="BtnFilterAll" Content="Tất cả bộ phận" Style="{StaticResource FilterButtonStyle}" Click="BtnFilter_Click" Tag="All" Margin="0,0,0,8"/>
                            <Button x:Name="BtnFilterBgh" Content="Ban giám hiệu" Style="{StaticResource FilterButtonStyle}" Click="BtnFilter_Click" Tag="BGH" Margin="0,0,0,8"/>
                            <Button x:Name="BtnFilterGv" Content="Giáo viên" Style="{StaticResource FilterButtonStyle}" Click="BtnFilter_Click" Tag="Giáo viên" Margin="0,0,0,8"/>
                            <Button x:Name="BtnFilterNv" Content="Nhân viên văn phòng" Style="{StaticResource FilterButtonStyle}" Click="BtnFilter_Click" Tag="Nhân viên" Margin="0,0,0,8"/>
                            <Button x:Name="BtnFilterDoan" Content="Đoàn - Đội / CLB" Style="{StaticResource FilterButtonStyle}" Click="BtnFilter_Click" Tag="Đoàn - Đội" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Main grid -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="TxtSchoolScheduleHeader" Text="Danh sách hoạt động trong ngày" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>
                            <ListView Grid.Row="1" x:Name="LvSchoolSchedule" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BgColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                        <Border Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="KHẨN CẤP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding LocationDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{Binding AssignedToDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                                    <TextBlock Text="{Binding CollaboratorsDisplay}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Background="{Binding StatusBg}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusFg}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: LỊCH CÔNG VIỆC BỘ PHẬN -->
            <TabItem Header="👥 Lịch bộ phận của tôi">
                <Grid Margin="0,16,0,0">
                    <Border Background="White" CornerRadius="12" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TxtDeptHeader" Text="Lịch hoạt động của tổ chuyên môn" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Grid.Column="1" x:Name="TxtDeptName" Text="Bộ phận: Giáo viên" FontSize="14" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            </Grid>
                            <ListView Grid.Row="1" x:Name="LvDeptSchedule" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BgColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                        <Border Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="KHẨN CẤP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding LocationDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{Binding AssignedToDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                                    <TextBlock Text="{Binding CollaboratorsDisplay}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Background="{Binding StatusBg}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusFg}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: LỊCH CÁ NHÂN & PHỐI HỢP -->
            <TabItem Header="👤 Lịch cá nhân của tôi">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: My Tasks -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🧭 Công việc hôm nay của tôi" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,16"/>
                            <ListView Grid.Row="1" x:Name="LvMyTasks" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#14532D" TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1" Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Top">
                                                        <TextBlock Text="KHẨN" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding TimeAndLocation}" FontSize="13" Foreground="#166534" Margin="0,4,0,0"/>
                                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Ủy thác" Click="BtnDelegate_Click" Tag="{Binding Id}" Margin="0,0,6,0" Padding="8,4" Background="#F1F5F9" Foreground="#475569" BorderThickness="1" BorderBrush="#CBD5E1"/>
                                                    <Button Grid.Column="2" Content="Báo cáo" Click="BtnReportComplete_Click" Tag="{Binding Id}" Padding="10,4" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Visibility="{Binding IsNotDone, Converter={StaticResource BoolToVisConverter}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right: Coordination Tasks -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🤝 Việc tôi cần phối hợp" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,16"/>
                            <ListView Grid.Row="1" x:Name="LvMyCoordinations" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1" Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Top">
                                                        <TextBlock Text="KHẨN" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding TimeAndLocation}" FontSize="13" Foreground="#1E40AF" Margin="0,4,0,0"/>
                                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding AssignedToDisplay}" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Báo cáo" Click="BtnReportComplete_Click" Tag="{Binding Id}" Padding="10,4" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Visibility="{Binding IsNotDone, Converter={StaticResource BoolToVisConverter}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
