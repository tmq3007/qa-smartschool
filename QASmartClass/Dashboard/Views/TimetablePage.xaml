<Page x:Class="QASmartClass.Dashboard.Views.TimetablePage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

      mc:Ignorable="d" 

      d:DesignHeight="720" d:DesignWidth="1280"

      Title="TimetablePage" FontFamily="Segoe UI" Background="#F0F2F5">



    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- HEADER & FILTERS -->

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">

            <Border.Effect>

                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>

            </Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <TextBlock Grid.Column="0" Text="📅 Thời khóa biểu toàn trường" FontSize="24" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center"/>



                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="Xem theo:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>

                    <ComboBox x:Name="CbViewMode" Width="150" Height="36" FontSize="16" SelectionChanged="CbViewMode_SelectionChanged" Margin="0,0,10,0">

                        <ComboBoxItem Content="Theo Lớp" IsSelected="True" Tag="Class"/>

                        <ComboBoxItem Content="Theo Giáo viên" Tag="Teacher"/>

                    </ComboBox>



                    <ComboBox x:Name="CbTargetSelection" Width="200" Height="36" FontSize="16" SelectionChanged="CbTargetSelection_SelectionChanged"/>

                </StackPanel>

            </Grid>

        </Border>



        <!-- TIMETABLE GRID -->

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">

            <Border.Effect>

                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>

            </Border.Effect>

            

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/> <!-- Header days -->

                    <RowDefinition Height="*"/> <!-- Periods -->

                </Grid.RowDefinitions>



                <!-- HEADER ROW -->

                <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,10">

                    <Border Background="#F1F5F9" CornerRadius="8" Margin="5" Padding="10">

                        <TextBlock Text="Tiết" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#64748B"/>

                    </Border>

                    <Border Background="#F8FAFC" CornerRadius="8" Margin="5" Padding="10"><TextBlock Text="Thứ 2" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16" Foreground="#1E3A5F"/></Border>

                    <Border Background="#F8FAFC" CornerRadius="8" Margin="5" Padding="10"><TextBlock Text="Thứ 3" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16" Foreground="#1E3A5F"/></Border>

                    <Border Background="#F8FAFC" CornerRadius="8" Margin="5" Padding="10"><TextBlock Text="Thứ 4" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16" Foreground="#1E3A5F"/></Border>

                    <Border Background="#F8FAFC" CornerRadius="8" Margin="5" Padding="10"><TextBlock Text="Thứ 5" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16" Foreground="#1E3A5F"/></Border>

                    <Border Background="#F8FAFC" CornerRadius="8" Margin="5" Padding="10"><TextBlock Text="Thứ 6" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16" Foreground="#1E3A5F"/></Border>

                    <Border Background="#F8FAFC" CornerRadius="8" Margin="5" Padding="10"><TextBlock Text="Thứ 7" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16" Foreground="#1E3A5F"/></Border>

                </UniformGrid>



                <!-- DATA ROWS -->

                <!-- We will generate this dynamically in code-behind to support the 5 periods * 6 days grid cleanly,

                     but for simplicity we can use an ItemsControl with a UniformGrid of 5 rows and 7 columns. -->

                <ItemsControl Grid.Row="1" x:Name="IcTimetableGrid">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <UniformGrid Rows="5" Columns="7"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="{Binding BackgroundBrush}" BorderBrush="#E2E8F0" BorderThickness="1" Margin="5" CornerRadius="8" Padding="10">

                                <Grid>

                                    <TextBlock Text="{Binding PeriodLabel}" FontWeight="Bold" FontSize="16" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPeriodHeader, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsDataCell, Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <TextBlock Text="{Binding Subject}" FontWeight="Bold" FontSize="18" Foreground="#1E3A5F" TextAlignment="Center" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding SubInfo}" FontSize="14" Foreground="#64748B" Margin="0,5,0,0" TextAlignment="Center"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Grid>

        </Border>

    </Grid>

</Page>



