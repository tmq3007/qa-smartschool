<Page x:Class="QASmartClass.Dashboard.Views.MyDailyTasksPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

      mc:Ignorable="d" 

      d:DesignHeight="720" d:DesignWidth="1280"

      Title="MyDailyTasksPage" FontFamily="Segoe UI" Background="#F0F2F5">



    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- HEADER & PROGRESS -->

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">

            <Border.Effect>

                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>

            </Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="300"/>

                </Grid.ColumnDefinitions>



                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="📋 Việc của tôi — " FontSize="24" FontWeight="Bold" Foreground="#1E3A5F"/>

                    <TextBlock x:Name="TxtCurrentDate" Text="20/05/2026" FontSize="24" FontWeight="Bold" Foreground="#1E3A5F"/>

                </StackPanel>



                <StackPanel Grid.Column="2" VerticalAlignment="Center">

                    <TextBlock x:Name="TxtProgressLabel" Text="Hoàn thành: 0/0 (0%)" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,0,5"/>

                    <ProgressBar x:Name="PbTaskProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="#E2E8F0" BorderThickness="0">

                        <ProgressBar.Resources>

                            <Style TargetType="Border">

                                <Setter Property="CornerRadius" Value="4"/>

                            </Style>

                        </ProgressBar.Resources>

                    </ProgressBar>

                </StackPanel>

            </Grid>

        </Border>



        <!-- TASKS LISTS -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- TODO COLUMN -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,10,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtTodoHeader" Text="⏳ Cần làm (0)" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,15"/>

                    <ListView Grid.Row="1" x:Name="LvTodo" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#E2E8F0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                                <TextBlock Text="Đến hạn: " FontSize="13" Foreground="#64748B"/>

                                                <TextBlock Text="{Binding DueDate, StringFormat='dd/MM/yyyy'}" FontSize="13" Foreground="{Binding OverdueColor}" FontWeight="Bold"/>

                                                <TextBlock Text=" 🔴 Quá hạn" FontSize="12" Foreground="#EF4444" FontWeight="Bold" Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            </StackPanel>

                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Bắt đầu" Tag="{Binding Id}" Click="BtnStartTask_Click" Margin="10,0,0,0" Padding="10,5" Background="#E0F2FE" Foreground="#0284C7" BorderThickness="0" Cursor="Hand"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>



            <!-- IN PROGRESS COLUMN -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="15" Margin="5,0,5,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtInProgressHeader" Text="🔄 Đang làm (0)" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,15"/>

                    <ListView Grid.Row="1" x:Name="LvInProgress" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#EFF6FF" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#BFDBFE">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1E3A8A"/>

                                            <TextBlock Text="{Binding AssignedBy, StringFormat='Giao bởi: {0}'}" FontSize="13" Foreground="#3B82F6" Margin="0,5,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="1" Content="✅ Hoàn thành" Tag="{Binding Id}" Click="BtnCompleteTask_Click" Margin="10,0,0,0" Padding="10,5" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>



            <!-- DONE COLUMN -->

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="15" Margin="10,0,0,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtDoneHeader" Text="✅ Đã xong (0)" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,15"/>

                    <ListView Grid.Row="1" x:Name="LvDone" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F0FDF4" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#BBF7D0">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextDecorations="Strikethrough" Foreground="#065F46" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Notes, StringFormat='Ghi chú: {0}'}" FontSize="13" Foreground="#047857" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>



            <!-- EMPTY STATE LAYER -->

            <Border x:Name="BdrEmptyState" Grid.ColumnSpan="3" Background="#F0F2F5" Visibility="Collapsed">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock Text="🎉" FontSize="80" TextAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="Thật tuyệt! Bạn không có việc nào hôm nay." FontSize="24" FontWeight="SemiBold" Foreground="#1E3A5F" TextAlignment="Center"/>

                    <TextBlock Text="Hãy tận hưởng thời gian nghỉ ngơi nhé." FontSize="16" Foreground="#64748B" TextAlignment="Center" Margin="0,10,0,0"/>

                </StackPanel>

            </Border>



        </Grid>

    </Grid>

</Page>



