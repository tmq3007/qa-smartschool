<Page x:Class="QASmartClass.Dashboard.Views.TaskDetailPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

      mc:Ignorable="d" 

      d:DesignHeight="720" d:DesignWidth="1280"

      Title="TaskDetailPage" FontFamily="Segoe UI" Background="#F1F5F9">



    <Grid Margin="20">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*"/>

            <ColumnDefinition Width="1*"/>

        </Grid.ColumnDefinitions>



        <!-- TASK DETAILS (LEFT) -->

        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="30" Margin="0,0,10,0">

            <Border.Effect>

                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <Button x:Name="BtnBack" Content="← Quay lại Kanban" HorizontalAlignment="Left" Padding="10,5" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,15" Click="BtnBack_Click"/>



                <StackPanel Grid.Row="1" Margin="0,0,0,20">

                    <TextBlock x:Name="TxtTitle" Text="Cập nhật giáo án Toán tuần 20" FontSize="28" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>

                    

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <Border x:Name="BdrPriority" Background="#FEF9C3" CornerRadius="6" Padding="10,4" Margin="0,0,15,0">

                            <TextBlock x:Name="TxtPriority" Text="Mức độ: Medium" FontSize="14" Foreground="#A16207" FontWeight="Bold"/>

                        </Border>

                        <Border x:Name="BdrStatus" Background="#E0F2FE" CornerRadius="6" Padding="10,4" Margin="0,0,15,0">

                            <TextBlock x:Name="TxtStatus" Text="Trạng thái: InProgress" FontSize="14" Foreground="#0284C7" FontWeight="Bold"/>

                        </Border>

                        <TextBlock x:Name="TxtDeadline" Text="Hạn chót: 25/05/2026" FontSize="14" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>

                    </StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">

                        <TextBlock Text="Người giao: " FontSize="14" Foreground="#64748B"/>

                        <TextBlock x:Name="TxtAssignedBy" Text="BGH" FontSize="14" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,20,0"/>

                        <TextBlock Text="Người nhận: " FontSize="14" Foreground="#64748B"/>

                        <TextBlock x:Name="TxtAssignedTo" Text="Tổ Toán-Tin" FontSize="14" Foreground="#0F172A" FontWeight="SemiBold"/>

                    </StackPanel>

                </StackPanel>



                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <TextBlock x:Name="TxtDescription" Text="Nội dung chi tiết của công việc sẽ hiển thị ở đây..." FontSize="16" Foreground="#334155" TextWrapping="Wrap" LineHeight="24"/>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Border>



        <!-- COMMENTS SECTION (RIGHT) -->

        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">

            <Border.Effect>

                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <TextBlock Grid.Row="0" Text="💬 Thảo luận &amp; Bình luận" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>



                <ListView Grid.Row="1" x:Name="LvComments" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,10" Width="360">

                                <StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                                        <TextBlock Text="{Binding Author}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>

                                        <TextBlock Text="{Binding CreatedAt, StringFormat=' - {0:dd/MM HH:mm}'}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                    </StackPanel>

                                    <TextBlock Text="{Binding Content}" FontSize="14" Foreground="#334155" TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>



                <!-- ADD COMMENT INPUT -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtNewComment" Grid.Column="0" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" MaxLength="500" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>

                    <Button x:Name="BtnSendComment" Grid.Column="1" Content="Gửi" Width="60" Height="40" Margin="10,0,0,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSendComment_Click"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>



