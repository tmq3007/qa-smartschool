<Window x:Class="QASmartClass.HRModule.Views.RejectReasonDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Từ Chối Đơn Nghỉ Phép" 

        Width="400" Height="200"

        WindowStartupLocation="CenterOwner"

        ResizeMode="NoResize"

        Background="#F8FAFC"

        FontFamily="Segoe UI">

    <Grid Margin="15">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Text="❌ Lý do từ chối đơn nghỉ phép:" 

                   FontSize="14" 

                   FontWeight="SemiBold" 

                   Foreground="#0F172A" 

                   Margin="0,0,0,10"

                   Grid.Row="0"/>



        <TextBox x:Name="TxtReason" 

                 Text="Không được chấp thuận"

                 Height="35" 

                 FontSize="14" 

                 VerticalContentAlignment="Center"

                 Padding="5,0,5,0"

                 Grid.Row="1"

                 Margin="0,0,0,10"

                 Focusable="True"/>



        <StackPanel Orientation="Horizontal" 

                    HorizontalAlignment="Right" 

                    Grid.Row="2">

            <Button Content="Hủy" 

                    Width="80" Height="30" 

                    Margin="0,0,10,0"

                    Background="White"

                    BorderBrush="#CBD5E1"

                    Cursor="Hand"

                    Click="BtnCancel_Click"/>

            <Button Content="Xác nhận" 

                    Width="100" Height="30" 

                    Background="#EF4444"

                    Foreground="White"

                    BorderThickness="0"

                    Cursor="Hand"

                    FontWeight="Bold"

                    Click="BtnConfirm_Click"/>

        </StackPanel>

    </Grid>

</Window>

