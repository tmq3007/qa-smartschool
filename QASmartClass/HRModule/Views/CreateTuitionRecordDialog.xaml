<Window x:Class="QASmartClass.HRModule.Views.CreateTuitionRecordDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Tạo Phiếu Thu Học Phí Mới" 

        Width="450" Height="380"

        WindowStartupLocation="CenterOwner"

        ResizeMode="NoResize"

        Background="#F8FAFC"

        FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Text="✍️ Thông Tin Phiếu Thu Mới" 

                   FontSize="18" 

                   FontWeight="Bold" 

                   Foreground="#0F172A" 

                   Margin="0,0,0,15"

                   Grid.Row="0"/>



        <StackPanel Grid.Row="1">

            <!-- Chọn học sinh -->

            <TextBlock Text="Học sinh:" 

                       FontSize="14" 

                       FontWeight="SemiBold" 

                       Foreground="#334155" 

                       Margin="0,0,0,5"/>

            <ComboBox x:Name="CbStudent" 

                      Height="35" 

                      FontSize="14" 

                      Margin="0,0,0,15"

                      DisplayMemberPath="Display"

                      SelectedValuePath="Id"/>



            <!-- Số tiền -->

            <TextBlock Text="Số tiền (VND):" 

                       FontSize="14" 

                       FontWeight="SemiBold" 

                       Foreground="#334155" 

                       Margin="0,0,0,5"/>

            <TextBox x:Name="TxtAmount" 

                     Text="5000000"

                     Height="35" 

                     FontSize="14" 

                     VerticalContentAlignment="Center"

                     Padding="5,0,5,0"

                     Margin="0,0,0,15"/>



            <!-- Hạn nộp -->

            <TextBlock Text="Hạn nộp:" 

                       FontSize="14" 

                       FontWeight="SemiBold" 

                       Foreground="#334155" 

                       Margin="0,0,0,5"/>

            <DatePicker x:Name="DpDueDate" 

                        Height="35" 

                        FontSize="14" 

                        Margin="0,0,0,15"/>

        </StackPanel>



        <!-- Nút bấm -->

        <StackPanel Orientation="Horizontal" 

                    HorizontalAlignment="Right" 

                    Grid.Row="2">

            <Button Content="Hủy" 

                    Width="80" Height="35" 

                    Margin="0,0,10,0"

                    Background="White"

                    BorderBrush="#CBD5E1"

                    Cursor="Hand"

                    Click="BtnCancel_Click"/>

            <Button Content="Tạo Phiếu" 

                    Width="100" Height="35" 

                    Background="#3B82F6"

                    Foreground="White"

                    BorderThickness="0"

                    Cursor="Hand"

                    FontWeight="Bold"

                    Click="BtnSave_Click"/>

        </StackPanel>

    </Grid>

</Window>

