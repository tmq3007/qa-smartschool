<Page x:Class="QASmartClass.HRModule.Views.TuitionFeeView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Thu Học Phí" Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <DockPanel Margin="0,0,0,20">

            <TextBlock Text="💳 Quản lý Thu Học phí" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="BtnNotify" Content="🔔 Nhắc nợ Tự động" Background="#F59E0B" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnNotify_Click"/>

                <Button x:Name="BtnAdd" Content="➕ Tạo Phiếu Thu" Background="#3B82F6" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnAdd_Click"/>

                <Button x:Name="BtnPay" Content="✔️ Xác nhận Đã Thu" Background="#10B981" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnPay_Click"/>

                <Button x:Name="BtnRefresh" Content="🔄 Làm mới" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15,8" Cursor="Hand" Click="BtnRefresh_Click"/>

            </StackPanel>

        </DockPanel>



        <!-- Main Content Grid -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="200"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Filters -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,15,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

                <StackPanel>

                    <TextBlock Text="Trạng thái Học phí" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <RadioButton Content="Tất cả" GroupName="Status" IsChecked="True" Margin="0,5" Checked="Filter_Changed"/>

                    <RadioButton Content="Chưa nộp (Unpaid)" GroupName="Status" Tag="Unpaid" Margin="0,5" Checked="Filter_Changed"/>

                    <RadioButton Content="Đã nộp (Paid)" GroupName="Status" Tag="Paid" Margin="0,5" Checked="Filter_Changed"/>

                    <RadioButton Content="Quá hạn (Overdue)" GroupName="Status" Tag="Overdue" Foreground="#EF4444" Margin="0,5" Checked="Filter_Changed"/>

                </StackPanel>

            </Border>



            <!-- DataGrid -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

                <DataGrid x:Name="DgTuition" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" HeadersVisibility="Column" RowHeight="40">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="80"/>

                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="2*"/>

                        <DataGridTextColumn Header="Số tiền (VND)" Binding="{Binding Amount, StringFormat=N0}" Width="150"/>

                        <DataGridTextColumn Header="Hạn nộp" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="100"/>

                        <DataGridTextColumn Header="Ngày nộp" Binding="{Binding PaidDate, StringFormat=dd/MM/yyyy}" Width="100"/>

                        <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}" Width="120"/>

                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Page>



