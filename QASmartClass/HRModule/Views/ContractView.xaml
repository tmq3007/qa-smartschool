<Page x:Class="QASmartClass.HRModule.Views.ContractView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Quản lý Hợp đồng" Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <DockPanel Margin="0,0,0,20">

            <TextBlock Text="📄 Quản lý Hợp đồng Lao động" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="BtnAdd" Content="➕ Thêm Hợp đồng" Background="#3B82F6" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnAdd_Click"/>

                <Button x:Name="BtnRefresh" Content="🔄 Làm mới" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15,8" Cursor="Hand" Click="BtnRefresh_Click"/>

            </StackPanel>

        </DockPanel>



        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <DataGrid x:Name="DgContracts" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" HeadersVisibility="Column" RowHeight="40">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Số Hợp đồng" Binding="{Binding ContractNumber}" Width="150"/>

                    <DataGridTextColumn Header="Mã NV" Binding="{Binding StaffId}" Width="100"/>

                    <DataGridTextColumn Header="Loại Hợp đồng" Binding="{Binding ContractType}" Width="1.5*"/>

                    <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="120"/>

                    <DataGridTextColumn Header="Ngày kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="120"/>

                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- Popup Overlay for Adding Contract -->

        <Grid x:Name="PopupAddContract" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">

            <Border Background="White" CornerRadius="12" Padding="20" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.3"/>

                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="Tạo Hợp đồng Lao động" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="#1E293B"/>

                    

                    <TextBlock Text="Nhân sự (Giáo viên):" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>

                    <ComboBox x:Name="CbStaff" Padding="8" Margin="0,0,0,10" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

                    

                    <TextBlock Text="Số Hợp đồng:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>

                    <TextBox x:Name="TxtContractNumber" Padding="8" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#CBD5E1"/>

                    

                    <TextBlock Text="Loại Hợp đồng:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>

                    <ComboBox x:Name="CbContractType" Padding="8" Margin="0,0,0,10" SelectionChanged="CbContractType_SelectionChanged">

                        <ComboBoxItem Content="Probation" IsSelected="True"/>

                        <ComboBoxItem Content="1-Year"/>

                        <ComboBoxItem Content="Indefinite"/>

                    </ComboBox>

                    

                    <TextBlock Text="Ngày bắt đầu:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>

                    <DatePicker x:Name="DpStartDate" Padding="8" Margin="0,0,0,10"/>

                    

                    <StackPanel x:Name="PanelEndDate">

                        <TextBlock Text="Ngày kết thúc:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>

                        <DatePicker x:Name="DpEndDate" Padding="8" Margin="0,0,0,10"/>

                    </StackPanel>

                    

                    <TextBlock Text="Trạng thái:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>

                    <ComboBox x:Name="CbStatus" Padding="8" Margin="0,0,0,15">

                        <ComboBoxItem Content="Active" IsSelected="True"/>

                        <ComboBoxItem Content="Expired"/>

                        <ComboBoxItem Content="Terminated"/>

                    </ComboBox>

                    

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Button Content="Hủy" Grid.Column="0" Margin="0,0,5,0" Padding="10" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnCancelAddContract_Click"/>

                        <Button Content="Lưu hợp đồng" Grid.Column="1" Margin="5,0,0,0" Padding="10" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSaveContract_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>



