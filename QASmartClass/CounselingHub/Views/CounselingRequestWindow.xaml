<Window x:Class="QASmartClass.CounselingHub.Views.CounselingRequestWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Tạo hồ sơ yêu cầu tư vấn" Height="420" Width="450"

        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"

        Background="#F5F7FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0" Text="TẠO HỒ SƠ TƯ VẤN MỚI" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,16"/>



        <StackPanel Grid.Row="1">

            <TextBlock Text="Chọn Học sinh" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <ComboBox x:Name="CboStudent" DisplayMemberPath="DisplayInfo" SelectedValuePath="Id" Height="32" Margin="0,0,0,12" SelectionChanged="CboStudent_SelectionChanged"/>



            <TextBlock Text="Lớp học" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <TextBox x:Name="TxtClassName" Height="30" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,12" Padding="6,4"/>



            <TextBlock Text="Loại vấn đề" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <ComboBox x:Name="CboProblemType" Height="32" Margin="0,0,0,12" SelectedIndex="0">
                <ComboBoxItem Content="Học tập"/>
                <ComboBoxItem Content="Gia đình"/>
                <ComboBoxItem Content="Tâm lý cá nhân"/>
                <ComboBoxItem Content="Quan hệ bạn bè"/>
            </ComboBox>



            <TextBlock Text="Ghi chú nội dung tư vấn" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <TextBox x:Name="TxtNotes" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6,4"/>

        </StackPanel>



        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">

            <Button Content="Hủy" Width="80" Height="30" Margin="0,0,10,0" Background="#E0E0E0" Click="BtnCancel_Click"/>

            <Button Content="Lưu" Width="80" Height="30" Background="#1976D2" Foreground="White" Click="BtnSave_Click"/>

        </StackPanel>

    </Grid>

</Window>

