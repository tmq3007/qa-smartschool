<Page x:Class="QASmartClass.CounselingHub.Views.CounselingDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Thống kê Tư vấn Học đường" Background="#F4F6F8" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Thống kê hoạt động Tư vấn học đường" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
        
        <WrapPanel Grid.Row="1" Margin="0,10,0,20">
            <!-- Cards -->
            <Border Background="White" CornerRadius="8" Padding="15,20" Margin="0,0,15,15" Width="180" BorderBrush="#E0E6ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tổng Số Ca" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtTotal" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2980B9" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Background="White" CornerRadius="8" Padding="15,20" Margin="0,0,15,15" Width="180" BorderBrush="#E0E6ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Đang Chờ Xử Lý" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtPending" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E67E22" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Background="White" CornerRadius="8" Padding="15,20" Margin="0,0,15,15" Width="180" BorderBrush="#E0E6ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Đã Lên Lịch" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtScheduled" Text="0" FontSize="32" FontWeight="Bold" Foreground="#9B59B6" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15,20" Margin="0,0,15,15" Width="180" BorderBrush="#E0E6ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Đang Theo Dõi" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtInProgress" Text="0" FontSize="32" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Background="White" CornerRadius="8" Padding="15,20" Margin="0,0,15,15" Width="180" BorderBrush="#E0E6ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Đã Hoàn Thành" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtCompleted" Text="0" FontSize="32" FontWeight="Bold" Foreground="#27AE60" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Visual Issue Distribution Chart -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E0E6ED" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📊 Phân phối loại vấn đề tâm lý học đường" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcDistribution">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ProblemType}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding Percentage}" Maximum="100" Height="14" Foreground="{Binding BarColor}" Background="#F1F5F9" BorderThickness="0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2C3E50"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
