<Page x:Class="QASmartClass.CounselingHub.Views.CounselingSessionDetail"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Hồ sơ Phiên Tư vấn" Background="#F4F6F8">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        

        <TextBlock Text="Chi tiết Phiên Tư vấn Tâm lý" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E0E6ED" BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Thông tin Học sinh" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                    <TextBlock Text="Học sinh: " FontWeight="SemiBold"/>

                    <TextBlock x:Name="TxtStudentName" Text="Nguyễn Văn A"/>

                    <TextBlock Text=" - Lớp: " FontWeight="SemiBold" Margin="20,0,0,0"/>

                    <TextBlock x:Name="TxtClassName" Text="10A1"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Vấn đề: " FontWeight="SemiBold"/>

                    <TextBlock x:Name="TxtProblemType" Text="Áp lực điểm số" Foreground="#E74C3C"/>

                </StackPanel>

            </StackPanel>

        </Border>

        

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E0E6ED" BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                

                <TextBlock Text="Ghi chép chuyên môn (Bảo mật)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <TextBox x:Name="TxtNotes" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                

                <TextBlock Grid.Row="2" Text="Kế hoạch hành động / Giải pháp" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <TextBox x:Name="TxtSolution" Grid.Row="3" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            </Grid>

        </Border>

        

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

            <Button Content="Hủy bỏ" Width="100" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" BorderThickness="0" Click="BtnCancel_Click"/>

            <Button Content="Lưu Phiên" Width="100" Background="#27AE60" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>

        </StackPanel>

    </Grid>

</Page>



