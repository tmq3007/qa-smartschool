<Page x:Class="QASmartClass.CounselingHub.Views.CounselingRequestBoard"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Quản lý Yêu cầu Tư vấn" Background="#F4F6F8" Loaded="Page_Loaded">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="Danh sách Ca Tư vấn" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <Button Content="Tạo yêu cầu mới" Margin="20,0,0,0" Padding="12,6" Click="BtnCreate_Click" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
            <TextBlock Text="💡 Hướng dẫn: Nhấp đúp chuột vào một ca tư vấn để mở trang chi tiết ghi chép và hướng giải quyết." FontSize="13" Foreground="#7F8C8D" Margin="0,6,0,0" FontStyle="Italic"/>
        </StackPanel>

        

        <!-- Simplified DataGrid for list -->

        <DataGrid x:Name="DgRequests" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 

                  Background="White" BorderBrush="#E0E6ED" RowHeight="40" ColumnHeaderHeight="40"

                  MouseDoubleClick="DgRequests_MouseDoubleClick">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50"/>

                <DataGridTextColumn Header="Tên học sinh" Binding="{Binding StudentName}" Width="150"/>

                <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="100"/>

                <DataGridTextColumn Header="Phân loại" Binding="{Binding ProblemType}" Width="*"/>

                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/>

                <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAt, StringFormat=\{0:dd/MM/yyyy\}}" Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Page>



