<UserControl x:Class="QASmartClass.HomeroomHub.Views.ContactBookView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             mc:Ignorable="d" 

             d:DesignHeight="700" d:DesignWidth="1100" FontFamily="Segoe UI">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    </UserControl.Resources>

    

    <Grid Background="#F8F9FA">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header Bar -->

        <Grid Grid.Row="0" Margin="20,15,20,15">

            <StackPanel Orientation="Vertical">

                <TextBlock Text="SỔ LIÊN LẠC ĐIỆN TỬ" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>

                <TextBlock Text="{Binding HomeroomClass.DisplayName, StringFormat='Lớp: {0}'}" FontSize="14" Foreground="#7F8C8D" Margin="0,3,0,0"/>

            </StackPanel>

            

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,15,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>

                

                <Button Content="📥 Xuất PDF" Command="{Binding ExportPdfCommand}" Background="#3498DB" Foreground="White" Padding="15,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="5">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <Button Content="🗂️ Xuất Hàng Loạt" Command="{Binding ExportAllPdfCommand}" Background="#E67E22" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="5">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </StackPanel>

        </Grid>



        <!-- Main Workspace (Left Roster / Right SLL details) -->

        <Grid Grid.Row="1" Margin="20,0,20,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="320"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Student List -->

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10">

                <Border.Effect>

                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2"/>

                </Border.Effect>

                

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    

                    <TextBlock Grid.Row="0" Text="Danh sách học sinh" FontSize="16" FontWeight="Bold" Foreground="#34495E" Margin="5,5,5,10"/>

                    

                    <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" 

                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding" Value="0"/>

                                <Setter Property="Margin" Value="0,0,0,8"/>

                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10" BorderBrush="#EEEEEE" BorderThickness="1">

                                                <ContentPresenter/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsSelected" Value="True">

                                                    <Setter Property="Background" Value="#EBF5FB"/>

                                                    <Setter Property="BorderBrush" Value="#2980B9"/>

                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="#F8F9F9"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ListBox.ItemContainerStyle>

                        

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#34495E" Margin="0,0,10,0" VerticalAlignment="Center">

                                        <TextBlock Text="{Binding StudentName, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <!-- We can extract initials or just show avatar. Let's just put student's first character. -->

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text" Value="🎓"/>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                    

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                        <TextBlock Text="{Binding StudentName}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>

                                        <Grid Margin="0,3,0,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding AverageGrade, StringFormat='TB: {0:0.00}'}" FontSize="12" Foreground="#7F8C8D"/>

                                            <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Background="#2ECC71">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Conduct}" Value="Tốt">

                                                                <Setter Property="Background" Value="#2ECC71"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Conduct}" Value="Khá">

                                                                <Setter Property="Background" Value="#3498DB"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Conduct}" Value="Trung bình">

                                                                <Setter Property="Background" Value="#F1C40F"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Conduct}" Value="Yếu">

                                                                <Setter Property="Background" Value="#E74C3C"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <TextBlock Text="{Binding Conduct}" Foreground="White" FontSize="10" FontWeight="Bold"/>

                                            </Border>

                                        </Grid>

                                    </StackPanel>

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>



            <!-- Detailed Contact Book View -->

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20">

                <Border.Effect>

                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2"/>

                </Border.Effect>

                

                <Grid>

                    <Grid.Style>

                        <Style TargetType="Grid">

                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Grid.Style>

                    

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Student Summary Card -->

                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE" Padding="0,0,0,15" Margin="0,0,0,15">

                        <Grid>

                            <StackPanel>

                                <TextBlock Text="{Binding SelectedEntry.StudentName}" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>

                                <TextBlock Text="{Binding SelectedEntry.SchoolYear, StringFormat='Năm học: {0}'}" FontSize="13" Foreground="#7F8C8D" Margin="0,3,0,0"/>

                            </StackPanel>

                            

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                <Border Background="#16A085" CornerRadius="5" Padding="15,8" Margin="0,0,10,0">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Điểm TB: " Foreground="White" FontSize="14" VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding SelectedEntry.AverageGrade, StringFormat='{}{0:0.00}'}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>



                                <Border Background="#2980B9" CornerRadius="5" Padding="15,8">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Hạnh kiểm: " Foreground="White" FontSize="14" VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding SelectedEntry.Conduct}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- Core Metrics Row -->

                    <Grid Grid.Row="1" Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="15"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                        <!-- Absent Days -->

                        <Border Grid.Column="0" Background="#FADBD8" CornerRadius="8" Padding="15,10">

                            <StackPanel>

                                <TextBlock Text="Số ngày vắng mặt" FontSize="12" Foreground="#C0392B" FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding SelectedEntry.AbsentDays, StringFormat='{}{0} ngày'}" FontSize="24" FontWeight="Bold" Foreground="#962D22" Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>



                        <!-- Last Updated -->

                        <Border Grid.Column="2" Background="#FCF3CF" CornerRadius="8" Padding="15,10">

                            <StackPanel>

                                <TextBlock Text="Cập nhật lần cuối" FontSize="12" Foreground="#D35400" FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding SelectedEntry.UpdatedAt, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="20" FontWeight="Bold" Foreground="#A04000" Margin="0,7,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>



                    <!-- Interactive Teacher Comments & Feedback -->

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="ĐÁNH GIÁ VÀ NHẬN XÉT CỦA GIÁO VIÊN" FontSize="14" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,8"/>

                            

                            <TextBox Text="{Binding TeacherComment, UpdateSourceTrigger=PropertyChanged}" 

                                     TextWrapping="Wrap" AcceptsReturn="True" Height="120" Padding="10" FontSize="14"

                                     BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,10"/>

                            

                            <Button Content="Lưu nhận xét giáo viên" Command="{Binding SaveCommentCommand}" 

                                    HorizontalAlignment="Left" Background="#1ABC9C" Foreground="White" FontSize="14" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,0,25">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">

                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>



                            <TextBlock Text="Ý KIẾN PHẢN HỒI TỪ PHỤ HUYNH" FontSize="14" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,8"/>

                            

                            <Border BorderBrush="#EEEEEE" BorderThickness="1" Background="#F9F9F9" CornerRadius="4" Padding="15" MinHeight="80">

                                <TextBlock Text="{Binding SelectedEntry.ParentFeedback, TargetNullValue='Chưa có ý kiến phản hồi từ phụ huynh.', FallbackValue='Chưa có ý kiến phản hồi từ phụ huynh.'}" 

                                           TextWrapping="Wrap" FontSize="14" Foreground="#555555" FontStyle="Italic"/>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <!-- Loading Overlay -->

        <Grid Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="⏳ Đang xử lý PDF..." FontSize="18" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center"/>

                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,10,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>



