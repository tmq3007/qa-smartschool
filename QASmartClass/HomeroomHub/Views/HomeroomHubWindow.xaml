<Window x:Class="QASmartClass.HomeroomHub.Views.HomeroomHubWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:viewmodels="clr-namespace:QASmartClass.HomeroomHub.ViewModels"

        xmlns:local="clr-namespace:QASmartClass.HomeroomHub.Views"

        Title="Giáo Viên Chủ Nhiệm - QA SmartSchool" Height="768" Width="1366"

        WindowStartupLocation="CenterScreen"

        FontFamily="Segoe UI" Background="{DynamicResource AppBackground}">



    <Window.DataContext>

        <viewmodels:HomeroomHubViewModel />

    </Window.DataContext>



    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type viewmodels:HomeroomDashboardViewModel}">

            <local:HomeroomDashboardView />

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:HomeroomInboxViewModel}">

            <local:HomeroomInboxView />

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ContactBookViewModel}">

            <local:ContactBookView />

        </DataTemplate>



        <Style x:Key="SidebarBtnStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="20,15"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}">

                            <ContentPresenter Margin="{TemplateBinding Padding}" 

                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"

                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#1ABC9C"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <!-- Sidebar -->

        <Border Grid.Column="0" Background="#16A085">

            <StackPanel>

                <TextBlock Text="HOMEROOM PORTAL" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,30,20,30" />

                

                <Button Content="🏠 Dashboard Lớp" Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource SidebarBtnStyle}" />

                

                <Button Content="📒 Sổ Chủ Nhiệm" Tag="diary" Click="NavFeature_Click" Style="{StaticResource SidebarBtnStyle}" />

                

                <Button Content="📖 Sổ Liên Lạc" Command="{Binding NavigateToContactBookCommand}" Style="{StaticResource SidebarBtnStyle}" />

                

                <Button Content="📋 Điểm Danh Lớp" Tag="attendance" Click="NavFeature_Click" Style="{StaticResource SidebarBtnStyle}" />

                

                <Button Content="🏆 Thi Đua Lớp" Tag="emulation" Click="NavFeature_Click" Style="{StaticResource SidebarBtnStyle}" />

                

                <Button Content="📊 Thống Kê" Tag="stats" Click="NavFeature_Click" Style="{StaticResource SidebarBtnStyle}" />

                

                <Border Height="1" Background="#FFFFFF30" Margin="20,10"/>

                

                <Button Command="{Binding NavigateToInboxCommand}" Style="{StaticResource SidebarBtnStyle}">

                    <Button.Content>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="✉️ Hộp thư Phụ huynh"/>

                            <Border Grid.Column="1" Background="#E74C3C" CornerRadius="10" MinWidth="20" Padding="5,2" Margin="10,0,0,0"

                                    Visibility="{Binding UnreadMessagesCount, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <TextBlock Text="{Binding UnreadMessagesCount}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>

                            </Border>

                        </Grid>

                    </Button.Content>

                </Button>

            </StackPanel>

        </Border>



        <!-- Main Content -->

        <Border Grid.Column="1" Background="{DynamicResource AppBackground}" Padding="20">

            <ContentControl Content="{Binding CurrentViewModel}" />

        </Border>

    </Grid>

</Window>



