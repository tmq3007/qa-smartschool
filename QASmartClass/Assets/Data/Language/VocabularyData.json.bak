                "PoS": "noun",
                "ExEn": "",
                "Collocations": [],
                "ContextualExamples": {
                    "Đời thường": "I penciled (BrE: pencilled) a brief reminder in my notebook.\n(Tôi viết (BrE: pencilled) một lời nhắc nhở ngắn gọn vào sổ tay của mình.)",
                    "Trang trọng": "The words were scribbled in pencil\n(Những lời đã được viết nguệch ngoạc bằng bút chì)"
                }
            },
            {
                "En": "Book",
