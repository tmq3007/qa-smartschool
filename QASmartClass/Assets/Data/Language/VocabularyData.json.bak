        "Words": [
            {
                "En": "Hello",
                "Vi": "Xin chào",
                "Level": "A1",
                "IPA": "hə'ləʊ",
                "PoS": "interjection",
                "ExEn": "",
                "Collocations": [
                    "Say hello",
                    "A warm hello",
                    "Hello everyone"
