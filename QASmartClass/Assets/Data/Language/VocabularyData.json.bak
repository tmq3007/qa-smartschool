                "Level": "A1",
                "IPA": "'nəʊtbʊk",
                "PoS": "noun",
                "ExEn": ""
            },
            {
                "En": "Eraser",
                "Vi": "Cục tẩy",
                "Level": "A1",
                "IPA": "ɪ'reɪzər",
                "PoS": "noun",
