<Page x:Class="QASmartClass.HealthRoom.Views.FoodSafetyView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:QASmartClass.Converters"
      Title="Kiểm Thực 3 Bước" Background="#F8FAFC" FontFamily="Segoe UI">

    <Page.Resources>
        <conv:FoodSafetyResultConverter x:Key="FoodSafetyResultConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <TextBlock Text="🍱 Kiểm Thực 3 Bước &amp; VSATTP Canteen" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnAdd" Content="➕ Thêm Nhật ký Kiểm thực" Background="#10B981" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnAdd_Click" FontWeight="Bold"/>
                <Button x:Name="BtnRefresh" Content="🔄 Làm mới" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15,8" Cursor="Hand" Click="BtnRefresh_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- DataGrid -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>
            <DataGrid x:Name="DgRecords" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" HeadersVisibility="Column" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Thực đơn trong ngày" Binding="{Binding MenuItems}" Width="3*"/>
                    <DataGridCheckBoxColumn Header="Lưu mẫu 24h" Binding="{Binding SampleKept}" Width="100"/>
                    <DataGridTextColumn Header="Người kiểm tra" Binding="{Binding Inspector}" Width="150"/>
                    <DataGridTemplateColumn Header="Kết quả" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Result, Converter={StaticResource FoodSafetyResultConverter}}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="Fail">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Popup Overlay for Adding Food Safety Record -->
        <Grid x:Name="PopupAddRecord" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="20" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Thêm Nhật ký Kiểm thực" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="#1E293B"/>
                    
                    <!-- Guidance Box -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="📋 Chỉ dẫn Kiểm thực 3 Bước:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBlock Text="1. Kiểm tra nguyên liệu đầu vào trước khi chế biến." FontSize="10" Foreground="#475569" Margin="0,0,0,2" TextWrapping="Wrap"/>
                            <TextBlock Text="2. Kiểm tra vệ sinh trong quá trình chế biến." FontSize="10" Foreground="#475569" Margin="0,0,0,2" TextWrapping="Wrap"/>
                            <TextBlock Text="3. Lưu mẫu thực phẩm 24h &amp; ghi nhận kết quả." FontSize="10" Foreground="#475569" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Ngày kiểm thực:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DpRecordDate" Padding="8" Margin="0,0,0,10" Height="36"/>
                    
                    <TextBlock Text="Thực đơn trong ngày:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtMenuItems" Padding="8" Margin="0,0,0,10" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="#CBD5E1"/>
                    
                    <CheckBox x:Name="ChkSampleKept" Content="Lưu mẫu thực phẩm 24h" Margin="0,5,0,10" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    
                    <TextBlock Text="Người kiểm tra:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtInspector" Padding="8" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#CBD5E1"/>
                    
                    <TextBlock Text="Kết quả kiểm tra:" Margin="0,5,0,2" Foreground="#475569" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CbResult" Padding="8" Margin="0,0,0,15" Height="36">
                        <ComboBoxItem Content="Đạt chuẩn VSATTP" Tag="Pass" IsSelected="True"/>
                        <ComboBoxItem Content="Không đạt chuẩn" Tag="Fail"/>
                    </ComboBox>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Hủy" Grid.Column="0" Margin="0,0,5,0" Padding="10" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnCancelAddRecord_Click"/>
                        <Button Content="Lưu" Grid.Column="1" Margin="5,0,0,0" Padding="10" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSaveRecord_Click" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>



