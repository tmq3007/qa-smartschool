<UserControl x:Class="QASmartClass.HealthRoom.Views.MedicalInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QASmartClass.HealthRoom.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">

    <UserControl.Resources>
        <local:MedicalCategoryConverter x:Key="MedicalCategoryConverter"/>
        <local:QuantityAlertColorConverter x:Key="QuantityAlertColorConverter"/>
        <local:QuantityAlertWeightConverter x:Key="QuantityAlertWeightConverter"/>
        <local:ExpiryAlertColorConverter x:Key="ExpiryAlertColorConverter"/>
        <local:ExpiryAlertWeightConverter x:Key="ExpiryAlertWeightConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <TextBlock Text="Quản lý Kho thuốc &amp; Vật tư Y tế" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Theo dõi tồn kho, hạn sử dụng và cảnh báo thuốc sắp hết hạn." Foreground="Gray" Margin="0,0,0,20"/>



        <!-- Main Content -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="3*"/>

            </Grid.ColumnDefinitions>



            <!-- Form Nhập Thuốc -->

            <Border Grid.Column="0" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock Text="Nhập Vật Tư Mới" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                    

                    <TextBlock Text="Tên thuốc/vật tư:" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <TextBox x:Name="TxtName" Margin="0,0,0,10" Padding="5"/>



                    <TextBlock Text="Danh mục:" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <ComboBox x:Name="CmbCategory" Margin="0,0,0,10" Padding="5">
                        <ComboBoxItem Content="Thuốc" Tag="Medicine" IsSelected="True"/>
                        <ComboBoxItem Content="Sơ cứu" Tag="FirstAid"/>
                        <ComboBoxItem Content="Thiết bị" Tag="Equipment"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="65" Margin="0,0,10,0">
                            <TextBlock Text="Số lượng:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtQuantity" Padding="5"/>
                        </StackPanel>
                        <StackPanel Width="65" Margin="0,0,10,0">
                            <TextBlock Text="Đơn vị:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtUnit" Padding="5" Text="Hộp"/>
                        </StackPanel>
                        <StackPanel Width="80">
                            <TextBlock Text="Mức cảnh báo:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtMinAlertQty" Padding="5" Text="10" ToolTip="Cảnh báo tồn tối thiểu"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Hạn sử dụng:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpExpiryDate" Margin="0,0,0,15"/>

                    <Button Content="Thêm vào Kho" Background="#10B981" Foreground="White" Padding="10" Click="BtnAdd_Click" Cursor="Hand" FontWeight="Bold" BorderThickness="0"/>

                </StackPanel>

            </Border>



            <!-- Danh Sách Kho -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                    <Button Content="Tất cả Vật tư" Padding="10,5" Click="BtnLoadAll_Click" Cursor="Hand" Margin="0,0,10,0"/>

                    <Button Content="Cảnh báo Hết hạn (Sắp hết / Đã hết hạn)" Background="#DC3545" Foreground="White" Padding="10,5" Click="BtnLoadExpiring_Click" Cursor="Hand"/>

                </StackPanel>



                <ListView x:Name="LvInventory" Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1">

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header="Tên" DisplayMemberBinding="{Binding Name}" Width="150"/>

                            <GridViewColumn Header="Loại" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category, Converter={StaticResource MedicalCategoryConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Số lượng" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quantity}" FontWeight="{Binding Converter={StaticResource QuantityAlertWeightConverter}}" Foreground="{Binding Converter={StaticResource QuantityAlertColorConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Đơn vị" DisplayMemberBinding="{Binding Unit}" Width="60"/>

                            <GridViewColumn Header="Hạn sử dụng" Width="110">
                                 <GridViewColumn.CellTemplate>
                                     <DataTemplate>
                                         <TextBlock Text="{Binding ExpiryDate, StringFormat='dd/MM/yyyy'}" 
                                                    Foreground="{Binding ExpiryDate, Converter={StaticResource ExpiryAlertColorConverter}}" 
                                                    FontWeight="{Binding ExpiryDate, Converter={StaticResource ExpiryAlertWeightConverter}}"/>
                                     </DataTemplate>
                                 </GridViewColumn.CellTemplate>
                             </GridViewColumn>

                            <GridViewColumn Header="Hành động" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Xuất dùng" Padding="6,2" Click="BtnConsume_Click" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>

                    </ListView.View>

                </ListView>

            </Grid>

        </Grid>

    </Grid>

</UserControl>



