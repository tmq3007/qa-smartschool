<Window x:Class="QASmartClass.Shared.FloatingModeBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid Margin="6">
        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 1. TRẠNG THÁI MỞ RỘNG (EXPANDED MODE BAR)                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="pnlExpanded" CornerRadius="12"
                Background="#E8EAF6" BorderBrush="#5C6BC0" BorderThickness="1.5"
                Width="716" Height="50"
                Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" Color="#263238"/>
            </Border.Effect>

            <DockPanel Margin="4,2">
                <!-- Left Drag Handle Grip (Rộng 30px để ngón tay dễ chạm) -->
                <Border DockPanel.Dock="Left" Width="30" Cursor="SizeAll" Background="Transparent"
                        ToolTip="Kéo giữ để di chuyển thanh điều khiển"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseDown">
                    <TextBlock Text="⠿" FontSize="18" Foreground="#5C6BC0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Separator -->
                <Border DockPanel.Dock="Left" Width="1" Background="#C5CAE9" Margin="2,6"/>

                <!-- Right Drag Handle Grip -->
                <Border DockPanel.Dock="Right" Width="26" Cursor="SizeAll" Background="Transparent"
                        ToolTip="Kéo giữ để di chuyển thanh điều khiển"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseDown">
                    <TextBlock Text="⠿" FontSize="18" Foreground="#90A4AE" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Separator before quick tools -->
                <Border DockPanel.Dock="Right" Width="1" Background="#C5CAE9" Margin="3,6"/>

                <!-- Quick Tools (right side) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                    <!-- Show/Hide main window -->
                    <Border x:Name="btnShowHide" Width="34" Height="34" CornerRadius="8" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="OnShowHideClick"
                            PreviewTouchDown="OnShowHideTouchDown"
                            ToolTip="Hiển thị / Ẩn cửa sổ chính">
                        <TextBlock x:Name="txtShowHide" Text="🔲" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Voice broadcast -->
                    <Border x:Name="btnVoice" Width="34" Height="34" CornerRadius="8" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="OnVoiceClick"
                            PreviewTouchDown="OnVoiceTouchDown"
                            ToolTip="Bắt đầu / Ngừng phát giọng nói tới cả lớp">
                        <TextBlock x:Name="txtVoice" Text="🎤" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Pen annotation -->
                    <Border x:Name="btnPen" Width="34" Height="34" CornerRadius="8" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="OnPenClick"
                            PreviewTouchDown="OnPenTouchDown"
                            ToolTip="Mở bảng viết chú thích SMART TOUCH">
                        <TextBlock Text="✏️" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Screen recording -->
                    <Border x:Name="btnRecord" Width="34" Height="34" CornerRadius="8" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="OnRecordClick"
                            PreviewTouchDown="OnRecordTouchDown"
                            ToolTip="Ghi hình bài giảng &amp; hoạt động trình chiếu">
                        <TextBlock x:Name="txtRecord" Text="⏺️" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Screen broadcast + Quick Broadcast Menu (Split Pill) -->
                    <Border x:Name="bdrBroadcastGroup" Height="34" CornerRadius="8" Background="#DCE3F9"
                            BorderBrush="#9FA8DA" BorderThickness="1" Margin="2,0,3,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="btnBroadcast" MinWidth="36" Height="32" CornerRadius="7,0,0,7"
                                    Padding="7,0,5,0" Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="OnBroadcastClick"
                                    MouseRightButtonUp="OnBroadcastRightClick"
                                    PreviewTouchDown="OnBroadcastTouchDown"
                                    ToolTip="Chia sẻ màn hình &amp; Quảng bá bài giảng cho Học sinh (Chuột phải hoặc bấm ▾ để chọn chế độ)">
                                <TextBlock x:Name="txtBroadcast" Text="📺" FontSize="14" FontWeight="Bold"
                                           Foreground="#1E293B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="sepBroadcastSplit" Width="1" Margin="0,6" Background="#9FA8DA"/>
                            <Border x:Name="btnBroadcastMenu" Width="22" Height="32" CornerRadius="0,7,7,0"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="OnBroadcastMenuClick"
                                    PreviewTouchDown="OnBroadcastMenuTouchDown"
                                    ToolTip="Menu Quảng bá: Chọn màn hình/cửa sổ, Kéo vùng, Chiếu Bảng trắng, Mẫu HS, Thông báo, Mở Web">
                                <TextBlock x:Name="txtBroadcastCaret" Text="▾" FontSize="11" FontWeight="Bold"
                                           Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Collapse Button -->
                    <Border x:Name="btnCollapseBar" Width="32" Height="32" CornerRadius="8" Background="#C5CAE9" Cursor="Hand"
                            Margin="2,0,2,0"
                            MouseLeftButtonDown="OnCollapseClick"
                            PreviewTouchDown="btnCollapseBar_PreviewTouchDown"
                            ToolTip="Thu gọn thanh điều khiển">
                        <TextBlock Text="▼" FontSize="11" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Close/disconnect -->
                    <Border Width="34" Height="34" CornerRadius="8" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="OnCloseClick"
                            PreviewTouchDown="OnCloseTouchDown"
                            ToolTip="Thoát thanh công cụ">
                        <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#D32F2F" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </StackPanel>

                <!-- Separator -->
                <Border DockPanel.Dock="Right" Width="1" Background="#C5CAE9" Margin="3,6"/>

                <!-- Mode Buttons (left side, fills remaining space) -->
                <Grid Margin="2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 📚 Smart Class Button -->
                    <!-- [SMARTTOUCH_ONLY] Thêm Visibility="Collapsed" để ẩn nút SmartClass -->
                    <Border x:Name="btnClass" Grid.Column="0" CornerRadius="8,0,0,8" Margin="1"
                            Background="#1976D2" Cursor="Hand" MouseLeftButtonDown="OnClassClick">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📚 SMART CLASS" FontSize="10" FontWeight="Bold" 
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Quản lý lớp" FontSize="8" Foreground="#BBDEFB" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 🖊️ Smart Touch Button -->
                    <Border x:Name="btnScreen" Grid.Column="1" Margin="1"
                            Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnScreenClick">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🖊️ SMART TOUCH" FontSize="10" FontWeight="Bold" 
                                       Foreground="#37474F" HorizontalAlignment="Center"/>
                            <TextBlock Text="Bảng trắng" FontSize="8" Foreground="#78909C" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 🔲 Desktop Button -->
                    <!-- [SMARTTOUCH_ONLY] Thêm Visibility="Collapsed" để ẩn nút Desktop -->
                    <Border x:Name="btnDesktop" Grid.Column="2" CornerRadius="0,8,8,0" Margin="1"
                            Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnDesktopClick">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔲 DESKTOP" FontSize="10" FontWeight="Bold"
                                       Foreground="#37474F" HorizontalAlignment="Center"/>
                            <TextBlock Text="Windows" FontSize="8" Foreground="#78909C" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 2. TRẠNG THÁI THU GỌN (COLLAPSED MINI CAPSULE)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="pnlCollapsed"
                CornerRadius="20"
                Background="#E8EAF6" BorderBrush="#5C6BC0" BorderThickness="1.5"
                Height="44"
                Padding="4,2,4,2"
                Visibility="Collapsed"
                ToolTip="Nhấp để mở rộng thanh điều khiển">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#263238"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Vùng Grip kéo di chuyển riêng (Drag Handle) -->
                <Border Width="30" Height="38" Background="Transparent" Cursor="SizeAll"
                        ToolTip="Kéo giữ để di chuyển"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseDown">
                    <TextBlock Text="⠿" FontSize="18" Foreground="#5C6BC0" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Nút điều khiển nhanh Đang chiếu ngay khi thu gọn (Mini Live Pill) -->
                <Border x:Name="bdrMiniLiveBadge"
                        Visibility="Collapsed"
                        CornerRadius="10"
                        Background="#DC2626"
                        Padding="8,5"
                        Margin="0,0,4,0"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnMiniLiveBadgeClick"
                        PreviewTouchDown="OnMiniLiveBadgeTouchDown"
                        ToolTip="Đang chia sẻ màn hình — Nhấn để đổi nguồn / tạm dừng / dừng chiếu">
                    <TextBlock Text="🔴 LIVE" FontSize="10.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </Border>

                <!-- Vùng Nút bấm Mở rộng (Expand Button) - Diện tích to, chạm là mở ngay lập tức -->
                <Border x:Name="btnExpandModeBar"
                        Background="Transparent"
                        Padding="4,2"
                        CornerRadius="12"
                        Cursor="Hand"
                        MouseLeftButtonDown="btnExpandModeBar_MouseLeftButtonDown"
                        PreviewTouchDown="btnExpandModeBar_PreviewTouchDown"
                        ToolTip="Nhấn để mở rộng thanh điều khiển">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Badge chế độ hiện tại -->
                        <Border x:Name="bdrMiniModeBadge" CornerRadius="10" Background="#455A64" Padding="10,5" Margin="0,0,6,0">
                            <TextBlock x:Name="txtMiniModeName" Text="🔲 DESKTOP" FontSize="11" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- Icon mở rộng ▲ / ▼ -->
                        <Border Width="26" Height="26" CornerRadius="13" Background="#5C6BC0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtExpandArrow" Text="▲" FontSize="10" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
