<UserControl x:Class="QASmartClass.Shared.TransitionOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             IsHitTestVisible="True">

    <!-- 
    [LOI_VID_49] Transition Overlay — Hiển thị khi đang chuyển mode.
    - Che toàn màn hình, chặn touch input
    - Hiển thị Loading Spinner + tên mode đích
    - Nút "Hủy & Thử lại" xuất hiện sau 10s
    - Tuân thủ QC_4.2_LANGUAGE_BRANDING: SMART CLASS, SMART TOUCH, DESKTOP
    -->

    <Grid x:Name="OverlayRoot" Background="#CC1A1A2E">
        <!-- Semi-transparent dark background -->

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading Spinner -->
        <Viewbox Grid.Row="1" Width="64" Height="64" Margin="0,0,0,20">
            <Canvas Width="50" Height="50" x:Name="SpinnerCanvas">
                <Ellipse Width="50" Height="50" 
                         Stroke="#7C4DFF" StrokeThickness="4" 
                         StrokeDashArray="3 2" StrokeDashCap="Round"
                         x:Name="SpinnerEllipse">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="25" CenterY="25"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Viewbox>

        <!-- Status Text -->
        <TextBlock Grid.Row="2" x:Name="StatusText"
                   Text="Đang chuyển chế độ..."
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="White" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- Mode Name (giữ nguyên tiếng Anh theo QC_4.2_LANGUAGE_BRANDING) -->
        <TextBlock Grid.Row="3" x:Name="ModeNameText"
                   Text="SMART TOUCH"
                   FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24">
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7C4DFF" Offset="0"/>
                    <GradientStop Color="#448AFF" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>

        <!-- Timeout Cancel Button (xuất hiện sau 10s) -->
        <Button Grid.Row="3" x:Name="CancelButton"
                Content="⚠️ Hủy &amp; Thử lại"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                Margin="0,60,0,0"
                Padding="24,10"
                FontSize="14" FontWeight="SemiBold"
                Background="#FF5252" Foreground="White"
                BorderBrush="Transparent"
                Cursor="Hand"
                Click="OnCancelClick">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>
