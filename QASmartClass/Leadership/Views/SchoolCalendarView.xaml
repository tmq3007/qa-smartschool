<Page x:Class="QASmartClass.Leadership.Views.SchoolCalendarView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Lịch Công tác Trường học" Background="#F8FAFC" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">




    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <DockPanel Grid.Row="0" Margin="0,0,0,16">

            <TextBlock Text="📅 Lịch Công Tác Nhà Trường" FontSize="24" FontWeight="Bold"

                       Foreground="#0F172A" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="BtnPrev" Content="◀" Click="BtnPrev_Click"

                        FontSize="16" Padding="10,4" Background="#EFF6FF"

                        Foreground="#3B82F6" BorderThickness="0" Margin="0,0,4,0"/>

                <TextBlock x:Name="TxtWeekLabel" Text="..." FontSize="14"

                           FontWeight="SemiBold" Foreground="#334155"

                           VerticalAlignment="Center" Margin="8,0"/>

                <Button x:Name="BtnNext" Content="▶" Click="BtnNext_Click"

                        FontSize="16" Padding="10,4" Background="#EFF6FF"

                        Foreground="#3B82F6" BorderThickness="0" Margin="4,0,12,0"/>

                <Button x:Name="BtnToday" Content="Hôm nay" Click="BtnToday_Click"

                        FontSize="13" Padding="12,6" Background="#3B82F6"

                        Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>

                <Button x:Name="BtnAdd" Content="＋ Thêm sự kiện" Click="BtnAdd_Click"

                        FontSize="13" Padding="12,6" Background="#10B981"

                        Foreground="White" BorderThickness="0"/>

            </StackPanel>

        </DockPanel>



        <!-- Column Headers (T2-CN) -->

        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">

            <TextBlock Text="Thứ 2" FontWeight="SemiBold" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>

            <TextBlock Text="Thứ 3" FontWeight="SemiBold" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>

            <TextBlock Text="Thứ 4" FontWeight="SemiBold" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>

            <TextBlock Text="Thứ 5" FontWeight="SemiBold" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>

            <TextBlock Text="Thứ 6" FontWeight="SemiBold" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>

            <TextBlock Text="Thứ 7" FontWeight="SemiBold" FontSize="13" Foreground="#F59E0B" HorizontalAlignment="Center"/>

            <TextBlock Text="CN"     FontWeight="SemiBold" FontSize="13" Foreground="#EF4444" HorizontalAlignment="Center"/>

        </UniformGrid>



        <!-- 7-column Calendar Grid -->

        <UniformGrid x:Name="CalendarGrid" Grid.Row="2" Columns="7" Margin="0"/>



    </Grid>


    </ScrollViewer>
</Page>



