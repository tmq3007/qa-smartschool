<UserControl x:Class="QASmartClass.Leadership.Views.ApprovalQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1000">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Danh sách bài giảng chờ duyệt -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Danh Sách Phê Duyệt Bài Giảng" FontSize="20" FontWeight="Bold" Foreground="#1A1A2E" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bộ lọc & Tìm kiếm nhanh -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tìm kiếm nhanh (Giáo viên, Lớp, Bài giảng):" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,4" FontSize="13" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Môn học:" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
                        <ComboBox SelectedItem="{Binding SelectedSubject}" ItemsSource="{Binding Subjects}" Height="32" Padding="5" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="🔄 Làm Mới" Command="{Binding LoadPendingLessonsCommand}" Height="32" Padding="15,0" Margin="0,15,0,0" Cursor="Hand" FontWeight="Bold" Background="#F0F4F8" BorderBrush="#D0D4D8"/>
                </Grid>

                <!-- Danh sách chính -->
                <ListView Grid.Row="2" ItemsSource="{Binding PendingLessons}" SelectedItem="{Binding SelectedLesson}" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tính chất" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtType" Text="Tiêu chuẩn" Foreground="#757575" FontSize="11" VerticalAlignment="Center"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEmergency}" Value="True">
                                                <Setter TargetName="txtType" Property="Text" Value="⚠️ KHẨN CẤP"/>
                                                <Setter TargetName="txtType" Property="Foreground" Value="#C62828"/>
                                                <Setter TargetName="txtType" Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ngày Trình" DisplayMemberBinding="{Binding UpdatedAt, StringFormat='dd/MM HH:mm'}" Width="110"/>
                            <GridViewColumn Header="Giáo Viên" DisplayMemberBinding="{Binding TeacherName}" Width="130"/>
                            <GridViewColumn Header="Lớp" DisplayMemberBinding="{Binding ClassName}" Width="70"/>
                            <GridViewColumn Header="Môn" DisplayMemberBinding="{Binding Subject}" Width="90"/>
                            <GridViewColumn Header="Tên Bài Giảng" DisplayMemberBinding="{Binding Title}" Width="220"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Chi tiết xử lý phê duyệt (Form bên phải) -->
        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel IsEnabled="{Binding SelectedLesson, Converter={x:Null}}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedLesson}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Xử Lý Phê Duyệt" FontSize="20" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,20"/>

                <TextBlock Text="{Binding SelectedLesson.Title}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SelectedLesson.TeacherName, StringFormat='Giáo viên: {0}'}" Foreground="#555" Margin="0,0,0,5" FontSize="13"/>
                <TextBlock Foreground="#555" Margin="0,0,0,20" FontSize="13">
                    <Run Text="Lớp: "/>
                    <Run Text="{Binding SelectedLesson.ClassName, Mode=OneWay}"/>
                    <Run Text=" | Môn: "/>
                    <Run Text="{Binding SelectedLesson.Subject, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Text="Ghi chú / Nhận xét / Lý do từ chối:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ReviewNotes, UpdateSourceTrigger=PropertyChanged}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,15" FontSize="13" VerticalContentAlignment="Top"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E88E5" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,15" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <Button Content="PHÊ DUYỆT" Command="{Binding ApproveLessonCommand}" 
                            Background="#43A047" Foreground="White" FontWeight="Bold" Padding="10,12" Width="120" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="TỪ CHỐI (SỬA)" Command="{Binding RejectLessonCommand}" 
                            Background="#E53935" Foreground="White" FontWeight="Bold" Padding="10,12" Width="120" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
