<Page x:Class="QASmartClass.Leadership.Views.PrincipalDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tổng quan Số liệu Nhà trường" FontFamily="Segoe UI" Background="#F8FAFC">

    <Page.Resources>
        <Style x:Key="ClickableKpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>



    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <!-- 💡 Hướng dẫn sử dụng sư phạm (SP-04) -->
            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Hướng dẫn nhanh: Nhấp vào các thẻ chỉ số bên dưới (Điểm danh hôm nay, Giáo án tuần này, Tuân thủ TKB) để xem báo cáo chi tiết. Sử dụng các nút Dự giờ, Lịch công tác để chuyển nghiệp vụ." FontSize="13" Foreground="#0369A1" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,0,0,25">

                <TextBlock Text="📊 Dashboard Ban Giám Hiệu" FontSize="28" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                <Button x:Name="BtnRefresh" Content="🔄 Làm mới" Height="35" Background="#3B82F6" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Padding="15,0" Margin="15,0,0,0" Cursor="Hand" Click="BtnRefresh_Click" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">

                    <Button x:Name="BtnObservation" Content="📝 Dự giờ" Click="BtnObservation_Click" 

                            Padding="14,8" FontSize="13" Background="#10B981" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>

                    <Button x:Name="BtnCalendar" Content="📅 Lịch công tác" Click="BtnOpenCalendar_Click" 

                            Padding="14,8" FontSize="13" Background="#8B5CF6" Foreground="White" BorderThickness="0"/>

                </StackPanel>

            </DockPanel>





            <!-- KPI Cards -->
            <UniformGrid Columns="5" Margin="0,0,0,25">

                <!-- 1. Tổng học sinh -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🎓" FontSize="28"/>
                        <TextBlock x:Name="TxtTotalStudents" Text="---" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" Margin="0,5,0,0"/>
                        <TextBlock Text="Tổng Học sinh" FontSize="14" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. Tổng giáo viên -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="👨‍🏫" FontSize="28"/>
                        <TextBlock x:Name="TxtTotalTeachers" Text="---" FontSize="32" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        <TextBlock Text="Tổng Giáo viên" FontSize="14" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. Tỷ lệ điểm danh -->
                <Border Style="{StaticResource ClickableKpiCardStyle}" Cursor="Hand" MouseLeftButtonDown="DrillDown_Attendance" ToolTip="Click để xem chi tiết học sinh vắng hôm nay">
                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="28"/>
                        <TextBlock x:Name="TxtAttendanceRate" Text="---" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                        <TextBlock Text="Tỷ lệ Điểm danh hôm nay" FontSize="14" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 4. Giáo án tuần này -->
                <Border Style="{StaticResource ClickableKpiCardStyle}" Cursor="Hand" MouseLeftButtonDown="DrillDown_Lessons" ToolTip="Click để xem danh sách giáo án soạn trong tuần">
                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📝" FontSize="28"/>
                        <TextBlock x:Name="TxtLessonsWeek" Text="---" FontSize="32" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,5,0,0"/>
                        <TextBlock Text="Giáo án tuần này" FontSize="14" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 5. Tuân thủ TKB -->
                <Border Style="{StaticResource ClickableKpiCardStyle}" Margin="0" Cursor="Hand" MouseLeftButtonDown="DrillDown_TkbCompliance" ToolTip="Click để xem danh sách giáo viên vi phạm TKB">
                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📆" FontSize="28"/>
                        <TextBlock x:Name="TxtTkbCompliance" Text="---" FontSize="32" FontWeight="Bold" Foreground="#EF4444" Margin="0,5,0,0"/>
                        <TextBlock Text="Tuân thủ TKB tháng này" FontSize="14" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </UniformGrid>



            <!-- Bottom panels -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>



                <!-- Thi đua rút gọn -->

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0">

                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="🏆 Top Thi Đua Lớp" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                        <ListView x:Name="LvTopClasses" BorderThickness="0" Background="Transparent">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="0,0,0,6">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="35"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding RankIcon}" FontSize="18" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding ClassName}" FontSize="15" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding ScoreDisplay}" FontSize="14" Foreground="#3B82F6" FontWeight="Bold" VerticalAlignment="Center"/>

                                    </Grid>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>

                </Border>



                <!-- Thông báo gần đây -->

                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">

                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="📢 Thông Báo Gần Đây" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                        <ListView x:Name="LvRecentBulletins" BorderThickness="0" Background="Transparent">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel Margin="0,0,0,8">

                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>

                                        <TextBlock Text="{Binding DateStr}" FontSize="12" Foreground="#94A3B8"/>

                                    </StackPanel>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ═══ SMART ANALYTICS SECTION (P1-08) ═══ -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,20,0,0">

                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

                <StackPanel>

                    <DockPanel Margin="0,0,0,16">

                        <TextBlock Text="🧠 Phân Tích Thông Minh — 6 Tháng Gần Nhất"

                                   FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>

                        <Button x:Name="BtnRefreshAnalytics" Content="🔄" HorizontalAlignment="Right"

                                Click="BtnRefreshAnalytics_Click" Padding="10,4" FontSize="13"

                                Background="#EFF6FF" Foreground="#3B82F6" BorderThickness="0"/>

                    </DockPanel>



                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="2*"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                        <!-- Biểu đồ xu hướng điểm 6 tháng -->

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">

                            <TextBlock Text="📈 Xu hướng điểm TB toàn trường" FontSize="14"

                                       Foreground="#64748B" Margin="0,0,0,10"/>

                            <ItemsControl x:Name="IcMonthlyTrend">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,0,8">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="55"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="50"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding MonthLabel}" FontSize="12"

                                                       Foreground="#64748B" VerticalAlignment="Center"/>

                                            <Border Grid.Column="1" Height="18" CornerRadius="4"

                                                    Background="#EFF6FF" VerticalAlignment="Center" Margin="4,0">

                                                <Rectangle Height="18" Fill="{Binding BarColor}"

                                                           Width="{Binding BarWidth}"

                                                           HorizontalAlignment="Left" RadiusX="4" RadiusY="4"/>

                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding AvgDisplay}"

                                                       FontSize="12" FontWeight="Bold"

                                                       Foreground="{Binding BarColor}"

                                                       VerticalAlignment="Center"/>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>



                        <!-- Panel phải: Môn yếu nhất + HS nguy cơ -->

                        <StackPanel Grid.Column="1">

                            <!-- Môn học yếu nhất -->

                            <Border Background="#FFF7ED" CornerRadius="8" Padding="14" Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="⚠️ Môn yếu nhất toàn trường"

                                               FontSize="13" Foreground="#92400E" FontWeight="SemiBold"/>

                                    <TextBlock x:Name="TxtWeakestSubject" Text="---"

                                               FontSize="20" FontWeight="Bold" Foreground="#D97706"

                                               Margin="0,6,0,2"/>

                                    <TextBlock x:Name="TxtWeakestAvg" Text="TB: ---"

                                               FontSize="12" Foreground="#92400E"/>

                                </StackPanel>

                            </Border>



                            <!-- Top HS nguy cơ -->

                            <Border Background="#FEF2F2" CornerRadius="8" Padding="14">

                                <StackPanel>

                                    <TextBlock Text="🚨 HS nguy cơ cần can thiệp"

                                               FontSize="13" Foreground="#991B1B" FontWeight="SemiBold"

                                               Margin="0,0,0,8"/>

                                    <ListBox x:Name="LstAtRisk" BorderThickness="0"

                                             Background="Transparent" MaxHeight="150" FontSize="12">

                                        <ListBox.ItemContainerStyle>

                                            <Style TargetType="ListBoxItem">

                                                <Setter Property="Padding" Value="0,3"/>

                                                <Setter Property="Background" Value="Transparent"/>

                                            </Style>

                                        </ListBox.ItemContainerStyle>

                                    </ListBox>

                                    <TextBlock x:Name="TxtNoRisk" Text="✅ Không có HS nguy cơ"

                                               FontSize="12" Foreground="#16A34A" Visibility="Collapsed"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Border>



        </StackPanel>

    </ScrollViewer>

</Page>





