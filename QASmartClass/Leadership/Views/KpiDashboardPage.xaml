<Page x:Class="QASmartClass.Leadership.Views.KpiDashboardPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

      xmlns:oxy="http://oxyplot.org/wpf"

      mc:Ignorable="d" 

      d:DesignHeight="720" d:DesignWidth="1280"

      Title="Chỉ số KPI và So sánh Hiệu năng" FontFamily="Segoe UI" Background="#F8FAFC">



    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- HEADER -->

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">

            <Border.Effect>

                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>

            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="📈 Dashboard KPI Toàn Trường" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>

                <TextBlock Text=" (Dữ liệu thời gian thực)" FontSize="16" Foreground="#64748B" VerticalAlignment="Bottom" Margin="10,0,0,3"/>

            </StackPanel>

        </Border>



        <!-- 4 KPI CARDS -->

        <Grid Grid.Row="1" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Card 1: Sĩ số -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="👨‍🎓" FontSize="24" Margin="0,0,10,0"/>

                        <TextBlock Text="Tổng Sĩ số" FontSize="16" Foreground="#64748B" VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock x:Name="TxtTotalStudents" Text="---" FontSize="36" FontWeight="Bold" Foreground="#1E293B"/>

                </StackPanel>

            </Border>



            <!-- Card 2: Chuyên cần -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5,0,5,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="✅" FontSize="24" Margin="0,0,10,0"/>

                        <TextBlock Text="Tỷ lệ Chuyên cần" FontSize="16" Foreground="#64748B" VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock x:Name="TxtAttendanceRate" Text="---" FontSize="36" FontWeight="Bold" Foreground="#10B981"/>

                </StackPanel>

            </Border>



            <!-- Card 3: Điểm TB -->

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5,0,5,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="📊" FontSize="24" Margin="0,0,10,0"/>

                        <TextBlock Text="Điểm Trung bình" FontSize="16" Foreground="#64748B" VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock x:Name="TxtAvgScore" Text="---" FontSize="36" FontWeight="Bold" Foreground="#3B82F6"/>

                </StackPanel>

            </Border>



            <!-- Card 4: Hoàn thành Task -->

            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="📋" FontSize="24" Margin="0,0,10,0"/>

                        <TextBlock Text="Hoàn thành Nhiệm vụ" FontSize="16" Foreground="#64748B" VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock x:Name="TxtTaskRate" Text="---" FontSize="36" FontWeight="Bold" Foreground="#F59E0B"/>

                </StackPanel>

            </Border>

        </Grid>



        <!-- BOTTOM SECTION -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>



            <!-- COMPARATIVE ANALYTICS PANEL (WI-08) -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    

                    <DockPanel Grid.Row="0" Margin="0,0,0,15">

                        <TextBlock Text="⚖️ So Sánh Hiệu Năng Giữa Các Học Kỳ" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            <TextBlock Text="Năm học: " VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,5,0"/>

                            <ComboBox x:Name="CboSchoolYear" Width="120" Height="28" Margin="0,0,15,0" SelectedIndex="0" SelectionChanged="CompareSemesters_SelectionChanged">

                                <ComboBoxItem Content="2025-2026"/>

                                <ComboBoxItem Content="2024-2025"/>

                            </ComboBox>

                            <Button Content="🔄 So sánh" Click="BtnCompare_Click" Padding="10,4" FontSize="12" Background="#3B82F6" Foreground="White" BorderThickness="0"/>

                        </StackPanel>

                    </DockPanel>



                    <!-- Comparison Summary Row -->

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15">

                        <!-- Học tập -->

                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">

                            <StackPanel>

                                <TextBlock Text="📚 Kết quả Học tập" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>

                                <Grid Margin="0,5,0,0">

                                    <StackPanel>

                                        <TextBlock x:Name="TxtCompareScore" Text="-- / --" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>

                                        <TextBlock Text="Học kỳ 1 / Học kỳ 2" FontSize="11" Foreground="#64748B"/>

                                    </StackPanel>

                                    <TextBlock x:Name="TxtTrendScore" Text="--" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- Chuyên cần -->

                        <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="4,0,4,0">

                            <StackPanel>

                                <TextBlock Text="✅ Chuyên Cần" FontSize="13" FontWeight="SemiBold" Foreground="#065F46"/>

                                <Grid Margin="0,5,0,0">

                                    <StackPanel>

                                        <TextBlock x:Name="TxtCompareAttendance" Text="-- / --" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>

                                        <TextBlock Text="Học kỳ 1 / Học kỳ 2" FontSize="11" Foreground="#64748B"/>

                                    </StackPanel>

                                    <TextBlock x:Name="TxtTrendAttendance" Text="--" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- Thi đua -->

                        <Border Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="8,0,0,0">

                            <StackPanel>

                                <TextBlock Text="🏆 Rèn Luyện / Thi Đua" FontSize="13" FontWeight="SemiBold" Foreground="#92400E"/>

                                <Grid Margin="0,5,0,0">

                                    <StackPanel>

                                        <TextBlock x:Name="TxtCompareConduct" Text="-- / --" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>

                                        <TextBlock Text="Học kỳ 1 / Học kỳ 2" FontSize="11" Foreground="#64748B"/>

                                    </StackPanel>

                                    <TextBlock x:Name="TxtTrendConduct" Text="--" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </UniformGrid>



                    <!-- Comparison Details and Charts -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="1.2*"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                        <!-- Comparison Details Table/List -->

                        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>

                                <!-- Headers -->

                                <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="2*"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Chỉ số hiệu năng" FontWeight="SemiBold" Foreground="#475569" FontSize="12"/>

                                        <TextBlock Grid.Column="1" Text="Học kỳ 1" FontWeight="SemiBold" Foreground="#475569" FontSize="12" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="2" Text="Học kỳ 2" FontWeight="SemiBold" Foreground="#475569" FontSize="12" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="3" Text="Biến động (Delta)" FontWeight="SemiBold" Foreground="#475569" FontSize="12" HorizontalAlignment="Right"/>

                                    </Grid>

                                </Border>

                                

                                <!-- Rows -->

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                    <StackPanel Margin="10">

                                        <!-- Row 1 -->

                                        <Grid Margin="0,5,0,5">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="2*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Điểm trung bình học sinh" FontSize="13" Foreground="#334155"/>

                                            <TextBlock Grid.Column="1" x:Name="TxtScore1" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="2" x:Name="TxtScore2" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="3" x:Name="TxtScoreDelta" Text="--" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Separator Background="#F1F5F9" Margin="0,5"/>

                                        

                                        <!-- Row 2 -->

                                        <Grid Margin="0,5,0,5">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="2*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Tỷ lệ đạt (>=5.0)" FontSize="13" Foreground="#334155"/>

                                            <TextBlock Grid.Column="1" x:Name="TxtPassRate1" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="2" x:Name="TxtPassRate2" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="3" x:Name="TxtPassRateDelta" Text="--" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Separator Background="#F1F5F9" Margin="0,5"/>



                                        <!-- Row 3 -->

                                        <Grid Margin="0,5,0,5">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="2*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Tỷ lệ chuyên cần học sinh" FontSize="13" Foreground="#334155"/>

                                            <TextBlock Grid.Column="1" x:Name="TxtAtt1" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="2" x:Name="TxtAtt2" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="3" x:Name="TxtAttDelta" Text="--" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Separator Background="#F1F5F9" Margin="0,5"/>



                                        <!-- Row 4 -->

                                        <Grid Margin="0,5,0,5">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="2*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Số học sinh được khen thưởng" FontSize="13" Foreground="#334155"/>

                                            <TextBlock Grid.Column="1" x:Name="TxtCommendation1" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="2" x:Name="TxtCommendation2" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="3" x:Name="TxtCommendationDelta" Text="--" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Separator Background="#F1F5F9" Margin="0,5"/>



                                        <!-- Row 5 -->

                                        <Grid Margin="0,5,0,5">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="2*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Số trường hợp kỷ luật học sinh" FontSize="13" Foreground="#334155"/>

                                            <TextBlock Grid.Column="1" x:Name="TxtDiscipline1" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="2" x:Name="TxtDiscipline2" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="3" x:Name="TxtDisciplineDelta" Text="--" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                                        </Grid>

                                    </StackPanel>

                                </ScrollViewer>

                            </Grid>

                        </Border>



                        <!-- OxyPlot Overlay Charts TabControl -->

                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White" Padding="10">

                            <TabControl Background="Transparent" BorderThickness="0">

                                <TabItem Header="Học Lực (Xếp Loại %)" FontSize="12">

                                    <oxy:PlotView x:Name="ChartAcademic" Background="Transparent"/>

                                </TabItem>

                                <TabItem Header="Chuyên Cần &amp; Đạt (%)" FontSize="12">

                                    <oxy:PlotView x:Name="ChartKpi" Background="Transparent"/>

                                </TabItem>

                            </TabControl>

                        </Border>

                    </Grid>

                </Grid>

            </Border>



            <!-- LEADERBOARD -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🏆 Đơn vị dẫn đầu Thi đua" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <TextBlock Text="🥇" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock x:Name="TxtEmulationLeader" Text="---" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>

                        <TextBlock Text="Điểm thi đua cao nhất khối chuyên môn" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>



