<Page x:Class="QASmartClass.Leadership.Views.ReportExportPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

      mc:Ignorable="d" 

      d:DesignHeight="720" d:DesignWidth="1280"

      Title="Xuất Báo cáo Kết quả Học tập" FontFamily="Segoe UI" Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">




    <Grid Margin="40">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0" Text="🖨️ Xuất Báo Cáo &amp; Thống Kê" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,30"/>



        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="40" HorizontalAlignment="Stretch" MaxWidth="800" VerticalAlignment="Top">

            <Border.Effect>

                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05"/>

            </Border.Effect>

            <StackPanel>

                <!-- Chọn Mẫu báo cáo -->

                <TextBlock Text="1. Chọn mẫu báo cáo:" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>

                <ComboBox x:Name="CbReportType" Height="45" FontSize="16" Padding="10,5" Margin="0,0,0,25">

                    <ComboBoxItem Content="Báo cáo Tổng hợp (Chuyên môn &amp; Kỷ luật)" Tag="General" IsSelected="True"/>

                    <ComboBoxItem Content="Báo cáo Thi đua các Tổ chuyên môn" Tag="Emulation"/>

                    <ComboBoxItem Content="Báo cáo Hiệu suất công việc (Task Hub)" Tag="TaskPerf"/>

                    <ComboBoxItem Content="Báo cáo Kết quả Đánh giá 360°" Tag="Eval360"/>

                    <!-- WI-11: MOET Forms -->

                    <ComboBoxItem Content="📋 Biểu mẫu MOET — Mẫu 20-THCS (Sĩ số)" Tag="MOET_20"/>

                    <ComboBoxItem Content="📋 Biểu mẫu MOET — Mẫu 22-THCS (Học lực &amp; Hạnh kiểm)" Tag="MOET_22"/>

                    <ComboBoxItem Content="📋 Biểu mẫu MOET — Tổng kết GV &amp; HS" Tag="MOET_Summary"/>

                </ComboBox>



                <!-- Chọn Thời gian -->

                <TextBlock Text="2. Chọn khoảng thời gian:" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,25">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="20"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Từ ngày:" FontSize="14" Foreground="#64748B" Margin="0,0,0,5"/>

                        <DatePicker x:Name="DpStartDate" Height="40" FontSize="16"/>

                    </StackPanel>

                    

                    <TextBlock Grid.Column="1" Text="-" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Foreground="#94A3B8"/>

                    

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Đến ngày:" FontSize="14" Foreground="#64748B" Margin="0,0,0,5"/>

                        <DatePicker x:Name="DpEndDate" Height="40" FontSize="16"/>

                    </StackPanel>

                </Grid>



                <!-- Chọn Định dạng -->

                <TextBlock Text="3. Định dạng xuất:" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">

                    <RadioButton x:Name="RbFormatPdf" Content="📄 PDF Document (.pdf)" FontSize="16" IsChecked="True" GroupName="FormatGroup" Margin="0,0,30,0"/>

                    <RadioButton x:Name="RbFormatExcel" Content="📊 Excel Spreadsheet (.xlsx)" FontSize="16" GroupName="FormatGroup"/>

                </StackPanel>



                <!-- Action Buttons -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    

                    <Button Grid.Column="0" x:Name="BtnPreview" Content="👁️ Xem trước (Preview)" Height="50" Margin="0,0,10,0" Background="#E0F2FE" Foreground="#0369A1" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="BtnPreview_Click" Cursor="Hand"/>

                    

                    <Button Grid.Column="1" x:Name="BtnExport" Content="⬇️ Xuất Báo Cáo" Height="50" Margin="10,0,0,0" Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="BtnExport_Click" Cursor="Hand"/>

                </Grid>



                <!-- Status Text -->

                <TextBlock x:Name="TxtStatus" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

            </StackPanel>

        </Border>

    </Grid>


    </ScrollViewer>
</Page>



