<Page x:Class="QASmartClass.Leadership.Views.ClassObservationView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Dự giờ Đánh giá Giáo viên" Background="#F8FAFC" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">


    <Grid Margin="20">

        <TabControl x:Name="MainTab" Background="Transparent" BorderThickness="0">

            <TabControl.Resources>

                <Style TargetType="TabItem">

                    <Setter Property="FontFamily" Value="Segoe UI"/>

                    <Setter Property="FontSize" Value="14"/>

                    <Setter Property="Padding" Value="14,8"/>

                </Style>

            </TabControl.Resources>



            <!-- TAB 1: Phiếu dự giờ (WI-14 rubric) -->

            <TabItem Header="📝 Phiếu dự giờ">

                <Grid Margin="0,10,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">

                        <TextBlock Text="📝 Phiếu Dự Giờ Đánh Giá (CV 5555)" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>

                        <Button x:Name="BtnAdd" Content="＋ Tạo phiếu" Click="BtnAdd_Click"

                                DockPanel.Dock="Right" HorizontalAlignment="Right"

                                FontSize="13" Padding="12,6" Background="#3B82F6" Foreground="White" BorderThickness="0"/>

                    </DockPanel>

                    <ListView Grid.Row="1" x:Name="LvObs" BorderThickness="0" Background="Transparent">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,10"

                                        BorderBrush="#E2E8F0" BorderThickness="1">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>

                                            <TextBlock Text="{Binding Info}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"

                                                       TextTrimming="CharacterEllipsis" MaxHeight="20"/>

                                            <TextBlock Text="{Binding RecommendText}" FontSize="11" Foreground="#7C3AED" Margin="0,2,0,0"

                                                       TextTrimming="CharacterEllipsis" MaxHeight="20"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,4" Margin="0,0,4,0" ToolTip="KHBD: Kế hoạch Bài dạy (Chuẩn bị bài dạy)">

                                                <TextBlock Text="{Binding ScoreLP}" FontSize="11" Foreground="#3B82F6" FontWeight="Bold"/>

                                            </Border>

                                            <Border Background="#F0FDF4" CornerRadius="4" Padding="6,4" Margin="0,0,4,0" ToolTip="TCH: Tổ chức hoạt động dạy học (Tiến trình dạy học)">

                                                <TextBlock Text="{Binding ScoreDL}" FontSize="11" Foreground="#16A34A" FontWeight="Bold"/>

                                            </Border>

                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,4" Margin="0,0,4,0" ToolTip="HHS: Hoạt động học tập của Học sinh (Sự tích cực)">

                                                <TextBlock Text="{Binding ScoreSE}" FontSize="11" Foreground="#CA8A04" FontWeight="Bold"/>

                                            </Border>

                                            <Border Background="#FCE7F3" CornerRadius="4" Padding="6,4" Margin="0,0,4,0" ToolTip="HTGV: Hỗ trợ, hướng dẫn của Giáo viên">

                                                <TextBlock Text="{Binding ScoreTS}" FontSize="11" Foreground="#DB2777" FontWeight="Bold"/>

                                            </Border>

                                            <Border Background="#E0E7FF" CornerRadius="4" Padding="6,4" Margin="0,0,4,0" ToolTip="KTG: Kiểm tra, đánh giá trong tiết dạy">

                                                <TextBlock Text="{Binding ScoreAS}" FontSize="11" Foreground="#4F46E5" FontWeight="Bold"/>

                                            </Border>

                                            <Border Background="{Binding RatingBg}" CornerRadius="4" Padding="8,4" Margin="4,0,0,0">

                                                <TextBlock Text="{Binding RatingText}" FontSize="12" Foreground="{Binding RatingFg}" FontWeight="Bold"/>

                                            </Border>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </TabItem>



            <!-- TAB 2: Lịch dự giờ (WI-12) -->

            <TabItem Header="📅 Lịch dự giờ">

                <Grid Margin="0,10,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <!-- Header bar -->

                    <DockPanel Margin="0,0,0,10">

                        <TextBlock Text="📅 Lịch Dự Giờ Tổ Chuyên Môn" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>

                        <Button x:Name="BtnAddSchedule" Content="＋ Tạo lịch" Click="BtnAddSchedule_Click"

                                DockPanel.Dock="Right" HorizontalAlignment="Right"

                                FontSize="13" Padding="12,6" Background="#10B981" Foreground="White" BorderThickness="0"/>

                    </DockPanel>



                    <!-- Filter bar -->

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="Tổ CM:" VerticalAlignment="Center" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>

                        <ComboBox x:Name="CbDeptFilter" Width="200" FontSize="13" SelectionChanged="CbDeptFilter_Changed"/>

                        <Button x:Name="BtnPrevMonth" Content="◀" Click="BtnPrevMonth_Click" Margin="20,0,4,0"

                                FontSize="13" Padding="8,4" Background="White" BorderBrush="#E2E8F0"/>

                        <TextBlock x:Name="TxtCurrentMonth" Text="" FontSize="15" FontWeight="SemiBold"

                                   VerticalAlignment="Center" Foreground="#1E293B" Margin="4,0,4,0"/>

                        <Button x:Name="BtnNextMonth" Content="▶" Click="BtnNextMonth_Click"

                                FontSize="13" Padding="8,4" Background="White" BorderBrush="#E2E8F0"/>

                    </StackPanel>



                    <!-- Schedule list -->

                    <ListView Grid.Row="2" x:Name="LvSchedule" BorderThickness="0" Background="Transparent">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,8"

                                        BorderBrush="#E2E8F0" BorderThickness="1">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="80"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <!-- Date badge -->

                                        <Border Background="#EFF6FF" CornerRadius="8" Padding="8" VerticalAlignment="Center" HorizontalAlignment="Center">

                                            <StackPanel HorizontalAlignment="Center">

                                                <TextBlock Text="{Binding DayText}" FontSize="20" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>

                                                <TextBlock Text="{Binding MonthText}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>

                                            </StackPanel>

                                        </Border>

                                        <!-- Info -->

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>

                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>

                                        </StackPanel>

                                        <!-- Status + Action -->

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">

                                            <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="10,4" Margin="0,0,0,4">

                                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusFg}" FontWeight="SemiBold"/>

                                            </Border>

                                            <Button Content="{Binding ActionText}" Tag="{Binding Id}"

                                                    Click="BtnScheduleAction_Click" FontSize="11" Padding="8,3"

                                                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0"

                                                    HorizontalAlignment="Stretch"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>


    </ScrollViewer>
</Page>



