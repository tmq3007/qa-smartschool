<Page x:Class="QASmartClass.Leadership.Views.StaffPerformanceTrackerView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Theo dõi Hiệu suất Giảng dạy" Background="#F0F2F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">


    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="🎯 Đánh Giá Khung Năng Lực Giáo Viên (Teacher KPI)" FontSize="24" FontWeight="Bold" Foreground="#212121"/>

            <TextBlock Text="Tổng hợp đánh giá dựa trên: Hiệu suất Task, Dự giờ, Value-Added Model (VAM), và Phản hồi học sinh." Foreground="#757575" Margin="0,5,0,0"/>

        </StackPanel>



        <DataGrid Grid.Row="1" x:Name="dgPerformance" AutoGenerateColumns="False" CanUserAddRows="False" 

                  BorderBrush="#E0E0E0" BorderThickness="1" Background="White" RowHeight="45"

                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" HeadersVisibility="Column">

            <DataGrid.Resources>

                <Style TargetType="DataGridColumnHeader">

                    <Setter Property="Background" Value="#E3F2FD"/>

                    <Setter Property="FontWeight" Value="SemiBold"/>

                    <Setter Property="Padding" Value="10,0"/>

                    <Setter Property="Height" Value="40"/>

                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Giáo viên" Binding="{Binding FullName}" Width="160" IsReadOnly="True" FontWeight="SemiBold"/>

                <DataGridTextColumn Header="Môn" Binding="{Binding Subject}" Width="100" IsReadOnly="True"/>

                

                <!-- Task Completion -->

                <DataGridTemplateColumn Header="Nhiệm vụ (%)" Width="120">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding TaskCompletionRate, StringFormat={}{0:F1}%}" VerticalAlignment="Center" Margin="10,0" Foreground="#1976D2"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>



                <!-- Class Observation -->

                <DataGridTemplateColumn Header="Dự giờ (/4.0)" Width="100">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding AverageObservationScore, StringFormat={}{0:F2}}" VerticalAlignment="Center" Margin="10,0"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>



                <!-- Value-Added Model -->

                <DataGridTemplateColumn Header="VAM Score (Cải thiện)" Width="150">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding VamScore, StringFormat={}{0:F2}}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" Foreground="#388E3C"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>



                <!-- Student Feedback -->

                <DataGridTemplateColumn Header="HS Phản hồi" Width="100">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding StudentFeedbackScore, StringFormat={}{0:F1} ★}" VerticalAlignment="Center" Margin="10,0" Foreground="#F57C00"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                

                <!-- Final Rating Score -->

                <DataGridTemplateColumn Header="Điểm Tổng (100)" Width="130">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding FinalRating, StringFormat={}{0:F1}}" VerticalAlignment="Center" Margin="10,0" FontSize="14" FontWeight="Bold"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>



                <!-- Label -->

                <DataGridTemplateColumn Header="Xếp loại" Width="140">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Border Background="#F3E5F5" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">

                                <TextBlock Text="{Binding RatingLabel}" Foreground="#6A1B9A" FontWeight="SemiBold"/>

                            </Border>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>



            </DataGrid.Columns>

        </DataGrid>

    </Grid>


    </ScrollViewer>
</Page>



