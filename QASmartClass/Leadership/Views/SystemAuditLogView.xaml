<Page x:Class="QASmartClass.Leadership.Views.SystemAuditLogView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:QASmartClass.Converters"
      Title="Nhật ký Kiểm toán Hệ thống" Background="#F4F6F9"
      FontFamily="Segoe UI">
    <Page.Resources>
        <conv:ActionTranslationConverter x:Key="ActionTranslationConverter"/>
        <conv:HashTruncateConverter x:Key="HashTruncateConverter"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">


    

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Bộ lọc nâng cao -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Bảng dữ liệu (Card) -->
            <RowDefinition Height="*"/>
            <!-- 3. Phân trang & Xuất dữ liệu -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 0. HEADER SECTION ═══ -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E3E8EE" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📜 Nhật ký hoạt động hệ thống" FontSize="22" FontWeight="Bold" Foreground="#1A202C"/>
                    <TextBlock Text="Theo dõi các hoạt động cấu hình hệ thống, đăng nhập và chỉnh sửa dữ liệu giáo dục." Foreground="#718096" Margin="0,4,0,0" FontSize="13"/>
                </StackPanel>
                <!-- Nút xác minh toàn vẹn dữ liệu -->
                <Button Grid.Column="1" x:Name="btnVerify" Content="🛡 Xác thực tính toàn vẹn" Click="BtnVerify_Click"
                        Background="#3182CE" Foreground="White" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ 1. FILTER SECTION ═══ -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E3E8EE" BorderThickness="1">
            <StackPanel>
                <!-- Hướng dẫn sử dụng nhanh từng bước -->
                <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="💡 Hướng dẫn sử dụng nhanh từng bước:" FontWeight="Bold" Foreground="#2B6CB0" FontSize="13"/>
                        <TextBlock Text="• Bước 1: Nhập thông tin bộ lọc (Người dùng, Hành động) hoặc chọn khoảng ngày cần tra cứu." Foreground="#4A5568" Margin="0,4,0,2" FontSize="12"/>
                        <TextBlock Text="• Bước 2: Nhấn nút 'Lọc' hoặc phím 'Enter' để tìm kiếm; nhấn 'Đặt lại' để quay về mặc định." Foreground="#4A5568" Margin="0,0,0,2" FontSize="12"/>
                        <TextBlock Text="• Bước 3: Bấm 'Xác thực tính toàn vẹn' để kiểm tra bảo mật dữ liệu hoặc 'Xuất báo cáo Excel' để tải tệp thống kê." Foreground="#4A5568" FontSize="12"/>
                    </StackPanel>
                </Border>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Lọc theo Người dùng -->
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Người dùng" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="12"/>
                    <TextBox x:Name="txtSearchActor" Width="160" Height="32" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#CBD5E0" BorderThickness="1" KeyDown="TxtSearch_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Lọc theo Hành động -->
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Hành động" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="12"/>
                    <TextBox x:Name="txtSearchAction" Width="140" Height="32" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#CBD5E0" BorderThickness="1" KeyDown="TxtSearch_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Lọc từ ngày -->
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Từ ngày" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="12"/>
                    <DatePicker x:Name="dpFromDate" Width="130" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Lọc đến ngày -->
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Đến ngày" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="12"/>
                    <DatePicker x:Name="dpToDate" Width="130" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Lọc theo Mức độ nghiêm trọng -->
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Mức độ nghiêm trọng" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6" FontSize="12"/>
                    <ComboBox x:Name="cbSeverity" Width="150" Height="32" VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="Tất cả"/>
                        <ComboBoxItem Content="Thông tin (Info)"/>
                        <ComboBoxItem Content="Cảnh báo (Warning)"/>
                        <ComboBoxItem Content="Nguy cấp (Critical)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Nút bấm điều hướng -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                    <Button x:Name="btnSearch" Content="🔍 Lọc" Click="BtnSearch_Click" Width="80" Height="32" Margin="0,0,8,0"
                            Background="#2B6CB0" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnReset" Content="🔄 Đặt lại" Click="BtnReset_Click" Width="80" Height="32"
                            Background="#E2E8F0" Foreground="#4A5568" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ 2. DATAGRID (CARD BODY) ═══ -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E3E8EE" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgAuditLogs" AutoGenerateColumns="False" CanUserAddRows="False" 
                      BorderThickness="0" Background="White" RowHeight="40" FontSize="13" Foreground="#2D3748"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7" HeadersVisibility="Column">
                
                <DataGrid.Resources>
                    <!-- Header Styling -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F7FAFC"/>
                        <Setter Property="Foreground" Value="#4A5568"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.Resources>

                <!-- Hover Row Effect -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7FAFC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                    
                    <DataGridTextColumn Header="Thời gian thực hiện" Binding="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="160" IsReadOnly="True"/>
                    
                    <!-- Cột Hành động -->
                    <DataGridTemplateColumn Header="Tác vụ" Width="140" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="4" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"
                                        Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1">
                                    <TextBlock Text="{Binding Action, Converter={StaticResource ActionTranslationConverter}}" Foreground="#2B6CB0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột Mức độ nghiêm trọng -->
                    <DataGridTemplateColumn Header="Mức độ" Width="100" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="badgeBorder" Margin="4" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"
                                        Background="#E2E8F0" BorderBrush="#CBD5E0" BorderThickness="1">
                                    <TextBlock x:Name="badgeText" Text="Thông tin" Foreground="#4A5568" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                        <Setter TargetName="badgeBorder" Property="Background" Value="#E6F4EA"/>
                                        <Setter TargetName="badgeBorder" Property="BorderBrush" Value="#34A853"/>
                                        <Setter TargetName="badgeText" Property="Text" Value="Thông tin"/>
                                        <Setter TargetName="badgeText" Property="Foreground" Value="#137333"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter TargetName="badgeBorder" Property="Background" Value="#FEF7E0"/>
                                        <Setter TargetName="badgeBorder" Property="BorderBrush" Value="#FBBC04"/>
                                        <Setter TargetName="badgeText" Property="Text" Value="Cảnh báo"/>
                                        <Setter TargetName="badgeText" Property="Foreground" Value="#B06000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                        <Setter TargetName="badgeBorder" Property="Background" Value="#FCE8E6"/>
                                        <Setter TargetName="badgeBorder" Property="BorderBrush" Value="#EA4335"/>
                                        <Setter TargetName="badgeText" Property="Text" Value="Nguy cấp"/>
                                        <Setter TargetName="badgeText" Property="Foreground" Value="#C5221F"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Người dùng" Binding="{Binding ActorName}" Width="160" IsReadOnly="True"/>
                    
                    <!-- Cột Chi tiết (Co giãn rộng và hỗ trợ xuống dòng) -->
                    <DataGridTextColumn Header="Chi tiết thay đổi" Binding="{Binding Details}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Cột Mã Hash để đối chiếu bảo mật -->
                    <DataGridTemplateColumn Width="150" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="Mã bảo mật (SHA256)" ToolTip="Mã khóa bảo mật dùng để xác minh dữ liệu không bị sửa đổi trái phép"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RowHash, Converter={StaticResource HashTruncateConverter}}" 
                                           ToolTip="{Binding RowHash}" 
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center" Padding="8,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ 3. PAGINATION & EXPORT BAR ═══ -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Xuất dữ liệu Excel -->
            <Button Grid.Column="0" x:Name="btnExport" Content="📥 Xuất báo cáo Excel" Click="BtnExport_Click"
                    Background="#38A169" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Điều hướng phân trang (Giữa) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnPrevPage" Content="◀" Click="BtnPrevPage_Click" Width="36" Height="32" Margin="0,0,8,0"
                        Background="White" BorderBrush="#CBD5E0" BorderThickness="1" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <TextBlock x:Name="txtPageInfo" Text="Trang 1 / 1" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" Foreground="#4A5568"/>
                
                <Button x:Name="btnNextPage" Content="▶" Click="BtnNextPage_Click" Width="36" Height="32" Margin="8,0,0,0"
                        Background="White" BorderBrush="#CBD5E0" BorderThickness="1" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="2" x:Name="txtTotalCount" Text="Tổng số bản ghi: 0" VerticalAlignment="Center" Foreground="#718096" FontWeight="SemiBold"/>
        </Grid>
    </Grid>

    </ScrollViewer>
</Page>
