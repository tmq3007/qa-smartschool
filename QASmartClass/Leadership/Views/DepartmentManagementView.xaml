<Page x:Class="QASmartClass.Leadership.Views.DepartmentManagementView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Quản lý Tổ Chuyên Môn" Background="#F8FAFC"

      FontFamily="Segoe UI">



    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="🏫 Quản lý Tổ Chuyên Môn" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>

            <TextBlock Text="Quản lý cơ cấu các tổ chuyên môn, phân bổ nhân sự giáo viên và theo dõi KPI giảng dạy." Foreground="#64748B" FontSize="14" Margin="0,4,0,0"/>

        </StackPanel>



        <!-- Main Body -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="320"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- LEFT: Departments List -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <TextBlock Grid.Row="0" Text="Danh sách Tổ chuyên môn" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>



                    <ListBox Grid.Row="1" x:Name="lstDepartments" BorderThickness="0" Background="Transparent" SelectionChanged="LstDepartments_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding" Value="0"/>

                                <Setter Property="Margin" Value="0,0,0,8"/>

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">

                                                <ContentPresenter />

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsSelected" Value="True">

                                                    <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>

                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>

                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding DepartmentName}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>

                                    <TextBlock Grid.Row="1" Text="{Binding SchoolYear, StringFormat='Năm học: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>



                    <!-- Add Button -->

                    <Button Grid.Row="2" Content="➕ Thêm Tổ Chuyên Môn" Height="40" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" FontSize="13" Cursor="Hand" BorderThickness="0" Margin="0,12,0,0" Click="BtnAddDepartment_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" CornerRadius="8">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>

            </Border>



            <!-- RIGHT: Details, KPIs & Members -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <!-- Top detail / KPI cards -->

                <Grid Grid.Row="0" Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/>

                        <ColumnDefinition Width="3*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Left: Selected Dept Detail & Actions -->

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0">

                        <StackPanel>

                            <TextBlock Text="Thông tin Tổ" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                            

                            <Grid Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Tên tổ:" Foreground="#64748B" VerticalAlignment="Center"/>

                                <TextBox Grid.Column="1" x:Name="txtDeptName" Padding="6" BorderBrush="#CBD5E1" BorderThickness="1"/>

                            </Grid>



                            <Grid Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Tổ trưởng:" Foreground="#64748B" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1" x:Name="cmbHeadTeacher" DisplayMemberPath="FullName" SelectedValuePath="StaffCode" Padding="6"/>

                            </Grid>



                            <Grid Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Tổ phó:" Foreground="#64748B" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1" x:Name="cmbDeputyHead" DisplayMemberPath="FullName" SelectedValuePath="StaffCode" Padding="6"/>

                            </Grid>



                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Năm học:" Foreground="#64748B" VerticalAlignment="Center"/>

                                <TextBox Grid.Column="1" x:Name="txtSchoolYear" Padding="6" BorderBrush="#CBD5E1" BorderThickness="1" IsReadOnly="True" Background="#F1F5F9"/>

                            </Grid>



                            <UniformGrid Columns="2" Rows="1">

                                <Button Content="💾 Lưu thay đổi" Height="36" Background="#10B981" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="0,0,6,0" Click="BtnSaveDept_Click">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                                <Button Content="🗑 Xóa Tổ" Height="36" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="6,0,0,0" Click="BtnDeleteDept_Click">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </UniformGrid>

                        </StackPanel>

                    </Border>



                    <!-- Right: KPI cards -->

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="KPI Tổ tháng này" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                            

                            <UniformGrid Grid.Row="1" Columns="3" Rows="1">

                                <!-- Card 1: Teachers -->

                                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#BFDBFE" BorderThickness="1">

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                        <TextBlock Text="👥 Giáo viên" FontSize="12" Foreground="#2563EB" HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="txtKpiTeachers" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Border>



                                <!-- Card 2: Lesson Plans -->

                                <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="4,0,4,0" BorderBrush="#A7F3D0" BorderThickness="1">

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                        <TextBlock Text="📄 Giáo án" FontSize="12" Foreground="#059669" HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="txtKpiLessonPlans" Text="0" FontSize="28" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Border>



                                <!-- Card 3: Observations -->

                                <Border Background="#FFF7ED" CornerRadius="8" Padding="12" Margin="8,0,0,0" BorderBrush="#FED7AA" BorderThickness="1">

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                        <TextBlock Text="👁 Dự giờ" FontSize="12" Foreground="#D97706" HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="txtKpiObservations" Text="0" FontSize="28" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Border>

                            </UniformGrid>

                        </Grid>

                    </Border>

                </Grid>



                <!-- Bottom: Members List & Manage -->

                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>



                        <!-- Panel Header -->

                        <Grid Grid.Row="0" Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Thành viên tổ chuyên môn" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>

                        </Grid>



                        <!-- Members DataGrid -->

                        <DataGrid Grid.Row="1" x:Name="dgMembers" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="None" Background="Transparent" BorderThickness="0" HeadersVisibility="Column">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background" Value="#F1F5F9"/>

                                    <Setter Property="Foreground" Value="#475569"/>

                                    <Setter Property="FontWeight" Value="SemiBold"/>

                                    <Setter Property="Padding" Value="10,8"/>

                                    <Setter Property="BorderThickness" Value="0"/>

                                </Style>

                                <Style TargetType="DataGridCell">

                                    <Setter Property="Padding" Value="10,8"/>

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="DataGridCell">

                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">

                                                    <ContentPresenter VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.RowStyle>

                                <Style TargetType="DataGridRow">

                                    <Setter Property="Background" Value="Transparent"/>

                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>

                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>

                                </Style>

                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mã nhân sự" Binding="{Binding StaffCode}" Width="120" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Chức vụ trong tổ" Binding="{Binding Role}" Width="150" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Ngày tham gia" Binding="{Binding JoinedDate, StringFormat='dd/MM/yyyy'}" Width="120" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Hành động" Width="100">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="Xóa" Background="#FEE2E2" Foreground="#EF4444" FontWeight="SemiBold" Padding="8,4" Cursor="Hand" BorderThickness="0" Click="BtnRemoveMember_Click">

                                                <Button.Template>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Button.Template>

                                            </Button>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>



                        <!-- Add Member Section -->

                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="180"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                    <TextBlock Text="Chọn giáo viên" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>

                                    <ComboBox x:Name="cmbAvailableStaff" DisplayMemberPath="FullName" SelectedValuePath="Id" Height="36"/>

                                </StackPanel>



                                <StackPanel Grid.Column="1" Margin="0,0,12,0">

                                    <TextBlock Text="Chức vụ" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>

                                    <ComboBox x:Name="cmbMemberRole" SelectedIndex="2" Height="36">

                                        <ComboBoxItem Content="Tổ trưởng"/>

                                        <ComboBoxItem Content="Tổ phó"/>

                                        <ComboBoxItem Content="Thành viên"/>

                                    </ComboBox>

                                </StackPanel>



                                <Button Grid.Column="2" Content="➕ Thêm thành viên" VerticalAlignment="Bottom" Height="36" Width="150" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Click="BtnAddMember_Click">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Grid>



        <!-- Popup: Add Department Dialog -->

        <Popup x:Name="popAddDept" Placement="Center" IsOpen="False" StaysOpen="False">

            <Border Background="White" CornerRadius="12" Padding="20" Width="360" BorderBrush="#CBD5E1" BorderThickness="1">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="15" Opacity="0.15"/>

                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="➕ Thêm Tổ chuyên môn mới" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="#0F172A"/>



                    <TextBlock Text="Tên Tổ chuyên môn:" Foreground="#64748B" Margin="0,0,0,4"/>

                    <TextBox x:Name="txtNewDeptName" Padding="8" Margin="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="1"/>



                    <TextBlock Text="Tổ trưởng:" Foreground="#64748B" Margin="0,0,0,4"/>

                    <ComboBox x:Name="cmbNewHead" DisplayMemberPath="FullName" SelectedValuePath="StaffCode" Padding="8" Margin="0,0,0,12"/>



                    <TextBlock Text="Năm học:" Foreground="#64748B" Margin="0,0,0,4"/>

                    <TextBox x:Name="txtNewSchoolYear" Text="2025-2026" Padding="8" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1"/>



                    <UniformGrid Columns="2" Rows="1">

                        <Button Content="Hủy bỏ" Height="36" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="0,0,6,0" Click="BtnCancelNewDept_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                        <Button Content="Thêm mới" Height="36" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="6,0,0,0" Click="BtnConfirmAddDept_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </UniformGrid>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>

</Page>



