<Page x:Class="QASmartClass.Leadership.Views.AwardManagementView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Quản lý Khen Thưởng" Background="#F8FAFC"

      FontFamily="Segoe UI">



    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="🎖️ Quản lý Khen Thưởng" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>

            <TextBlock Text="Phê duyệt các đề xuất khen thưởng cho Học sinh, Giáo viên, Tập thể lớp và xuất giấy khen QuestPDF." Foreground="#64748B" FontSize="14" Margin="0,4,0,0"/>

        </StackPanel>



        <!-- Main Body -->

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" x:Name="tcMain">

            <TabControl.Resources>

                <!-- Style for TabItem -->

                <Style TargetType="TabItem">

                    <Setter Property="HeaderTemplate">

                        <Setter.Value>

                            <DataTemplate>

                                <ContentPresenter Content="{TemplateBinding Content}" Margin="12,6"/>

                            </DataTemplate>

                        </Setter.Value>

                    </Setter>

                    <Setter Property="FontSize" Value="14"/>

                    <Setter Property="FontWeight" Value="SemiBold"/>

                    <Setter Property="Background" Value="Transparent"/>

                    <Setter Property="BorderThickness" Value="0,0,0,2"/>

                    <Setter Property="BorderBrush" Value="Transparent"/>

                    <Setter Property="Foreground" Value="#64748B"/>

                    <Setter Property="Template">

                        <Setter.Value>

                            <ControlTemplate TargetType="TabItem">

                                <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="10,6">

                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsSelected" Value="True">

                                        <Setter Property="BorderBrush" Value="#3B82F6"/>

                                        <Setter Property="Foreground" Value="#3B82F6"/>

                                    </Trigger>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Foreground" Value="#1E293B"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Setter.Value>

                    </Setter>

                </Style>

            </TabControl.Resources>



            <!-- TAB 1: Pending Approvals -->

            <TabItem Header="⏳ Chờ duyệt" x:Name="tabPending">

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>



                        <DockPanel Grid.Row="0" Margin="0,0,0,16">

                            <TextBlock Text="Danh sách đề cử chờ phê duyệt" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>

                            <Button DockPanel.Dock="Right" Content="🔄 Tải lại" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" BorderThickness="0" Click="BtnRefreshPending_Click" HorizontalAlignment="Right">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </DockPanel>



                        <!-- DataGrid Pending -->

                        <DataGrid Grid.Row="1" x:Name="dgPending" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="None" Background="Transparent" BorderThickness="0" HeadersVisibility="Column">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background" Value="#F1F5F9"/>

                                    <Setter Property="Foreground" Value="#475569"/>

                                    <Setter Property="FontWeight" Value="SemiBold"/>

                                    <Setter Property="Padding" Value="10,8"/>

                                    <Setter Property="BorderThickness" Value="0"/>

                                </Style>

                                <Style TargetType="DataGridCell">

                                    <Setter Property="Padding" Value="10,8"/>

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="DataGridCell">

                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">

                                                    <ContentPresenter VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.RowStyle>

                                <Style TargetType="DataGridRow">

                                    <Setter Property="Background" Value="Transparent"/>

                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>

                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>

                                </Style>

                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Đối tượng" Binding="{Binding TargetTypeDesc}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Tên đối tượng" Binding="{Binding TargetName}" Width="150" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Danh hiệu" Binding="{Binding AwardType}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Học kỳ" Binding="{Binding Semester}" Width="80" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Năm học" Binding="{Binding SchoolYear}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Người đề xuất" Binding="{Binding ProposedBy}" Width="120" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Ngày đề cử" Binding="{Binding ProposedDate, StringFormat='dd/MM/yyyy'}" Width="120" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Thao tác" Width="180">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal">

                                                <Button Content="Duyệt" Background="#DCFCE7" Foreground="#166534" FontWeight="SemiBold" Padding="8,4" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" Click="BtnApprove_Click">

                                                    <Button.Template>

                                                        <ControlTemplate TargetType="Button">

                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            </Border>

                                                        </ControlTemplate>

                                                    </Button.Template>

                                                </Button>

                                                <Button Content="Từ chối" Background="#FEE2E2" Foreground="#991B1B" FontWeight="SemiBold" Padding="8,4" Cursor="Hand" BorderThickness="0" Click="BtnReject_Click">

                                                    <Button.Template>

                                                        <ControlTemplate TargetType="Button">

                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            </Border>

                                                        </ControlTemplate>

                                                    </Button.Template>

                                                </Button>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </TabItem>



            <!-- TAB 2: Approved / Print Queue -->

            <TabItem Header="✅ Đã duyệt (In giấy khen)" x:Name="tabApproved">

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>



                        <!-- Controls -->

                        <Grid Grid.Row="0" Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>



                            <StackPanel Grid.Column="0" Orientation="Horizontal">

                                <TextBlock Text="Năm học:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <ComboBox x:Name="cmbYearFilter" Width="120" Height="36" SelectionChanged="CmbYearFilter_SelectionChanged"/>

                            </StackPanel>



                            <StackPanel Grid.Column="2" Orientation="Horizontal">

                                <Button Content="🖨 In giấy khen hàng loạt" Background="#EAB308" Foreground="#854D0E" FontWeight="Bold" Padding="14,8" Cursor="Hand" BorderThickness="0" Margin="0,0,8,0" Click="BtnPrintBatch_Click">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                                <Button Content="🔄 Tải lại" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" BorderThickness="0" Click="BtnRefreshApproved_Click">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </StackPanel>

                        </Grid>



                        <!-- DataGrid Approved -->

                        <DataGrid Grid.Row="1" x:Name="dgApproved" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="None" Background="Transparent" BorderThickness="0" HeadersVisibility="Column">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background" Value="#F1F5F9"/>

                                    <Setter Property="Foreground" Value="#475569"/>

                                    <Setter Property="FontWeight" Value="SemiBold"/>

                                    <Setter Property="Padding" Value="10,8"/>

                                    <Setter Property="BorderThickness" Value="0"/>

                                </Style>

                                <Style TargetType="DataGridCell">

                                    <Setter Property="Padding" Value="10,8"/>

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="DataGridCell">

                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">

                                                    <ContentPresenter VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.RowStyle>

                                <Style TargetType="DataGridRow">

                                    <Setter Property="Background" Value="Transparent"/>

                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>

                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>

                                </Style>

                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <!-- Checkbox Column for Bulk Print -->

                                <DataGridTemplateColumn Width="45">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Đối tượng" Binding="{Binding TargetTypeDesc}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Tên đối tượng" Binding="{Binding TargetName}" Width="150" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Danh hiệu" Binding="{Binding AwardType}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Học kỳ" Binding="{Binding Semester}" Width="80" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Năm học" Binding="{Binding SchoolYear}" Width="100" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Người duyệt" Binding="{Binding ApprovedBy}" Width="120" IsReadOnly="True"/>

                                <DataGridTextColumn Header="Ngày duyệt" Binding="{Binding ApprovedDate, StringFormat='dd/MM/yyyy'}" Width="120" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Hành động" Width="100">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="🖨 In PDF" Background="#EFF6FF" Foreground="#2563EB" FontWeight="SemiBold" Padding="8,4" Cursor="Hand" BorderThickness="0" Click="BtnPrintSingle_Click">

                                                <Button.Template>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Button.Template>

                                            </Button>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </TabItem>



            <!-- TAB 3: Statistics Dashboard -->

            <TabItem Header="📊 Thống kê" x:Name="tabStats">

                <Grid Margin="0,12,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <!-- KPI row -->

                    <UniformGrid Grid.Row="0" Columns="4" Rows="1" Height="100" Margin="0,0,0,16">

                        <!-- Total -->

                        <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,8,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="📝 Tổng đề xuất" FontSize="12" Foreground="#64748B"/>

                                <TextBlock x:Name="txtStatTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>



                        <!-- Approved -->

                        <Border Background="#ECFDF5" CornerRadius="12" Padding="16" BorderBrush="#A7F3D0" BorderThickness="1" Margin="8,0,8,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="✅ Đã duyệt" FontSize="12" Foreground="#059669"/>

                                <TextBlock x:Name="txtStatApproved" Text="0" FontSize="26" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>



                        <!-- Pending -->

                        <Border Background="#EFF6FF" CornerRadius="12" Padding="16" BorderBrush="#BFDBFE" BorderThickness="1" Margin="8,0,8,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="⏳ Chờ duyệt" FontSize="12" Foreground="#2563EB"/>

                                <TextBlock x:Name="txtStatPending" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>



                        <!-- Rejected -->

                        <Border Background="#FEE2E2" CornerRadius="12" Padding="16" BorderBrush="#FCA5A5" BorderThickness="1" Margin="8,0,0,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="❌ Từ chối" FontSize="12" Foreground="#DC2626"/>

                                <TextBlock x:Name="txtStatRejected" Text="0" FontSize="26" FontWeight="Bold" Foreground="#991B1B" Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>

                    </UniformGrid>



                    <!-- Breakdown & Details -->

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="2*"/>

                        </Grid.ColumnDefinitions>



                        <!-- Awards by type -->

                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Cơ cấu theo Danh hiệu" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>

                                

                                <ListBox Grid.Row="1" x:Name="lstStatsByType" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding TypeName}" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>

                                                    <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="12" Padding="10,4">

                                                        <TextBlock Text="{Binding Count, StringFormat='{}{0} giải'}" FontSize="12" FontWeight="Bold" Foreground="#475569"/>

                                                    </Border>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Grid>

                        </Border>



                        <!-- All awards log -->

                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Nhật ký khen thưởng toàn trường" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>

                                

                                <DataGrid Grid.Row="1" x:Name="dgAllAwards" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="None" Background="Transparent" BorderThickness="0" HeadersVisibility="Column" IsReadOnly="True">

                                    <DataGrid.Resources>

                                        <Style TargetType="DataGridColumnHeader">

                                            <Setter Property="Background" Value="#F1F5F9"/>

                                            <Setter Property="Foreground" Value="#475569"/>

                                            <Setter Property="FontWeight" Value="SemiBold"/>

                                            <Setter Property="Padding" Value="10,8"/>

                                            <Setter Property="BorderThickness" Value="0"/>

                                        </Style>

                                        <Style TargetType="DataGridCell">

                                            <Setter Property="Padding" Value="10,8"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="DataGridCell">

                                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">

                                                            <ContentPresenter VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </DataGrid.Resources>

                                    <DataGrid.RowStyle>

                                        <Style TargetType="DataGridRow">

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>

                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>

                                        </Style>

                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Đối tượng" Binding="{Binding TargetName}" Width="130"/>

                                        <DataGridTextColumn Header="Danh hiệu" Binding="{Binding AwardType}" Width="100"/>

                                        <DataGridTextColumn Header="Học kỳ" Binding="{Binding Semester}" Width="80"/>

                                        <DataGridTextColumn Header="Năm học" Binding="{Binding SchoolYear}" Width="100"/>

                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDesc}" Width="100"/>

                                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </TabItem>

        </TabControl>



        <!-- Popup: Input Rejection Reason Dialog -->

        <Popup x:Name="popRejectReason" Placement="Center" IsOpen="False" StaysOpen="False">

            <Border Background="White" CornerRadius="12" Padding="20" Width="360" BorderBrush="#CBD5E1" BorderThickness="1">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="15" Opacity="0.15"/>

                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="❌ Lý do từ chối khen thưởng" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="#991B1B"/>

                    <TextBlock Text="Vui lòng nhập lý do từ chối phê duyệt đề xuất khen thưởng này:" Foreground="#64748B" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    

                    <TextBox x:Name="txtRejectReason" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1" VerticalScrollBarVisibility="Auto"/>



                    <UniformGrid Columns="2" Rows="1">

                        <Button Content="Hủy bỏ" Height="36" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="0,0,6,0" Click="BtnCancelReject_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                        <Button Content="Xác nhận từ chối" Height="36" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="6,0,0,0" Click="BtnConfirmReject_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </UniformGrid>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>

</Page>



