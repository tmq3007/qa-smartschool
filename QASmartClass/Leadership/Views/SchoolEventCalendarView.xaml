<Page x:Class="QASmartClass.Leadership.Views.SchoolEventCalendarView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Lịch Sự kiện &amp; Lễ hội" Background="#F0F2F5"
      FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Thêm Sự kiện -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="5" ShadowDepth="1"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="📅 Lên Lịch Công Tác" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                    <TextBlock Text="💡 Hướng dẫn nhanh: Nhập chính xác thời gian bắt đầu và kết thúc (định dạng HH:mm) để giảng viên, học sinh theo dõi trên lịch công tác chung." 
                               TextWrapping="Wrap" Foreground="#1E40AF" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="Tên sự kiện:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTitle" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Bắt đầu:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="dpStart" Height="35"/>
                    <TextBox x:Name="txtStartTime" Grid.Column="2" Height="35" Text="08:00" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Giờ bắt đầu (HH:mm)"/>
                </Grid>

                <TextBlock Text="Kết thúc:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="dpEnd" Height="35"/>
                    <TextBox x:Name="txtEndTime" Grid.Column="2" Height="35" Text="17:00" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Giờ kết thúc (HH:mm)"/>
                </Grid>

                <TextBlock Text="Đơn vị tổ chức:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtOrganizer" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Địa điểm:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLocation" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Nội dung/Thành phần tham dự:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDescription" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,20"/>

                <Button Content="💾 Lưu Sự Kiện" Height="45" Background="#1976D2" Foreground="White" 
                        FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Click="BtnSaveEvent_Click"/>
            </StackPanel>
        </Border>

        <!-- Lịch biểu -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="5" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📆 Lịch Công Tác Tuần Này" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnExportExcel" Content="📊 Xuất Excel (CSV)" Margin="0,0,8,0" Padding="12,6" 
                                Background="#10B981" Foreground="White" FontWeight="SemiBold" FontSize="12" Cursor="Hand" BorderThickness="0" Click="BtnExportExcel_Click"/>
                        <Button x:Name="btnExportPdf" Content="🖨️ In ấn / Lưu PDF" Padding="12,6" 
                                Background="#8B5CF6" Foreground="White" FontWeight="SemiBold" FontSize="12" Cursor="Hand" BorderThickness="0" Click="BtnExportPdf_Click"/>
                    </StackPanel>
                </Grid>
                
                <ListView x:Name="lvEvents" Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F5F5F5" CornerRadius="6" Padding="15" Margin="5,5,5,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#1976D2"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="🕒 Bắt đầu: " Foreground="#757575"/>
                                        <TextBlock Text="{Binding StartTime, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#212121" FontWeight="SemiBold" Margin="0,0,15,0"/>

                                        <TextBlock Text="🕒 Kết thúc: " Foreground="#757575"/>
                                        <TextBlock Text="{Binding EndTime, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#212121" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="👤 Tổ chức: " Foreground="#757575"/>

                                        <TextBlock Text="{Binding Organizer}" Foreground="#212121" FontWeight="SemiBold" Margin="0,0,15,0"/>



                                        <TextBlock Text="📍 Địa điểm: " Foreground="#757575"/>

                                        <TextBlock Text="{Binding Location}" Foreground="#212121" FontWeight="SemiBold"/>

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

    </Grid>


    </ScrollViewer>
</Page>



