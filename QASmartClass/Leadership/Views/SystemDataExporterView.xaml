<Page x:Class="QASmartClass.Leadership.Views.SystemDataExporterView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Trích xuất Dữ liệu Định dạng Excel" Background="#F0F2F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">


    <Grid x:Name="GridExporterContent" Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="📑 Xuất Báo Cáo Hệ Thống" FontSize="24" FontWeight="Bold" Foreground="#212121"/>

            <TextBlock Text="Trích xuất dữ liệu từ các phân hệ để lưu trữ hoặc nộp báo cáo (CSV/Excel)." Foreground="#757575" Margin="0,5,0,0"/>

        </StackPanel>



        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Export Students -->

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="🎓 Dữ Liệu Học Sinh" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <CheckBox x:Name="chkStudentsAll" Content="Danh sách toàn trường" IsChecked="True" Margin="0,5"/>

                    <CheckBox x:Name="chkStudentsGrades" Content="Bảng điểm thành phần" Margin="0,5"/>

                    <CheckBox x:Name="chkStudentsAttendance" Content="Lịch sử điểm danh" Margin="0,5"/>

                    

                    <Button Content="📥 Xuất File CSV" Height="45" Background="#1976D2" Foreground="White" 

                            FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Margin="0,20,0,0" Click="BtnExportStudents_Click"/>

                </StackPanel>

            </Border>



            <!-- Export Staff & KPI -->

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="👔 Dữ Liệu Nhân Sự &amp; KPI" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <CheckBox x:Name="chkStaffList" Content="Danh sách Nhân sự" IsChecked="True" Margin="0,5"/>

                    <CheckBox x:Name="chkStaffTasks" Content="Chi tiết công việc (Tasks)" Margin="0,5"/>

                    <CheckBox x:Name="chkStaffLeave" Content="Lịch sử nghỉ phép" Margin="0,5"/>

                    

                    <Button Content="📥 Xuất File Excel" Height="45" Background="#4CAF50" Foreground="White" 

                            FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Margin="0,20,0,0" Click="BtnExportStaff_Click"/>

                </StackPanel>

            </Border>



            <!-- Export System Logs -->

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="⚙️ Dữ Liệu Hệ Thống" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <CheckBox x:Name="chkAuditLogs" Content="Nhật ký hoạt động (Audit Logs)" IsChecked="True" Margin="0,5"/>

                    <CheckBox x:Name="chkEmergency" Content="Báo cáo Sự cố y tế/Cơ sở" Margin="0,5"/>

                    <CheckBox x:Name="chkKitchenData" Content="Thống kê Canteen" Margin="0,5"/>

                    

                    <Button Content="📥 Xuất PDF/CSV" Height="45" Background="#9C27B0" Foreground="White" 

                            FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Margin="0,20,0,0" Click="BtnExportSystem_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>


    </ScrollViewer>
</Page>



