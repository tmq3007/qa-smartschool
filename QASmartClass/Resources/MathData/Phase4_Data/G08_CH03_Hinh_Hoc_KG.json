      "sectionName": "Hình chóp & Lăng trụ",
      "order": 1,
      "concepts": [
        {
          "id": "hk8_001",
          "name": "Hình chóp",
          "definition": "Đáy là đa giác, các mặt bên là tam giác chung đỉnh. V = Sđáy × h / 3",
          "examples": [
            "Kim tự tháp = hình chóp tứ giác đều"
          ]
        },
        {
          "id": "hk8_002",
          "name": "Lăng trụ",
          "definition": "2 đáy song song bằng nhau, mặt bên là HBH. V = Sđáy × h",
          "examples": [
            "Hộp bút = lăng trụ đứng HCN"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "hk8_p01",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Lăng trụ đứng đáy tam giác, Sđáy=12 cm², h=10 cm. V = ?",
          "options": [
            "A) 60 cm³",
            "B) 120 cm³",
            "C) 22 cm³",
            "D) 240 cm³"
          ],
          "correctAnswer": "B",
          "solution": "V = Sđáy × h = 12 × 10 = 120 cm³",
          "points": 5
        },
        {
          "problemId": "hk8_p02",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Hình chóp đáy vuông cạnh 6 cm, cao 8 cm. V = ?",
          "options": [
            "A) 48 cm³",
            "B) 96 cm³",
            "C) 144 cm³",
            "D) 288 cm³"
          ],
          "correctAnswer": "B",
          "solution": "Sđáy = 6² = 36 cm². V = 36 × 8 / 3 = 96 cm³",
          "points": 10
        },
        {
          "problemId": "hk8_p03",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Lăng trụ đáy tam giác đều cạnh 4 cm, cao 9 cm. V = ? (S tam giác đều = a²√3/4)",
          "options": [
            "A) 36√3 cm³",
            "B) 4√3 cm³",
            "C) 9√3 cm³",
            "D) 12√3 cm³"
          ],
          "correctAnswer": "A",
          "solution": "S = 4²√3/4 = 4√3. V = 4√3 × 9 = 36√3 cm³",
          "points": 15
        },
        {
          "problemId": "hk8_p04",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Hình chóp tam giác có bao nhiêu mặt?",
          "options": [
            "A) 3",
            "B) 4",
            "C) 5",
            "D) 6"
          ],
          "correctAnswer": "B",
          "solution": "1 đáy tam giác + 3 mặt bên tam giác = 4 mặt",
          "points": 5
        },
        {
          "problemId": "hk8_p05",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Lăng trụ đứng đáy HCN 5×3 cm, cao 8 cm. Diện tích xung quanh = ?",
          "options": [
            "A) 64 cm²",
            "B) 128 cm²",
            "C) 120 cm²",
            "D) 160 cm²"
          ],
          "correctAnswer": "B",
          "solution": "Sxq = Chu vi đáy × h = (5+3)×2 × 8 = 16 × 8 = 128 cm²",
          "points": 10
        },
        {
          "problemId": "hk8_p06",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Bể nước hình lăng trụ đáy thang: 2 đáy 3m & 5m, cao thang 2m, bể cao 1,5m. V = ? m³",
          "options": [
            "A) 6 m³",
            "B) 8 m³",
            "C) 12 m³",
            "D) 15 m³"
          ],
          "correctAnswer": "C",
          "solution": "S thang = (3+5)×2/2 = 8 m². V = 8 × 1,5 = 12 m³",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "hk8_02",
      "sectionName": "Diện tích & Thể tích tổng hợp",
      "order": 2,
      "concepts": [
        {
          "id": "hk8_003",
          "name": "Diện tích toàn phần",
          "definition": "Stp = Sxq + 2Sđáy (lăng trụ) hoặc Sxq + Sđáy (chóp)",
          "examples": [
            "Lăng trụ: Stp = Sxq + 2Sđáy"
          ]
        },
        {
          "id": "hk8_004",
          "name": "So sánh thể tích",
          "definition": "Dùng đơn vị chung để so sánh: 1 m³ = 1000 lít = 1.000.000 cm³",
          "examples": [
            "1 lít = 1 dm³ = 1000 cm³"
          ]
        }
      ],
      "problems": [
