          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "1 m³ = ? lít",
          "options": [
            "A) 10",
            "B) 100",
            "C) 1000",
            "D) 10000"
          ],
          "correctAnswer": "C",
          "solution": "1 m³ = 1000 dm³ = 1000 lít",
          "points": 5
        },
        {
          "problemId": "hk8_p08",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Hình hộp CN 4×3×2 cm. Stp = ?",
          "options": [
            "A) 24 cm²",
            "B) 52 cm²",
            "C) 26 cm²",
            "D) 48 cm²"
          ],
          "correctAnswer": "B",
          "solution": "Stp = 2(4×3 + 4×2 + 3×2) = 2(12+8+6) = 2×26 = 52 cm²",
          "points": 10
        },
        {
          "problemId": "hk8_p09",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Hình trụ r=5, h=12 cm. V = ? (π≈3,14)",
          "options": [
            "A) 471 cm³",
            "B) 942 cm³",
            "C) 188,4 cm³",
            "D) 314 cm³"
          ],
          "correctAnswer": "B",
          "solution": "V = πr²h = 3,14 × 25 × 12 = 942 cm³",
          "points": 10
        },
        {
          "problemId": "hk8_p10",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Bồn nước hình trụ r=0,5m, h=1,2m. Chứa bao nhiêu lít? (π≈3,14)",
          "options": [
            "A) 785 lít",
            "B) 942 lít",
            "C) 1570 lít",
            "D) 2000 lít"
          ],
          "correctAnswer": "B",
          "solution": "V = 3,14 × 0,25 × 1,2 = 0,942 m³ = 942 lít",
          "points": 15
        },
        {
          "problemId": "hk8_p11",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "So sánh V hình cầu r=3 cm và V hình trụ r=3, h=4 cm",
          "options": [
            "A) Cầu lớn hơn",
            "B) Trụ lớn hơn",
            "C) Bằng nhau",
            "D) Không so sánh được"
          ],
          "correctAnswer": "A",
          "solution": "V cầu = 4π(27)/3 = 36π ≈ 113,1. V trụ = π(9)(4) = 36π ≈ 113,1. BẰNG NHAU!",
          "points": 15
