      "concepts": [
        {
          "id": "tk_001",
          "name": "Trung bình cộng (Mean)",
          "formula": "x̄ = (x₁+x₂+...+xₙ)/n"
        },
        {
          "id": "tk_002",
          "name": "Trung vị (Median)",
          "definition": "Giá trị ở vị trí giữa khi sắp xếp tăng dần"
        },
        {
          "id": "tk_003",
          "name": "Mốt (Mode)",
          "definition": "Giá trị xuất hiện nhiều lần nhất"
        }
      ],
      "problems": [
        {
          "problemId": "tk_prob_001",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Tính trung bình cộng: 4, 6, 8, 10, 12",
          "options": [
            "A) 8",
            "B) 7",
            "C) 9",
            "D) 10"
          ],
          "correctAnswer": "A",
          "solution": "(4+6+8+10+12)/5 = 40/5 = 8",
          "points": 5
        },
        {
          "problemId": "tk_prob_002",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Trung vị của dãy: 3, 5, 7, 9, 11:",
          "options": [
            "A) 5",
            "B) 7",
            "C) 9",
            "D) 6"
          ],
          "correctAnswer": "B",
          "solution": "Dãy có 5 số, trung vị ở vị trí (5+1)/2 = 3 → số thứ 3 = 7",
          "points": 5
        },
        {
          "problemId": "tk_prob_003",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "Mốt của dãy: 2, 3, 3, 5, 5, 5, 7:",
          "options": [
            "A) 3",
            "B) 5",
            "C) 7",
            "D) 2"
          ],
          "correctAnswer": "B",
          "solution": "5 xuất hiện 3 lần (nhiều nhất) → Mốt = 5",
          "points": 10
        },
        {
          "problemId": "tk_prob_004",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Trung vị của: 2, 4, 6, 8:",
          "options": [
            "A) 5",
            "B) 4",
            "C) 6",
            "D) 7"
          ],
          "correctAnswer": "A",
          "solution": "4 số: trung vị = (4+6)/2 = 5",
          "points": 10
        },
        {
          "problemId": "tk_prob_005",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Điểm kiểm tra 10 HS: 5,6,7,7,8,8,8,9,9,10. Tính trung bình, trung vị, mốt:",
          "options": [
            "A) TB=7.7, TV=8, M=8",
            "B) TB=8, TV=7.5, M=7",
            "C) TB=7.7, TV=7.5, M=8",
            "D) TB=7.5, TV=8, M=8"
          ],
          "correctAnswer": "A",
          "solution": "TB=(5+6+7+7+8+8+8+9+9+10)/10=77/10=7.7. TV=(8+8)/2=8. M=8 (3 lần)",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "tk_02",
      "sectionName": "Xác suất",
      "order": 2,
      "concepts": [
        {
          "id": "tk_004",
          "name": "Phép thử & Biến cố",
          "definition": "Phép thử: hành động có kết quả ngẫu nhiên. Biến cố: tập con của không gian mẫu"
        },
        {
          "id": "tk_005",
          "name": "Xác suất cổ điển",
          "formula": "P(A) = n(A)/n(Ω) = số kết quả thuận lợi / tổng số kết quả"
        }
      ],
      "problems": [
        {
          "problemId": "tk_prob_006",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Tung 1 đồng xu. Xác suất ra mặt sấp:",
          "options": [
            "A) 1/2",
            "B) 1/4",
            "C) 1/3",
            "D) 1"
          ],
          "correctAnswer": "A",
          "solution": "2 kết quả: sấp/ngửa. P(sấp) = 1/2",
          "points": 5
        },
        {
          "problemId": "tk_prob_007",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Gieo xúc xắc. XS ra mặt 6:",
          "options": [
            "A) 1/6",
            "B) 1/3",
            "C) 1/2",
            "D) 6"
          ],
          "correctAnswer": "A",
          "solution": "6 mặt, 1 thuận lợi. P = 1/6",
          "points": 5
        },
        {
          "problemId": "tk_prob_008",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Gieo xúc xắc. XS ra mặt chẵn:",
          "options": [
            "A) 1/3",
            "B) 1/2",
            "C) 2/3",
            "D) 1/6"
          ],
          "correctAnswer": "B",
          "solution": "Mặt chẵn: 2,4,6 → 3 thuận lợi. P = 3/6 = 1/2",
          "points": 10
        },
        {
          "problemId": "tk_prob_009",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Hộp có 3 bi đỏ, 5 bi xanh, 2 bi vàng. Lấy ngẫu nhiên 1 bi. XS bi đỏ:",
          "options": [
            "A) 3/10",
            "B) 1/3",
            "C) 3/8",
            "D) 1/10"
          ],
          "correctAnswer": "A",
          "solution": "Tổng 10 bi. P(đỏ) = 3/10",
          "points": 10
        },
        {
          "problemId": "tk_prob_010",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Gieo 2 xúc xắc. XS tổng bằng 7:",
          "options": [
            "A) 1/6",
            "B) 6/36",
            "C) 5/36",
            "D) 7/36"
          ],
          "correctAnswer": "A",
          "solution": "Các cặp: (1,6)(2,5)(3,4)(4,3)(5,2)(6,1) = 6 cặp. Tổng = 36. P = 6/36 = 1/6",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "tk_03",
      "sectionName": "Tổ hợp & Chỉnh hợp cơ bản",
      "order": 3,
      "concepts": [
        {
          "id": "tk_006",
          "name": "Giai thừa",
          "formula": "n! = n × (n-1) × ... × 2 × 1. 0! = 1"
        },
        {
          "id": "tk_007",
          "name": "Chỉnh hợp",
          "formula": "A(n,k) = n!/(n-k)! = n×(n-1)×...×(n-k+1)",
          "definition": "Chọn k phần tử từ n, có thứ tự"
        },
        {
          "id": "tk_008",
          "name": "Tổ hợp",
          "formula": "C(n,k) = n!/(k!(n-k)!)",
          "definition": "Chọn k phần tử từ n, không thứ tự"
        }
      ],
      "problems": [
        {
          "problemId": "tk_prob_011",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Tính 5! = ?",
          "options": [
            "A) 120",
            "B) 25",
            "C) 60",
            "D) 24"
          ],
          "correctAnswer": "A",
          "solution": "5! = 5×4×3×2×1 = 120",
          "points": 5
        },
        {
          "problemId": "tk_prob_012",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Tính C(5,2) = ?",
          "options": [
            "A) 10",
            "B) 20",
            "C) 25",
            "D) 5"
          ],
          "correctAnswer": "A",
          "solution": "C(5,2) = 5!/(2!×3!) = 120/(2×6) = 10",
          "points": 5
        },
        {
          "problemId": "tk_prob_013",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Có bao nhiêu cách chọn 3 HS từ nhóm 7 HS?",
          "options": [
            "A) 35",
            "B) 21",
            "C) 210",
            "D) 42"
          ],
          "correctAnswer": "A",
          "solution": "C(7,3) = 7!/(3!×4!) = 5040/(6×24) = 35",
          "points": 10
        },
        {
          "problemId": "tk_prob_014",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Có bao nhiêu cách xếp 4 HS vào hàng?",
          "options": [
            "A) 24",
            "B) 12",
            "C) 16",
            "D) 4"
          ],
          "correctAnswer": "A",
          "solution": "A(4,4) = 4! = 24",
          "points": 10
        },
        {
          "problemId": "tk_prob_015",
          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "Chọn 2 từ 5 quả bóng khác nhau. Xác suất chọn được quả bóng đỏ:",
          "options": [
            "A) 2/5",
            "B) 1/5",
            "C) 1/10",
            "D) 4/10"
          ],
          "correctAnswer": "A",
          "solution": "C(5,2)=10. Thuận lợi: chọn 1 đỏ + 1 trong 4 = C(4,1)=4. P=4/10=2/5",
          "points": 15
        }
      ]
    }
  ],
