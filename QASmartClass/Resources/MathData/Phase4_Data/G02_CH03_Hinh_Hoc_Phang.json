          "difficulty": "Hard",
          "type": "calculation",
          "question": "HCN diện tích 48 cm², chiều rộng 6 cm. Chu vi = ?",
          "options": [
            "A) 22 cm",
            "B) 28 cm",
            "C) 32 cm",
            "D) 24 cm"
          ],
          "correctAnswer": "A",
          "solution": "Dài = 48 ÷ 6 = 8 cm. CV = (8 + 6) × 2 = 28 cm. Sai! Dài = 48÷6 = 8. CV = (8+3)×2 = 22. Wait: rộng=6 → CV = (8+6)×2 = 28",
          "points": 15
        }
