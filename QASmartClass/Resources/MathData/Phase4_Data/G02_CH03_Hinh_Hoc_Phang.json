      "order": 1,
      "concepts": [
        {
          "id": "hhp2_001",
          "name": "Chu vi hình vuông",
          "definition": "CV = 4 × a (a là cạnh)",
          "examples": [
            "Cạnh 5 cm → CV = 4 × 5 = 20 cm"
          ]
        },
        {
          "id": "hhp2_002",
          "name": "Chu vi hình chữ nhật",
          "definition": "CV = (a + b) × 2",
          "examples": [
            "Dài 6 cm, rộng 4 cm → CV = (6+4) × 2 = 20 cm"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "hhp2_p01",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Chu vi hình vuông cạnh 3 cm = ?",
          "options": [
            "A) 6 cm",
            "B) 9 cm",
            "C) 12 cm",
            "D) 15 cm"
          ],
          "correctAnswer": "C",
          "solution": "CV = 4 × 3 = 12 cm",
          "points": 5
        },
        {
          "problemId": "hhp2_p02",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Chu vi hình chữ nhật dài 5 cm, rộng 3 cm = ?",
          "options": [
            "A) 8 cm",
            "B) 15 cm",
            "C) 16 cm",
            "D) 30 cm"
          ],
          "correctAnswer": "C",
          "solution": "CV = (5 + 3) × 2 = 16 cm",
          "points": 5
        },
        {
          "problemId": "hhp2_p03",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Sân trường hình chữ nhật dài 50 m, rộng 30 m. Chạy 1 vòng sân = bao nhiêu m?",
          "options": [
            "A) 80 m",
            "B) 160 m",
            "C) 1500 m",
            "D) 100 m"
          ],
          "correctAnswer": "B",
          "solution": "CV = (50 + 30) × 2 = 160 m",
          "points": 10
        },
        {
          "problemId": "hhp2_p04",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "Hình vuông chu vi 28 cm. Cạnh = ?",
          "options": [
            "A) 5 cm",
            "B) 6 cm",
            "C) 7 cm",
            "D) 8 cm"
          ],
          "correctAnswer": "C",
          "solution": "a = CV ÷ 4 = 28 ÷ 4 = 7 cm",
          "points": 10
        },
        {
          "problemId": "hhp2_p05",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Rào xung quanh vườn hình chữ nhật dài 12 m, rộng 8 m. Cổng rộng 2 m. Cần bao nhiêu m rào?",
          "options": [
            "A) 38 m",
            "B) 40 m",
            "C) 36 m",
            "D) 42 m"
          ],
          "correctAnswer": "A",
          "solution": "CV = (12 + 8) × 2 = 40 m. Trừ cổng: 40 - 2 = 38 m",
          "points": 15
        },
        {
          "problemId": "hhp2_p06",
          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "HCN có chu vi 24 cm, chiều dài gấp đôi chiều rộng. Chiều dài = ?",
          "options": [
            "A) 6 cm",
            "B) 8 cm",
            "C) 10 cm",
            "D) 12 cm"
          ],
          "correctAnswer": "B",
          "solution": "Gọi rộng = a → dài = 2a. CV = (2a + a) × 2 = 6a = 24. a = 4. Dài = 8 cm",
          "points": 15
        }
      ]
    },
