      "difficulty": "Hard",
      "question": "Hình vành khăn: R lớn=10, R nhỏ=6. S vành khăn = ? (π≈3,14)",
      "options": [
        "A) 100,48 cm²",
        "B) 150,72 cm²",
        "C) 200,96 cm²",
        "D) 50,24 cm²"
      ],
      "answer": "C",
      "solution": "S = π(R²-r²) = 3,14(100-36) = 3,14 × 64 = 200,96 cm²"
    },
