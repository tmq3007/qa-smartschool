          "id": "bpt8_003",
          "name": "Hệ BPT",
          "definition": "Giao tập nghiệm của 2 BPT",
          "examples": [
            "x > 2 VÀ x < 7 → 2 < x < 7"
          ]
        },
        {
          "id": "bpt8_004",
          "name": "Bài toán BPT thực tế",
          "definition": "Chuyển điều kiện thực tế thành BPT",
          "examples": [
            "Mua x quyển vở 8.000đ, có 50.000đ → 8000x ≤ 50000 → x ≤ 6"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "bpt8_p07",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Hệ BPT: x > 1 và x < 5. Tập nghiệm = ?",
          "options": [
            "A) 1 < x < 5",
            "B) x > 5",
            "C) x < 1",
            "D) Vô nghiệm"
          ],
          "correctAnswer": "A",
          "solution": "Giao: x > 1 ∩ x < 5 → 1 < x < 5",
          "points": 5
        },
        {
          "problemId": "bpt8_p08",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Hệ: 2x-1 > 3 và 3x+2 < 20. Tập nghiệm?",
          "options": [
            "A) 2 < x < 6",
            "B) 1 < x < 6",
            "C) 2 ≤ x ≤ 6",
            "D) Vô nghiệm"
          ],
          "correctAnswer": "A",
          "solution": "2x > 4 → x > 2. 3x < 18 → x < 6. Giao: 2 < x < 6",
          "points": 10
        },
        {
          "problemId": "bpt8_p09",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Có 80.000đ, mua bút 12.000đ/cây. Mua nhiều nhất mấy cây?",
          "options": [
            "A) 5",
            "B) 6",
            "C) 7",
            "D) 8"
          ],
          "correctAnswer": "B",
          "solution": "12.000x ≤ 80.000. x ≤ 6,67. x nguyên max = 6 cây",
          "points": 10
        },
        {
          "problemId": "bpt8_p10",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Hệ: x-2 ≥ 0 và 5-x > 0. Số nguyên thỏa = ?",
          "options": [
            "A) x∈{2,3,4}",
            "B) x∈{2,3,4,5}",
            "C) x∈{3,4}",
            "D) Vô nghiệm"
          ],
          "correctAnswer": "A",
          "solution": "x ≥ 2 và x < 5. Số nguyên: 2, 3, 4",
          "points": 15
        },
        {
          "problemId": "bpt8_p11",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Cần tìm x sao cho: |x - 3| < 4",
          "options": [
            "A) -1 < x < 7",
            "B) x < 7",
            "C) x > -1",
            "D) -7 < x < 1"
          ],
          "correctAnswer": "A",
          "solution": "-4 < x-3 < 4. -1 < x < 7",
          "points": 15
        },
        {
          "problemId": "bpt8_p12",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Hệ: x > 5 và x < 3. Tập nghiệm?",
          "options": [
            "A) 3 < x < 5",
            "B) x > 5",
            "C) Vô nghiệm",
            "D) Mọi x"
          ],
          "correctAnswer": "C",
          "solution": "Không có x nào vừa > 5 vừa < 3 → vô nghiệm",
          "points": 5
