      "order": 1,
      "concepts": [
        {
          "id": "bpt8_001",
          "name": "BPT bậc nhất",
          "definition": "ax + b > 0 (hoặc <, ≥, ≤). Tập nghiệm là khoảng/nửa khoảng",
          "examples": [
            "2x - 6 > 0 → x > 3",
            "-3x + 9 ≤ 0 → x ≥ 3"
          ]
        },
        {
          "id": "bpt8_002",
          "name": "Quy tắc đổi dấu",
          "definition": "Nhân/chia cả 2 vế với số ÂM → đổi chiều BPT",
          "examples": [
            "-2x > 6 → x < -3 (đổi dấu khi chia -2)"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "bpt8_p01",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Giải: 2x + 3 > 7",
          "options": [
            "A) x > 2",
            "B) x > 5",
            "C) x < 2",
            "D) x < 5"
          ],
          "correctAnswer": "A",
          "solution": "2x > 7-3 = 4. x > 2",
          "points": 5
        },
        {
          "problemId": "bpt8_p02",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Giải: -x + 5 ≥ 0",
          "options": [
            "A) x ≥ 5",
            "B) x ≤ 5",
            "C) x ≥ -5",
            "D) x ≤ -5"
          ],
          "correctAnswer": "B",
          "solution": "-x ≥ -5 → x ≤ 5 (đổi dấu khi nhân -1)",
          "points": 5
        },
        {
          "problemId": "bpt8_p03",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Giải: 3(x-2) < 2x + 1",
          "options": [
            "A) x < 7",
            "B) x > 7",
            "C) x < 5",
            "D) x > 5"
          ],
          "correctAnswer": "A",
          "solution": "3x-6 < 2x+1. 3x-2x < 1+6. x < 7",
          "points": 10
        },
        {
          "problemId": "bpt8_p04",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "BPT: -2x + 4 > 0. Tập nghiệm biểu diễn trên trục số là:",
          "options": [
            "A) (-∞, 2)",
            "B) (2, +∞)",
            "C) (-∞, -2)",
            "D) (-2, +∞)"
          ],
          "correctAnswer": "A",
          "solution": "-2x > -4 → x < 2 (đổi dấu). Tập nghiệm: (-∞, 2)",
          "points": 10
        },
        {
          "problemId": "bpt8_p05",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Giải: (x+1)/2 - (x-3)/4 ≥ 1",
          "options": [
            "A) x ≥ 1",
            "B) x ≥ -1",
            "C) x ≤ 1",
            "D) x ≤ -1"
          ],
          "correctAnswer": "A",
          "solution": "Nhân 4: 2(x+1) - (x-3) ≥ 4. 2x+2-x+3 ≥ 4. x+5 ≥ 4. x ≥ -1",
          "points": 15
        },
        {
          "problemId": "bpt8_p06",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tìm số nguyên x lớn nhất thỏa: 5x - 3 < 12",
          "options": [
            "A) x = 2",
            "B) x = 3",
            "C) x = 1",
            "D) x = 0"
          ],
          "correctAnswer": "A",
          "solution": "5x < 15 → x < 3. Số nguyên lớn nhất < 3 là x = 2",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "bpt8_02",
