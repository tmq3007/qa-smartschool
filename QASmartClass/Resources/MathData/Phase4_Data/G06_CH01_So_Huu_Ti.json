      "order": 2,
      "concepts": [
        {
          "id": "sht_004",
          "name": "Số nguyên tố",
          "definition": "Số > 1 chỉ chia hết cho 1 và chính nó"
        },
        {
          "id": "sht_005",
          "name": "Phân tích thừa số nguyên tố",
          "definition": "Viết số dưới dạng tích thừa số nguyên tố"
        },
        {
          "id": "sht_006",
          "name": "ƯCLN & BCNN",
          "definition": "ƯCLN: tích TSNT chung, mũ nhỏ nhất. BCNN: tích TSNT, mũ lớn nhất"
        }
      ],
      "problems": [
        {
          "problemId": "sht_prob_007",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Số nào là số nguyên tố?",
          "options": [
            "A) 15",
            "B) 21",
            "C) 23",
            "D) 27"
          ],
          "correctAnswer": "C",
          "solution": "23 chỉ chia hết cho 1 và 23 → nguyên tố",
          "points": 5
        },
        {
          "problemId": "sht_prob_008",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Phân tích 30 ra thừa số nguyên tố:",
          "options": [
            "A) 2 × 15",
            "B) 2 × 3 × 5",
            "C) 5 × 6",
            "D) 3 × 10"
          ],
          "correctAnswer": "B",
          "solution": "30 = 2 × 3 × 5",
          "points": 5
        },
        {
          "problemId": "sht_prob_009",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Tìm ƯCLN(24, 36):",
          "options": [
            "A) 6",
            "B) 12",
            "C) 8",
            "D) 4"
          ],
          "correctAnswer": "B",
          "solution": "24 = 2³×3, 36 = 2²×3². ƯCLN = 2²×3 = 12",
          "points": 10
        },
        {
          "problemId": "sht_prob_010",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Tìm BCNN(8, 12):",
          "options": [
            "A) 24",
            "B) 48",
            "C) 96",
            "D) 4"
          ],
          "correctAnswer": "A",
          "solution": "8 = 2³, 12 = 2²×3. BCNN = 2³×3 = 24",
          "points": 10
        },
        {
          "problemId": "sht_prob_011",
          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "36 bi đỏ và 48 bi xanh chia đều vào hộp. Số hộp nhiều nhất?",
          "options": [
            "A) 6",
            "B) 8",
            "C) 12",
            "D) 4"
          ],
          "correctAnswer": "C",
          "solution": "ƯCLN(36,48) = 12 hộp",
          "points": 15
        }
      ]
    },
