  "commonMistakes": [
    {
      "mistake": "Nhầm: √(a+b) = √a + √b",
      "correction": "√(a+b) ≠ √a + √b"
    },
    {
      "mistake": "x² = 9 → x = 3",
      "correction": "x² = 9 → x = ±3"
