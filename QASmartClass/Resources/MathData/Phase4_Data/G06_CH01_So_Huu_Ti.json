      "sectionId": "sht_01",
      "sectionName": "Số hữu tỉ & Tính chất",
      "order": 1,
      "concepts": [
        {
          "id": "sht_001",
          "name": "Số hữu tỉ",
          "definition": "Số viết được dưới dạng p/q (p, q ∈ ℤ, q ≠ 0). Ký hiệu: ℚ"
        },
        {
          "id": "sht_002",
          "name": "So sánh số hữu tỉ",
          "definition": "Quy đồng mẫu dương rồi so sánh tử"
        },
        {
          "id": "sht_003",
          "name": "Giá trị tuyệt đối",
          "definition": "|a| = a nếu a ≥ 0, |a| = -a nếu a < 0"
        }
      ],
      "problems": [
        {
          "problemId": "sht_prob_001",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Số nào sau đây là số hữu tỉ?",
          "options": [
            "A) √2",
            "B) π",
            "C) -3/7",
            "D) √3"
          ],
          "correctAnswer": "C",
          "solution": "-3/7 có dạng p/q → hữu tỉ",
          "points": 5
        },
        {
          "problemId": "sht_prob_002",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Tính: |-7| + |3| = ?",
          "options": [
            "A) -4",
            "B) 10",
            "C) 4",
            "D) -10"
          ],
          "correctAnswer": "B",
          "solution": "|-7| = 7, |3| = 3. 7 + 3 = 10",
          "points": 5
        },
        {
          "problemId": "sht_prob_003",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "So sánh: -3/4 và -5/7",
          "options": [
            "A) -3/4 > -5/7",
            "B) -3/4 < -5/7",
            "C) Bằng nhau",
            "D) Không so sánh được"
          ],
          "correctAnswer": "B",
          "solution": "Quy đồng mẫu 28: -21/28 < -20/28 → -3/4 < -5/7",
          "points": 10
        },
        {
          "problemId": "sht_prob_004",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Tính: 2/3 + (-5/6) = ?",
          "options": [
            "A) -1/6",
            "B) 1/6",
            "C) -3/6",
            "D) 7/6"
          ],
          "correctAnswer": "A",
          "solution": "Quy đồng mẫu 6: 4/6 + (-5/6) = -1/6",
          "points": 10
        },
        {
          "problemId": "sht_prob_005",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tìm x: |x - 2| = 5",
          "options": [
            "A) x = 7",
            "B) x = -3",
            "C) x = 7 hoặc x = -3",
            "D) x = 3"
          ],
          "correctAnswer": "C",
          "solution": "x - 2 = 5 → x = 7 hoặc x - 2 = -5 → x = -3",
          "points": 15
        },
        {
          "problemId": "sht_prob_006",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tính: (-2/3) × 9/4 + (-2/3) × 3/4",
          "options": [
            "A) -2",
            "B) 2",
            "C) -1",
            "D) -3"
          ],
          "correctAnswer": "A",
          "solution": "(-2/3) × (9/4 + 3/4) = (-2/3) × 3 = -2",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "sht_02",
