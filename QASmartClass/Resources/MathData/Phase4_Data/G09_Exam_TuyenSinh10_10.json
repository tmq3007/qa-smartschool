      "difficulty": "Medium",
      "question": "Giải: 2x+3y=13, x-y=1",
      "options": [
        "A) x=2, y=3",
        "B) x=3, y=2",
        "C) x=4, y=1",
        "D) x=3.2, y=2.2"
      ],
      "answer": "D",
      "solution": "Từ PT2: x=1+y. Thế vào PT1: 2(1+y)+3y=13. 2+5y=13. y=2.2. x=3.2"
    },
