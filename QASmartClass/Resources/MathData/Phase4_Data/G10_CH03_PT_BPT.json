          "name": "Hệ PT bậc nhất 3 ẩn",
          "method": "Gauss: khử ẩn từng bước"
        },
        {
          "id": "pt_008",
          "name": "Hệ PT 1 bậc nhất - 1 bậc hai",
          "method": "Rút từ PT bậc nhất, thế vào PT bậc hai"
        },
        {
          "id": "pt_009",
          "name": "Bài toán thực tế",
          "method": "Gọi ẩn → Lập PT/Hệ PT → Giải → Kết luận"
        }
      ],
      "problems": [
        {
          "problemId": "pt_prob_007",
          "difficulty": "Easy",
          "question": "Giải hệ: 2x+y=7, x-3y=0",
          "options": [
            "A) (3;1)",
            "B) (1;3)",
            "C) (3;-1)",
            "D) (7;0)"
          ],
          "correctAnswer": "A",
          "solution": "Từ PT2: x=3y. Thế: 6y+y=7→y=1→x=3",
          "points": 10
        },
        {
          "problemId": "pt_prob_008",
          "difficulty": "Medium",
          "question": "Giải hệ: x+y=3, xy=2",
          "options": [
            "A) (1;2) và (2;1)",
            "B) (1;2)",
            "C) Vô nghiệm",
            "D) (3;0)"
          ],
          "correctAnswer": "A",
          "solution": "x,y là nghiệm t²-3t+2=0→t=1,2. Hai nghiệm: (1;2) và (2;1)",
          "points": 15
        },
        {
          "problemId": "pt_prob_009",
          "difficulty": "Hard",
          "question": "Hai số có tổng 10, tổng bình phương 52. Tích 2 số là:",
          "options": [
            "A) 24",
            "B) 21",
            "C) 25",
            "D) 20"
          ],
          "correctAnswer": "A",
          "solution": "x+y=10, x²+y²=52. (x+y)²=x²+2xy+y²→100=52+2xy→xy=24",
          "points": 20
        },
        {
          "problemId": "pt_prob_010",
          "difficulty": "Medium",
          "question": "Giải hệ: x+y+z=6, x-y+z=2, 2x+y-z=1",
          "options": [
            "A) (1;2;3)",
            "B) (2;1;3)",
            "C) (3;2;1)",
            "D) (1;3;2)"
          ],
          "correctAnswer": "A",
          "solution": "PT1+PT2: 2x+2z=8→x+z=4. PT1-PT2: 2y=4→y=2. PT3: 2x-z=1-2=-1. Hệ: x+z=4, 2x-z=-1→3x=3→x=1→z=3",
          "points": 15
        }
      ]
    }
