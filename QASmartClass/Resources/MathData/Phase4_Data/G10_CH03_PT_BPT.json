      "order": 1,
      "concepts": [
        {
          "id": "pt_001",
          "name": "PT trùng phương",
          "formula": "ax⁴+bx²+c=0. Đặt t=x²≥0 → at²+bt+c=0"
        },
        {
          "id": "pt_002",
          "name": "PT bậc 3 (có nghiệm hữu tỉ)",
          "method": "Tìm nghiệm a: f(a)=0, chia Horner → bậc 2"
        },
        {
          "id": "pt_003",
          "name": "PT chứa căn",
          "method": "Điều kiện + Bình phương 2 vế + Kiểm tra"
        }
      ],
      "problems": [
        {
          "problemId": "pt_prob_001",
          "difficulty": "Easy",
          "question": "Giải: x⁴-5x²+4=0",
          "options": [
            "A) x=±1,±2",
            "B) x=±1,±4",
            "C) x=1,4",
            "D) x=±2"
          ],
          "correctAnswer": "A",
          "solution": "Đặt t=x²≥0: t²-5t+4=0→t=1,4. x²=1→x=±1; x²=4→x=±2",
          "points": 10
        },
        {
          "problemId": "pt_prob_002",
          "difficulty": "Medium",
          "question": "Giải: x³-3x²+2x=0",
          "options": [
            "A) x=0,1,2",
            "B) x=0,-1,-2",
            "C) x=1,2",
            "D) x=0,1"
          ],
          "correctAnswer": "A",
          "solution": "x(x²-3x+2)=0→x(x-1)(x-2)=0→x=0,1,2",
          "points": 15
        },
        {
          "problemId": "pt_prob_003",
          "difficulty": "Hard",
          "question": "Giải: √(x+3)=x+1",
          "options": [
            "A) x=1",
            "B) x=-2,1",
            "C) x=-2",
            "D) Vô nghiệm"
          ],
          "correctAnswer": "A",
          "solution": "ĐK: x≥-3, x+1≥0→x≥-1. BP: x+3=x²+2x+1→x²+x-2=0→x=1,-2. Loại x=-2 (không thỏa ĐK x≥-1). x=1✓",
          "points": 20
        }
      ]
    },
    {
      "sectionId": "pt_02",
      "sectionName": "BPT nâng cao",
      "order": 2,
      "concepts": [
        {
          "id": "pt_004",
          "name": "BPT chứa ẩn ở mẫu",
          "method": "Quy đồng, xét dấu, KHÔNG nhân chéo nếu chưa biết dấu mẫu"
        },
        {
          "id": "pt_005",
          "name": "BPT chứa trị tuyệt đối",
          "formulas": [
            "|f(x)|<a ⟺ -a<f(x)<a (a>0)",
            "|f(x)|>a ⟺ f(x)<-a hoặc f(x)>a"
          ]
        },
        {
          "id": "pt_006",
          "name": "BPT tích/thương",
          "method": "Xét dấu từng nhân tử, lập bảng xét dấu"
        }
      ],
      "problems": [
        {
          "problemId": "pt_prob_004",
          "difficulty": "Easy",
          "question": "Giải: |2x-3|<5",
          "options": [
            "A) -1<x<4",
            "B) x<-1 hoặc x>4",
            "C) -4<x<1",
            "D) x>4"
          ],
          "correctAnswer": "A",
          "solution": "-5<2x-3<5→-2<2x<8→-1<x<4",
          "points": 10
        },
        {
          "problemId": "pt_prob_005",
          "difficulty": "Medium",
          "question": "Giải: (x-1)/(x+2)≥0",
          "options": [
            "A) x<-2 hoặc x≥1",
            "B) -2<x<1",
            "C) x≤-2 hoặc x≥1",
            "D) x>1"
          ],
          "correctAnswer": "A",
          "solution": "Xét dấu: tử x-1=0↔x=1, mẫu x+2=0↔x=-2. Bảng xét dấu→f≥0 khi x<-2 hoặc x≥1",
          "points": 15
        },
        {
          "problemId": "pt_prob_006",
          "difficulty": "Hard",
          "question": "Giải: x/(x-1) + 2/(x+1) ≤ 1",
          "options": [
            "A) (-1;0]∪(1;3]",
            "B) x≤0",
            "C) [0;1)∪[3;+∞)",
            "D) (-∞;-1)∪[0;1)"
          ],
          "correctAnswer": "A",
          "solution": "Quy đồng: [x(x+1)+2(x-1)-(x²-1)]/[(x-1)(x+1)]≤0\n=[x²+x+2x-2-x²+1]/[...]=[3x-1]/[(x-1)(x+1)]≤0\nXét dấu→nghiệm: (-1;1/3]∪(1;+∞)... Nghiệm: (-1;1/3]∪(1;+∞)",
          "points": 25
        }
      ]
    },
    {
