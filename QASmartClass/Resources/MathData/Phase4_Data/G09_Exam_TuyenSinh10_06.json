      "question": "sin 150° = ?",
      "options": [
        "A) 1/2",
        "B) -1/2",
        "C) √3/2",
        "D) -√3/2"
      ],
      "answer": "A",
      "solution": "sin150° = sin(180°-30°) = sin30° = 1/2 (góc phần tư II, sin > 0)"
