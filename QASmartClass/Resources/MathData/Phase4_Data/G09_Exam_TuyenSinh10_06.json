      "topic": "multiple_choice",
      "difficulty": "Hard",
      "question": "Từ điểm A bên ngoài (O;r), kẻ 2 tiếp tuyến AB, AC. Nếu OA=10, r=6 thì AB=?",
      "options": [
        "A) 8",
        "B) 4",
        "C) 12",
        "D) √136"
      ],
      "answer": "A",
      "solution": "OB⊥AB. Pytago: AB = √(OA²-OB²) = √(100-36) = √64 = 8"
    },
