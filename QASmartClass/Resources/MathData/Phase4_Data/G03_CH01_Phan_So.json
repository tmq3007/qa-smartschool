          "name": "Cộng trừ số thập phân",
          "definition": "Đặt dấu phẩy thẳng hàng rồi tính như số tự nhiên",
          "examples": [
            "1,5 + 2,3 = 3,8",
            "5,0 - 1,7 = 3,3"
          ]
        }
