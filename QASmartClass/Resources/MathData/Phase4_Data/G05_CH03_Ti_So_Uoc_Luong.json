      "sectionId": "tl5_01",
      "sectionName": "Tỉ số & Tỉ lệ",
      "order": 1,
      "concepts": [
        {
          "id": "tl5_001",
          "name": "Tỉ số",
          "definition": "So sánh 2 đại lượng bằng phép chia. a:b = a/b",
          "examples": [
            "3 nam : 5 nữ = tỉ số 3/5",
            "Bản đồ 1:100.000 → 1 cm = 1 km"
          ]
        },
        {
          "id": "tl5_002",
          "name": "Tỉ lệ bản đồ",
          "definition": "1:n nghĩa là 1 đơn vị trên bản đồ = n đơn vị thực tế",
          "examples": [
            "Tỉ lệ 1:50.000 → 2 cm trên bản đồ = 2 × 50.000 = 100.000 cm = 1 km"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "tl5_p01",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Lớp 15 nam, 20 nữ. Tỉ số nam/nữ = ?",
          "options": [
            "A) 15/20 = 3/4",
            "B) 20/15",
            "C) 15/35",
            "D) 20/35"
          ],
          "correctAnswer": "A",
          "solution": "Tỉ số nam/nữ = 15/20 = 3/4",
          "points": 5
        },
        {
          "problemId": "tl5_p02",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Bản đồ tỉ lệ 1:200.000. Đoạn AB trên bản đồ = 3 cm. Thực tế = ? km",
          "options": [
            "A) 3 km",
            "B) 6 km",
            "C) 60 km",
            "D) 600 km"
          ],
          "correctAnswer": "B",
          "solution": "3 × 200.000 = 600.000 cm = 6 km",
          "points": 10
        },
        {
          "problemId": "tl5_p03",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Chia 60 viên kẹo theo tỉ lệ 2:3 cho An và Bình. An được mấy viên?",
          "options": [
            "A) 20",
            "B) 24",
            "C) 30",
            "D) 36"
          ],
          "correctAnswer": "B",
          "solution": "Tổng phần = 2+3 = 5. An = 60 × 2/5 = 24 viên",
          "points": 10
        },
        {
          "problemId": "tl5_p04",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Trộn nước cam:nước theo tỉ lệ 1:4. Cần 3 lít nước cam thì cần bao nhiêu lít nước?",
          "options": [
            "A) 9 lít",
            "B) 12 lít",
            "C) 15 lít",
            "D) 4 lít"
          ],
          "correctAnswer": "B",
          "solution": "1 phần cam = 3 lít → 1 phần = 3 lít. 4 phần nước = 4 × 3 = 12 lít",
          "points": 15
        },
        {
          "problemId": "tl5_p05",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "A:B:C = 2:3:5. Tổng = 200. C = ?",
          "options": [
            "A) 80",
            "B) 100",
            "C) 60",
            "D) 40"
          ],
          "correctAnswer": "B",
          "solution": "Tổng phần = 10. C = 200 × 5/10 = 100",
          "points": 15
        },
        {
          "problemId": "tl5_p06",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Tỉ lệ 1:100. 5 cm trên giấy = ? cm thực tế",
          "options": [
            "A) 100 cm",
            "B) 500 cm",
            "C) 50 cm",
            "D) 5000 cm"
          ],
          "correctAnswer": "B",
          "solution": "5 × 100 = 500 cm = 5 m",
          "points": 5
        }
      ]
    },
    {
      "sectionId": "tl5_02",
      "sectionName": "Ước lượng & Làm tròn",
      "order": 2,
      "concepts": [
        {
          "id": "tl5_003",
          "name": "Làm tròn số",
          "definition": "Nếu chữ số sau vị trí làm tròn ≥ 5 → tăng 1, < 5 → giữ nguyên",
          "examples": [
            "3,47 ≈ 3,5 (làm tròn 1 chữ số TP)",
            "1.648 ≈ 1.700 (làm tròn hàng trăm)"
          ]
        },
        {
          "id": "tl5_004",
          "name": "Ước lượng kết quả",
          "definition": "Dùng số tròn để tính nhanh gần đúng",
          "examples": [
            "49 × 21 ≈ 50 × 20 = 1000 (chính xác: 1029)"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "tl5_p07",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Làm tròn 3,74 đến hàng đơn vị = ?",
          "options": [
            "A) 3",
            "B) 3,7",
            "C) 4",
            "D) 3,8"
          ],
          "correctAnswer": "C",
          "solution": "Chữ số sau hàng đơn vị là 7 ≥ 5 → tăng 1: 3 → 4",
          "points": 5
        },
        {
          "problemId": "tl5_p08",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "Ước lượng: 198 × 52 ≈ ?",
          "options": [
            "A) 8.000",
            "B) 10.000",
            "C) 12.000",
            "D) 15.000"
          ],
          "correctAnswer": "B",
          "solution": "198 ≈ 200, 52 ≈ 50. 200 × 50 = 10.000 (chính xác: 10.296)",
          "points": 10
        },
        {
          "problemId": "tl5_p09",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Làm tròn 4.567 đến hàng trăm = ?",
          "options": [
            "A) 4.500",
            "B) 4.600",
            "C) 4.570",
            "D) 5.000"
          ],
          "correctAnswer": "B",
          "solution": "Hàng chục = 6 ≥ 5 → hàng trăm tăng 1: 4.600",
          "points": 10
        },
        {
          "problemId": "tl5_p10",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Ước lượng: 3,14 × 7² ≈ ?",
