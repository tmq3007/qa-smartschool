  "sections": [
    {
      "sectionId": "calc_12_04_01",
      "sectionName": "Số phức và các phép toán",
      "order": 1,
      "concepts": [
        {
          "id": "sp_001",
          "name": "Định nghĩa số phức",
          "definition": "Số phức z có dạng z = a + bi, trong đó a, b ∈ ℝ và i² = -1",
          "details": {
            "realPart": "a = Re(z): phần thực",
            "imaginaryPart": "b = Im(z): phần ảo",
            "imaginaryUnit": "i = √(-1), i² = -1, i³ = -i, i⁴ = 1"
          },
          "examples": [
            {
              "z": "3 + 2i",
              "real": 3,
              "imaginary": 2
            },
            {
              "z": "5 - 4i",
              "real": 5,
              "imaginary": -4
            },
            {
              "z": "-2i",
              "real": 0,
              "imaginary": -2
            },
            {
              "z": "7",
              "real": 7,
              "imaginary": 0
            }
          ]
        },
        {
          "id": "sp_002",
          "name": "Số phức bằng nhau",
          "definition": "z₁ = z₂ ⟺ a₁ = a₂ và b₁ = b₂",
          "formula": "a₁ + b₁i = a₂ + b₂i ⟺ a₁ = a₂, b₁ = b₂"
        },
        {
          "id": "sp_003",
          "name": "Số phức liên hợp",
          "definition": "Số phức liên hợp của z = a + bi là z̄ = a - bi",
          "properties": [
            "z + z̄ = 2a (số thực)",
            "z · z̄ = a² + b² (số thực không âm)",
            "z̄̄ = z",
            "Liên hợp(z₁ + z₂) = z̄₁ + z̄₂",
            "Liên hợp(z₁ · z₂) = z̄₁ · z̄₂"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "sp_prob_001",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Cho z = 3 - 5i. Phần thực và phần ảo của z là:",
          "options": [
            "A) a=3, b=5",
            "B) a=3, b=-5",
            "C) a=-5, b=3",
            "D) a=3, b=5i"
          ],
          "correctAnswer": "B",
          "solution": "z = a + bi = 3 + (-5)i → a = 3 (phần thực), b = -5 (phần ảo)",
          "points": 10
        },
        {
          "problemId": "sp_prob_002",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Số phức liên hợp của z = 2 + 3i là:",
          "options": [
            "A) -2 - 3i",
            "B) 2 - 3i",
            "C) -2 + 3i",
            "D) 3 + 2i"
          ],
          "correctAnswer": "B",
          "solution": "z̄ = a - bi = 2 - 3i",
          "points": 10
        },
        {
          "problemId": "sp_prob_003",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "Tìm x, y ∈ ℝ biết (2x - 1) + (3y + 2)i = 5 + 8i",
          "options": [
            "A) x=3, y=2",
            "B) x=2, y=3",
            "C) x=3, y=-2",
            "D) x=2, y=2"
          ],
          "correctAnswer": "A",
          "solution": "Đồng nhất phần thực và phần ảo:\n2x - 1 = 5 → x = 3\n3y + 2 = 8 → y = 2",
          "points": 15
        },
        {
          "problemId": "sp_prob_004",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Tính z · z̄ với z = 4 - 3i",
          "options": [
            "A) 25",
            "B) 7",
            "C) -7",
            "D) 24"
          ],
          "correctAnswer": "A",
          "solution": "z · z̄ = (4 - 3i)(4 + 3i) = 16 + 12i - 12i - 9i² = 16 + 9 = 25",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "calc_12_04_02",
      "sectionName": "Phép toán số phức",
      "order": 2,
      "concepts": [
        {
          "id": "sp_004",
          "name": "Phép cộng và trừ",
          "formulas": [
            "(a + bi) + (c + di) = (a+c) + (b+d)i",
            "(a + bi) - (c + di) = (a-c) + (b-d)i"
          ]
        },
        {
          "id": "sp_005",
          "name": "Phép nhân",
          "formula": "(a + bi)(c + di) = (ac - bd) + (ad + bc)i",
          "note": "Nhớ i² = -1"
        },
        {
          "id": "sp_006",
          "name": "Phép chia",
          "formula": "(a + bi)/(c + di) = [(a + bi)(c - di)] / (c² + d²)",
          "method": "Nhân cả tử và mẫu với liên hợp của mẫu"
        }
      ],
      "problems": [
        {
          "problemId": "sp_prob_005",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Tính (3 + 2i) + (1 - 5i)",
          "options": [
            "A) 4 - 3i",
            "B) 4 + 3i",
            "C) 2 - 7i",
            "D) 4 - 7i"
          ],
          "correctAnswer": "A",
          "solution": "(3+1) + (2-5)i = 4 - 3i",
          "points": 10
        },
        {
          "problemId": "sp_prob_006",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Tính (2 + 3i)(1 - 4i)",
          "options": [
            "A) 14 - 5i",
            "B) 2 - 5i",
            "C) 14 + 5i",
            "D) -10 - 5i"
          ],
          "correctAnswer": "A",
          "solution": "= 2·1 + 2·(-4i) + 3i·1 + 3i·(-4i)\n= 2 - 8i + 3i - 12i²\n= 2 - 5i + 12 = 14 - 5i",
          "points": 15
        },
        {
          "problemId": "sp_prob_007",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tính (3 + i)/(1 - 2i)",
          "options": [
            "A) 1/5 + 7i/5",
            "B) 3/5 + i/5",
            "C) 1 + 7i",
            "D) 7/5 + i/5"
          ],
          "correctAnswer": "A",
          "solution": "Nhân liên hợp:\n= (3+i)(1+2i) / [(1-2i)(1+2i)]\n= (3+6i+i+2i²) / (1+4)\n= (3+7i-2) / 5\n= (1+7i)/5 = 1/5 + 7i/5",
          "points": 20
        },
        {
          "problemId": "sp_prob_008",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tính i²⁰²⁶",
          "options": [
            "A) -1",
            "B) 1",
            "C) i",
            "D) -i"
          ],
          "correctAnswer": "A",
          "solution": "i¹=i, i²=-1, i³=-i, i⁴=1, chu kỳ 4.\n2026 = 4×506 + 2\nVậy i²⁰²⁶ = i² = -1",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "calc_12_04_03",
      "sectionName": "Mô-đun và biểu diễn hình học",
      "order": 3,
      "concepts": [
        {
          "id": "sp_007",
          "name": "Mô-đun số phức",
          "definition": "|z| = √(a² + b²)",
          "properties": [
            "|z| ≥ 0, |z| = 0 ⟺ z = 0",
            "|z₁ · z₂| = |z₁| · |z₂|",
            "|z₁/z₂| = |z₁|/|z₂|",
            "|z̄| = |z|",
            "|z|² = z · z̄"
          ]
        },
        {
          "id": "sp_008",
          "name": "Biểu diễn hình học",
          "definition": "Số phức z = a + bi ↔ điểm M(a, b) trên mặt phẳng Oxy",
          "details": {
            "trục_thực": "Ox — chứa các số thực (b = 0)",
            "trục_ảo": "Oy — chứa các số ảo thuần túy (a = 0)",
            "mô_đun": "|z| = khoảng cách từ M đến gốc O"
          }
        },
        {
          "id": "sp_009",
          "name": "Dạng lượng giác",
          "formula": "z = r(cosφ + i·sinφ)",
          "details": {
            "r": "|z| = √(a² + b²)",
            "φ": "argument — góc giữa OM và Ox",
            "tanφ": "b/a"
          }
        }
      ],
      "problems": [
        {
          "problemId": "sp_prob_009",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Mô-đun của z = 3 + 4i bằng:",
          "options": [
            "A) 7",
            "B) 5",
            "C) 25",
            "D) √7"
          ],
          "correctAnswer": "B",
          "solution": "|z| = √(3² + 4²) = √(9 + 16) = √25 = 5",
          "points": 10
        },
        {
          "problemId": "sp_prob_010",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "Tập hợp điểm biểu diễn số phức z thỏa |z - (1+i)| = 2 là:",
          "options": [
            "A) Đường thẳng",
            "B) Đường tròn tâm (1,1) bán kính 2",
            "C) Đường tròn tâm (1,-1) bán kính 2",
            "D) Elip"
          ],
          "correctAnswer": "B",
          "solution": "|z - (1+i)| = 2 nghĩa là khoảng cách từ điểm M(a,b) biểu diễn z đến điểm A(1,1) bằng 2 → đường tròn tâm (1,1) bán kính 2",
          "points": 15
        },
        {
          "problemId": "sp_prob_011",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tìm mô-đun của z = (1+i)⁶",
          "options": [
            "A) 8",
            "B) 4",
            "C) 2√2",
            "D) 16"
          ],
          "correctAnswer": "A",
          "solution": "|1+i| = √2\n|(1+i)⁶| = |1+i|⁶ = (√2)⁶ = 2³ = 8",
          "points": 20
        },
        {
          "problemId": "sp_prob_012",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Tìm tập hợp các điểm M biểu diễn z thỏa |z - 2| = |z + 2i|",
          "options": [
            "A) Đường thẳng y = -x",
            "B) Đường thẳng y = x",
            "C) Đường tròn tâm O bán kính 2",
            "D) Đường thẳng x + y = 2"
          ],
          "correctAnswer": "A",
          "solution": "Gọi z = x + yi.\n|z - 2| = |z + 2i|\n√((x-2)² + y²) = √(x² + (y+2)²)\n(x-2)² + y² = x² + (y+2)²\nx² - 4x + 4 + y² = x² + y² + 4y + 4\n-4x = 4y → y = -x\nTập hợp: đường thẳng y = -x",
          "points": 20
        }
      ]
    },
    {
      "sectionId": "calc_12_04_04",
      "sectionName": "Phương trình bậc hai với số phức",
      "order": 4,
      "concepts": [
        {
          "id": "sp_010",
          "name": "PT bậc hai có Δ < 0",
          "definition": "ax² + bx + c = 0 (a≠0) với Δ = b² - 4ac < 0 có 2 nghiệm phức liên hợp",
          "formula": "x = (-b ± i√|Δ|) / (2a)"
        },
        {
          "id": "sp_011",
          "name": "Căn bậc hai số phức",
          "formula": "√(a + bi) = ±(x + yi) với x² - y² = a và 2xy = b"
        }
      ],
      "problems": [
        {
          "problemId": "sp_prob_013",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Giải phương trình z² + 2z + 5 = 0",
          "options": [
            "A) z = -1 ± 2i",
            "B) z = 1 ± 2i",
            "C) z = -2 ± i",
            "D) z = -1 ± 4i"
          ],
          "correctAnswer": "A",
          "solution": "Δ = 4 - 20 = -16 < 0\nz = (-2 ± i√16) / 2 = (-2 ± 4i) / 2\nz₁ = -1 + 2i, z₂ = -1 - 2i",
          "points": 15
        },
        {
          "problemId": "sp_prob_014",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Giải phương trình z² - (3+i)z + (2+i) = 0",
          "options": [
            "A) z₁ = 2+i, z₂ = 1",
            "B) z₁ = 3+i, z₂ = 2",
            "C) z₁ = 1+i, z₂ = 2",
            "D) z₁ = 2-i, z₂ = 1+i"
          ],
          "correctAnswer": "A",
          "solution": "Δ = (3+i)² - 4(2+i) = 9+6i-1-8-4i = 2i\n√(2i): đặt (x+yi)² = 2i → x²-y²=0, 2xy=2\nx=y → 2x²=2 → x=1, y=1\n√Δ = 1+i\nz = [(3+i) ± (1+i)] / 2\nz₁ = (4+2i)/2 = 2+i\nz₂ = (2+0i)/2 = 1",
          "points": 20
        },
        {
          "problemId": "sp_prob_015",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Phương trình z² + 4 = 0 có nghiệm là:",
          "options": [
            "A) z = ±2",
            "B) z = ±2i",
            "C) z = ±4i",
            "D) Vô nghiệm"
          ],
          "correctAnswer": "B",
          "solution": "z² = -4 → z = ±√(-4) = ±2i",
          "points": 10
        },
        {
          "problemId": "sp_prob_016",
          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "Cho z thỏa |z - 1 - i| = 1 và |z| đạt giá trị lớn nhất. Tìm z.",
          "options": [
            "A) 1 + i + (1+i)/√2",
            "B) 1 + i + √2",
            "C) (1 + √2/2) + (1 + √2/2)i",
            "D) 2 + 2i"
          ],
          "correctAnswer": "C",
          "solution": "|z - (1+i)| = 1: đường tròn tâm I(1,1), R=1.\n|z| max khi z nằm trên tia OI phía xa O nhất.\nOI = √2, |z|_max = √2 + 1.\nHướng OI: (1/√2, 1/√2).\nz = (1+1/√2) + (1+1/√2)i",
          "points": 25
        }
      ]
    }
  ],
