        {
          "problemId": "tt3_p02",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Kim ngắn chỉ số 3, kim dài chỉ số 12. Mấy giờ?",
          "options": [
            "A) 12:03",
            "B) 3:00",
            "C) 3:12",
            "D) 12:15"
