          "name": "Giờ và phút",
          "definition": "1 giờ = 60 phút. Kim dài chỉ phút, kim ngắn chỉ giờ",
          "examples": [
            "8 giờ 30 phút = 8:30",
            "2 giờ 15 phút chiều = 14:15"
          ]
        },
        {
          "id": "tt3_002",
          "name": "Tính khoảng thời gian",
          "definition": "Lấy thời điểm sau trừ thời điểm trước",
          "examples": [
