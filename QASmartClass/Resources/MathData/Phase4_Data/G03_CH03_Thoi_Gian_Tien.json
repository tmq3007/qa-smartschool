          ]
        }
      ],
      "problems": [
        {
          "problemId": "tt3_p01",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "1 giờ = bao nhiêu phút?",
          "options": [
            "A) 30 phút",
            "B) 50 phút",
