        {
          "problemId": "tt3_p03",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Buổi học bắt đầu 7:30, kết thúc 11:00. Học bao lâu?",
          "options": [
            "A) 3 giờ",
            "B) 3 giờ 30 phút",
            "C) 4 giờ",
            "D) 4 giờ 30 phút"
          ],
          "correctAnswer": "B",
          "solution": "Từ 7:30 → 11:00 = 3 giờ 30 phút",
          "points": 10
        },
        {
          "problemId": "tt3_p04",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Bạn An đi ngủ lúc 21:00, thức dậy lúc 6:30. An ngủ bao lâu?",
          "options": [
            "A) 8 giờ 30 phút",
            "B) 9 giờ",
            "C) 9 giờ 30 phút",
            "D) 10 giờ"
          ],
          "correctAnswer": "C",
          "solution": "21:00 → 6:30 hôm sau = 9 giờ 30 phút",
          "points": 10
        },
        {
          "problemId": "tt3_p05",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "1,5 giờ = bao nhiêu phút?",
          "options": [
            "A) 75 phút",
            "B) 80 phút",
            "C) 90 phút",
            "D) 150 phút"
          ],
          "correctAnswer": "C",
          "solution": "1,5 giờ = 1 giờ 30 phút = 60 + 30 = 90 phút",
          "points": 15
        },
        {
          "problemId": "tt3_p06",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tàu đi lúc 8:45, tới nơi lúc 13:20. Tàu chạy bao lâu?",
          "options": [
            "A) 4 giờ 25 phút",
            "B) 4 giờ 35 phút",
            "C) 5 giờ 25 phút",
            "D) 5 giờ 35 phút"
          ],
          "correctAnswer": "B",
          "solution": "8:45 → 13:20. Giờ: 13-8=5. Phút: 20-45=-25 → mượn 1 giờ: 4 giờ 35 phút",
          "points": 15
        }
      ]
