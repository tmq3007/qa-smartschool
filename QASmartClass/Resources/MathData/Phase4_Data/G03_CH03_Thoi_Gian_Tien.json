    {
      "sectionId": "tt3_02",
      "sectionName": "Tiền Việt Nam (VNĐ)",
      "order": 2,
      "concepts": [
        {
          "id": "tt3_003",
          "name": "Các mệnh giá tiền",
          "definition": "Tiền xu: 200đ, 500đ, 1.000đ, 2.000đ. Tiền giấy: 5.000đ → 500.000đ",
          "examples": [
            "Mệnh giá 50.000đ → tờ tiền polymer màu hồng"
          ]
        },
        {
          "id": "tt3_004",
          "name": "Tính tiền mua hàng",
          "definition": "Tổng tiền = giá × số lượng. Tiền thừa = tiền đưa - tổng tiền",
          "examples": [
            "Mua 3 quyển vở 8.000đ → 3 × 8.000 = 24.000đ"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "tt3_p07",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Tờ tiền polymer màu xanh lá, giá trị 100.000đ. Đổi được mấy tờ 10.000đ?",
          "options": [
            "A) 5",
            "B) 10",
            "C) 50",
            "D) 100"
          ],
          "correctAnswer": "B",
          "solution": "100.000 ÷ 10.000 = 10 tờ",
          "points": 5
        },
        {
          "problemId": "tt3_p08",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Mua bút 5.000đ, vở 8.000đ. Tổng = ?",
          "options": [
            "A) 12.000đ",
            "B) 13.000đ",
            "C) 15.000đ",
            "D) 10.000đ"
          ],
          "correctAnswer": "B",
          "solution": "5.000 + 8.000 = 13.000đ",
          "points": 5
        },
        {
          "problemId": "tt3_p09",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Mua 4 cái bánh, mỗi cái 7.500đ. Đưa 50.000đ. Tiền thừa = ?",
          "options": [
            "A) 15.000đ",
            "B) 20.000đ",
            "C) 22.500đ",
            "D) 10.000đ"
          ],
          "correctAnswer": "B",
          "solution": "4 × 7.500 = 30.000đ. 50.000 - 30.000 = 20.000đ thừa",
          "points": 10
        },
        {
          "problemId": "tt3_p10",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "Bạn An có 2 tờ 20.000đ và 1 tờ 5.000đ. An có tổng cộng bao nhiêu?",
          "options": [
            "A) 25.000đ",
            "B) 40.000đ",
            "C) 45.000đ",
            "D) 50.000đ"
          ],
          "correctAnswer": "C",
          "solution": "2 × 20.000 + 5.000 = 40.000 + 5.000 = 45.000đ",
          "points": 10
        },
        {
          "problemId": "tt3_p11",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Sách giá 120.000đ giảm 25%. Giá sau giảm = ?",
          "options": [
            "A) 80.000đ",
            "B) 90.000đ",
            "C) 95.000đ",
            "D) 100.000đ"
          ],
          "correctAnswer": "B",
          "solution": "Giảm 25% = giảm 1/4 = 120.000 ÷ 4 = 30.000đ. Còn: 120.000 - 30.000 = 90.000đ",
          "points": 15
        },
        {
          "problemId": "tt3_p12",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Mua 3 quyển sách giá 45.000đ/quyển và 2 cây bút 12.000đ/cây. Đưa 200.000đ. Thừa?",
          "options": [
            "A) 31.000đ",
            "B) 41.000đ",
            "C) 51.000đ",
            "D) 61.000đ"
          ],
          "correctAnswer": "A",
          "solution": "3×45.000=135.000. 2×12.000=24.000. Tổng=159.000. Thừa=200.000-159.000=41.000",
          "points": 15
        }
      ]
    },
