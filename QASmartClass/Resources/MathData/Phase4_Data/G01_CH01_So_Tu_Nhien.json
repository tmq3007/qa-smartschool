        {
          "id": "stn_001",
          "name": "Đếm từ 1 đến 10",
          "definition": "Đếm số lượng đồ vật, liên kết số với hình ảnh thực tế",
          "examples": [
            "1 quả táo = số 1",
            "5 ngón tay = số 5",
            "10 viên bi = số 10"
          ]
        },
        {
          "id": "stn_002",
          "name": "Số hàng chục (10-100)",
          "definition": "Số có 2 chữ số gồm hàng chục và hàng đơn vị",
          "examples": [
            "23 = 2 chục + 3 đơn vị",
            "50 = 5 chục + 0 đơn vị"
          ]
        }
      ],
      "problems": [
