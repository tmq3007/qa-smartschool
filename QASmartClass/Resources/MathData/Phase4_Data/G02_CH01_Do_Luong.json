      "concepts": [
        {
          "id": "dl_005",
          "name": "Đơn vị thời gian",
          "definition": "1 giờ = 60 phút, 1 phút = 60 giây, 1 ngày = 24 giờ, 1 tuần = 7 ngày",
          "examples": [
            "Tiết học = 45 phút",
            "Bữa ăn trưa khoảng 30 phút"
          ]
        },
        {
          "id": "dl_006",
          "name": "Xem đồng hồ",
          "definition": "Kim giờ ngắn chỉ giờ, kim phút dài chỉ phút",
          "examples": [
            "Kim giờ chỉ 3, kim phút chỉ 12 → 3 giờ đúng",
            "Kim giờ chỉ giữa 7 và 8, kim phút chỉ 6 → 7 giờ 30 phút"
          ]
        },
        {
          "id": "dl_007",
          "name": "Tính thời gian",
          "definition": "Thời gian = Giờ kết thúc - Giờ bắt đầu",
          "examples": [
            "Học từ 7:30 đến 11:00 → 3 giờ 30 phút"
          ]
        }
      ],
