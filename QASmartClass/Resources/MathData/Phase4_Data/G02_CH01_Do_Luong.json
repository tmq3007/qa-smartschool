          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "Một bao gạo nặng 50kg. Đã dùng hết 12kg 500g. Còn lại bao nhiêu?",
          "options": [
            "A) 37kg 500g",
            "B) 38kg 500g",
            "C) 37kg",
            "D) 47kg 500g"
          ],
          "correctAnswer": "A",
          "solution": "50kg - 12kg 500g = 49kg 1000g - 12kg 500g = 37kg 500g",
