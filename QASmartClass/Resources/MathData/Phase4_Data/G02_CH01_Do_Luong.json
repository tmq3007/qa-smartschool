      "sectionName": "Đo độ dài",
      "order": 1,
      "concepts": [
        {
          "id": "dl_001",
          "name": "Đơn vị đo độ dài",
          "definition": "cm (xăng-ti-mét), m (mét), km (ki-lô-mét). 1m = 100cm, 1km = 1000m",
          "examples": [
            "Cây bút dài khoảng 15cm",
            "Sân trường dài khoảng 50m",
            "Từ nhà đến trường khoảng 2km"
          ]
        },
        {
          "id": "dl_002",
          "name": "Đổi đơn vị độ dài",
          "definition": "Nhân hoặc chia cho 10, 100, 1000 để đổi đơn vị",
          "examples": [
            "3m = 300cm",
            "2500m = 2km 500m",
            "1m 50cm = 150cm"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "dl_prob_001",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "1 mét bằng bao nhiêu xăng-ti-mét?",
          "options": [
            "A) 10cm",
            "B) 100cm",
            "C) 1000cm",
            "D) 50cm"
          ],
          "correctAnswer": "B",
          "solution": "1m = 100cm. Mỗi mét chia thành 100 phần bằng nhau, mỗi phần là 1cm",
          "points": 5
        },
        {
          "problemId": "dl_prob_002",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Đổi: 3m 25cm = ? cm",
          "options": [
            "A) 325cm",
            "B) 352cm",
            "C) 3025cm",
            "D) 32cm"
          ],
          "correctAnswer": "A",
          "solution": "3m = 300cm. 300cm + 25cm = 325cm",
          "points": 10
        },
        {
          "problemId": "dl_prob_003",
          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "Một sợi dây dài 2m 40cm. Cắt đi 75cm. Sợi dây còn lại dài bao nhiêu?",
          "options": [
            "A) 1m 65cm",
            "B) 1m 75cm",
            "C) 2m 65cm",
            "D) 1m 55cm"
          ],
          "correctAnswer": "A",
          "solution": "2m 40cm = 240cm. 240cm - 75cm = 165cm = 1m 65cm",
          "points": 15
        }
      ]
    },
    {
