          "definition": "g (gam), kg (ki-lô-gam), tấn. 1kg = 1000g, 1 tấn = 1000kg",
          "examples": [
            "Quả trứng nặng khoảng 60g",
            "Cặp sách nặng khoảng 3kg",
            "Xe ô tô nặng khoảng 2 tấn"
          ]
        },
        {
          "id": "dl_004",
          "name": "So sánh & đổi khối lượng",
          "definition": "Quy về cùng đơn vị rồi so sánh",
          "examples": [
            "2kg 500g = 2500g",
            "1500g = 1kg 500g"
          ]
        }
      ],
      "problems": [
