        {
          "problemId": "dl_prob_005",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Mẹ mua 2kg 300g gạo và 1kg 700g đường. Tổng cộng nặng bao nhiêu?",
          "options": [
            "A) 3kg",
            "B) 4kg",
            "C) 3kg 900g",
            "D) 4kg 100g"
          ],
          "correctAnswer": "B",
          "solution": "2kg 300g + 1kg 700g = 3kg 1000g = 4kg",
