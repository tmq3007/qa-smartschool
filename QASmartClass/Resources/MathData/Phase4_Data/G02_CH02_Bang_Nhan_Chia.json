    {
      "sectionId": "nc2_03",
      "sectionName": "Phép chia tương ứng",
      "order": 3,
      "concepts": [
        {
          "id": "nc2_005",
          "name": "Chia là ngược của nhân",
          "definition": "Nếu a × b = c thì c ÷ a = b",
          "examples": [
            "3 × 4 = 12 → 12 ÷ 3 = 4",
            "5 × 6 = 30 → 30 ÷ 5 = 6"
          ]
        },
        {
          "id": "nc2_006",
          "name": "Chia có dư",
          "definition": "Khi không chia hết, phần thừa gọi là SỐ DƯ",
          "examples": [
            "13 ÷ 4 = 3 dư 1 (vì 4 × 3 = 12, 13 - 12 = 1)",
            "17 ÷ 5 = 3 dư 2"
          ]
        }
      ],
