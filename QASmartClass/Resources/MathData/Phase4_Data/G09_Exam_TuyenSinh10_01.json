      "topic": "calculation",
      "difficulty": "Medium",
      "question": "Giải: 3x+2y=12, x+2y=8",
      "options": [
        "A) x=2, y=3",
        "B) x=4, y=2",
        "C) x=2, y=4",
        "D) x=3, y=1.5"
      ],
      "answer": "A",
      "solution": "Trừ: (3x+2y)-(x+2y)=12-8 → 2x=4 → x=2. y=(12-6)/2=3"
    },
    {
      "id": 2,
      "topic": "calculation",
      "difficulty": "Easy",
      "question": "Tổng 2 số = 20, hiệu = 6. Hai số = ?",
      "options": [
        "A) 13, 7",
        "B) 14, 6",
        "C) 12, 8",
        "D) 15, 5"
      ],
      "answer": "A",
      "solution": "x+y=20, x-y=6. x=(20+6)/2=13. y=20-13=7"
    },
