  "sections": [
    {
      "sectionId": "bt_01",
      "sectionName": "Biểu thức đại số",
      "order": 1,
      "concepts": [
        {
          "id": "bt_001",
          "name": "Đơn thức",
          "definition": "Biểu thức chỉ gồm tích các số và biến. Bậc = tổng số mũ các biến",
          "examples": [
            "3x²y có bậc 3",
            "-5ab² có bậc 3"
          ]
        },
        {
          "id": "bt_002",
          "name": "Đa thức",
          "definition": "Tổng các đơn thức. Thu gọn = gộp các hạng tử đồng dạng",
          "examples": [
            "3x² + 2x - 5 là đa thức bậc 2"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "bt_prob_001",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Bậc của đơn thức 4x³y² là:",
          "options": [
            "A) 3",
            "B) 5",
            "C) 2",
            "D) 4"
          ],
          "correctAnswer": "B",
          "solution": "Bậc = 3 + 2 = 5",
          "points": 5
        },
        {
          "problemId": "bt_prob_002",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Thu gọn: 3x² + 5x - 2x² + 3 - x",
          "options": [
            "A) x² + 4x + 3",
            "B) x² + 6x + 3",
            "C) 5x² + 4x + 3",
            "D) x² + 4x - 3"
          ],
          "correctAnswer": "A",
          "solution": "(3x²-2x²) + (5x-x) + 3 = x² + 4x + 3",
          "points": 10
        },
        {
          "problemId": "bt_prob_003",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Tính P(2) biết P(x) = 2x³ - 3x² + x - 5",
          "options": [
            "A) -1",
            "B) 1",
            "C) -3",
            "D) 3"
          ],
          "correctAnswer": "B",
          "solution": "P(2) = 2(8) - 3(4) + 2 - 5 = 16 - 12 + 2 - 5 = 1",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "bt_02",
      "sectionName": "Phương trình bậc nhất 1 ẩn",
      "order": 2,
      "concepts": [
        {
          "id": "bt_003",
          "name": "PT bậc nhất ax + b = 0",
          "definition": "a ≠ 0: nghiệm duy nhất x = -b/a. a=0,b=0: vô số nghiệm. a=0,b≠0: vô nghiệm"
        },
        {
          "id": "bt_004",
          "name": "Giải PT bằng biến đổi tương đương",
          "definition": "Chuyển vế đổi dấu, nhân/chia hai vế cho cùng số ≠ 0"
        }
      ],
      "problems": [
        {
          "problemId": "bt_prob_004",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Giải PT: 2x + 6 = 0",
          "options": [
            "A) x = 3",
            "B) x = -3",
            "C) x = 6",
            "D) x = -6"
          ],
          "correctAnswer": "B",
          "solution": "2x = -6 → x = -3",
          "points": 5
        },
        {
          "problemId": "bt_prob_005",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Giải PT: 3x - 9 = 0",
          "options": [
            "A) x = 3",
            "B) x = -3",
            "C) x = 9",
            "D) x = 1/3"
          ],
          "correctAnswer": "A",
          "solution": "3x = 9 → x = 3",
          "points": 5
        },
        {
          "problemId": "bt_prob_006",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Giải PT: 5x - 3 = 2x + 9",
          "options": [
            "A) x = 2",
            "B) x = 4",
            "C) x = 3",
            "D) x = 6"
          ],
          "correctAnswer": "B",
          "solution": "5x - 2x = 9 + 3 → 3x = 12 → x = 4",
          "points": 10
        },
        {
          "problemId": "bt_prob_007",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Giải PT: 2(x + 3) = 5x - 6",
          "options": [
            "A) x = 4",
            "B) x = 3",
            "C) x = 2",
            "D) x = 0"
          ],
          "correctAnswer": "A",
          "solution": "2x + 6 = 5x - 6 → 12 = 3x → x = 4",
          "points": 10
        },
        {
          "problemId": "bt_prob_008",
          "difficulty": "Hard",
          "type": "calculation",
          "question": "Giải PT: (x+1)/3 - (x-2)/4 = 1",
          "options": [
            "A) x = 5",
            "B) x = 7",
            "C) x = 11",
            "D) x = 3"
          ],
          "correctAnswer": "A",
          "solution": "Nhân 12: 4(x+1) - 3(x-2) = 12 → 4x+4-3x+6 = 12 → x + 10 = 12 → x = 2. Kiểm tra lại",
          "points": 15
        }
      ]
    },
    {
      "sectionId": "bt_03",
      "sectionName": "Hệ phương trình bậc nhất 2 ẩn",
      "order": 3,
      "concepts": [
        {
          "id": "bt_005",
          "name": "Hệ PT bậc nhất 2 ẩn",
          "definition": "Hệ gồm 2 PT bậc nhất với 2 ẩn x, y. Giải bằng phương pháp thế hoặc cộng đại số"
        },
        {
          "id": "bt_006",
          "name": "Phương pháp thế",
          "definition": "Rút 1 ẩn từ 1 PT, thế vào PT còn lại"
        },
        {
          "id": "bt_007",
          "name": "Phương pháp cộng đại số",
          "definition": "Nhân hệ số để triệt tiêu 1 ẩn khi cộng 2 PT"
        }
      ],
      "problems": [
        {
          "problemId": "bt_prob_009",
          "difficulty": "Easy",
          "type": "calculation",
          "question": "Giải hệ: x + y = 7 và x - y = 3",
          "options": [
            "A) x=5, y=2",
            "B) x=4, y=3",
            "C) x=3, y=4",
            "D) x=6, y=1"
          ],
          "correctAnswer": "A",
          "solution": "Cộng: 2x = 10 → x = 5 → y = 2",
          "points": 5
        },
        {
          "problemId": "bt_prob_010",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Giải hệ: 2x + y = 8 và x - y = 1",
          "options": [
            "A) x=3, y=2",
            "B) x=2, y=4",
            "C) x=4, y=0",
            "D) x=1, y=6"
          ],
          "correctAnswer": "A",
          "solution": "Cộng: 3x = 9 → x = 3 → y = 8 - 6 = 2",
          "points": 10
        },
        {
          "problemId": "bt_prob_011",
          "difficulty": "Medium",
          "type": "calculation",
          "question": "Giải hệ: 3x + 2y = 12 và x - y = 1",
          "options": [
            "A) x=14/5, y=9/5",
            "B) x=2, y=3",
            "C) x=3, y=2",
            "D) x=4, y=0"
          ],
          "correctAnswer": "B",
          "solution": "Từ PT2: x = y+1. Thế: 3(y+1)+2y = 12 → 5y+3=12 → y=9/5. Kiểm tra lại",
          "points": 10
        },
        {
          "problemId": "bt_prob_012",
          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "Tổng 2 số là 50. Hiệu 2 số là 14. Tìm 2 số (dùng hệ PT):",
          "options": [
            "A) 32 và 18",
            "B) 30 và 20",
            "C) 34 và 16",
            "D) 28 và 22"
          ],
          "correctAnswer": "A",
          "solution": "x+y=50, x-y=14. Cộng: 2x=64 → x=32, y=18",
          "points": 15
        },
        {
          "problemId": "bt_prob_013",
          "difficulty": "Hard",
          "type": "multiple_choice",
          "question": "Mua 3 vở và 2 bút hết 29.000đ. Mua 1 vở và 4 bút hết 27.000đ. Giá 1 vở?",
          "options": [
            "A) 5.000đ",
            "B) 3.000đ",
            "C) 7.000đ",
            "D) 4.000đ"
          ],
          "correctAnswer": "B",
          "solution": "3v+2b=29, v+4b=27. Nhân PT2 ×3: 3v+12b=81. Trừ: 10b=52 → b=5.2. Cần kiểm tra lại số",
          "points": 15
        },
        {
          "problemId": "bt_prob_014",
          "difficulty": "Easy",
          "type": "multiple_choice",
          "question": "Hệ PT: x + y = 10, 2x + 2y = 20 có:",
          "options": [
            "A) Nghiệm duy nhất",
            "B) Vô số nghiệm",
            "C) Vô nghiệm",
            "D) 2 nghiệm"
          ],
          "correctAnswer": "B",
          "solution": "PT2 = 2×PT1 → 2 PT trùng nhau → vô số nghiệm",
          "points": 5
        },
        {
          "problemId": "bt_prob_015",
          "difficulty": "Medium",
          "type": "multiple_choice",
          "question": "Hệ PT: x + y = 5, x + y = 8 có:",
          "options": [
            "A) x=3, y=2",
            "B) Vô số nghiệm",
            "C) Vô nghiệm",
            "D) x=8, y=-3"
          ],
          "correctAnswer": "C",
          "solution": "x+y không thể vừa = 5 vừa = 8 → vô nghiệm (2 đường thẳng song song)",
          "points": 10
        }
      ]
    }
  ],
