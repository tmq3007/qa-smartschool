      "topic": "chuyen_de",
      "difficulty": "Medium",
      "question": "Thể tích khối tròn xoay khi quay y=√x (0≤x≤4) quanh Ox:",
      "options": [
        "A) 8π",
        "B) 4π",
        "C) 16π",
        "D) 2π"
      ],
      "answer": "A",
      "solution": "V = π∫₀⁴ (√x)²dx = π∫₀⁴ xdx = π[x²/2]₀⁴ = 8π"
    },
    {
      "id": 2,
      "topic": "chuyen_de",
      "difficulty": "Medium",
      "question": "Giải: 4ˣ - 3·2ˣ + 2 = 0",
      "options": [
        "A) x=0, x=1",
        "B) x=1, x=2",
        "C) x=0, x=2",
        "D) x=-1, x=1"
      ],
      "answer": "A",
      "solution": "Đặt t=2ˣ>0. t²-3t+2=0 → t=1,2. 2ˣ=1→x=0; 2ˣ=2→x=1"
    },
