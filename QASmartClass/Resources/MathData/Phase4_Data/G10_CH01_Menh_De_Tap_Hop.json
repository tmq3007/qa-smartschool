      "sectionId": "md_01",
      "sectionName": "Mệnh đề & Phép suy luận",
      "order": 1,
      "concepts": [
        {
          "id": "md_001",
          "name": "Mệnh đề",
          "definition": "Một câu khẳng định đúng hoặc sai (không vừa đúng vừa sai)",
          "examples": [
            "'3 là số nguyên tố' → Đúng",
            "'2+3=6' → Sai",
            "'x>5' → KHÔNG phải mệnh đề (chưa xác định x)"
          ]
        },
        {
          "id": "md_002",
          "name": "Phủ định",
          "formula": "Phủ định ¬P: đúng khi P sai, sai khi P đúng",
          "rules": [
            "Phủ định ∀ → ∃ không",
            "Phủ định ∃ → ∀ không"
          ]
        },
        {
          "id": "md_003",
          "name": "Kéo theo & Tương đương",
          "formulas": [
            "P ⇒ Q: 'Nếu P thì Q'",
            "P ⇔ Q: 'P khi và chỉ khi Q'"
          ]
        },
        {
          "id": "md_004",
          "name": "Điều kiện cần, đủ",
          "rules": [
            "P ⇒ Q: P là ĐK đủ, Q là ĐK cần",
            "P ⇔ Q: P là ĐK cần và đủ cho Q"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "md_prob_001",
          "difficulty": "Easy",
          "question": "Phủ định của 'Mọi học sinh đều chăm học' là:",
          "options": [
            "A) Mọi HS đều không chăm",
            "B) Có ít nhất 1 HS không chăm",
            "C) Không HS nào chăm",
            "D) Một vài HS chăm"
          ],
          "correctAnswer": "B",
          "solution": "Phủ định ∀x P(x) = ∃x ¬P(x)",
          "points": 10
        },
        {
          "problemId": "md_prob_002",
          "difficulty": "Medium",
          "question": "Cho P: 'x²=4', Q: 'x=2'. Mệnh đề P⇒Q:",
          "options": [
            "A) Đúng",
            "B) Sai",
            "C) Không xác định",
            "D) Tương đương"
          ],
          "correctAnswer": "B",
          "solution": "x²=4 → x=±2. Khi x=-2: P đúng nhưng Q sai → P⇒Q sai",
          "points": 15
        },
        {
          "problemId": "md_prob_003",
          "difficulty": "Hard",
          "question": "Mệnh đề nào sau đây là mệnh đề tương đương?",
          "options": [
            "A) x>0 ⇔ x²>0",
            "B) |x|=x ⇔ x≥0",
            "C) x²=1 ⇔ x=1",
            "D) x>1 ⇔ x>2"
          ],
          "correctAnswer": "B",
          "solution": "|x|=x đúng khi x≥0 và ngược lại → tương đương",
          "points": 20
        }
      ]
    },
    {
