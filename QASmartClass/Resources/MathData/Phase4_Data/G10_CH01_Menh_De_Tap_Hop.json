          "name": "Các phép toán tập hợp",
          "formulas": [
            "A∪B: hợp",
            "A∩B: giao",
            "A\\B: hiệu",
            "Ā (CₑA): phần bù"
          ]
        },
        {
          "id": "md_006",
          "name": "Khoảng, đoạn, nửa khoảng",
          "types": [
            "(a;b) = {x: a<x<b}",
            "[a;b] = {x: a≤x≤b}",
            "[a;b) = {x: a≤x<b}",
            "(a;+∞) = {x: x>a}"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "md_prob_004",
          "difficulty": "Easy",
          "question": "Cho A=(-2;3], B=[1;5). Tìm A∩B.",
          "options": [
            "A) [1;3]",
            "B) (1;3)",
            "C) [1;3)",
            "D) (-2;5)"
          ],
          "correctAnswer": "A",
          "solution": "A∩B = [max(-2,1); min(3,5)] = [1;3]",
          "points": 10
        },
        {
          "problemId": "md_prob_005",
          "difficulty": "Medium",
          "question": "Cho A=(-∞;2), B=(0;+∞). Tìm A\\B.",
          "options": [
            "A) (-∞;0]",
            "B) (-∞;0)",
            "C) (0;2)",
            "D) Ø"
          ],
          "correctAnswer": "A",
          "solution": "A\\B = những phần tử thuộc A nhưng không thuộc B = (-∞;0]",
          "points": 15
        },
        {
          "problemId": "md_prob_006",
          "difficulty": "Hard",
          "question": "Cho A={x∈ℤ: |x|≤3}. Số tập con của A là:",
          "options": [
            "A) 64",
            "B) 128",
            "C) 256",
            "D) 49"
          ],
          "correctAnswer": "B",
          "solution": "A={-3,-2,-1,0,1,2,3} có 7 phần tử. Số tập con = 2⁷ = 128",
          "points": 20
        }
      ]
