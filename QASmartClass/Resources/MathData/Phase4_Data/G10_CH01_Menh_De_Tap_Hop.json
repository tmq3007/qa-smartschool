    {
      "sectionId": "md_03",
      "sectionName": "Hàm số cơ bản (Lớp 10)",
      "order": 3,
      "concepts": [
        {
          "id": "md_007",
          "name": "Định nghĩa hàm số",
          "definition": "Quy tắc f gán mỗi x∈D một giá trị y duy nhất"
        },
        {
          "id": "md_008",
          "name": "Tính chất hàm số",
          "properties": [
            "Đồng biến: x₁<x₂ → f(x₁)<f(x₂)",
            "Nghịch biến: x₁<x₂ → f(x₁)>f(x₂)",
            "Chẵn: f(-x)=f(x)",
            "Lẻ: f(-x)=-f(x)"
          ]
        },
        {
          "id": "md_009",
          "name": "Hàm bậc nhất y=ax+b",
          "properties": [
            "a>0: đồng biến",
            "a<0: nghịch biến",
            "Đồ thị: đường thẳng"
          ]
        },
        {
          "id": "md_010",
          "name": "Hàm bậc hai y=ax²+bx+c",
          "properties": [
            "Đỉnh: (-b/2a; -Δ/4a)",
            "Trục đối xứng: x=-b/2a",
            "a>0: bề lõm, a<0: bề lồi"
          ]
        }
      ],
      "problems": [
        {
          "problemId": "md_prob_007",
          "difficulty": "Easy",
          "question": "Hàm số y=x²-4x+3 có đỉnh là:",
          "options": [
            "A) (2;-1)",
            "B) (-2;15)",
            "C) (2;1)",
            "D) (4;3)"
          ],
          "correctAnswer": "A",
          "solution": "x_đ=-(-4)/(2·1)=2. y_đ=4-8+3=-1. Đỉnh (2;-1)",
          "points": 10
        },
        {
          "problemId": "md_prob_008",
          "difficulty": "Medium",
          "question": "Hàm số f(x)=x³-x là hàm:",
          "options": [
            "A) Chẵn",
            "B) Lẻ",
            "C) Không chẵn không lẻ",
            "D) Vừa chẵn vừa lẻ"
          ],
          "correctAnswer": "B",
          "solution": "f(-x)=(-x)³-(-x)=-x³+x=-(x³-x)=-f(x) → hàm lẻ",
          "points": 15
        },
        {
          "problemId": "md_prob_009",
          "difficulty": "Easy",
          "question": "TXĐ của y=√(x-2) là:",
          "options": [
            "A) [2;+∞)",
            "B) (2;+∞)",
            "C) (-∞;2]",
            "D) ℝ"
          ],
          "correctAnswer": "A",
          "solution": "x-2≥0 → x≥2 → D=[2;+∞)",
          "points": 10
        },
        {
          "problemId": "md_prob_010",
          "difficulty": "Medium",
          "question": "Parabol y=-x²+2x+3 cắt Ox tại 2 điểm có hoành độ:",
          "options": [
            "A) x=-1, x=3",
            "B) x=1, x=-3",
            "C) x=0, x=2",
            "D) x=-1, x=-3"
          ],
          "correctAnswer": "A",
          "solution": "-x²+2x+3=0 → x²-2x-3=0 → (x+1)(x-3)=0 → x=-1, x=3",
          "points": 15
        },
        {
          "problemId": "md_prob_011",
          "difficulty": "Hard",
          "question": "Tìm m để đường thẳng y=x+m tiếp xúc parabol y=x²:",
          "options": [
            "A) m=1/4",
            "B) m=-1/4",
            "C) m=1",
            "D) m=0"
          ],
          "correctAnswer": "A",
          "solution": "x²=x+m → x²-x-m=0. Tiếp xúc ⟺ Δ=1+4m=0 → m=-1/4. Kiểm tra: Δ=0 khi m=-1/4... Sửa: x²-x-m=0, Δ=1+4m=0→m=-1/4",
          "points": 20
        },
        {
          "problemId": "md_prob_012",
          "difficulty": "Hard",
          "question": "Tìm m để y=mx²-2x+1>0 ∀x∈ℝ:",
          "options": [
            "A) m>1",
            "B) m≥1",
            "C) m>0",
            "D) m≥0"
          ],
          "correctAnswer": "A",
          "solution": "TH m=0: y=-2x+1 không luôn dương. TH m≠0: cần m>0 và Δ'=1-m<0 → m>1",
          "points": 25
        }
      ]
    }
