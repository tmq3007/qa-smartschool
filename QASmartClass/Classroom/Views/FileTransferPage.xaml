<Page x:Class="QASmartClass.Classroom.Views.FileTransferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Phát/Thu bài" Background="#FAFAFA">
    <Page.Resources>
        <ControlTemplate x:Key="RoundBtn" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: Main content ═══ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="📂 Thêm file" Style="{StaticResource ActionBtn}"
                            Background="#E3F2FD" Foreground="#1565C0"
                            Margin="0,0,6,0" Click="AddFiles_Click"/>
                    <Button Content="🗑️ Xóa tất cả" Style="{StaticResource ActionBtn}"
                            Background="#FFEBEE" Foreground="#C62828"
                            Click="ClearAll_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="📁 Phát / Thu bài tập" FontSize="18" FontWeight="Bold" Foreground="#212121"/>
                    <TextBlock Text="Gửi đề bài + tài liệu cho HS, thu bài làm về máy GV" FontSize="13" Foreground="#757575" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Assignment Info -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📝 Mô tả / Yêu cầu bài tập:" FontSize="13" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtAssignmentDesc" Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="13" BorderBrush="#E0E0E0" Padding="8,4" VerticalScrollBarVisibility="Auto"
                                 Text="" GotFocus="Desc_GotFocus" LostFocus="Desc_LostFocus" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="⏰ Hạn nộp:" FontSize="13" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="dpDeadline" Width="120" FontSize="13"
                                        xmlns:sys="clr-namespace:System;assembly=System.Runtime"/>
                            <ComboBox x:Name="cmbDeadlineHour" Width="50" FontSize="13" Margin="4,0,0,0"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <TextBlock Text=":" FontSize="13" FontWeight="Bold" Margin="2,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbDeadlineMinute" Width="50" FontSize="13"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File List -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="14,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="📋 File đính kèm" FontSize="13" FontWeight="SemiBold" Foreground="#212121" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtFileCount" DockPanel.Dock="Right" Text="0 file"
                                       FontSize="13" Foreground="#9C27B0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="fileListBox" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="6" Padding="10,6" Margin="0,0,0,3"
                                        BorderBrush="#E8E8E8" BorderThickness="1"
                                        ToolTip="{Binding Path}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                                                FontSize="10" Background="#FFEBEE" Foreground="#C62828"
                                                BorderThickness="0" Cursor="Hand" Click="RemoveFile_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding TypeIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   FontFamily="Segoe UI Emoji"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#212121"/>
                                            <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="#9E9E9E"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Actions + Progress -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="14">
                <StackPanel>
                    <ProgressBar x:Name="progressBar" Height="6" Value="0"
                                 Background="#F5F5F5" Foreground="#4CAF50" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtStatus" Text="📂 Chọn file → Nhập yêu cầu → Nhấn Phát bài"
                               FontSize="14" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnSend" Content="📤 Phát bài cho HS"
                                Style="{StaticResource ActionBtn}"
                                Padding="20,10" FontSize="13"
                                Background="#1976D2" Foreground="White"
                                Margin="0,0,10,0" Click="Send_Click"/>
                        <Button Content="📥 Thu bài từ HS"
                                Style="{StaticResource ActionBtn}"
                                Padding="20,10" FontSize="13"
                                Background="#E8F5E9" Foreground="#2E7D32"
                                Click="Collect_Click"/>
                        <CheckBox x:Name="chkLockSubmission" Content="🔒 Khóa nhận bài nộp" 
                                  FontSize="13" FontWeight="Bold" Foreground="#C62828"
                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                  Checked="LockSubmission_Checked" Unchecked="LockSubmission_Unchecked"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ RIGHT: Guide + Submission Status ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Guide -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💡 Hướng dẫn sử dụng" FontSize="14" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,8"/>

                    <TextBlock Text="📤 PHÁT BÀI:" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#555" Margin="0,0,0,8"
                               Text="① Thêm file đề bài / tài liệu&#10;② Nhập mô tả + yêu cầu&#10;③ Đặt hạn nộp (nếu cần)&#10;④ Nhấn &quot;Phát bài cho HS&quot;&#10;→ File tự động gửi tới tất cả HS"/>

                    <TextBlock Text="📥 THU BÀI:" FontSize="13" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#555" Margin="0,0,0,8"
                               Text="• HS nộp bài → file tự động vào thư mục&#10;• Nhấn &quot;Thu bài từ HS&quot; → mở thư mục&#10;• Tên file chuẩn hóa: MãHS_Tên_Bài_NgàyGiờ"/>

                    <Border Background="#FFF8E1" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#E65100"
                                   Text="📌 Cùng máy: File sẽ tự copy trực tiếp. Không cần kết nối mạng."/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Recipients (New Panel) -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Gửi đến" FontSize="16" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,10"/>
                    <RadioButton x:Name="rbAllStudents" Content="Tất cả học sinh" IsChecked="True" FontSize="14" Margin="0,0,0,6"
                                 GroupName="Target" Checked="TargetChanged"/>
                    <RadioButton x:Name="rbGroup" Content="Nhóm cụ thể" FontSize="14" Margin="0,0,0,6"
                                 GroupName="Target" Checked="TargetChanged"/>
                    <RadioButton x:Name="rbIndividual" Content="Chọn từng HS" FontSize="14"
                                 GroupName="Target" Checked="TargetChanged"/>
                    
                    <!-- Sub: Group picker -->
                    <Border x:Name="panelGroupPicker" Visibility="Collapsed" Background="#E8F5E9" CornerRadius="8"
                            Padding="10,8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Chọn nhóm:" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,6"/>
                            <StackPanel x:Name="groupCheckList">
                                <TextBlock Text="Đang tải nhóm..." FontSize="14" Foreground="#BDBDBD" FontStyle="Italic"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Chọn tất cả" FontSize="14" Padding="10,4" Margin="0,0,6,0"
                                        Background="#C8E6C9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"
                                        Click="SelectAllGroups_Click" Template="{StaticResource RoundBtn}"/>
                                <Button Content="Bỏ chọn" FontSize="14" Padding="10,4"
                                        Background="#FFCDD2" Foreground="#C62828" BorderThickness="0" Cursor="Hand"
                                        Click="DeselectAllGroups_Click" Template="{StaticResource RoundBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Sub: Individual student picker -->
                    <Border x:Name="panelStudentPicker" Visibility="Collapsed" Background="#E3F2FD" CornerRadius="8"
                            Padding="10,8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Chọn học sinh:" FontSize="14" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,6"/>
                            <!-- Tìm kiếm HS -->
                            <Grid Margin="0,0,0,6">
                                <TextBox x:Name="txtSearchStudent" FontSize="13" Padding="8,6"
                                         Background="White" BorderBrush="#BBDEFB" BorderThickness="1"
                                         TextChanged="SearchStudent_TextChanged"/>
                                <TextBlock Text="Tìm học sinh theo tên..."
                                           FontSize="13" Foreground="#BDBDBD" Padding="10,7"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearchStudent}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="studentCheckList">
                                    <TextBlock Text="Đang tải học sinh..." FontSize="14" Foreground="#BDBDBD" FontStyle="Italic"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Chọn tất cả" FontSize="14" Padding="10,4" Margin="0,0,6,0"
                                        Background="#C8E6C9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"
                                        Click="SelectAllStudents_Click" Template="{StaticResource RoundBtn}"/>
                                <Button Content="Bỏ chọn" FontSize="14" Padding="10,4"
                                        Background="#FFCDD2" Foreground="#C62828" BorderThickness="0" Cursor="Hand"
                                        Click="DeselectAllStudents_Click" Template="{StaticResource RoundBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Máy HS sẽ nhận -->
                    <TextBlock x:Name="txtRecipientCount" Text="→ Tất cả máy HS sẽ nhận" FontSize="13" Foreground="#1565C0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Submission Status -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📊 Trạng thái nộp bài" FontSize="14" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock x:Name="txtSubmissionCount" DockPanel.Dock="Right" Text="0 bài"
                                   FontSize="13" Foreground="#4CAF50" FontWeight="SemiBold"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="submissionList"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
