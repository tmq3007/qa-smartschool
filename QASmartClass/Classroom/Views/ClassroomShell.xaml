<Window x:Class="QASmartClass.Classroom.Views.ClassroomShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QASmartClass.Classroom.Views"
        Title="QA Smart Class — Quản lý Lớp học"
        WindowState="Maximized" WindowStyle="None"
        Background="#FAFAFA" AllowsTransparency="False">

    <Window.Resources>
        <local:SidebarIconConverter x:Key="SidebarIconConverter"/>
        <local:SidebarTextConverter x:Key="SidebarTextConverter"/>
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" ClipToBounds="True"
                                CornerRadius="0,6,6,0" Margin="0,1,8,1" Height="38">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="colIcon" Width="44"/>
                                    <ColumnDefinition x:Name="colText" Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Hiển thị Emoji trích xuất bằng Converter: Luôn căn giữa tuyệt đối trong ô 44px -->
                                <TextBlock x:Name="iconBlock" Grid.Column="0"
                                           Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SidebarIconConverter}}"
                                           FontFamily="Segoe UI Emoji" FontSize="17" Width="24" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>

                                <!-- Hiển thị Nhãn chữ trích xuất bằng Converter -->
                                <TextBlock x:Name="textBlock" Grid.Column="1"
                                           Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SidebarTextConverter}}"
                                           Margin="4,0,8,0" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>

                                <!-- Badge thông báo tin nhắn chưa đọc -->
                                <Border x:Name="badgeBorder" Grid.ColumnSpan="2" Background="#EF5350" Width="18" Height="18" CornerRadius="9"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0" Visibility="Collapsed">
                                    <TextBlock Text="{Binding Path=(local:ClassroomShell.BadgeCount), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="White" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                            <!-- Tự động ẩn/hiện Badge khi BadgeCount > 0 -->
                            <DataTrigger Binding="{Binding Path=(local:ClassroomShell.BadgeCount), RelativeSource={RelativeSource Self}, Converter={StaticResource IntToVisibilityConverter}}" Value="Visible">
                                <Setter TargetName="badgeBorder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- Trigger xử lý tự động khi Sidebar thu nhỏ -->
                            <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="textBlock" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="colText" Property="Width" Value="0"/>
                                <Setter TargetName="bd" Property="CornerRadius" Value="8"/>
                                <Setter TargetName="bd" Property="Width" Value="44"/>
                                <Setter TargetName="bd" Property="Margin" Value="0,2,0,2"/>
                                <Setter TargetName="bd" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="badgeBorder" Property="Margin" Value="0,2,2,0"/>
                                <Setter Property="ToolTip" Value="{Binding Path=Content, RelativeSource={RelativeSource Self}, Converter={StaticResource SidebarTextConverter}}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="16,6,0,2"/>
        </Style>
        <Style x:Key="NavSep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Margin" Value="16,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="sidebarColumn" Width="255"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="#0D1B2A" ClipToBounds="True">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" x:Name="sidebarHeaderBorder">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="14,8,10,4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Padding" Value="0,8,0,4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Expanded Header View -->
                        <Grid x:Name="headerExpandedGrid">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="logoBorder" Grid.Column="0" Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0" Cursor="Hand" ToolTip="Nhấn giữ 3 giây để chẩn đoán hệ thống" PreviewMouseLeftButtonDown="Logo_MouseLeftButtonDown" PreviewMouseLeftButtonUp="Logo_MouseLeftButtonUp">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1976D2" Offset="0"/>
                                        <GradientStop Color="#42A5F5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="logoTextPanel" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="QA SMART CLASS" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{DynamicResource Shell_Subtitle}" FontSize="10" Foreground="#607D8B" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="btnToggleSidebar" Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                    Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                                    Cursor="Hand" Click="ToggleSidebar_Click" ToolTip="Thu nhỏ Sidebar"
                                    FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="{TemplateBinding FontSize}"
                                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#1E3A5F"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Collapsed Header View: Nút Toggle mở rộng khi thu nhỏ, căn giữa tuyệt đối -->
                        <Button x:Name="btnToggleSidebarCollapsed" Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                Width="44" Height="36" Padding="0"
                                Background="Transparent" Foreground="#90A4AE" BorderThickness="0"
                                Cursor="Hand" Click="ToggleSidebar_Click" ToolTip="Mở rộng Sidebar"
                                FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="8">
                                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#1E3A5F"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Session Info + Roster Selector -->
                <Border x:Name="sessionInfoBorder" DockPanel.Dock="Top" Background="#1B2838" CornerRadius="8"
                        Cursor="Hand" MouseLeftButtonDown="RosterSelector_Click" ToolTip="Click để chọn lớp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Width" Value="44"/>
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon lớp học: Căn giữa tuyệt đối trong ô 44px -->
                        <TextBlock x:Name="iconClass" Grid.Column="0" Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#4FC3F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Chi tiết lớp học (ẩn khi thu nhỏ) -->
                        <StackPanel x:Name="sessionDetailsPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="txtClassName" Text="Chưa chọn lớp" Foreground="#4FC3F7" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6" Fill="#4CAF50" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtStudentCount" Text="Click để chọn lớp" Foreground="#A5D6A7" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mũi tên Dropdown (ẩn khi thu nhỏ) -->
                        <TextBlock x:Name="sessionDropdownArrow" Grid.Column="2" Text="▼" Foreground="#546E7A" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Bottom: Teacher Info + Exit -->
                <Border DockPanel.Dock="Bottom" Background="#0A1628">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="10,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Padding" Value="0,8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- ═══ ACCESSIBILITY PANEL ═══ -->
                        <Grid x:Name="accessibilityPanel" Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Back Button -->
                            <Button Grid.Column="0" x:Name="btnAccessBack" Width="36" Height="36" Cursor="Hand" Click="btnAccessBack_Click" ToolTip="Quay lại trang trước">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="18" Background="#1E3A5F" BorderBrush="#37474F" BorderThickness="1">
                                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E0E0E0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Home Button -->
                            <Button Grid.Column="1" x:Name="btnAccessHome" Width="36" Height="36" Cursor="Hand" Click="btnAccessHome_Click" ToolTip="Quay lại trang chủ">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="18" Background="#1E3A5F" BorderBrush="#37474F" BorderThickness="1">
                                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E0E0E0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Student Mode Button -->
                            <Button Grid.Column="2" x:Name="btnAccessStudent" Width="36" Height="36" Cursor="Hand" Click="btnAccessStudent_Click" ToolTip="Chuyển sang giao diện Học sinh">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="18" Background="#1E3A5F" BorderBrush="#37474F" BorderThickness="1">
                                            <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E0E0E0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Smart Touch / Screen Mode Button -->
                            <Button Grid.Column="3" x:Name="btnAccessScreen" Width="36" Height="36" Cursor="Hand" Click="btnAccessScreen_Click" ToolTip="Chuyển sang Bảng viết tương tác">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="18" Background="#1E3A5F" BorderBrush="#37474F" BorderThickness="1">
                                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E0E0E0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <Border x:Name="SepAccess" Height="1" Background="#1E3A5F" Margin="0,2,0,8"/>

                        <!-- Teacher Profile Info -->
                        <Grid Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="TeacherAvatar_Click" ToolTip="Click để đổi ảnh đại diện">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar circle with image or initials -->
                            <Border x:Name="teacherAvatarBorder" Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                    BorderBrush="#4CAF50" BorderThickness="2" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2E7D32" Offset="0"/>
                                        <GradientStop Color="#66BB6A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock x:Name="txtTeacherInitials" Text="NA" FontSize="15" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="imgTeacherAvatar" Stretch="UniformToFill" Visibility="Collapsed">
                                        <Image.Clip>
                                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock x:Name="txtTeacherName" Text="GV. Nguyễn Văn A" Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtTeacherSchool" Text="Trường THPT QA  •  Toán học" Foreground="#546E7A" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#1E3A5F" Margin="0,2,0,6"/>
                        <Button x:Name="btnExitApp" FontSize="12" Background="#1B1B2F" Foreground="#EF5350"
                                BorderThickness="0" Cursor="Hand" Click="ExitApp_Click" ToolTip="Thoát chương trình">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Width" Value="44"/>
                                            <Setter Property="Height" Value="38"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}" BorderBrush="#37474F" BorderThickness="1">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="iconExit" Grid.Column="0" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#EF5350" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtExitLabel" Grid.Column="1" Text="{DynamicResource Shell_ExitApp}" FontSize="12" Foreground="#EF5350" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3E0000"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#EF5350"/>
                                        </Trigger>
                                        <!-- Tự động co gọn nút thoát khi Sidebar thu nhỏ -->
                                        <DataTrigger Binding="{Binding Path=IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txtExitLabel" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="iconExit" Property="Margin" Value="0"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" ClipToBounds="True">
                    <StackPanel x:Name="navPanel" Margin="0,4,0,8" ClipToBounds="True">

                        <!-- 🏠 BẢNG TỔNG QUAN (Độc lập trên cùng) -->
                        <Button x:Name="btnHomeNav" Style="{StaticResource NavButtonActive}" Content="{DynamicResource Nav_Home}" Tag="F1" Click="NavButton_Click" Margin="0,0,0,4"/>
                        <Border x:Name="SepHome" Style="{StaticResource NavSep}"/>

                        <!-- ═══ I. SOẠN GIẢNG & LỊCH TRÌNH ═══ -->
                        <Border x:Name="BorderSec1" Margin="6,1,6,1" Padding="8,3" CornerRadius="6" Background="#122640" Tag="Sec1" Cursor="Hand" MouseLeftButtonDown="ToggleSection_Click">
                            <DockPanel>
                                <TextBlock x:Name="txtToggleSec1" Text="-" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7"/>
                                <TextBlock Text="{DynamicResource Nav_Section1}" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7"/>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="panelSec1" Visibility="Visible">
                            <Button Style="{StaticResource NavButton}"       Content="{DynamicResource Nav_Timetable}"       Tag="F26" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}"       Content="{DynamicResource Nav_Lessons}"         Tag="F2"  Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}"       Content="{DynamicResource Nav_LessonEditor}"    Tag="F3"  Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}"       Content="{DynamicResource Nav_Library}"          Tag="F9"  Click="NavButton_Click"/>
                        </StackPanel>

                        <!-- ═══ II. HỒ SƠ & CHUYÊN CẦN ═══ -->
                        <Border x:Name="SepSec2" Style="{StaticResource NavSep}"/>
                        <Border x:Name="BorderSec2" Margin="6,1,6,1" Padding="8,3" CornerRadius="6" Background="#122640" Tag="Sec2" Cursor="Hand" MouseLeftButtonDown="ToggleSection_Click">
                            <DockPanel>
                                <TextBlock x:Name="txtToggleSec2" Text="-" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="#81C784"/>
                                <TextBlock Text="{DynamicResource Nav_Section2}" FontSize="11" FontWeight="Bold" Foreground="#81C784"/>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="panelSec2" Visibility="Visible">
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Roster}"      Tag="F15" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Groups}"      Tag="F10" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Attendance}"  Tag="F27" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Teachers}"    Tag="F33" Click="NavButton_Click"/>
                        </StackPanel>

                        <!-- ═══ III. TƯƠNG TÁC LỚP HỌC ═══ -->
                        <Border x:Name="SepSec3" Style="{StaticResource NavSep}"/>
                        <Border x:Name="BorderSec3" Margin="6,1,6,1" Padding="8,3" CornerRadius="6" Background="#122640" Tag="Sec3" Cursor="Hand" MouseLeftButtonDown="ToggleSection_Click">
                            <DockPanel>
                                <TextBlock x:Name="txtToggleSec3" Text="-" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="#FFB74D"/>
                                <TextBlock Text="{DynamicResource Nav_Section3}" FontSize="11" FontWeight="Bold" Foreground="#FFB74D"/>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="panelSec3" Visibility="Visible">
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Classroom}"    Tag="F4"  Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Monitor}"      Tag="F5"  Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Broadcast}"    Tag="F16" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_FileTransfer}" Tag="F11" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_WebPush}"      Tag="F30" Click="NavButton_Click"/>
                            <Button x:Name="btnMessaging" Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Messaging}" Tag="F13" Click="NavButton_Click"/>
                        </StackPanel>

                        <!-- ═══ IV. ĐÁNH GIÁ & THỐNG KÊ ═══ -->
                        <Border x:Name="SepSec4" Style="{StaticResource NavSep}"/>
                        <Border x:Name="BorderSec4" Margin="6,1,6,1" Padding="8,3" CornerRadius="6" Background="#122640" Tag="Sec4" Cursor="Hand" MouseLeftButtonDown="ToggleSection_Click">
                            <DockPanel>
                                <TextBlock x:Name="txtToggleSec4" Text="-" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="#EF9A9A"/>
                                <TextBlock Text="{DynamicResource Nav_Section4}" FontSize="11" FontWeight="Bold" Foreground="#EF9A9A"/>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="panelSec4" Visibility="Visible">
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Survey}"        Tag="F18" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Quiz}"          Tag="F6"  Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_QuestionBank}"  Tag="F14" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Homework}"      Tag="F28" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Report}"        Tag="F7"  Click="NavButton_Click"/>
                        </StackPanel>

                        <!-- ═══ V. TRỢ GIẢNG & HỌC CỤ ═══ -->
                        <Border x:Name="SepSec5" Style="{StaticResource NavSep}"/>
                        <Border x:Name="BorderSec5" Margin="6,1,6,1" Padding="8,3" CornerRadius="6" Background="#122640" Tag="Sec5" Cursor="Hand" MouseLeftButtonDown="ToggleSection_Click">
                            <DockPanel>
                                <TextBlock x:Name="txtToggleSec5" Text="-" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="#CE93D8"/>
                                <TextBlock Text="{DynamicResource Nav_Section5}" FontSize="11" FontWeight="Bold" Foreground="#CE93D8"/>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="panelSec5" Visibility="Visible">
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Canvas}"        Tag="F20" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_AI}"            Tag="F29" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_STEM}"          Tag="F31" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_LearningTools}" Tag="F32" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Timer}"         Tag="F22" Click="NavButton_Click"/>
                        </StackPanel>

                        <!-- ═══ VI. QUẢN TRỊ HỆ THỐNG ═══ -->
                        <Border x:Name="SepSec6" Style="{StaticResource NavSep}"/>
                        <Border x:Name="BorderSec6" Margin="6,1,6,1" Padding="8,3" CornerRadius="6" Background="#122640" Tag="Sec6" Cursor="Hand" MouseLeftButtonDown="ToggleSection_Click">
                            <DockPanel>
                                <TextBlock x:Name="txtToggleSec6" Text="-" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="#90A4AE"/>
                                <TextBlock Text="{DynamicResource Nav_Section6}" FontSize="11" FontWeight="Bold" Foreground="#90A4AE"/>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="panelSec6" Visibility="Visible">
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Settings}"      Tag="F8"  Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_Policy}"       Tag="F17" Click="NavButton_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav_EventLog}"     Tag="F19" Click="NavButton_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ← Quay lại -->
                        <Button x:Name="btnGoBack" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" 
                                Width="32" Height="32" Margin="0,0,8,0" Padding="0"
                                Background="Transparent" Foreground="#546E7A" BorderThickness="0"
                                Cursor="Hand" Click="GoBack_Click" ToolTip="Quay lại trang trước (Alt+←)"
                                Visibility="Collapsed" FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Foreground" Value="#212121"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#BDBDBD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- 🏠 Trang chủ -->
                        <Button x:Name="btnGoHome" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" 
                                Width="32" Height="32" Margin="0,0,12,0" Padding="0"
                                Background="Transparent" Foreground="#546E7A" BorderThickness="0"
                                Cursor="Hand" Click="GoHome_Click" ToolTip="Về Trang chủ (Alt+Home)"
                                Visibility="Collapsed" FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Foreground" Value="#212121"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#BDBDBD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Width="1" Height="16" Background="#E0E0E0" Margin="0,0,12,0"/>
                        
                        <TextBlock x:Name="txtPageTitle" Text="{DynamicResource Shell_HomeTitle}"
                                   VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#212121"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtClock" Text="--:--" Foreground="#9E9E9E" FontSize="13"
                                   Margin="0,0,16,0" VerticalAlignment="Center"/>
                        
                        <!-- VNC Blinking Indicator (LOI_VID_46) -->
                        <Border x:Name="brdBroadcastStatus" Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1"
                                CornerRadius="6" Padding="10,5" Margin="0,0,8,0" Cursor="Hand"
                                MouseLeftButtonDown="brdBroadcastStatus_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="elpDot" Width="8" Height="8" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.25" Duration="0:0:0.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock x:Name="txtBroadcastTime" Text="🔴 Đang phát VNC (00:00)" FontSize="11" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#E3F2FD" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" Cursor="Hand"
                                MouseLeftButtonDown="GoToMonitor_Click">
                            <TextBlock x:Name="txtOnlineStudentCount" Text="🟢 0 HS" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold"/>
                        </Border>
                        <!-- 🎓 Switch to Student mode -->
                        <Button Content="{DynamicResource Shell_Students}" Background="#4CAF50" Foreground="White"
                                BorderThickness="0" Padding="12,6" FontSize="12" Cursor="Hand"
                                Margin="0,0,6,0" Click="SwitchToStudent_Click" ToolTip="Mở giao diện Học sinh">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#388E3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- 🖊️ Switch to Smart Touch -->
                        <Button Content="{DynamicResource Shell_SmartTouch}" Background="#1976D2" Foreground="White"
                                BorderThickness="0" Padding="12,6" FontSize="12" Cursor="Hand"
                                Margin="0,0,6,0" Click="SwitchToScreen_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#0D47A1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- ✕ Close -->
                        <Button Content="✕" Background="Transparent" Foreground="#9E9E9E"
                                BorderThickness="0" Padding="8,4" FontSize="14" Cursor="Hand"
                                Click="ExitApp_Click" ToolTip="Thoát">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#FFEBEE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Frame + Toast Overlay -->
            <Grid Grid.Row="1">
                <Frame x:Name="contentFrame" NavigationUIVisibility="Hidden">
                    <Frame.RenderTransform>
                        <TranslateTransform x:Name="frameTranslate" X="0"/>
                    </Frame.RenderTransform>
                </Frame>

                <!-- Toast Notification Panel (top-right overlay) -->
                <StackPanel x:Name="toastPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,20,0" Width="360"/>
            </Grid>
        </Grid>

        <!-- Loading Overlay (Z-Index cao nhất) -->
        <Grid x:Name="loadingOverlay" Grid.ColumnSpan="2" Background="#4D000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="30,24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="8" Foreground="#1976D2" Value="0" Margin="0,0,0,16"/>
                    <TextBlock Text="Đang tải dữ liệu..." FontSize="16" FontWeight="SemiBold" Foreground="#37474F" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Confirmation Dialog Overlay -->
        <Grid x:Name="confirmationOverlay" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CẢNH BÁO" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" Margin="0,0,0,12"/>
                    <TextBlock x:Name="txtConfirmMessage" Text="Bạn có chắc chắn muốn thực hiện thao tác này?" FontSize="15" Foreground="#37474F" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="22"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnConfirmCancel" Content="Hủy bỏ" Height="40" Margin="0,0,8,0" Background="#F5F5F5" Foreground="#424242" BorderBrush="#BDBDBD" BorderThickness="1" Click="btnConfirmCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" x:Name="btnConfirmOK" Content="Đồng ý" Height="40" Margin="8,0,0,0" Background="#D32F2F" Foreground="White" BorderThickness="0" Click="btnConfirmOK_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
