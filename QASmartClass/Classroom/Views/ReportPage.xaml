<Page x:Class="QASmartClass.Classroom.Views.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Báo cáo" Background="#FAFAFA"
      PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>
        <!-- Rounded button template -->
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Export button template -->
        <Style x:Key="ExportBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for DataGridCell validation feedback -->
        <Style TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="BorderBrush" Value="#E53935"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" 
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Fade-in animation for DataGrid and Gauss curve canvas -->
        <Storyboard x:Key="FadeInGridAndCanvas">
            <DoubleAnimation Storyboard.TargetName="gradeDataGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="gaussCanvas"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Page.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Filter Bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ════ HEADER + EXPORT ════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="📄 Export PDF" Style="{StaticResource ExportBtn}"
                        Background="#FFEBEE" Foreground="#C62828" Click="ExportPdf_Click" Margin="0,0,6,0"/>
                <Button Content="📊 Export Excel" Style="{StaticResource ExportBtn}"
                        Background="#E8F5E9" Foreground="#2E7D32" Click="ExportExcel_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="📊 Báo cáo &amp; Thống kê" FontSize="18" FontWeight="Bold" Foreground="#212121"/>
                <TextBlock x:Name="txtSubtitle" Text="Tổng hợp kết quả học tập" FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ════ FILTER BAR ════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!-- Khối -->
                <TextBlock Text="🏫 Khối:" FontSize="13" FontWeight="SemiBold" Foreground="#495057"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboGradeLevel" Width="140" FontSize="13" Padding="6,4"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Tất cả" Tag="" IsSelected="True"/>
                </ComboBox>

                <Border Width="1" Background="#E9ECEF" Margin="16,2"/>

                <!-- Lớp -->
                <TextBlock Text="📚 Lớp:" FontSize="13" FontWeight="SemiBold" Foreground="#495057"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboClass" Width="300" FontSize="13" Padding="6,4"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="— Chọn lớp —" Tag="" IsSelected="True"/>
                </ComboBox>

                <Border Width="1" Background="#E9ECEF" Margin="16,2"/>

                <!-- Học kỳ -->
                <TextBlock Text="📅 Học kỳ:" FontSize="13" FontWeight="SemiBold" Foreground="#495057"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboSemester" Width="100" FontSize="13" Padding="6,4"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="HK1" Tag="HK1"/>
                    <ComboBoxItem Content="HK2" Tag="HK2" IsSelected="True"/>
                </ComboBox>

                <!-- Save All -->
                <Button x:Name="btnSaveAll" Content="💾  Lưu tất cả" Margin="24,0,0,0"
                        Style="{StaticResource FilterBtn}"
                        Background="#E3F2FD" Foreground="#1565C0" BorderBrush="#BBDEFB"
                        Click="SaveAllGrades_Click" Visibility="Collapsed"/>

                <!-- Download Template -->
                <Button x:Name="btnTemplate" Content="📥  Tải form mẫu" Margin="6,0,0,0"
                        Style="{StaticResource FilterBtn}"
                        Background="#FFF8E1" Foreground="#F57F17" BorderBrush="#FFE082"
                        Click="DownloadTemplate_Click" Visibility="Collapsed"/>

                <!-- Import CSV -->
                <Button x:Name="btnImport" Content="📤  Nhập điểm từ CSV" Margin="6,0,0,0"
                        Style="{StaticResource FilterBtn}"
                        Background="#E8F5E9" Foreground="#2E7D32" BorderBrush="#A5D6A7"
                        Click="ImportGrades_Click" Visibility="Collapsed"/>

                <!-- Simulator Button -->
                <Button x:Name="btnSimulator" Content="🔍  Giả lập điểm" Margin="6,0,0,0"
                        Style="{StaticResource FilterBtn}"
                        Background="#E0F2F1" Foreground="#004D40" BorderBrush="#B2DFDB"
                        Click="Simulator_Click" Visibility="Collapsed"/>

                <!-- Status -->
                <TextBlock x:Name="txtFilterStatus" Text="" FontSize="12" Foreground="#868E96"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ════ SCROLLABLE CONTENT ════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Summary Cards -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="16">
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🏆 Điểm TB lớp" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="txtAvgScore" Text="—" FontSize="36" FontWeight="Bold" Foreground="#FF9800" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtAvgNote" Text="Chọn lớp để xem" FontSize="11" Foreground="#757575"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Margin="4,0" Padding="16">
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="✅ Tỷ lệ đạt" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="txtPassRate" Text="—" FontSize="36" FontWeight="Bold" Foreground="#4CAF50" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtPassDetail" Text="" FontSize="11" Foreground="#757575"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Margin="4,0" Padding="16">
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="👨‍🎓 Học sinh" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="txtTotalStudents" Text="0" FontSize="36" FontWeight="Bold" Foreground="#9C27B0" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtStudentNote" Text="Sĩ số lớp" FontSize="11" Foreground="#757575"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Margin="8,0,0,0" Padding="16">
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📝 Đã nhập điểm" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="txtGradeEntryCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#1976D2" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtGradeEntryNote" Text="bản ghi" FontSize="11" Foreground="#757575"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Charts Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Score Distribution -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📊 Phân bố điểm số" FontSize="15" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,16"/>
                            <StackPanel x:Name="distributionPanel">
                                <!-- Generated by code-behind -->
                                <TextBlock Text="Chọn lớp để xem phân bố" FontSize="12" Foreground="#868E96" FontStyle="Italic"/>
                            </StackPanel>
                            <!-- Gauss curve canvas -->
                            <Canvas x:Name="gaussCanvas" Height="180" Margin="0,12,0,0" Visibility="Collapsed" SizeChanged="GaussCanvas_SizeChanged"/>
                            <TextBlock x:Name="txtStats" Text="" FontSize="11" Foreground="#495057" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Grade formula + info -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Margin="8,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📐 Công thức &amp; Loại điểm" FontSize="15" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,12"/>
                            <Border Background="#F8F9FA" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                                <TextBlock x:Name="txtFormula" Text="TB = ..." FontSize="13" Foreground="#495057" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel x:Name="gradeTypeInfoPanel">
                                <!-- Generated by code-behind -->
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ════ EDITABLE GRADE TABLE ════ -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" x:Name="txtTableStatus" Text="" FontSize="12" Foreground="#868E96" VerticalAlignment="Center"/>
                                <TextBlock Text="📋 Bảng điểm chi tiết (Nhập/Sửa điểm)" FontSize="15" FontWeight="SemiBold" Foreground="#212121"/>
                            </DockPanel>
                        </Border>

                        <!-- Dynamic DataGrid — columns generated by code-behind -->
                        <DataGrid x:Name="gradeDataGrid" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="All"
                                  BorderThickness="0" Background="White" RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA" FontSize="14" RowHeight="36"
                                  CanUserResizeRows="False" CanUserSortColumns="True"
                                  SelectionMode="Single" SelectionUnit="Cell"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CellEditEnding="GradeCell_EditEnding"
                                  MinHeight="200" MaxHeight="500">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F3F5"/>
                                    <Setter Property="Foreground" Value="#495057"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                        <!-- No-data placeholder -->
                        <TextBlock x:Name="txtNoData" Text="📌 Vui lòng chọn Khối → Lớp để hiển thị bảng điểm"
                                   FontSize="13" Foreground="#868E96" FontStyle="Italic"
                                   HorizontalAlignment="Center" Margin="0,24,0,24"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
