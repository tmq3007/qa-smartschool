<Page x:Class="QASmartClass.Classroom.Views.TeacherListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý Giáo viên" Background="#F0F2F5">

    <Page.Resources>
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="1" BlurRadius="8" Opacity="0.05" Color="#000"/>

        <!-- Rounded button template -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stats -->
            <RowDefinition Height="Auto"/>  <!-- Search bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             ROW 0: HEADER
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="22,14" Margin="0,0,0,10"
                Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2E7D32" Offset="0"/>
                    <GradientStop Color="#43A047" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 Nhập CSV" Padding="12,8" FontSize="11"
                            Background="Transparent" Foreground="White" BorderBrush="#FFFFFF55" BorderThickness="1"
                            Style="{StaticResource RoundBtn}" Click="ImportCsv_Click" Margin="0,0,6,0"/>
                    <Button Content="📤 Xuất CSV" Padding="12,8" FontSize="11"
                            Background="Transparent" Foreground="White" BorderBrush="#FFFFFF55" BorderThickness="1"
                            Style="{StaticResource RoundBtn}" Click="ExportCsv_Click" Margin="0,0,6,0"/>
                    <Button Content="🔄" Padding="8,8" FontSize="13"
                            Background="Transparent" Foreground="White"
                            Style="{StaticResource RoundBtn}" Click="Refresh_Click"
                            ToolTip="Làm mới" Margin="0,0,8,0"/>
                    <Button Padding="16,8" FontSize="12.5" FontWeight="SemiBold"
                            Content="➕ Thêm GV mới" Foreground="White"
                            Style="{StaticResource RoundBtn}" Click="AddTeacher_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1565C0" Offset="0"/>
                                <GradientStop Color="#1E88E5" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👨‍🏫 Quản lý Giáo Viên" FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="txtResultCount" Text="Đang tải..." FontSize="12"
                               Foreground="#B9F6CA" Margin="0,3,0,0" FontFamily="Segoe UI"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             ROW 1: STATS
             ═══════════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,6,0"
                    Effect="{StaticResource CardShadow}">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#E8F5E9" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="👨‍🏫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2E7D32" FontFamily="Segoe UI"/>
                        <TextBlock Text="Tổng giáo viên" FontSize="10.5" Foreground="#868E96" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="3,0,3,0"
                    Effect="{StaticResource CardShadow}">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#E3F2FD" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtActiveCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1976D2" FontFamily="Segoe UI"/>
                        <TextBlock Text="Đang hoạt động" FontSize="10.5" Foreground="#868E96" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="6,0,0,0"
                    Effect="{StaticResource CardShadow}">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#FFF3E0" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtSubjectCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E65100" FontFamily="Segoe UI"/>
                        <TextBlock Text="Bộ môn" FontSize="10.5" Foreground="#868E96" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══════════════════════════════════════════════════════
             ROW 2: SEARCH
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="14,10"
                Margin="0,0,0,10" Effect="{StaticResource CardShadow}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#F8F9FA" CornerRadius="10" BorderBrush="#DEE2E6" BorderThickness="1"
                        VerticalAlignment="Center" Width="280">
                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0"
                             Padding="12,8" FontSize="12" Text="🔍 Tìm kiếm giáo viên..."
                             Foreground="#ADB5BD" TextChanged="Search_Changed" FontFamily="Segoe UI"
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lọc:" FontSize="11" Foreground="#868E96" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI"/>
                    <Button x:Name="btnFilterAll" Content="Tất cả" Padding="12,6" FontSize="11" FontWeight="SemiBold"
                            Background="#2E7D32" Foreground="White" Style="{StaticResource RoundBtn}"
                            Tag="All" Click="Filter_Click" Margin="0,0,4,0"/>
                    <Button x:Name="btnFilterActive" Content="✅ Hoạt động" Padding="12,6" FontSize="11"
                            Background="#F1F3F5" Foreground="#495057" Style="{StaticResource RoundBtn}"
                            Tag="Active" Click="Filter_Click" Margin="0,0,4,0"/>
                    <Button x:Name="btnFilterInactive" Content="⏸ Nghỉ" Padding="12,6" FontSize="11"
                            Background="#F1F3F5" Foreground="#495057" Style="{StaticResource RoundBtn}"
                            Tag="Inactive" Click="Filter_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             ROW 3: TABLE
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="12,12,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>        <!-- # -->
                            <ColumnDefinition Width="80"/>        <!-- Mã GV -->
                            <ColumnDefinition Width="*"/>         <!-- FullName -->
                            <ColumnDefinition Width="80"/>        <!-- Title -->
                            <ColumnDefinition Width="100"/>       <!-- Subject -->
                            <ColumnDefinition Width="120"/>       <!-- Phone -->
                            <ColumnDefinition Width="150"/>       <!-- Email -->
                            <ColumnDefinition Width="70"/>        <!-- Status -->
                            <ColumnDefinition Width="130"/>       <!-- Notes -->
                            <ColumnDefinition Width="110"/>       <!-- Actions -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="1" Text="Mã GV" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="2" Text="Họ tên" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="3" Text="Chức danh" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="4" Text="Bộ môn" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="5" Text="SĐT" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="6" Text="Email" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="7" Text="Trạng thái" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="8" Text="Ghi chú" FontSize="12" FontWeight="Bold" Foreground="#1A237E" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="9" Text="Thao tác" FontSize="12" FontWeight="Bold" Foreground="#1A237E" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    </Grid>
                </Border>

                <!-- Table Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="listViewBody"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
