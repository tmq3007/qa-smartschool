<Page x:Class="QASmartClass.Classroom.Views.RandomPickerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Chọn ngẫu nhiên" Background="#FAFAFA">

    <Grid Margin="20,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: PICKER ═══ -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Title -->
            <TextBlock Text="🎲 Chọn Học sinh Ngẫu nhiên" FontSize="22" FontWeight="Bold"
                       Foreground="#212121" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="txtRemaining" Text="Đang tải..." FontSize="12"
                       Foreground="#37474F" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Mode toggle -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button x:Name="btnModeSingle" Content="👤 Chọn 1 HS" Padding="16,10" FontSize="13"
                        Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Margin="0,0,8,0" Click="ModeSingle_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0D47A1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
                <Button x:Name="btnModeGroup" Content="👥 Chọn nhóm" Padding="16,10" FontSize="13"
                        Background="#F5F5F5" Foreground="#424242" BorderThickness="0" Cursor="Hand"
                        Click="ModeGroup_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#EDE7F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
            </StackPanel>

            <!-- Pedagogical Options -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <CheckBox x:Name="chkAllowDuplicates" Content="Gọi trùng (có lặp)" FontSize="12" Foreground="#37474F" Margin="0,0,16,0" VerticalAlignment="Center" Cursor="Hand" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="chkExcludeAbsent" Content="Loại trừ HS vắng" IsChecked="True" FontSize="12" Foreground="#37474F" VerticalAlignment="Center" Cursor="Hand" Checked="Option_Changed" Unchecked="Option_Changed"/>
            </StackPanel>

            <!-- Group size picker (hidden in single mode) -->
            <StackPanel x:Name="groupSizePanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,16"
                        Visibility="Collapsed">
                <TextBlock Text="Số thành viên:" FontSize="13" Foreground="#555"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="btnGroupMinus" Content="−" Padding="12,8" FontSize="16" Background="#F5F5F5"
                        BorderThickness="0" Cursor="Hand" Click="GroupMinus_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFCDD2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
                <TextBlock x:Name="txtGroupSize" Text="3" FontSize="20" FontWeight="Bold"
                           Foreground="#7B1FA2" Margin="14,0" VerticalAlignment="Center"/>
                <Button x:Name="btnGroupPlus" Content="+" Padding="12,8" FontSize="16" Background="#F5F5F5"
                        BorderThickness="0" Cursor="Hand" Click="GroupPlus_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C8E6C9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
            </StackPanel>

            <!-- Result Card -->
            <Border x:Name="resultCard" Width="340" MinHeight="220" CornerRadius="20" Padding="30,20"
                    Background="White" Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Avatar circle -->
                        <Border Width="90" Height="90" CornerRadius="45" HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1976D2" Offset="0"/>
                                    <GradientStop Color="#7B1FA2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="txtPickAvatar" Text="🎲" FontSize="36"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="txtPickResult" Text="Nhấn 🎲 để bắt đầu"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#424242" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                        <ItemsControl x:Name="groupResultsList" Visibility="Collapsed" Margin="0,8,0,0" MaxWidth="300">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,5" Margin="4" Background="#F3E5F5" BorderBrush="#E1BEE7" BorderThickness="1">
                                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" Foreground="#4A148C"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="txtPickResultSub" Text="Chọn học sinh ngẫu nhiên"
                                   FontSize="13" Foreground="#555555"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SPIN Button -->
            <Button x:Name="btnSpin" Content="🎲 CHỌN NGẪU NHIÊN"
                    Padding="36,16" FontSize="16" FontWeight="Bold"
                    Background="#FF9800" Foreground="White" BorderThickness="0"
                    Cursor="Hand" HorizontalAlignment="Center" Margin="0,0,0,14"
                    Click="Spin_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E65100"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Reset -->
            <Button x:Name="btnReset" Content="🔄 Đặt lại vòng mới" Padding="16,8" FontSize="12"
                    Background="Transparent" Foreground="#1976D2" BorderThickness="0"
                    Cursor="Hand" HorizontalAlignment="Center" Click="Reset_Click">
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E3F2FD"/><Setter Property="Foreground" Value="#0D47A1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            </Button>
        </StackPanel>

        <!-- ═══ RIGHT: HISTORY ═══ -->
        <Border Grid.Column="1" Background="White" CornerRadius="14"
                BorderBrush="#E0E0E0" BorderThickness="1" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="16,16,16,0">
                    <Button x:Name="btnClearHistory" DockPanel.Dock="Right" Content="🗑️" Background="#FFEBEE"
                            Foreground="#C62828" BorderThickness="0" Padding="8,6"
                            FontSize="12" Cursor="Hand" Click="ClearHistory_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFCDD2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="📋 Lịch sử chọn" FontSize="14" FontWeight="SemiBold" Foreground="#212121"/>
                        <TextBlock Text="Phiên học hôm nay" FontSize="11" Foreground="#555555"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="0" Height="1" Background="#F0F0F0" Margin="0,14,0,0" VerticalAlignment="Bottom"/>

                <!-- History list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,8,12,8">
                    <ItemsControl x:Name="historyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" CornerRadius="8" Padding="10,8" Background="#F8F9FA">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#424242"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Stats footer -->
                <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,14,14" Padding="16,12">
                    <TextBlock x:Name="txtRemaining2" Text="" FontSize="11" Foreground="#37474F"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ EMPTY STATE OVERLAY ═══ -->
        <Grid x:Name="emptyStateOverlay" Grid.ColumnSpan="2" Background="#F0FAFAFA" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" BorderBrush="#E0E0E0" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" MaxWidth="500">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Danh sách lớp trống" FontSize="20" FontWeight="Bold" Foreground="#37474F" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Lớp học hoạt động hiện tại chưa có học sinh hoặc bạn chưa chọn lớp. Vui lòng chọn lớp học ở thanh menu bên trái hoặc thêm học sinh vào danh sách lớp trước." 
                               FontSize="13" Foreground="#78909C" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,24"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
