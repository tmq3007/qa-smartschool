<Page x:Class="QASmartClass.Classroom.Views.SurveyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Khảo sát &amp; Thăm dò ý kiến" Background="#F8FAFC">

    <Page.Resources>
        <!-- Modern Rounded Button Template -->
        <ControlTemplate x:Key="RoundBtn" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Segmented Tab Button Style -->
        <Style x:Key="TabBtn" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Input TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- Card Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.06" Color="#0F172A"/>
        <DropShadowEffect x:Key="ActiveCardShadow" BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#1E293B"/>
    </Page.Resources>

    <!-- Main Container: Full stretch layout without restrictive MaxWidth -->
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Content Row with 2-Column Responsive Layout -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  HEADER BAR: Title + Subtitle + Segmented Tabs             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,16,28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Description -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="8,6" Margin="0,0,12,0">
                            <TextBlock Text="📊" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Khảo sát nhanh trực tiếp trong lớp" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="● TRỰC TIẾP TRONG LỚP • KHÔNG LƯU DB" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Phát câu hỏi nhanh tới thiết bị học sinh đang trong lớp — kết quả đếm trực tiếp và tự xóa sạch khi tắt" 
                               FontSize="13" Foreground="#64748B" Margin="44,3,0,0"/>
                </StackPanel>

                <!-- Right: Segmented Tabs Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="tabQuickPoll" Style="{StaticResource TabBtn}" Background="#EFF6FF" BorderBrush="#2563EB"
                            MouseLeftButtonDown="Tab_Click" Tag="quick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Mẫu 1 chạm" FontSize="13" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="tabCustom" Style="{StaticResource TabBtn}"
                            MouseLeftButtonDown="Tab_Click" Tag="custom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Tự nhập câu hỏi" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                    <!-- [MYTHWARE_LITE] Ẩn tab Độ hài lòng lưu DB theo ngày -->
                    <Border x:Name="tabSatisfaction" Visibility="Collapsed" Style="{StaticResource TabBtn}"
                            MouseLeftButtonDown="Tab_Click" Tag="satisfaction">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Độ hài lòng lớp học" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  BODY: 2-COLUMN MASTER-DETAIL DASHBOARD                    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" PanningMode="Both" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,20,28,24" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <!-- Left Column: Tool Controls / Question Panels -->
                    <ColumnDefinition Width="1.2*" MinWidth="480"/>
                    <!-- Right Column: Live Results & Classroom Monitoring -->
                    <ColumnDefinition Width="1*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════ -->
                <!--  LEFT COLUMN: FORMS & CONTROLS                     -->
                <!-- ═══════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <!-- TARGET SELECTION PANEL (for Custom & Satisfaction) -->
                    <Border x:Name="panelTargetSelection" Visibility="Collapsed" Background="White" CornerRadius="16" 
                            Padding="22" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                                        <TextBlock Text="👥" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="Phạm vi đối tượng nhận bài" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Chỉ định lớp học nhận phiếu khảo sát" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <RadioButton x:Name="rbAllStudents" Content="Tất cả học sinh trong phiên dạy" IsChecked="True" FontSize="13" FontWeight="Medium"
                                             Foreground="#1E293B" Margin="0,0,24,0" GroupName="Target" Checked="TargetChanged" Unchecked="TargetChanged"/>
                                <RadioButton x:Name="rbSelectClasses" Content="Lựa chọn lớp cụ thể" FontSize="13" FontWeight="Medium"
                                             Foreground="#1E293B" GroupName="Target" Checked="TargetChanged" Unchecked="TargetChanged"/>
                            </StackPanel>

                            <!-- Sub: Class list checkboxes -->
                            <Border x:Name="panelClassPicker" Visibility="Collapsed" Background="#F0FDF4" CornerRadius="10" 
                                    Padding="16,12" Margin="0,6,0,0" BorderBrush="#BBF7D0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📂 Tích chọn các lớp tham gia khảo sát:" FontSize="13" FontWeight="SemiBold" Foreground="#15803D" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="classCheckList" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✓ Chọn tất cả" FontSize="12" FontWeight="SemiBold" Padding="12,5" Margin="0,0,8,0"
                                                Background="#DCFCE7" Foreground="#166534" BorderThickness="0" Cursor="Hand"
                                                Click="SelectAllClasses_Click" Template="{StaticResource RoundBtn}"/>
                                        <Button Content="✕ Bỏ chọn" FontSize="12" FontWeight="SemiBold" Padding="12,5"
                                                Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Cursor="Hand"
                                                Click="DeselectAllClasses_Click" Template="{StaticResource RoundBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ─────────────────────────────────────────────── -->
                    <!--  TAB 1: QUICK POLL CARD (Khảo sát nhanh 1 chạm) -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Border x:Name="panelQuickPoll" Background="White" CornerRadius="16" Padding="24" 
                            BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#EFF6FF" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                                            <TextBlock Text="⚡" FontSize="15"/>
                                        </Border>
                                        <TextBlock Text="Khảo sát nhanh 1 chạm tới cả lớp" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                    <TextBlock Text="Chạm vào một mẫu bên dưới để phát ngay câu hỏi tới tất cả máy Học sinh (Windows &amp; Android) đang trong lớp" 
                                               FontSize="12" Foreground="#64748B" Margin="32,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 4 Large 1-Click Live Broadcast Poll Cards -->
                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                                <!-- Card 1: Mức độ hiểu bài -->
                                <Border Background="#F0FDF4" CornerRadius="14" Padding="18" Margin="0,0,10,12" Cursor="Hand"
                                        BorderBrush="#86EFAC" BorderThickness="1.5" Effect="{StaticResource CardShadow}"
                                        MouseLeftButtonDown="QuickPoll_Click" Tag="understand">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="🎯" FontSize="30" VerticalAlignment="Center"/>
                                            <Border Background="#DCFCE7" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="📤 Chạm để phát" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Mức độ hiểu bài" FontSize="16" FontWeight="Bold" Foreground="#14532D" Margin="0,10,0,4"/>
                                        <TextBlock Text="A. Đã hiểu rõ • B. Hiểu sơ bộ • C. Cần giảng lại" FontSize="12" Foreground="#166534" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtYes" Text="0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Chọn nhanh A / B / C / D -->
                                <Border Background="#EFF6FF" CornerRadius="14" Padding="18" Margin="0,0,0,12" Cursor="Hand"
                                        BorderBrush="#93C5FD" BorderThickness="1.5" Effect="{StaticResource CardShadow}"
                                        MouseLeftButtonDown="QuickPoll_Click" Tag="abcd">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="🅰️" FontSize="30" VerticalAlignment="Center"/>
                                            <Border Background="#DBEAFE" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="📤 Chạm để phát" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Trắc nghiệm nhanh A / B / C / D" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,10,0,4"/>
                                        <TextBlock Text="GV đọc câu hỏi miệng/trên bảng — HS bấm chọn A, B, C hoặc D" FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtNo" Text="0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Đúng / Sai -->
                                <Border Background="#FFFBEB" CornerRadius="14" Padding="18" Margin="0,0,10,0" Cursor="Hand"
                                        BorderBrush="#FCD34D" BorderThickness="1.5" Effect="{StaticResource CardShadow}"
                                        MouseLeftButtonDown="QuickPoll_Click" Tag="truefalse">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="✅" FontSize="30" VerticalAlignment="Center"/>
                                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="📤 Chạm để phát" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Biểu quyết Đúng / Sai" FontSize="16" FontWeight="Bold" Foreground="#78350F" Margin="0,10,0,4"/>
                                        <TextBlock Text="A. Đúng / Đồng ý • B. Sai / Không đồng ý" FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtSlow" Text="0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Nhịp độ bài giảng -->
                                <Border Background="#F0F9FF" CornerRadius="14" Padding="18" Cursor="Hand"
                                        BorderBrush="#7DD3FC" BorderThickness="1.5" Effect="{StaticResource CardShadow}"
                                        MouseLeftButtonDown="QuickPoll_Click" Tag="pace">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="⏱️" FontSize="30" VerticalAlignment="Center"/>
                                            <Border Background="#E0F2FE" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="📤 Chạm để phát" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Nhịp độ bài giảng" FontSize="16" FontWeight="Bold" Foreground="#0C4A6E" Margin="0,10,0,4"/>
                                        <TextBlock Text="A. Vừa phải • B. Hơi nhanh • C. Hơi chậm" FontSize="12" Foreground="#0369A1" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtFast" Text="0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Quick Poll Tips Footer -->
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chế độ 100% RAM trong lớp: Dữ liệu chỉ hiển thị trực tiếp khi khảo sát đang bật. Khi bấm Kết thúc khảo sát hoặc đóng lớp, mọi dữ liệu tự động xóa trắng."
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ─────────────────────────────────────────────── -->
                    <!--  TAB 2: CUSTOM SURVEY (Câu hỏi tùy chỉnh)       -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Border x:Name="panelCustom" Visibility="Collapsed" Background="White" CornerRadius="16" 
                            Padding="24" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#EFF6FF" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                                            <TextBlock Text="📝" FontSize="15"/>
                                        </Border>
                                        <TextBlock Text="Soạn câu hỏi trắc nghiệm tức thời" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                    <TextBlock Text="Gửi câu hỏi và các phương án lựa chọn về máy học sinh để thu thập đáp án" 
                                               FontSize="12" Foreground="#64748B" Margin="32,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- [MYTHWARE_LITE] Ẩn lưu/chọn câu hỏi mẫu từ SQLite DB -->
                            <TextBlock Text="📋 Chọn câu hỏi mẫu có sẵn:" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cboSavedTemplates" Visibility="Collapsed" FontSize="13" Padding="10,8" Margin="0,0,0,14" 
                                      SelectionChanged="SavedTemplates_SelectionChanged"/>

                            <!-- Question -->
                            <TextBlock Text="Nội dung câu hỏi:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtQuestion" FontSize="14" Padding="12,10" MinHeight="50" AcceptsReturn="False"
                                     Style="{StaticResource ModernTextBox}"/>

                            <!-- Answer Options -->
                            <TextBlock Text="Các phương án trả lời:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,14,0,8"/>
                            <StackPanel x:Name="answerOptionsPanel">
                                <DockPanel Margin="0,0,0,8">
                                    <Border Background="#DCFCE7" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                        <TextBlock Text="A" FontSize="14" FontWeight="ExtraBold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="txtOptA" FontSize="13" Padding="10,8" Style="{StaticResource ModernTextBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border Background="#E0F2FE" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                        <TextBlock Text="B" FontSize="14" FontWeight="ExtraBold" Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="txtOptB" FontSize="13" Padding="10,8" Style="{StaticResource ModernTextBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border Background="#FEF3C7" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                        <TextBlock Text="C" FontSize="14" FontWeight="ExtraBold" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="txtOptC" FontSize="13" Padding="10,8" Style="{StaticResource ModernTextBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border Background="#FEE2E2" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                        <TextBlock Text="D" FontSize="14" FontWeight="ExtraBold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="txtOptD" FontSize="13" Padding="10,8" Style="{StaticResource ModernTextBox}"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Time Limit -->
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="⏱️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Giới hạn thời gian:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="cboTimeLimit" Width="160" FontSize="13" Padding="8,6" SelectedIndex="1">
                                    <ComboBoxItem Content="Không giới hạn" Tag="0"/>
                                    <ComboBoxItem Content="30 giây" Tag="30"/>
                                    <ComboBoxItem Content="1 phút" Tag="60"/>
                                    <ComboBoxItem Content="2 phút" Tag="120"/>
                                    <ComboBoxItem Content="5 phút" Tag="300"/>
                                    <ComboBoxItem Content="10 phút" Tag="600"/>
                                </ComboBox>
                            </DockPanel>

                            <!-- Action Buttons -->
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📤 Phát khảo sát tới Học sinh trong lớp" Padding="0,13"
                                        Background="#2563EB" Foreground="White" FontSize="14" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand" Click="SendCustomSurvey_Click"
                                        Template="{StaticResource RoundBtn}"/>
                                <!-- [MYTHWARE_LITE] Không lưu mẫu câu hỏi vào SQLite DB -->
                                <Button Grid.Column="1" Visibility="Collapsed" Content="💾 Lưu thành mẫu" Padding="18,13" Margin="10,0,0,0"
                                        Background="#059669" Foreground="White" FontSize="14" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand" Click="SaveTemplate_Click"
                                        Template="{StaticResource RoundBtn}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ─────────────────────────────────────────────── -->
                    <!--  TAB 3: SATISFACTION (Độ hài lòng lớp học)      -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Border x:Name="panelSatisfaction" Visibility="Collapsed" Background="White" CornerRadius="16" 
                            Padding="24" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#FEF3C7" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                                            <TextBlock Text="⭐" FontSize="15"/>
                                        </Border>
                                        <TextBlock Text="Đánh giá độ hài lòng buổi học" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                    <TextBlock Text="Phát form đánh giá 5 sao chuẩn sư phạm tới tất cả học sinh trong phiên dạy" 
                                               FontSize="12" Foreground="#64748B" Margin="32,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Preview of Satisfaction Criteria -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📋 Thang điểm đánh giá (sẽ hiển thị trên máy học sinh):" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                                    <TextBlock Text="Câu hỏi: Em cảm thấy buổi học hôm nay như thế nào?" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="8,2,0,8"/>
                                    <Grid Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="• ⭐ 1 sao — Chưa hiểu bài" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                                            <TextBlock Text="• ⭐⭐ 2 sao — Cần cố gắng thêm" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                                            <TextBlock Text="• ⭐⭐⭐ 3 sao — Tiếp thu bình thường" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="• ⭐⭐⭐⭐ 4 sao — Hài lòng, hiểu bài" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                                            <TextBlock Text="• ⭐⭐⭐⭐⭐ 5 sao — Rất thích, xuất sắc!" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Star Rating (Teacher local evaluation) -->
                            <Border Background="#FFFBEB" CornerRadius="12" Padding="18,16" Margin="0,0,0,16" BorderBrush="#FDE68A" BorderThickness="1.5">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="⭐ Giáo viên tự chấm điểm buổi dạy:" FontSize="14" FontWeight="Bold" Foreground="#B45309"/>
                                        <TextBlock Text="Chạm vào sao để đánh giá" FontSize="11" Foreground="#D97706" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,10">
                                        <TextBlock x:Name="gvStar1" Text="★" FontSize="44" Cursor="Hand" Margin="6,0" Foreground="#CBD5E1" MouseLeftButtonDown="Star_Click" Tag="1"/>
                                        <TextBlock x:Name="gvStar2" Text="★" FontSize="44" Cursor="Hand" Margin="6,0" Foreground="#CBD5E1" MouseLeftButtonDown="Star_Click" Tag="2"/>
                                        <TextBlock x:Name="gvStar3" Text="★" FontSize="44" Cursor="Hand" Margin="6,0" Foreground="#CBD5E1" MouseLeftButtonDown="Star_Click" Tag="3"/>
                                        <TextBlock x:Name="gvStar4" Text="★" FontSize="44" Cursor="Hand" Margin="6,0" Foreground="#CBD5E1" MouseLeftButtonDown="Star_Click" Tag="4"/>
                                        <TextBlock x:Name="gvStar5" Text="★" FontSize="44" Cursor="Hand" Margin="6,0" Foreground="#CBD5E1" MouseLeftButtonDown="Star_Click" Tag="5"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtStarResult" Text="Chưa có đánh giá" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#92400E" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Time Limit for satisfaction -->
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="⏱️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thời gian biểu quyết:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="cboSatisfactionTime" Width="160" FontSize="13" Padding="8,6" SelectedIndex="2">
                                    <ComboBoxItem Content="1 phút" Tag="60"/>
                                    <ComboBoxItem Content="2 phút" Tag="120"/>
                                    <ComboBoxItem Content="3 phút" Tag="180"/>
                                    <ComboBoxItem Content="5 phút" Tag="300"/>
                                </ComboBox>
                            </DockPanel>

                            <Button Content="📤 Phát động đánh giá tới học sinh" Padding="0,13"
                                    Background="#EA580C" Foreground="White" FontSize="14" FontWeight="Bold"
                                    BorderThickness="0" Cursor="Hand" Click="SendSatisfaction_Click"
                                    Template="{StaticResource RoundBtn}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════ -->
                <!--  RIGHT COLUMN: LIVE RESULTS & CLASSROOM MONITORING -->
                <!-- ═══════════════════════════════════════════════════ -->
                <!-- Must be directly inside a StackPanel for ShowToast() compatibility -->
                <StackPanel x:Name="rightColumnStack" Grid.Column="1">

                    <!-- 1. ACTIVE LIVE RESULTS PANEL (Real-time Broadcast) -->
                    <Border x:Name="surveyResultsPanel" Visibility="Collapsed"
                            Background="White" CornerRadius="16" Padding="22" Margin="0,0,0,16" 
                            BorderBrush="#93C5FD" BorderThickness="1.5" Effect="{StaticResource ActiveCardShadow}">
                        <StackPanel>
                            <!-- Header with total + timer -->
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#EFF6FF" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                                        <TextBlock Text="📊" FontSize="15"/>
                                    </Border>
                                    <TextBlock Text="Kết quả khảo sát trực tiếp" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Timer Badge -->
                                    <Border x:Name="timerBadge" Visibility="Collapsed" Background="#FEF3C7" CornerRadius="12" Padding="10,5" Margin="0,0,8,0"
                                            BorderBrush="#FDE68A" BorderThickness="1">
                                        <TextBlock FontSize="12">
                                            <Run Text="⏱️ Còn lại: " Foreground="#92400E"/>
                                            <Run x:Name="txtCountdown" Text="00:30" FontWeight="Bold" Foreground="#B45309"/>
                                        </TextBlock>
                                    </Border>
                                    <!-- Total Responses Badge -->
                                    <Border Background="#DBEAFE" CornerRadius="12" Padding="10,5" Margin="0,0,8,0" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <TextBlock FontSize="12">
                                            <Run Text="Tổng: " Foreground="#1E40AF"/>
                                            <Run x:Name="txtTotalVotes" Text="0" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            <Run Text=" phản hồi" Foreground="#1E40AF"/>
                                        </TextBlock>
                                    </Border>
                                    <!-- End & Wipe Survey Button -->
                                    <Button x:Name="btnEndSurvey" Content="⏹ Kết thúc khảo sát" Padding="12,5"
                                            Background="#DC2626" Foreground="White" FontSize="12" FontWeight="Bold"
                                            BorderThickness="0" Cursor="Hand" Click="EndActiveSurvey_Click"
                                            ToolTip="Đóng khảo sát trên toàn bộ máy Học sinh và xóa sạch kết quả tạm trên RAM"
                                            Template="{StaticResource RoundBtn}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Question display -->
                            <Border Background="#EEF2FF" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="#C7D2FE" BorderThickness="1">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="❓ Câu hỏi: " FontSize="13" FontWeight="Bold" Foreground="#4338CA"/>
                                    <Run x:Name="txtActiveQuestion" Text="" Foreground="#1E1B4B" FontWeight="Bold" FontSize="14"/>
                                </TextBlock>
                            </Border>

                            <!-- Dynamic results bars generated by code-behind -->
                            <StackPanel x:Name="resultBarsPanel" Margin="0,0,0,14"/>

                            <!-- Student Star Rating Summary -->
                            <Border x:Name="panelStudentStarRating" Visibility="Collapsed" Background="#FFFBEB" CornerRadius="10" 
                                    Padding="14,12" Margin="0,0,0,14" BorderBrush="#FDE68A" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="⭐ Điểm đánh giá trung bình từ học sinh:" FontSize="13" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtStudentStarAvg" Text="0.0 / 5.0" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtStudentStarCount" Text="(0 lượt)" FontSize="12" Foreground="#78350F" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Student Response Feed / Log -->
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="📝 Nhật ký câu trả lời theo thời gian thực" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                                        <TextBlock Text="Tự động cập nhật" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="surveyResponseLog">
                                            <TextBlock Text="⏳ Đang chờ phản hồi từ học sinh..." FontSize="13" Foreground="#94A3B8" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,12"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. DEFAULT MONITORING & INSIGHTS CARD (Always visible to utilize right column space) -->
                    <Border Background="White" CornerRadius="16" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F0FDF4" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                                        <TextBlock Text="📡" FontSize="15"/>
                                    </Border>
                                    <TextBlock Text="Trung tâm Phản hồi &amp; Tương tác" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#F1F5F9" CornerRadius="12" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="SẴN SÀNG" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </DockPanel>

                            <TextBlock Text="Theo dõi mức độ tương tác và sự tập trung của học sinh trong giờ học thông qua các hình thức thăm dò đa dạng."
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <!-- Feature 1: Quick Poll Guide -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FEF3C7" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="1. Mẫu 1 chạm (Instant Quick Poll)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="Bấm 1 chạm để phát ngay câu hỏi thăm dò mức độ hiểu bài, A/B/C/D, Đúng/Sai hoặc tốc độ bài giảng tới toàn bộ máy Học sinh trong lớp."
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 2: Custom Quiz Guide -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="2. Tự nhập câu hỏi nhanh (Custom Poll)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="Nhập câu hỏi và các đáp án A/B/C/D tùy ý. Biểu đồ phần trăm phản hồi hiển thị trực tiếp ngay khi học sinh bấm chọn."
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 3: Ephemeral RAM Privacy Guide -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="3. Chỉ lưu tạm lúc khảo sát (Không ghi Database)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="Khi bấm Kết thúc khảo sát hoặc thoát lớp, toàn bộ câu hỏi và số phiếu tự xóa sạch trên cả máy Giáo viên và Học sinh."
                                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Quick Stat Banner -->
                            <Border Background="#F1F5F9" CornerRadius="10" Padding="14,10">
                                <DockPanel>
                                    <TextBlock Text="💡 Gợi ý sư phạm:" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nên tổ chức thăm dò mỗi 15-20 phút giảng bài để duy trì nhịp độ chú ý." 
                                               FontSize="12" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

