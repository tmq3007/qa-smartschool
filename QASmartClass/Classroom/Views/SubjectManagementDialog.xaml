<Window x:Class="QASmartClass.Classroom.Views.SubjectManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Danh mục Môn học"
        Width="880" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Modern ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="16,16,0,0" Padding="24,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button Content="✕" DockPanel.Dock="Right" Width="36" Height="36" FontSize="16" FontWeight="Bold"
                            Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#3B82F6" Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="📚" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Quản lý Danh mục Môn học" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Cấu hình tên môn, màu sắc nhận diện và phòng chuyên dụng trên Thời khóa biểu" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ CONTENT (2 Columns) ═══ -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/> <!-- Subject List -->
                    <ColumnDefinition Width="16"/>  <!-- Spacer -->
                    <ColumnDefinition Width="*"/>   <!-- Editor Form -->
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Search & Subject List -->
                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="🔍" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged"/>
                            </DockPanel>
                        </Border>

                        <!-- Action Bar: Add new subject button -->
                        <Button Grid.Row="1" Content="➕ Thêm môn học mới" Height="38" FontSize="13" FontWeight="SemiBold"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"
                                Click="BtnNewSubject_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Subject ListBox -->
                        <ListBox x:Name="lstSubjects" Grid.Row="2" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="LstSubjects_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="#93C5FD"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#DBEAFE"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                        <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <!-- Color indicator strip -->
                                        <Border Width="6" Height="36" CornerRadius="3" DockPanel.Dock="Left" Margin="0,0,10,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding ColorHex}"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- Icon -->
                                        <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>

                                        <!-- Short name badge -->
                                        <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding ShortName}" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                        </Border>

                                        <!-- Name & Room -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DefaultRoom, TargetNullValue='Phòng chung'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: Editor Form -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Form Header -->
                            <TextBlock x:Name="txtFormTitle" Text="Chỉnh sửa Môn học" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                            <!-- Row 1: Name and ShortName -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tên môn học *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtName" Height="38" FontSize="13" Padding="10,8" BorderBrush="#CBD5E1"
                                             TextChanged="TxtName_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tên viết tắt *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtShortName" Height="38" FontSize="13" Padding="10,8" BorderBrush="#CBD5E1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Icon and Default Room -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Biểu tượng (Icon)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <DockPanel LastChildFill="True">
                                        <Border Width="38" Height="38" Background="#F1F5F9" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,6,0" DockPanel.Dock="Left">
                                            <TextBlock x:Name="txtSelectedIconPreview" Text="📚" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox x:Name="txtIcon" Height="38" FontSize="14" Padding="8,8" BorderBrush="#CBD5E1"
                                                 TextChanged="TxtIcon_TextChanged"/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phòng chuyên dụng mặc định" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtDefaultRoom" Height="38" FontSize="13" Padding="10,8" BorderBrush="#CBD5E1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Preset Icons selector -->
                            <TextBlock Text="Gợi ý biểu tượng:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="panelIconPresets" Margin="0,0,0,14"/>

                            <!-- Row 3: Color Palette Picker -->
                            <TextBlock Text="Màu sắc nhận diện trên Thời khóa biểu *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <Border x:Name="bdColorPreview" Width="26" Height="26" CornerRadius="6" BorderBrush="#94A3B8" BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,8,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1976D2"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="Mã màu HEX: " FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtColorHex" Width="90" Height="28" FontSize="12" Padding="6,3" BorderBrush="#CBD5E1"
                                                 HorizontalAlignment="Left" Text="#1976D2" TextChanged="TxtColorHex_TextChanged"/>
                                    </DockPanel>

                                    <!-- 20 Preset Colors Grid -->
                                    <WrapPanel x:Name="panelColorPresets"/>
                                </StackPanel>
                            </Border>

                            <!-- Row 4: Weekly Periods & Display Order -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số tiết định mức / tuần" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtWeeklyPeriods" Height="38" FontSize="13" Padding="10,8" BorderBrush="#CBD5E1" Text="2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Thứ tự hiển thị" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtDisplayOrder" Height="38" FontSize="13" Padding="10,8" BorderBrush="#CBD5E1" Text="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Form Action Buttons -->
                            <DockPanel LastChildFill="False">
                                <Button x:Name="btnDelete" Content="🗑️ Xóa môn này" Height="40" FontSize="13" FontWeight="SemiBold"
                                        Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" Padding="14,0"
                                        DockPanel.Dock="Left" Click="BtnDelete_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnSave" Content="💾 Lưu môn học" Height="40" FontSize="13" FontWeight="Bold"
                                        Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="20,0"
                                        DockPanel.Dock="Right" Click="BtnSave_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,16,16" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <Button Content="🔄 Khôi phục 20 môn chuẩn GDPT 2018" FontSize="12" FontWeight="SemiBold"
                            Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand"
                            DockPanel.Dock="Left" Click="BtnResetDefaults_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="txtStatusMsg" Text="Đã sẵn sàng" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="Hoàn tất &amp; Đóng" Width="120" Height="36" FontSize="13" FontWeight="SemiBold"
                                Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
