<Page x:Class="QASmartClass.Classroom.Views.MessagingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tin nhắn" Background="#F0F2F5">

    <Page.Resources>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="ContactItemContextMenu">
            <MenuItem Header="🔓 Cho phép phát biểu (Mở khóa)" Click="AllowStudentChat_Click"/>
            <MenuItem Header="🔒 Khóa chat riêng" Click="MuteStudentChat_Click"/>
        </ContextMenu>

        <Style x:Key="ContactItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{StaticResource ContactItemContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="450"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT SIDEBAR — Contacts & Channels ═══ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <DockPanel Grid.Row="0" Margin="16,14,16,8">
                    <Button DockPanel.Dock="Right" Content="➕ Tạo nhóm" FontSize="11" Padding="8,5"
                            Style="{StaticResource RoundBtn}" Background="#E8F5E9" Foreground="#2E7D32"
                            Click="CreateGroup_Click" ToolTip="Tạo nhóm học sinh mới" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="💬 Tin nhắn" FontSize="18" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock x:Name="txtOnlineCount" Text="0 học sinh online" FontSize="11" Foreground="#9E9E9E" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Search box -->
                <Border Grid.Row="1" Margin="12,0,12,8" Background="#F5F7FA" CornerRadius="10" Padding="10,7">
                    <Grid>
                        <TextBlock x:Name="searchPlaceholder" Text="🔍 Tìm kiếm..." FontSize="12" Foreground="#BDBDBD"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" FontSize="12"
                                 VerticalContentAlignment="Center" TextChanged="Search_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Channel tabs -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8">
                    <Button x:Name="tabAll" Content="📋 Tất cả" FontSize="11" Padding="10,5"
                            Style="{StaticResource RoundBtn}" Background="#1976D2" Foreground="White"
                            Margin="0,0,4,0" Click="TabAll_Click"/>
                    <Button x:Name="tabGroup" Content="👥 Cả lớp" FontSize="11" Padding="10,5"
                            Style="{StaticResource RoundBtn}" Background="#F5F5F5" Foreground="#616161"
                            Margin="0,0,4,0" Click="TabGroup_Click"/>
                    <Button x:Name="tabPrivate" Content="🔒 Riêng" FontSize="11" Padding="10,5"
                            Style="{StaticResource RoundBtn}" Background="#F5F5F5" Foreground="#616161"
                            Click="TabPrivate_Click"/>
                </StackPanel>

                <!-- ═══ Sort options ═══ -->
                <Border Grid.Row="3" Margin="12,0,12,6" Background="#FAFAFA" CornerRadius="8" Padding="4,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sắp xếp:" FontSize="10" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <Button x:Name="sortOnline" Content="🟢 Online" FontSize="10" Padding="6,3"
                                Style="{StaticResource RoundBtn}" Background="#E8F5E9" Foreground="#2E7D32"
                                Margin="0,0,3,0" Click="SortOnline_Click" ToolTip="Online lên đầu"/>
                        <Button x:Name="sortName" Content="A→Z" FontSize="10" Padding="6,3"
                                Style="{StaticResource RoundBtn}" Background="#F5F5F5" Foreground="#616161"
                                Margin="0,0,3,0" Click="SortName_Click" ToolTip="Sắp xếp theo tên"/>
                        <Button x:Name="sortRecent" Content="🕐 Mới" FontSize="10" Padding="6,3"
                                Style="{StaticResource RoundBtn}" Background="#F5F5F5" Foreground="#616161"
                                Margin="0,0,3,0" Click="SortRecent_Click" ToolTip="Tin nhắn gần nhất"/>
                        <Button x:Name="sortUnread" Content="🔴 Chưa đọc" FontSize="10" Padding="6,3"
                                Style="{StaticResource RoundBtn}" Background="#F5F5F5" Foreground="#616161"
                                Click="SortUnread_Click" ToolTip="Tin chưa đọc lên đầu"/>
                    </StackPanel>
                </Border>

                <!-- Contact / Channel List -->
                <ListBox x:Name="contactList" Grid.Row="4" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Contact_SelectionChanged"
                         ItemContainerStyle="{StaticResource ContactItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding FullIdentity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Grid Grid.Column="0">
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="{Binding AvatarBg}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarText}" FontSize="14" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Online status dot -->
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,0,0" BorderBrush="White" BorderThickness="1.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Background" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <!-- Role badge overlay -->
                                    <TextBlock Text="{Binding RoleBadge}" FontSize="10"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Margin="-2,-2,0,0"/>
                                </Grid>

                                <!-- Name + class + last message -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <DockPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#212121" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FeedbackEmoji}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#FF9800"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding LastMessage}" FontSize="11" Foreground="#9E9E9E"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                </StackPanel>

                                <!-- Time + unread badge -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastTimeStr}" FontSize="10" Foreground="#BDBDBD"
                                               HorizontalAlignment="Right"/>
                                    <Border x:Name="unreadBadge" CornerRadius="9" MinWidth="18" Height="18"
                                            Background="#EF5350" Margin="0,3,0,0" HorizontalAlignment="Right"
                                            Padding="5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding UnreadCount}" FontSize="9" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Grid Splitter cho phép kéo giãn co chiều rộng Sidebar -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" Background="#E0E0E0" ShowsPreview="True"/>

        <!-- ═══ RIGHT SIDE — Chat Area ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Chat Header — Avatar + Name + Stats ══ -->
            <Border Grid.Row="0" Background="White" Padding="16,10,16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Right: action buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnToggleMuteChat" Content="🔓 Khóa chat" Style="{StaticResource RoundBtn}"
                                Background="#E0F2F1" Foreground="#00796B" FontSize="11"
                                Margin="0,0,4,0" Click="ToggleMuteChat_Click"/>
                        <Button Content="📢 Thông báo" Style="{StaticResource RoundBtn}"
                                Background="#FFF3E0" Foreground="#E65100" FontSize="11"
                                Margin="0,0,4,0" Click="BroadcastAnnounce_Click"/>
                        <Button Content="📜 Lịch sử" Style="{StaticResource RoundBtn}"
                                Background="#E8EAF6" Foreground="#283593" FontSize="11"
                                Margin="0,0,4,0" Click="ShowHistory_Click"/>
                        <Button Content="🗑️" ToolTip="Xóa tin nhắn" Style="{StaticResource RoundBtn}"
                                Background="#FFEBEE" Foreground="#C62828" FontSize="11"
                                Click="ClearChat_Click"/>
                    </StackPanel>

                    <!-- Left: avatar + info -->
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="chatAvatar" Width="42" Height="42" CornerRadius="21"
                                Background="#1976D2" VerticalAlignment="Center">
                            <TextBlock x:Name="chatAvatarText" Text="👥" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtChatTitle" Text="Cả lớp" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A"/>
                            <TextBlock x:Name="txtChatSubtitle" Text="Nhắn tin nhóm với toàn bộ học sinh" FontSize="12.5" Foreground="#616161"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══ Sub-header — Channel tabs + stats ══ -->
            <Border Grid.Row="1" Background="#FAFBFC" Padding="16,5,16,5" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Right stats -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="chkAnonymousFeedback" Content="Ẩn danh phản hồi" FontSize="11" Foreground="#616161" Margin="0,0,14,0" VerticalAlignment="Center" Checked="chkAnonymousFeedback_Checked" Unchecked="chkAnonymousFeedback_Unchecked"/>
                        <TextBlock Text="Độ hiểu bài:" FontSize="11" Foreground="#616161" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ProgressBar x:Name="barUnderstanding" Width="60" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Tỷ lệ hiểu bài của lớp học" Background="#E8EAF6" Foreground="#4CAF50"/>
                        <TextBlock x:Name="txtFeedbackStats" Text="💡:0 | ❓:0 | 🙋:0 | ⏳:0" FontSize="13" FontWeight="Bold" Foreground="#E65100" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtChannelStats" Text="0 tin nhắn" FontSize="11" Foreground="#616161" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Left tabs -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E3F2FD" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                            <TextBlock Text="💬 Trò chuyện" FontSize="10.5" FontWeight="SemiBold" Foreground="#1976D2"/>
                        </Border>
                        <Border x:Name="tabMembers" Background="#F5F5F5" CornerRadius="10" Padding="10,3" Margin="0,0,6,0" Cursor="Hand" PreviewMouseLeftButtonDown="TabMembers_Click">
                            <TextBlock x:Name="txtTabMembers" Text="👥 0 thành viên" FontSize="10.5" Foreground="#757575"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══ Chat Messages Area ══ -->
            <Border Grid.Row="2" Background="#F0F2F5">
                <ListView x:Name="chatList" BorderThickness="0" Background="Transparent"
                          Padding="16,8" ItemsSource="{Binding FilteredMessages}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- ─ Date Separator ─ -->
                                <Border HorizontalAlignment="Center" Margin="0,8,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDateSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border Background="#E0E0E0" CornerRadius="10" Padding="16,3">
                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#616161" FontWeight="SemiBold"/>
                                    </Border>
                                </Border>

                                <!-- ─ System message (center) ─ -->
                                <Border HorizontalAlignment="Center" Margin="0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border Background="#E8EAF6" CornerRadius="12" Padding="14,5">
                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#5C6BC0" FontStyle="Italic"/>
                                    </Border>
                                </Border>

                                <!-- ─ Teacher message (right, blue bubble) ─ -->
                                <StackPanel HorizontalAlignment="Right" Margin="100,2,0,2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTeacher}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border CornerRadius="16,4,16,16" Padding="14,9" MaxWidth="450" HorizontalAlignment="Right">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1976D2" Offset="0"/>
                                                <GradientStop Color="#1565C0" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Text}" FontSize="14.5" Foreground="White" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="{Binding TimeStr}" FontSize="9" Foreground="#BDBDBD"
                                               HorizontalAlignment="Right" Margin="0,2,4,0"/>
                                </StackPanel>

                                <!-- ─ Student message (left, avatar + author header + bubble) ─ -->
                                <StackPanel HorizontalAlignment="Left" Margin="0,2,100,2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTeacher}" Value="False"/>
                                                        <Condition Binding="{Binding IsSystem}" Value="False"/>
                                                        <Condition Binding="{Binding IsDateSeparator}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <DockPanel>
                                        <!-- Avatar circle -->
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17"
                                                Background="{Binding AvatarBg}" VerticalAlignment="Top" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding AvatarText}" FontSize="12" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <!-- Author name + @code + time -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Author}" FontSize="12" Foreground="#1976D2"
                                                           FontWeight="SemiBold" Cursor="Hand"/>
                                                <TextBlock Text="{Binding StudentCodeDisplay}" FontSize="10" Foreground="#9E9E9E"
                                                           Margin="6,2,0,0" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="{Binding TimeStr}" FontSize="10" Foreground="#BDBDBD"
                                                           Margin="8,2,0,0" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                            <!-- Message text (multi-line) -->
                                            <Border Background="White" CornerRadius="4,16,16,16" Padding="14,9"
                                                    MaxWidth="420" HorizontalAlignment="Left"
                                                    BorderBrush="#E8E8E8" BorderThickness="1">
                                                <TextBlock Text="{Binding Text}" FontSize="14.5" Foreground="#1A1A1A" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- ══ Input Bar — Enhanced ══ -->
            <Border Grid.Row="3" Background="White" Padding="10,8,10,8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left buttons: attach -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➕" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Đính kèm tệp"
                                Style="{StaticResource RoundBtn}" Background="Transparent"
                                Foreground="#757575" Padding="6,4" Margin="0,0,2,0"
                                Click="AttachFile_Click"/>
                    </StackPanel>

                    <!-- Text input -->
                    <Border Grid.Column="1" Background="#F5F7FA" CornerRadius="20" Padding="14,0" Margin="4,0">
                        <Grid>
                            <TextBlock x:Name="inputPlaceholder" Text="Gõ và nhấn Enter để gửi tin nhắn"
                                       FontSize="13" Foreground="#BDBDBD" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="txtInput" Background="Transparent" BorderThickness="0"
                                     FontSize="13" FontFamily="Segoe UI Emoji" VerticalContentAlignment="Center"
                                     AcceptsReturn="False" KeyDown="Input_KeyDown"
                                     TextChanged="Input_TextChanged"
                                     Padding="0,7"/>
                        </Grid>
                    </Border>

                    <!-- Right buttons: emoji, like, attach, sticker, emoji, send -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="😊" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Biểu cảm"
                                Style="{StaticResource RoundBtn}" Background="Transparent"
                                Foreground="#757575" Padding="5,4" Margin="2,0"
                                Click="ShowEmoji_Click"/>
                        <Button Content="👍" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Thích"
                                Style="{StaticResource RoundBtn}" Background="Transparent"
                                Foreground="#757575" Padding="5,4" Margin="2,0"
                                Click="QuickLike_Click"/>
                        <Button Content="📎" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Đính kèm ảnh / file"
                                Style="{StaticResource RoundBtn}" Background="Transparent"
                                Foreground="#757575" Padding="5,4" Margin="2,0"
                                Click="AttachMedia_Click"/>
                        <Button Content="🎤" FontSize="15" FontFamily="Segoe UI Emoji" ToolTip="Ghi âm giọng nói"
                                Style="{StaticResource RoundBtn}" Background="Transparent"
                                Foreground="#757575" Padding="5,4" Margin="2,0"
                                Click="VoiceRecord_Click"/>
                        <Button Content="😃" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Sticker"
                                Style="{StaticResource RoundBtn}" Background="Transparent"
                                Foreground="#757575" Padding="5,4" Margin="2,0,4,0"
                                Click="ShowSticker_Click"/>

                        <!-- Send button -->
                        <Button Width="38" Height="38" Margin="4,0,0,0"
                                Click="Send_Click" ToolTip="Gửi tin nhắn">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="19" Width="38" Height="38">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1976D2" Offset="0"/>
                                                <GradientStop Color="#0D47A1" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="▶" FontSize="15" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
