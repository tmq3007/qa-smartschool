                            <TextBox x:Name="txtPinDigit3" MaxLength="1" Width="40" Height="45" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3" KeyUp="OtpTextBox_KeyUp" PreviewKeyDown="OtpTextBox_PreviewKeyDown" ToolTip="Chữ số thứ 3" FontWeight="Bold" Background="#F8F9FA"/>
                            <TextBox x:Name="txtPinDigit4" MaxLength="1" Width="40" Height="45" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3" KeyUp="OtpTextBox_KeyUp" PreviewKeyDown="OtpTextBox_PreviewKeyDown" ToolTip="Chữ số thứ 4" FontWeight="Bold" Background="#F8F9FA"/>
                            <TextBox x:Name="txtPinDigit5" MaxLength="1" Width="40" Height="45" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3" KeyUp="OtpTextBox_KeyUp" PreviewKeyDown="OtpTextBox_PreviewKeyDown" ToolTip="Chữ số thứ 5" FontWeight="Bold" Background="#F8F9FA"/>
