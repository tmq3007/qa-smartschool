                    <Button Grid.Row="2" Content="🔓 Mở khóa thiết lập" Padding="15,10" Background="#1976D2" Foreground="White" Click="btnIdleUnlock_Click" Cursor="Hand" Width="200" Margin="0,16,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
