<Page x:Class="QASmartClass.Classroom.Views.HomeworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F2F5">

    <Page.Resources>
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="#000"/>
        
        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Subtle / Outline Button -->
        <Style x:Key="SubtleBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab-like filter button -->
        <Style x:Key="FilterBtn" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: HEADER ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="22,16" Margin="0,0,0,10"
                Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1565C0" Offset="0"/>
                    <GradientStop Color="#1E88E5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Right side: Action buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 Tải mẫu Word" Padding="16,10" FontSize="14"
                            Background="#FFF8E1" Foreground="#F57F17" FontWeight="SemiBold"
                            Style="{StaticResource PrimaryBtn}" Command="{Binding DownloadTemplateCommand}"
                            ToolTip="Tải file Word mẫu để điền thông tin bài tập" Margin="0,0,8,0"/>
                    <Button Content="📄 Nhập từ Word" Padding="16,10" FontSize="14"
                            Background="#FFFFFF" Foreground="#1565C0" FontWeight="SemiBold"
                            Style="{StaticResource PrimaryBtn}" Command="{Binding ImportFromWordCommand}" Margin="0,0,8,0"/>
                    <Button Content="➕ Giao BTVN mới" Padding="16,10" FontSize="14"
                            Style="{StaticResource PrimaryBtn}" Command="{Binding CreateHomeworkCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#43A047" Offset="0"/>
                                <GradientStop Color="#66BB6A" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <!-- Left side: Title -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📝 Bài Tập Về Nhà" FontSize="24" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI Semibold"/>
                    <TextBlock x:Name="txtSubtitle" Text="{Binding Subtitle}"
                               FontSize="13.5" Foreground="#B3D9FF" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ ROW 1: GUIDE PANEL (collapsible) ═══ -->
        <Border x:Name="guidePanel" Grid.Row="1" Background="White" CornerRadius="12" Padding="18,14"
                Margin="0,0,0,10" Effect="{StaticResource CardShadow}" Visibility="Visible">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="✕ Ẩn" FontSize="10" Background="Transparent"
                            Foreground="#868E96" BorderThickness="0" Cursor="Hand" Click="HideGuide_Click"
                            VerticalAlignment="Top" Padding="6,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hướng dẫn sử dụng" FontSize="14" FontWeight="Bold" Foreground="#1565C0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Template -->
                    <Border Grid.Column="0" Background="#FFF3E0" CornerRadius="10" Padding="14,12" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="① Tải mẫu Word" FontSize="13.5" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#495057"
                                       Text="Nhấn '📥 Tải mẫu Word' để lấy file mẫu có sẵn cấu trúc. Mở file, điền nội dung bài tập vào các mục."/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Import -->
                    <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="10" Padding="14,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="② Nhập từ Word" FontSize="13.5" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#495057"
                                       Text="Nhấn '📄 Nhập từ Word' để import file đã sửa. Hoặc nhấn '➕ Giao BTVN mới' để nhập tay."/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Send -->
                    <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="10" Padding="14,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="③ Gửi cho HS" FontSize="13.5" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#495057"
                                       Text="Bài tập tự động gửi đến HS. Có thể đính kèm file Word/PDF. Nhấn '📤 Gửi lại' nếu cần."/>
                        </StackPanel>
                    </Border>

                    <!-- Step 4: Track -->
                    <Border Grid.Column="3" Background="#FFF8E1" CornerRadius="10" Padding="14,12" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="④ Theo dõi" FontSize="13.5" FontWeight="Bold" Foreground="#F57F17" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#495057"
                                       Text="Xem trạng thái: đang mở / hết hạn. Chỉnh sửa ✏️ hoặc xóa 🗑️ bài tập đã giao."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 2: STATS BAR + FILTER ═══ -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,10"
                Effect="{StaticResource CardShadow}">
            <DockPanel>
                <!-- Right: Filter -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="filterAll" Style="{StaticResource FilterBtn}" Background="#E3F2FD"
                            MouseLeftButtonDown="Filter_Click" Tag="all" Padding="16,8">
                        <TextBlock Text="Tất cả" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0"/>
                    </Border>
                    <Border x:Name="filterActive" Style="{StaticResource FilterBtn}"
                            MouseLeftButtonDown="Filter_Click" Tag="active" Margin="4,0" Padding="16,8">
                        <TextBlock Text="🟢 Đang mở" FontSize="13" Foreground="#495057"/>
                    </Border>
                    <Border x:Name="filterExpired" Style="{StaticResource FilterBtn}"
                            MouseLeftButtonDown="Filter_Click" Tag="expired" Padding="16,8">
                        <TextBlock Text="⏰ Hết hạn" FontSize="13" Foreground="#495057"/>
                    </Border>
                    <Border Margin="8,0,0,0" Background="#F1F3F5" CornerRadius="8" Padding="4">
                        <Button Content="💡 Hướng dẫn" FontSize="12" Background="Transparent" Foreground="#868E96"
                                BorderThickness="0" Cursor="Hand" Click="ShowGuide_Click" Padding="10,4"/>
                    </Border>
                </StackPanel>

                <!-- Left: Stats -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E3F2FD" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock x:Name="txtStatTotal" Text="{Binding StatTotal}" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0"/>
                    </Border>
                    <Border Background="#E8F5E9" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock x:Name="txtStatActive" Text="{Binding StatActive}" FontSize="13" Foreground="#2E7D32"/>
                    </Border>
                    <Border Background="#F1F3F5" CornerRadius="8" Padding="12,6">
                        <TextBlock x:Name="txtStatExpired" Text="{Binding StatExpired}" FontSize="13" Foreground="#868E96"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ ROW 3: HOMEWORK LIST ═══ -->
        <Grid Grid.Row="3" Margin="0">
            <Border Background="White" CornerRadius="12" Padding="12" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BgBorder}" 
                                        BorderBrush="{Binding BorderBrush}" 
                                        BorderThickness="1" CornerRadius="12" Margin="0,0,0,8">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ToggleExpandCommand}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Background="{Binding AccentColor}" CornerRadius="12,0,0,12" Width="5"/>
                                        
                                        <StackPanel Grid.Column="1" Margin="16,14,12,14">
                                            <DockPanel Margin="0,0,0,6">
                                                <Border Background="#E3F2FD" CornerRadius="8" Padding="10,4.5" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding Item.Subject, StringFormat='📚 {0}'}" FontSize="12" Foreground="#1565C0" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayIndex}" FontSize="12" Foreground="#ADB5BD" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            
                                            <TextBlock Text="{Binding Item.Title}" FontSize="18" FontWeight="Bold" Foreground="#212121" TextWrapping="Wrap" FontFamily="Segoe UI Semibold"/>
                                            
                                            <TextBlock Text="{Binding Item.Description}" FontSize="14.5" Foreground="#495057" TextWrapping="Wrap" Margin="0,6,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="MaxHeight" Value="42"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="MaxHeight" Value="9999"/>
                                                                <Setter Property="TextTrimming" Value="None"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            
                                            <Button Command="{Binding ToggleExpandCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1565C0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🔽 Xem chi tiết"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="🔼 Thu gọn"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            
                                            <WrapPanel Margin="0,8,0,0">
                                                <Border Background="#F3E5F5" CornerRadius="8" Padding="10,4.5" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding Item.CreatedAt, StringFormat='📅 Giao: {0:dd/MM/yyyy}'}" FontSize="12" Foreground="#7B1FA2"/>
                                                </Border>
                                                <Border Background="{Binding DeadlineBg}" CornerRadius="8" Padding="10,4.5" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding Item.Deadline, StringFormat='⏰ Hạn: {0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="{Binding DeadlineFg}"/>
                                                </Border>
                                                <Border Background="{Binding TimeInfoBg}" CornerRadius="8" Padding="10,4.5" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding TimeInfo, StringFormat='⏳ {0}'}" FontSize="12" Foreground="{Binding TimeInfoFg}"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,12,14,12" MinWidth="120">
                                            <Border Background="{Binding DeadlineBg}" CornerRadius="8" Padding="12,6" Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding AccentColor}" HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="📤" FontSize="15" ToolTip="Gửi lại cho HS" Padding="10,6" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Cursor="Hand" Command="{Binding ResendCommand}"/>
                                                <Button Content="✏️" FontSize="15" ToolTip="Chỉnh sửa" Padding="10,6" Background="#FFF8E1" Foreground="#F57F17" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0" Command="{Binding EditCommand}" CommandParameter="{Binding Item}"/>
                                                <Button Content="🗑️" FontSize="15" ToolTip="Xóa bài tập" Padding="10,6" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0" Command="{Binding DeleteCommand}" CommandParameter="{Binding Item}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            
            <!-- Empty State Placeholder Overlay -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📋" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Chưa có bài tập nào được giao" FontSize="18" FontWeight="Bold" Foreground="#868E96" HorizontalAlignment="Center"/>
                <TextBlock Text="Hãy nhấn nút 'Giao BTVN mới' ở phía trên để bắt đầu." FontSize="13.5" Foreground="#ADB5BD" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
