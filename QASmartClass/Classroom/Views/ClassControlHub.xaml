<Page x:Class="QASmartClass.Classroom.Views.ClassControlHub"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Điều Khiển Lớp Học"
      Background="#F0F2F5"
      FontFamily="Segoe UI, Inter"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- ═══ Menu dọc bên trái (thay cho tab ngang). Giữ key "HubTabButton"/"HubTabButtonActive" để code-behind không đổi ═══ -->
        <Style x:Key="HubTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubTabButtonActive" TargetType="Button" BasedOn="{StaticResource HubTabButton}">
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="Background" Value="#EAF2FD"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ═══ Ô hành động nhanh (touch-friendly, icon lớn + chú thích) ═══ -->
        <Style x:Key="QuickActionButtonPrimary" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionButtonNeutral" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- [RULE] QC_4.2_LAYOUT_GRID: rootGrid Stretch, No MaxWidth -->
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/> <!-- Menu dọc -->
            <ColumnDefinition Width="*"/>   <!-- Nội dung -->
        </Grid.ColumnDefinitions>

        <!-- ═══ 1. MENU DỌC BÊN TRÁI ═══ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,16">
                    <TextBlock Text="🖥️ ĐIỀU KHIỂN" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="LỚP HỌC" FontSize="17" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock Text="Chọn chức năng bên dưới" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="tabBtnMonitor" Style="{StaticResource HubTabButtonActive}" Tag="Monitor" Click="TabButton_Click">
                        <StackPanel>
                            <TextBlock Text="🖥️  Giám sát &amp; Quản lý lớp"/>
                            <TextBlock Text="Xem màn hình, trạng thái học sinh" FontSize="11" FontWeight="Normal" Opacity="0.75" Margin="26,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="tabBtnBroadcast" Style="{StaticResource HubTabButton}" Tag="Broadcast" Click="TabButton_Click">
                        <StackPanel>
                            <TextBlock Text="📺  Trình chiếu &amp; Phát sóng"/>
                            <TextBlock Text="Chiếu màn hình cho cả lớp" FontSize="11" FontWeight="Normal" Opacity="0.75" Margin="26,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="tabBtnFiles" Style="{StaticResource HubTabButton}" Tag="Files" Click="TabButton_Click">
                        <StackPanel>
                            <TextBlock Text="📁  Trao đổi tài liệu"/>
                            <TextBlock Text="Gửi / nhận file với học sinh" FontSize="11" FontWeight="Normal" Opacity="0.75" Margin="26,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="tabBtnWeb" Style="{StaticResource HubTabButton}" Tag="Web" Click="TabButton_Click">
                        <StackPanel>
                            <TextBlock Text="🌐  Điều hướng website"/>
                            <TextBlock Text="Đẩy trang web tới máy học sinh" FontSize="11" FontWeight="Normal" Opacity="0.75" Margin="26,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ 2. KHU VỰC NỘI DUNG ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Trạng thái + điều khiển nhanh (1 hàng duy nhất) -->
                <RowDefinition Height="*"/>    <!-- Sub-page -->
            </Grid.RowDefinitions>

            <!-- Thanh trạng thái + điều khiển nhanh: chỉ giữ thao tác TOÀN LỚP (khóa/mở khóa/im lặng).
                 Phát màn hình / Gửi file / Mở web đã có ở menu dọc bên trái nên không lặp lại ở đây. -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,10">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnQuickLock" Style="{StaticResource QuickActionButtonPrimary}" Background="#DC2626" MinHeight="46" Padding="14,6" Click="QuickLock_Click" ToolTip="Khóa màn hình và chuột bàn phím tất cả máy học sinh">
                        <TextBlock Text="🔒 Khóa tất cả" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="btnQuickUnlock" Style="{StaticResource QuickActionButtonPrimary}" Background="#16A34A" MinHeight="46" Padding="14,6" Click="QuickUnlock_Click" ToolTip="Mở khóa tất cả máy học sinh">
                        <TextBlock Text="🔓 Mở khóa" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="btnQuickMute" Style="{StaticResource QuickActionButtonNeutral}" MinHeight="46" Padding="14,6" Click="QuickMute_Click" ToolTip="Bật / Tắt chế độ yêu cầu im lặng">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="iconQuickMute" Text="🔇" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtQuickMute" Text="Im lặng"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái lớp" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <!-- Live Share Status Pill -->
                    <Border x:Name="pillLiveStatus" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="dotLiveStatus" Width="9" Height="9" Fill="#94A3B8" Margin="0,0,7,0"/>
                            <TextBlock x:Name="txtLiveStatus" Text="Chưa phát màn hình" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Border>

                    <!-- Student Count Pill -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock x:Name="txtStudentCount" Text="👥 0 Học sinh" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                    </Border>

                    <!-- Silence Pill -->
                    <Border x:Name="pillSilence" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock Text="🔇 Đang im lặng" FontSize="12" FontWeight="Bold" Foreground="#B91C1C"/>
                    </Border>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Sub-pages container -->
            <Grid Grid.Row="1" x:Name="PagesContainer" Background="#F0F2F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Frame x:Name="frameMonitor" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" Visibility="Visible"/>
                <Frame x:Name="frameBroadcast" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" Visibility="Collapsed"/>
                <Frame x:Name="frameFiles" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" Visibility="Collapsed"/>
                <Frame x:Name="frameWeb" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
