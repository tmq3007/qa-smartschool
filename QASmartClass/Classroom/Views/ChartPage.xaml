<Page x:Class="QASmartClass.Classroom.Views.ChartPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Biểu đồ" Background="#FAFAFA">

    <Grid Margin="24,16">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header + Controls -->

        <DockPanel Grid.Row="0" Margin="0,0,0,16">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                <ComboBox x:Name="cmbChartType" FontSize="12" Width="140" SelectedIndex="0" Margin="0,0,10,0"

                          SelectionChanged="ChartType_Changed">

                    <ComboBoxItem Content="📊 Điểm trung bình"/>

                    <ComboBoxItem Content="🏆 Phân loại học lực"/>

                    <ComboBoxItem Content="📈 Tiến độ hoàn thành"/>

                </ComboBox>

                <Button Content="🔄 Làm mới" Padding="10,7" FontSize="12"

                        Background="#F5F5F5" Foreground="#424242" BorderThickness="0" Cursor="Hand"

                        Click="Refresh_Click">

                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#EEEEEE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                </Button>

            </StackPanel>

            <StackPanel>

                <TextBlock Text="📈 Biểu đồ thống kê" FontSize="18" FontWeight="Bold" Foreground="#212121"/>

                <TextBlock x:Name="txtChartTitle" Text="Điểm trung bình theo học sinh" FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>

            </StackPanel>

        </DockPanel>



        <!-- Chart Area -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="220"/>

            </Grid.ColumnDefinitions>



            <!-- Bar Chart Canvas -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,16,0" BorderBrush="#E0E0E0" BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <!-- Y-axis labels + bars -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="32"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- Y labels -->

                        <StackPanel Grid.Column="0" VerticalAlignment="Stretch">

                            <TextBlock Text="10" FontSize="10" Foreground="#9E9E9E" VerticalAlignment="Top"/>

                            <TextBlock Text="8" FontSize="10" Foreground="#9E9E9E" VerticalAlignment="Center"/>

                            <TextBlock Text="6" FontSize="10" Foreground="#9E9E9E" VerticalAlignment="Center"/>

                            <TextBlock Text="4" FontSize="10" Foreground="#9E9E9E" VerticalAlignment="Center"/>

                            <TextBlock Text="0" FontSize="10" Foreground="#9E9E9E" VerticalAlignment="Bottom"/>

                        </StackPanel>

                        <!-- Bars -->

                        <ItemsControl x:Name="barChart" Grid.Column="1">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid Rows="1"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel VerticalAlignment="Bottom" Margin="3,0">

                                        <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="SemiBold"

                                                   HorizontalAlignment="Center" Foreground="#424242" Margin="0,0,0,3"/>

                                        <Rectangle VerticalAlignment="Bottom" Width="32" RadiusX="3" RadiusY="3"

                                                   Height="{Binding BarHeight}">

                                            <Rectangle.Fill>

                                                <SolidColorBrush Color="{Binding BarColor}"/>

                                            </Rectangle.Fill>

                                        </Rectangle>

                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#9E9E9E"

                                                   HorizontalAlignment="Center" Margin="0,4,0,0"

                                                   TextTrimming="CharacterEllipsis" MaxWidth="40"/>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                    <!-- X axis line -->

                    <Rectangle Grid.Row="1" Height="1" Fill="#E0E0E0" Margin="32,4,0,0"/>

                </Grid>

            </Border>



            <!-- Summary Cards -->

            <StackPanel Grid.Column="1">

                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="📊 Thống kê nhanh" FontSize="13" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                            <TextBlock Text="Điểm cao nhất:" FontSize="11" Foreground="#757575"/>

                            <TextBlock x:Name="txtMax" Grid.Column="1" Text="10.0" FontSize="13" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right"/>

                        </Grid>

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                            <TextBlock Text="Điểm thấp nhất:" FontSize="11" Foreground="#757575"/>

                            <TextBlock x:Name="txtMin" Grid.Column="1" Text="4.5" FontSize="13" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Right"/>

                        </Grid>

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                            <TextBlock Text="Điểm trung bình:" FontSize="11" Foreground="#757575"/>

                            <TextBlock x:Name="txtAvg" Grid.Column="1" Text="7.8" FontSize="13" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Right"/>

                        </Grid>

                        <Grid>

                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                            <TextBlock Text="Tỉ lệ đạt:" FontSize="11" Foreground="#757575"/>

                            <TextBlock x:Name="txtPass" Grid.Column="1" Text="91%" FontSize="13" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Right"/>

                        </Grid>

                    </StackPanel>

                </Border>



                <!-- Legend -->

                <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="🎨 Chú thích" FontSize="13" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                            <Rectangle Width="14" Height="14" Fill="#4CAF50" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <TextBlock Text="Giỏi (≥ 8.5)" FontSize="11" VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                            <Rectangle Width="14" Height="14" Fill="#2196F3" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <TextBlock Text="Khá (7.0–8.4)" FontSize="11" VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                            <Rectangle Width="14" Height="14" Fill="#FF9800" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <TextBlock Text="TB (5.0–6.9)" FontSize="11" VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <Rectangle Width="14" Height="14" Fill="#F44336" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <TextBlock Text="Yếu (&lt; 5.0)" FontSize="11" VerticalAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</Page>

