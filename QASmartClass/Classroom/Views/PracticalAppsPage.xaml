<Page x:Class="QASmartClass.Classroom.Views.PracticalAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Background="#F0F2F5"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F2F4F7"/>
                                <Setter Property="BorderBrush" Value="#98A2B3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="20,14" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D1B2A" Offset="0"/>
                    <GradientStop Color="#1B263B" Offset="0.5"/>
                    <GradientStop Color="#415A77" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="True">
                <!-- Navigation sub-flow: Quay lại Bộ Công Cụ Học Tập -->
                <Button x:Name="btnBackHome" DockPanel.Dock="Left" Content="← Quay lại Bộ Công Cụ" 
                        FontSize="13.5" FontWeight="SemiBold" Background="Transparent" BorderThickness="0"
                        Foreground="White" Cursor="Hand" VerticalAlignment="Center"
                        Margin="0,0,16,0" Padding="8,6" Click="GoBackHome_Click"
                        ToolTip="Quay lại Bộ Công Cụ Học Tập (F32)"/>

                <!-- Nút Focus / Unfocus -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnFocusHS" Content=" Tập trung HS" FontSize="13" FontWeight="Bold"
                            Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand" Click="FocusHS_Click"
                            ToolTip="Yêu cầu tất cả HS tập trung vào công cụ này">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="#C8E6C9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#C8E6C9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnUnfocusHS" Content=" Hủy tập trung" FontSize="13" FontWeight="Bold"
                            Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"
                            Padding="12,6" Margin="0,0,16,0" Cursor="Hand" Click="UnfocusHS_Click"
                            ToolTip="Bỏ Focus để HS tự do trả lời">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="#FFCDD2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#FFCDD2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="White" CornerRadius="8" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock Text="🌍 PhET" FontSize="11" Foreground="#333333" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="10,5">
                        <TextBlock Text="📈 Desmos" FontSize="11" Foreground="#333333" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🌍 Ứng dụng thực tế" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Mô phỏng tương tác PhET (Vật lý, Hóa học, Toán học) và Đồ thị toán học Desmos" 
                               FontSize="11" Foreground="#B0BEC5" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT (TAB CONTROL) ═══ -->
        <TabControl x:Name="tabApps" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" SelectionChanged="TabApps_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="20,12" Margin="0,0,8,0" CornerRadius="8,8,0,0" Background="#E0E0E0" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#757575"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: PHET SIMULATIONS -->
            <TabItem x:Name="tabPhet" Header="🌍 Mô phỏng PhET">
                <Border Background="White" CornerRadius="0,12,12,12" BorderBrush="#D0D5DD" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>  <!-- Toolbar -->
                            <RowDefinition Height="*"/>   <!-- WebView -->
                        </Grid.RowDefinitions>

                        <!-- Browser Toolbar -->
                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="15,5">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="btnPhetBack" Style="{StaticResource ToolbarButton}" Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" Click="BtnPhetBack_Click" ToolTip="Quay lại"/>
                                    <Button x:Name="btnPhetRefresh" Style="{StaticResource ToolbarButton}" Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" Click="BtnPhetRefresh_Click" ToolTip="Tải lại"/>
                                    <TextBlock x:Name="txtPhetUrl" Text="https://phet.colorado.edu/vi/simulations/browse?type=html" VerticalAlignment="Center" Foreground="#667085" FontSize="12" Margin="5,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <ProgressBar x:Name="progressPhet" Width="100" Height="10" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtPhetStatus" Text="Đang tải..." Foreground="#667085" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- WebView Container -->
                        <Grid Grid.Row="1">
                            <wv2:WebView2 x:Name="webPhet" Visibility="Collapsed"/>
                            <!-- Offline message if load fails -->
                            <StackPanel x:Name="panelPhetOffline" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Không thể kết nối Internet hoặc lỗi khởi tạo trình duyệt." FontSize="14" Foreground="#666" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: DESMOS CALCULATOR -->
            <TabItem x:Name="tabDesmos" Header="📈 Đồ thị Desmos">
                <Border Background="White" CornerRadius="0,12,12,12" BorderBrush="#D0D5DD" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>  <!-- Toolbar -->
                            <RowDefinition Height="*"/>   <!-- WebView -->
                        </Grid.RowDefinitions>

                        <!-- Browser Toolbar -->
                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="15,5">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="btnDesmosBack" Style="{StaticResource ToolbarButton}" Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" Click="BtnDesmosBack_Click" ToolTip="Quay lại"/>
                                    <Button x:Name="btnDesmosRefresh" Style="{StaticResource ToolbarButton}" Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" Click="BtnDesmosRefresh_Click" ToolTip="Tải lại"/>
                                    <TextBlock x:Name="txtDesmosUrl" Text="https://www.desmos.com/calculator" VerticalAlignment="Center" Foreground="#667085" FontSize="12" Margin="5,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <ProgressBar x:Name="progressDesmos" Width="100" Height="10" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtDesmosStatus" Text="Đang tải..." Foreground="#667085" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- WebView Container -->
                        <Grid Grid.Row="1">
                            <wv2:WebView2 x:Name="webDesmos" Visibility="Collapsed"/>
                            <!-- Offline message if load fails -->
                            <StackPanel x:Name="panelDesmosOffline" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Không thể kết nối Internet hoặc lỗi khởi tạo trình duyệt." FontSize="14" Foreground="#666" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
