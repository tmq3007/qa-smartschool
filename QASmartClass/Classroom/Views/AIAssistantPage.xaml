<Page x:Class="QASmartClass.Classroom.Views.AIAssistantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

    <Grid x:Name="rootGrid" Margin="24,16" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,14" Margin="0,0,0,12"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💡 Gợi ý câu lệnh" FontSize="11" Padding="10,6" Background="#E3F2FD"
                            Foreground="#1565C0" BorderThickness="0" Cursor="Hand" Click="ShowPromptsGuide_Click" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="🗑️ Xóa hội thoại" FontSize="11" Padding="10,6" Background="#FFEBEE"
                            Foreground="#C62828" BorderThickness="0" Cursor="Hand" Click="ClearChat_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#EF9A9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="🤖 AI Trợ Giảng" FontSize="18" FontWeight="Bold" Foreground="#212121"/>
                    <TextBlock Text="Hỗ trợ soạn bài, tạo câu hỏi, tóm tắt nội dung" FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CHAT / TOOLS AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Quick tools sidebar -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,10,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚡ Công cụ nhanh" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>
                    <Button Content="📝 Tạo câu hỏi trắc nghiệm" Tag="quiz" Click="QuickTool_Click" Style="{x:Null}"
                            FontSize="14" Padding="10,12" Margin="0,0,0,8" Background="#E3F2FD" Foreground="#1565C0"
                            BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"/>
                    <Button Content="📋 Tóm tắt bài giảng" Tag="summary" Click="QuickTool_Click" Style="{x:Null}"
                            FontSize="14" Padding="10,12" Margin="0,0,0,8" Background="#F3E5F5" Foreground="#7B1FA2"
                            BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"/>
                    <Button Content="💡 Gợi ý câu hỏi mở" Tag="openq" Click="QuickTool_Click" Style="{x:Null}"
                            FontSize="14" Padding="10,12" Margin="0,0,0,8" Background="#E8F5E9" Foreground="#2E7D32"
                            BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"/>
                    <Button Content="📖 Giải thích khái niệm" Tag="explain" Click="QuickTool_Click" Style="{x:Null}"
                            FontSize="14" Padding="10,12" Margin="0,0,0,8" Background="#FFF3E0" Foreground="#E65100"
                            BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"/>
                    <Button Content="🎯 Tạo mục tiêu bài học" Tag="objective" Click="QuickTool_Click" Style="{x:Null}"
                            FontSize="14" Padding="10,12" Margin="0,0,0,8" Background="#FCE4EC" Foreground="#AD1457"
                            BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"/>
                    <Button Content="📊 Tạo rubric đánh giá" Tag="rubric" Click="QuickTool_Click" Style="{x:Null}"
                            FontSize="14" Padding="10,12" Margin="0,0,0,8" Background="#E0F2F1" Foreground="#00695C"
                            BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Chat area -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="0"
                    BorderBrush="#E0E0E0" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" Padding="12,8" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                        <TextBlock Text="💬 Hội thoại với AI" FontSize="14" FontWeight="SemiBold" Foreground="#555"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="chatScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="chatList" Margin="12,8,12,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- INPUT BAR -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" Margin="0,10,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✈️ Gửi" FontSize="15" Padding="20,12"
                        Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="SendChat_Click" Margin="8,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox x:Name="txtChatInput" FontSize="15" Padding="14,12" BorderBrush="#BBDEFB" BorderThickness="2"
                         AcceptsReturn="False" KeyDown="ChatInput_KeyDown" Foreground="#94A3B8"
                         GotFocus="TxtChatInput_GotFocus" LostFocus="TxtChatInput_LostFocus"
                         VerticalContentAlignment="Center" MaxLength="1000"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
