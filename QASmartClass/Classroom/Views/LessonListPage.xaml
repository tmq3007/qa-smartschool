<Page x:Class="QASmartClass.Classroom.Views.LessonListPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Quản lý Bài giảng" Background="#F0F2F5">



    <Page.Resources>

        <DropShadowEffect x:Key="CardShadow" ShadowDepth="1" BlurRadius="8" Opacity="0.05" Color="#000"/>



        <!-- Rounded button template -->

        <Style x:Key="RoundBtn" TargetType="Button">

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bg" Background="{TemplateBinding Background}"

                                CornerRadius="8" Padding="{TemplateBinding Padding}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bg" Property="Opacity" Value="0.82"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Filter chip -->

        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource RoundBtn}">

            <Setter Property="Padding" Value="14,7"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="Background" Value="#F1F3F5"/>

            <Setter Property="Foreground" Value="#495057"/>

        </Style>

    </Page.Resources>



    <Grid Margin="20,12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>  <!-- Header -->

            <RowDefinition Height="Auto"/>  <!-- Stats -->

            <RowDefinition Height="Auto"/>  <!-- Filter + Search -->

            <RowDefinition Height="*"/>     <!-- Content -->

        </Grid.RowDefinitions>



        <!-- ═══════════════════════════════════════════════════════

             ROW 0: HEADER

             ═══════════════════════════════════════════════════════ -->

        <Border Grid.Row="0" CornerRadius="14" Padding="22,14" Margin="0,0,0,10"

                Effect="{StaticResource CardShadow}">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                    <GradientStop Color="#1565C0" Offset="0"/>

                    <GradientStop Color="#1E88E5" Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

            <DockPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Content="📅 TKB" Padding="12,8" FontSize="11" FontWeight="SemiBold"

                            Background="#FFFFFF" Foreground="#1565C0" Style="{StaticResource RoundBtn}"

                            Click="Timetable_Click" ToolTip="Thời khóa biểu" Margin="0,0,6,0"/>

                    <Button Content="📥 Xuất CSV" Padding="12,8" FontSize="11"

                            Background="Transparent" Foreground="White" BorderBrush="#FFFFFF55" BorderThickness="1"

                            Style="{StaticResource RoundBtn}" Click="ExportList_Click" Margin="0,0,6,0"/>

                    <Button Content="🔄" Padding="8,8" FontSize="13"

                            Background="Transparent" Foreground="White"

                            Style="{StaticResource RoundBtn}" Click="Refresh_Click"

                            ToolTip="Làm mới" Margin="0,0,8,0"/>

                    <Button Padding="16,8" FontSize="12.5" FontWeight="SemiBold"

                            Content="➕ Tạo bài mới" Foreground="White"

                            Style="{StaticResource RoundBtn}" Click="NewLesson_Click">

                        <Button.Background>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                                <GradientStop Color="#43A047" Offset="0"/>

                                <GradientStop Color="#66BB6A" Offset="1"/>

                            </LinearGradientBrush>

                        </Button.Background>

                    </Button>

                </StackPanel>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="📚 Quản lý Bài Giảng" FontSize="20" FontWeight="Bold" Foreground="White"/>

                    <TextBlock x:Name="txtResultCount" Text="Đang tải..." FontSize="12"

                               Foreground="#B3D9FF" Margin="0,3,0,0"/>

                </StackPanel>

            </DockPanel>

        </Border>



        <!-- ═══════════════════════════════════════════════════════

             ROW 1: STATS

             ═══════════════════════════════════════════════════════ -->

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">

            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,6,0"

                    Effect="{StaticResource CardShadow}">

                <StackPanel Orientation="Horizontal">

                    <Border Background="#E3F2FD" CornerRadius="10" Width="40" Height="40"

                            Margin="0,0,12,0">

                        <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="txtTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1976D2"/>

                        <TextBlock Text="Tổng bài" FontSize="10.5" Foreground="#868E96"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="3,0,3,0"

                    Effect="{StaticResource CardShadow}">

                <StackPanel Orientation="Horizontal">

                    <Border Background="#E8F5E9" CornerRadius="10" Width="40" Height="40"

                            Margin="0,0,12,0">

                        <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="txtApprovedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>

                        <TextBlock Text="Đã duyệt/dạy" FontSize="10.5" Foreground="#868E96"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="3,0,3,0"

                    Effect="{StaticResource CardShadow}">

                <StackPanel Orientation="Horizontal">

                    <Border Background="#FFF3E0" CornerRadius="10" Width="40" Height="40"

                            Margin="0,0,12,0">

                        <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="txtPendingCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E65100"/>

                        <TextBlock Text="Chờ duyệt" FontSize="10.5" Foreground="#868E96"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="6,0,0,0"

                    Effect="{StaticResource CardShadow}">

                <StackPanel Orientation="Horizontal">

                    <Border Background="#F5F5F5" CornerRadius="10" Width="40" Height="40"

                            Margin="0,0,12,0">

                        <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="txtDraftCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#757575"/>

                        <TextBlock Text="Bản nháp" FontSize="10.5" Foreground="#868E96"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </UniformGrid>



        <!-- ═══════════════════════════════════════════════════════

             ROW 2: FILTER + SORT + SEARCH

             ═══════════════════════════════════════════════════════ -->

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="14,10"

                Margin="0,0,0,10" Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="260"/>

                </Grid.ColumnDefinitions>



                <!-- Filter chips -->

                <StackPanel x:Name="filterBar" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Content="📋 Tất cả" Tag="All" Style="{StaticResource FilterChip}"

                            Background="#1976D2" Foreground="White" Margin="0,0,5,0" Click="Filter_Click"/>

                    <Button Content="⭐ Yêu thích" Tag="Favorite" Style="{StaticResource FilterChip}" Margin="0,0,5,0" Click="Filter_Click"/>

                    <Button Content="✅ Đã duyệt" Tag="Approved" Style="{StaticResource FilterChip}" Margin="0,0,5,0" Click="Filter_Click"/>

                    <Button Content="⏳ Chờ duyệt" Tag="PendingApproval" Style="{StaticResource FilterChip}" Margin="0,0,5,0" Click="Filter_Click"/>

                    <Button Content="📝 Bản nháp" Tag="Draft" Style="{StaticResource FilterChip}" Margin="0,0,5,0" Click="Filter_Click"/>

                    <Button Content="📚 Đã dạy" Tag="Taught" Style="{StaticResource FilterChip}" Click="Filter_Click"/>

                </StackPanel>



                <!-- Teacher scope toggle -->

                <Border Grid.Column="1" Background="#F1F3F5" CornerRadius="8" Padding="2" Margin="12,0,0,0" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="btnScopeMyLessons" Content="👤 Của tôi" Padding="10,5" FontSize="11"

                                Background="#1565C0" Foreground="White" FontWeight="SemiBold"

                                Style="{StaticResource RoundBtn}" Click="ScopeMyLessons_Click"

                                ToolTip="Chỉ hiện bài giảng của tôi"/>

                        <Button x:Name="btnScopeAll" Content="👥 Tất cả GV" Padding="10,5" FontSize="11"

                                Background="Transparent" Foreground="#495057"

                                Style="{StaticResource RoundBtn}" Click="ScopeAllTeachers_Click"

                                ToolTip="Hiện bài giảng của tất cả giáo viên"/>

                    </StackPanel>

                </Border>



                <!-- Sort + View toggle -->

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Right">

                    <TextBlock Text="Sắp xếp:" FontSize="11" Foreground="#868E96" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <ComboBox x:Name="cmbSort" Width="145" FontSize="11" Padding="6,4"

                              SelectionChanged="Sort_Changed" SelectedIndex="0">

                        <ComboBoxItem Content="Gần nhất" Tag="UpdatedAt"/>

                        <ComboBoxItem Content="Tiêu đề" Tag="Title"/>

                        <ComboBoxItem Content="Môn học" Tag="Subject"/>

                        <ComboBoxItem Content="Số lần dạy" Tag="UseCount"/>

                    </ComboBox>

                    <Button x:Name="btnSortDir" Content="↓" Padding="8,5" FontSize="12" FontWeight="Bold"

                            Background="#F1F3F5" Foreground="#495057" Style="{StaticResource RoundBtn}"

                            Margin="4,0,0,0" Click="SortDir_Click" ToolTip="Đảo chiều sắp xếp"/>

                    <!-- View mode toggle -->

                    <Border Background="#F1F3F5" CornerRadius="8" Padding="2" Margin="8,0,0,0">

                        <StackPanel Orientation="Horizontal">

                            <Button x:Name="btnViewList" Content="☰" Padding="8,4" FontSize="13"

                                    Background="#1976D2" Foreground="White" Style="{StaticResource RoundBtn}"

                                    Click="ViewList_Click" ToolTip="Dạng bảng"/>

                            <Button x:Name="btnViewGrid" Content="⊞" Padding="8,4" FontSize="13"

                                    Background="Transparent" Foreground="#495057" Style="{StaticResource RoundBtn}"

                                    Click="ViewGrid_Click" ToolTip="Dạng lưới"/>

                        </StackPanel>

                    </Border>

                </StackPanel>



                <!-- Search -->

                <Border Grid.Column="3" Background="#F8F9FA" CornerRadius="10" BorderBrush="#DEE2E6" BorderThickness="1"

                        VerticalAlignment="Center">

                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0"

                             Padding="12,8" FontSize="12" Text="🔍 Tìm kiếm bài giảng..."

                             Foreground="#ADB5BD" TextChanged="Search_Changed"

                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>

                </Border>

            </Grid>

        </Border>



        <!-- ═══════════════════════════════════════════════════════

             ROW 3: CONTENT AREA (List + Grid views)

             ═══════════════════════════════════════════════════════ -->



        <!-- TABLE / LIST VIEW (default) -->

        <Border x:Name="listViewPanel" Grid.Row="3" Background="White" CornerRadius="12"

                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <!-- Table Header -->

                <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="12,12,0,0" Padding="16,10">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="32"/>       <!-- # -->

                            <ColumnDefinition Width="28"/>       <!-- Fav -->

                            <ColumnDefinition Width="*"/>        <!-- Title -->

                            <ColumnDefinition Width="90"/>       <!-- Subject -->

                            <ColumnDefinition Width="70"/>       <!-- Grade -->

                            <ColumnDefinition Width="120"/>      <!-- Timetable -->

                            <ColumnDefinition Width="95"/>       <!-- Status -->

                            <ColumnDefinition Width="65"/>       <!-- UseCount -->

                            <ColumnDefinition Width="85"/>       <!-- Updated -->

                            <ColumnDefinition Width="130"/>      <!-- Actions -->

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>

                        <TextBlock Grid.Column="1" Text="★" FontSize="10" FontWeight="Bold" Foreground="#868E96" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="2" Text="Tiêu đề bài giảng" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>

                        <TextBlock Grid.Column="3" Text="Môn học" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>

                        <TextBlock Grid.Column="4" Text="Khối" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>

                        <TextBlock Grid.Column="5" Text="Lịch dạy" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>

                        <TextBlock Grid.Column="6" Text="Trạng thái" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>

                        <TextBlock Grid.Column="7" Text="Đã dạy" FontSize="10" FontWeight="Bold" Foreground="#868E96" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="8" Text="Cập nhật" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>

                        <TextBlock Grid.Column="9" Text="Thao tác" FontSize="10" FontWeight="Bold" Foreground="#868E96" HorizontalAlignment="Center"/>

                    </Grid>

                </Border>



                <!-- Table Body -->

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="listViewBody"/>

                </ScrollViewer>

            </Grid>

        </Border>



        <!-- GRID / CARD VIEW (hidden by default) -->

        <ScrollViewer x:Name="gridViewPanel" Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">

            <ItemsControl x:Name="lessonGrid">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="290" Margin="0,0,10,10" CornerRadius="12"

                                Background="{Binding CardBg}"

                                BorderBrush="#E8EAED" BorderThickness="1"

                                Cursor="Hand" MouseLeftButtonDown="LessonCard_Click">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05"/>

                            </Border.Effect>

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="BorderBrush" Value="#1976D2"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel>

                                <!-- Color accent bar -->

                                <Border CornerRadius="12,12,0,0" Height="4"

                                        Background="{Binding AccentBrush}"/>

                                <StackPanel Margin="14,12,14,14">

                                    <!-- Title row -->

                                    <DockPanel Margin="0,0,0,6">

                                        <Button DockPanel.Dock="Right" Content="{Binding FavIcon}"

                                                Background="Transparent" BorderThickness="0"

                                                FontSize="14" Cursor="Hand" Padding="2"

                                                Click="ToggleFavorite_Click"/>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="{Binding SubjectIcon}" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"

                                                       Foreground="#212121" TextTrimming="CharacterEllipsis"

                                                       MaxWidth="200" VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </DockPanel>

                                    <!-- Meta info -->

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                                        <TextBlock Text="{Binding Subject}" FontSize="10" Foreground="#868E96"/>

                                        <TextBlock Text=" · " FontSize="10" Foreground="#CED4DA"/>

                                        <TextBlock Text="{Binding Grade}" FontSize="10" Foreground="#868E96"/>

                                        <TextBlock Text=" · " FontSize="10" Foreground="#CED4DA"/>

                                        <TextBlock Text="{Binding TypeIcon}" FontSize="10"/>

                                        <TextBlock Text="{Binding DurationMin, StringFormat='{}{0}p'}" FontSize="10" Foreground="#868E96" Margin="2,0,0,0"/>

                                    </StackPanel>

                                    <!-- Timetable info -->

                                    <TextBlock Text="{Binding TimetableLabel}" FontSize="9" Foreground="#1565C0"

                                               Visibility="{Binding TimetableVis}" Margin="0,0,0,6"/>

                                    <!-- Description -->

                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#868E96"

                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"

                                               Margin="0,0,0,8"/>

                                    <!-- Status + Actions -->

                                    <DockPanel>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                                            <Button Content="✏️" Background="#F1F3F5" Padding="6,4" FontSize="10"

                                                    Style="{StaticResource RoundBtn}" ToolTip="Sửa"

                                                    Click="EditLesson_Click" Margin="0,0,3,0"/>

                                            <Button Content="📋" Background="#F1F3F5" Padding="6,4" FontSize="10"

                                                    Style="{StaticResource RoundBtn}" ToolTip="Sao chép"

                                                    Click="DuplicateLesson_Click" Margin="0,0,3,0"/>

                                            <Button Content="🗑️" Background="#FFF5F5" Padding="6,4" FontSize="10"

                                                    Style="{StaticResource RoundBtn}" ToolTip="Xóa"

                                                    Click="DeleteLesson_Click"/>

                                        </StackPanel>

                                        <Border Background="{Binding StatusBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">

                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10"

                                                       Foreground="{Binding StatusFg}" FontWeight="SemiBold"/>

                                        </Border>

                                    </DockPanel>

                                    <!-- Footer -->

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                                        <TextBlock Text="{Binding UsedLabel}" FontSize="9" Foreground="#ADB5BD" Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding UpdatedLabel, StringFormat='🕐 {0}'}" FontSize="9" Foreground="#CED4DA"/>

                                    </StackPanel>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Page>

