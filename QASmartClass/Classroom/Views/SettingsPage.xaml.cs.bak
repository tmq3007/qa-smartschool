        // ═══════════════════════════════════════════════════════
        //  SETTINGS FILE PERSISTENCE (JSON)
        // ═══════════════════════════════════════════════════════

        private void SaveCurrentSettings()
        {
            try
            {
                var settings = new ClassroomSettings
                {
                    Theme = GetSelectedTheme(),
                    Language = (cboLanguage.SelectedItem as ComboBoxItem)?.Tag?.ToString() ?? "vi",
                    FontSize = GetSelectedFontSize(),
                    TcpPort = int.TryParse(txtTcpPort.Text, out int p) ? p : 29877,
                    AutoReconnect = chkAutoReconnect.IsChecked == true,
                    MaxStudents = int.TryParse(txtMaxStudents.Text, out int m) ? m : 35,
                    SavedAt = DateTime.Now
                };

                Directory.CreateDirectory(Path.GetDirectoryName(SettingsFilePath)!);
                var json = JsonSerializer.Serialize(settings, new JsonSerializerOptions { WriteIndented = true });
                File.WriteAllText(SettingsFilePath, json);
                Log.Information("Settings saved to {Path}", SettingsFilePath);
            }
            catch (Exception ex) { Log.Warning("SaveSettings error: {Err}", ex.Message); }
        }

        private static ClassroomSettings LoadSettingsFile()
        {
            try
            {
                if (File.Exists(SettingsFilePath))
                {
                    var json = File.ReadAllText(SettingsFilePath);
                    return JsonSerializer.Deserialize<ClassroomSettings>(json) ?? new ClassroomSettings();
                }
            }
            catch (Exception ex) { Log.Warning("LoadSettingsFile error: {Err}", ex.Message); }
            return new ClassroomSettings();
        }
        // ═══════════════════════════════════════════════════════
        //  API KEY MANAGEMENT
        // ═══════════════════════════════════════════════════════

        private bool _apiKeyVisible = false;
        private TextBox? _apiKeyTextBox = null;

        private void LoadApiKey()
        {
            try
            {
                string apiKey = QASmartTouch.Properties.Settings.Default.GoogleCloudVisionApiKey ?? "";
                txtApiKey.Password = apiKey;

                if (!string.IsNullOrWhiteSpace(apiKey))
                {
                    txtApiStatus.Text = "✅ API key đã được cấu hình";
                    txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(46, 125, 50));
                    apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(232, 245, 233));
                }
            }
            catch (Exception ex)
            {
                Log.Warning("LoadApiKey error: {Err}", ex.Message);
            }
        }

        private void SaveApiKey_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                string apiKey = _apiKeyVisible && _apiKeyTextBox != null
                    ? _apiKeyTextBox.Text.Trim()
                    : txtApiKey.Password.Trim();

                QASmartTouch.Properties.Settings.Default.GoogleCloudVisionApiKey = apiKey;
                QASmartTouch.Properties.Settings.Default.Save();

                if (!string.IsNullOrWhiteSpace(apiKey))
                {
                    txtApiStatus.Text = "✅ API key đã lưu thành công";
                    txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(46, 125, 50));
                    apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(232, 245, 233));
                }
                else
                {
                    txtApiStatus.Text = "⚠️ API key trống";
                    txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(245, 124, 0));
                    apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(255, 243, 224));
                }

                MessageBox.Show(
                    "Đã lưu API key thành công!\n\nKhởi động lại ứng dụng để áp dụng thay đổi.",
                    "Lưu API Key", MessageBoxButton.OK, MessageBoxImage.Information);
                Log.Information("API key saved (length: {Len})", apiKey.Length);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi khi lưu API key: {ex.Message}", "Lỗi", MessageBoxButton.OK, MessageBoxImage.Error);
                Log.Warning("SaveApiKey error: {Err}", ex.Message);
            }
        }

        private void ToggleApiKeyVisibility_Click(object sender, RoutedEventArgs e)
        {
            _apiKeyVisible = !_apiKeyVisible;

            if (_apiKeyVisible)
            {
                // Show as plain text - replace PasswordBox with TextBox
                var parent = txtApiKey.Parent as Grid;
                if (parent != null)
                {
                    int idx = parent.Children.IndexOf(txtApiKey);
                    _apiKeyTextBox = new TextBox
                    {
                        Text = txtApiKey.Password,
                        Style = (Style)FindResource("RoundedTextBox"),
                        Margin = new Thickness(0, 0, 10, 0)
                    };
                    Grid.SetColumn(_apiKeyTextBox, 0);
                    txtApiKey.Visibility = Visibility.Collapsed;
                    parent.Children.Insert(idx + 1, _apiKeyTextBox);
                }
            }
            else
            {
                // Hide - remove TextBox, show PasswordBox
                if (_apiKeyTextBox != null)
                {
                    txtApiKey.Password = _apiKeyTextBox.Text;
                    var parent = _apiKeyTextBox.Parent as Grid;
                    parent?.Children.Remove(_apiKeyTextBox);
                    _apiKeyTextBox = null;
                    txtApiKey.Visibility = Visibility.Visible;
                }
            }
        }

        private async void TestApiConnection_Click(object sender, RoutedEventArgs e)
        {
            string apiKey = _apiKeyVisible && _apiKeyTextBox != null
                ? _apiKeyTextBox.Text.Trim()
                : txtApiKey.Password.Trim();

            if (string.IsNullOrWhiteSpace(apiKey))
            {
                txtApiStatus.Text = "⚠️ Vui lòng nhập API key trước";
                txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(245, 124, 0));
                apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(255, 243, 224));
                return;
            }

            txtApiStatus.Text = "🔄 Đang kiểm tra...";
            txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(25, 118, 210));
            apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(227, 242, 253));

            try
            {
                var testService = new HandwritingRecognitionService(apiKey);
                if (!testService.IsInitialized)
                {
                    txtApiStatus.Text = "❌ Không thể khởi tạo service";
                    txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                    apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(255, 235, 238));
                    return;
                }

                bool connected = await testService.TestConnectionAsync();
                if (connected)
                {
                    txtApiStatus.Text = "✅ Kết nối thành công! API hoạt động bình thường";
                    txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(46, 125, 50));
                    apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(232, 245, 233));
                }
                else
                {
                    txtApiStatus.Text = "❌ Kết nối thất bại. Kiểm tra API key và bật Cloud Vision API";
                    txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                    apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(255, 235, 238));
                }
            }
            catch (Exception ex)
            {
                txtApiStatus.Text = $"❌ Lỗi: {ex.Message}";
                txtApiStatus.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                apiStatusBadge.Background = new SolidColorBrush(Color.FromRgb(255, 235, 238));
                Log.Warning("TestApiConnection error: {Err}", ex.Message);
            }
        }

        // ═══════════════════════════════════════════════════════
        //  GRADE TYPE MASTER MANAGEMENT
        // ═══════════════════════════════════════════════════════

        private void LoadGradeTypes()
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                var types = db.GradeTypeMasters
                    .OrderBy(g => g.SortOrder)
                    .ToList();

                gradeTypeRowsPanel.Children.Clear();
                int idx = 1;
                foreach (var gt in types)
                {
                    gradeTypeRowsPanel.Children.Add(CreateGradeTypeRow(gt, idx++));
                }

                UpdateFormulaPreview(types);
            }
            catch (Exception ex) { Log.Warning("LoadGradeTypes error: {Err}", ex.Message); }
        }

        private Border CreateGradeTypeRow(GradeTypeMaster gt, int index)
        {
            var row = new Border
            {
                Padding = new Thickness(0, 6, 0, 6),
                BorderBrush = new SolidColorBrush(Color.FromRgb(233, 236, 239)),
                BorderThickness = new Thickness(0, 0, 0, 1),
                Tag = gt.Id
            };

            var grid = new Grid();
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(36) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(80) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(70) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(80) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(100) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(70) });

            // # index
            var tbIdx = new TextBlock
            {
                Text = index.ToString(),
                FontSize = 12, Foreground = new SolidColorBrush(Color.FromRgb(134, 142, 150)),
                VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(4, 0, 0, 0)
            };
            Grid.SetColumn(tbIdx, 0);
            grid.Children.Add(tbIdx);

            // Display name (editable)
            var txtName = new TextBox
            {
                Text = gt.DisplayName, FontSize = 12, Padding = new Thickness(6, 4, 6, 4),
                BorderThickness = new Thickness(1), BorderBrush = new SolidColorBrush(Color.FromRgb(222, 226, 230)),
                Background = new SolidColorBrush(Color.FromRgb(248, 249, 250)),
                Tag = $"name_{gt.Id}"
            };
            Grid.SetColumn(txtName, 1);
            grid.Children.Add(txtName);

            // Short name
            var txtShort = new TextBox
            {
                Text = gt.ShortName, FontSize = 12, Padding = new Thickness(6, 4, 6, 4),
                BorderThickness = new Thickness(1), BorderBrush = new SolidColorBrush(Color.FromRgb(222, 226, 230)),
                Background = new SolidColorBrush(Color.FromRgb(248, 249, 250)),
                TextAlignment = TextAlignment.Center, Tag = $"short_{gt.Id}", Margin = new Thickness(4, 0, 4, 0)
            };
            Grid.SetColumn(txtShort, 2);
            grid.Children.Add(txtShort);

            // Weight (ComboBox)
            var cboWeight = new ComboBox
            {
                FontSize = 12, Padding = new Thickness(4, 2, 4, 2),
                SelectedIndex = Math.Max(0, gt.Weight - 1), Tag = $"weight_{gt.Id}"
            };
            cboWeight.Items.Add(new ComboBoxItem { Content = "1", Tag = 1 });
            cboWeight.Items.Add(new ComboBoxItem { Content = "2", Tag = 2 });
            cboWeight.Items.Add(new ComboBoxItem { Content = "3", Tag = 3 });
            cboWeight.Items.Add(new ComboBoxItem { Content = "4", Tag = 4 });
            cboWeight.Items.Add(new ComboBoxItem { Content = "5", Tag = 5 });
            Grid.SetColumn(cboWeight, 3);
            grid.Children.Add(cboWeight);

            // MaxAttempts (ComboBox)
            var cboAttempts = new ComboBox
            {
                FontSize = 12, Padding = new Thickness(4, 2, 4, 2),
                SelectedIndex = Math.Max(0, gt.MaxAttempts - 1), Tag = $"attempts_{gt.Id}",
                Margin = new Thickness(4, 0, 4, 0)
            };
            cboAttempts.Items.Add(new ComboBoxItem { Content = "1 lần", Tag = 1 });
            cboAttempts.Items.Add(new ComboBoxItem { Content = "2 lần", Tag = 2 });
            cboAttempts.Items.Add(new ComboBoxItem { Content = "3 lần", Tag = 3 });
            cboAttempts.Items.Add(new ComboBoxItem { Content = "4 lần", Tag = 4 });
            Grid.SetColumn(cboAttempts, 4);
            grid.Children.Add(cboAttempts);

            // Status badge
            var statusBadge = new Border
            {
                CornerRadius = new CornerRadius(6),
                Padding = new Thickness(8, 3, 8, 3),
                HorizontalAlignment = HorizontalAlignment.Left,
                VerticalAlignment = VerticalAlignment.Center,
                Background = gt.IsActive
                    ? new SolidColorBrush(Color.FromRgb(232, 245, 233))
                    : new SolidColorBrush(Color.FromRgb(255, 235, 238))
            };
            statusBadge.Child = new TextBlock
            {
                Text = gt.IsActive ? "✅ Bật" : "❌ Tắt",
                FontSize = 10, FontWeight = FontWeights.SemiBold,
                Foreground = gt.IsActive
                    ? new SolidColorBrush(Color.FromRgb(46, 125, 50))
                    : new SolidColorBrush(Color.FromRgb(198, 40, 40))
            };
            Grid.SetColumn(statusBadge, 5);
            grid.Children.Add(statusBadge);

            // Action buttons
            var actionPanel = new StackPanel
            {
                Orientation = Orientation.Horizontal,
                VerticalAlignment = VerticalAlignment.Center
            };

            var btnSave = new Button
            {
                Content = "💾", FontSize = 14, Width = 28, Height = 28,
                Background = Brushes.Transparent, BorderThickness = new Thickness(0),
                Cursor = Cursors.Hand, ToolTip = "Lưu", Tag = gt.Id,
                Padding = new Thickness(0)
            };
            btnSave.Click += SaveGradeType_Click;
            actionPanel.Children.Add(btnSave);

            var btnDel = new Button
            {
                Content = "🗑️", FontSize = 14, Width = 28, Height = 28,
                Background = Brushes.Transparent, BorderThickness = new Thickness(0),
                Cursor = Cursors.Hand, ToolTip = "Xóa", Tag = gt.Id,
                Padding = new Thickness(0)
            };
            btnDel.Click += DeleteGradeType_Click;
            actionPanel.Children.Add(btnDel);

            Grid.SetColumn(actionPanel, 6);
            grid.Children.Add(actionPanel);

            row.Child = grid;
            return row;
        }

        private void AddGradeType_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;

                int nextOrder = db.GradeTypeMasters.Any()
                    ? db.GradeTypeMasters.Max(g => g.SortOrder) + 1 : 1;
                string code = $"Custom{nextOrder}";

                db.GradeTypeMasters.Add(new GradeTypeMaster
                {
                    Code = code,
                    DisplayName = "Loại điểm mới",
                    ShortName = "?",
                    Weight = 1,
                    MaxAttempts = 1,
                    SortOrder = nextOrder,
                    IsActive = true
                });
                db.SaveChanges();
                LoadGradeTypes();
                Log.Information("Added new GradeTypeMaster: {Code}", code);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void SaveGradeType_Click(object sender, RoutedEventArgs e)
        {
            if (sender is not Button btn || btn.Tag is not int id) return;
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                var gt = db.GradeTypeMasters.FirstOrDefault(g => g.Id == id);
                if (gt == null) return;

                // Find the parent row and read values
                foreach (Border rowBorder in gradeTypeRowsPanel.Children)
                {
                    if (rowBorder.Tag is int rowId && rowId == id && rowBorder.Child is Grid grid)
                    {
                        foreach (UIElement child in grid.Children)
                        {
                            if (child is TextBox tb)
                            {
                                var tag = tb.Tag?.ToString() ?? "";
                                if (tag == $"name_{id}") gt.DisplayName = tb.Text.Trim();
                                if (tag == $"short_{id}") gt.ShortName = tb.Text.Trim();
                            }
                            if (child is ComboBox cbo)
                            {
                                var tag = cbo.Tag?.ToString() ?? "";
                                var selItem = cbo.SelectedItem as ComboBoxItem;
                                if (selItem?.Tag is int val)
                                {
                                    if (tag == $"weight_{id}") gt.Weight = val;
                                    if (tag == $"attempts_{id}") gt.MaxAttempts = val;
                                }
                            }
                        }
                        break;
                    }
                }

                db.SaveChanges();
                LoadGradeTypes();
                Log.Information("Saved GradeTypeMaster #{Id}: {Name} (W={W}, A={A})",
                    gt.Id, gt.DisplayName, gt.Weight, gt.MaxAttempts);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void DeleteGradeType_Click(object sender, RoutedEventArgs e)
        {
            if (sender is not Button btn || btn.Tag is not int id) return;
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                var gt = db.GradeTypeMasters.FirstOrDefault(g => g.Id == id);
                if (gt == null) return;

                // Check if grades exist
                bool hasGrades = db.StudentGrades.Any(sg => sg.GradeTypeId == id);
                if (hasGrades)
                {
                    var res = MessageBox.Show(
                        $"Loại điểm \"{gt.DisplayName}\" đã có dữ liệu điểm.\n" +
                        "Bạn có muốn vô hiệu hóa (ẩn) thay vì xóa?",
                        "Không thể xóa", MessageBoxButton.YesNo, MessageBoxImage.Warning);
                    if (res == MessageBoxResult.Yes)
                    {
                        gt.IsActive = false;
                        db.SaveChanges();
                        LoadGradeTypes();
                        Log.Information("Deactivated GradeTypeMaster #{Id}", id);
                    }
                    return;
                }

                var confirm = MessageBox.Show(
                    $"Xóa loại điểm \"{gt.DisplayName}\"?",
                    "Xác nhận xóa", MessageBoxButton.YesNo, MessageBoxImage.Question);
                if (confirm == MessageBoxResult.Yes)
                {
                    db.GradeTypeMasters.Remove(gt);
                    db.SaveChanges();
                    LoadGradeTypes();
                    Log.Information("Deleted GradeTypeMaster #{Id}: {Name}", id, gt.DisplayName);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void UpdateFormulaPreview(System.Collections.Generic.List<GradeTypeMaster> types)
        {
            if (types == null || types.Count == 0)
            {
                txtFormulaPreview.Text = "(Chưa có loại điểm nào)";
                return;
            }

            var activeTypes = types.Where(t => t.IsActive).ToList();
            if (activeTypes.Count == 0)
            {
                txtFormulaPreview.Text = "(Không có loại điểm hoạt động)";
                return;
            }

            // Build formula string: TB = (M×1 + 15p×1 + 1T×2 + HK×3) / (1+1+2+3)
            var numerator = string.Join(" + ", activeTypes.Select(t =>
            {
                if (t.MaxAttempts > 1)
                    return string.Join(" + ", Enumerable.Range(1, t.MaxAttempts)
                        .Select(a => $"{t.ShortName}{a}×{t.Weight}"));
                return $"{t.ShortName}×{t.Weight}";
            }));

            int totalWeight = activeTypes.Sum(t => t.Weight * t.MaxAttempts);
            txtFormulaPreview.Text = $"TB = ({numerator}) / {totalWeight}";
        }

        // ═══════════════════════════════════════════════════════
        //  SCHOOL CONFIG — ROSTER MANAGEMENT
        // ═══════════════════════════════════════════════════════

        private void LoadRosterRows()
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                var rosters = db.ClassRosters.Where(r => r.IsActive).OrderBy(r => r.GradeLevel).ThenBy(r => r.ClassName).ToList();

                rosterRowsPanel.Children.Clear();
                int idx = 1;
                foreach (var r in rosters)
                    rosterRowsPanel.Children.Add(CreateRosterRow(r, idx++));

                txtRosterSummary.Text = $"🏫 {rosters.Count} lớp • Khối: {string.Join(", ", rosters.Select(r => r.GradeLevel).Distinct().OrderBy(x => x))}";
            }
            catch (Exception ex) { Log.Warning("LoadRosterRows error: {Err}", ex.Message); }
        }

        private Border CreateRosterRow(ClassRoster roster, int index)
        {
            var row = new Border
            {
                Padding = new Thickness(0, 6, 0, 6),
                BorderBrush = new SolidColorBrush(Color.FromRgb(233, 236, 239)),
                BorderThickness = new Thickness(0, 0, 0, 1),
                Tag = roster.Id
            };

            var grid = new Grid();
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(36) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(70) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(100) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(120) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(60) });
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(60) });

            // Col 0: Index
            var tbIdx = new TextBlock { Text = index.ToString(), FontSize = 12, Foreground = new SolidColorBrush(Color.FromRgb(134, 142, 150)), VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(4, 0, 0, 0) };
            Grid.SetColumn(tbIdx, 0);
            grid.Children.Add(tbIdx);

            // Col 1: Grade Level
            var cboLevel = new ComboBox { FontSize = 12, Padding = new Thickness(4, 2, 4, 2), Tag = $"level_{roster.Id}" };
            foreach (var lv in new[] { "6", "7", "8", "9", "10", "11", "12" })
            {
                var item = new ComboBoxItem { Content = lv, Tag = lv };
                if (lv == roster.GradeLevel) item.IsSelected = true;
                cboLevel.Items.Add(item);
            }
            Grid.SetColumn(cboLevel, 1);
            grid.Children.Add(cboLevel);

            // Col 2: Class Name
            var txtName = new TextBox { Text = roster.ClassName, FontSize = 12, Padding = new Thickness(6, 4, 6, 4), BorderThickness = new Thickness(1), BorderBrush = new SolidColorBrush(Color.FromRgb(222, 226, 230)), Background = new SolidColorBrush(Color.FromRgb(248, 249, 250)), Tag = $"name_{roster.Id}", Margin = new Thickness(4, 0, 4, 0) };
            Grid.SetColumn(txtName, 2);
            grid.Children.Add(txtName);

            // Col 3: Subject
            var txtSubject = new TextBox { Text = roster.Subject, FontSize = 12, Padding = new Thickness(6, 4, 6, 4), BorderThickness = new Thickness(1), BorderBrush = new SolidColorBrush(Color.FromRgb(222, 226, 230)), Background = new SolidColorBrush(Color.FromRgb(248, 249, 250)), Tag = $"subj_{roster.Id}", Margin = new Thickness(0, 0, 4, 0) };
            Grid.SetColumn(txtSubject, 3);
            grid.Children.Add(txtSubject);

            // Col 4: Teacher Name
            var txtTeacher = new TextBox { Text = roster.TeacherName, FontSize = 12, Padding = new Thickness(6, 4, 6, 4), BorderThickness = new Thickness(1), BorderBrush = new SolidColorBrush(Color.FromRgb(222, 226, 230)), Background = new SolidColorBrush(Color.FromRgb(248, 249, 250)), Tag = $"teacher_{roster.Id}", Margin = new Thickness(0, 0, 4, 0) };
            Grid.SetColumn(txtTeacher, 4);
            grid.Children.Add(txtTeacher);

            // Col 5: Student Count (read-only)
            var tbCount = new TextBlock { Text = roster.StudentCount.ToString(), FontSize = 12, Foreground = new SolidColorBrush(Color.FromRgb(25, 118, 210)), FontWeight = FontWeights.SemiBold, VerticalAlignment = VerticalAlignment.Center, HorizontalAlignment = HorizontalAlignment.Center };
            Grid.SetColumn(tbCount, 5);
            grid.Children.Add(tbCount);

            // Col 6: Delete
            var btnDel = new Button { Content = "🗑️", FontSize = 14, Width = 28, Height = 28, Background = Brushes.Transparent, BorderThickness = new Thickness(0), Cursor = Cursors.Hand, ToolTip = "Xóa lớp", Tag = roster.Id, Padding = new Thickness(0) };
            btnDel.Click += DeleteRoster_Click;
            Grid.SetColumn(btnDel, 6);
            grid.Children.Add(btnDel);

            row.Child = grid;
            return row;
        }

        private void AddRoster_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                string year = txtSchoolYear.Text.Trim();
                string semester = (cboDefaultSemester.SelectedItem as ComboBoxItem)?.Tag?.ToString() ?? "HK2";

                db.ClassRosters.Add(new ClassRoster
                {
                    ClassName = "Lớp mới",
                    GradeLevel = "10",
                    SchoolYear = year,
                    Semester = semester,
                    Subject = "",
                    IsActive = true
                });
                db.SaveChanges();
                LoadRosterRows();
                Log.Information("Added new ClassRoster");
            }
            catch (Exception ex) { MessageBox.Show($"Lỗi: {ex.Message}"); }
        }

        private void SaveSchoolConfig_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                string year = txtSchoolYear.Text.Trim();
                string semester = (cboDefaultSemester.SelectedItem as ComboBoxItem)?.Tag?.ToString() ?? "HK2";
                int saved = 0;

                foreach (Border rowBorder in rosterRowsPanel.Children)
                {
                    if (rowBorder.Tag is not int id || rowBorder.Child is not Grid grid) continue;
                    var roster = db.ClassRosters.FirstOrDefault(r => r.Id == id);
                    if (roster == null) continue;

                    foreach (UIElement child in grid.Children)
                    {
                        if (child is TextBox tb)
                        {
                            var tag = tb.Tag?.ToString() ?? "";
                            if (tag == $"name_{id}") roster.ClassName = tb.Text.Trim();
                            if (tag == $"subj_{id}") roster.Subject = tb.Text.Trim();
                            if (tag == $"teacher_{id}") roster.TeacherName = tb.Text.Trim();
                        }
                        if (child is ComboBox cbo && cbo.Tag?.ToString() == $"level_{id}")
                        {
                            var sel = cbo.SelectedItem as ComboBoxItem;
                            if (sel?.Tag is string lv) roster.GradeLevel = lv;
                        }
                    }
                    roster.SchoolYear = year;
                    roster.Semester = semester;
                    saved++;
                }

                db.SaveChanges();
                LoadRosterRows();
                MessageBox.Show($"✅ Đã lưu {saved} lớp!", "Thành công", MessageBoxButton.OK, MessageBoxImage.Information);
                Log.Information("SaveSchoolConfig: {Count} rosters", saved);
            }
            catch (Exception ex) { MessageBox.Show($"Lỗi: {ex.Message}"); }
        }

        private void DeleteRoster_Click(object sender, RoutedEventArgs e)
        {
            if (sender is not Button btn || btn.Tag is not int id) return;
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                var roster = db.ClassRosters.FirstOrDefault(r => r.Id == id);
                if (roster == null) return;

                bool hasStudents = db.ClassRosterStudents.Any(rs => rs.RosterId == id);
                bool hasGrades = db.StudentGrades.Any(sg => sg.RosterId == id);

                if (hasStudents || hasGrades)
                {
                    var res = MessageBox.Show($"Lớp \"{roster.ClassName}\" có {(hasGrades ? "điểm" : "học sinh")}.\nVô hiệu hóa (ẩn) thay vì xóa?", "Không thể xóa", MessageBoxButton.YesNo, MessageBoxImage.Warning);
                    if (res == MessageBoxResult.Yes)
                    {
                        roster.IsActive = false;
                        db.SaveChanges();
                        LoadRosterRows();
                    }
                    return;
                }

                var confirm = MessageBox.Show($"Xóa lớp \"{roster.ClassName}\"?", "Xác nhận", MessageBoxButton.YesNo, MessageBoxImage.Question);
                if (confirm == MessageBoxResult.Yes)
                {
                    db.ClassRosters.Remove(roster);
                    db.SaveChanges();
                    LoadRosterRows();
                }
            }
            catch (Exception ex) { MessageBox.Show($"Lỗi: {ex.Message}"); }
        }
    }

    /// <summary>Persistent app settings (saved as JSON)</summary>
    public class ClassroomSettings
    {
        public string Theme { get; set; } = "Light";
        public string Language { get; set; } = "vi";
        public int FontSize { get; set; } = 14;
        public int TcpPort { get; set; } = 29877;
        public bool AutoReconnect { get; set; } = true;
        public int MaxStudents { get; set; } = 35;
        public DateTime SavedAt { get; set; } = DateTime.Now;
    }
}

