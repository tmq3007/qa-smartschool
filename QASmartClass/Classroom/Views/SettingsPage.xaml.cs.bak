using System;
using System.IO;
using System.Linq;
using System.Text.Json;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using System.Windows.Media;
using QASmartClass.Data;
using QASmartClass.Shared;
using QASmartTouch.Services;
using Serilog;

namespace QASmartClass.Classroom.Views
{
    public partial class SettingsPage : Page
    {
        private bool _isLoading = true; // prevent saves during initial load
        private static readonly string SettingsFilePath = QASmartClass.Services.AppPaths.ClassroomSettingsFile;

        public SettingsPage()
        {
            InitializeComponent();
            Loaded += (_, _) =>
            {
                LoadSettings();
                _isLoading = false;
            };
        }

        // ═══════════════════════════════════════════════════════
        //  LOAD ALL SETTINGS
        // ═══════════════════════════════════════════════════════

        private void LoadSettings()
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;

                // ── Load saved settings from JSON file ──
                var saved = LoadSettingsFile();

                // Theme
                SetThemeHighlight(saved.Theme);

                // Language
                cboLanguage.SelectedIndex = saved.Language == "en" ? 1 : 0;
                QASmartClass.Shared.LanguageManager.SetLanguage(saved.Language);

                // Font size
                switch (saved.FontSize)
                {
                    case 12: fontSmall.IsChecked = true; break;
                    case 16: fontLarge.IsChecked = true; break;
                    default: fontMedium.IsChecked = true; break;
                }

                // Network
                txtTcpPort.Text = saved.TcpPort.ToString();
                chkAutoReconnect.IsChecked = saved.AutoReconnect;
                txtMaxStudents.Text = saved.MaxStudents.ToString();

                // Network status
                var net = app.NetworkService;
                if (net != null && !string.IsNullOrEmpty(net.ServerIP))
                {
                    txtNetStatus.Text = net.IsBroadcasting
                        ? "🟢 Trang thai: Dang hoat dong"
                        : "🟡 Trang thai: San sang";
                    txtNetIp.Text = $"IP: {net.ServerIP} | Port: {saved.TcpPort}";
                }
                else
                {
                    txtNetStatus.Text = "🔴 Trang thai: Chua khoi dong";
                    txtNetIp.Text = "IP: —";
                }

                // ── Storage ──
                RefreshStorageInfo();

                // ── DB stats ──
                txtCountLessons.Text = db.Lessons.Count().ToString();
                txtCountStudents.Text = db.Students.Count().ToString();
                txtCountQuizzes.Text = db.Quizzes.Count().ToString();
                txtCountEvents.Text = db.EventLogs.Count().ToString();

                // ── User Role ──
                LoadRoleCards();

                // ── Teacher profile ──
                var teacher = db.TeacherProfiles.FirstOrDefault();
                if (teacher != null)
                {
                    txtTeacherName.Text = teacher.FullName;
                    txtTeacherSubject.Text = teacher.Subject;
                    txtTeacherSchool.Text = teacher.School;

                    // Match title combo
                    string[] titles = { "GV", "ThS", "TS", "PGS", "GS" };
                    int idx = Array.IndexOf(titles, teacher.Title);
                    cboTeacherTitle.SelectedIndex = idx >= 0 ? idx : 0;
                }

                // ── API Key ──
                LoadApiKey();

                // ── Grade Type Master ──
                LoadGradeTypes();

                // ── School / Roster Config ──
                LoadRosterRows();

                Log.Information("Settings loaded successfully");
            }
            catch (Exception ex) { Log.Warning("LoadSettings error: {Err}", ex.Message); }
        }

        // ═══════════════════════════════════════════════════════
        //  STORAGE INFO (real calculations)
        // ═══════════════════════════════════════════════════════

        private void RefreshStorageInfo()
        {
            try
            {
                var dbPath = QASmartClass.Services.AppPaths.DatabaseFile;

                // DB size
                long dbSize = 0;
                if (File.Exists(dbPath)) dbSize = new FileInfo(dbPath).Length;
                txtDbSize.Text = FormatBytes(dbSize);
                double dbBarRatio = Math.Min((double)dbSize / (50 * 1024 * 1024), 1.0); // max 50MB scale
                barDb.Width = Math.Max(dbBarRatio * 500, 4);

                // Cache/logs size
                long cacheSize = 0;
                var logDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "logs");
                if (Directory.Exists(logDir))
                {
                    foreach (var f in Directory.GetFiles(logDir, "*", SearchOption.AllDirectories))
                    {
                        try { cacheSize += new FileInfo(f).Length; } catch { }
                    }
                }
                txtCacheSize.Text = FormatBytes(cacheSize);
                double cacheBarRatio = Math.Min((double)cacheSize / (50 * 1024 * 1024), 1.0);
                barCache.Width = Math.Max(cacheBarRatio * 500, 4);
            }
            catch (Exception ex) { Log.Warning("RefreshStorageInfo error: {Err}", ex.Message); }
        }

        private static string FormatBytes(long bytes)
        {
            if (bytes < 1024) return $"{bytes} B";
            if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
            if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
            return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
        }

        // ═══════════════════════════════════════════════════════
        //  THEME SELECTION
        // ═══════════════════════════════════════════════════════

        private void Theme_Click(object sender, MouseButtonEventArgs e)
        {
            if (sender is Border border && border.Tag is string theme)
            {
                SetThemeHighlight(theme);
                SaveCurrentSettings();
                Log.Information("Theme changed to: {Theme}", theme);
            }
        }

        private void SetThemeHighlight(string theme)
        {
            // Reset all borders
            themeLight.BorderThickness = new Thickness(0);
            themeDark.BorderThickness = new Thickness(0);
            themeNature.BorderThickness = new Thickness(0);

            themeLight.BorderBrush = Brushes.Transparent;
            themeDark.BorderBrush = Brushes.Transparent;
            themeNature.BorderBrush = Brushes.Transparent;

            // Highlight selected
            Border selected = theme switch
            {
                "Dark" => themeDark,
                "Nature" => themeNature,
                _ => themeLight
            };
            selected.BorderThickness = new Thickness(2);
            selected.BorderBrush = new SolidColorBrush(Color.FromRgb(25, 118, 210));
        }

        private string GetSelectedTheme()
        {
            if (themeDark.BorderThickness.Left > 0) return "Dark";
            if (themeNature.BorderThickness.Left > 0) return "Nature";
            return "Light";
        }

        // ═══════════════════════════════════════════════════════
        //  LANGUAGE & FONT SIZE
        // ═══════════════════════════════════════════════════════

        private void Language_Changed(object sender, SelectionChangedEventArgs e)
        {
            if (_isLoading) return;
            var lang = (cboLanguage.SelectedItem as ComboBoxItem)?.Tag?.ToString() ?? "vi";
            QASmartClass.Shared.LanguageManager.SetLanguage(lang);
            SaveCurrentSettings();
            Log.Information("Language changed to: {Lang}", lang);
        }

        private void FontSize_Changed(object sender, RoutedEventArgs e)
        {
            if (_isLoading) return;
            if (sender is RadioButton rb && rb.Tag is string sizeStr && int.TryParse(sizeStr, out int size))
            {
                // Apply font size to application
                Application.Current.Resources["GlobalFontSize"] = (double)size;
                SaveCurrentSettings();
                Log.Information("Font size changed to: {Size}px", size);
            }
        }

        private int GetSelectedFontSize()
        {
            if (fontSmall?.IsChecked == true) return 12;
            if (fontLarge?.IsChecked == true) return 16;
            return 14;
        }

        // ═══════════════════════════════════════════════════════
        //  SIDEBAR MENU NAVIGATION
        // ═══════════════════════════════════════════════════════

        private void Menu_Click(object sender, MouseButtonEventArgs e)
        {
            foreach (var el in new[] { menuRole, menuGeneral, menuNetwork, menuStorage, menuAccount, menuAbout, menuApi, menuGrade, menuSchool })
            {
                el.Background = Brushes.Transparent;
                if (el.Child is TextBlock tb)
                {
                    tb.Foreground = new SolidColorBrush(Color.FromRgb(66, 66, 66));
                    tb.FontWeight = FontWeights.Normal;
                }
            }

            if (sender is Border border)
            {
                border.Background = new SolidColorBrush(Color.FromRgb(227, 242, 253));
                // Handle both TextBlock child and StackPanel child
                if (border.Child is StackPanel sp && sp.Children.Count > 1 && sp.Children[1] is TextBlock stb)
                {
                    stb.Foreground = new SolidColorBrush(Color.FromRgb(21, 101, 192));
                    stb.FontWeight = FontWeights.SemiBold;
                }
                else if (border.Child is TextBlock tb)
                {
                    tb.Foreground = new SolidColorBrush(Color.FromRgb(21, 101, 192));
                    tb.FontWeight = FontWeights.SemiBold;
                }

                var tag = border.Tag?.ToString();
                ScrollToSection(tag);
            }
        }

        private void ScrollToSection(string? section)
        {
            FrameworkElement? target = section switch
            {
                "role"    => sectionRole,
                "general" => sectionGeneral,
                "network" => sectionNetwork,
                "storage" => sectionStorage,
                "account" => sectionAccount,
                "about"   => sectionAbout,
                "api"     => sectionApi,
                "grade"   => sectionGrade,
                "school"  => sectionSchool,
                _ => null
            };

            if (target != null)
            {
                target.BringIntoView();
            }
        }

        // ═══════════════════════════════════════════════════════
        //  USER ROLE SELECTION
        // ═══════════════════════════════════════════════════════

        private void LoadRoleCards()
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var roleService = app.UserRoleService;
                var currentRole = roleService.CurrentRole;
                var currentInfo = UserRoleService.GetRoleInfo(currentRole);

                // Update current role badge
                txtCurrentRoleIcon.Text = currentInfo.Icon;
                txtCurrentRoleName.Text = currentInfo.Name;
                txtCurrentRoleDesc.Text = currentInfo.Description;

                // Generate role cards
                roleCardsPanel.Children.Clear();
                foreach (var info in UserRoleInfo.All)
                {
                    var isSelected = info.Role == currentRole;
                    var card = CreateRoleCard(info, isSelected);
                    roleCardsPanel.Children.Add(card);
                }

                Log.Information("Role cards loaded. Current: {Role}", currentRole);
            }
            catch (Exception ex) { Log.Warning("LoadRoleCards error: {Err}", ex.Message); }
        }

        private Border CreateRoleCard(UserRoleInfo info, bool isSelected)
        {
            var roleColor = (System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString(info.Color);
            var lightBg = System.Windows.Media.Color.FromArgb(25, roleColor.R, roleColor.G, roleColor.B);

            var card = new Border
            {
                Width = 180,
                MinHeight = 95,
                CornerRadius = new CornerRadius(12),
                Margin = new Thickness(0, 0, 10, 10),
                Padding = new Thickness(14, 12, 14, 12),
                Cursor = info.IsAvailable ? Cursors.Hand : Cursors.Arrow,
                BorderThickness = new Thickness(isSelected ? 2.5 : 1),
                BorderBrush = isSelected
                    ? new SolidColorBrush(roleColor)
                    : new SolidColorBrush(Color.FromRgb(222, 226, 230)),
                Background = isSelected
                    ? new SolidColorBrush(lightBg)
                    : new SolidColorBrush(Colors.White),
                Tag = info.Role,
                Opacity = info.IsAvailable ? 1.0 : 0.55
            };

            var sp = new StackPanel();

            // Icon + Name row
            var headerRow = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 0, 0, 6) };
            headerRow.Children.Add(new TextBlock
            {
                Text = info.Icon,
                FontSize = 20,
                Margin = new Thickness(0, 0, 8, 0),
                VerticalAlignment = VerticalAlignment.Center
            });

            var nameBlock = new TextBlock
            {
                Text = info.Name,
                FontSize = 12,
                FontWeight = isSelected ? FontWeights.Bold : FontWeights.SemiBold,
                Foreground = new SolidColorBrush(roleColor),
                VerticalAlignment = VerticalAlignment.Center,
                TextWrapping = TextWrapping.Wrap,
                MaxWidth = 120
            };
            headerRow.Children.Add(nameBlock);
            sp.Children.Add(headerRow);

            // Description
            sp.Children.Add(new TextBlock
            {
                Text = info.Description,
                FontSize = 10,
                Foreground = new SolidColorBrush(Color.FromRgb(134, 142, 150)),
                TextWrapping = TextWrapping.Wrap,
                MaxWidth = 160
            });

            // Status badge
            if (!info.IsAvailable)
            {
                var badge = new Border
                {
                    CornerRadius = new CornerRadius(6),
                    Background = new SolidColorBrush(Color.FromRgb(255, 243, 224)),
                    Padding = new Thickness(8, 3, 8, 3),
                    Margin = new Thickness(0, 6, 0, 0),
                    HorizontalAlignment = HorizontalAlignment.Left
                };
                badge.Child = new TextBlock
                {
                    Text = "⏳ Sắp ra mắt",
                    FontSize = 10,
                    Foreground = new SolidColorBrush(Color.FromRgb(230, 81, 0))
                };
                sp.Children.Add(badge);
            }
            else if (isSelected)
            {
                var badge = new Border
                {
                    CornerRadius = new CornerRadius(6),
                    Background = new SolidColorBrush(Color.FromRgb(232, 245, 233)),
                    Padding = new Thickness(8, 3, 8, 3),
                    Margin = new Thickness(0, 6, 0, 0),
                    HorizontalAlignment = HorizontalAlignment.Left
                };
                badge.Child = new TextBlock
                {
                    Text = "✅ Đang sử dụng",
                    FontSize = 10,
                    FontWeight = FontWeights.SemiBold,
                    Foreground = new SolidColorBrush(Color.FromRgb(46, 125, 50))
                };
                sp.Children.Add(badge);
            }

            card.Child = sp;

            // Click handler
            if (info.IsAvailable)
            {
                card.MouseLeftButtonDown += RoleCard_Click;
            }

            return card;
        }

        private void RoleCard_Click(object sender, MouseButtonEventArgs e)
        {
            if (sender is not Border card || card.Tag is not UserRole selectedRole)
                return;

            var app = (QASmartTouch.App)Application.Current;
            var currentRole = app.UserRoleService.CurrentRole;

            if (selectedRole == currentRole)
                return; // Already selected

            var info = UserRoleService.GetRoleInfo(selectedRole);

            var result = MessageBox.Show(
                $"Chuyển vai trò sang: {info.Icon} {info.Name}?\n\n" +
                $"{info.Description}\n\n" +
                $"Modules: {string.Join(", ", info.AvailableModules)}\n\n" +
                "⚠️ Ứng dụng sẽ khởi động lại để áp dụng.",
                "Thay đổi vai trò sử dụng",
                MessageBoxButton.YesNo, MessageBoxImage.Question);

            if (result == MessageBoxResult.Yes)
            {
                app.UserRoleService.SaveRole(selectedRole);
                Log.Information("User role changed to: {Role}", selectedRole);

                // Restart app
                var exePath = System.Diagnostics.Process.GetCurrentProcess().MainModule?.FileName;
                if (!string.IsNullOrEmpty(exePath))
                {
                    System.Diagnostics.Process.Start(exePath);
                    Application.Current.Shutdown();
                }
            }
        }

        // ═══════════════════════════════════════════════════════
        //  STORAGE ACTIONS
        // ═══════════════════════════════════════════════════════

        private void ClearCache_Click(object sender, RoutedEventArgs e)
        {
            var logDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "logs");
            int deleted = 0;
            long freed = 0;
            if (Directory.Exists(logDir))
            {
                foreach (var f in Directory.GetFiles(logDir, "*.log"))
                {
                    try
                    {
                        freed += new FileInfo(f).Length;
                        File.Delete(f);
                        deleted++;
                    }
                    catch { }
                }
            }
            MessageBox.Show($"Da xoa {deleted} file ({FormatBytes(freed)})!\nThu muc logs da duoc don sach.",
                "Xoa Cache", MessageBoxButton.OK, MessageBoxImage.Information);
            RefreshStorageInfo();
            Log.Information("Cache cleared: {Count} files, {Size} freed", deleted, FormatBytes(freed));
        }

        private void OpenDbFolder_Click(object sender, RoutedEventArgs e)
        {
            var folder = QASmartClass.Services.AppPaths.RootDir;
            Directory.CreateDirectory(folder);
            System.Diagnostics.Process.Start("explorer.exe", folder);
        }

        private void ResetDb_Click(object sender, RoutedEventArgs e)
        {
            var result = MessageBox.Show(
                "Ban chac chan muon XOA TOAN BO du lieu?\n\nThao tac nay khong the hoan tac!",
                "Xac nhan Reset", MessageBoxButton.YesNo, MessageBoxImage.Warning);

            if (result == MessageBoxResult.Yes)
            {
                var dbPath = QASmartClass.Services.AppPaths.DatabaseFile;
                try
                {
                    if (File.Exists(dbPath)) File.Delete(dbPath);
                    MessageBox.Show("Da xoa CSDL. Khoi dong lai ung dung de tao moi.",
                        "Reset thanh cong", MessageBoxButton.OK, MessageBoxImage.Information);
                    Log.Warning("Database reset by user");
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"Loi: {ex.Message}", "Khong the xoa", MessageBoxButton.OK, MessageBoxImage.Error);
                }
            }
        }

        // ═══════════════════════════════════════════════════════
        //  TEACHER ACCOUNT SAVE
        // ═══════════════════════════════════════════════════════

        private void SaveAccount_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                var teacher = db.TeacherProfiles.FirstOrDefault();

                if (teacher == null)
                {
                    teacher = new TeacherProfile();
                    db.TeacherProfiles.Add(teacher);
                }

                teacher.FullName = txtTeacherName.Text.Trim();
                teacher.Subject = txtTeacherSubject.Text.Trim();
                teacher.School = txtTeacherSchool.Text.Trim();
                var titleText = (cboTeacherTitle.SelectedItem as ComboBoxItem)?.Content?.ToString() ?? "GV";
                teacher.Title = titleText.Contains(" — ") ? titleText.Split(" — ")[0] : titleText;
                teacher.UpdatedAt = DateTime.Now;

                db.SaveChanges();

                MessageBox.Show("Da luu thong tin giao vien!",
                    "Luu", MessageBoxButton.OK, MessageBoxImage.Information);
                Log.Information("Teacher profile saved: {Name} ({Title})", teacher.FullName, teacher.Title);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Loi: {ex.Message}", "Loi", MessageBoxButton.OK, MessageBoxImage.Error);
                Log.Warning("SaveAccount error: {Err}", ex.Message);
            }
        }

        // ═══════════════════════════════════════════════════════
        //  CHANGE PASSWORD
        // ═══════════════════════════════════════════════════════

        private void ChangePassword_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var db = app.Database;
                var teacher = db.TeacherProfiles.FirstOrDefault();
                string currentPwd = teacher?.TeacherPassword ?? "admin";

                // Validate current password
                if (txtCurrentPassword.Password != currentPwd)
                {
                    txtPasswordMsg.Text = "Mat khau hien tai khong dung!";
                    txtPasswordMsg.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                    return;
                }

                // Validate new password
                if (string.IsNullOrWhiteSpace(txtNewPassword.Password))
                {
                    txtPasswordMsg.Text = "Mat khau moi khong duoc de trong!";
                    txtPasswordMsg.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                    return;
                }

                if (txtNewPassword.Password.Length < 4)
                {
                    txtPasswordMsg.Text = "Mat khau moi phai co it nhat 4 ky tu!";
                    txtPasswordMsg.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                    return;
                }

                // Validate confirm
                if (txtNewPassword.Password != txtConfirmPassword.Password)
                {
                    txtPasswordMsg.Text = "Xac nhan mat khau khong khop!";
                    txtPasswordMsg.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                    return;
                }

                // Save
                if (teacher == null)
                {
                    teacher = new TeacherProfile();
                    db.TeacherProfiles.Add(teacher);
                }
                teacher.TeacherPassword = txtNewPassword.Password;
                teacher.UpdatedAt = DateTime.Now;
                db.SaveChanges();

                // Clear fields
                txtCurrentPassword.Password = "";
                txtNewPassword.Password = "";
                txtConfirmPassword.Password = "";
                txtPasswordMsg.Text = "Doi mat khau thanh cong!";
                txtPasswordMsg.Foreground = new SolidColorBrush(Color.FromRgb(46, 125, 50));

                Log.Information("Teacher password changed successfully");
            }
            catch (Exception ex)
            {
                txtPasswordMsg.Text = $"Loi: {ex.Message}";
                txtPasswordMsg.Foreground = new SolidColorBrush(Color.FromRgb(198, 40, 40));
                Log.Warning("ChangePassword error: {Err}", ex.Message);
            }
        }

