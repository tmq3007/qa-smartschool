<Page x:Class="QASmartClass.Classroom.Views.TimetablePage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Background="#F5F5F5">



    <Grid Margin="24,16">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,14" Margin="0,0,0,12"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ─── ROW 1: TITLE, MODE, INFO & WEEK NAVIGATION ─── -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- Right: Week Nav + Sim -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="◀ Tuần trước" FontSize="12" Padding="10,6" Background="#F5F5F5"
                                Foreground="#555" BorderThickness="1" BorderBrush="#DDD" Cursor="Hand"
                                Click="PrevWeek_Click" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="📅 Tuần này" FontSize="12" Padding="10,6" Background="#E3F2FD"
                                Foreground="#1565C0" BorderThickness="0" Cursor="Hand" Click="ThisWeek_Click" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Tuần sau ▶" FontSize="12" Padding="10,6" Background="#F5F5F5"
                                Foreground="#555" BorderThickness="1" BorderBrush="#DDD" Cursor="Hand" Click="NextWeek_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="1" Background="#E0E0E0" Margin="10,2" Height="22"/>

                        <!-- SIMULATION TIME PICKER -->
                        <Border Background="#FFF8E1" CornerRadius="8" Padding="6,3" Margin="0,0,4,0"
                                BorderBrush="#FFE082" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕐" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="cboSimHour" Width="46" FontSize="11" Padding="2" VerticalAlignment="Center"
                                          SelectionChanged="SimTime_Changed" ToolTip="Giờ"/>
                                <TextBlock Text=":" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0"/>
                                <ComboBox x:Name="cboSimMinute" Width="46" FontSize="11" Padding="2" VerticalAlignment="Center"
                                          SelectionChanged="SimTime_Changed" ToolTip="Phút"/>
                                <Button x:Name="btnSimToggle" Content="▶ Test" FontSize="10" Padding="6,3" Margin="4,0,0,0"
                                        Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Click="SimToggle_Click" VerticalAlignment="Center" ToolTip="Bật/tắt chế độ mô phỏng giờ">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F57C00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Left: Title, Mode, Class Info, Current Status -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 Thời Khóa Biểu" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="cboTimetableMode" Width="150" FontSize="12" FontWeight="SemiBold" Padding="6,4" VerticalAlignment="Center" SelectionChanged="TimetableMode_Changed" Margin="0,0,12,0">
                            <ComboBoxItem Content="🏫 Của Lớp học" Tag="Class" IsSelected="True"/>
                            <ComboBoxItem Content="👨‍🏫 Của Giáo viên" Tag="Teacher"/>
                        </ComboBox>
                        
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="txtClassInfo" Text="🏫 Lớp ..." FontSize="12" Foreground="#1E40AF" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="txtWeekRange" Text="" FontSize="11" Foreground="#64748B" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtCurrentPeriod" Text="" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>

                <!-- Divider line between info row and button row -->
                <Border Grid.Row="1" Height="1" Background="#F1F5F9" VerticalAlignment="Top" Margin="0,0,0,8"/>

                <!-- ─── ROW 2: ACTION TOOLBAR ─── -->
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <!-- Right: Import / Export -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📥 Import" FontSize="12" Padding="12,6" Background="#E8F5E9"
                                Foreground="#2E7D32" BorderThickness="0" Cursor="Hand" Click="ImportTimetable_Click" Margin="0,0,6,0" ToolTip="Nhập TKB từ Excel">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="📤 Export" FontSize="12" Padding="12,6" Background="#FFF3E0"
                                Foreground="#E65100" BorderThickness="0" Cursor="Hand" Click="ExportTimetable_Click" Margin="0,0,0,0" ToolTip="Xuất TKB ra Excel">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFE0B2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Left: Action buttons (WrapPanel ensures nothing is ever hidden or truncated) -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➕ Thêm tiết học" FontSize="12" FontWeight="SemiBold" Padding="12,6" Background="#2563EB"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Click="AddSlot_Click" Margin="0,0,8,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="📚 Danh mục Môn học" FontSize="12" FontWeight="SemiBold" Padding="12,6" Background="#7C3AED"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Click="ManageSubjects_Click" Margin="0,0,8,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="⏰ Khung giờ học" FontSize="12" FontWeight="SemiBold" Padding="12,6" Background="#0284C7"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Click="ConfigurePeriodTimes_Click" Margin="0,0,8,4"
                                ToolTip="Cài đặt khung giờ học theo mùa (Mùa hè / Mùa đông) hoặc giờ vào học theo trường">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnOpenPeriodLogbook" Content="📖 Sổ đầu bài điện tử" FontSize="12" FontWeight="SemiBold" Padding="12,6" Background="#0D9488"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Click="OpenPeriodLogbook_Click" Margin="0,0,8,4" ToolTip="Xem và tra cứu Sổ đầu bài điện tử các lớp">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnQuickTeachNow" Content="🚀 Vào dạy tiết này" FontSize="12" FontWeight="Bold" Padding="14,6" Background="#16A34A"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Click="QuickTeachNow_Click" Margin="0,0,8,4" Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Border>



        <!-- ═══ TIMETABLE GRID ═══ -->

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="0"

                BorderBrush="#E0E0E0" BorderThickness="1" ClipToBounds="True">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

                <Grid x:Name="timetableGrid" Margin="0"/>

            </ScrollViewer>

        </Border>

    </Grid>

</Page>

