<Page x:Class="QASmartClass.Classroom.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Veyon Master - Giám sát &amp; Quản lý Lớp học"
      Background="#DCE2EA"
      FontFamily="Segoe UI, Inter"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- SVG Vector Geometries -->
        <Geometry x:Key="GeomScreen">M21,3H3C1.89,3 1,3.89 1,5V17C1,18.1 1.89,19 3,19H10V21H14V19H21C22.1,19 23,18.1 23,17V5C23,3.89 22.1,3 21,3M21,17H3V5H21V17Z</Geometry>
        <Geometry x:Key="GeomLock">M18,8H17V6A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M9,6A3,3 0 0,1 15,6V8H9V6M12,17A2,2 0 1,1 14,15A2,2 0 0,1 12,17Z</Geometry>
        <Geometry x:Key="GeomUnlock">M18,8H17V6A5,5 0 0,0 7,6V8H9V6A3,3 0 0,1 15,6A3,3 0 0,1 18,9V10H6A2,2 0 0,0 4,12V22A2,2 0 0,0 6,24H18A2,2 0 0,0 20,22V12A2,2 0 0,0 18,8Z</Geometry>
        <Geometry x:Key="GeomCheck">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z</Geometry>
        <Geometry x:Key="GeomBlock">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C14.1,4 16,4.8 17.4,6.2L6.2,17.4C4.8,16 4,14.1 4,12C4,7.6 7.6,4 12,4M12,20C9.9,20 8,19.2 6.6,17.8L17.8,6.6C19.2,8 20,9.9 20,12C20,16.4 16.4,20 12,20Z</Geometry>
        <Geometry x:Key="GeomFile">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z</Geometry>
        <Geometry x:Key="GeomChat">M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2Z</Geometry>
        <Geometry x:Key="GeomRefresh">M17.65,6.35A8,8 0 0,0 4,12H7A5,5 0 0,1 12,7A5,5 0 0,1 16,8.59L13,11.5H21V3.5L17.65,6.35Z</Geometry>
        <Geometry x:Key="GeomWifi">M12,21.5L2,11.5C3,10.5 7,6.5 12,6.5C17,6.5 21,10.5 22,11.5L12,21.5M12,2C6.5,2 2,4.5 0,5.5L2,7.5C3.5,6.7 7.5,4.5 12,4.5C16.5,4.5 20.5,6.7 22,7.5L24,5.5C22,4.5 17.5,2 12,2Z</Geometry>
        <Geometry x:Key="GeomPeople">M16,13C14.3,13 11,13.9 11,15.6V17H21V15.6C21,13.9 17.7,13 16,13M16,11A3,3 0 1,0 16,5A3,3 0 0,0 16,11M9,13C7.3,13 4,13.9 4,15.6V17H10V15.6C10,14.5 10.4,13.6 11,13M9,11A3,3 0 1,0 9,5A3,3 0 0,0 9,11Z</Geometry>
        <Geometry x:Key="GeomWarning">M12,2L1,21H23L12,2M12,6L19.5,19H4.5L12,6M12,10V14H13V10H12M12,16V17H13V16H12Z</Geometry>
        <Geometry x:Key="GeomInfo">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M13,17H11V11H13V17M13,9H11V7H13V9Z</Geometry>
        <Geometry x:Key="GeomComputer">M21,2H3C1.9,2 1,2.9 1,4v12c0,1.1 0.9,2 2,2h7v2H8v2h8v-2h-2v-2h7c1.1,0 2-0.9 2-2V4C23,2.9 22.1,2 21,2z M21,14H3V4h18V14z</Geometry>
        <Geometry x:Key="GeomShield">M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z</Geometry>

        <!-- Rounded button template -->
        <ControlTemplate x:Key="LightBtn" TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Light Styling -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <!-- [RULE] QC_4.2_LAYOUT_GRID: rootGrid Stretch, No MaxWidth, Bố cục chuẩn Veyon Master -->
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- Row 0: Workspace (Left Locations & Computers Dock + Center Computer Screen Grid) -->
            <RowDefinition Height="Auto"/>   <!-- Row 1: Veyon Bottom Status Bar (Panel Toggle + Search + Auto-fit + Zoom Slider) -->
        </Grid.RowDefinitions>

        <!-- ═══ 1. MAIN VEYON WORKSPACE: Left Dock (Locations & Computers) + Center Live Screen Grid ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Col 0: Left Collapsible Panel ("Locations & Computers" chuẩn Veyon) -->
                <ColumnDefinition Width="*"/>    <!-- Col 1: Center Computer Monitoring Grid -->
            </Grid.ColumnDefinitions>

            <!-- 1.A. VEYON LEFT PANEL: "Locations & Computers" (Phòng học & Danh sách máy) -->
            <Border x:Name="veyonLeftPanel" Grid.Column="0" Width="268" Background="#F8FAFC"
                    BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header + Phòng học / Kênh -->
                        <RowDefinition Height="Auto"/> <!-- Bộ lọc & Chọn máy -->
                        <RowDefinition Height="Auto"/> <!-- Tác vụ nhanh & Chặn app -->
                        <RowDefinition Height="*"/>    <!-- Nhật ký hoạt động / Trạng thái máy -->
                    </Grid.RowDefinitions>

                    <!-- Section 1: Locations / Classroom Session -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="📍 PHÒNG HỌC &amp; MÁY TRẠM" FontSize="11.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            <Button x:Name="btnStartSession" DockPanel.Dock="Right" Content="Bắt đầu lớp" FontSize="11.5" FontWeight="Bold" Padding="10,4"
                                    Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Click="StartSession_Click"
                                    HorizontalAlignment="Right" Template="{StaticResource LightBtn}"/>
                        </DockPanel>

                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="🏫 Phòng/Lớp:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="cmbSessionClass" Height="26" FontSize="12" FontWeight="Bold"
                                              Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                              VerticalContentAlignment="Center" Cursor="Hand" SelectionChanged="CmbSessionClass_SelectionChanged"/>
                                </DockPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock x:Name="txtSessionCode" Text="Mã lớp: --" FontSize="11.5" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txtSessionIP" Text="IP: --" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Section 2: Quick Filter Chips & Multi-Computer Selection (Veyon Computer Filter) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="🖥️ BỘ LỌC MÁY TÍNH" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button x:Name="chipAll" Tag="all" Click="FilterChip_Click" Height="30" Margin="0,0,4,4" Cursor="Hand" BorderThickness="0" Background="#005BAA" Foreground="White" FontWeight="SemiBold" FontSize="11.5" Content="Tất cả 0" Template="{StaticResource LightBtn}"/>
                            <Button x:Name="chipHand" Tag="hand" Click="FilterChip_Click" Height="30" Margin="4,0,0,4" Cursor="Hand" BorderThickness="0" Background="#E6EEFF" Foreground="#1E293B" FontWeight="SemiBold" FontSize="11.5" Content="✋ Giơ tay 0" Template="{StaticResource LightBtn}"/>
                            <Button x:Name="chipAlert" Tag="alert" Click="FilterChip_Click" Height="30" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0" Background="#E6EEFF" Foreground="#1E293B" FontWeight="SemiBold" FontSize="11.5" Content="⚠️ Cảnh báo 0" Template="{StaticResource LightBtn}"/>
                            <Button x:Name="chipOffline" Tag="offline" Click="FilterChip_Click" Height="30" Margin="4,0,0,0" Cursor="Hand" BorderThickness="0" Background="#E6EEFF" Foreground="#1E293B" FontWeight="SemiBold" FontSize="11.5" Content="Offline 0" Template="{StaticResource LightBtn}"/>
                        </UniformGrid>

                        <!-- Chọn từng máy (Computer Checkbox Selection) -->
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6"
                                Cursor="Hand" MouseLeftButtonDown="ToggleSelectMode_Click">
                            <DockPanel>
                                <Border x:Name="toggleSelectMode" DockPanel.Dock="Right"
                                        Width="36" Height="18" CornerRadius="9" Background="#CBD5E1">
                                    <Ellipse x:Name="toggleSelectDot" Width="14" Height="14" Fill="White"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomCheck}" Fill="#0284C7" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chọn nhiều máy trạm" FontSize="12" Foreground="#1E293B" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Actions for selected computers -->
                        <StackPanel x:Name="pnlSelectedActions" Visibility="Collapsed" Margin="0,0,0,6">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="txtSelectedCount" Text="0 đã chọn"
                                           FontSize="11.5" Foreground="#0369A1" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Chọn hết" FontSize="11" Padding="7,3" Cursor="Hand"
                                            Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#BAE6FD"
                                            BorderThickness="1" Template="{StaticResource LightBtn}"
                                            Click="SelectAll_Click" Margin="0,0,4,0"/>
                                    <Button Content="Bỏ chọn" FontSize="11" Padding="7,3" Cursor="Hand"
                                            Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1"
                                            BorderThickness="1" Template="{StaticResource LightBtn}"
                                            Click="DeselectAll_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <UniformGrid Columns="2">
                                <Button Background="#DC2626" Foreground="White" Padding="0,6"
                                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,3,0" BorderThickness="0"
                                        Template="{StaticResource LightBtn}" Click="LockSelected_Click" Content="🔒 Khóa máy chọn"/>
                                <Button Background="#16A34A" Foreground="White" Padding="0,6"
                                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="3,0,0,0" BorderThickness="0"
                                        Template="{StaticResource LightBtn}" Click="UnlockSelected_Click" Content="🔓 Mở máy chọn"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Chặn ứng dụng ngoài -->
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,7"
                                Cursor="Hand" MouseLeftButtonDown="ToggleBlockApps_Click">
                            <DockPanel>
                                <Border x:Name="toggleBlockApp" DockPanel.Dock="Right"
                                        Width="36" Height="18" CornerRadius="9" Background="#10B981">
                                    <Ellipse x:Name="toggleDot" Width="14" Height="14" Fill="White"
                                             HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomBlock}" Fill="#D97706" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chặn Game / App ngoài" FontSize="12" Foreground="#1E293B" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Section 3: Persistent Off-Task Banner (No Blinking), Action Toast & Quick Utilities -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <!-- Banner theo dõi ngầm: Còn ở ứng dụng/thiết bị khác thì giữ nguyên không nháy, quay về lớp thì tự ẩn ngay -->
                        <Border x:Name="offTaskBanner" Background="#EA580C" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,6" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Lọc xem" Background="#C2410C"
                                            BorderThickness="0" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                                            Cursor="Hand" Click="FilterOffTaskBanner_Click" Padding="6,2" Margin="6,0,0,0"
                                            Template="{StaticResource LightBtn}"/>
                                    <TextBlock x:Name="txtOffTaskBannerTitle" Text="" FontSize="11.5"
                                               FontWeight="Bold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="txtOffTaskBannerDetail" Text="" FontSize="11"
                                           Foreground="#FEF3C7" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Toast thông báo thao tác tức thời (không dùng cho cảnh báo lặp lại) -->
                        <Border x:Name="toastPopup" Background="#0369A1" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,6" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Background="Transparent"
                                            BorderThickness="0" Foreground="White" FontSize="12" Cursor="Hand"
                                            Click="DismissToast_Click" Padding="0" Margin="4,0,0,0"/>
                                    <TextBlock x:Name="txtToastTitle" Text="" FontSize="11.5"
                                               FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock x:Name="txtToastDetail" Text="" FontSize="11"
                                           Foreground="#E0F2FE" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <Button Background="White" Foreground="#334155" Padding="6,6"
                                    FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,3,0"
                                    BorderBrush="#CBD5E1" BorderThickness="1"
                                    Template="{StaticResource LightBtn}" Click="SendFile_Click" Content="📤 Gửi File nhanh"/>
                            <Button Background="White" Foreground="#334155" Padding="6,6"
                                    FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="3,0,0,0"
                                    BorderBrush="#CBD5E1" BorderThickness="1"
                                    Template="{StaticResource LightBtn}" Click="NetworkDiag_Click" Content="📡 Chẩn đoán LAN"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Section 4: Live Connected Students List + Activity Log -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.35*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.9*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtLeftStudentListHeader" Grid.Row="0" Text="👥 DANH SÁCH HỌC SINH (0)"
                                   FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,5"/>

                        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="6" Padding="4" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock x:Name="txtEmptyStudentListHint"
                                           Text="Chưa có học sinh kết nối vào lớp"
                                           FontSize="11" Foreground="#94A3B8" FontStyle="Italic"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="lstConnectedStudents">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,4" CornerRadius="5" Padding="7,5" Cursor="Hand"
                                                        MouseLeftButtonDown="Thumbnail_Click"
                                                        ToolTip="Nhấp để mở điều khiển học sinh này">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding HasAlert}" Value="True">
                                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                                    <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1"
                                                                    Background="#FEE2E2" Visibility="{Binding OffTaskVisibility}" VerticalAlignment="Center">
                                                                <TextBlock Text="⚠️ Ngoài bài" FontSize="9.5" FontWeight="Bold" Foreground="#B91C1C"/>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding StatusDotColor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <DockPanel Margin="12,2,0,0" LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayIP}" FontSize="9.5"
                                                                       Foreground="#94A3B8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CurrentAppLabel}" FontSize="10"
                                                                       Foreground="{Binding CurrentAppForeground}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="📋 NHẬT KÝ SỰ KIỆN" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="activityLog">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" CornerRadius="5" Padding="7,5"
                                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Time}" DockPanel.Dock="Right"
                                                               FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                               FontWeight="Bold" Foreground="#1E293B"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                           Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- 1.B. VEYON CENTER COMPUTER MONITORING GRID (Lưới màn hình máy Học sinh chuẩn Veyon) -->
            <Grid Grid.Column="1" Margin="8,8,8,4">
                <!-- Live Thumbnail Grid (Veyon Computer Monitor Tiles) -->
                <ListBox x:Name="monitorGrid" Visibility="Visible"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Students}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Path=DataContext.ColumnsCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Rows="1" IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Ô Màn Hình Máy Tính Chuẩn Veyon Master -->
                                        <Border Margin="6" CornerRadius="6" Cursor="Hand"
                                                MouseLeftButtonDown="Thumbnail_Click" ClipToBounds="True"
                                                MinHeight="155"
                                                ToolTip="Nhấp chuột để mở bảng điều khiển máy Học sinh này (Quan sát to, Điều khiển, Khóa máy, Gửi cảnh báo, Mời ra khỏi lớp)">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0F172A" Opacity="0.08" BlurRadius="6" ShadowDepth="1"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                                            <Setter Property="Background" Value="#F0F9FF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding HasAlert}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                                            <Setter Property="BorderThickness" Value="2.5"/>
                                                            <Setter Property="Background" Value="#E0F2FE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>    <!-- Row 0: Khung màn hình máy tính 16:9 kiểu Veyon -->
                                                    <RowDefinition Height="Auto"/> <!-- Row 1: Nhãn Tên Học sinh & Tên máy dưới chân màn hình -->
                                                    <RowDefinition Height="Auto"/> <!-- Row 2: Ứng dụng đang mở -->
                                                </Grid.RowDefinitions>

                                                <!-- Khung màn hình máy tính (Dark Screen Bezel chuẩn Veyon) -->
                                                <Border Grid.Row="0" MinHeight="112" Background="#0F172A" ClipToBounds="True" Margin="5,5,5,3" CornerRadius="4" BorderBrush="#334155" BorderThickness="1">
                                                    <Grid>
                                                        <!-- Ảnh màn hình thời gian thực -->
                                                        <Image Source="{Binding ScreenshotSource}"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                        <!-- Placeholder biểu tượng máy tính kiểu Veyon khi chưa có ảnh chụp -->
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                    Visibility="{Binding PlaceholderVisibility}">
                                                            <Path Data="{StaticResource GeomComputer}" Fill="#475569" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Huy hiệu Giơ tay (Top-Left) -->
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"
                                                                CornerRadius="4" Padding="6,2" Background="#F59E0B" Visibility="{Binding HandRaiseVisibility}">
                                                            <TextBlock Text="✋ GIƠ TAY" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                                                        </Border>

                                                        <!-- Huy hiệu Cảnh báo (Top-Right) -->
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5"
                                                                CornerRadius="4" Padding="5,2" Background="#EF4444"
                                                                Visibility="{Binding OffTaskVisibility}">
                                                            <TextBlock Text="{Binding AlertBadgeText}" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                                                        </Border>

                                                        <!-- VNC Focus Badge (Top-Right) -->
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5"
                                                                CornerRadius="4" Padding="5,2" Background="{Binding BroadcastFocusColor}"
                                                                Visibility="{Binding BroadcastFocusVisibility}">
                                                            <TextBlock Text="{Binding BroadcastFocusLabel}" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                                                        </Border>

                                                        <!-- Checkbox chọn máy (Bottom-Left) -->
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                  Margin="6"
                                                                  Visibility="{Binding SelectModeVisibility}"
                                                                  Click="StudentCheckbox_Click"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Nhãn Tên Học sinh & Tên máy / IP dưới chân màn hình (Chuẩn Veyon) -->
                                                <Border Grid.Row="1" Padding="7,4" Background="Transparent">
                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Background="{Binding StatusPillBackground}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayPCName}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusTextColor}" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusDotColor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Ứng dụng học sinh đang mở -->
                                                <Border Grid.Row="2" Margin="6,0,6,5" CornerRadius="4" Padding="6,2"
                                                        Background="{Binding CurrentAppBackground}" Visibility="{Binding CurrentAppVisibility}">
                                                    <TextBlock Text="{Binding CurrentAppLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{Binding CurrentAppForeground}" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Chế độ Danh sách gọn (List View) -->
                <ScrollViewer x:Name="scrollStudentList" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="studentGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="4" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="165" Height="135" Margin="6" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" Cursor="Hand" MouseLeftButtonDown="Thumbnail_Click">
                                    <StackPanel Margin="10,8" VerticalAlignment="Center">
                                        <Border Height="72" CornerRadius="6" Background="{Binding AvatarBackground}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding StudentInitials}"
                                                       Foreground="{Binding AvatarForeground}"
                                                       FontSize="20" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" Width="125"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayPCName}" FontSize="10.5" Foreground="#64748B" Margin="14,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══ 2. VEYON BOTTOM STATUS & CONTROL BAR (Nút bật/tắt Panel Phòng + Tìm kiếm + Thanh trượt Zoom cỡ ô màn hình) ═══ -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel LastChildFill="True">
                <!-- BÊN PHẢI: Ô tìm kiếm + Chế độ xem + Thanh trượt Phóng to / Thu nhỏ ô màn hình chuẩn Veyon -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ô tìm kiếm nhanh của Veyon -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Width="175" Height="30" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="12" Margin="7,0,4,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSearchStudent" Background="Transparent" BorderThickness="0" FontSize="12"
                                     VerticalContentAlignment="Center" TextChanged="SearchStudent_TextChanged"
                                     ToolTip="Tìm nhanh theo tên học sinh, tên máy tính hoặc địa chỉ IP"/>
                        </DockPanel>
                    </Border>

                    <!-- Chuyển Lưới / Danh sách -->
                    <Border Background="#E2E8F0" CornerRadius="5" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnViewGrid" Content="🖥️ Lưới" Padding="8,3" FontSize="11.5" FontWeight="SemiBold"
                                    Background="White" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" Click="ViewMode_Grid_Click"/>
                            <Button x:Name="btnViewList" Content="📋 Thẻ" Padding="8,3" FontSize="11.5" FontWeight="SemiBold"
                                    Background="Transparent" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="ViewMode_List_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Chế độ hiển thị: Máy kết nối vs Cả lớp -->
                    <ComboBox x:Name="cmbDisplayMode" Width="108" Height="30" Padding="8,3" FontSize="11.5"
                              SelectionChanged="DisplayMode_Changed" SelectedIndex="0" Margin="0,0,6,0">
                        <ComboBoxItem Content="Máy kết nối"/>
                        <ComboBoxItem Content="Cả lớp"/>
                    </ComboBox>

                    <ComboBox x:Name="cmbFilter" Width="92" Height="30" Padding="8,3" FontSize="11.5"
                              SelectionChanged="Filter_Changed" SelectedIndex="0" Margin="0,0,8,0">
                        <ComboBoxItem Content="Tất cả"/>
                        <ComboBoxItem Content="Online"/>
                        <ComboBoxItem Content="Offline"/>
                        <ComboBoxItem Content="Cảnh báo"/>
                    </ComboBox>

                    <!-- Giữ ẩn cmbGrid để tương thích code-behind cũ -->
                    <ComboBox x:Name="cmbGrid" Visibility="Collapsed" SelectionChanged="GridSize_Changed" SelectedIndex="2">
                        <ComboBoxItem Content="3×3"/>
                        <ComboBoxItem Content="4×4"/>
                        <ComboBoxItem Content="5×5"/>
                        <ComboBoxItem Content="6×6"/>
                    </ComboBox>

                    <!-- Thanh trượt Phóng to / Thu nhỏ Cỡ ô màn hình chuẩn Veyon Master -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="8,3" Height="30" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔎 Cỡ ô:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="sliderVeyonZoom" Width="105" Minimum="2" Maximum="8" Value="4"
                                    TickFrequency="1" IsSnapToTickEnabled="True" IsDirectionReversed="True"
                                    VerticalAlignment="Center" Cursor="Hand"
                                    ValueChanged="VeyonZoomSlider_ValueChanged"
                                    ToolTip="Kéo sang phải để phóng to ô màn hình Học sinh, kéo sang trái để thu nhỏ hiển thị nhiều máy hơn (Chuẩn Veyon)"/>
                            <TextBlock x:Name="txtVeyonGridCols" Text="4 cột" FontSize="11" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="34"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- BÊN TRÁI: Nút đóng/mở Panel Phòng & Máy tính (Giống hệt nút "Locations & computers" của Veyon) + Thông số lớp -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="btnToggleVeyonPanel" IsChecked="True" Height="30" Padding="10,4" Margin="0,0,10,0"
                                  Cursor="Hand" FontSize="11.5" FontWeight="Bold"
                                  Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#7DD3FC" BorderThickness="1"
                                  Checked="ToggleVeyonPanel_Changed" Unchecked="ToggleVeyonPanel_Changed"
                                  ToolTip="Ẩn/Hiện cột Phòng học &amp; Danh sách máy bên trái (Veyon Locations &amp; Computers)">
                        <TextBlock Text="📍 Phòng &amp; Máy tính"/>
                    </ToggleButton>

                    <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtMonitorCount" Text="0/0 trực tuyến"
                               FontSize="12" Foreground="#15803D" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtAlertCount" Text="0 cảnh báo"
                               FontSize="12" Foreground="#D97706" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <TextBlock Text="CPU: " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCpuAvg" Text="—%" FontSize="12"
                               Foreground="#1E293B" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>

                    <Border CornerRadius="5" Height="28" Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                            MouseLeftButtonDown="ToggleAutoRefresh_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeomRefresh}" Fill="#16A34A" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtRefreshStatus" Text="Tự động: 5s"
                                       FontSize="11" Foreground="#16A34A" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="5" Height="28" Padding="8,2" Margin="6,0,0,0" Cursor="Hand"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                            MouseLeftButtonDown="TogglePrivacyMode_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="pathPrivacy" Data="{StaticResource GeomUnlock}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtPrivacyStatus" Text="Riêng tư: TẮT"
                                       FontSize="11" Foreground="#334155" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
