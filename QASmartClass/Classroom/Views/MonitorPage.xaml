<Page x:Class="QASmartClass.Classroom.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Giám sát Học sinh" Background="#1A1D23"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- SVG Vector Geometries -->
        <Geometry x:Key="GeomScreen">M21,3H3C1.89,3 1,3.89 1,5V17C1,18.1 1.89,19 3,19H10V21H14V19H21C22.1,19 23,18.1 23,17V5C23,3.89 22.1,3 21,3M21,17H3V5H21V17Z</Geometry>
        <Geometry x:Key="GeomLock">M18,8H17V6A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M9,6A3,3 0 0,1 15,6V8H9V6M12,17A2,2 0 1,1 14,15A2,2 0 0,1 12,17Z</Geometry>
        <Geometry x:Key="GeomUnlock">M18,8H17V6A5,5 0 0,0 7,6V8H9V6A3,3 0 0,1 15,6A3,3 0 0,1 18,9V10H6A2,2 0 0,0 4,12V22A2,2 0 0,0 6,24H18A2,2 0 0,0 20,22V12A2,2 0 0,0 18,8Z</Geometry>
        <Geometry x:Key="GeomCheck">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z</Geometry>
        <Geometry x:Key="GeomBlock">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C14.1,4 16,4.8 17.4,6.2L6.2,17.4C4.8,16 4,14.1 4,12C4,7.6 7.6,4 12,4M12,20C9.9,20 8,19.2 6.6,17.8L17.8,6.6C19.2,8 20,9.9 20,12C20,16.4 16.4,20 12,20Z</Geometry>
        <Geometry x:Key="GeomFile">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z</Geometry>
        <Geometry x:Key="GeomChat">M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2Z</Geometry>
        <Geometry x:Key="GeomRefresh">M17.65,6.35A8,8 0 0,0 4,12H7A5,5 0 0,1 12,7A5,5 0 0,1 16,8.59L13,11.5H21V3.5L17.65,6.35Z</Geometry>
        <Geometry x:Key="GeomWifi">M12,21.5L2,11.5C3,10.5 7,6.5 12,6.5C17,6.5 21,10.5 22,11.5L12,21.5M12,2C6.5,2 2,4.5 0,5.5L2,7.5C3.5,6.7 7.5,4.5 12,4.5C16.5,4.5 20.5,6.7 22,7.5L24,5.5C22,4.5 17.5,2 12,2Z</Geometry>
        <Geometry x:Key="GeomPeople">M16,13C14.3,13 11,13.9 11,15.6V17H21V15.6C21,13.9 17.7,13 16,13M16,11A3,3 0 1,0 16,5A3,3 0 0,0 16,11M9,13C7.3,13 4,13.9 4,15.6V17H10V15.6C10,14.5 10.4,13.6 11,13M9,11A3,3 0 1,0 9,5A3,3 0 0,0 9,11Z</Geometry>
        <Geometry x:Key="GeomWarning">M12,2L1,21H23L12,2M12,6L19.5,19H4.5L12,6M12,10V14H13V10H12M12,16V17H13V16H12Z</Geometry>
        <Geometry x:Key="GeomInfo">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M13,17H11V11H13V17M13,9H11V7H13V9Z</Geometry>

        <!-- Dark rounded button template -->
        <ControlTemplate x:Key="DarkBtn" TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="b" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Page.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- Monitor grid + sidebar -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ MAIN CONTENT: Grid + Sidebar ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="monitorGrid" Grid.Column="0" Margin="0,0,12,0"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Students}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Path=DataContext.ColumnsCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Rows="1" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonDown="Thumbnail_Click" ClipToBounds="True"
                                            MaxHeight="160">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#252830"/>
                                                <Setter Property="BorderBrush" Value="#363942"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlert}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#F44336"/>
                                                        <Setter Property="BorderThickness" Value="2.5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Thumbnail area (single row, overlay layout) -->
                                            <Border MinHeight="100" ClipToBounds="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#2A2D35" Offset="0"/>
                                                        <GradientStop Color="#1E2028" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <!-- Screenshot image (real capture) -->
                                                    <Image Source="{Binding ScreenshotSource}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                    <!-- Placeholder if no screenshot -->
                                                    <Path Data="{StaticResource GeomScreen}" Fill="#8E93A0" Width="36" Height="36"
                                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Opacity="0.15" Visibility="{Binding PlaceholderVisibility}"/>

                                                    <!-- ═══ TOP OVERLAY: PC + Name + off-task badge ═══ -->
                                                    <Border VerticalAlignment="Top" Padding="5,3"
                                                            Background="#99181B20">
                                                        <DockPanel>
                                                            <!-- Off-task badge (left, red) -->
                                                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,1"
                                                                    Background="#E53935" Margin="4,0,0,0"
                                                                    Visibility="{Binding OffTaskVisibility}">
                                                                <TextBlock Text="Chưa tập trung" FontSize="10"
                                                                           Foreground="White" FontWeight="Bold"/>
                                                            </Border>
                                                            <!-- VNC Focus Badge -->
                                                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,1"
                                                                    Background="{Binding BroadcastFocusColor}" Margin="4,0,0,0"
                                                                    Visibility="{Binding BroadcastFocusVisibility}">
                                                                <TextBlock Text="{Binding BroadcastFocusLabel}" FontSize="10"
                                                                           Foreground="White" FontWeight="Bold"/>
                                                            </Border>
                                                            <!-- Online dot -->
                                                            <Ellipse Width="8" Height="8" DockPanel.Dock="Right"
                                                                     Margin="4,0,0,0" VerticalAlignment="Center"
                                                                     Fill="{Binding StatusDotColor}"/>
                                                            <!-- PC: Name -->
                                                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                       FontSize="12" Foreground="#D0D4DC" FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding DisplayPCName, Mode=OneWay}" Foreground="#8E93A0"/>
                                                                <Run Text=": "/>
                                                                <Run Text="{Binding Name}"/>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- Selection checkbox (bottom-left, visible in select mode) -->
                                                    <CheckBox IsChecked="{Binding IsSelected}" 
                                                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                              Margin="6,0,0,6"
                                                              Visibility="{Binding SelectModeVisibility}"
                                                              Click="StudentCheckbox_Click"/>

                                                    <!-- Activity color bar (bottom) -->
                                                    <Rectangle Height="3" VerticalAlignment="Bottom"
                                                               Fill="{Binding ActivityColor}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ═══ RIGHT SIDEBAR (Dark) ═══ -->
            <Border Grid.Column="1" Background="#252830" CornerRadius="12"
                    BorderBrush="#363942" BorderThickness="1" Padding="14,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Toast notification -->
                        <RowDefinition Height="Auto"/>  <!-- Action buttons -->
                        <RowDefinition Height="Auto"/>  <!-- Separator -->
                        <RowDefinition Height="*"/>     <!-- Activity log -->
                    </Grid.RowDefinitions>

                    <!-- ── TOAST NOTIFICATION (alert popup) ── -->
                    <Border x:Name="toastPopup" Grid.Row="0" Background="#FF6F00" CornerRadius="8"
                            Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Background="Transparent"
                                        BorderThickness="0" Foreground="White" FontSize="12" Cursor="Hand"
                                        Click="DismissToast_Click" Padding="0" Margin="4,0,0,0"/>
                                <TextBlock x:Name="txtToastTitle" Text="" FontSize="11"
                                           FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock x:Name="txtToastDetail" Text="" FontSize="10"
                                       Foreground="#FFECB3" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── ACTION BUTTONS ── -->
                    <StackPanel Grid.Row="1">
                        <!-- 1. Khóa tất cả -->
                        <Button Background="#E53935" Foreground="White" Padding="0,11"
                                FontSize="13" FontWeight="Bold" Cursor="Hand"
                                Margin="0,0,0,4" BorderThickness="0"
                                Template="{StaticResource DarkBtn}" Click="LockAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomLock}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Khóa tất cả" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Mở khóa tất cả -->
                        <Button Background="#43A047" Foreground="White" Padding="0,11"
                                FontSize="13" FontWeight="Bold" Cursor="Hand"
                                Margin="0,0,0,8" BorderThickness="0"
                                Template="{StaticResource DarkBtn}" Click="UnlockAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomUnlock}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mở khóa tất cả" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ── CHỌN TỪNG HS ── -->
                        <Border Background="#2D3038" CornerRadius="8" Padding="10,7" Margin="0,0,0,4"
                                Cursor="Hand" MouseLeftButtonDown="ToggleSelectMode_Click">
                            <DockPanel>
                                <Border x:Name="toggleSelectMode" DockPanel.Dock="Right"
                                        Width="40" Height="22" CornerRadius="11" Background="#757575">
                                    <Ellipse x:Name="toggleSelectDot" Width="18" Height="18" Fill="White"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomCheck}" Fill="#E0E3EA" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chọn từng HS" FontSize="13" Foreground="#E0E3EA"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Actions for selected students (visible only in select mode) -->
                        <StackPanel x:Name="pnlSelectedActions" Visibility="Collapsed" Margin="0,4,0,4">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="txtSelectedCount" Text="0 đã chọn"
                                           FontSize="12" Foreground="#FF9800" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Tất cả" FontSize="10" Padding="6,3" Cursor="Hand"
                                            Background="#2D3038" Foreground="#4CAF50" BorderBrush="#454A56"
                                            BorderThickness="1" Template="{StaticResource DarkBtn}"
                                            Click="SelectAll_Click" Margin="0,0,4,0"/>
                                    <Button Content="Bỏ chọn" FontSize="10" Padding="6,3" Cursor="Hand"
                                            Background="#2D3038" Foreground="#B0B5C3" BorderBrush="#454A56"
                                            BorderThickness="1" Template="{StaticResource DarkBtn}"
                                            Click="DeselectAll_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <Button Background="#E53935" Foreground="White" Padding="0,8"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,3" BorderThickness="0"
                                    Template="{StaticResource DarkBtn}" Click="LockSelected_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeomLock}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Khóa đã chọn" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#43A047" Foreground="White" Padding="0,8"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,3" BorderThickness="0"
                                    Template="{StaticResource DarkBtn}" Click="UnlockSelected_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeomUnlock}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mở khóa đã chọn" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 3. Phát màn hình GV -->
                        <Button Background="#1976D2" Foreground="White" Padding="0,11"
                                FontSize="13" FontWeight="Bold" Cursor="Hand"
                                Margin="0,0,0,8" BorderThickness="0"
                                Template="{StaticResource DarkBtn}" Click="BroadcastScreen_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomScreen}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Phát màn hình GV" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Chặn ứng dụng (Toggle) -->
                        <Border Background="#2D3038" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                                Cursor="Hand" MouseLeftButtonDown="ToggleBlockApps_Click">
                            <DockPanel>
                                <Border x:Name="toggleBlockApp" DockPanel.Dock="Right"
                                        Width="40" Height="22" CornerRadius="11" Background="#4CAF50">
                                    <Ellipse x:Name="toggleDot" Width="18" Height="18" Fill="White"
                                             HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomBlock}" Fill="#E0E3EA" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chặn ứng dụng" FontSize="13" Foreground="#E0E3EA"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 5. Gửi file -->
                        <Button Background="Transparent" Foreground="#B0B5C3" Padding="0,10"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,6"
                                BorderBrush="#454A56" BorderThickness="1.5"
                                Template="{StaticResource DarkBtn}" Click="SendFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomFile}" Fill="#B0B5C3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Gửi file" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Gửi tin nhắn -->
                        <Button Background="Transparent" Foreground="#B0B5C3" Padding="0,10"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,6"
                                BorderBrush="#454A56" BorderThickness="1.5"
                                Template="{StaticResource DarkBtn}" Click="SendMessage_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomChat}" Fill="#B0B5C3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Gửi tin nhắn" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. Chẩn đoán mạng LAN -->
                        <Button Background="Transparent" Foreground="#B0B5C3" Padding="0,10"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,6"
                                BorderBrush="#454A56" BorderThickness="1.5"
                                Template="{StaticResource DarkBtn}" Click="NetworkDiag_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomInfo}" Fill="#B0B5C3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chẩn đoán mạng LAN" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Grid.Row="2" Height="1" Background="#363942" Margin="0,8,0,10"/>

                    <!-- ── ACTIVITY LOG ── -->
                    <StackPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeomInfo}" Fill="#8E93A0" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nhật ký hoạt động" FontSize="13" FontWeight="Bold"
                                       Foreground="#8E93A0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="activityLog">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" CornerRadius="6" Padding="8,6"
                                                Background="{Binding LogBg}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Time}" DockPanel.Dock="Right"
                                                               FontSize="10" Foreground="#6B7080" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding LogFg}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="#8E93A0" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ BOTTOM STATUS BAR ═══ -->
        <Border Grid.Row="1" Background="#20252A" CornerRadius="8" Padding="16,8" Margin="0,8,0,0">
            <DockPanel>
                <!-- Right: grid size selector -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Display mode: connected only vs all class -->
                    <ComboBox x:Name="cmbDisplayMode" Width="115" Height="40" Padding="8,4" FontSize="12" Foreground="White"
                              Background="#2D3038" BorderBrush="#454A56" VerticalContentAlignment="Center"
                              SelectionChanged="DisplayMode_Changed" SelectedIndex="1">
                        <ComboBoxItem Content="Máy kết nối"/>
                        <ComboBoxItem Content="Cả lớp"/>
                    </ComboBox>
                    <ComboBox x:Name="cmbFilter" Width="100" Height="40" Padding="8,4" FontSize="12" Margin="6,0,0,0" Foreground="White"
                              Background="#2D3038" BorderBrush="#454A56" VerticalContentAlignment="Center"
                              SelectionChanged="Filter_Changed" SelectedIndex="0">
                        <ComboBoxItem Content="Tất cả"/>
                        <ComboBoxItem Content="Online"/>
                        <ComboBoxItem Content="Offline"/>
                        <ComboBoxItem Content="Cảnh báo"/>
                    </ComboBox>
                    <ComboBox x:Name="cmbGrid" Width="55" Height="40" Padding="8,4" FontSize="12" Margin="6,0,0,0" Foreground="White"
                              Background="#2D3038" BorderBrush="#454A56" VerticalContentAlignment="Center"
                              SelectionChanged="GridSize_Changed" SelectedIndex="2">
                        <ComboBoxItem Content="3×3"/>
                        <ComboBoxItem Content="4×4"/>
                        <ComboBoxItem Content="5×5"/>
                        <ComboBoxItem Content="6×6"/>
                    </ComboBox>
                    <Border CornerRadius="6" Height="40" Padding="10,4" Margin="6,0,0,0" Cursor="Hand"
                            Background="#2D3038" MouseLeftButtonDown="ToggleAutoRefresh_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeomRefresh}" Fill="#4CAF50" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtRefreshStatus" Text="Tự động: 5s"
                                       FontSize="12" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left: status info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtMonitorCount" Text="0/0 trực tuyến"
                               FontSize="13" Foreground="#4CAF50" FontWeight="Bold"/>
                    <TextBlock Text="  |  " FontSize="13" Foreground="#454A56"/>
                    <TextBlock x:Name="txtAlertCount" Text="0 cảnh báo"
                               FontSize="13" Foreground="#FF9800" FontWeight="Bold"/>
                    <TextBlock Text="  |  " FontSize="13" Foreground="#454A56"/>
                    <TextBlock Text="CPU trung bình: " FontSize="13" Foreground="#6B7080" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtCpuAvg" Text="—%" FontSize="13"
                               Foreground="#B0B5C3" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBlock Text="  |  " FontSize="13" Foreground="#454A56"/>
                    <Border CornerRadius="6" Height="40" Padding="10,4" Margin="6,0,0,0" Cursor="Hand"
                            Background="#2D3038" MouseLeftButtonDown="TogglePrivacyMode_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="pathPrivacy" Data="{StaticResource GeomUnlock}" Fill="#B0B5C3" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtPrivacyStatus" Text="Riêng tư: TẮT"
                                       FontSize="12" Foreground="#B0B5C3" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
