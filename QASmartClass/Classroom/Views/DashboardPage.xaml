<Page x:Class="QASmartClass.Classroom.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Teacher Dashboard" Background="#F0F2F5">
    
    <Page.Resources>
        <!-- Glassmorphism Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="20" ShadowDepth="4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- KPI Cards -->
                <RowDefinition Height="Auto"/> <!-- Tiến trình tiết học (NEW) -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🚀 Bảng Thống Kê Lớp Học" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="txtSubtitle" Text="Tổng quan tình hình học tập và điểm danh của lớp" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 Cập nhật dữ liệu" Padding="16,8" FontSize="13" FontWeight="SemiBold"
                            Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Refresh_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- KPI Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sĩ số -->
                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="16" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#2563EB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Sĩ số lớp" FontSize="14" Foreground="#DBEAFE" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtTotalStudents" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tỷ lệ đi học -->
                <Border Grid.Column="1" Margin="8,0,8,0" CornerRadius="16" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Tỷ lệ chuyên cần" FontSize="14" Foreground="#D1FAE5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtAttendanceRate" Text="0%" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Điểm trung bình -->
                <Border Grid.Column="2" Margin="8,0,8,0" CornerRadius="16" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B5CF6" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Điểm trung bình (GPA)" FontSize="14" Foreground="#EDE9FE" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtAvgScore" Text="0.0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Cảnh báo -->
                <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="16" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F43F5E" Offset="0"/>
                            <GradientStop Color="#E11D48" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Cần lưu ý (Học sinh)" FontSize="14" Foreground="#FFE4E6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtWarnings" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ TIẾN TRÌNH TIẾT HỌC CHUẨN ═══ -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,24" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="📖 TIẾN TRÌNH TIẾT HỌC CHUẨN (Quy chuẩn của Bộ GD&amp;ĐT)" FontSize="15" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/> <!-- B1 -->
                            <ColumnDefinition Width="Auto"/> <!-- Mũi tên -->
                            <ColumnDefinition Width="*"/> <!-- B2 -->
                            <ColumnDefinition Width="Auto"/> <!-- Mũi tên -->
                            <ColumnDefinition Width="*"/> <!-- B3 -->
                            <ColumnDefinition Width="Auto"/> <!-- Mũi tên -->
                            <ColumnDefinition Width="*"/> <!-- B4 -->
                            <ColumnDefinition Width="Auto"/> <!-- Mũi tên -->
                            <ColumnDefinition Width="*"/> <!-- B5 -->
                            <ColumnDefinition Width="Auto"/> <!-- Mũi tên -->
                            <ColumnDefinition Width="*"/> <!-- B6 -->
                        </Grid.ColumnDefinitions>

                        <!-- Bước 1: Chọn lớp -->
                        <Button Grid.Column="0" Click="Step1_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="borderStep1" Background="#F8FAFC" CornerRadius="8" Padding="10,8" BorderThickness="1" BorderBrush="#E2E8F0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtStep1Title" Text="Bước 1" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtStep1Desc" Text="📋 Chọn lớp học" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Grid.Column="1" Text="➔" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Bước 2: Điểm danh -->
                        <Button Grid.Column="2" Click="Step2_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="borderStep2" Background="#F8FAFC" CornerRadius="8" Padding="10,8" BorderThickness="1" BorderBrush="#E2E8F0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtStep2Title" Text="Bước 2" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtStep2Desc" Text="👥 Điểm danh" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Grid.Column="3" Text="➔" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Bước 3: Khởi động -->
                        <Button Grid.Column="4" Click="Step3_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="borderStep3" Background="#F8FAFC" CornerRadius="8" Padding="10,8" BorderThickness="1" BorderBrush="#E2E8F0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtStep3Title" Text="Bước 3" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtStep3Desc" Text="⚡ Khởi động" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Grid.Column="5" Text="➔" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Bước 4: Giảng dạy -->
                        <Button Grid.Column="6" Click="Step4_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="borderStep4" Background="#F8FAFC" CornerRadius="8" Padding="10,8" BorderThickness="1" BorderBrush="#E2E8F0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtStep4Title" Text="Bước 4" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtStep4Desc" Text="🖥️ Tiến trình dạy" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Grid.Column="7" Text="➔" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Bước 5: Luyện tập -->
                        <Button Grid.Column="8" Click="Step5_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="borderStep5" Background="#F8FAFC" CornerRadius="8" Padding="10,8" BorderThickness="1" BorderBrush="#E2E8F0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtStep5Title" Text="Bước 5" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtStep5Desc" Text="🏆 Luyện tập/Quiz" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Grid.Column="9" Text="➔" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Bước 6: Giao bài tập -->
                        <Button Grid.Column="10" Click="Step6_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="borderStep6" Background="#F8FAFC" CornerRadius="8" Padding="10,8" BorderThickness="1" BorderBrush="#E2E8F0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtStep6Title" Text="Bước 6" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtStep6Desc" Text="📝 Giao bài tập" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <!-- Bảng xếp hạng -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="🏆 Bảng Xếp Hạng Điểm Số (Top 5)" FontSize="18" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,16"/>
                            <ItemsControl x:Name="listTopStudents">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <!-- Hạng -->
                                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="#E2E8F0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Điểm -->
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Score}" FontWeight="Bold" FontSize="18" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                                <!-- Tên -->
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                    <!-- Vắng nhiều -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="⚠️ Học Sinh Vắng/Trễ Nhiều" FontSize="18" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,16"/>
                            <ItemsControl x:Name="listAbsences">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF1F2" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding AbsenceCount}" FontWeight="Bold" FontSize="16" Foreground="#E11D48" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#881337" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="txtNoAbsences" Text="Không có học sinh nào vắng quá 2 buổi." FontSize="14" Foreground="#10B981" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sidebar Tóm tắt -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="📈 Phân Phối Điểm Số" FontSize="18" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,24"/>
                            
                            <!-- Giỏi -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Giỏi (8-10)" Width="80" Foreground="#64748B"/>
                                <TextBlock x:Name="txtGioi" DockPanel.Dock="Right" Text="0" FontWeight="Bold" Foreground="#10B981"/>
                                <ProgressBar x:Name="barGioi" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#10B981" Background="#E2E8F0" Margin="8,0,16,0" BorderThickness="0"/>
                            </DockPanel>
                            
                            <!-- Khá -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Khá (6.5-8)" Width="80" Foreground="#64748B"/>
                                <TextBlock x:Name="txtKha" DockPanel.Dock="Right" Text="0" FontWeight="Bold" Foreground="#3B82F6"/>
                                <ProgressBar x:Name="barKha" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#3B82F6" Background="#E2E8F0" Margin="8,0,16,0" BorderThickness="0"/>
                            </DockPanel>
                            
                            <!-- TB -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="TB (5-6.5)" Width="80" Foreground="#64748B"/>
                                <TextBlock x:Name="txtTB" DockPanel.Dock="Right" Text="0" FontWeight="Bold" Foreground="#F59E0B"/>
                                <ProgressBar x:Name="barTB" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#F59E0B" Background="#E2E8F0" Margin="8,0,16,0" BorderThickness="0"/>
                            </DockPanel>
                            
                            <!-- Yếu -->
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Yếu (&lt;5)" Width="80" Foreground="#64748B"/>
                                <TextBlock x:Name="txtYeu" DockPanel.Dock="Right" Text="0" FontWeight="Bold" Foreground="#EF4444"/>
                                <ProgressBar x:Name="barYeu" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#EF4444" Background="#E2E8F0" Margin="8,0,16,0" BorderThickness="0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
