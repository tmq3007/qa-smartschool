<Page x:Class="QASmartClass.Classroom.Views.NetworkDiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:QASmartClass.Classroom.Views"
      mc:Ignorable="d"
      Title="Chẩn đoán Mạng"
      Background="#F8FAFC"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Custom button template -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="border" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" 
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Page.Resources>

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" x:Name="btnBack" 
                        Content="🡰 Quay lại" 
                        Click="btnBack_Click"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1"
                        Padding="16,8" FontSize="13" FontWeight="SemiBold"
                        Template="{StaticResource RoundedButtonTemplate}" Cursor="Hand"/>

                <Button DockPanel.Dock="Right" x:Name="btnRunDiag" 
                        Content="🔄 Chạy Chẩn đoán lại" 
                        Click="btnRunDiag_Click"
                        Background="#1976D2" Foreground="White" BorderThickness="0"
                        Padding="16,8" FontSize="13" FontWeight="SemiBold"
                        Template="{StaticResource RoundedButtonTemplate}" Cursor="Hand" Margin="10,0,0,0"/>

                <TextBlock Text="🔧 Chẩn đoán &amp; Giám sát Mạng LAN lớp học" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
            </DockPanel>
        </Border>

        <!-- Main Body (MaxWidth restricted to 1200 as per QC_4.2_LAYOUT_GRID) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <Grid MaxWidth="1200" HorizontalAlignment="Center" Width="1160">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Network Overview Summary Cards -->
                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,20">
                    <!-- Avg Latency Card -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Trễ Mạng Trung Bình" FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock x:Name="txtAvgLatency" Text="— ms" FontSize="28" FontWeight="Bold" Foreground="#1E293B" Margin="0,6,0,2"/>
                            <TextBlock x:Name="txtLatencyStatus" Text="Chưa kiểm tra" FontSize="11.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Packet Loss Card -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Tỷ Lệ Mất Gói Tin" FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock x:Name="txtPacketLoss" Text="— %" FontSize="28" FontWeight="Bold" Foreground="#1E293B" Margin="0,6,0,2"/>
                            <TextBlock x:Name="txtLossStatus" Text="Chưa kiểm tra" FontSize="11.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Connection Quality Card -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Chất Lượng Truyền Phát VNC" FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock x:Name="txtVncQuality" Text="Chưa xác định" FontSize="20" FontWeight="Bold" Foreground="#64748B" Margin="0,14,0,2"/>
                            <TextBlock x:Name="txtVncStatusDetails" Text="Hệ thống tự động điều chỉnh cấu hình" FontSize="11.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Progress / Status Section -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="txtProgressLabel" Text="Sẵn sàng chạy chẩn đoán mạng." VerticalAlignment="Center" FontSize="13.5" Foreground="#475569" FontWeight="Medium"/>
                        <ProgressBar Grid.Column="1" x:Name="progressBar" Height="8" Margin="20,0" Foreground="#1976D2" IsIndeterminate="False" Value="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="txtProgressPercent" Text="0%" VerticalAlignment="Center" FontSize="13.5" Foreground="#475569" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- Student List ListView -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="16,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mã học sinh" FontWeight="Bold" Foreground="#475569" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" Text="Họ và tên" FontWeight="Bold" Foreground="#475569" FontSize="12.5"/>
                                <TextBlock Grid.Column="2" Text="Địa chỉ IP" FontWeight="Bold" Foreground="#475569" FontSize="12.5"/>
                                <TextBlock Grid.Column="3" Text="Độ trễ (Ping)" FontWeight="Bold" Foreground="#475569" FontSize="12.5"/>
                                <TextBlock Grid.Column="4" Text="Mất gói" FontWeight="Bold" Foreground="#475569" FontSize="12.5"/>
                                <TextBlock Grid.Column="5" Text="Đánh giá chất lượng" FontWeight="Bold" Foreground="#475569" FontSize="12.5"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="lvDiagResults" BorderThickness="0" Background="Transparent" AlternationCount="2">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding StudentCode}" Foreground="#475569" FontSize="13.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#1E293B" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding IPAddress}" Foreground="#64748B" FontSize="13.5" VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="3" Text="{Binding LatencyDisplay}" FontSize="13.5" VerticalAlignment="Center" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvgLatency, Converter={StaticResource LatencyColorConverter}}" Value="High">
                                                                <Setter Property="Foreground" Value="#EF5350"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Grid.Column="4" Text="{Binding LossDisplay}" FontSize="13.5" VerticalAlignment="Center" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PacketLoss, Converter={StaticResource LossColorConverter}}" Value="High">
                                                                <Setter Property="Foreground" Value="#EF5350"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Grid.Column="5" HorizontalAlignment="Left" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Evaluation}" Value="🟢 Tốt">
                                                                <Setter Property="Background" Value="#E2F0D9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Evaluation}" Value="🟡 Chậm">
                                                                <Setter Property="Background" Value="#FFF2CC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Evaluation}" Value="🔴 Mất kết nối">
                                                                <Setter Property="Background" Value="#FCE4D6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Evaluation}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Evaluation}" Value="🟢 Tốt">
                                                                    <Setter Property="Foreground" Value="#385723"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Evaluation}" Value="🟡 Chậm">
                                                                    <Setter Property="Foreground" Value="#7F6000"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Evaluation}" Value="🔴 Mất kết nối">
                                                                    <Setter Property="Foreground" Value="#C00000"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
