<Page x:Class="QASmartClass.Classroom.Views.RemoteControlPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Điều khiển từ xa" Background="#FAFAFA"

      Unloaded="Page_Unloaded">

    <Grid Margin="20,14">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="220"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- ═══ LEFT: Student List ═══ -->

        <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E0E0E0"

                BorderThickness="1" Margin="0,0,12,0">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">

                    <TextBlock Text="👥 Học sinh" FontSize="13" FontWeight="SemiBold" Foreground="#212121"/>

                </Border>

                <ListBox x:Name="studentList" Grid.Row="1" BorderThickness="0" Background="Transparent"

                         Padding="6" SelectionChanged="Student_Selected">

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Padding" Value="8,6"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"

                                                Padding="{TemplateBinding Padding}">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>

                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">

                                                <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">

                                    <Ellipse.Style>

                                        <Style TargetType="Ellipse">

                                            <Setter Property="Fill" Value="#9E9E9E"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">

                                                    <Setter Property="Fill" Value="#4CAF50"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Ellipse.Style>

                                </Ellipse>

                                <StackPanel>

                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#212121"/>

                                    <TextBlock Text="{Binding PCName}" FontSize="10" Foreground="#9E9E9E"/>

                                </StackPanel>

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>



        <!-- ═══ RIGHT: Viewer + Controls ═══ -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <!-- Header bar -->

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"

                    BorderBrush="#E0E0E0" BorderThickness="1">

                <DockPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                        <Border x:Name="badgeMouse" Background="#E0E0E0" CornerRadius="6" Padding="8,3"

                                Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="ToggleMouse_Click">

                            <TextBlock x:Name="txtMouseBadge" Text="🖱️ Chuột: TẮT" FontSize="10" Foreground="#999" FontWeight="SemiBold"/>

                        </Border>

                        <Border x:Name="badgeKeyboard" Background="#E0E0E0" CornerRadius="6" Padding="8,3"

                                Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="ToggleKeyboard_Click">

                            <TextBlock x:Name="txtKeyBadge" Text="⌨️ Phím: TẮT" FontSize="10" Foreground="#999" FontWeight="SemiBold"/>

                        </Border>

                        <Border x:Name="liveBadge" Background="#F44336" CornerRadius="6" Padding="8,3"

                                Visibility="Collapsed" Margin="0,0,8,0">

                            <TextBlock Text="● LIVE" FontSize="10" Foreground="White" FontWeight="Bold"/>

                        </Border>

                        <TextBlock x:Name="txtRefreshInfo" Text="" FontSize="10" Foreground="#999"

                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel>

                        <TextBlock x:Name="txtViewerStatus" Text="← Chọn học sinh để xem màn hình"

                                   FontSize="14" FontWeight="SemiBold" Foreground="#212121"/>

                        <TextBlock x:Name="txtViewerInfo" Text="" FontSize="11" Foreground="#757575" Margin="0,2,0,0"/>

                    </StackPanel>

                </DockPanel>

            </Border>



            <!-- Screen Preview -->

            <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="12" Margin="0,0,0,8" ClipToBounds="True">

                <Grid>

                    <!-- Placeholder -->

                    <StackPanel x:Name="placeholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <TextBlock Text="🖥️" FontSize="64" HorizontalAlignment="Center" Opacity="0.2"

                                   Foreground="White" FontFamily="Segoe UI Emoji"/>

                        <TextBlock Text="Chọn học sinh để xem màn hình" FontSize="14" Foreground="#777"

                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>

                        <TextBlock Text="💡 Bước 1: Nhấn nút [Học sinh] trên thanh header" FontSize="11" Foreground="#555"

                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>

                        <TextBlock Text="💡 Bước 2: Chọn HS trong danh sách bên trái" FontSize="11" Foreground="#555"

                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    </StackPanel>



                    <!-- Screen Image (interactive for remote control) -->

                    <Image x:Name="screenImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"

                           Visibility="Collapsed" Cursor="Arrow"

                           MouseLeftButtonDown="ScreenImage_MouseLeftDown"

                           MouseRightButtonDown="ScreenImage_MouseRightDown"

                           MouseMove="ScreenImage_MouseMove"/>



                    <!-- Remote control indicator -->

                    <Border x:Name="remoteIndicator" HorizontalAlignment="Left" VerticalAlignment="Bottom"

                            Margin="12,0,0,12" Background="#80000000" CornerRadius="6" Padding="8,4"

                            Visibility="Collapsed">

                        <TextBlock x:Name="txtRemoteMode" Text="" FontSize="10" Foreground="#4CAF50"/>

                    </Border>

                </Grid>

            </Border>



            <!-- Action Controls Row 1 -->

            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10,6" Margin="0,0,0,4"

                    BorderBrush="#E0E0E0" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="🛡️ Hành động" FontSize="10" Foreground="#999" Margin="0,0,0,4"/>

                    <UniformGrid Columns="5">

                        <Button Content="📸 Chụp màn" Tag="screenshot" Margin="0,0,4,0" Padding="0,8"

                                Background="#F3E5F5" Foreground="#7B1FA2" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="🔒 Khóa" Tag="lock" Margin="0,0,4,0" Padding="0,8"

                                Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="🔇 IM LẶNG" Tag="silence" Margin="0,0,4,0" Padding="0,8"

                                Background="#212121" Foreground="White" BorderThickness="0" Cursor="Hand"

                                FontSize="11" FontWeight="Bold" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="🚫 Tắt app" Tag="killapps" Margin="0,0,4,0" Padding="0,8"

                                Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="⚠️ Cảnh báo" Tag="warning" Padding="0,8"

                                Background="#FFF3E0" Foreground="#E65100" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                    </UniformGrid>

                </StackPanel>

            </Border>



            <!-- Reverse Controls Row 2 -->

            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="10,6"

                    BorderBrush="#E0E0E0" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="✅ Gỡ bỏ" FontSize="10" Foreground="#2E7D32" Margin="0,0,0,4"/>

                    <UniformGrid Columns="5">

                        <Button Content="🔓 Mở khóa" Tag="unlock" Margin="0,0,4,0" Padding="0,8"

                                Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="🔊 Mở IM LẶNG" Tag="clearsilence" Margin="0,0,4,0" Padding="0,8"

                                Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="✅ Tắt cảnh báo" Tag="clearwarning" Margin="0,0,4,0" Padding="0,8"

                                Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="🔄 Gỡ tất cả" Tag="clearall" Margin="0,0,4,0" Padding="0,8"

                                Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                        <Button Content="❌ Ngắt" Tag="disconnect" Padding="0,8"

                                Background="#F5F5F5" Foreground="#666" BorderThickness="0" Cursor="Hand"

                                FontSize="11" Click="RemoteCmd_Click">

                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>

                        </Button>

                    </UniformGrid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>

