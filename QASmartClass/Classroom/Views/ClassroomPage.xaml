<Page x:Class="QASmartClass.Classroom.Views.ClassroomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Lớp học" Background="#FAFAFA" FontFamily="Segoe UI, Inter">
    
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- SVG Path Geometries (Biểu tượng vector chuyên nghiệp) -->
        <!-- Icon 🖥️ Máy tính -->
        <Geometry x:Key="GeomComputer">M21,2H3C1.9,2 1,2.9 1,4v12c0,1.1 0.9,2 2,2h7v2H8v2h8v-2h-2v-2h7c1.1,0 2-0.9 2-2V4C23,2.9 22.1,2 21,2z M21,14H3V4h18V14z</Geometry>
        <!-- Icon 🔒 Khóa -->
        <Geometry x:Key="GeomLock">M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24 7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1 0.9,2 2,2h12c1.1,0 2-0.9 2-2V10C20,8.9 19.1,8 18,8z M9,6c0-1.66 1.34-3 3-3s3,1.34 3,3v2H9V6z M12,17c-1.1,0-2-0.9-2-2s0.9-2 2-2s2,0.9 2,2S13.1,17 12,17z</Geometry>
        <!-- Icon 🔓 Mở khóa -->
        <Geometry x:Key="GeomUnlock">M12,2c-2.76,0-5,2.24-5,5v2h2V7c0-1.66,1.34-3,3-3s3,1.34,3,3v2h2V7C17,4.24,14.76,2,12,2z M18,8H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,8.9,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S13.1,17,12,17z</Geometry>
        <!-- Icon 📺 Quảng bá màn hình -->
        <Geometry x:Key="GeomBroadcast">M21,3H3C1.89,3,1,3.89,1,5v12c0,1.1,0.89,2,2,2h5v2h8v-2h5c1.1,0,2-0.9,2-2V5C23,3.89,22.1,3,21,3z M21,17H3V5h18V17z</Geometry>
        <!-- Icon 💬 Tin nhắn -->
        <Geometry x:Key="GeomChat">M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M20,14H6l-2,2V4h16V14z</Geometry>
        <!-- Icon 📁 Phát bài -->
        <Geometry x:Key="GeomFile">M10,4H4c-1.1,0-1.99,0.9-1.99,2L2,18c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8l-2-2z</Geometry>
        <!-- Icon 🏆 Quiz nhanh (Cúp vàng) -->
        <Geometry x:Key="GeomQuiz">M19,5h-2V3H7v2H5C3.9,5,3,5.9,3,7v1c0,2.55,1.92,4.63,4.39,4.94c0.63,1.5,1.98,2.63,3.61,2.94V19H7v2h10v-2h-4v-3.12c1.63-0.31,2.98-1.44,3.61-2.94C19.08,12.63,21,10.55,21,8V7C21,5.9,20.1,5,19,5z M5,8V7h2v3.82C5.84,10.4,5,9.3,5,8z M19,8c0,1.3-0.84,2.4-2,2.82V7h2V8z</Geometry>
        <!-- Icon 🔇 Im lặng -->
        <Geometry x:Key="GeomMute">M16.5,12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45,2.45C16.42,12.43,16.5,12.23,16.5,12z M19,12c0,0.94-0.2,1.82-0.54,2.64l1.51,1.51C20.63,14.91,21,13.5,21,12c0-4.28-2.99-7.86-7-8.77v2.06C17.55,6.2,20,8.82,20,12z M4.27,3L3,4.27 7.73,9H3v6h4l5,5v-6.73l4.25,4.25C15.67,17.92,14.9,18.27,14,18.41v2.04c1.45-0.2,2.77-0.78,3.87-1.63l2.86,2.86L22,20.73 4.27,3z M12,4L9.91,6.09 12,8.18V4z</Geometry>
        <!-- Icon Play (Bắt đầu) -->
        <Geometry x:Key="GeomPlay">M8,5v14l11-7z</Geometry>
        <!-- Icon Stop (Kết thúc) -->
        <Geometry x:Key="GeomStop">M6,6h12v12H6z</Geometry>
        <!-- Icon 🛡️ Khiên bảo mật -->
        <Geometry x:Key="GeomShield">M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z</Geometry>
    </Page.Resources>
    
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Banner cảnh báo mạng LAN -->
            <RowDefinition Height="Auto"/> <!-- Session bar -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Chỉ dẫn sử dụng (Help Banner) -->
            <RowDefinition Height="*"/>    <!-- Student Grid -->
        </Grid.RowDefinitions>

        <!-- Banner cảnh báo lỗi kết nối mạng LAN (Ấn mặc định, hiển thị động khi IP Loopback) -->
        <Border x:Name="bannerNetworkWarning" Grid.Row="0" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
            <DockPanel>
                <TextBlock Text="⚠️ Cảnh báo kết nối:" FontSize="14" FontWeight="Bold" Foreground="#E65100" Margin="0,0,12,0" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtWarningMessage" Text="Không phát hiện kết nối mạng LAN cục bộ. Vui lòng kết nối cáp mạng hoặc mạng Wi-Fi của phòng học để các máy trạm tìm thấy lớp!" FontSize="13" FontWeight="SemiBold" Foreground="#D84315" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Session bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnStartSession" Content="Bắt đầu lớp" FontSize="14" FontWeight="Bold" Padding="20,10" Tag="{StaticResource GeomPlay}"
                            Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" Click="StartSession_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                        </Viewbox>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️ Lớp học:" FontSize="18" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock x:Name="txtSessionName" Text=" Chưa chọn lớp" FontSize="18" Foreground="#1976D2" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="txtSessionCode" Text="Mã lớp: --" FontSize="13" FontWeight="Medium" Foreground="#757575" Margin="0,0,16,0"/>
                        <TextBlock x:Name="txtSessionIP" Text="IP: --" FontSize="13" FontWeight="Medium" Foreground="#757575" Margin="0,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="#BDBDBD" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txtOnlineCount" Text="0/0 Học sinh trực tuyến" FontSize="13" Foreground="#4CAF50" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar (Đồ họa Vector cao cấp thay thế Emoji, tối ưu tương tác cảm ứng) -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
            <WrapPanel Margin="0,0,0,-8">
                <!-- Nút Quảng bá MH -->
                <Button Margin="0,0,8,8" Padding="14,10" FontSize="13" FontWeight="SemiBold" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Cursor="Hand" Click="Broadcast_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomBroadcast}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#BBDEFB"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Quảng bá màn hình
                </Button>

                <!-- Nút Khóa tất cả -->
                <Button Margin="0,0,8,8" Padding="14,10" FontSize="13" FontWeight="SemiBold" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Cursor="Hand" Click="LockAll_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomLock}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFCDD2"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Khóa tất cả
                </Button>

                <!-- Nút Mở khóa -->
                <Button Margin="0,0,8,8" Padding="14,10" FontSize="13" FontWeight="SemiBold" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand" Click="UnlockAll_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomUnlock}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C8E6C9"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Mở khóa
                </Button>

                <!-- Nút Phát bài -->
                <Button Margin="0,0,8,8" Padding="14,10" FontSize="13" FontWeight="SemiBold" Background="#FFF3E0" Foreground="#E65100" BorderThickness="0" Cursor="Hand" Click="SendFile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomFile}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFE0B2"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Phát bài
                </Button>

                <!-- Nút Tin nhắn -->
                <Button Margin="0,0,8,8" Padding="14,10" FontSize="13" FontWeight="SemiBold" Background="#F3E5F5" Foreground="#7B1FA2" BorderThickness="0" Cursor="Hand" Click="Chat_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomChat}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E1BEE7"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Tin nhắn
                </Button>

                <!-- Nút Quiz nhanh -->
                <Button Margin="0,0,8,8" Padding="14,10" FontSize="13" FontWeight="SemiBold" Background="#E0F2F1" Foreground="#00695C" BorderThickness="0" Cursor="Hand" Click="StartQuiz_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomQuiz}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#B2DFDB"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Quiz nhanh
                </Button>

                <!-- Nút Im lặng -->
                <Button x:Name="btnMute" Margin="0,0,8,8" Padding="14,10" FontSize="13" FontWeight="SemiBold" Background="#ECEFF1" Foreground="#546E7A" BorderThickness="0" Cursor="Hand" Click="Mute_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomMute}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"/>
                                    </Viewbox>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#CFD8DC"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    Im lặng
                </Button>
            </WrapPanel>
        </Border>

        <!-- Chỉ dẫn sử dụng (Help Banner) -->
        <Border Grid.Row="3" Background="#E3F2FD" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="#BBDEFB" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💡 Chỉ dẫn sư phạm:" FontSize="12" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,8,0"/>
                <TextBlock Text="Nhấp chuột vào học sinh bất kỳ để chuyển sang màn hình giám sát máy trạm chi tiết." FontSize="12" Foreground="#1565C0"/>
            </StackPanel>
        </Border>

        <!-- Student Grid (Tự co giãn chiều ngang nhờ WrapPanel, thẻ học sinh to rõ và click được) -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="studentGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="4" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="160" Height="140" Margin="6" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Background="White" Cursor="Hand" MouseLeftButtonDown="StudentCard_Click">
                            <Border.ContextMenu>
                                <ContextMenu Opened="ContextMenu_Opened">
                                    <MenuItem Header="🖐️ Hạ tay học sinh" Click="LowerStudentHand_Click"/>
                                    <MenuItem Header="🖐️ Hạ tay toàn lớp" Click="LowerAllHands_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🛡️ Chẩn đoán lỗi trạm từ xa" Click="DiagnoseStudent_Click"/>
                                    <MenuItem Header="🔄 Khôi phục cài đặt gốc" Click="RestoreStudent_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#2196F3"/>
                                            <Setter Property="Background" Value="#F9FBFC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <Border Height="80" CornerRadius="6" Background="#F5F5F5" Margin="0,0,0,8">
                                        <Grid>
                                            <!-- Máy tính dạng Vector thay thế Emoji -->
                                            <Viewbox Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeomComputer}" Fill="#BDBDBD" Stretch="Uniform"/>
                                            </Viewbox>
                                            <!-- Shield Indicator -->
                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0">
                                                <Path Data="{StaticResource GeomShield}" Stretch="Uniform" ToolTip="{Binding ShieldTooltip}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="#BDBDBD"/> <!-- Unknown - Xám -->
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShieldStatus}" Value="OK">
                                                                    <Setter Property="Fill" Value="#4CAF50"/> <!-- OK - Xanh lá -->
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ShieldStatus}" Value="WARNING">
                                                                    <Setter Property="Fill" Value="#FFC107"/> <!-- Warning - Vàng -->
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ShieldStatus}" Value="CORRUPTED">
                                                                    <Setter Property="Fill" Value="#F44336"/> <!-- Corrupted - Đỏ -->
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Viewbox>
                                            <!-- Biểu tượng khóa lớn mờ đè lên màn hình khi bị khóa -->
                                            <Border Background="#A0000000" CornerRadius="6" Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                                <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeomLock}" Fill="White" Stretch="Uniform"/>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- LED trạng thái kết nối sử dụng DataTrigger -->
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#BDBDBD"/> <!-- Mặc định xám (Offline) -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="#4CAF50"/> <!-- Xanh lá (Online) -->
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#212121" TextTrimming="CharacterEllipsis" Width="108" VerticalAlignment="Center"/>
                                        <!-- Icon khóa nhỏ bên cạnh tên dạng Vector -->
                                        <Viewbox Width="12" Height="12" Margin="2,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                            <Path Data="{StaticResource GeomLock}" Fill="#C62828" Stretch="Uniform"/>
                                        </Viewbox>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PCName}" FontSize="11" Foreground="#757575" Margin="16,2,0,0"/>
                                </StackPanel>

                                <!-- Indicator Giơ tay (✋) nhấp nháy góc trên bên phải -->
                                <Border x:Name="handRaiseIndicator" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Background="#FF9800" Width="26" Height="26" CornerRadius="13" 
                                        Margin="0,4,4,0" BorderBrush="White" BorderThickness="1.5"
                                        ToolTip="Đang giơ tay phát biểu">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHandRaised}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="BlinkStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.2" Duration="0:0:0.6"
                                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="✋" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
