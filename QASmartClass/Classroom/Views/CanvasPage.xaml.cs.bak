        // ═══════════════════════════════════════════════════════════
        //  LESSON LOADING (preserved from original)
        // ═══════════════════════════════════════════════════════════

        private void LoadLessonOnCanvas(int lessonId)
        {
            try
            {
                var app = (QASmartTouch.App)Application.Current;
                var lesson = app.Database.Lessons.Find(lessonId);
                if (lesson == null) return;

                var contents = app.Database.LessonContents
                    .Where(c => c.LessonId == lessonId)
                    .OrderBy(c => c.SortOrder)
                    .ToList();

                if (!contents.Any()) return;

                lessonOverlay.Visibility = Visibility.Visible;
                lessonOverlay.Children.Clear();

                var titleBar = new Border
                {
                    Background = new SolidColorBrush(Color.FromArgb(230, 25, 118, 210)),
                    CornerRadius = new CornerRadius(0, 0, 8, 8),
                    Padding = new Thickness(20, 12, 20, 12),
                    Margin = new Thickness(0, 0, 0, 8)
                };
                var titleStack = new StackPanel();
                titleStack.Children.Add(new TextBlock
                {
                    Text = $"📖 {lesson.Title}", FontSize = 22, FontWeight = FontWeights.Bold,
                    Foreground = Brushes.White, TextWrapping = TextWrapping.Wrap
                });
                titleStack.Children.Add(new TextBlock
                {
                    Text = $"{lesson.Subject} — {lesson.Grade} | {contents.Count} phần",
                    FontSize = 13, Foreground = new SolidColorBrush(Color.FromRgb(187, 222, 251)), Margin = new Thickness(0, 2, 0, 0)
                });
                titleBar.Child = titleStack;
                lessonOverlay.Children.Add(titleBar);

                _totalBlocks = contents.Count;
                for (int i = 0; i < contents.Count; i++)
                {
                    var block = contents[i];
                    var text = block.Data.Replace("\\n", "\n");
                    var blockBorder = new Border
                    {
                        Tag = i,
                        Background = new SolidColorBrush(Color.FromArgb(240, 255, 255, 255)),
                        CornerRadius = new CornerRadius(8),
                        Padding = new Thickness(18, 14, 18, 14),
                        Margin = new Thickness(8, 0, 8, 8),
                        BorderBrush = Brushes.Transparent,
                        BorderThickness = new Thickness(2)
                    };
                    blockBorder.MouseLeftButtonDown += BlockBorder_Click;
                    blockBorder.Cursor = Cursors.Hand;
                    blockBorder.Child = BuildCanvasRichText(text);
                    lessonOverlay.Children.Add(blockBorder);
                }

                blockNav.Visibility = Visibility.Visible;
                _currentBlockIndex = 0;
                UpdateBlockNav();
                Log.Information("Lesson loaded on canvas: {Title}, {Blocks} blocks", lesson.Title, contents.Count);
            }
            catch (Exception ex) { Log.Warning("LoadLessonOnCanvas error: {Error}", ex.Message); }
        }

        // ═══════════════════════════════════════════════════════════
        //  BLOCK NAVIGATION
        // ═══════════════════════════════════════════════════════════

        private void PrevBlock_Click(object sender, MouseButtonEventArgs e)
        {
            if (_currentBlockIndex > 0) { _currentBlockIndex--; ScrollToBlock(_currentBlockIndex); UpdateBlockNav(); }
        }

        private void NextBlock_Click(object sender, MouseButtonEventArgs e)
        {
            if (_currentBlockIndex < _totalBlocks - 1) { _currentBlockIndex++; ScrollToBlock(_currentBlockIndex); UpdateBlockNav(); }
        }

        private void ScrollToBlock(int index)
        {
            if (index + 1 < lessonOverlay.Children.Count && lessonOverlay.Children[index + 1] is FrameworkElement fe)
            {
                for (int i = 1; i < lessonOverlay.Children.Count; i++)
                {
                    if (lessonOverlay.Children[i] is Border bd)
                        bd.BorderBrush = i == index + 1 ? new SolidColorBrush(Color.FromRgb(25, 118, 210)) : Brushes.Transparent;
                }
                fe.BringIntoView();
            }
        }

        private void UpdateBlockNav() => txtBlockNav.Text = $"{_currentBlockIndex + 1}/{_totalBlocks}";

        private void BlockBorder_Click(object sender, MouseButtonEventArgs e)
        {
            if (sender is Border bd && bd.Tag is int index)
            { _currentBlockIndex = index; ScrollToBlock(index); UpdateBlockNav(); }
        }

        // ═══════════════════════════════════════════════════════════
        //  FOCUS / SPOTLIGHT
        // ═══════════════════════════════════════════════════════════

        private void FocusMode_Click(object sender, MouseButtonEventArgs e)
        {
            _focusMode = !_focusMode;
            if (_focusMode && lessonOverlay.Children.Count > 1)
            {
                for (int i = 0; i < lessonOverlay.Children.Count; i++)
                {
                    if (lessonOverlay.Children[i] is FrameworkElement fe)
                        fe.Opacity = i == 0 ? 0.3 : ((i - 1) == _currentBlockIndex ? 1.0 : 0.15);
                }
            }
            else
            {
                foreach (FrameworkElement child in lessonOverlay.Children) child.Opacity = 1.0;
            }
        }

        private void Spotlight_Click(object sender, MouseButtonEventArgs e)
        {
            _spotlightMode = !_spotlightMode;
            spotlightOverlay.Visibility = _spotlightMode ? Visibility.Visible : Visibility.Collapsed;
            if (_spotlightMode) { spotlightOverlay.Children.Clear(); spotlightOverlay.Background = Brushes.Transparent; }
        }

        private void Spotlight_MouseMove(object sender, MouseEventArgs e)
        {
            if (!_spotlightMode) return;
            var pos = e.GetPosition(spotlightOverlay);
            var w = spotlightOverlay.ActualWidth;
            var h = spotlightOverlay.ActualHeight;
            double radius = 120;

            spotlightOverlay.Children.Clear();
            var geo = new CombinedGeometry(GeometryCombineMode.Exclude,
                new RectangleGeometry(new Rect(0, 0, w, h)),
                new EllipseGeometry(pos, radius, radius));
            spotlightOverlay.Children.Add(new System.Windows.Shapes.Path
            { Data = geo, Fill = new SolidColorBrush(Color.FromArgb(180, 0, 0, 0)) });

            var ring = new Ellipse
            {
                Width = radius * 2 + 4, Height = radius * 2 + 4,
                Stroke = new SolidColorBrush(Color.FromArgb(80, 255, 255, 255)),
                StrokeThickness = 2, Fill = Brushes.Transparent
            };
            Canvas.SetLeft(ring, pos.X - radius - 2);
            Canvas.SetTop(ring, pos.Y - radius - 2);
            spotlightOverlay.Children.Add(ring);
        }

        private void Spotlight_Cancel(object sender, MouseButtonEventArgs e)
        {
            _spotlightMode = false;
            spotlightOverlay.Visibility = Visibility.Collapsed;
        }

        private void FocusOverlay_MouseDown(object sender, MouseButtonEventArgs e)
        {
            focusOverlay.Visibility = Visibility.Collapsed;
            _focusMode = false;
            foreach (FrameworkElement child in lessonOverlay.Children) child.Opacity = 1.0;
        }

        private void FocusOverlay_MouseMove(object sender, MouseEventArgs e) { }
        private void FocusOverlay_MouseUp(object sender, MouseButtonEventArgs e) { }

        // ═══════════════════════════════════════════════════════════
        //  RICH TEXT BUILDER (preserved from original)
        // ═══════════════════════════════════════════════════════════

        private static RichTextBox BuildCanvasRichText(string text)
        {
            var rtb = new RichTextBox
            {
                BorderThickness = new Thickness(0), IsReadOnly = true,
                Background = Brushes.Transparent, Padding = new Thickness(0),
                FontFamily = new FontFamily("Segoe UI"), FontSize = 15, IsHitTestVisible = false
            };

            var doc = new FlowDocument { PagePadding = new Thickness(0) };
            foreach (var rawLine in text.Split('\n'))
            {
                var line = rawLine.TrimEnd('\r');
                if (string.IsNullOrWhiteSpace(line)) continue;

                var para = new Paragraph { Margin = new Thickness(0, 2, 0, 2) };
                if (line.StartsWith("📌") || line.StartsWith("✍") || line.StartsWith("⚡"))
                {
                    para.Inlines.Add(new Run(line) { FontSize = 18, FontWeight = FontWeights.Bold,
                        Foreground = new SolidColorBrush(Color.FromRgb(25, 118, 210)) });
                    para.Margin = new Thickness(0, 6, 0, 4);
                }
                else if (line.StartsWith("📖"))
                {
                    para.Inlines.Add(new Run(line) { FontSize = 17, FontWeight = FontWeights.Bold,
                        Foreground = new SolidColorBrush(Color.FromRgb(33, 33, 33)) });
                    para.Margin = new Thickness(0, 6, 0, 4);
                }
                else if (line.StartsWith("📝"))
                {
                    para.Inlines.Add(new Run(line) { FontSize = 16, FontWeight = FontWeights.SemiBold,
                        Foreground = new SolidColorBrush(Color.FromRgb(46, 125, 50)) });
                }
                else if (line.TrimStart().StartsWith("•") || line.TrimStart().StartsWith("🔹") ||
                         line.TrimStart().StartsWith("✅") || line.TrimStart().StartsWith("❌"))
                {
                    para.Margin = new Thickness(14, 1, 0, 1);
                    para.Inlines.Add(new Run(line) { FontSize = 15, Foreground = new SolidColorBrush(Color.FromRgb(55, 55, 55)) });
                }
                else
                {
                    para.Inlines.Add(new Run(line) { FontSize = 15, Foreground = new SolidColorBrush(Color.FromRgb(55, 55, 55)) });
                }
                doc.Blocks.Add(para);
            }
            rtb.Document = doc;
            return rtb;
        }
    }

    public interface IUndoableAction
    {
        void Undo();
        void Redo();
    }

    public class StrokeUndoAction : IUndoableAction
    {
        private readonly InkCanvas _inkCanvas;
        private readonly StrokeCollection _prevStrokes;
        private readonly StrokeCollection _newStrokes;

        public StrokeUndoAction(InkCanvas inkCanvas, StrokeCollection prevStrokes, StrokeCollection newStrokes)
        {
            _inkCanvas = inkCanvas;
            _prevStrokes = prevStrokes.Clone();
            _newStrokes = newStrokes.Clone();
        }

        public void Undo()
        {
            _inkCanvas.Strokes = _prevStrokes.Clone();
        }

        public void Redo()
        {
            _inkCanvas.Strokes = _newStrokes.Clone();
        }
    }

    public class ShapeUndoAction : IUndoableAction
    {
        private readonly Canvas _shapeCanvas;
        private readonly List<UIElement> _shapeElements;
        private readonly UIElement _element;

        public ShapeUndoAction(Canvas shapeCanvas, List<UIElement> shapeElements, UIElement element)
        {
            _shapeCanvas = shapeCanvas;
            _shapeElements = shapeElements;
            _element = element;
        }

        public void Undo()
        {
            _shapeCanvas.Children.Remove(_element);
            _shapeElements.Remove(_element);
        }

        public void Redo()
        {
            if (!_shapeCanvas.Children.Contains(_element))
                _shapeCanvas.Children.Add(_element);
            if (!_shapeElements.Contains(_element))
                _shapeElements.Add(_element);
        }
    }

    public class TextUndoAction : IUndoableAction
    {
        private readonly Canvas _shapeCanvas;
        private readonly List<UIElement> _shapeElements;
        private readonly UIElement _element;

        public TextUndoAction(Canvas shapeCanvas, List<UIElement> shapeElements, UIElement element)
        {
            _shapeCanvas = shapeCanvas;
            _shapeElements = shapeElements;
            _element = element;
        }

        public void Undo()
        {
            _shapeCanvas.Children.Remove(_element);
            _shapeElements.Remove(_element);
        }

        public void Redo()
        {
            if (!_shapeCanvas.Children.Contains(_element))
                _shapeCanvas.Children.Add(_element);
            if (!_shapeElements.Contains(_element))
                _shapeElements.Add(_element);
        }
    }
}

