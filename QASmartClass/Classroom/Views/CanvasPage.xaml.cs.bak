using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Documents;
using System.Windows.Ink;
using System.Windows.Input;
using System.Windows.Media;
using System.Windows.Media.Animation;
using System.Windows.Media.Imaging;
using System.Windows.Shapes;
using QASmartClass.Data;
using Serilog;

namespace QASmartClass.Classroom.Views
{
    public partial class CanvasPage : Page
    {
        private int _lessonId = 0;
        private double _zoomLevel = 1.0;
        private int _currentBlockIndex = 0;
        private int _totalBlocks = 0;
        private bool _focusMode = false;
        private bool _spotlightMode = false;

        // ── Pan state ──
        private bool _panMode = false;
        private bool _isPanning = false;
        private Point _panStartMouse;
        private double _panStartX, _panStartY;

        // ── Undo/Redo ──
        private readonly Stack<IUndoableAction> _undoStack = new();
        private readonly Stack<IUndoableAction> _redoStack = new();
        private bool _isUndoRedo = false;
        private StrokeCollection _lastStrokeState = new();

        // ── Shape drawing state ──
        private string _currentTool = "Pen";
        private bool _isDrawingShape = false;
        private Point _shapeStartPoint;
        private Shape? _previewShape = null;

        // ── Background mode ──
        private int _bgMode = 0; // 0=solid, 1=grid, 2=dots, 3=lines

        // ── Shape list for undo ──
        private readonly List<UIElement> _shapeElements = new();

        // ── Window key handlers to prevent leaks ──
        private KeyEventHandler? _windowKeyDownHandler;
        private KeyEventHandler? _windowKeyUpHandler;

        public CanvasPage(int lessonId = 0)
        {
            InitializeComponent();
            drawCanvas.DefaultDrawingAttributes.Color = Colors.White;
            drawCanvas.DefaultDrawingAttributes.Width = 3;
            drawCanvas.DefaultDrawingAttributes.Height = 3;

            // Stroke slider feedback
            strokeSlider.ValueChanged += (s, e) =>
            {
                drawCanvas.DefaultDrawingAttributes.Width = strokeSlider.Value;
                drawCanvas.DefaultDrawingAttributes.Height = strokeSlider.Value;
                txtStrokeSize.Text = $"{(int)strokeSlider.Value}px";
            };

            // Undo tracking
            _lastStrokeState = drawCanvas.Strokes.Clone();
            drawCanvas.StrokeCollected += (s, e) =>
            {
                if (!_isUndoRedo)
                {
                    PushAction(new StrokeUndoAction(drawCanvas, _lastStrokeState, drawCanvas.Strokes));
                    _lastStrokeState = drawCanvas.Strokes.Clone();
                }
            };
            drawCanvas.StrokeErased += (s, e) =>
            {
                if (!_isUndoRedo)
                {
                    PushAction(new StrokeUndoAction(drawCanvas, _lastStrokeState, drawCanvas.Strokes));
                    _lastStrokeState = drawCanvas.Strokes.Clone();
                }
            };

            _lessonId = lessonId;

            Loaded += (_, __) =>
            {
                if (_lessonId > 0) LoadLessonOnCanvas(_lessonId);
                _lastStrokeState = drawCanvas.Strokes.Clone();

                var win = Window.GetWindow(this);
                if (win != null)
                {
                    // Hủy đăng ký các handler cũ trước để tránh đăng ký lặp
                    if (_windowKeyDownHandler != null) win.KeyDown -= _windowKeyDownHandler;
                    if (_windowKeyUpHandler != null) win.KeyUp -= _windowKeyUpHandler;

                    _windowKeyDownHandler = (s, e) =>
                    {
                        if (e.Key == Key.Space && !_panMode) { _panMode = true; UpdatePanToolStyle(); }
                        if (e.Key == Key.Z && Keyboard.Modifiers == ModifierKeys.Control) Undo_Click(null!, null!);
                        if (e.Key == Key.Y && Keyboard.Modifiers == ModifierKeys.Control) Redo_Click(null!, null!);
                        if (e.Key == Key.Add || (e.Key == Key.OemPlus && Keyboard.Modifiers == ModifierKeys.Control)) SetZoom(Math.Min(_zoomLevel + 0.15, 3.0));
                        if (e.Key == Key.Subtract || (e.Key == Key.OemMinus && Keyboard.Modifiers == ModifierKeys.Control)) SetZoom(Math.Max(_zoomLevel - 0.15, 0.5));
                        
                        // Hỗ trợ phím tắt chuyển công cụ tương tự Tooltip
                        if (Keyboard.Modifiers == ModifierKeys.None)
                        {
                            if (e.Key == Key.P) SelectTool(toolPen, null!);
                            else if (e.Key == Key.H) SelectTool(toolHighlight, null!);
                            else if (e.Key == Key.E) SelectTool(toolEraser, null!);
                            else if (e.Key == Key.S) SelectTool(toolSelect, null!);
                        }
                    };
                    _windowKeyUpHandler = (s, e) => { if (e.Key == Key.Space && _panMode) { _panMode = false; UpdatePanToolStyle(); } };

                    win.KeyDown += _windowKeyDownHandler;
                    win.KeyUp += _windowKeyUpHandler;
                }
                ApplyBackground();
                SelectTool(toolPen, null!);
            };

            Unloaded += (_, __) =>
            {
                var win = Window.GetWindow(this);
                if (win != null)
                {
                    if (_windowKeyDownHandler != null) win.KeyDown -= _windowKeyDownHandler;
                    if (_windowKeyUpHandler != null) win.KeyUp -= _windowKeyUpHandler;
                }
            };
        }

        // ═══════════════════════════════════════════════════════════
        //  TOOL SELECTION
        // ═══════════════════════════════════════════════════════════

        private void SelectTool(object sender, MouseButtonEventArgs e)
        {
            var allTools = new[] { toolPen, toolHighlight, toolEraser, toolSelect, toolShape, toolEllipse, toolLine, toolArrow, toolText };
            foreach (var t in allTools)
            {
                t.Background = new SolidColorBrush(Color.FromRgb(45, 50, 80));
                if (t.Child is TextBlock tb) tb.Foreground = new SolidColorBrush(Color.FromRgb(176, 190, 197));
            }

            if (sender is Border border)
            {
                border.Background = new SolidColorBrush(Color.FromRgb(25, 118, 210));
                if (border.Child is TextBlock tb2) tb2.Foreground = Brushes.White;

                _currentTool = border.Tag?.ToString() ?? "Pen";

                switch (_currentTool)
                {
                    case "Highlight":
                        drawCanvas.EditingMode = InkCanvasEditingMode.Ink;
                        drawCanvas.DefaultDrawingAttributes.IsHighlighter = true;
                        drawCanvas.DefaultDrawingAttributes.Color = Color.FromArgb(128, 255, 255, 0);
                        drawCanvas.DefaultDrawingAttributes.Width = 20;
                        drawCanvas.DefaultDrawingAttributes.Height = 10;
                        drawCanvas.IsHitTestVisible = true;
                        ShowToolHint("Bút nhấn — kéo để vẽ");
                        break;
                    case "Eraser":
                        drawCanvas.DefaultDrawingAttributes.IsHighlighter = false;
                        drawCanvas.EditingMode = InkCanvasEditingMode.EraseByStroke;
                        drawCanvas.IsHitTestVisible = true;
                        ShowToolHint("Tẩy — chạm vào nét để xóa");
                        break;
                    case "Select":
                        drawCanvas.DefaultDrawingAttributes.IsHighlighter = false;
                        drawCanvas.EditingMode = InkCanvasEditingMode.Select;
                        drawCanvas.IsHitTestVisible = true;
                        ShowToolHint("Chọn — kéo khung để chọn nét");
                        break;
                    case "Shape":
                    case "Ellipse":
                    case "Line":
                    case "Arrow":
                        drawCanvas.DefaultDrawingAttributes.IsHighlighter = false;
                        drawCanvas.EditingMode = InkCanvasEditingMode.None;
                        drawCanvas.IsHitTestVisible = false;
                        string shapeName = _currentTool switch
                        {
                            "Shape" => "Hình chữ nhật", "Ellipse" => "Hình elip",
                            "Line" => "Đường thẳng", "Arrow" => "Mũi tên", _ => ""
                        };
                        ShowToolHint($"{shapeName} — kéo chuột để vẽ");
                        break;
                    case "Text":
                        drawCanvas.DefaultDrawingAttributes.IsHighlighter = false;
                        drawCanvas.EditingMode = InkCanvasEditingMode.None;
                        drawCanvas.IsHitTestVisible = false;
                        ShowToolHint("Chèn chữ — click vào vị trí trên bảng");
                        break;
                    default: // Pen
                        drawCanvas.DefaultDrawingAttributes.IsHighlighter = false;
                        drawCanvas.EditingMode = InkCanvasEditingMode.Ink;
                        drawCanvas.DefaultDrawingAttributes.Width = strokeSlider.Value;
                        drawCanvas.DefaultDrawingAttributes.Height = strokeSlider.Value;
                        drawCanvas.IsHitTestVisible = true;
                        ShowToolHint("Bút vẽ — kéo để vẽ tự do");
                        break;
                }
            }
        }

        private void ShowToolHint(string text)
        {
            txtToolHint.Text = text;
            toolHint.Visibility = Visibility.Visible;
            var fadeOut = new DoubleAnimation(1, 0, TimeSpan.FromSeconds(3))
            { BeginTime = TimeSpan.FromSeconds(1), EasingFunction = new CubicEase { EasingMode = EasingMode.EaseIn } };
            fadeOut.Completed += (_, _) => toolHint.Visibility = Visibility.Collapsed;
            toolHint.BeginAnimation(OpacityProperty, fadeOut);
        }

        // ═══════════════════════════════════════════════════════════
        //  COLOR PICKER
        // ═══════════════════════════════════════════════════════════

        private void ColorPick(object sender, MouseButtonEventArgs e)
        {
            if (sender is Ellipse el && el.Tag is string hex)
            {
                var color = (Color)ColorConverter.ConvertFromString(hex);
                drawCanvas.DefaultDrawingAttributes.Color = color;
                currentColorFill.Background = new SolidColorBrush(color);
            }
        }

        private static readonly string[] _extraColors = { "#E91E63", "#9C27B0", "#3F51B5", "#009688", "#795548", "#607D8B", "#F44336", "#00BCD4", "#CDDC39", "#FF5722" };
        private int _extraColorIndex = 0;

        private void CustomColor_Click(object sender, MouseButtonEventArgs e)
        {
            var hex = _extraColors[_extraColorIndex % _extraColors.Length];
            _extraColorIndex++;
            var c = (Color)ColorConverter.ConvertFromString(hex);
            drawCanvas.DefaultDrawingAttributes.Color = c;
            currentColorFill.Background = new SolidColorBrush(c);
            ShowToolHint($"Màu: {hex}");
        }

        // ═══════════════════════════════════════════════════════════
        //  UNDO / REDO
        // ═══════════════════════════════════════════════════════════

        private void PushAction(IUndoableAction action)
        {
            if (_isUndoRedo) return;
            _undoStack.Push(action);
            _redoStack.Clear();
            if (_undoStack.Count > 100)
            {
                var list = _undoStack.ToList();
                list.RemoveAt(list.Count - 1);
                list.Reverse();
                _undoStack.Clear();
                foreach (var act in list)
                {
                    _undoStack.Push(act);
                }
            }
        }

        private void Undo_Click(object sender, MouseButtonEventArgs e)
        {
            if (_undoStack.Count > 0)
            {
                _isUndoRedo = true;
                var action = _undoStack.Pop();
                action.Undo();
                _redoStack.Push(action);
                _isUndoRedo = false;
                _lastStrokeState = drawCanvas.Strokes.Clone();
                Log.Information("Undo — stack: {Count}", _undoStack.Count);
            }
        }

        private void Redo_Click(object sender, MouseButtonEventArgs e)
        {
            if (_redoStack.Count > 0)
            {
                _isUndoRedo = true;
                var action = _redoStack.Pop();
                action.Redo();
                _undoStack.Push(action);
                _isUndoRedo = false;
                _lastStrokeState = drawCanvas.Strokes.Clone();
                Log.Information("Redo — stack: {Count}", _redoStack.Count);
            }
        }

        // ═══════════════════════════════════════════════════════════
        //  BACKGROUND PATTERNS
        // ═══════════════════════════════════════════════════════════

        private void BgToggle_Click(object sender, MouseButtonEventArgs e)
        {
            _bgMode = (_bgMode + 1) % 4;
            ApplyBackground();
            string[] names = { "⊟ Trơn", "⊞ Ô vuông", "⁙ Chấm", "☰ Kẻ ngang" };
            txtBgMode.Text = new[] { "⊞", "⁙", "☰", "⊟" }[_bgMode];
            ShowToolHint($"Nền: {names[_bgMode]}");
        }

        private void ApplyBackground()
        {
            bgPatternCanvas.Children.Clear();

            switch (_bgMode)
            {
                case 1: // Grid
                    DrawGridPattern(40, Color.FromArgb(30, 255, 255, 255));
                    break;
                case 2: // Dots
                    DrawDotsPattern(30, 3, Color.FromArgb(40, 255, 255, 255));
                    break;
                case 3: // Horizontal lines
                    DrawLinePattern(40, Color.FromArgb(25, 255, 255, 255));
                    break;
            }
        }

        private void DrawGridPattern(double spacing, Color color)
        {
            double w = 2000, h = 1400;
            var brush = new SolidColorBrush(color);
            for (double x = 0; x < w; x += spacing)
            {
                bgPatternCanvas.Children.Add(new Line { X1 = x, Y1 = 0, X2 = x, Y2 = h, Stroke = brush, StrokeThickness = 0.5 });
            }
            for (double y = 0; y < h; y += spacing)
            {
                bgPatternCanvas.Children.Add(new Line { X1 = 0, Y1 = y, X2 = w, Y2 = y, Stroke = brush, StrokeThickness = 0.5 });
            }
        }

        private void DrawDotsPattern(double spacing, double dotSize, Color color)
        {
            double w = 2000, h = 1400;
            var brush = new SolidColorBrush(color);
            for (double x = spacing; x < w; x += spacing)
            {
                for (double y = spacing; y < h; y += spacing)
                {
                    var dot = new Ellipse { Width = dotSize, Height = dotSize, Fill = brush };
                    Canvas.SetLeft(dot, x - dotSize / 2);
                    Canvas.SetTop(dot, y - dotSize / 2);
                    bgPatternCanvas.Children.Add(dot);
                }
            }
        }

        private void DrawLinePattern(double spacing, Color color)
        {
            double w = 2000, h = 1400;
            var brush = new SolidColorBrush(color);
            for (double y = spacing; y < h; y += spacing)
            {
                bgPatternCanvas.Children.Add(new Line { X1 = 0, Y1 = y, X2 = w, Y2 = y, Stroke = brush, StrokeThickness = 0.5 });
            }
        }

        // ═══════════════════════════════════════════════════════════
        //  SHAPE DRAWING (Rect, Ellipse, Line, Arrow)
        // ═══════════════════════════════════════════════════════════

        private void StartShapeDraw(Point pos)
        {
            if (_currentTool == "Text")
            {
                InsertTextAtPosition(pos);
                return;
            }

            _isDrawingShape = true;
            _shapeStartPoint = pos;
            _previewShape = null;
        }

        private void UpdateShapePreview(Point pos)
        {
            if (!_isDrawingShape) return;
            shapePreviewCanvas.Children.Clear();

            var color = drawCanvas.DefaultDrawingAttributes.Color;
            var thickness = drawCanvas.DefaultDrawingAttributes.Width;
            var brush = new SolidColorBrush(color);

            var rect = new Rect(_shapeStartPoint, pos);
            Shape? shape = null;

            switch (_currentTool)
            {
                case "Shape":
                    shape = new Rectangle
                    {
                        Width = rect.Width, Height = rect.Height,
                        Stroke = brush, StrokeThickness = thickness,
                        Fill = Brushes.Transparent, StrokeDashArray = new DoubleCollection { 4, 2 }
                    };
                    Canvas.SetLeft(shape, rect.Left);
                    Canvas.SetTop(shape, rect.Top);
                    break;
                case "Ellipse":
                    shape = new Ellipse
                    {
                        Width = rect.Width, Height = rect.Height,
                        Stroke = brush, StrokeThickness = thickness,
                        Fill = Brushes.Transparent, StrokeDashArray = new DoubleCollection { 4, 2 }
                    };
                    Canvas.SetLeft(shape, rect.Left);
                    Canvas.SetTop(shape, rect.Top);
                    break;
                case "Line":
                    shape = new Line
                    {
                        X1 = _shapeStartPoint.X, Y1 = _shapeStartPoint.Y,
                        X2 = pos.X, Y2 = pos.Y,
                        Stroke = brush, StrokeThickness = thickness,
                        StrokeDashArray = new DoubleCollection { 4, 2 }
                    };
                    break;
                case "Arrow":
                    shape = new Line
                    {
                        X1 = _shapeStartPoint.X, Y1 = _shapeStartPoint.Y,
                        X2 = pos.X, Y2 = pos.Y,
                        Stroke = brush, StrokeThickness = thickness,
                        StrokeDashArray = new DoubleCollection { 4, 2 }
                    };
                    break;
            }

            if (shape != null)
            {
                shapePreviewCanvas.Children.Add(shape);
                _previewShape = shape;
            }
        }

        private void FinishShapeDraw(Point pos)
        {
            if (!_isDrawingShape) return;
            _isDrawingShape = false;
            shapePreviewCanvas.Children.Clear();

            var color = drawCanvas.DefaultDrawingAttributes.Color;
            var thickness = drawCanvas.DefaultDrawingAttributes.Width;
            var brush = new SolidColorBrush(color);
            var rect = new Rect(_shapeStartPoint, pos);

            // Minimum size check
            if (rect.Width < 5 && rect.Height < 5 &&
                _currentTool != "Line" && _currentTool != "Arrow") return;

            Shape? finalShape = null;

            switch (_currentTool)
            {
                case "Shape":
                    finalShape = new Rectangle
                    {
                        Width = rect.Width, Height = rect.Height,
                        Stroke = brush, StrokeThickness = thickness, Fill = Brushes.Transparent
                    };
                    Canvas.SetLeft(finalShape, rect.Left);
                    Canvas.SetTop(finalShape, rect.Top);
                    break;
                case "Ellipse":
                    finalShape = new Ellipse
                    {
                        Width = rect.Width, Height = rect.Height,
                        Stroke = brush, StrokeThickness = thickness, Fill = Brushes.Transparent
                    };
                    Canvas.SetLeft(finalShape, rect.Left);
                    Canvas.SetTop(finalShape, rect.Top);
                    break;
                case "Line":
                    finalShape = new Line
                    {
                        X1 = _shapeStartPoint.X, Y1 = _shapeStartPoint.Y,
                        X2 = pos.X, Y2 = pos.Y,
                        Stroke = brush, StrokeThickness = thickness,
                        StrokeStartLineCap = PenLineCap.Round, StrokeEndLineCap = PenLineCap.Round
                    };
                    break;
                case "Arrow":
                    // Arrow with arrowhead
                    var arrowGroup = CreateArrowPath(_shapeStartPoint, pos, brush, thickness);
                    shapeCanvas.Children.Add(arrowGroup);
                    _shapeElements.Add(arrowGroup);
                    PushAction(new ShapeUndoAction(shapeCanvas, _shapeElements, arrowGroup));
                    return;
            }

            if (finalShape != null)
            {
                shapeCanvas.Children.Add(finalShape);
                _shapeElements.Add(finalShape);
                PushAction(new ShapeUndoAction(shapeCanvas, _shapeElements, finalShape));
            }
        }

        private System.Windows.Shapes.Path CreateArrowPath(Point start, Point end, SolidColorBrush brush, double thickness)
        {
            var angle = Math.Atan2(end.Y - start.Y, end.X - start.X);
            var headLen = Math.Max(thickness * 4, 12);
            var headAngle = Math.PI / 6;

            var p1 = new Point(end.X - headLen * Math.Cos(angle - headAngle), end.Y - headLen * Math.Sin(angle - headAngle));
            var p2 = new Point(end.X - headLen * Math.Cos(angle + headAngle), end.Y - headLen * Math.Sin(angle + headAngle));

            var geo = new GeometryGroup();
            geo.Children.Add(new LineGeometry(start, end));
            geo.Children.Add(new LineGeometry(end, p1));
            geo.Children.Add(new LineGeometry(end, p2));

            return new System.Windows.Shapes.Path
            {
                Data = geo, Stroke = brush, StrokeThickness = thickness,
                StrokeStartLineCap = PenLineCap.Round, StrokeEndLineCap = PenLineCap.Round
            };
        }

        // ═══════════════════════════════════════════════════════════
        //  TEXT INSERTION
        // ═══════════════════════════════════════════════════════════

        private void InsertTextAtPosition(Point pos)
        {
            var inputBox = new TextBox
            {
                FontSize = Math.Max(drawCanvas.DefaultDrawingAttributes.Width * 4, 16),
                Foreground = new SolidColorBrush(drawCanvas.DefaultDrawingAttributes.Color),
                Background = new SolidColorBrush(Color.FromArgb(180, 15, 52, 96)),
                BorderThickness = new Thickness(1),
                BorderBrush = new SolidColorBrush(Color.FromRgb(25, 118, 210)),
                Padding = new Thickness(6, 4, 6, 4),
                MinWidth = 100,
                AcceptsReturn = false,
                FontFamily = new FontFamily("Segoe UI")
            };

            Canvas.SetLeft(inputBox, pos.X);
            Canvas.SetTop(inputBox, pos.Y);
            shapeCanvas.Children.Add(inputBox);

            inputBox.Loaded += (_, _) => { inputBox.Focus(); };

            inputBox.KeyDown += (s, ke) =>
            {
                if (ke.Key == Key.Enter || ke.Key == Key.Escape)
                {
                    if (ke.Key == Key.Enter && !string.IsNullOrWhiteSpace(inputBox.Text))
                    {
                        // Convert to TextBlock
                        var tb = new TextBlock
                        {
                            Text = inputBox.Text,
                            FontSize = inputBox.FontSize,
                            Foreground = inputBox.Foreground,
                            FontFamily = inputBox.FontFamily
                        };
                        Canvas.SetLeft(tb, Canvas.GetLeft(inputBox));
                        Canvas.SetTop(tb, Canvas.GetTop(inputBox));
                        shapeCanvas.Children.Remove(inputBox);
                        shapeCanvas.Children.Add(tb);
                        _shapeElements.Add(tb);
                        PushAction(new TextUndoAction(shapeCanvas, _shapeElements, tb));
                    }
                    else
                    {
                        shapeCanvas.Children.Remove(inputBox);
                    }
                }
            };
            inputBox.LostFocus += (s, _) =>
            {
                if (!string.IsNullOrWhiteSpace(inputBox.Text))
                {
                    var tb = new TextBlock
                    {
                        Text = inputBox.Text,
                        FontSize = inputBox.FontSize,
                        Foreground = inputBox.Foreground,
                        FontFamily = inputBox.FontFamily
                    };
                    Canvas.SetLeft(tb, Canvas.GetLeft(inputBox));
                    Canvas.SetTop(tb, Canvas.GetTop(inputBox));
                    shapeCanvas.Children.Remove(inputBox);
                    shapeCanvas.Children.Add(tb);
                    _shapeElements.Add(tb);
                    PushAction(new TextUndoAction(shapeCanvas, _shapeElements, tb));
                }
                else
                {
                    shapeCanvas.Children.Remove(inputBox);
                }
            };
        }

        // ═══════════════════════════════════════════════════════════
        //  SAVE / LOAD CANVAS
        // ═══════════════════════════════════════════════════════════

        private void SaveCanvas_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var dlg = new Microsoft.Win32.SaveFileDialog
                {
                    Filter = "Ink file (*.isf)|*.isf|PNG image (*.png)|*.png",
                    FileName = $"BangVe_{DateTime.Now:yyyyMMdd_HHmmss}",
                    DefaultExt = ".isf"
                };

                if (dlg.ShowDialog() == true)
                {
                    if (dlg.FilterIndex == 2) // PNG
                    {
                        SaveAsPng(dlg.FileName);
                    }
                    else // ISF
                    {
                        using var fs = new FileStream(dlg.FileName, FileMode.Create);
                        drawCanvas.Strokes.Save(fs);
                    }
                    MessageBox.Show($"Da luu: {dlg.FileName}", "Luu", MessageBoxButton.OK, MessageBoxImage.Information);
                    Log.Information("Canvas saved: {Path}", dlg.FileName);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Loi: {ex.Message}", "Loi", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void LoadCanvas_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var dlg = new Microsoft.Win32.OpenFileDialog
                {
                    Filter = "Ink file (*.isf)|*.isf",
                    DefaultExt = ".isf"
                };

                if (dlg.ShowDialog() == true)
                {
                    using var fs = new FileStream(dlg.FileName, FileMode.Open);
                    drawCanvas.Strokes = new StrokeCollection(fs);
                    _undoStack.Clear();
                    _redoStack.Clear();
                    _lastStrokeState = drawCanvas.Strokes.Clone();
                    Log.Information("Canvas loaded: {Path}", dlg.FileName);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Loi: {ex.Message}", "Loi", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void SaveAsPng(string path)
        {
            var target = canvasArea;
            var width = (int)target.ActualWidth;
            var height = (int)target.ActualHeight;
            if (width <= 0 || height <= 0) return;

            var renderBitmap = new RenderTargetBitmap(width, height, 96, 96, PixelFormats.Pbgra32);
            renderBitmap.Render(target);

            var encoder = new PngBitmapEncoder();
            encoder.Frames.Add(BitmapFrame.Create(renderBitmap));
            using var stream = File.Create(path);
            encoder.Save(stream);
        }

        // ═══════════════════════════════════════════════════════════
        //  PAN MODE
        // ═══════════════════════════════════════════════════════════

        private void PanMode_Click(object sender, MouseButtonEventArgs e)
        {
            _panMode = !_panMode;
            UpdatePanToolStyle();
        }

        private void UpdatePanToolStyle()
        {
            var activeColor = new SolidColorBrush(Color.FromRgb(25, 118, 210));
            var inactiveColor = new SolidColorBrush(Color.FromRgb(45, 50, 80));
            toolPan.Background = _panMode ? activeColor : inactiveColor;
            canvasArea.Cursor = _panMode ? Cursors.Hand : Cursors.Arrow;
        }

        private void CanvasArea_MouseDown(object sender, MouseButtonEventArgs e)
        {
            bool isPanGesture = _panMode || (e.MiddleButton == MouseButtonState.Pressed);

            if (isPanGesture || (_zoomLevel > 1.0 && Keyboard.Modifiers == ModifierKeys.Alt))
            {
                _isPanning = true;
                _panStartMouse = e.GetPosition(canvasArea);
                _panStartX = panTransform.X;
                _panStartY = panTransform.Y;
                canvasArea.CaptureMouse();
                canvasArea.Cursor = Cursors.SizeAll;
                e.Handled = isPanGesture;
                return;
            }

            // Shape/Text drawing
            if (_currentTool is "Shape" or "Ellipse" or "Line" or "Arrow" or "Text")
            {
                var pos = e.GetPosition(shapePreviewCanvas);
                StartShapeDraw(pos);
                e.Handled = true;
            }
        }

        private void CanvasArea_MouseMove(object sender, MouseEventArgs e)
        {
            if (_isPanning)
            {
                var current = e.GetPosition(canvasArea);
                var dx = current.X - _panStartMouse.X;
                var dy = current.Y - _panStartMouse.Y;
                var areaW = canvasArea.ActualWidth;
                var areaH = canvasArea.ActualHeight;
                var maxPanX = areaW * (_zoomLevel - 1) / 2.0;
                var maxPanY = areaH * (_zoomLevel - 1) / 2.0;
                panTransform.X = Math.Max(-maxPanX, Math.Min(maxPanX, _panStartX + dx));
                panTransform.Y = Math.Max(-maxPanY, Math.Min(maxPanY, _panStartY + dy));
                return;
            }

            if (_isDrawingShape)
            {
                var pos = e.GetPosition(shapePreviewCanvas);
                UpdateShapePreview(pos);
            }
        }

        private void CanvasArea_MouseUp(object sender, MouseButtonEventArgs e)
        {
            if (_isPanning)
            {
                _isPanning = false;
                canvasArea.ReleaseMouseCapture();
                canvasArea.Cursor = _panMode ? Cursors.Hand : Cursors.Arrow;
                return;
            }

            if (_isDrawingShape)
            {
                var pos = e.GetPosition(shapePreviewCanvas);
                FinishShapeDraw(pos);
            }
        }

        private void CanvasArea_MouseWheel(object sender, MouseWheelEventArgs e)
        {
            if (Keyboard.Modifiers == ModifierKeys.Control)
            {
                var delta = e.Delta > 0 ? 0.1 : -0.1;
                var newZoom = Math.Max(0.5, Math.Min(3.0, _zoomLevel + delta));
                if (Math.Abs(newZoom - _zoomLevel) < 0.001) return;

                var scale = newZoom / _zoomLevel;
                var areaW = canvasArea.ActualWidth;
                var areaH = canvasArea.ActualHeight;
                var cx = areaW / 2.0;
                var cy = areaH / 2.0;
                panTransform.X = cx + (panTransform.X - cx) * scale;
                panTransform.Y = cy + (panTransform.Y - cy) * scale;

                var maxPanX = areaW * (newZoom - 1) / 2.0;
                var maxPanY = areaH * (newZoom - 1) / 2.0;
                panTransform.X = Math.Max(-maxPanX, Math.Min(maxPanX, panTransform.X));
                panTransform.Y = Math.Max(-maxPanY, Math.Min(maxPanY, panTransform.Y));
                zoomTransform.ScaleX = newZoom;
                zoomTransform.ScaleY = newZoom;
                _zoomLevel = newZoom;

                var pct = (int)(newZoom * 100);
                txtZoomLevel.Text = $"{pct}%";
                txtZoomBadge.Text = $"🔍 {pct}%";
                zoomBadge.Visibility = newZoom != 1.0 ? Visibility.Visible : Visibility.Collapsed;
                e.Handled = true;
            }
        }

        private void ZoomIn_Click(object sender, MouseButtonEventArgs e) => SetZoom(Math.Min(_zoomLevel + 0.15, 3.0));
        private void ZoomOut_Click(object sender, MouseButtonEventArgs e) => SetZoom(Math.Max(_zoomLevel - 0.15, 0.5));

        private void ZoomReset_Click(object sender, MouseButtonEventArgs e)
        {
            SetZoom(1.0);
            panTransform.X = 0;
            panTransform.Y = 0;
        }

        private void SetZoom(double level)
        {
            _zoomLevel = level;
            var anim = new DoubleAnimation(level, TimeSpan.FromMilliseconds(200))
            { EasingFunction = new CubicEase { EasingMode = EasingMode.EaseOut } };
            zoomTransform.BeginAnimation(ScaleTransform.ScaleXProperty, anim);
            zoomTransform.BeginAnimation(ScaleTransform.ScaleYProperty, anim);

            var pct = (int)(level * 100);
            txtZoomLevel.Text = $"{pct}%";
            txtZoomBadge.Text = $"🔍 {pct}%";
            zoomBadge.Visibility = level != 1.0 ? Visibility.Visible : Visibility.Collapsed;
        }

