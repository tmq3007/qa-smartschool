        private void Screenshot_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var flashAnim = new DoubleAnimation(0.7, 0, TimeSpan.FromMilliseconds(300));
                flashOverlay.BeginAnimation(OpacityProperty, flashAnim);

                var folder = System.IO.Path.Combine(
                    Environment.GetFolderPath(Environment.SpecialFolder.MyPictures), "QASmartClass");
                Directory.CreateDirectory(folder);
                var filePath = System.IO.Path.Combine(folder, $"BangVe_{DateTime.Now:yyyyMMdd_HHmmss}.png");

                SaveAsPng(filePath);
                MessageBox.Show($"Da chup bang!\n\n{filePath}", "Chup man hinh", MessageBoxButton.OK, MessageBoxImage.Information);
                Log.Information("Screenshot saved: {Path}", filePath);
            }
            catch (Exception ex)
            {
                Log.Error(ex, "Screenshot error");
                MessageBox.Show($"Loi: {ex.Message}", "Loi", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

