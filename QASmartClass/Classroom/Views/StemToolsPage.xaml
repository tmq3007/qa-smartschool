                                                 <ComboBoxItem Content="📦 Hộp"/>
                                             </ComboBox>
                                             <TextBlock Text="🎨 Bảng màu" FontSize="12" Foreground="#757575" Margin="0,6,0,3"/>
                                             <ComboBox x:Name="cboColorTheme" FontSize="12" Padding="6,4" SelectedIndex="0">
                                                 <ComboBoxItem Content="🔵 Chuyên nghiệp"/>
                                                 <ComboBoxItem Content="🌈 Sinh động"/>
                                                 <ComboBoxItem Content="🌿 Pastel"/>
                                                 <ComboBoxItem Content="🔥 Ấm"/>
                                             </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                             <TextBlock Text="⚙️ Tùy chọn" FontSize="12" FontWeight="Bold" Foreground="#616161" Margin="0,0,0,4"/>
                                             <CheckBox x:Name="chkMeanLine" Content="📏 Đường TB" FontSize="12" Margin="0,0,0,3" IsChecked="True"/>
                                             <CheckBox x:Name="chkShowValues" Content="🔢 Hiện giá trị" FontSize="12" Margin="0,0,0,3" IsChecked="True"/>
                                             <CheckBox x:Name="chkShowLabels" Content="🏷️ Hiện nhãn" FontSize="12" IsChecked="True"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DRAW BUTTON -->
                                <Button DockPanel.Dock="Top" Content="📊  Vẽ biểu đồ" FontSize="13" FontWeight="SemiBold" Padding="12,8" Margin="0,8,0,0" Cursor="Hand" Click="StatsCalc_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="#1565C0" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0D47A1"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                                </Button>

                                <!-- BOTTOM: Preset data (fills remaining space) -->
                                <Border Margin="0,10,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="⚡ Dữ liệu mẫu — chạm để tự điền" FontSize="12" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,8"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0,0,4,0">
                                            <StackPanel>
                                                <!-- Nhóm 1: Toán & Điểm số -->
                                                <TextBlock Text="📐 Toán &amp; Điểm số" FontSize="12" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,4"/>
                                                <WrapPanel Margin="0,0,0,6">
                                                     <Button Content="🎓 Điểm toán 10A" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Scores"/>
                                                     <Button Content="📝 KT 15 phút" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Quiz15"/>
                                                     <Button Content="📊 TB HK1" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_HK1"/>
                                                </WrapPanel>

                                                <!-- Nhóm 2: KHTN -->
                                                <TextBlock Text="🔬 Khoa học tự nhiên" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" Margin="0,2,0,4"/>
                                                <WrapPanel Margin="0,0,0,6">
                                                     <Button Content="🌡️ Nhiệt độ 7 ngày" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Temp"/>
                                                     <Button Content="🧪 Nồng độ dd" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Concentration"/>
                                                     <Button Content="🌱 Chiều cao cây" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_PlantHeight"/>
                                                     <Button Content="⚡ Điện trở" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Resistance"/>
                                                </WrapPanel>

                                                <!-- Nhóm 3: Xã hội -->
                                                <TextBlock Text="🏫 Xã hội &amp; Đời sống" FontSize="12" FontWeight="Bold" Foreground="#E65100" Margin="0,2,0,4"/>
                                                <WrapPanel Margin="0,0,0,6">
                                                     <Button Content="👥 Sĩ số 6 lớp" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_ClassSize"/>
                                                     <Button Content="📚 Giờ tự học" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_StudyHours"/>
                                                     <Button Content="💰 Chi tiêu tuần" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Spending"/>
                                                     <Button Content="📖 Số sách đọc/tháng" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_BooksRead"/>
                                                </WrapPanel>

                                                <!-- Nhóm 4: Sức khỏe & Thể dục -->
                                                <TextBlock Text="🏃 Sức khỏe &amp; Thể dục" FontSize="12" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,2,0,4"/>
                                                <WrapPanel Margin="0,0,0,6">
                                                     <Button Content="❤️ Nhịp tim" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_HeartRate"/>
                                                     <Button Content="🏋️ Cân nặng HS" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Weight"/>
                                                     <Button Content="🏃 Chạy 100m" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Sprint"/>
                                                     <Button Content="📏 Chiều cao HS" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_StudentHeight"/>
                                                </WrapPanel>

                                                <!-- Nhóm 5: Môi trường & Địa lý -->
                                                <TextBlock Text="🌍 Môi trường &amp; Địa lý" FontSize="12" FontWeight="Bold" Foreground="#00838F" Margin="0,2,0,4"/>
                                                <WrapPanel Margin="0,0,0,4">
                                                     <Button Content="🌧️ Lượng mưa" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Rainfall"/>
                                                     <Button Content="💨 Chất lượng KK" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_AirQuality"/>
                                                     <Button Content="👨‍👩‍👧 Dân số tỉnh" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_Population"/>
                                                     <Button Content="🌾 Sản lượng lúa" Padding="6,4" Margin="0,0,4,4" FontSize="12" Cursor="Hand" Click="StatsPreset_RiceYield"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Right: chart + results + guide -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <Border DockPanel.Dock="Left" Background="#E3F2FD" CornerRadius="12" Padding="14,8" Margin="0,0,14,0">
                                    <TextBlock Text="📈" FontSize="24"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Thống Kê &amp; Biểu Đồ" FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
                                    <TextBlock Text="Nhập dữ liệu → tính Mean, Median, Mode, σ → vẽ biểu đồ trực quan" FontSize="12" Foreground="#9E9E9E"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Chart area -->
                            <Border Grid.Row="1" Background="#FAFAFA" CornerRadius="12" MinHeight="260" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                                <Canvas x:Name="chartCanvas" ClipToBounds="True"/>
                            </Border>

                            <!-- Stats results -->
                            <Border Grid.Row="2" x:Name="statsResultPanel" Visibility="Collapsed" Background="#F1F8E9" CornerRadius="10" Padding="16,12" BorderBrush="#C8E6C9" BorderThickness="1" Margin="0,0,0,10">
                                <WrapPanel x:Name="statsValuesPanel"/>
                            </Border>

                            <!-- HƯỚNG DẪN SỬ DỤNG -->
                            <Border Grid.Row="3" Background="#F5F5F5" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="💡 Hướng dẫn sử dụng" FontSize="14" FontWeight="Bold" Foreground="#616161" Margin="0,0,0,8"/>
                                    <TextBlock Text="1️⃣  Nhập tên (cột trái) và giá trị số (cột phải) cho mỗi dòng" FontSize="12" Foreground="#757575" Margin="0,0,0,3"/>
                                    <TextBlock Text="2️⃣  Nhấn ➕ Thêm dòng nếu cần thêm dữ liệu (✕ để xóa dòng)" FontSize="12" Foreground="#757575" Margin="0,0,0,3"/>
                                    <TextBlock Text="3️⃣  Chọn loại biểu đồ: Cột (so sánh), Tròn (tỉ lệ %), Đường (xu hướng)" FontSize="12" Foreground="#757575" Margin="0,0,0,3"/>
                                    <TextBlock Text="4️⃣  Nhấn 📊 Vẽ biểu đồ → xem chart + 7 chỉ số thống kê tự động" FontSize="12" Foreground="#757575" Margin="0,0,0,6"/>
                                    <Border Height="1" Background="#E0E0E0" Margin="0,2,0,6"/>
                                    <TextBlock Text="📊 Ý nghĩa các chỉ số:" FontSize="12" FontWeight="SemiBold" Foreground="#616161" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Mean (TB): Điểm trung bình = tổng / số lượng" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Median (TrV): Giá trị giữa khi sắp xếp tăng dần" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Mode (YV): Giá trị xuất hiện nhiều nhất" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                    <TextBlock Text="• σ (Std Dev): Độ lệch chuẩn — đo mức phân tán" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Variance: Phương sai = σ² — thường dùng trong CT GDPT 2018" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
                                    <Border Height="1" Background="#E0E0E0" Margin="0,2,0,6"/>
                                    <TextBlock Text="🎓 Mẹo cho GV:" FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Dùng preset 'Điểm toán lớp 10A' để demo nhanh trên bảng" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                    <TextBlock Text="• So sánh biểu đồ Cột vs Tròn để HS hiểu khi nào dùng loại nào" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Cho HS nhập điểm thật → phân tích → thảo luận kết quả" FontSize="11" Foreground="#757575"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
            
            <!-- MINDMAP TOOL -->
            <TabItem Header="🧠 Sơ đồ tư duy">
                <multi:MindmapTool/>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
