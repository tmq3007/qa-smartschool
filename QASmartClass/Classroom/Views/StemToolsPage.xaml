                                    <StackPanel>
                                        <TextBlock Text="💡 Hướng dẫn sử dụng" FontSize="13" FontWeight="Bold" Foreground="#616161" Margin="0,0,0,6"/>
                                        <TextBlock Text="1️⃣  Nhập PT dạng: Chất PƯ -> Sản phẩm" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                        <TextBlock Text="2️⃣  Dùng + ngăn cách, -> phân tách vế" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
