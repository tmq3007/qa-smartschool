                                </StackPanel>
                                <TextBlock Text="x +" FontSize="22" Foreground="#333" VerticalAlignment="Bottom" Margin="0,0,8,12"/>
                                
                                <StackPanel>
                                    <TextBlock Text="c" FontSize="14" Foreground="#757575" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtCoeffC" Width="80" FontSize="20" Padding="10,8" Text="6" TextAlignment="Center" TextChanged="SolveQuadratic_Changed"/>
                                </StackPanel>
                                <TextBlock Text="= 0" FontSize="22" Foreground="#333" VerticalAlignment="Bottom" Margin="12,0,0,12"/>
                            </StackPanel>

                            <Border Background="#F1F8E9" CornerRadius="12" Padding="24,20" BorderBrush="#C8E6C9" BorderThickness="2">
