                                    </Grid>

                                    <Border Height="1" Background="#C8E6C9" Margin="0,4,0,10"/>
                                    
                                    <!-- Panel mô tả ví dụ -->
                                    <Border x:Name="quadPresetDescPanel" Background="White" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
