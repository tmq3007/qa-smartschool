                                        <Border Height="1" Background="#E0E0E0" Margin="0,2,0,4"/>
                                        <TextBlock Text="⌨️ Quy tắc:" FontSize="11" FontWeight="SemiBold" Foreground="#616161" Margin="0,0,0,3"/>
