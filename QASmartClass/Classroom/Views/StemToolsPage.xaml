                                    <TextBlock x:Name="txtQuadResult" Text="x₁ = 2, x₂ = 3" FontSize="28" FontWeight="Bold" Foreground="#1B5E20"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Graph Graph Viewer -->
                        <Border Grid.Column="1" Background="#F1F8E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="12" Padding="16,16,6,16">
