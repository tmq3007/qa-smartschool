<Page x:Class="QASmartClass.Classroom.Views.StemToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:multi="clr-namespace:QASmartClass.LearningTools.Views.Multi"
      Background="#F0F2F5">

    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" CornerRadius="14" Padding="20,14" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A2332" Offset="0"/>
                    <GradientStop Color="#2C3E50" Offset="0.5"/>
                    <GradientStop Color="#34495E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Navigation sub-flow: Quay lại Trang chủ -->
                    <Button x:Name="btnBackHome" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" 
                            Width="36" Height="36" Margin="0,0,12,0" Padding="0"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="GoBackHome_Click" ToolTip="Quay lại Trang chủ"
                            FontSize="16">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút Focus / Unfocus -->
                    <Button x:Name="btnFocusHS" Content="🎯 Tập trung HS" FontSize="13" FontWeight="Bold"
                            Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand" Click="FocusHS_Click"
                            ToolTip="Yêu cầu tất cả HS tập trung vào công cụ này">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="#C8E6C9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#C8E6C9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnUnfocusHS" Content="❌ Hủy tập trung" FontSize="13" FontWeight="Bold"
                            Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"
                            Padding="12,6" Margin="0,0,16,0" Cursor="Hand" Click="UnfocusHS_Click"
                            ToolTip="Bỏ Focus — HS tự do trở lại">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="#FFCDD2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#FFCDD2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="White" CornerRadius="8" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock Text="🔬 Vật lý" FontSize="11" Foreground="#333333" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock Text="🧪 Hóa học" FontSize="11" Foreground="#333333" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="10,5">
                        <TextBlock Text="📐 Toán học" FontSize="11" Foreground="#333333" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="🔭 Công cụ STEM" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Máy tính khoa học • Bấm giờ thí nghiệm" 
                               FontSize="11" Foreground="#B0BEC5" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <TabControl x:Name="mainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="20,12" Margin="0,0,8,0" CornerRadius="8,8,0,0" Background="#E0E0E0" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#757575"/>
                </Style>

                <Style x:Key="QuickBtnStyle" TargetType="Button">
                    <Setter Property="Background" Value="#F3E5F5"/>
                    <Setter Property="Foreground" Value="#7B1FA2"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Margin" Value="0,0,4,4"/>
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E1BEE7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="QuickBtnStyle_Timer" TargetType="Button">
                    <Setter Property="Background" Value="#FFF3E0"/>
                    <Setter Property="Foreground" Value="#E65100"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Margin" Value="0,0,4,4"/>
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFE082"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="QuickBtnStyle_Quad" TargetType="Button">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Margin" Value="0,0,4,4"/>
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C8E6C9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: MÁY TÍNH -->
            <TabItem Header="🔢 Máy tính khoa học">
                <Border Background="White" CornerRadius="0,12,12,12" BorderBrush="#D0D5DD" BorderThickness="1" Padding="40">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MaxWidth="1200" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="650" MinWidth="320"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" CornerRadius="14" Padding="0" BorderBrush="#D0D5DD" BorderThickness="1" HorizontalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F8F9FA" Offset="0"/>
                                    <GradientStop Color="#FFFFFF" Offset="0.3"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <DockPanel Margin="16,12,16,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkDegMode" Content="Độ (Deg)" IsChecked="True" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Bật để dùng chế độ Độ (Degrees), tắt để dùng chế độ Radian (Rad)"/>
                                        <Button x:Name="btnCalcHistory" Content="📋" FontSize="16" Padding="8,4" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CalcHistory_Click" ToolTip="Lịch sử tính toán"/>
                                        <Button Content="🗑️" FontSize="16" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" Click="CalcClearAll_Click" ToolTip="Xóa tất cả"/>
                                    </StackPanel>
                                    <TextBlock Text="🔢 Máy tính khoa học" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                </DockPanel>

                                <Border Background="#1E293B" CornerRadius="10" Margin="16,12,16,0" Padding="20,16">
                                    <StackPanel>
                                        <TextBox x:Name="txtCalcInput" FontSize="20" FontFamily="Cambria Math, Segoe UI" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" TextAlignment="Right" Padding="0,0,0,4" CaretBrush="#94A3B8" KeyDown="CalcInput_KeyDown" ToolTip="Nhập biểu thức → Enter"/>
                                        <TextBlock x:Name="txtCalcDisplay" Text="0" FontSize="56" FontWeight="Bold" Foreground="White" TextAlignment="Right" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>

                                <UniformGrid x:Name="calcButtons" Columns="6" Margin="16,12,16,20"/>

                                <Border x:Name="calcHistoryPanel" Visibility="Collapsed" Background="#F8F9FA" Padding="12" Margin="16,0,16,16" MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="calcHistoryList"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- Quick info area in calculator tab -->
                        <Border Grid.Column="1" Margin="24,0,0,0" Background="#F8FAFE" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="💡 Hướng dẫn sử dụng" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                <TextBlock Text="• Có thể nhập trực tiếp từ bàn phím" FontSize="16" Margin="0,0,0,10" Foreground="#555"/>
                                <TextBlock Text="• Nhấn Enter để tính kết quả" FontSize="16" Margin="0,0,0,10" Foreground="#555"/>
                                <TextBlock Text="• Bấm 📋 để xem các phép tính cũ" FontSize="16" Margin="0,0,0,10" Foreground="#555"/>
                                <TextBlock Text="• Hỗ trợ các hàm lượng giác sin, cos, tan" FontSize="16" Margin="0,0,0,10" Foreground="#555"/>
                                <TextBlock Text="• Có thể gọi các hằng số ở tab Hằng số" FontSize="16" Foreground="#555"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 2: ĐỔI ĐƠN VỊ -->
            <TabItem Header="📏 Đổi đơn vị">
                <Border Background="White" CornerRadius="0,12,12,12" BorderBrush="#E3E8EE" BorderThickness="1" Padding="30,40">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MaxWidth="1200" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*" MaxWidth="680" MinWidth="320"/>
                            </Grid.ColumnDefinitions>

                        <!-- Cột 0: Quy đổi chính -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <DockPanel Margin="0,0,0,24">
                                <Border DockPanel.Dock="Left" Background="#F3E5F5" CornerRadius="12" Padding="16,8" Margin="0,0,16,0">
                                    <TextBlock Text="📏" FontSize="28"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Đổi đơn vị" FontSize="22" FontWeight="Bold" Foreground="#7B1FA2"/>
                                    <TextBlock Text="Hỗ trợ 7 loại đơn vị đo lường phổ biến" FontSize="14" Foreground="#9E9E9E"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ComboBox Grid.ColumnSpan="3" x:Name="cboUnitType" FontSize="16" Padding="16,12" Margin="0,0,0,20" SelectionChanged="UnitType_Changed">
                                    <ComboBoxItem Content="📏 Chiều dài" IsSelected="True"/>
                                    <ComboBoxItem Content="⚖️ Khối lượng"/>
                                    <ComboBoxItem Content="🌡️ Nhiệt độ"/>
                                    <ComboBoxItem Content="📐 Diện tích"/>
                                    <ComboBoxItem Content="🧊 Thể tích"/>
                                    <ComboBoxItem Content="⏱️ Thời gian"/>
                                    <ComboBoxItem Content="⚡ Năng lượng"/>
                                </ComboBox>

                                <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFE" CornerRadius="12" Padding="20,16" BorderBrush="#E3E8EE" BorderThickness="1">
                                    <DockPanel>
                                        <ComboBox x:Name="cboFromUnit" DockPanel.Dock="Right" Width="100" FontSize="14" Padding="8,6" Margin="12,0,0,0" SelectionChanged="Convert_UnitChanged"/>
                                        <TextBox x:Name="txtFromValue" FontSize="28" Padding="4" Text="1" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="#1A237E" TextChanged="Convert_Changed"/>
                                    </DockPanel>
                                </Border>

                                <Button Grid.Row="1" Grid.Column="1" Margin="16,0" Cursor="Hand" VerticalAlignment="Center" Click="SwapUnits_Click" ToolTip="Hoán đổi">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#F5F5F5" CornerRadius="24" Width="48" Height="48">
                                                <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E8EAF6"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Border Grid.Row="1" Grid.Column="2" CornerRadius="12" Padding="20,16" BorderBrush="#CE93D8" BorderThickness="2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F3E5F5" Offset="0"/>
                                            <GradientStop Color="#EDE7F6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <DockPanel>
                                        <ComboBox x:Name="cboToUnit" DockPanel.Dock="Right" Width="100" FontSize="14" Padding="8,6" Margin="12,0,0,0" SelectionChanged="Convert_UnitChanged"/>
                                        <TextBlock x:Name="txtToValue" FontSize="32" FontWeight="Bold" Foreground="#4A148C" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" x:Name="panelSaoRegion" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Khu vực quy đổi Sào:" VerticalAlignment="Center" FontSize="13" Foreground="#555" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="cboSaoRegion" Width="180" FontSize="13" Padding="8,4" SelectionChanged="SaoRegion_SelectionChanged">
                                        <ComboBoxItem Content="Bắc Bộ (360 m²)" Tag="360" IsSelected="True"/>
                                        <ComboBoxItem Content="Trung Bộ (500 m²)" Tag="500"/>
                                        <ComboBoxItem Content="Nam Bộ (1000 m²)" Tag="1000"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="txtConvertFormula" Text="" FontSize="14" Foreground="#757575" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        </StackPanel>

                        <!-- Cột 1: Ví dụ nhanh (Presets) -->
                        <Border Grid.Column="1" Background="#FAF5FC" BorderBrush="#E1BEE7" BorderThickness="1" CornerRadius="12" Padding="16,16,6,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="⚡ Ví dụ nhanh (Presets)" FontSize="13" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,10"/>
                                    
                                    <!-- Group 1: Chiều dài -->
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#EDE7F6" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📏 Chiều dài &amp; Vũ trụ/Vi mô" FontSize="13" FontWeight="Bold" Foreground="#4527A0" Margin="0,0,0,6"/>
                                            <WrapPanel Margin="0,0,0,4">
                                                <Button Content="Thiên văn (AU)" Style="{StaticResource QuickBtnStyle}" Click="Preset_AstronomicalLength"/>
                                                <Button Content="Năm ánh sáng (ly)" Style="{StaticResource QuickBtnStyle}" Click="Preset_LightYear"/>
                                                <Button Content="Công nghệ Nano (nm)" Style="{StaticResource QuickBtnStyle}" Click="Preset_NanoLength"/>
                                                <Button Content="Màn hình (inch)" Style="{StaticResource QuickBtnStyle}" Click="Preset_InchToCm"/>
                                                <Button Content="Cao độ bay (ft -> m)" Style="{StaticResource QuickBtnStyle}" Click="Preset_FlightAltitude"/>
                                                <Button Content="Marathon (mile -> km)" Style="{StaticResource QuickBtnStyle}" Click="Preset_MarathonDistance"/>
                                                <Button Content="Độ dày tóc (μm -> mm)" Style="{StaticResource QuickBtnStyle}" Click="Preset_HairThickness"/>
                                            </WrapPanel>
                                            <TextBlock Text="• Thiên văn học dùng AU và ly để đo khoảng cách hệ Mặt Trời. Vật lý bán dẫn dùng nm đo kích thước chip." FontSize="13" Foreground="#666666" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 2: Khối lượng -->
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#EDE7F6" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="⚖️ Khối lượng &amp; Hóa học/Đời sống" FontSize="13" FontWeight="Bold" Foreground="#4527A0" Margin="0,0,0,6"/>
                                            <WrapPanel Margin="0,0,0,4">
                                                <Button Content="Y tế (mg -> g)" Style="{StaticResource QuickBtnStyle}" Click="Preset_MgToG"/>
                                                <Button Content="Nông sản (Tạ -> kg)" Style="{StaticResource QuickBtnStyle}" Click="Preset_TaToKg"/>
                                                <Button Content="Vận tải (Tấn -> kg)" Style="{StaticResource QuickBtnStyle}" Click="Preset_TanToKg"/>
                                                <Button Content="Đo Anh-Mỹ (lb -> kg)" Style="{StaticResource QuickBtnStyle}" Click="Preset_LbToKg"/>
                                                <Button Content="Kim cương (carat -> g)" Style="{StaticResource QuickBtnStyle}" Click="Preset_DiamondHope"/>
                                                <Button Content="Vàng (oz -> g)" Style="{StaticResource QuickBtnStyle}" Click="Preset_GoldOunce"/>
                                                <Button Content="Voi châu Á (tấn -> kg)" Style="{StaticResource QuickBtnStyle}" Click="Preset_AsianElephant"/>
                                            </WrapPanel>
                                            <TextBlock Text="• Y sinh học dùng mg để định liều dược phẩm. Nông nghiệp và vận tải Việt Nam dùng Tạ, Tấn để tính sản lượng." FontSize="13" Foreground="#666666" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 3: Nhiệt độ -->
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#EDE7F6" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🌡️ Nhiệt độ &amp; Nhiệt động học" FontSize="13" FontWeight="Bold" Foreground="#4527A0" Margin="0,0,0,6"/>
                                            <WrapPanel Margin="0,0,0,4">
                                                <Button Content="Thân nhiệt (37°C -> °F)" Style="{StaticResource QuickBtnStyle}" Click="Preset_BodyTemp"/>
                                                <Button Content="Không tuyệt đối (0 K -> °C)" Style="{StaticResource QuickBtnStyle}" Click="Preset_AbsoluteZero"/>
                                                <Button Content="Nước sôi (100°C -> °F)" Style="{StaticResource QuickBtnStyle}" Click="Preset_BoilingTemp"/>
                                                <Button Content="Độ chuẩn (98.6°F -> °C)" Style="{StaticResource QuickBtnStyle}" Click="Preset_StandardFahrenheit"/>
                                                <Button Content="Nướng bánh (350°F -> °C)" Style="{StaticResource QuickBtnStyle}" Click="Preset_BakingTemp"/>
                                                <Button Content="Nitơ lỏng (-196°C -> K)" Style="{StaticResource QuickBtnStyle}" Click="Preset_LiquidNitrogen"/>
                                            </WrapPanel>
                                            <TextBlock Text="• Thân nhiệt chuẩn con người là 37°C (98.6°F). Thang đo Kelvin (K) dùng trong nghiên cứu vũ trụ." FontSize="13" Foreground="#666666" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 4: Diện tích -->
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#EDE7F6" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📐 Diện tích &amp; Lâm nghiệp/Quy hoạch" FontSize="13" FontWeight="Bold" Foreground="#4527A0" Margin="0,0,0,6"/>
                                            <WrapPanel Margin="0,0,0,4">
                                                <Button Content="Địa lý (km² -> ha)" Style="{StaticResource QuickBtnStyle}" Click="Preset_Km2ToHa"/>
                                                <Button Content="Rừng (ha -> m²)" Style="{StaticResource QuickBtnStyle}" Click="Preset_HaToM2"/>
                                                <Button Content="Ruộng đất (Sào -> m²)" Style="{StaticResource QuickBtnStyle}" Click="Preset_SaoToM2"/>
                                                <Button Content="Tiết diện dây (cm² -> mm²)" Style="{StaticResource QuickBtnStyle}" Click="Preset_Cm2ToMm2"/>
                                                <Button Content="Trang trại Mỹ (acre -> m²)" Style="{StaticResource QuickBtnStyle}" Click="Preset_USFarm"/>
                                                <Button Content="Sân bóng đá (ha -> m²)" Style="{StaticResource QuickBtnStyle}" Click="Preset_FootballPitch"/>
