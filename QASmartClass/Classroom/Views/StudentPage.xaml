<Page x:Class="QASmartClass.Classroom.Views.StudentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:QASmartClass.Classroom.Views"
      Title="Học sinh" Background="#FAFAFA">
    <Page.Resources>
        <local:AvatarPathConverter x:Key="AvatarPathConverter"/>
        <local:SeatNumberConverter x:Key="SeatNumberConverter"/>
    </Page.Resources>
    
        <Grid Margin="16" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL (Master) -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <!-- shadow effect removed for perf -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Danh sách lớp học" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    </StackPanel>
                </Border>
                
                <ListBox x:Name="lstClasses" Grid.Row="1" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="LstClasses_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="4,2" CornerRadius="8" Background="Transparent">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#E0F2FE" CornerRadius="12" Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding StudentCount, StringFormat={}{0} HS}" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ClassName}" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                                        <TextBlock Text="{Binding TeacherName}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4,2"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="➕ Tạo lớp" Padding="8,6" FontSize="12" FontWeight="SemiBold" Background="#DBEAFE" Foreground="#1D4ED8"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Click="CreateRoster_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#BFDBFE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="📥 Import" Padding="8,6" FontSize="12" FontWeight="SemiBold" Background="#DCFCE7" Foreground="#166534"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Click="ImportRosterCsv_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#BBF7D0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="🔄 Tải lại" Padding="8,6" FontSize="12" FontWeight="SemiBold" Background="#F1F5F9" Foreground="#334155"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,0" Click="RefreshRosters_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT PANEL (Detail) -->
        <Border Grid.Column="1">
            <Grid Margin="0,0,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- Row 0: Dashboard Header & Stats -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👨‍🎓 Quản lý Học sinh" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="txtSubtitle" Text="Danh sách học sinh — Lớp Toán 10A" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Stat Cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="White" CornerRadius="12" Padding="16,10" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <!-- shadow removed -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥 Tổng số: " FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTotalCount" Text="20" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="16,10" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <!-- shadow removed -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🟢 Online: " FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOnlineCount" Text="18" FontSize="20" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="16,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <!-- shadow removed -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚫ Offline: " FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOfflineCount" Text="2" FontSize="20" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 1: Unified Toolbar & Search -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                <!-- shadow removed -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top Toolbar: View Toggles & Actions -->
                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="btnListView" Content="📋 Danh sách" Padding="12,8" FontSize="13" Background="#1E40AF" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnListView_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                            </Button>
                            <Button x:Name="btnSeatingView" Content="🪑 Sơ đồ lớp" Padding="12,8" FontSize="13" Background="#F1F5F9" Foreground="#334155"
                                    BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Margin="0,0,8,0" Click="BtnSeatingView_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                            </Button>
                            <Button x:Name="btnAssetView" Content="🏫 Sơ đồ thiết bị" Padding="12,8" FontSize="13" Background="#F1F5F9" Foreground="#334155"
                                    BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnAssetView_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                            </Button>
                        </StackPanel>
                        
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📥 Import" Padding="10,7" FontSize="12" Background="#DCFCE7" Foreground="#166534"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="ImportExcel_Click" ToolTip="Nhập danh sách học sinh từ tệp CSV">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#BBF7D0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Button Content="📤 Export" Padding="10,7" FontSize="12" Background="#F3E8FF" Foreground="#6B21A8"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="ExportList_Click" ToolTip="Xuất danh sách ra file CSV">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E9D5FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Border Width="1" Height="20" Background="#E2E8F0" Margin="6,0" VerticalAlignment="Center"/>
                            <Button Content="➕ Thêm mới" Padding="10,7" FontSize="12" Background="#1E40AF" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Margin="6,0,6,0" Click="AddStudent_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1D4ED8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Button Content="✏️ Sửa" Padding="10,7" FontSize="12" Background="#FFEDD5" Foreground="#C2410C"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="EditStudent_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FED7AA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Button Content="🗑️ Xóa" Padding="10,7" FontSize="12" Background="#FEE2E2" Foreground="#B91C1C"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="DeleteStudent_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FECACA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Button Content="🔄" Padding="10,7" FontSize="12" Background="#F1F5F9" Foreground="#334155"
                                    BorderThickness="0" Cursor="Hand" Click="RefreshList_Click" ToolTip="Làm mới danh sách">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E2E8F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Bottom Toolbar: Search & Filter -->
                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="txtSearch" Text="🔍 Tìm kiếm học sinh..." Width="250"
                                     FontSize="13" BorderThickness="1" BorderBrush="#CBD5E1" Padding="10,6"
                                     Foreground="#64748B" Background="#F8FAFC"
                                     TextChanged="Search_TextChanged" GotFocus="Search_GotFocus" LostFocus="Search_LostFocus">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            
                        </StackPanel>
                        
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Lọc trạng thái:" FontSize="13" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="btnFilterAll" Content="Tất cả" FontSize="12" FontWeight="SemiBold" Padding="12,6" Background="#DBEAFE" Foreground="#1D4ED8"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="FilterAll_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#BFDBFE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Button x:Name="btnFilterOnline" Content="🟢 Trực tuyến" FontSize="12" FontWeight="SemiBold" Padding="12,6" Background="#F1F5F9" Foreground="#334155"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="FilterOnline_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#DCFCE7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                            <Button x:Name="btnFilterOffline" Content="⚫ Ngoại tuyến" FontSize="12" FontWeight="SemiBold" Padding="12,6" Background="#F1F5F9" Foreground="#334155"
                                    BorderThickness="0" Cursor="Hand" Click="FilterOffline_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FEE2E2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- DataGrid / Seating Chart Wrapper -->
            <Grid Grid.Row="2">
                <!-- LIST VIEW -->
                <Border x:Name="borderListView" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Visible">
                <DataGrid x:Name="studentDataGrid" VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Background="White"
                          RowBackground="White" AlternatingRowBackground="#FAFAFA"
                          FontSize="14" RowHeight="44"
                          CanUserResizeRows="False" SelectionMode="Single"
                          CanUserSortColumns="True"
                          HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="StudentGrid_DoubleClick"
                          Sorting="StudentGrid_Sorting">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#ECEFF1"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#1A237E"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#CFD8DC"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F5F5F5"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                    <Setter Property="Foreground" Value="#0D47A1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- Avatar Column -->
                        <DataGridTemplateColumn Header="Ảnh" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#E3F2FD" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#1976D2"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Placeholder Icon if AvatarPath is empty -->
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="#1976D2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvatarPath}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Actual Avatar Image with cached loader -->
                                            <Ellipse Width="44" Height="44">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarPathConverter}}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvatarPath}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Trạng thái" Width="74" SortMemberPath="IsOnline">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center"
                                             Fill="{Binding IsOnline, Converter={x:Null}}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#9E9E9E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Số máy ↕" Binding="{Binding SeatNumber, Converter={StaticResource SeatNumberConverter}}" Width="70" SortMemberPath="SeatNumber"/>
                        <DataGridTextColumn Header="Mã HS ↕" Binding="{Binding StudentCode}" Width="75" SortMemberPath="StudentCode"/>
                        <DataGridTextColumn Header="Họ và tên ↕" Binding="{Binding FullName}" Width="*" SortMemberPath="FullName"/>
                        <DataGridTextColumn Header="Máy tính ↕" Binding="{Binding PCName}" Width="80" SortMemberPath="PCName"/>
                        <DataGridTextColumn Header="Địa chỉ IP ↕" Binding="{Binding IPAddress}" Width="120" SortMemberPath="IPAddress"/>
                        <DataGridTemplateColumn Header="Lần cuối ↕" Width="120" SortMemberPath="LastSeen">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastSeen, StringFormat={}{0:HH:mm dd/MM}}"
                                               FontSize="12" Foreground="#37474F" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Change Avatar Button -->
                        <DataGridTemplateColumn Header="Ảnh ĐD" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="📷" FontSize="14" Padding="4,2" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Đổi ảnh đại diện HS"
                                            Click="ChangeStudentAvatar_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ASSET LAYOUT VIEW -->
            <Border x:Name="borderAssetChartView" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed" Padding="15" MinHeight="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ð« Chá» Äá» thiá»t ká» tÃ i sáº£n phÃ²ng mÃ¡y:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#37474F"/>
                            <CheckBox x:Name="chkAssetEdit" Content="Cho phÃ©p di chuyá»n thiá»t bá» (Chá» Äá» thiá»t ká»)" VerticalAlignment="Center" Click="ChkAssetEdit_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
                        <Canvas x:Name="AssetCanvas" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="AssetCanvas_SizeChanged" MouseMove="AssetCanvas_MouseMove" MouseUp="AssetCanvas_MouseUp">
                            <!-- Asset elements populated in code behind -->
                        </Canvas>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- SEATING CHART VIEW -->
            <Border x:Name="borderSeatingChartView" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed" Padding="15" MinHeight="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tự động căn lề lưới chỗ ngồi:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#37474F"/>
                            <CheckBox x:Name="chkSnapToGrid" Content="Căn lưới 20px" IsChecked="True" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="btnEmergencyMode" Content="ð¨ Lá»i thoá»t kháº©n cáº¥p" Margin="15,0,0,0" Padding="8,4" FontSize="11" Background="#FFEBEE" Foreground="#C62828" Cursor="Hand" Click="BtnEmergencyMode_Click"/>
                        </StackPanel>
                        <Button Content="🔄 Sắp xếp lại sơ đồ" HorizontalAlignment="Right" Padding="8,4" FontSize="11" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Cursor="Hand" Click="BtnResetSeatingLayout_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderBrush="#1976D2" BorderThickness="1"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                        </Button>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
                        <Canvas x:Name="SeatingCanvas" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="SeatingCanvas_SizeChanged" MouseMove="SeatingCanvas_MouseMove" MouseUp="SeatingCanvas_MouseUp" TouchMove="SeatingCanvas_TouchMove" TouchUp="SeatingCanvas_TouchUp">
                            <!-- Student cards populated in code behind -->
                        </Canvas>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

            

            <!-- ═══ REMEMBERED DEVICES PANEL ═══ -->
            <Border Grid.Row="4" Margin="0,12,0,0">
                <Expander x:Name="deviceExpander" IsExpanded="False"
                          Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                          Expanded="DeviceExpander_Expanded">
                    <Expander.Header>
                        <DockPanel Width="800">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="txtDeviceCount" Text="0 thiết bị" FontSize="12" Foreground="#37474F" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="🔄 Làm mới" Padding="8,4" FontSize="11" FontWeight="SemiBold" Background="#F5F5F5" Foreground="#424242"
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Click="RefreshDevices_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderBrush="#BDBDBD" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#EEEEEE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="🗑️ Xóa tất cả" Padding="8,4" FontSize="11" FontWeight="SemiBold" Background="#FFEBEE" Foreground="#C62828"
                                        BorderThickness="0" Cursor="Hand" Click="ClearAllDevices_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderBrush="#EF5350" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFCDD2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Thiết bị đã ghi nhớ" FontSize="14" FontWeight="SemiBold" Foreground="#212121" VerticalAlignment="Center"/>
                                <TextBlock Text="  (tự động lưu khi HS kết nối)" FontSize="12" Foreground="#546E7A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Expander.Header>
                    <Border Padding="12,8" MaxHeight="280">
                        <DataGrid x:Name="deviceDataGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="White"
                                  RowBackground="White" AlternatingRowBackground="#F5F5F5"
                                  FontSize="13" RowHeight="36"
                                  CanUserResizeRows="False" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="DeviceGrid_DoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#ECEFF1"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#37474F"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#CFD8DC"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#ECEFF1"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8EAF6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#C5CAE9"/>
                                            <Setter Property="Foreground" Value="#1A237E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="💻 Máy tính" Binding="{Binding PCName}" Width="100"/>
                                <DataGridTextColumn Header="🌐 IP gần nhất" Binding="{Binding LastKnownIP}" Width="110"/>
                                <DataGridTextColumn Header="👤 Học sinh" Binding="{Binding StudentName}" Width="*"/>
                                <DataGridTextColumn Header="🆔 Mã HS" Binding="{Binding StudentCode}" Width="75"/>
                                <DataGridTextColumn Header="📱 Phiên bản" Binding="{Binding ClientVersion}" Width="75"/>
                                <DataGridTemplateColumn Header="🔗 Số lần" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E9" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ConnectionCount}" FontSize="12" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="⏰ Lần cuối" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastConnected, StringFormat={}{0:HH:mm dd/MM/yyyy}}"
                                                       FontSize="11" Foreground="#37474F" VerticalAlignment="Center" Margin="10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="📝 Ghi chú" Binding="{Binding Notes}" Width="120"/>
                                <!-- Action buttons -->
                                <DataGridTemplateColumn Header="Thao tác" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" FontSize="12" Padding="4,2" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Sửa ghi chú"
                                                        Click="EditDeviceNote_Click"/>
                                                <Button Content="❌" FontSize="12" Padding="4,2" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Xóa thiết bị"
                                                        Click="RemoveDevice_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Expander>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="5" Background="#FAFAFA" Padding="8,6" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtDeviceStatus" Text="Thiết bị sẽ được tự động ghi nhớ khi học sinh kết nối vào lớp."
                               FontSize="12" Foreground="#37474F" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
                        </Grid>
        </Border>
    </Grid>
</Page>





