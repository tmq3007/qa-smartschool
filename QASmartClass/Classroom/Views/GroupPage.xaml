<Page x:Class="QASmartClass.Classroom.Views.GroupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nhóm học tập" Background="#FAFAFA"
      Loaded="Page_Loaded">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lớp:" FontSize="12" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbClass" FontSize="12" Width="120" Margin="0,0,12,0" SelectionChanged="Class_SelectionChanged" DisplayMemberPath="DisplayName" />
                
                <TextBlock Text="Số nhóm:" FontSize="12" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbGroupCount" FontSize="12" SelectedIndex="1" Width="55" SelectionChanged="GroupCount_Changed">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                </ComboBox>
                <Button Content="🔀 Chia ngẫu nhiên" Padding="10,7" FontSize="12" Background="#1976D2" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" Click="RandomAssign_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#0D47A1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
                <Button Content="🔄 Reset" Padding="10,7" FontSize="12" Background="#FFF3E0" Foreground="#E65100"
                        BorderThickness="0" Cursor="Hand" Margin="4,0,0,0" Click="ResetGroups_Click" ToolTip="Xóa toàn bộ nhóm, đưa tất cả HS về danh sách chưa phân nhóm">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderBrush="#FF9800" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FFE0B2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
                <Button Content="📋 Giao việc nhóm" Padding="10,7" FontSize="12" Background="#F3E5F5" Foreground="#7B1FA2"
                        BorderThickness="0" Cursor="Hand" Margin="4,0,0,0" Click="AssignGroupTask_Click" ToolTip="Giao nhiệm vụ cho tất cả các nhóm">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderBrush="#9C27B0" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E1BEE7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
                <Button Content="💾 Lưu nhóm" Padding="10,7" FontSize="12" Background="#E8F5E9" Foreground="#2E7D32"
                        BorderThickness="0" Cursor="Hand" Margin="4,0,0,0" Click="SaveGroups_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderBrush="#4CAF50" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#C8E6C9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="👥 Chia nhóm học tập" FontSize="18" FontWeight="Bold" Foreground="#212121"/>
                <TextBlock x:Name="txtGroupSummary" Text="3 nhóm — 0 học sinh" FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══ Main: Left sidebar (unassigned) + Right (groups) ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="350"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Unassigned students pool -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,4,0">
                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#455A64" CornerRadius="10,10,0,0" Padding="12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="txtUnassignedCount" Text="0" FontSize="12" Foreground="White" Opacity="0.8" VerticalAlignment="Center"/>
                            <TextBlock Text="📋 Chưa phân nhóm" FontSize="14" FontWeight="Bold" Foreground="White"/>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="Kéo thả HS vào nhóm bên phải" FontSize="10" Foreground="#9E9E9E" Padding="10,4" TextAlignment="Center"/>
                    <TextBox x:Name="tbSearchUnassigned" DockPanel.Dock="Top" FontSize="12" Padding="6,4" Margin="6,2,6,4" 
                             TextChanged="SearchUnassigned_TextChanged"
                             BorderBrush="#CFD8DC" BorderThickness="1" GotFocus="Search_GotFocus" LostFocus="Search_LostFocus"
                             Foreground="Gray" Text="🔍 Nhập tên để tìm..."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="unassignedPanel" Margin="6,2,6,6"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- SPLITTER: sidebar ↔ groups -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#CFD8DC" Cursor="SizeWE" Margin="2,0"/>

            <!-- RIGHT: Groups fill available space — no outer scroll needed -->
            <Grid x:Name="groupsGrid" Grid.Column="2" Margin="4,0,0,0"/>
        </Grid>
    </Grid>
</Page>
