<Page x:Class="QASmartClass.YouthUnion.Views.AttendanceView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:QASmartClass.YouthUnion.Views"

      Title="Điểm danh Sinh hoạt" Background="{StaticResource AppBackground}" Language="vi-VN">

    <Page.Resources>
        <local:PositionConverter x:Key="PositionConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> <!-- Hướng dẫn từng bước -->
            <RowDefinition Height="Auto"/> <!-- Session Selector -->
            <RowDefinition Height="*"/> <!-- DataGrid -->
        </Grid.RowDefinitions>


        <DockPanel Margin="0,0,0,15">
            <TextBlock Text="📋 Điểm danh Sinh hoạt Đoàn" Style="{StaticResource StaffPageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnExport" Content="📤 Xuất Excel" Style="{StaticResource StaffPrimaryBtn}" Margin="0,0,10,0" Click="BtnExport_Click"/>
                <Button x:Name="BtnNewSession" Content="➕ Tạo buổi sinh hoạt" Style="{StaticResource StaffPrimaryBtn}" Click="BtnNewSession_Click"/>
            </StackPanel>
        </DockPanel>

        <Expander Grid.Row="1" Header="💡 Hướng dẫn điểm danh tự động bằng thẻ RFID" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,0,15" IsExpanded="False" FontFamily="Segoe UI">
            <StackPanel Margin="15">
                <TextBlock Text="Quy trình 3 bước thực hiện:" FontWeight="Bold" Foreground="#065F46" Margin="0,0,0,8" FontSize="13"/>
                <TextBlock Text="• Bước 1: Chọn hoặc Tạo buổi sinh hoạt Đoàn cần điểm danh ở thanh điều khiển phía dưới." Foreground="#047857" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 2: Học sinh quét thẻ thông minh qua đầu đọc RFID (cổng COM được cấu hình). Hệ thống sẽ tự động phát âm thanh và đánh dấu 'Có mặt'." Foreground="#047857" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 3: Kiểm tra lại danh sách, bổ sung ghi chú thủ công (nếu cần), sau đó nhấn nút '💾 Lưu Điểm danh' ở góc dưới bên phải." Foreground="#047857" FontSize="13"/>
            </StackPanel>
        </Expander>

        <!-- Session selector -->
        <Border Grid.Row="2" Style="{StaticResource StaffFormCard}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Buổi sinh hoạt:" VerticalAlignment="Center" Style="{StaticResource StaffFormLabel}" Margin="0,0,10,0"/>
                <ComboBox x:Name="CbSessions" Width="350" Height="35" Style="{StaticResource StaffComboBox}" SelectionChanged="CbSessions_Changed" DisplayMemberPath="Display"/>
                <TextBlock x:Name="TxtStats" Text="" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Attendance list -->
        <Border Grid.Row="3" Style="{StaticResource StaffFormCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Trạng thái quét RFID -->
                    <RowDefinition Height="*"/>    <!-- DataGrid danh sách -->
                    <RowDefinition Height="Auto"/> <!-- Nút Lưu -->
                </Grid.RowDefinitions>

                <!-- Thanh thông báo trạng thái RFID v4.2 -->
                <Border x:Name="BdrRfidStatus" Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource AntennaIcon}" Fill="#475569" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRfidStatus" Text="Trạng thái đầu đọc RFID: Đang chờ quét thẻ..." FontSize="14" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1" x:Name="DgAttendance" AutoGenerateColumns="False" BorderThickness="0" Background="White" 
                          HeadersVisibility="Column" RowHeight="40" FontSize="14" GridLinesVisibility="Horizontal"
                          RowBackground="White" AlternatingRowBackground="#F8FAFC" CanUserAddRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="80" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="2*" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding Position, Converter={StaticResource PositionConverter}}" Width="120" IsReadOnly="True"/>

                        <DataGridCheckBoxColumn Header="Có mặt" Binding="{Binding IsPresent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                        <DataGridTemplateColumn Header="Thao tác" Width="150">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Content="✏️ Sửa" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Tag="{Binding Id}" Click="BtnEditAttendance_Click" Margin="0,0,5,0"/>

                                        <Button Content="🗑️ Xóa" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="Red" Tag="{Binding Id}" Click="BtnDeleteAttendance_Click"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <Button Grid.Row="2" x:Name="BtnSaveAttendance" Content="💾 Lưu Điểm danh" Style="{StaticResource StaffSuccessBtn}" 
                        HorizontalAlignment="Right" Margin="0,15,0,0" Click="BtnSaveAttendance_Click"/>

            </Grid>

        </Border>

    </Grid>

</Page>



