<Page x:Class="QASmartClass.YouthUnion.Views.YouthUnionDashboard"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Dashboard Đoàn" Background="{StaticResource AppBackground}" Language="vi-VN">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <Grid Margin="0,0,0,20">
                <TextBlock Text="📊 Dashboard — Công tác Đoàn Thanh niên" Style="{StaticResource StaffPageTitle}"/>
                <Button Content="📥 Xuất Báo cáo PDF" Style="{StaticResource StaffSuccessBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnExportPdf_Click"/>
            </Grid>

            <!-- Stats Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource StaffFormCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="🌟 Tổng Đoàn viên" FontSize="13" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTotalMembers" Text="0" FontSize="36" FontWeight="Bold" Foreground="#3B82F6" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtActiveMembers" Text="Đang sinh hoạt: 0" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StaffFormCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="🚩 Hoạt động tháng này" FontSize="13" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtMonthActivities" Text="0" FontSize="36" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtCompletedAct" Text="Đã hoàn thành: 0" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StaffFormCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="💰 Tỷ lệ đóng phí" FontSize="13" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtFeeRate" Text="0%" FontSize="36" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtFeePaid" Text="Đã đóng: 0/0" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StaffFormCard}">
                    <StackPanel>
                        <TextBlock Text="⭐ Điểm TB Thi đua" FontSize="13" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtAvgScore" Text="0" FontSize="36" FontWeight="Bold" Foreground="#EF4444" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtTopMember" Text="" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>



            <!-- Recent Activities + Top Members -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="350"/>

                </Grid.ColumnDefinitions>



                <Border Style="{StaticResource StaffFormCard}" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="📅 Hoạt động gần đây" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                        <ItemsControl x:Name="IcRecentActivities"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StaffFormCard}">
                    <StackPanel>
                        <TextBlock Text="🏆 Top 5 Đoàn viên xuất sắc" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                        <ItemsControl x:Name="IcTopMembers"/>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</Page>



