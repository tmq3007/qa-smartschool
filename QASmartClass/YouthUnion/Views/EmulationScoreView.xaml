<Page x:Class="QASmartClass.YouthUnion.Views.EmulationScoreView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:local="clr-namespace:QASmartClass.YouthUnion.Views"

      Title="Thi đua Đoàn viên" Background="{StaticResource AppBackground}">

    <Page.Resources>
        <local:PositionConverter x:Key="PositionConverter"/>
    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/> <!-- Header -->

            <RowDefinition Height="Auto"/> <!-- Hướng dẫn nghiệp vụ -->

            <RowDefinition Height="*"/> <!-- Grid -->

        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">

            <TextBlock Text="🏆 Bảng Thi đua Đoàn viên" Style="{StaticResource StaffPageTitle}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <TextBox x:Name="TxtSearch" Width="200" Height="32" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,15,0" TextChanged="TxtSearch_TextChanged"/>

                <Button x:Name="BtnExport" Content="📤 Xuất DS" Style="{StaticResource StaffPrimaryBtn}" Margin="0,0,10,0" Click="BtnExport_Click"/>

                <Button x:Name="BtnAddScore" Content="➕ Cộng điểm" Style="{StaticResource StaffSuccessBtn}" Margin="0,0,10,0" Click="BtnAddScore_Click"/>

                <Button x:Name="BtnSubScore" Content="➖ Trừ điểm" Style="{StaticResource StaffOutlineBtn}" Click="BtnSubScore_Click"/>

            </StackPanel>

        </DockPanel>

        <!-- Lớp phủ Hướng dẫn Từng bước (v4.2) -->
        <Expander Grid.Row="1" Header="💡 Hướng dẫn ghi nhận điểm thi đua Đoàn - Đội" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,15" IsExpanded="False" FontFamily="Segoe UI">
            <StackPanel Margin="15">
                <TextBlock Text="Quy trình 3 bước thực hiện:" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8" FontSize="13"/>
                <TextBlock Text="• Bước 1: Sử dụng ô tìm kiếm để định vị Đoàn viên/Đội viên cần xử lý điểm số." Foreground="#1E3A8A" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 2: Bấm nút '➕ Cộng điểm' hoặc '➖ Trừ điểm', chọn học sinh, nhập số điểm và lý do ghi nhận." Foreground="#1E3A8A" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 3: Xem lịch sử điểm của từng học sinh bằng cách nhấn nút '📜 Xem lịch sử' trong bảng dữ liệu." Foreground="#1E3A8A" FontSize="13"/>
            </StackPanel>
        </Expander>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="15">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <DataGrid x:Name="DgScores" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" 

                      Background="White" HeadersVisibility="Column" RowHeight="42" FontSize="14" 

                      GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F8FAFC">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40"/>

                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="2*"/>

                    <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="80"/>

                    <DataGridTextColumn Header="Chức vụ" Binding="{Binding Position, Converter={StaticResource PositionConverter}}" Width="120"/>

                    <DataGridTextColumn Header="Tổng điểm" Binding="{Binding TotalScore}" Width="100">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="FontWeight" Value="Bold"/>

                                <Setter Property="Foreground" Value="#3B82F6"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Xếp loại" Binding="{Binding Grade}" Width="100"/>

                    <DataGridTemplateColumn Header="Lịch sử điểm" Width="140">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="📜 Xem lịch sử" Tag="{Binding Id}" Click="BtnHistoryScore_Click" Background="#3B82F6" Foreground="White" Padding="10,4" BorderThickness="0" Cursor="Hand"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>



