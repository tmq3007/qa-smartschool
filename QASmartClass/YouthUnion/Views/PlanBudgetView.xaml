<Page x:Class="QASmartClass.YouthUnion.Views.PlanBudgetView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:local="clr-namespace:QASmartClass.YouthUnion.Views"

      Title="Kế hoạch &amp; Ngân sách" Background="{StaticResource AppBackground}" Language="vi-VN">

    <Page.Resources>
        <local:PlanStatusConverter x:Key="PlanStatusConverter"/>
        <local:PeriodTypeConverter x:Key="PeriodTypeConverter"/>
        <local:BudgetTransactionTypeConverter x:Key="BudgetTransactionTypeConverter"/>
    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Hướng dẫn nghiệp vụ -->
            <RowDefinition Height="*"/> <!-- Tabs -->
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">
            <TextBlock Text="📊 Quản lý Kế hoạch &amp; Ngân sách" Style="{StaticResource StaffPageTitle}"/>
            <Button x:Name="BtnExport" Content="📤 Xuất Excel" Style="{StaticResource StaffPrimaryBtn}" HorizontalAlignment="Right" Click="BtnExport_Click"/>
        </DockPanel>

        <!-- Lớp phủ Hướng dẫn Từng bước (v4.2) -->
        <Expander Grid.Row="1" Header="💡 Hướng dẫn lập kế hoạch và quản lý ngân sách Đoàn" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,15" IsExpanded="False" FontFamily="Segoe UI">
            <StackPanel Margin="15">
                <TextBlock Text="Quy trình 3 bước thực hiện:" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8" FontSize="13"/>
                <TextBlock Text="• Bước 1: Tạo Kế hoạch hoạt động (Tháng/Quý/Năm) ở tab đầu tiên để được Ban giám hiệu phê duyệt." Foreground="#1E3A8A" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 2: Theo dõi các giao dịch Thu/Chi trong Sổ quỹ ngân sách Đoàn ở tab thứ hai." Foreground="#1E3A8A" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 3: Đảm bảo số tiền chi luôn nằm trong phạm vi số dư tồn quỹ để tránh lỗi giao dịch." Foreground="#1E3A8A" FontSize="13"/>
            </StackPanel>
        </Expander>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- Tab Kế hoạch -->

            <TabItem Header="Kế hoạch Hoạt động" FontSize="16" FontWeight="SemiBold">

                <Grid Margin="0,15,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lọc trạng thái:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CbFilterStatus" Width="130" Height="32" Style="{StaticResource StaffComboBox}" SelectionChanged="CbFilterStatus_Changed">
                                <ComboBoxItem Content="Tất cả" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="Bản nháp" Tag="Draft"/>
                                <ComboBoxItem Content="Đã duyệt" Tag="Approved"/>
                                <ComboBoxItem Content="Hoàn thành" Tag="Completed"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="BtnNewPlan" Content="➕ Tạo Kế hoạch" Style="{StaticResource StaffPrimaryBtn}" HorizontalAlignment="Right" Click="BtnNewPlan_Click"/>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource StaffFormCard}">
                        <DataGrid x:Name="DgPlans" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="White" HeadersVisibility="Column" RowHeight="40" FontSize="14" GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="2*"/>

                                <DataGridTextColumn Header="Loại kỳ" Binding="{Binding PeriodType, Converter={StaticResource PeriodTypeConverter}}" Width="100"/>

                                <DataGridTextColumn Header="Từ ngày" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="110"/>

                                <DataGridTextColumn Header="Đến ngày" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="110"/>

                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource PlanStatusConverter}}" Width="100"/>

                                <DataGridTextColumn Header="Người tạo" Binding="{Binding CreatedBy}" Width="100"/>

                                <DataGridTemplateColumn Header="Thao tác" Width="180">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal">

                                                <Button Content="✅ Hoàn thành" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#10B981" Tag="{Binding Id}" Click="BtnCompletePlan_Click" Margin="0,0,5,0"/>

                                                <Button Content="✏️ Sửa" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Tag="{Binding Id}" Click="BtnEditPlan_Click" Margin="0,0,5,0"/>

                                                <Button Content="🗑️ Xóa" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#EF4444" Tag="{Binding Id}" Click="BtnDeletePlan_Click"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </TabItem>



            <!-- Tab Ngân sách -->

            <TabItem Header="Sổ quỹ &amp; Ngân sách" FontSize="16" FontWeight="SemiBold">

                <Grid Margin="0,15,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    

                    <DockPanel Margin="0,0,0,15">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Tổng Thu:" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtTotalIncome" Text="0" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="5,0,20,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Tổng Chi:" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtTotalExpense" Text="0" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="5,0,20,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Tồn quỹ:" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtBalance" Text="0" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="5,0,0,0" VerticalAlignment="Center"/>

                        </StackPanel>

                        <Button x:Name="BtnNewTransaction" Content="➕ Thêm Giao dịch" Style="{StaticResource StaffSuccessBtn}" HorizontalAlignment="Right" Click="BtnNewTransaction_Click"/>

                    </DockPanel>



                    <Border Grid.Row="2" Style="{StaticResource StaffFormCard}">
                        <DataGrid x:Name="DgBudget" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="White" HeadersVisibility="Column" RowHeight="40" FontSize="14" GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110"/>

                                <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="2*"/>

                                <DataGridTextColumn Header="Loại" Binding="{Binding Type, Converter={StaticResource BudgetTransactionTypeConverter}}" Width="80"/>

                                <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" Width="120">

                                    <DataGridTextColumn.ElementStyle>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="FontWeight" Value="Bold"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Type}" Value="Income">

                                                    <Setter Property="Foreground" Value="#10B981"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Type}" Value="Expense">

                                                    <Setter Property="Foreground" Value="#EF4444"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Danh mục" Binding="{Binding Category}" Width="120"/>

                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="150"/>

                                <DataGridTemplateColumn Header="Thao tác" Width="100">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal">

                                                <Button Content="✏️" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Tag="{Binding Id}" Click="BtnEditTransaction_Click" Margin="0,0,5,0" ToolTip="Sửa"/>

                                                <Button Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#EF4444" Tag="{Binding Id}" Click="BtnDeleteTransaction_Click" ToolTip="Xóa"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Page>



