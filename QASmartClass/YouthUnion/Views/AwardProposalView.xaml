<Page x:Class="QASmartClass.YouthUnion.Views.AwardProposalView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:local="clr-namespace:QASmartClass.YouthUnion.Views"

      Title="Quản lý Khen thưởng" Background="#F0F2F5">

    <Page.Resources>
        <local:ProposalTypeConverter x:Key="ProposalTypeConverter"/>
        <local:ProposalStatusConverter x:Key="ProposalStatusConverter"/>
    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">

            <TextBlock Text="🏅 Quản lý Đề xuất &amp; Hồ sơ Khen thưởng" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="BtnExport" Content="📤 Xuất Excel" Background="#3B82F6" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,10,0" Click="BtnExport_Click"/>

                <Button x:Name="BtnNewProposal" Content="➕ Tạo đề xuất" Background="#10B981" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnNewProposal_Click"/>

            </StackPanel>

        </DockPanel>



        <!-- Đề xuất -->

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <StackPanel>

                <DockPanel Margin="0,0,0,10">

                    <TextBlock Text="Danh sách Đề xuất" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <TextBlock Text="Lọc trạng thái:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>

                        <ComboBox x:Name="CbFilterStatus" Width="130" Height="30" SelectionChanged="CbFilterStatus_Changed">

                            <ComboBoxItem Content="Tất cả" Tag="All" IsSelected="True"/>

                            <ComboBoxItem Content="Chờ duyệt" Tag="Pending"/>

                            <ComboBoxItem Content="Đã duyệt" Tag="Approved"/>

                            <ComboBoxItem Content="Từ chối" Tag="Rejected"/>

                        </ComboBox>

                    </StackPanel>

                </DockPanel>

                <DataGrid x:Name="DgProposals" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" 

                          Background="White" HeadersVisibility="Column" RowHeight="40" FontSize="14" Height="200"

                          GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F8FAFC">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Họ tên/Tập thể" Binding="{Binding Name}" Width="150"/>

                        <DataGridTextColumn Header="Loại" Binding="{Binding ProposalType, Converter={StaticResource ProposalTypeConverter}}" Width="80"/>

                        <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="2*"/>

                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource ProposalStatusConverter}}" Width="100"/>

                        <DataGridTextColumn Header="Người đề xuất" Binding="{Binding ProposedBy}" Width="120"/>

                        <DataGridTemplateColumn Header="Thao tác" Width="120">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Content="✅" ToolTip="Duyệt" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding Id}" Click="BtnApprove_Click"/>

                                        <Button Content="❌" ToolTip="Từ chối" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding Id}" Click="BtnReject_Click" Margin="5,0,0,0"/>

                                        <Button Content="✏️" ToolTip="Sửa" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding Id}" Click="BtnEditProposal_Click" Margin="5,0,0,0"/>

                                        <Button Content="🗑️" ToolTip="Xóa" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#EF4444" Tag="{Binding Id}" Click="BtnDeleteProposal_Click" Margin="5,0,0,0"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>



        <!-- Hồ sơ chính thức -->

        <TextBlock Grid.Row="2" Text="Hồ sơ Khen thưởng (Đã Duyệt)" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>

        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="15">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <DataGrid x:Name="DgRecords" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" 

                      Background="White" HeadersVisibility="Column" RowHeight="40" FontSize="14"

                      GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F8FAFC">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="150"/>

                    <DataGridTextColumn Header="Danh hiệu/Hình thức" Binding="{Binding AwardTitle}" Width="2*"/>

                    <DataGridTextColumn Header="Số Quyết định" Binding="{Binding DecisionNo}" Width="120"/>

                    <DataGridTextColumn Header="Ngày khen thưởng" Binding="{Binding AwardDate, StringFormat=dd/MM/yyyy}" Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>



