<Page x:Class="QASmartClass.YouthUnion.Views.ActivityManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:QASmartClass.YouthUnion.Views"
      Title="Quản lý Phong trào" Background="{StaticResource AppBackground}">

    <Page.Resources>
        <local:YouthActivityStatusConverter x:Key="ActivityStatusConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🚩 Quản lý Hoạt động &amp; Phong trào" Style="{StaticResource StaffPageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Lọc:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CbFilterStatus" Width="130" Height="32" SelectionChanged="CbFilterStatus_Changed" Margin="0,0,10,0">
                    <ComboBoxItem Content="Tất cả" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Bản nháp" Tag="Draft"/>
                    <ComboBoxItem Content="Đã duyệt" Tag="Approved"/>
                    <ComboBoxItem Content="Hoàn thành" Tag="Completed"/>
                </ComboBox>
                <Button x:Name="BtnExport" Content="📤 Xuất Excel" Style="{StaticResource StaffPrimaryBtn}" Margin="0,0,10,0" Click="BtnExport_Click"/>
                <Button x:Name="BtnAdd" Content="➕ Thêm Hoạt động" Style="{StaticResource StaffSuccessBtn}" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="BtnRefresh" Content="🔄 Làm mới" Style="{StaticResource StaffOutlineBtn}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </DockPanel>

        <Expander Grid.Row="1" Header="📖 Hướng dẫn sử dụng Quản lý Phong trào &amp; Hoạt động" Style="{StaticResource StaffExpanderStandard}" Margin="0,0,0,15" IsExpanded="False">
            <TextBlock TextWrapping="Wrap" Style="{StaticResource StaffBodyText}" LineHeight="20">
                • <Run FontWeight="Bold">Mục đích:</Run> Quản lý toàn bộ danh sách các phong trào, hoạt động Đoàn - Đội được tổ chức trong năm học.<LineBreak/>
                • <Run FontWeight="Bold">Quy trình:</Run> Bấm nút <Run FontWeight="Bold">Thêm Hoạt động</Run> để tạo mới một hoạt động ở trạng thái Bản nháp. Khi được phê duyệt, chuyển trạng thái thành Đã duyệt và cập nhật Hoàn thành sau khi tổ chức xong.<LineBreak/>
                • <Run FontWeight="Bold">Tác vụ hỗ trợ:</Run> Bấm nút 🔔 để gửi thông báo nhắc nhở hàng loạt đến các Đoàn viên, ✏️ để chỉnh sửa thông tin hoặc 🗑️ để xóa hoạt động.
            </TextBlock>
        </Expander>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="15">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>
            <DataGrid x:Name="DgActivities" AutoGenerateColumns="False" IsReadOnly="True" 
                      BorderThickness="0" Background="White" HeadersVisibility="Column" 
                      RowHeight="42" FontSize="14" GridLinesVisibility="Horizontal"
                      RowBackground="White" AlternatingRowBackground="#F8FAFC"
                      MouseDoubleClick="DgActivities_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Tên Hoạt động" Binding="{Binding Title}" Width="2*"/>
                    <DataGridTextColumn Header="Địa điểm" Binding="{Binding Location}" Width="150"/>
                    <DataGridTextColumn Header="Thành phần" Binding="{Binding Participants}" Width="150"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource ActivityStatusConverter}}" Width="100"/>
                    <DataGridTextColumn Header="Điểm" Binding="{Binding Points}" Width="60"/>
                    <DataGridTextColumn Header="Ngân sách" Binding="{Binding Budget, StringFormat=N0}" Width="100"/>
                    <DataGridTemplateColumn Header="" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔔" ToolTip="Gửi nhắc nhở" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Tag="{Binding Id}" Click="BtnNotify_Click" Margin="0,0,5,0"/>
                                    <Button Content="✏️" ToolTip="Sửa" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Tag="{Binding Id}" Click="BtnEdit_Click"/>
                                    <Button Content="🗑️" ToolTip="Xóa" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Tag="{Binding Id}" Click="BtnDelete_Click" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>

</Page>



