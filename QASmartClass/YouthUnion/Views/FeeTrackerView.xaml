<Page x:Class="QASmartClass.YouthUnion.Views.FeeTrackerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:QASmartClass.YouthUnion.Views"
      Title="Phí Đoàn" Background="{StaticResource AppBackground}" Language="vi-VN">

    <Page.Resources>
        <local:FeeStatusConverter x:Key="FeeStatusConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Hướng dẫn nghiệp vụ -->
            <RowDefinition Height="Auto"/> <!-- Summary Filter -->
            <RowDefinition Height="*"/> <!-- Grid -->
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">
            <TextBlock Text="💰 Theo dõi Phí Đoàn" Style="{StaticResource StaffPageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnBulkCollect" Content="Đóng phí hàng loạt" Style="{StaticResource StaffOutlineBtn}" Margin="0,0,10,0" Click="BtnBulkCollect_Click"/>
                <Button x:Name="BtnExport" Content="📤 Xuất PDF/Excel" Style="{StaticResource StaffPrimaryBtn}" Margin="0,0,10,0" Click="BtnExport_Click"/>
                <Button x:Name="BtnCollect" Content="➕ Ghi nhận đóng phí" Style="{StaticResource StaffSuccessBtn}" Click="BtnCollect_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Lớp phủ Hướng dẫn Từng bước (v4.2) -->
        <Expander Grid.Row="1" Header="💡 Hướng dẫn quản lý và thu Phí Đoàn" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,15" IsExpanded="False" FontFamily="Segoe UI">
            <StackPanel Margin="15">
                <TextBlock Text="Quy trình 3 bước thực hiện:" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8" FontSize="13"/>
                <TextBlock Text="• Bước 1: Chọn Kỳ học/Kỳ thu phí tương ứng từ hộp chọn phía dưới." Foreground="#1E3A8A" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 2: Lọc trạng thái 'Chưa đóng' để hiển thị các đoàn viên chưa hoàn thành đóng phí." Foreground="#1E3A8A" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="• Bước 3: Sử dụng nút '✏️' để ghi nhận đóng phí nhanh hoặc nút 'Đóng phí hàng loạt' cho toàn bộ học sinh được chọn." Foreground="#1E3A8A" FontSize="13"/>
            </StackPanel>
        </Expander>

        <!-- Summary -->
        <Border Grid.Row="2" Style="{StaticResource StaffFormCard}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Kỳ học:" Style="{StaticResource StaffFormLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CbPeriod" Width="150" Height="32" Style="{StaticResource StaffComboBox}" SelectionChanged="CbFilter_Changed">
                    <ComboBoxItem Content="HK1-2026" Tag="HK1-2026" IsSelected="True"/>
                    <ComboBoxItem Content="HK2-2026" Tag="HK2-2026"/>
                </ComboBox>

                <TextBlock Text="Trạng thái:" Style="{StaticResource StaffFormLabel}" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox x:Name="CbStatusFilter" Width="150" Height="32" Style="{StaticResource StaffComboBox}" SelectionChanged="CbFilter_Changed">
                    <ComboBoxItem Content="Tất cả" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Đã đóng" Tag="Paid"/>
                    <ComboBoxItem Content="Chưa đóng" Tag="Unpaid"/>
                </ComboBox>

                <TextBlock x:Name="TxtSummary" Margin="25,0,0,0" FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource StaffFormCard}">

            <DataGrid x:Name="DgFees" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" 

                      Background="White" HeadersVisibility="Column" RowHeight="40" FontSize="14" 

                      GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F8FAFC">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="80"/>

                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StudentName}" Width="2*"/>

                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding FeeDisplay}" Width="120"/>

                    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" Width="100"/>

                    <DataGridTextColumn Header="Ngày đóng" Binding="{Binding PaidDateStr}" Width="120"/>

                    <DataGridTemplateColumn Header="Thao tác" Width="140">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <Button Content="✏️" Tag="{Binding Id}" Click="BtnEditFee_Click" Background="#10B981" Foreground="White" Padding="6,2" Margin="2,0" BorderThickness="0" Cursor="Hand" ToolTip="Sửa"/>

                                    <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeleteFee_Click" Background="#EF4444" Foreground="White" Padding="6,2" Margin="2,0" BorderThickness="0" Cursor="Hand" ToolTip="Xóa"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>



