<Page x:Class="QASmartClass.YouthUnion.Views.DocumentView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:local="clr-namespace:QASmartClass.YouthUnion.Views"

      Title="Tài liệu Đoàn" Background="#F0F2F5">

    <Page.Resources>
        <local:DocumentCategoryConverter x:Key="DocumentCategoryConverter"/>
    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">

            <TextBlock Text="📁 Kho Tài liệu số" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="BtnExport" Content="📤 Xuất Excel" Background="#10B981" Foreground="White" Padding="15,8" 

                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,10,0" Click="BtnExport_Click"/>

                <Button x:Name="BtnUpload" Content="➕ Tải lên tài liệu" Background="#3B82F6" Foreground="White" Padding="15,8" 

                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnUpload_Click"/>

            </StackPanel>

        </DockPanel>



        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">

            <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Danh mục:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <ComboBox x:Name="CbCategory" Width="200" Height="35" SelectionChanged="CbCategory_Changed">

                    <ComboBoxItem Content="Tất cả" Tag="All" IsSelected="True"/>

                    <ComboBoxItem Content="Quy chế" Tag="Quy che"/>

                    <ComboBoxItem Content="Hướng dẫn" Tag="Huong dan"/>

                    <ComboBoxItem Content="Biểu mẫu" Tag="Bieu mau"/>

                    <ComboBoxItem Content="Khác" Tag="General"/>

                </ComboBox>

            </StackPanel>

        </Border>



        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="15">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <DataGrid x:Name="DgDocs" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" 

                      Background="White" HeadersVisibility="Column" RowHeight="45" FontSize="14"

                      GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F8FAFC">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Tên tài liệu" Binding="{Binding Title}" Width="3*"/>

                    <DataGridTextColumn Header="Danh mục" Binding="{Binding Category, Converter={StaticResource DocumentCategoryConverter}}" Width="150"/>

                    <DataGridTextColumn Header="Người tải lên" Binding="{Binding UploadedBy}" Width="150"/>

                    <DataGridTextColumn Header="Ngày tải lên" Binding="{Binding UploadedAt, StringFormat=dd/MM/yyyy}" Width="120"/>

                    <DataGridTemplateColumn Header="Thao tác" Width="150">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="✏️" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Tag="{Binding Id}" Click="BtnEditDoc_Click" ToolTip="Sửa" Padding="4,2"/>

                                    <Button Content="📥" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Tag="{Binding FilePath}" Click="BtnDownload_Click" ToolTip="Tải xuống" Padding="4,2" Margin="5,0,0,0"/>

                                    <Button Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Xóa" Padding="4,2" Margin="5,0,0,0"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>



