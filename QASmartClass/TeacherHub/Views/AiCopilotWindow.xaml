<Window x:Class="QASmartClass.TeacherHub.Views.AiCopilotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Copilot - Sinh câu hỏi từ văn bản" Height="500" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🤖 Trợ Giảng AI (Copilot)" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Text="Dán một đoạn văn bản hoặc tài liệu vào dưới đây, AI sẽ tự động phân tích và tạo ra các câu hỏi trắc nghiệm tương ứng." TextWrapping="Wrap" FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Nội dung văn bản gốc:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtSourceText" Height="150" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="13"/>
            
            <TextBlock Text="Môn học cho câu hỏi được tạo:" FontWeight="SemiBold" Margin="0,15,0,5"/>
            <ComboBox x:Name="CboSubject" FontSize="13" Padding="5">
                <ComboBoxItem Content="Toán"/>
                <ComboBoxItem Content="Lý"/>
                <ComboBoxItem Content="Hóa"/>
                <ComboBoxItem Content="Văn" IsSelected="True"/>
                <ComboBoxItem Content="Anh"/>
                <ComboBoxItem Content="Khác"/>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="PrgLoading" Grid.Row="0" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10" Foreground="#8B5CF6"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCancel" Grid.Column="0" Content="Hủy bỏ" Padding="0,12" FontSize="14" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
                <Button x:Name="BtnGenerate" Grid.Column="2" Content="Tạo Câu Hỏi (AI)" Padding="0,12" FontSize="14" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnGenerate_Click" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
