<UserControl x:Class="QASmartClass.TeacherHub.Views.TeacherDashboardView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             mc:Ignorable="d"

             d:DesignHeight="700" d:DesignWidth="1000" FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="1200" HorizontalAlignment="Left">

            <StackPanel Margin="24,20,24,20" Width="950">



            <!-- Header -->

            <DockPanel Margin="0,0,0,20">

                <TextBlock Text="📊 PHÂN TÍCH LỚP HỌC" FontSize="24" FontWeight="Bold"

                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                <Button x:Name="BtnRefresh" Content="🔄 Làm mới" HorizontalAlignment="Right"

                        Click="BtnRefresh_Click" Padding="16,8" FontSize="13"

                        Background="#1E88E5" Foreground="White" BorderThickness="0"/>

            </DockPanel>



            <!-- KPI Cards Row -->

            <UniformGrid Columns="3" Margin="0,0,0,24">

                <!-- Card: Điểm TB -->

                <Border Background="White" CornerRadius="10" Margin="0,0,12,0"

                        BorderBrush="#E0E0E0" BorderThickness="1" Padding="20">

                    <StackPanel>

                        <TextBlock Text="📈 Điểm TB Lớp" FontSize="13" Foreground="Gray"/>

                        <TextBlock x:Name="TxtClassAvg" Text="--" FontSize="36"

                                   FontWeight="Bold" Foreground="#1E88E5" Margin="0,4,0,0"/>

                        <TextBlock Text="/ 10.0" FontSize="13" Foreground="Gray"/>

                    </StackPanel>

                </Border>

                <!-- Card: Chuyên cần -->

                <Border Background="White" CornerRadius="10" Margin="6,0,6,0"

                        BorderBrush="#E0E0E0" BorderThickness="1" Padding="20">

                    <StackPanel>

                        <TextBlock Text="✅ Chuyên cần hôm nay" FontSize="13" Foreground="Gray"/>

                        <TextBlock x:Name="TxtAttendance" Text="--" FontSize="28"

                                   FontWeight="Bold" Foreground="#43A047" Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Card: HS cần quan tâm -->

                <Border Background="White" CornerRadius="10" Margin="12,0,0,0"

                        BorderBrush="#E0E0E0" BorderThickness="1" Padding="20">

                    <StackPanel>

                        <TextBlock Text="⚠️ HS cần quan tâm" FontSize="13" Foreground="Gray"/>

                        <TextBlock x:Name="TxtAtRisk" Text="--" FontSize="36"

                                   FontWeight="Bold" Foreground="#E53935" Margin="0,4,0,0"/>

                        <TextBlock Text="học sinh" FontSize="13" Foreground="Gray"/>

                    </StackPanel>

                </Border>

            </UniformGrid>



            <!-- Phân bố điểm -->

            <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0"

                    BorderThickness="1" Padding="20" Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="🎯 Phân bố điểm" FontSize="16" FontWeight="SemiBold"

                               Margin="0,0,0,16"/>

                    <!-- Giỏi -->

                    <Grid Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="80"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="140"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Giỏi (≥8.5)" VerticalAlignment="Center" FontSize="13"/>

                        <Border Grid.Column="1" Height="22" CornerRadius="4" Margin="8,0"

                                Background="#E3F2FD" VerticalAlignment="Center">

                            <Rectangle x:Name="BarExcellent" Height="22" Fill="#1E88E5"

                                       HorizontalAlignment="Left" RadiusX="4" RadiusY="4"/>

                        </Border>

                        <TextBlock x:Name="TxtExcellent" Grid.Column="2" Text="--"

                                   VerticalAlignment="Center" FontSize="13" Foreground="Gray"/>

                    </Grid>

                    <!-- Khá -->

                    <Grid Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="80"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="140"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Khá (7-8.4)" VerticalAlignment="Center" FontSize="13"/>

                        <Border Grid.Column="1" Height="22" CornerRadius="4" Margin="8,0"

                                Background="#E8F5E9" VerticalAlignment="Center">

                            <Rectangle x:Name="BarGood" Height="22" Fill="#43A047"

                                       HorizontalAlignment="Left" RadiusX="4" RadiusY="4"/>

                        </Border>

                        <TextBlock x:Name="TxtGood" Grid.Column="2" Text="--"

                                   VerticalAlignment="Center" FontSize="13" Foreground="Gray"/>

                    </Grid>

                    <!-- Trung bình -->

                    <Grid Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="80"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="140"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="TB (5-6.9)" VerticalAlignment="Center" FontSize="13"/>

                        <Border Grid.Column="1" Height="22" CornerRadius="4" Margin="8,0"

                                Background="#FFF8E1" VerticalAlignment="Center">

                            <Rectangle x:Name="BarAverage" Height="22" Fill="#FFA000"

                                       HorizontalAlignment="Left" RadiusX="4" RadiusY="4"/>

                        </Border>

                        <TextBlock x:Name="TxtAverage" Grid.Column="2" Text="--"

                                   VerticalAlignment="Center" FontSize="13" Foreground="Gray"/>

                    </Grid>

                    <!-- Yếu -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="80"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="140"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Yếu (&lt;5)" VerticalAlignment="Center" FontSize="13"/>

                        <Border Grid.Column="1" Height="22" CornerRadius="4" Margin="8,0"

                                Background="#FFEBEE" VerticalAlignment="Center">

                            <Rectangle x:Name="BarWeak" Height="22" Fill="#E53935"

                                       HorizontalAlignment="Left" RadiusX="4" RadiusY="4"/>

                        </Border>

                        <TextBlock x:Name="TxtWeak" Grid.Column="2" Text="--"

                                   VerticalAlignment="Center" FontSize="13" Foreground="Gray"/>

                    </Grid>

                </StackPanel>

            </Border>



            <!-- HS cần quan tâm list -->

            <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0"

                    BorderThickness="1" Padding="20">

                <StackPanel>

                    <TextBlock Text="⚠️ Danh sách học sinh cần quan tâm"

                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <ListBox x:Name="ListAtRisk" BorderThickness="0"

                             Background="Transparent" MaxHeight="200"

                             FontSize="13">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding" Value="8,6"/>

                                <Setter Property="Margin" Value="0,2"/>

                                <Setter Property="Background" Value="#FFF3E0"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border Background="{TemplateBinding Background}"

                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">

                                                <ContentPresenter/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ListBox.ItemContainerStyle>

                    </ListBox>

                    <TextBlock Text="(Không có học sinh cần quan tâm)" FontSize="13"

                               Foreground="Gray" HorizontalAlignment="Center" Margin="0,8">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Items.Count, ElementName=ListAtRisk}" Value="0">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

            </Border>



            </StackPanel>

        </Viewbox>

    </ScrollViewer>

</UserControl>



