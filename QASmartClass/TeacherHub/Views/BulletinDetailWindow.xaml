<Window x:Class="QASmartClass.TeacherHub.Views.BulletinDetailWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Chi tiết Bảng tin" Height="700" Width="900" WindowStartupLocation="CenterScreen"

        Background="#F8FAFC" FontFamily="{StaticResource InterFont}">

    <Grid Margin="30">
        <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                    <StackPanel>
                        <!-- Printable Area (for Export Image) -->
                        <Border x:Name="PrintableArea" Background="White" CornerRadius="8" Padding="20" BorderBrush="#F1F5F9" BorderThickness="1" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Header Metadata -->
                                <StackPanel Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="{Binding PriorityColor}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Priority}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤 Đăng bởi: " FontSize="14" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding CreatedBy}" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,20,0"/>
                                        
                                        <TextBlock Text="🕒 Lúc: " FontSize="14" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding CreatedAtStr}" FontSize="14" Foreground="#64748B" Margin="0,0,20,0"/>
                                        
                                        <TextBlock Text="👥 Đối tượng: " FontSize="14" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding Audience}" FontSize="14" FontWeight="Bold" Foreground="#3B82F6"/>
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Height="1" Fill="#E2E8F0" Margin="0,0,0,20"/>

                                <!-- Image -->
                                <Image x:Name="ImgBulletin" MaxHeight="300" Margin="0,0,0,20" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                
                                <!-- Content Body -->
                                <RichTextBox x:Name="RtbContent" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                            </StackPanel>
                        </Border>

                        <!-- Engagement & Interactive Area (not printed) -->
                        <Button x:Name="BtnToggleLike" Content="❤️ Thích bản tin này" 
                                Background="#FEF2F2" Foreground="#EF4444" BorderBrush="#FECACA" BorderThickness="1"
                                Padding="15,8" HorizontalAlignment="Left" FontWeight="Bold" Cursor="Hand"
                                Click="BtnToggleLike_Click" Margin="0,0,0,30"/>

                        <!-- Comments Section -->
                        <Rectangle Height="1" Fill="#E2E8F0" Margin="0,0,0,20"/>
                        <TextBlock Text="Bình luận" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                        
                        <!-- List Comments -->
                        <ItemsControl x:Name="IcComments" Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <Border Background="#E2E8F0" Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                                                    <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedBy}" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{} • {0:dd/MM HH:mm}'}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Content}" Foreground="#475569" TextWrapping="Wrap" Margin="34,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Comment -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtComment" Grid.Column="0" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                                     BorderBrush="#CBD5E1" Background="White" Foreground="#334155" FontSize="14"
                                     ToolTip="Viết bình luận của bạn..." />
                            <Button x:Name="BtnSendComment" Grid.Column="1" Content="Gửi" Width="80" Margin="10,0,0,0"
                                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                    Click="BtnSendComment_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar (not printed) -->
                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="15" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN TƯƠNG TÁC" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,15"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="👁️ Lượt xem:" FontSize="14" Foreground="#475569" Width="100"/>
                            <TextBlock Text="{Binding ViewCount}" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="❤️ Lượt thích:" FontSize="14" Foreground="#475569" Width="100"/>
                            <TextBlock Text="{Binding LikeCount}" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#CBD5E1" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="MÃ QR TRUY CẬP" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        
                        <Image x:Name="ImgQrCode" Width="150" Height="150" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Quét mã để xem chi tiết trên thiết bị di động" FontSize="12" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        
                        <Button x:Name="BtnExportImage" Content="📸 Xuất File Ảnh" Background="#10B981" Foreground="White" Padding="15,10" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Margin="0,15,0,0" Click="BtnExportImage_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>

</Window>



