<Window x:Class="QASmartClass.TeacherHub.Views.BulletinTemplateView"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Thư viện Mẫu Bảng tin" Height="600" Width="900" WindowStartupLocation="CenterScreen"

        Background="#F0F2F5" FontFamily="{StaticResource InterFont}">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Text="🎨 Thư viện Mẫu Bảng tin (Templates)" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>



        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="IcTemplates">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <WrapPanel Orientation="Horizontal" />

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="260" Height="200" Background="White" CornerRadius="12" Padding="15" Margin="0,0,15,15" BorderThickness="1" BorderBrush="#E2E8F0">

                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="*"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>

                                

                                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,10">

                                    <TextBlock Text="🖼️ Preview" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>



                                <StackPanel Grid.Row="1">

                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>

                                    <TextBlock Text="{Binding Category}" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                    <Button Content="Sử dụng mẫu này" Background="#3B82F6" Foreground="White" Padding="8" BorderThickness="0" Cursor="Hand" Click="BtnUseTemplate_Click"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <Button Grid.Row="2" Content="Đóng" HorizontalAlignment="Right" Width="100" Height="35" Background="#64748B" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,15,0,0" Click="BtnClose_Click" FontWeight="Bold"/>

    </Grid>

</Window>



