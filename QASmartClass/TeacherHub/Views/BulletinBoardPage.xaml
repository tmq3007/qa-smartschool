<Page x:Class="QASmartClass.TeacherHub.Views.BulletinBoardPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

      mc:Ignorable="d" 

      d:DesignHeight="720" d:DesignWidth="1280"

      Title="BulletinBoardPage" FontFamily="{StaticResource InterFont}" Background="#F8FAFC">



    <Grid Margin="30">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*"/>

            <ColumnDefinition Width="1*"/>

        </Grid.ColumnDefinitions>



        <!-- DANH SÁCH BẢNG TIN -->

        <Border x:Name="BorderBulletinList" Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,10,0">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                    <TextBlock Text="📢 Bảng Tin Nhà Trường" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="26" Foreground="#CBD5E1" Margin="15,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbFilter" Width="145" Height="35" FontSize="15" SelectionChanged="CbFilter_SelectionChanged" Margin="0,0,10,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tất cả đối tượng" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Chỉ Giáo viên" Tag="GV"/>
                        <ComboBoxItem Content="Chỉ Học sinh" Tag="HS"/>
                        <ComboBoxItem Content="Đoàn viên" Tag="DV"/>
                        <ComboBoxItem Content="Phụ huynh" Tag="PH"/>
                        <ComboBoxItem Content="Nhân viên" Tag="NV"/>
                    </ComboBox>
                    <ComboBox x:Name="CbCategoryFilter" Width="160" Height="35" FontSize="15" SelectionChanged="CbCategoryFilter_SelectionChanged" Margin="0,0,20,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Mọi danh mục" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="🏫 Nhà trường" Tag="School"/>
                        <ComboBoxItem Content="🚩 Đoàn - Đội" Tag="YouthUnion"/>
                        <ComboBoxItem Content="👩‍🏫 Giáo viên" Tag="Staff"/>
                        <ComboBoxItem Content="👦 Học sinh" Tag="Student"/>
                        <ComboBoxItem Content="🏅 Thi đua" Tag="Competition"/>
                        <ComboBoxItem Content="🌐 Website công khai" Tag="Public"/>
                        <ComboBoxItem Content="⚙️ Công đoàn" Tag="TradeUnion"/>
                        <ComboBoxItem Content="🎉 Kỷ niệm" Tag="Celebration"/>
                    </ComboBox>
                    <Button x:Name="BtnSlideshow" Content="📺 Trình Chiếu" Background="#F59E0B" Foreground="White" Padding="12,5" BorderThickness="0" Height="35" Cursor="Hand" Click="BtnSlideshow_Click" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </WrapPanel>



                <ListView Grid.Row="1" x:Name="LvBulletins" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">

                                <StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                        <Border Background="{Binding PriorityColor}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">

                                            <TextBlock Text="{Binding Priority}" FontSize="12" FontWeight="Bold" Foreground="White"/>

                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                    </StackPanel>

                                    

                                    <TextBlock Text="{Binding ContentPreview}" FontSize="15" Foreground="#475569" TextWrapping="Wrap" 

                                               MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,0,0,15"/>

                                    

                                    <WrapPanel Orientation="Horizontal">

                                        <TextBlock Text="👤 " FontSize="13" Foreground="#94A3B8"/>

                                        <TextBlock Text="{Binding CreatedBy}" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,15,0"/>

                                        

                                        <TextBlock Text="🕒 " FontSize="13" Foreground="#94A3B8"/>

                                        <TextBlock Text="{Binding CreatedAtStr}" FontSize="13" Foreground="#64748B" Margin="0,0,15,0"/>

                                        

                                        <TextBlock Text="👥 " FontSize="13" Foreground="#94A3B8"/>

                                        <TextBlock Text="{Binding Audience}" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,15,0"/>



                                        <TextBlock Text="👁️ " FontSize="13" Foreground="#94A3B8"/>

                                        <TextBlock Text="{Binding ViewCount}" FontSize="13" Foreground="#64748B" Margin="0,0,15,0"/>



                                        <TextBlock Text="❤️ " FontSize="13" Foreground="#94A3B8"/>

                                        <TextBlock Text="{Binding LikeCount}" FontSize="13" Foreground="#64748B" Margin="0,0,15,0"/>

                                        

                                        <Button Content="Chi tiết ➔" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" 

                                                Cursor="Hand" FontWeight="SemiBold" Padding="5,0"

                                                Click="BtnViewDetail_Click" Tag="{Binding Id}"/>

                                        <Button Content="✏️" ToolTip="Sửa" Background="Transparent" Foreground="#F59E0B" BorderThickness="0"

                                                Cursor="Hand" FontSize="14" Padding="5,0" Margin="5,0,0,0"

                                                Click="BtnEditBulletin_Click" Tag="{Binding Id}"

                                                Visibility="{Binding AdminVisibility}"/>

                                        <Button Content="🗑️" ToolTip="Xóa" Background="Transparent" Foreground="#EF4444" BorderThickness="0"

                                                Cursor="Hand" FontSize="14" Padding="5,0" Margin="5,0,0,0"

                                                Click="BtnDeleteBulletin_Click" Tag="{Binding Id}"

                                                Visibility="{Binding AdminVisibility}"/>

                                    </WrapPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>



        <!-- FORM TẠO MỚI BẢNG TIN -->

        <Border x:Name="BorderCreateBulletin" Grid.Column="1" Background="White" CornerRadius="12" Padding="25" Margin="10,0,0,0">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <DockPanel Grid.Row="0" Margin="0,0,0,20">

                    <TextBlock Text="✍️ Đăng Thông Báo Mới" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button x:Name="BtnAiSuggest" Content="✨ AI Gợi ý" Background="#8B5CF6" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnAiSuggest_Click"/>

                        <Button x:Name="BtnChooseTemplate" Content="🎨 Chọn mẫu" Background="#10B981" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand" Click="BtnChooseTemplate_Click"/>

                    </StackPanel>

                </DockPanel>



                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">

                    <StackPanel>

                        <!-- Thẻ chỉ dẫn viết tin từng bước (Step-by-step Help Wizard) -->
                        <Border x:Name="BorderHelpWizard" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="💡 HƯỚNG DẪN SOẠN TIN NHANH" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Bước 1: Nhập tiêu đề hoặc chọn từ thư viện mẫu (🎨 Chọn mẫu)." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Bước 2: Soạn nội dung chi tiết trong khung nhập liệu văn bản." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Bước 3: Đính kèm ảnh minh họa (📸 Chọn Ảnh) và chọn Đối tượng nhận tin." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Bước 4: Lựa chọn Danh mục bảng tin, Độ ưu tiên và Lên lịch (nếu cần)." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Bước 5: Bấm Đăng Lên Bảng Tin (Học sinh/Đoàn viên đăng sẽ tự động chờ duyệt)." FontSize="12" Foreground="#1E3A8A"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnHideHelp" Content="✕" Width="20" Height="20" Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Click="BtnHideHelp_Click" ToolTip="Ẩn hướng dẫn"/>
                            </Grid>
                        </Border>
                        
                        <!-- Nút hiển thị lại trợ giúp khi bị ẩn -->
                        <Button x:Name="BtnShowHelp" Content="❓ Xem hướng dẫn đăng tin" HorizontalAlignment="Right" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10" Visibility="Collapsed" Click="BtnShowHelp_Click" FontWeight="SemiBold"/>

                        <TextBlock Text="Tiêu đề:" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>

                        <TextBox x:Name="TxtTitle" Height="35" FontSize="15" Padding="5,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>



                        <TextBlock Text="Nội dung:" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>

                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,15" Background="#F8FAFC">

                            <StackPanel>

                                <!-- Format Toolbar -->

                                <Border Background="#E2E8F0" Padding="5">

                                    <StackPanel Orientation="Horizontal">

                                    <Button x:Name="BtnBold" Content="B" FontWeight="Bold" Width="30" Margin="0,0,5,0" Click="BtnFormat_Click" Tag="Bold"/>

                                    <Button x:Name="BtnItalic" Content="I" FontStyle="Italic" Width="30" Margin="0,0,5,0" Click="BtnFormat_Click" Tag="Italic"/>

                                    <Button x:Name="BtnUnderline" Content="U" Width="30" Margin="0,0,5,0" Click="BtnFormat_Click" Tag="Underline">

                                        <Button.Template>

                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#CBD5E1" CornerRadius="2">

                                                    <TextBlock Text="U" TextDecorations="Underline" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Button.Template>

                                    </Button>

                                    <Rectangle Width="1" Fill="#94A3B8" Margin="5,0"/>

                                    <Button x:Name="BtnColorRed" Background="#E11D48" Width="20" Height="20" Margin="5,0" Click="BtnColor_Click" Tag="Red" ToolTip="Màu đỏ Crimson"/>

                                    <Button x:Name="BtnColorBlue" Background="#2563EB" Width="20" Height="20" Margin="5,0" Click="BtnColor_Click" Tag="Blue" ToolTip="Màu xanh Cobalt"/>

                                    <Button x:Name="BtnColorBlack" Background="#1E293B" Width="20" Height="20" Margin="5,0" Click="BtnColor_Click" Tag="Black" ToolTip="Màu đen Charcoal"/>

                                    </StackPanel>

                                </Border>

                                <RichTextBox x:Name="RtbContent" Height="150" Background="Transparent" BorderThickness="0" Padding="5">

                                    <FlowDocument>

                                        <Paragraph></Paragraph>

                                    </FlowDocument>

                                </RichTextBox>

                            </StackPanel>

                        </Border>



                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                            <TextBlock Text="Đính kèm Ảnh:" FontSize="15" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Button x:Name="BtnUploadImage" Content="📸 Chọn Ảnh..." Padding="10,5" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="BtnUploadImage_Click"/>

                            <TextBlock x:Name="TxtImagePath" Text="" FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>

                        </StackPanel>

                        <Grid x:Name="GridPreview" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,15">
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <Image x:Name="ImgPreview" Height="100" Stretch="Uniform" HorizontalAlignment="Left"/>
                            </Border>
                            <Button x:Name="BtnRemoveImage" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnRemoveImage_Click" ToolTip="Xóa ảnh">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Margin="0,-1,0,0"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Đối tượng nhận tin:" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CbAudience" Height="35" FontSize="15" Margin="0,0,0,15" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Tất cả mọi người" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Chỉ Giáo viên" Tag="GV"/>
                            <ComboBoxItem Content="Chỉ Học sinh" Tag="HS"/>
                            <ComboBoxItem Content="Đoàn viên" Tag="DV"/>
                            <ComboBoxItem Content="Phụ huynh" Tag="PH"/>
                            <ComboBoxItem Content="Nhân viên" Tag="NV"/>
                        </ComboBox>

                        <TextBlock Text="Danh mục bảng tin:" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CbCategory" Height="35" FontSize="15" Margin="0,0,0,15">
                            <ComboBoxItem Content="🏫 Nhà trường" Tag="School" IsSelected="True"/>
                            <ComboBoxItem Content="🚩 Đoàn - Đội" Tag="YouthUnion"/>
                            <ComboBoxItem Content="👩‍🏫 Giáo viên" Tag="Staff"/>
                            <ComboBoxItem Content="👦 Học sinh" Tag="Student"/>
                            <ComboBoxItem Content="🏅 Thi đua" Tag="Competition"/>
                            <ComboBoxItem Content="🌐 Website công khai" Tag="Public"/>
                            <ComboBoxItem Content="⚙️ Công đoàn" Tag="TradeUnion"/>
                            <ComboBoxItem Content="🎉 Kỷ niệm" Tag="Celebration"/>
                        </ComboBox>



                        <TextBlock Text="Độ ưu tiên:" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>

                        <ComboBox x:Name="CbPriority" Height="35" FontSize="15" Margin="0,0,0,15">

                            <ComboBoxItem Content="Bình thường" Tag="Normal" IsSelected="True"/>

                            <ComboBoxItem Content="Quan trọng" Tag="High"/>

                            <ComboBoxItem Content="Thấp" Tag="Low"/>

                        </ComboBox>



                        <!-- P2-06: Scheduling -->

                        <CheckBox x:Name="ChkSchedule" Content="⏰ Lên lịch xuất bản" FontSize="14"

                                  Foreground="#334155" Margin="0,0,0,8"

                                  Checked="ChkSchedule_Changed" Unchecked="ChkSchedule_Changed"/>

                        <StackPanel x:Name="PanelSchedule" Visibility="Collapsed">
                            <TextBlock Text="Ngày giờ xuất bản:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <DatePicker x:Name="DpScheduledAt" FontSize="14" Width="150" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ComboBox x:Name="CbScheduledHour" Width="55" Height="28" FontSize="13"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                    <ComboBox x:Name="CbScheduledMinute" Width="55" Height="28" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Ngày hết hạn (tùy chọn):" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,10">
                                <DatePicker x:Name="DpExpiresAt" FontSize="14" Width="150" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ComboBox x:Name="CbExpiresHour" Width="55" Height="28" FontSize="13"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                    <ComboBox x:Name="CbExpiresMinute" Width="55" Height="28" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>



                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnPost" Content="Đăng Lên Bảng Tin" Height="45" Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnPost_Click"/>
                    <Button Grid.Column="1" x:Name="BtnCancelEdit" Content="Hủy" Width="90" Height="45" Background="#64748B" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" Visibility="Collapsed" Click="BtnCancelEdit_Click"/>
                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>



