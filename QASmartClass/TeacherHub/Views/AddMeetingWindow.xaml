<Window x:Class="QASmartClass.TeacherHub.Views.AddMeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo biên bản sinh hoạt tổ chuyên môn" Height="680" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F8FAFC"
        FontFamily="Inter, Segoe UI, Arial, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="📝 Tạo biên bản sinh hoạt tổ" 
                   FontFamily="Outfit, Segoe UI, Arial, sans-serif" 
                   FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Form fields inside ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" Padding="0,0,10,0">
            <StackPanel>
                
                <!-- Department ComboBox (Editable) -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Tên tổ chuyên môn:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboDept" IsEditable="True" Height="40" Padding="6" Background="White" FontSize="13" VerticalContentAlignment="Center"/>
                    <TextBlock Text="💡 Bạn có thể chọn tổ có sẵn hoặc tự nhập tên tổ mới." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Date of Meeting -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Ngày họp:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDate" Height="40" FontSize="13" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Agenda -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Nội dung nghị sự:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAgenda" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="13"/>
                </StackPanel>

                <!-- Minutes -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Biên bản chi tiết cuộc họp:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMinutes" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="13"/>
                </StackPanel>

                <!-- Attendees -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Thành phần dự họp (cách nhau bằng dấu phẩy):" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAttendees" Height="40" Padding="8,4" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="13"/>
                </StackPanel>

                <!-- Action Items -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Công việc giao (mỗi dòng 1 việc):" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAction" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="13"/>
                    
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="10" Margin="0,6,0,0" BorderBrush="#BFDBFE" BorderThickness="1">
                        <TextBlock Text="💡 Phân công nhanh: Bắt đầu dòng bằng [Tên Người Nhận] để tự động gán việc. (Ví dụ: [Cô Thảo] Soạn đề cương)" 
                                   FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Due Date for actions -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Hạn hoàn thành công việc:" FontSize="13" Foreground="#64748B" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDueDate" Height="40" FontSize="13" VerticalContentAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy bỏ" Width="100" Height="40" 
                        Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Lưu biên bản" Width="140" Height="40" 
                        Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
