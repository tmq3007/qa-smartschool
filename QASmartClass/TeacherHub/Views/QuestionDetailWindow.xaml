<Window x:Class="QASmartClass.TeacherHub.Views.QuestionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết và Kiểm định câu hỏi" Height="580" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Inter, Segoe UI, Arial, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔍 Thẩm định chi tiết câu hỏi" FontFamily="Outfit, Segoe UI, Arial, sans-serif" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtMeta" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="BdrStatus" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                
                <!-- Metadata Grid -->
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Môn học" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSubject" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Khối lớp" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtGrade" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="Dạng câu hỏi" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtType" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Độ khó" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtDifficulty" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Điểm số" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtPoints" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Thời gian giới hạn" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTimeLimit" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Question Text -->
                <TextBlock Text="Nội dung câu hỏi:" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                    <TextBlock x:Name="TxtContent" FontSize="14" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="20"/>
                </Border>

                <!-- Image Container (NEW v4.2) -->
                <TextBlock x:Name="LblQuestionImage" Text="Hình ảnh minh họa:" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4" Visibility="Collapsed"/>
                <Border x:Name="BdrQuestionImage" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <Image x:Name="ImgQuestion" MaxHeight="250" Stretch="Uniform" HorizontalAlignment="Center" Cursor="Hand" MouseDown="ImgQuestion_MouseDown" ToolTip="Nhấp chuột để xem hình lớn"/>
                        <TextBlock x:Name="TxtImageCaption" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Options / Answers -->
                <TextBlock x:Name="LblOptions" Text="Các phương án lựa chọn:" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                <Border x:Name="BdrOptions" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                    <ItemsControl x:Name="LstOptions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4" Background="#F8FAFC" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Correct Answer -->
                <TextBlock Text="Đáp án đúng:" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                <Border Background="#ECFDF5" CornerRadius="8" Padding="15" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,0,15">
                    <TextBlock x:Name="TxtCorrectAnswer" FontSize="14" FontWeight="Bold" Foreground="#047857" TextWrapping="Wrap"/>
                </Border>

                <!-- Explanation -->
                <TextBlock Text="Lời giải chi tiết:" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                    <TextBlock x:Name="TxtExplanation" FontSize="13" Foreground="#475569" TextWrapping="Wrap" LineHeight="18"/>
                </Border>

                <!-- Rejection Review Comments (If previously rejected) -->
                <StackPanel x:Name="PnlReviewComments" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Góp ý trước đó:" FontSize="14" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,4"/>
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="15" BorderBrush="#FEE2E2" BorderThickness="1">
                        <TextBlock x:Name="TxtReviewComments" FontSize="13" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Actions Footer -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Đóng lại" Width="100" Height="40" 
                        Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="2" x:Name="PnlActionButtons" Orientation="Horizontal">
                    <Button Content="Yêu cầu hiệu chỉnh" Width="150" Height="40" Margin="0,0,10,0"
                            Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" Click="BtnReject_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Phê duyệt câu hỏi" Width="150" Height="40" 
                            Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnApprove_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
