<Page x:Class="QASmartClass.TeacherHub.Views.MyTasksView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="My Tasks (Kanban)" Background="#F0F2F5">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="📌 Việc Cần Làm (Kanban Board)" FontSize="24" FontWeight="Bold" Foreground="#212121"/>

            <TextBlock Text="Kéo thả thẻ công việc để thay đổi trạng thái tiến độ." Foreground="#757575" Margin="0,5,0,0"/>

        </StackPanel>



        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- To Do Column -->

            <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Border Background="#FF9800" CornerRadius="4" Padding="5" Margin="0,0,0,10">

                        <TextBlock Text="🔴 Mới giao (Pending)" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                    </Border>

                    <ListBox x:Name="lstPending" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,10">

                                    <Border.Effect><DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="4" ShadowDepth="1"/></Border.Effect>

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Department}" Foreground="#1976D2" FontSize="11" Margin="0,5,0,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                            <TextBlock Text="🕒 Hạn: " Foreground="#757575" FontSize="12"/>

                                            <TextBlock Text="{Binding DueDate, StringFormat='dd/MM'}" Foreground="#D32F2F" FontSize="12" FontWeight="SemiBold"/>

                                        </StackPanel>

                                        <Button Content="Bắt đầu làm ➡️" Margin="0,10,0,0" Padding="5" Background="#E3F2FD" Foreground="#1976D2" BorderThickness="0" Cursor="Hand" Click="BtnStart_Click" Tag="{Binding Id}"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>



            <!-- Doing Column -->

            <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="10,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Border Background="#2196F3" CornerRadius="4" Padding="5" Margin="0,0,0,10">

                        <TextBlock Text="🟡 Đang làm (In Progress)" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                    </Border>

                    <ListBox x:Name="lstInProgress" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,10">

                                    <Border.Effect><DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="4" ShadowDepth="1"/></Border.Effect>

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Department}" Foreground="#1976D2" FontSize="11" Margin="0,5,0,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                            <TextBlock Text="🕒 Hạn: " Foreground="#757575" FontSize="12"/>

                                            <TextBlock Text="{Binding DueDate, StringFormat='dd/MM'}" Foreground="#D32F2F" FontSize="12" FontWeight="SemiBold"/>

                                        </StackPanel>

                                        <Button Content="Hoàn thành ✅" Margin="0,10,0,0" Padding="5" Background="#E8F5E9" Foreground="#4CAF50" BorderThickness="0" Cursor="Hand" Click="BtnDone_Click" Tag="{Binding Id}"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>



            <!-- Done Column -->

            <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="10,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Border Background="#4CAF50" CornerRadius="4" Padding="5" Margin="0,0,0,10">

                        <TextBlock Text="🟢 Hoàn thành (Done)" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                    </Border>

                    <ListBox x:Name="lstDone" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,10" Opacity="0.7">

                                    <Border.Effect><DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="4" ShadowDepth="1"/></Border.Effect>

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" TextDecorations="Strikethrough" Foreground="#757575"/>

                                        <TextBlock Text="{Binding Department}" Foreground="#9E9E9E" FontSize="11" Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>



