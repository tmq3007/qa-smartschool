<Window x:Class="QASmartClass.TeacherHub.Views.BulletinSlideshowWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Bảng Tin Thông Minh" Height="1080" Width="1920" 

        WindowStyle="None" WindowState="Maximized" 

        Topmost="True" Background="#0F172A" FontFamily="{StaticResource InterFont}"

        KeyDown="Window_KeyDown">



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="100"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="80"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <Border Grid.Row="0" Background="#1E293B" Padding="40,20">

            <DockPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">

                    <TextBlock Text="QA" FontSize="40" FontWeight="Black" Foreground="#3B82F6"/>

                    <TextBlock Text="SMART" FontSize="40" FontWeight="Black" Foreground="White"/>

                    <TextBlock Text="BULLETIN" FontSize="40" FontWeight="Light" Foreground="#94A3B8" Margin="10,0,0,0"/>

                </StackPanel>

                

                <TextBlock x:Name="TxtClock" Text="00:00" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" Foreground="#38BDF8"/>

            </DockPanel>

        </Border>



        <!-- Main Content -->

        <Border Grid.Row="1" Margin="100,50" Background="White" CornerRadius="20">

            <Border.Effect>

                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.3"/>

            </Border.Effect>

            

            <Grid Margin="50">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>

                

                <!-- Text Area -->

                <StackPanel Grid.Column="0" Margin="0,0,50,0">

                    <Border x:Name="BorderPriority" HorizontalAlignment="Left" CornerRadius="8" Padding="15,5" Margin="0,0,0,20">

                        <TextBlock x:Name="TxtPriority" FontSize="20" FontWeight="Bold" Foreground="White"/>

                    </Border>

                    

                    <TextBlock x:Name="TxtTitle" FontSize="60" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="75"/>

                    

                    <RichTextBox x:Name="RtbContent" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="28" Foreground="#334155"/>

                </StackPanel>



                <!-- Media & QR Area -->

                <Grid Grid.Column="1">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    

                    <Border x:Name="BorderImageContainer" CornerRadius="12" ClipToBounds="True" Background="#F1F5F9">

                        <Image x:Name="ImgBulletin" Stretch="Uniform" Visibility="Collapsed"/>

                    </Border>

                    

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="30" Margin="0,30,0,0" HorizontalAlignment="Center">

                        <StackPanel>

                            <TextBlock Text="QUÉT ĐỂ XEM CHI TIẾT" FontSize="20" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <Image x:Name="ImgQrCode" Width="250" Height="250" HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </Border>



        <!-- Footer -->

        <Border Grid.Row="2" Background="#1E293B">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="Đang trình chiếu bản tin: " FontSize="20" Foreground="#94A3B8"/>

                <TextBlock x:Name="TxtProgress" Text="1 / 5" FontSize="20" FontWeight="Bold" Foreground="White"/>

                <TextBlock Text=" | Nhấn ESC để thoát" FontSize="20" Foreground="#64748B" Margin="20,0,0,0"/>

            </StackPanel>

        </Border>

        

        <!-- Progress Bar (Timer) -->

        <Grid Grid.Row="2" VerticalAlignment="Top" Height="4">

            <Border x:Name="ProgressBar" Background="#3B82F6" HorizontalAlignment="Left" Width="0"/>

        </Grid>

    </Grid>

</Window>



