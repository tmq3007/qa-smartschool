<Window x:Class="QASmartClass.TeacherHub.Views.RejectCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Góp ý hiệu chỉnh câu hỏi" Height="280" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Inter, Segoe UI, Arial, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Yêu cầu hiệu chỉnh &amp; Góp ý" 
                   FontFamily="Outfit, Segoe UI, Arial, sans-serif" 
                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

        <!-- Description -->
        <TextBlock Grid.Row="1" Text="Nhập nội dung góp ý hoặc yêu cầu hiệu chỉnh để gửi lại giáo viên biên soạn:" 
                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Input TextBox -->
        <TextBox Grid.Row="2" x:Name="TxtComment" 
                  AcceptsReturn="True" 
                  TextWrapping="Wrap" 
                  MaxLength="500"
                  Padding="8"
                  BorderBrush="#CBD5E1" 
                  BorderThickness="1"
                  Background="White" 
                  FontSize="13"
                  VerticalScrollBarVisibility="Auto"
                  GotFocus="TxtComment_GotFocus"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy bỏ" Width="90" Height="40" 
                    Background="#F1F5F9" Foreground="#475569" 
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" 
                    Click="BtnCancel_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <Button Content="Gửi góp ý" Width="130" Height="40" 
                    Background="#4F46E5" Foreground="White" FontWeight="SemiBold" 
                    BorderThickness="0" Cursor="Hand" 
                    Click="BtnConfirm_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
