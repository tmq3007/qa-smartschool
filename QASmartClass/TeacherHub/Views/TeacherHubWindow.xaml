<Window x:Class="QASmartClass.TeacherHub.Views.TeacherHubWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:viewmodels="clr-namespace:QASmartClass.TeacherHub.ViewModels"

        xmlns:local="clr-namespace:QASmartClass.TeacherHub.Views"

        Title="Giáo Viên Bộ Môn - QA SmartSchool" Height="768" Width="1366"

        WindowStartupLocation="CenterScreen"

        FontFamily="Segoe UI" Background="{DynamicResource AppBackground}">



    <Window.DataContext>

        <viewmodels:TeacherHubViewModel />

    </Window.DataContext>



    <Window.Resources>

        <DataTemplate DataType="{x:Type viewmodels:TeacherDashboardViewModel}">

            <local:TeacherDashboardView />

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TeacherClassesViewModel}">

            <Border Padding="10">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="📚 Quản Lý Lớp Học" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" Foreground="#64748B" Margin="0,0,0,15"/>

                    <ListView Grid.Row="2" ItemsSource="{Binding Classes}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">

                                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="50"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="20" Background="#EFF6FF" HorizontalAlignment="Center">

                                            <TextBlock Text="🏫" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0">

                                            <TextBlock Text="{Binding ClassName}" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>

                                            <TextBlock Text="{Binding DisplayInfo}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding CreatedDisplay}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>

                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalStudents}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TeacherGradingViewModel}">

            <local:TeacherGradingView />

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TeacherAssignmentsViewModel}">

            <Border Padding="10">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="📋 Quản Lý Bài Tập" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" Foreground="#64748B" Margin="0,0,0,15"/>

                    <ListView Grid.Row="2" ItemsSource="{Binding Assignments}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">

                                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">

                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="White"/>

                                            </Border>

                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#475569" MaxHeight="40" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding DeadlineDisplay}" FontSize="12" Foreground="#94A3B8" Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>

        </DataTemplate>



        <Style x:Key="SidebarBtnStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="20,15"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}">

                            <ContentPresenter Margin="{TemplateBinding Padding}" 

                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"

                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#34495E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <!-- Sidebar -->

        <Border Grid.Column="0" Background="#2C3E50">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <TextBlock Text="TEACHER PORTAL" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,30,20,40" />

                

                <Button Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource SidebarBtnStyle}" Click="BtnClearFrame_Click">

                    <DockPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Command="{Binding NavigateToClassesCommand}" Style="{StaticResource SidebarBtnStyle}" Click="BtnClearFrame_Click">

                    <DockPanel><TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#81C784" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Lớp học" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Command="{Binding NavigateToGradingCommand}" Style="{StaticResource SidebarBtnStyle}" Click="BtnClearFrame_Click">

                    <DockPanel><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFB74D" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Chấm điểm" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Command="{Binding NavigateToAssignmentsCommand}" Style="{StaticResource SidebarBtnStyle}" Click="BtnClearFrame_Click">

                    <DockPanel><TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#CE93D8" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Bài tập" VerticalAlignment="Center"/></DockPanel>

                </Button>



                <TextBlock Text="TÍNH NĂNG MỚI (V5.0)" Foreground="#7F8C8D" FontSize="14" FontWeight="Bold" Margin="20,30,20,10" />

                <Button Click="BtnNavLessonPlan_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Soạn Giáo Án" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavHomeroom_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A5D6A7" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Sổ Chủ Nhiệm" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavEmulation_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FDD835" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Thi Đua Lớp" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavBulletin_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF9A9A" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Bảng Tin" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavAi_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#80DEEA" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="AI Assistant" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavQuestionBank_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#F48FB1" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Ngân Hàng Câu Hỏi" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavDeptMeeting_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B39DDB" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Sinh Hoạt Tổ CM" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <!-- MI Dashboard -->

                <Button Click="BtnNavClassMIDashboard_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="MI Dashboard Lớp" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <!-- V7 M1.2 -->

                <Button Click="BtnNavDeptHeadReview_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Kiểm Định Đề Thi" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavSkkn_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFB300" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Sáng kiến kinh nghiệm" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavRemedial_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE7BC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E74C3C" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Phụ đạo HS Yếu" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <!-- F3.2 -->

                <Button Click="BtnNavParentApproval_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Ký Duyệt (Phụ huynh)" VerticalAlignment="Center"/></DockPanel>

                </Button>

                

                <TextBlock Text="P3-05: ĐOÀN - ĐỘI" Foreground="#7F8C8D" FontSize="14" FontWeight="Bold" Margin="20,30,20,10" />

                <Button Click="BtnNavYouthDashboard_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Dashboard Đoàn" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthMembers_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF8A65" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Quản lý Đoàn viên" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthRecruitment_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Kết nạp Đoàn" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthAttendance_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Điểm danh" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthActivities_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4DB6AC" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Hoạt động - Phong trào" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthEventReg_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE8ED;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EC4899" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Đăng ký Sự kiện" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthEmulation_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Thi đua Đoàn viên" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthAward_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EAB308" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Hồ sơ Khen thưởng" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthFee_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Đóng Phí Đoàn" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthVoting_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Bầu cử trực tuyến" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthDocument_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Kho Tài liệu" VerticalAlignment="Center"/></DockPanel>

                </Button>

                <Button Click="BtnNavYouthPlanBudget_Click" Style="{StaticResource SidebarBtnStyle}">

                    <DockPanel><TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#14B8A6" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Kế hoạch &amp; Ngân sách" VerticalAlignment="Center"/></DockPanel>

                </Button>

            </StackPanel>

            </ScrollViewer>

        </Border>



        <!-- Main Content -->

        <Border Grid.Column="1" Background="{DynamicResource AppBackground}" Padding="20">

            <Grid>

                <!-- MVVM Content -->

                <ContentControl Content="{Binding CurrentViewModel}" />

                

                <!-- Frame để test các Page mới tạo -->

                <Frame x:Name="FeatureFrame" NavigationUIVisibility="Hidden" Background="{DynamicResource AppBackground}" Visibility="Collapsed"/>

            </Grid>

        </Border>

    </Grid>

</Window>



