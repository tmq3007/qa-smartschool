<Window x:Class="QASmartClass.TeacherHub.Views.SoftSkillRubricWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Chấm điểm Kỹ năng mềm (Rubric)" Height="500" Width="450"

        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"

        FontFamily="Segoe UI" Background="#F8FAFC">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0" Text="🧠 Kỹ Năng Mềm (Rubric)" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>

        <TextBlock x:Name="TxtStudentName" Grid.Row="1" Text="Học sinh: Nguyễn Văn A" FontSize="14" Foreground="#64748B" Margin="0,0,0,20"/>



        <StackPanel Grid.Row="2">

            <!-- Teamwork -->

            <TextBlock Text="🤝 Làm việc nhóm (Teamwork)" FontWeight="SemiBold" Margin="0,0,0,5"/>

            <DockPanel Margin="0,0,0,15">

                <TextBlock x:Name="TxtTeamworkVal" DockPanel.Dock="Right" Text="5.0" Width="40" TextAlignment="Right" FontWeight="Bold" Foreground="#3B82F6"/>

                <Slider x:Name="SldTeamwork" Minimum="0" Maximum="10" Value="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            </DockPanel>



            <!-- Presentation -->

            <TextBlock Text="🎤 Kỹ năng thuyết trình (Presentation)" FontWeight="SemiBold" Margin="0,0,0,5"/>

            <DockPanel Margin="0,0,0,15">

                <TextBlock x:Name="TxtPresentationVal" DockPanel.Dock="Right" Text="5.0" Width="40" TextAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>

                <Slider x:Name="SldPresentation" Minimum="0" Maximum="10" Value="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            </DockPanel>



            <!-- Critical Thinking -->

            <TextBlock Text="🔍 Tư duy phản biện (Critical Thinking)" FontWeight="SemiBold" Margin="0,0,0,5"/>

            <DockPanel Margin="0,0,0,15">

                <TextBlock x:Name="TxtCriticalVal" DockPanel.Dock="Right" Text="5.0" Width="40" TextAlignment="Right" FontWeight="Bold" Foreground="#F59E0B"/>

                <Slider x:Name="SldCritical" Minimum="0" Maximum="10" Value="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            </DockPanel>



            <TextBlock Text="Ghi chú thêm:" FontWeight="SemiBold" Margin="0,10,0,5"/>

            <TextBox x:Name="TxtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>

        </StackPanel>



        <Grid Grid.Row="3" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="10"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Hủy bỏ" Padding="0,10" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>

            <Button Grid.Column="2" Content="Lưu Đánh Giá" Padding="0,10" Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnSave_Click" Cursor="Hand"/>

        </Grid>

    </Grid>

</Window>



