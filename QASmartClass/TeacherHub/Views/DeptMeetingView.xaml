<UserControl x:Class="QASmartClass.TeacherHub.Views.DeptMeetingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Inter, Segoe UI, Arial, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <TextBlock Text="📋 Sinh Hoạt Tổ Chuyên Môn" FontFamily="Outfit, Segoe UI, Arial, sans-serif" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button x:Name="BtnAdd" Content="＋ Tạo biên bản" Click="BtnAdd_Click"
                    DockPanel.Dock="Right" VerticalAlignment="Center"
                    FontSize="13" MinHeight="40" Padding="14,0" Background="#3B82F6"
                    Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>



        <!-- Filter -->

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">

            <TextBlock Text="Tổ:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>

            <ComboBox x:Name="CboDept" Width="180" Height="40" FontSize="13" VerticalContentAlignment="Center" SelectionChanged="CboDept_Changed"/>

        </StackPanel>



        <!-- Meeting List + Actions -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="350"/>

            </Grid.ColumnDefinitions>



            <!-- Meetings -->

            <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,8,0"

                    BorderBrush="#E2E8F0" BorderThickness="1">

                <ListView x:Name="LvMeetings" BorderThickness="0" SelectionChanged="LvMeetings_SelectionChanged">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>

                                    <TextBlock Text="{Binding DateStr}" FontSize="11" Foreground="#64748B"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Border>



            <!-- Action Items panel -->

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14"

                    BorderBrush="#E2E8F0" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="📌 Công việc theo dõi" FontSize="15" FontWeight="SemiBold"

                               Foreground="#1E293B" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="LstActions">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="8,6" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">

                                    <DockPanel>

                                        <CheckBox IsChecked="{Binding IsCompleted}" Margin="0,0,8,0"

                                                  Click="ActionCheck_Click" Tag="{Binding Id}"/>

                                        <StackPanel>

                                            <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#1E293B"

                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Info}" FontSize="11" Foreground="#94A3B8"/>

                                        </StackPanel>

                                    </DockPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <TextBlock x:Name="TxtNoActions" Text="📝 Chọn biên bản cuộc họp bên trái để theo dõi các công việc được phân công."
                               FontSize="13" Foreground="#94A3B8" Margin="0,20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>



