<Page x:Class="QASmartClass.TeacherHub.Views.SkknView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Quản lý Sáng kiến Kinh nghiệm" Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <DockPanel Margin="0,0,0,20">

            <TextBlock Text="💡 Quản lý Sáng kiến Kinh nghiệm (SKKN)" FontSize="24" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

            <Button x:Name="BtnNewSkkn" Content="＋ Nộp SKKN mới" Click="BtnNewSkkn_Click" HorizontalAlignment="Right" Background="#3B82F6" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>

        </DockPanel>



        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <TextBlock Text="Danh sách SKKN đã nộp" FontSize="18" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15"/>



                <ListView Grid.Row="1" x:Name="LvSkkns" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#F1F5F9" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>



                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                            <TextBlock Text="{Binding Subject}" FontSize="13" Foreground="#64748B" Margin="0,0,15,0"/>

                                            <TextBlock Text="{Binding Level}" FontSize="13" Foreground="#64748B" Margin="0,0,15,0"/>

                                            <TextBlock Text="{Binding SubmittedAt, StringFormat=dd/MM/yyyy}" FontSize="13" Foreground="#94A3B8"/>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasNote}">

                                            <TextBlock Text="Ghi chú duyệt:" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,5,0"/>

                                            <TextBlock Text="{Binding ReviewNote}" FontSize="13" Foreground="#EF4444" TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </StackPanel>



                                    <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="15" Padding="12,5" VerticalAlignment="Top" Margin="10,0,0,0">

                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold" Foreground="White"/>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

    </Grid>

</Page>



