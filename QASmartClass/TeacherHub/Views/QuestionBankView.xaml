<UserControl x:Class="QASmartClass.TeacherHub.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" d:DesignHeight="700" d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="📚 Ngân Hàng Câu Hỏi" FontSize="24" FontWeight="Bold"
                       Foreground="#0F172A" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtTotal" Text="0 câu hỏi" FontSize="13" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <!-- F2.3: AI Copilot -->
                <Button x:Name="BtnAiCopilot" Content="🤖 AI Copilot" Click="BtnAiCopilot_Click"
                        FontSize="13" Padding="14,8" Background="#8B5CF6"
                        Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button x:Name="BtnBulkApprove" Content="✔️ Duyệt hàng loạt" Click="BtnBulkApprove_Click"
                        FontSize="13" Padding="14,8" Background="#059669"
                        Foreground="White" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#047857"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnBulkReject" Content="❌ Từ chối hàng loạt" Click="BtnBulkReject_Click"
                        FontSize="13" Padding="14,8" Background="#DC2626"
                        Foreground="White" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#B91C1C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnExportReport" Content="📊 Báo cáo tổng hợp" Click="BtnExportReport_Click"
                        FontSize="13" Padding="14,8" Background="#4F46E5"
                        Foreground="White" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#4338CA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnExportExcel" Content="📥 Xuất Excel" Click="BtnExportExcel_Click"
                        FontSize="13" Padding="14,8" Background="#2196F3"
                        Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button x:Name="BtnDownloadTemplate" Content="📄 Tải file mẫu" Click="BtnDownloadTemplate_Click"
                        FontSize="13" Padding="14,8" Background="#475569"
                        Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button x:Name="BtnImportExcel" Content="📁 Nhập Excel" Click="BtnImportExcel_Click"
                        FontSize="13" Padding="14,8" Background="#FF9800"
                        Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button x:Name="BtnAdd" Content="＋ Thêm câu hỏi" Click="BtnAdd_Click"
                        FontSize="13" Padding="14,8" Background="#10B981"
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>

        <!-- Hướng dẫn ngân hàng câu hỏi sư phạm -->
        <Expander Grid.Row="1" Header="📖 HƯỚNG DẪN QUẢN LÝ NGÂN HÀNG CÂU HỎI (3 BƯỚC)" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,12" Padding="10">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18" Foreground="#1E3A8A">
                Bước 1: Sử dụng bộ lọc (Môn, Khối, Mức độ) và ô tìm kiếm để tra cứu nhanh câu hỏi.<LineBreak/>
                Bước 2: Click &quot;Duyệt hàng loạt&quot; hoặc &quot;Từ chối hàng loạt&quot; sau khi tick chọn các câu hỏi ở danh sách phía dưới.<LineBreak/>
                Bước 3: Nhấp chọn &quot;🤖 AI Copilot&quot; để tối ưu hóa nội dung câu hỏi hoặc tự động phân tích độ khó học thuật.
            </TextBlock>
        </Expander>

        <!-- Filter bar -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Môn:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CboSubject" Width="130" FontSize="13"
                          SelectionChanged="Filter_Changed" Margin="0,0,16,0"/>
                <TextBlock Text="Khối:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CboGrade" Width="100" FontSize="13"
                          SelectionChanged="Filter_Changed" Margin="0,0,16,0"/>
                <TextBlock Text="Mức độ:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CboDifficulty" Width="100" FontSize="13"
                          SelectionChanged="Filter_Changed" Margin="0,0,16,0"/>
                <TextBlock Text="Trạng thái duyệt:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CboApprovalStatus" Width="120" FontSize="13"
                          SelectionChanged="Filter_Changed" Margin="0,0,16,0"/>
                <TextBlock Text="Tìm:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtSearch" Width="200" FontSize="13" Padding="6,4"
                         TextChanged="Filter_Changed" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkSelectAll" Content="Chọn tất cả" FontSize="13" VerticalAlignment="Center"
                          Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked"/>
            </StackPanel>
        </Border>

        <!-- Questions list -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                BorderThickness="1" Padding="0">
            <ListView x:Name="LvQuestions" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <!-- Checkbox selection -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <!-- Content -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#1E293B"
                                               FontFamily="Segoe UI, Cambria Math, MS Reference Sans Serif"
                                               TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Content}" FontSize="12"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#F5F3FF" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Grade}" FontSize="12" Foreground="#7C3AED"/>
                                        </Border>
                                        <Border Background="#EFF6FF" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Subject}" FontSize="12" Foreground="#3B82F6"/>
                                        </Border>
                                        <Border Background="{Binding DiffBg}" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Difficulty}" FontSize="12" Foreground="{Binding DiffFg}"/>
                                        </Border>
                                        <Border Background="#F0FDF4" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding QuestionType}" FontSize="12" Foreground="#16A34A"/>
                                        </Border>
                                        <!-- V7 M1.4: Approval Status -->
                                        <Border Background="{Binding ApprovalStatusBg}" CornerRadius="3" Padding="5,2">
                                            <TextBlock Text="{Binding ApprovalStatusText}" FontSize="12" Foreground="{Binding ApprovalStatusFg}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Answer -->
                                <TextBlock Grid.Column="2" Text="{Binding CorrectAnswer}" FontSize="12"
                                           FontFamily="Segoe UI, Cambria Math, MS Reference Sans Serif"
                                           Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,10,0"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding CorrectAnswer}" FontSize="12"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                <!-- F1.1: Tỷ lệ làm sai & Chia sẻ -->
                                <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PointsText}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding WrongRateText}" FontSize="10" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding DifficultyRecommendation}" FontSize="9" Foreground="#D97706" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="{Binding HasRecommendationVisibility}"/>
                                    <Button x:Name="BtnApplyDifficulty" Content="⚙️ Áp dụng" FontSize="9" Padding="4,2" Click="BtnApplyDifficulty_Click" Tag="{Binding Id}" Background="#FFFBEB" Foreground="#D97706" Cursor="Hand" Visibility="{Binding HasRecommendationVisibility}" Margin="0,2,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#FEF3C7"/>
                                                        <Setter TargetName="b" Property="BorderBrush" Value="#FCD34D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <!-- Actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <Button Content="🌐" FontSize="12" Tag="{Binding Id}" Click="BtnShare_Click" ToolTip="Chia sẻ với Tổ bộ môn" Background="#EFF6FF" Foreground="#3B82F6" BorderBrush="#DBEAFE" BorderThickness="1" Padding="6,4" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="🗑" FontSize="12" Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="Xóa câu hỏi khỏi ngân hàng" Background="#FEF2F2" Foreground="#EF4444" BorderBrush="#FEE2E2" BorderThickness="1" Padding="6,4" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Pagination controls -->
        <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPageInfo" Text="Trang 1 / 1 (Tổng số 0 câu)" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPrevPage" Content="◀ Trang trước" Click="BtnPrevPage_Click"
                            FontSize="12" Padding="10,6" Background="#F1F5F9" Foreground="#334155" 
                            BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="BtnNextPage" Content="Trang sau ▶" Click="BtnNextPage_Click"
                            FontSize="12" Padding="10,6" Background="#F1F5F9" Foreground="#334155" 
                            BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
