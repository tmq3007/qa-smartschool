<Page x:Class="QASmartClass.TeacherHub.Views.HomeroomDiaryPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

      mc:Ignorable="d" 

      d:DesignHeight="720" d:DesignWidth="1280"

      Title="HomeroomDiaryPage" FontFamily="Segoe UI" Background="#F8FAFC">



    <Grid Margin="20">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*"/>

            <ColumnDefinition Width="1*"/>

        </Grid.ColumnDefinitions>



        <!-- Form Sổ Chủ Nhiệm -->

        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="30" Margin="0,0,10,0">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">

                    <TextBlock Text="📒 Sổ Chủ Nhiệm Điện Tử" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>

                    <TextBlock Text="|" FontSize="26" Foreground="#CBD5E1" Margin="15,0"/>

                    <ComboBox x:Name="CbRoster" Width="180" FontSize="16" Height="35" SelectionChanged="CbRoster_SelectionChanged">

                        <!-- Items loaded from DB in code-behind -->

                    </ComboBox>

                    <TextBlock Text="|" FontSize="26" Foreground="#CBD5E1" Margin="15,0"/>

                    <DatePicker x:Name="DpDate" Width="150" FontSize="16" Height="35" SelectedDateChanged="DpDate_SelectedDateChanged"/>

                </StackPanel>



                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

                    <TabItem Header="Nhật Ký Hàng Ngày" FontSize="15" FontWeight="SemiBold">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,10,0">

                            <StackPanel>

                                <!-- Điểm danh -->

                                <TextBlock Text="1. Tình hình Sĩ số / Điểm danh:" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">

                                    <TextBlock Text="Số học sinh vắng mặt hôm nay:" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <TextBox x:Name="TxtAbsentCount" Width="80" Height="35" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="0"/>

                                </StackPanel>



                                <!-- Nề nếp -->

                                <TextBlock Text="2. Ghi chú Nề nếp &amp; Kỷ luật:" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>

                                <TextBox x:Name="TxtDiscipline" Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontSize="15" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="0,0,0,20"/>



                                <!-- Sự kiện -->

                                <TextBlock Text="3. Các sự kiện / Hoạt động trong ngày:" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>

                                <TextBox x:Name="TxtEvents" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="15" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="0,0,0,20"/>



                                <!-- Nhắc nhở -->

                                <TextBlock Text="4. Dặn dò / Nhắc nhở cho ngày mai:" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>

                                <TextBox x:Name="TxtReminders" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="15" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            </StackPanel>

                        </ScrollViewer>

                    </TabItem>



                    <!-- P2-08: Discipline Tab -->

                    <TabItem Header="Khen thưởng - Kỷ luật" FontSize="15" FontWeight="SemiBold">

                        <Grid Margin="0,10,0,0">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            

                            <DockPanel Margin="0,0,0,10">

                                <ComboBox x:Name="CboDisciplineFilter" Width="150" FontSize="14" SelectionChanged="CboDisciplineFilter_Changed">

                                    <ComboBoxItem Content="Tất cả" Tag="All" IsSelected="True"/>

                                    <ComboBoxItem Content="Khen thưởng" Tag="Commendation"/>

                                    <ComboBoxItem Content="Nhắc nhở" Tag="Warning"/>

                                    <ComboBoxItem Content="Kỷ luật" Tag="Discipline"/>

                                </ComboBox>

                                <Button x:Name="BtnAddDiscipline" Content="＋ Thêm ghi nhận" Click="BtnAddDiscipline_Click" 

                                        HorizontalAlignment="Right" Padding="12,6" Background="#3B82F6" Foreground="White" BorderThickness="0"/>

                            </DockPanel>



                            <ListView x:Name="LvDisciplines" Grid.Row="1" BorderThickness="0" Background="Transparent">

                                <ListView.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>

                                                <StackPanel>

                                                    <TextBlock Text="{Binding StudentName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>

                                                    <TextBlock Text="{Binding Reason}" FontSize="14" Foreground="#475569" Margin="0,4,0,0"/>

                                                    <TextBlock Text="{Binding DateStr}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>

                                                </StackPanel>

                                                <Border Grid.Column="1" Background="{Binding TypeBg}" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">

                                                    <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{Binding TypeFg}" FontWeight="Bold"/>

                                                </Border>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ListView.ItemTemplate>

                            </ListView>

                        </Grid>

                    </TabItem>

                </TabControl>



                <!-- Nút Lưu & Nút Báo cáo -->

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

                    <Button x:Name="BtnReport" Content="📄 Tạo báo cáo cuối kỳ" Height="45" Width="180" 

                            Background="#8B5CF6" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnReport_Click"/>

                    <Button x:Name="BtnSave" Content="💾 Lưu Sổ Nhật Ký" Height="45" Width="180" 

                            Background="#10B981" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>

                </StackPanel>

            </Grid>

        </Border>



        <!-- Sidebar Thống Kê / Gợi ý -->

        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

            <StackPanel>

                <TextBlock Text="📈 Thống kê lớp (Tuần này)" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                

                <!-- Status Cards -->

                <Border Background="#EFF6FF" CornerRadius="8" Padding="15" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="Chuyên cần" FontSize="14" Foreground="#3B82F6" FontWeight="Bold"/>

                        <TextBlock Text="Trung bình vắng: 1.2 hs/ngày" FontSize="13" Foreground="#475569" Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

                

                <Border Background="#FEF2F2" CornerRadius="8" Padding="15" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="Kỷ luật" FontSize="14" Foreground="#EF4444" FontWeight="Bold"/>

                        <TextBlock Text="2 trường hợp đi trễ" FontSize="13" Foreground="#475569" Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

                

                <TextBlock Text="🔔 Lịch trình sắp tới" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,15,0,10"/>

                <TextBlock Text="• 25/05: Sinh hoạt chuyên đề" FontSize="14" Foreground="#475569" Margin="0,0,0,5"/>

                <TextBlock Text="• 28/05: Kiểm tra Toán 1 tiết" FontSize="14" Foreground="#475569"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>



