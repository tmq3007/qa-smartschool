<UserControl x:Class="QASmartClass.TeacherHub.Views.TeacherGradingView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             mc:Ignorable="d" 

             d:DesignHeight="600" d:DesignWidth="1000" FontFamily="Segoe UI">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0" Text="SMART GRADING - Bảng Nhập Điểm" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

        <Expander Grid.Row="1" Header="📖 HƯỚNG DẪN NHẬP ĐIỂM &amp; ĐÁNH GIÁ (3 BƯỚC)" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,15" Padding="10">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18" Foreground="#1E3A8A">
                Bước 1: Lựa chọn Lớp dạy và Học kỳ tương ứng ở Toolbar bên dưới.<LineBreak/>
                Bước 2: Sử dụng nút &quot;Import Điểm&quot; để dán dữ liệu từ Excel (hệ thống tự động ánh xạ thông minh hoặc hiển thị hộp thoại xử lý trùng tên).<LineBreak/>
                Bước 3: Nhấp chuột chọn học sinh và click chọn các nút ở bảng bên phải để gửi nhanh nhận xét sư phạm đến Sổ liên lạc của cha mẹ. Nhấp &quot;Lưu Bảng Điểm&quot; để đồng bộ.
            </TextBlock>
        </Expander>



        <!-- Toolbar -->

        <Grid Grid.Row="2" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>



            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="Chọn Lớp:" FontSize="16" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" DisplayMemberPath="DisplayName"

                          Width="200" Height="35" FontSize="16" Padding="5,0"/>

                

                <TextBlock Text="Học kỳ:" FontSize="16" Foreground="Gray" VerticalAlignment="Center" Margin="20,0,10,0"/>

                <ComboBox ItemsSource="{Binding SemesterList}" SelectedItem="{Binding SelectedSemester}"

                          Width="120" Height="35" FontSize="16" Padding="5,0"/>

            </StackPanel>



            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="14" Foreground="#4CAF50" FontWeight="SemiBold" 

                       HorizontalAlignment="Center" VerticalAlignment="Center"/>



            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <Button Content="📁 Import Điểm" Command="{Binding ImportGradesCommand}"

                        Background="#FF9800" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15,8" Cursor="Hand" Margin="0,0,10,0">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="5">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

                

                <Button Content="📥 Tải Excel" Command="{Binding ExportGradesCommand}"

                        Background="#2196F3" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15,8" Cursor="Hand" Margin="0,0,10,0">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="5">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <Button Content="💾 Lưu Bảng Điểm" Command="{Binding SaveGradesCommand}"

                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Padding="15,8" Cursor="Hand">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="5">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </StackPanel>

        </Grid>



        <!-- DataGrid & Quick Feedback -->

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="300"/>

            </Grid.ColumnDefinitions>



            <DataGrid Grid.Column="0" Name="dgGrades" ItemsSource="{Binding GradingTable}" AutoGenerateColumns="True" 

                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"

                      RowHeight="40" FontSize="16" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"

                      HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"

                      AutoGeneratingColumn="DataGrid_AutoGeneratingColumn">

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background" Value="#1E88E5"/>

                        <Setter Property="Foreground" Value="White"/>

                        <Setter Property="FontWeight" Value="Bold"/>

                        <Setter Property="Padding" Value="10,5"/>

                        <Setter Property="HorizontalContentAlignment" Value="Center"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>

                    <Style TargetType="DataGridCell">

                        <Setter Property="Padding" Value="10,0"/>

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate TargetType="DataGridCell">

                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">

                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                        <Style.Triggers>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter Property="Background" Value="#E3F2FD"/>

                                <Setter Property="Foreground" Value="Black"/>

                                <Setter Property="BorderThickness" Value="0"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.CellStyle>

            </DataGrid>



            <!-- F1.2: Sổ liên lạc thông minh (Quick Feedback Panel) -->

            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="15,0,0,0" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="⚡ Sổ Liên Lạc Nhanh" FontSize="18" FontWeight="Bold" Foreground="#1E88E5" Margin="0,0,0,15"/>

                    <TextBlock Text="Chọn HS trong bảng, sau đó click các nút bên dưới để tự động tạo nhận xét:" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,15"/>

                    

                    <TextBlock Text="Đánh giá tích cực" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <WrapPanel Margin="0,0,0,15">

                        <Button Content="⭐ Tích cực phát biểu" Tag="Tích cực phát biểu" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                        <Button Content="📈 Có tiến bộ" Tag="Có tiến bộ rõ rệt" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                        <Button Content="💯 Làm bài tốt" Tag="Làm bài xuất sắc" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                    </WrapPanel>



                    <TextBlock Text="Cần cải thiện" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <WrapPanel Margin="0,0,0,15">

                        <Button Content="⚠️ Thiếu tập trung" Tag="Cần tập trung hơn" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                        <Button Content="📚 Quên bài tập" Tag="Chưa làm bài tập nhà" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                        <Button Content="📉 Cần phụ đạo" Tag="Cần kèm thêm buổi tối" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#FFF3E0" Foreground="#E65100" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                    </WrapPanel>

                    

                    <TextBlock Text="Tùy chọn khác" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <WrapPanel>

                        <Button Content="📞 Gọi Phụ huynh" Tag="Giáo viên đề nghị gặp Phụ huynh" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                        <Button Content="🧹 Trực nhật muộn" Tag="Đi trực nhật muộn" Click="BtnQuickFeedback_Click" Margin="0,0,5,5" Background="#F3E5F5" Foreground="#6A1B9A" BorderThickness="0" Padding="8,4" Cursor="Hand"/>

                        <!-- F1.3: Nút gọi Popup chấm kỹ năng mềm -->

                        <Button Content="🧠 Chấm Kỹ Năng Mềm" Click="BtnSoftSkill_Click" Margin="0,0,5,5" Background="#E0F2F1" Foreground="#00695C" BorderThickness="0" Padding="8,4" Cursor="Hand" FontWeight="Bold"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>



