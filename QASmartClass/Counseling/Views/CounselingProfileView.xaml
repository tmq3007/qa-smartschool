<Page x:Class="QASmartClass.Counseling.Views.CounselingProfileView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Hồ sơ Tư vấn Học đường" Background="#F0F9FF" FontFamily="pack://application:,,,/Resources/Fonts/#Inter">

    <TabControl Margin="10" Background="Transparent" BorderThickness="0">

        <TabItem Header="Hồ sơ cá nhân" FontSize="16" FontWeight="Bold">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1*"/>

                    <ColumnDefinition Width="2*"/>

                </Grid.ColumnDefinitions>



                <!-- Danh sách HS cần tư vấn -->

                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">

                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.05"/></Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <TextBlock Text="👥 Danh sách Học sinh" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <Button Grid.Row="1" x:Name="BtnAddProfile" Content="＋ Thêm Hồ sơ mới" Click="BtnAddProfile_Click" 
                                Height="40" Background="#0EA5E9" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Grid.Column="0" Margin="0,0,5,0" Padding="5" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                            <ComboBox x:Name="CboClassFilter" Grid.Column="1" Padding="5" SelectionChanged="CboClassFilter_SelectionChanged"/>
                        </Grid>

                        <ListView Grid.Row="3" x:Name="LvProfiles" BorderThickness="0" SelectionChanged="LvProfiles_SelectionChanged">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">

                                        <StackPanel>

                                            <TextBlock Text="{Binding StudentName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>

                                            <TextBlock Text="{Binding ClassName}" FontSize="12" Foreground="#64748B"/>

                                            <TextBlock Text="{Binding ProblemType}" FontSize="12" Foreground="#0EA5E9" FontWeight="SemiBold" Margin="0,4,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                </Border>



                <!-- Chi tiết hồ sơ và lịch sử tư vấn -->

                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">

                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.05"/></Border.Effect>

                    <Grid x:Name="GridDetails" Visibility="Hidden">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>



                        <DockPanel Margin="0,0,0,15">

                            <StackPanel>

                                <TextBlock x:Name="TxtStudentName" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>

                                <TextBlock x:Name="TxtProblemType" FontSize="14" Foreground="#0EA5E9" FontWeight="SemiBold"/>

                            </StackPanel>

                            <Button x:Name="BtnAddSession" Content="＋ Thêm phiên tư vấn" Click="BtnAddSession_Click"
                                    Height="40" Padding="12,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10B981" Foreground="White" BorderThickness="0"/>

                        </DockPanel>



                        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="0,0,0,20">

                            <TextBlock x:Name="TxtNotes" TextWrapping="Wrap" FontSize="14" Foreground="#334155"/>

                        </Border>



                        <!-- Lịch sử phiên tư vấn -->

                        <Grid Grid.Row="2">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <TextBlock Text="🕒 Lịch sử tư vấn" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <ListView Grid.Row="1" x:Name="LvSessions" BorderThickness="0">

                                <ListView.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">

                                            <StackPanel>

                                                <TextBlock Text="{Binding SessionDateStr}" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding Content}" FontSize="14" Foreground="#334155" Margin="0,4,0,4" TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding SolutionStr}" FontSize="14" Foreground="#10B981" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding FollowUpStr}" FontSize="12" Foreground="#F59E0B" Margin="0,4,0,0" FontStyle="Italic"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ListView.ItemTemplate>

                            </ListView>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </TabItem>



        <TabItem Header="Góc Ẩn Danh" FontSize="16" FontWeight="Bold">

            <Border Background="White" CornerRadius="10" Padding="20" Margin="10">

                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.05"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="🎭 Câu hỏi Ẩn Danh chờ phản hồi" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                    <ListView Grid.Row="1" x:Name="LvAnonymous" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                                                <TextBlock Text="{Binding Category}" FontWeight="Bold" Foreground="#64748B" Margin="0,0,10,0"/>

                                                <TextBlock Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" FontSize="13" Foreground="#94A3B8"/>

                                            </StackPanel>

                                            <TextBlock Text="{Binding Question}" FontSize="15" Foreground="#334155" TextWrapping="Wrap"/>

                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Phản hồi" Tag="{Binding Id}" Click="BtnReplyAnonymous_Click" 
                                                Height="40" Padding="15,0" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>

        </TabItem>

    </TabControl>

</Page>



