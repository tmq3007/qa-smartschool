<Window x:Class="QASmartClass.Counseling.Views.CounselingSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm phiên tư vấn" Height="420" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="💬 THÊM PHIÊN TƯ VẤN MỚI" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Nội dung trao đổi" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtContent" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="6,4"/>

            <TextBlock Text="Hướng giải quyết / Đề xuất" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtSolution" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="6,4"/>

            <TextBlock Text="Ngày hẹn tiếp theo (nếu có)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpFollowUp" Margin="0,0,0,15"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="40" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="Lưu phiên" Width="100" Height="40" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
