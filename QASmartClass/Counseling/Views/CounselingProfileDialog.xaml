<Window x:Class="QASmartClass.Counseling.Views.CounselingProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Hồ sơ mới" Height="420" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="👥 TẠO HỒ SƠ TƯ VẤN MỚI" FontSize="18" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Tên học sinh" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtStudentName" Height="30" Margin="0,0,0,12" Padding="6,4" VerticalContentAlignment="Center"/>

            <TextBlock Text="Lớp" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtClassName" Height="30" Margin="0,0,0,12" Padding="6,4" VerticalContentAlignment="Center"/>

            <TextBlock Text="Vấn đề chính" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <ComboBox x:Name="CboProblemType" Height="30" Margin="0,0,0,12">
                <ComboBoxItem Content="Học tập" IsSelected="True"/>
                <ComboBoxItem Content="Gia đình"/>
                <ComboBoxItem Content="Tâm lý cá nhân"/>
                <ComboBoxItem Content="Quan hệ bạn bè"/>
            </ComboBox>

            <TextBlock Text="Ghi chú ban đầu" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6,4"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="40" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="Lưu hồ sơ" Width="100" Height="40" Background="#0EA5E9" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
