<UserControl x:Class="QASmartClass.Counseling.Views.SchoolCounselingView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             FontFamily="pack://application:,,,/Resources/Fonts/#Inter" Background="#F1F5F9">

    <Grid x:Name="GridMainContent" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🧠 Sổ Theo Dõi Tâm Lý Học Đường (SEL)" FontSize="24" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="➕ Thêm Hồ sơ" Height="40" Padding="14,0" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAddRecord_Click"/>
                <Button Content="🔄 Làm mới" Height="40" Padding="14,0" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
            </StackPanel>
        </DockPanel>



        <!-- Form Thêm/Sửa (Ban đầu ẩn) -->
        <Border Grid.Row="1" x:Name="PnlAddRecord" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- V4.2: Nhãn chỉ dẫn sử dụng từng bước trực quan -->
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="💡 Chỉ dẫn: Bước 1: Chọn Học sinh -> Bước 2: Kéo chọn điểm Mood -> Bước 3: Đặt Cấp can thiệp -> Bước 4: Viết ghi chép &amp; Lưu" FontStyle="Italic" Foreground="#4F46E5" Margin="0,0,0,15" FontSize="12" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Học sinh:" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="#64748B"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CboStudent" Margin="0,0,20,10" Padding="5" Height="35" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Điểm Mood (1-10):" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="#64748B"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <Slider x:Name="SldMoodScore" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" Width="100" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="SldMoodScore_ValueChanged"/>
                    <TextBlock x:Name="TxtMoodVal" Text="5 🙂" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#0EA5E9"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ghi chú ban đầu:" VerticalAlignment="Top" Margin="0,0,10,10" Foreground="#64748B"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtNotes" Height="50" TextWrapping="Wrap" Margin="0,0,0,10" Padding="5" AcceptsReturn="True"/>

                <!-- V7 P3.5: Cấp can thiệp 3 cấp mới -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cấp can thiệp:" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="#64748B"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CboInterventionLevel" Margin="0,0,20,10" Padding="5" Height="35" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Chưa can thiệp"/>
                    <ComboBoxItem Content="Cấp Lớp (GV hỗ trợ)"/>
                    <ComboBoxItem Content="Cấp Trường (Phòng tâm lý)"/>
                    <ComboBoxItem Content="Cấp Chuyên gia (Y tế/Bệnh viện)"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="2" Text="Hẹn tái khám:" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="#64748B"/>
                <DatePicker Grid.Row="3" Grid.Column="3" x:Name="DpFollowUp" Margin="0,0,0,10" Height="35" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ghi chú can thiệp:" VerticalAlignment="Top" Margin="0,0,10,10" Foreground="#64748B"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtInterventionNotes" Height="50" TextWrapping="Wrap" Margin="0,0,0,10" Padding="5" AcceptsReturn="True"/>

                <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="💾 Lưu Hồ Sơ" Click="BtnSave_Click" Background="#4F46E5" Foreground="White" BorderThickness="0" Height="40" Padding="15,0" Cursor="Hand"/>
                    <Button Content="❌ Hủy" Click="BtnCancel_Click" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Height="40" Padding="15,0" Margin="10,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="DgRecords" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  RowHeight="60" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#4F46E5"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày ghi nhận" Binding="{Binding RecordedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                <DataGridTextColumn Header="Học sinh" Binding="{Binding StudentName}" Width="150"/>
                
                <DataGridTemplateColumn Header="Tâm trạng (Mood)" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MoodScore}" FontWeight="Bold" Foreground="{Binding MoodColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ghi chú / Từ khóa nhạy cảm" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxHeight="35" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DetectedKeywords}" Foreground="#EF4444" FontSize="11" FontStyle="Italic" Margin="0,2,0,0" Visibility="{Binding HasKeywords}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="Mức rủi ro" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RiskBg}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RiskLevelDisplay}" Foreground="{Binding RiskFg}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Hành động" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Cập nhật" Tag="{Binding Id}" Click="BtnEditRecord_Click" Background="#4F46E5" Foreground="White" BorderThickness="0" Height="30" Padding="8,0" Margin="0,0,5,0" Cursor="Hand"/>
                                <Button Content="Gửi Cảnh báo" Tag="{Binding Id}" Click="BtnNotify_Click" Background="#FEF08A" Foreground="#854D0E" BorderThickness="0" Height="30" Padding="8,0" Cursor="Hand" Visibility="{Binding CanNotify}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>



