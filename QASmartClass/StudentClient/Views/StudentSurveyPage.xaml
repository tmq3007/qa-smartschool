<Page x:Class="QASmartClass.StudentClient.Views.StudentSurveyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Khảo sát" Background="#F5F7FA">

    <Grid Margin="24,16">
        <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="#E0E0E0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="📋 Khảo sát" FontSize="22" FontWeight="Bold" Foreground="#212121" Margin="0,0,0,8"/>
                    <TextBlock Text="Tham gia khảo sát từ giáo viên để cải thiện chất lượng giảng dạy" FontSize="14" Foreground="#5A6A85" Margin="0,0,0,20"/>

                    <!-- Empty state -->
                    <Border x:Name="emptyState" Background="#F5F7FA" CornerRadius="10" Padding="30" MinHeight="200">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#FFF3E0" HorizontalAlignment="Center">
                                <TextBlock Text="📝" FontSize="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chưa có khảo sát mới" FontSize="16" FontWeight="SemiBold" Foreground="#74829C"
                                       Margin="0,16,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Text="GV sẽ gửi khảo sát khi cần ý kiến đóng góp" FontSize="14" Foreground="#74829C"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Active survey (from teacher) -->
                    <Border x:Name="activeSurveyPanel" Visibility="Collapsed"
                            Background="#E3F2FD" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📊 Khảo sát từ GV" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>
                            <TextBlock x:Name="txtSurveyQuestion" Text="" FontSize="18" Foreground="#212121"
                                       TextWrapping="Wrap" Margin="0,0,0,16" FontWeight="SemiBold"/>
                            <WrapPanel x:Name="panelSurveyOptions" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Thank you message -->
                    <Border x:Name="thankYouPanel" Visibility="Collapsed"
                            Background="#E8F5E9" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✅ Cảm ơn bạn đã tham gia khảo sát!" FontSize="16"
                                           FontWeight="SemiBold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Star rating -->
                    <Border Background="#FFF8E1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="⭐ Đánh giá bài giảng hôm nay" FontSize="15" FontWeight="SemiBold" Foreground="#F57C00" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="star1" Text="★" FontSize="36" Cursor="Hand" Margin="4" Tag="1" Foreground="#DFE4EA" MouseLeftButtonDown="StarRate_Click" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="star2" Text="★" FontSize="36" Cursor="Hand" Margin="4" Tag="2" Foreground="#DFE4EA" MouseLeftButtonDown="StarRate_Click" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="star3" Text="★" FontSize="36" Cursor="Hand" Margin="4" Tag="3" Foreground="#DFE4EA" MouseLeftButtonDown="StarRate_Click" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="star4" Text="★" FontSize="36" Cursor="Hand" Margin="4" Tag="4" Foreground="#DFE4EA" MouseLeftButtonDown="StarRate_Click" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="star5" Text="★" FontSize="36" Cursor="Hand" Margin="4" Tag="5" Foreground="#DFE4EA" MouseLeftButtonDown="StarRate_Click" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                            <!-- Pedagogical Labels: Flexible Width & Large semi-bold font -->
                            <Grid Margin="0,8,0,0" MaxWidth="320" HorizontalAlignment="Stretch">
                                <TextBlock Text="1⭐ Khó hiểu / Quá nhanh" FontSize="12" FontWeight="SemiBold" Foreground="#F57C00" HorizontalAlignment="Left"/>
                                <TextBlock Text="5⭐ Dễ hiểu / Thú vị" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="txtStarResult" Text="" FontSize="14" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <Border Background="#F5F7FA" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="✅ Khảo sát đã hoàn thành" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                <TextBlock x:Name="txtCompletedCount" DockPanel.Dock="Right" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                            </DockPanel>
                            <TextBlock x:Name="txtLastSurvey" Text="Chưa có khảo sát nào được hoàn thành" FontSize="14" Foreground="#5A6A85" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <!-- Confetti overlay stretched to cover the entire page Grid -->
        <Canvas x:Name="canvasConfetti" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="True" Background="Transparent" IsHitTestVisible="False"/>
    </Grid>
</Page>