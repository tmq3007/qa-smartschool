<Page x:Class="QASmartClass.StudentClient.Views.StudentSurveyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Khảo sát nhanh" Background="#F8FAFC">

    <Page.Resources>
        <ControlTemplate x:Key="M3PrimaryPillBtn" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="24" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Page.Resources>

    <Grid Margin="24,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="680" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,8,0,24">

                <!-- M3 Main Surface Card -->
                <Border Background="White" CornerRadius="20" Padding="28" BorderBrush="#E2E8F0" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header -->
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#E8F0FE" Margin="0,0,14,0">
                                    <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Khảo sát nhanh trong lớp" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="txtHeaderSubtitle"
                                               Text="Phản hồi trực tiếp tới Giáo viên trong tiết học"
                                               FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border x:Name="badgeLiveStatus" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#E8F0FE" CornerRadius="12" Padding="10,5" BorderBrush="#BFDBFE" BorderThickness="1">
                                <TextBlock x:Name="txtLiveStatus" Text="● ĐANG MỞ" FontSize="11" FontWeight="Bold" Foreground="#1A73E8"/>
                            </Border>
                        </DockPanel>

                        <!-- Empty / Waiting State (Shown when no active poll in RAM) -->
                        <Border x:Name="emptyState" Background="#F8FAFC" CornerRadius="16" Padding="32,36"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                                <Border Width="72" Height="72" CornerRadius="36" Background="#E8F0FE" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtEmptyIcon" Text="📋" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="txtEmptyTitle" Text="Hiện chưa có khảo sát nào đang mở"
                                           FontSize="16" FontWeight="Bold" Foreground="#1E293B"
                                           Margin="0,16,0,6" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock x:Name="txtEmptyDesc"
                                           Text="Khi Giáo viên phát khảo sát nhanh trên lớp, câu hỏi và các phương án lựa chọn sẽ hiển thị ngay tại đây."
                                           FontSize="13.5" Foreground="#64748B"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Survey Card (M3 Single-Focus Poll matching Android) -->
                        <Border x:Name="activeSurveyPanel" Visibility="Collapsed"
                                Background="#F8FAFC" CornerRadius="16" Padding="22"
                                BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="txtSurveyTitle" Text="KHẢO SÁT TỪ GIÁO VIÊN"
                                           FontSize="11.5" FontWeight="Bold" Foreground="#1A73E8" Margin="0,0,0,8"/>

                                <TextBlock x:Name="txtSurveyQuestion" Text=""
                                           FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                           TextWrapping="Wrap" Margin="0,0,0,18"/>

                                <!-- Full-width M3 selectable option cards -->
                                <StackPanel x:Name="panelSurveyOptions" Margin="0,0,0,16"/>

                                <!-- Submit Button -->
                                <Button x:Name="btnSubmitSurvey"
                                        Content="Gửi phản hồi khảo sát"
                                        Height="48" FontSize="15" FontWeight="Bold"
                                        Background="#1A73E8" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Template="{StaticResource M3PrimaryPillBtn}"
                                        Click="SubmitSurvey_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Submitted Banner (Visible while current poll is still open in RAM) -->
                        <Border x:Name="thankYouPanel" Visibility="Collapsed"
                                Background="#ECFDF5" CornerRadius="14" Padding="18,14" Margin="0,14,0,0"
                                BorderBrush="#A7F3D0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✅" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Đã gửi phản hồi của bạn tới Giáo viên!" FontSize="14" FontWeight="Bold" Foreground="#065F46"/>
                                    <TextBlock x:Name="txtSelectedSummary" Text="" FontSize="12.5" Foreground="#047857" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- [MYTHWARE_LITE] Ẩn đánh giá 5 sao lưu DB theo ngày và lịch sử khảo sát cũ (chỉ khảo sát lúc vào lớp, tắt đi là xóa sạch) -->
                        <Border Visibility="Collapsed" Background="#FFF8E1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="star1" Text="★"/>
                                    <TextBlock x:Name="star2" Text="★"/>
                                    <TextBlock x:Name="star3" Text="★"/>
                                    <TextBlock x:Name="star4" Text="★"/>
                                    <TextBlock x:Name="star5" Text="★"/>
                                </StackPanel>
                                <TextBlock x:Name="txtStarResult" Text=""/>
                                <TextBlock x:Name="txtCompletedCount" Text="0"/>
                                <TextBlock x:Name="txtLastSurvey" Text=""/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Confetti overlay stretched to cover the entire page Grid -->
        <Canvas x:Name="canvasConfetti" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="True" Background="Transparent" IsHitTestVisible="False"/>
    </Grid>
</Page>
