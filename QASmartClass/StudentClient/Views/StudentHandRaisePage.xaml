<Page x:Class="QASmartClass.StudentClient.Views.StudentHandRaisePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Giơ tay" Background="#F5F7FA">

    <Grid Margin="24,16">
        <Border Background="White" CornerRadius="16" Padding="32" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Giơ tay tương tác -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                    <TextBlock Text="✋ Phát biểu trong lớp" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Nhấp nút bên dưới để giơ tay xin phát biểu ý kiến hoặc gọi Giáo viên." FontSize="14" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Nút Giơ tay tròn nằm trong Grid để overlay vòng Cooldown -->
                    <Grid Width="180" Height="180" HorizontalAlignment="Center">
                        <Button x:Name="btnRaiseHand" Width="180" Height="180" Click="RaiseHand_Click" Cursor="Hand" BorderThickness="0" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="circle" Width="180" Height="180" CornerRadius="90" BorderThickness="4" BorderBrush="#1A73E8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#E8F0FE" Offset="0"/>
                                                <GradientStop Color="#D2E3FC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="handIcon" Text="✋" FontSize="64" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="handLabel" Text="Click để Giơ tay" FontSize="14" FontWeight="Bold" Foreground="#1A73E8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="circle" Property="BorderBrush" Value="#0D47A1"/>
                                            <Setter TargetName="circle" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#1A73E8" Opacity="0.3"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Vòng tròn Cooldown xoay hạt mờ (Gamer-style) -->
                        <Ellipse x:Name="cooldownRing" Width="180" Height="180" Stroke="#FF9800" StrokeThickness="4" StrokeDashArray="3 3" Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="cooldownRotation" CenterX="90" CenterY="90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <TextBlock x:Name="txtStatus" Text="Chưa giơ tay" FontSize="15" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="Lý do giơ tay:" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                        <ComboBox x:Name="cbReason" Width="160" Height="32" FontSize="13" SelectedIndex="0">
                            <ComboBoxItem Content="🙋 Phát biểu bài"/>
                            <ComboBoxItem Content="❓ Chưa hiểu bài"/>
                            <ComboBoxItem Content="🔧 Lỗi máy tính"/>
                            <ComboBoxItem Content="🚪 Xin ra ngoài"/>
                        </ComboBox>
                        <TextBlock Text="* Hãy chọn lý do phù hợp trước khi nhấn nút để Thầy/Cô hỗ trợ em nhanh nhất." FontSize="11" Foreground="#64748B" FontStyle="Italic" TextWrapping="Wrap" Margin="0,10,0,0" Width="180" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Đường phân tách giữa 2 cột -->
                <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="24,10" Background="#E2E8F0" Width="1"/>

                <!-- Cột phải: Hỏi nhanh giáo viên -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                    <Border Background="#F8FAFC" CornerRadius="12" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💬 Gửi câu hỏi nhanh cho Giáo viên" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <TextBlock Text="Câu hỏi sẽ được chuyển thẳng đến bảng điều khiển của GV để hỗ trợ giải đáp." FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBox x:Name="txtQuestion" Padding="12,10" FontSize="14" Height="100" MaxLength="500"
                                     AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="#CBD5E1" Background="White" VerticalScrollBarVisibility="Auto">
                                <TextBox.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                </TextBox.Resources>
                            </TextBox>
                            
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Tối đa 500 ký tự" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button Content="📤 Gửi câu hỏi" Padding="18,10" FontSize="14" FontWeight="SemiBold"
                                        Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Right" Click="SendQuestion_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#0D47A1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>