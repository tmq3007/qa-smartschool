<Page x:Class="QASmartClass.StudentClient.Views.StudentSimulatorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Giả lập điểm số" Background="#FAFAFA"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Filter Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Validation Trigger for Cell Editing -->
        <Style TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="BorderBrush" Value="#E53935"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" 
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="BorderBrush" Value="#009688"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Summary Box -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="50" Height="50" CornerRadius="25" DockPanel.Dock="Left" Margin="0,0,16,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#009688" Offset="0"/>
                        <GradientStop Color="#80CBC4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔍 Giả Lập Điểm Số &amp; Mục Tiêu Học Lực" FontSize="20" FontWeight="Bold" Foreground="#1A2530"/>
                <TextBlock Text="Thử nghiệm điểm số mong đợi để lên kế hoạch đạt danh hiệu phấn đấu" FontSize="13" Foreground="#757575"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. TOOLBAR BAR -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📅 Học kỳ:" FontSize="13" FontWeight="SemiBold" Foreground="#495057"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cboSemester" Width="100" FontSize="13" Padding="6,4" SelectionChanged="Semester_Changed">
                        <ComboBoxItem Content="HK1" Tag="HK1"/>
                        <ComboBoxItem Content="HK2" Tag="HK2" IsSelected="True"/>
                    </ComboBox>

                    <!-- Status Indicator Banner -->
                    <Border x:Name="statusBanner" Background="#ECEFF1" CornerRadius="6" Padding="12,6" Margin="20,0,0,0">
                        <TextBlock x:Name="txtStatus" Text="Chế độ xem bảng điểm thực tế" FontSize="12" FontWeight="SemiBold" Foreground="#546E7A" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- Simulator Trigger Buttons -->
                    <Button x:Name="btnStartSim" Content="🔍 Bắt đầu giả lập" Style="{StaticResource ActionBtn}"
                            Background="#009688" Foreground="White" BorderBrush="#00796B" Click="StartSim_Click"/>
                    <Button x:Name="btnStopSim" Content="🛑 Dừng giả lập" Style="{StaticResource ActionBtn}"
                            Background="#FFEBEE" Foreground="#C62828" BorderBrush="#FFCDD2" Click="StopSim_Click" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. DATAGRID -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <!-- Dynamic DataGrid -->
                <DataGrid x:Name="dgSimulator" AutoGenerateColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="All"
                          BorderThickness="0" Background="White" RowBackground="White"
                          AlternatingRowBackground="#FAFAFA" FontSize="13" RowHeight="36"
                          CanUserResizeRows="False" CanUserSortColumns="False"
                          SelectionMode="Single" SelectionUnit="Cell"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CellEditEnding="DataGrid_CellEditEnding">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#ECEFF1"/>
                            <Setter Property="Foreground" Value="#37474F"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#CFD8DC"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>

                <!-- No-data Placeholder -->
                <TextBlock x:Name="txtNoData" Text="📌 Không tìm thấy dữ liệu điểm của học kỳ này."
                           FontSize="13" Foreground="#9E9E9E" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 4. SUMMARY BOX -->
        <Border Grid.Row="3" Background="#E0F2F1" CornerRadius="12" Padding="20,16" Margin="0,16,0,0" BorderBrush="#B2DFDB" BorderThickness="1">
            <UniformGrid Columns="3">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Xếp loại Học lực Dự kiến" FontSize="12" Foreground="#004D40"/>
                    <TextBlock x:Name="txtEstClassification" Text="—" FontSize="28" FontWeight="Bold" Foreground="#00796B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Số môn đạt Tốt (≥ 8.0)" FontSize="12" Foreground="#004D40"/>
                    <TextBlock x:Name="txtEstCountTot" Text="0" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Số môn đạt Khá (≥ 6.5)" FontSize="12" Foreground="#004D40"/>
                    <TextBlock x:Name="txtEstCountKha" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1565C0" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Page>
