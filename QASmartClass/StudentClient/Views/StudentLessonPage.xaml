<Page x:Class="QASmartClass.StudentClient.Views.StudentLessonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Bài giảng" Background="#F5F7FA"
      PreviewKeyDown="Page_PreviewKeyDown" Focusable="True">

    <Page.Resources>
        <Storyboard x:Key="sbBlinkAlert" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="txtNetworkStatus" 
                             Storyboard.TargetProperty="Opacity" 
                             From="1.0" To="0.2" Duration="0:0:0.8"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border x:Name="headerBorder" Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="txtLessonTitle" Text="📖 Hàm số bậc nhất y = ax + b" FontSize="20" FontWeight="Bold" Foreground="#1A202C"/>
                    <TextBlock x:Name="txtLessonInfo" Text="Môn: Toán  •  Lớp: 10A  •  GV: Nguyễn Văn A  •  45 phút" FontSize="13.5" Foreground="#4A5568" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Network Status -->
                    <TextBlock x:Name="txtNetworkStatus" Text="📶 Đang kết nối" FontSize="11" Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    
                    <!-- Manual Refresh Button -->
                    <Button x:Name="btnRefresh" Content="🔄 Làm mới" FontSize="11" FontWeight="SemiBold" 
                            Background="#EDF2F7" Foreground="#4A5568" BorderBrush="#CBD5E0" BorderThickness="1"
                            Padding="8,4" Cursor="Hand" Margin="0,0,8,0" Click="BtnRefresh_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Content count -->
                    <Border Background="#E3F2FD" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock x:Name="txtBlockCount" Text="0 nội dung" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Status badge -->
                    <Border x:Name="statusBadge" Background="#E8F5E9" CornerRadius="6" Padding="10,5">
                        <TextBlock x:Name="txtStatus" Text="✅ Đã duyệt" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <ScrollViewer x:Name="contentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- ⚠️ Offline self-study mode banner -->
                <Border x:Name="borderOfflineBanner" Visibility="Collapsed" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Mất kết nối máy chủ Giáo viên > 30s. Hệ thống tự động kích hoạt Chế độ tự học ngoại tuyến. Bạn có thể tiếp tục xem bài giảng hiện tại." 
                                   FontSize="12.5" FontWeight="Medium" Foreground="#E65100" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- 🎯 Focus indicator from teacher -->
                <Border x:Name="focusIndicator" Visibility="Collapsed" Background="#1976D2" CornerRadius="10" Padding="20,14" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock Text="🎯" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel>
                            <TextBlock x:Name="txtFocusTitle" Text="GV yêu cầu tập trung" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="txtFocusDetail" Text="Hãy đọc kỹ nội dung được đánh dấu bên dưới" FontSize="14" Foreground="#BBDEFB" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="btnCloseFocus" DockPanel.Dock="Right" Content="✕" FontSize="16" 
                                Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Top" Padding="6" Click="CloseFocus_Click" ToolTip="Đóng" Visibility="Collapsed"/>
                    </DockPanel>
                </Border>

                <!-- ═══ STAGE 2: KIỂM TRA BÀI CŨ — ẩn bài mới, chỉ hiện quiz ═══ -->
                <Border x:Name="stageReviewPanel" Visibility="Collapsed" Background="White" CornerRadius="12" 
                        Padding="40,30" MinHeight="300" BorderBrush="#FF9800" BorderThickness="2" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="56" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kiểm Tra Bài Cũ" FontSize="20" FontWeight="Bold" Foreground="#E65100"
                                   Margin="0,14,0,6" HorizontalAlignment="Center"/>
                        <TextBlock Text="GV đang kiểm tra kiến thức bài trước." FontSize="14" Foreground="#666"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Hãy tập trung trả lời câu hỏi từ giáo viên!" FontSize="13" Foreground="#999"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Border Background="#FFF3E0" CornerRadius="8" Padding="16,10">
                            <StackPanel>
                                <TextBlock Text="💡 Lưu ý:" FontSize="12" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,4"/>
                                <TextBlock Text="• Nội dung bài mới sẽ hiển thị khi GV chuyển sang giai đoạn giảng bài" 
                                           FontSize="11" Foreground="#795548" TextWrapping="Wrap"/>
                                <TextBlock Text="• Nếu có Quiz, câu hỏi sẽ xuất hiện tự động trên màn hình" 
                                           FontSize="11" Foreground="#795548" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ STAGE 4-6: Thông tin trạng thái khác ═══ -->
                <Border x:Name="stageActivityPanel" Visibility="Collapsed" Background="White" CornerRadius="12"
                        Padding="40,30" MinHeight="200" BorderBrush="#7B1FA2" BorderThickness="2" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="txtStageIcon" Text="🎮" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtStageName" Text="Thực hành" FontSize="18" FontWeight="Bold" Foreground="#7B1FA2"
                                   Margin="0,12,0,4" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtStageHint" Text="Hãy tham gia hoạt động theo hướng dẫn của GV!" 
                                   FontSize="13" Foreground="#999" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <Border x:Name="emptyState" Background="White" CornerRadius="12" Padding="40" MinHeight="300"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="56" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtEmptyMessage" Text="Đang chờ GV trình chiếu bài giảng..." FontSize="15" Foreground="#9E9E9E"
                                   Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="Bài giảng sẽ tự động hiển thị khi giáo viên bắt đầu." FontSize="12" Foreground="#BDBDBD"
                                   Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Lesson content blocks (populated from DB) -->
                <StackPanel x:Name="lessonContentPanel" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DIAGNOSTIC OVERLAY (F12) ═══ -->
        <Border x:Name="dbDiagnosticOverlay" Grid.Row="1" Visibility="Collapsed" 
                Background="#2D3748" CornerRadius="8" Padding="16" Width="280" Height="190"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                BorderBrush="#4A5568" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="🛠️ Chẩn Đoán Kết Nối (F12)" FontSize="12.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <TextBlock x:Name="txtDiagLocalIp" Text="IP Học sinh: 127.0.0.1" FontSize="13.0" FontWeight="Medium" Foreground="#E2E8F0" Margin="0,2,0,2"/>
                <TextBlock x:Name="txtDiagTeacherIp" Text="IP Giáo viên: Chưa kết nối" FontSize="13.0" FontWeight="Medium" Foreground="#E2E8F0" Margin="0,2,0,2"/>
                <TextBlock x:Name="txtDiagLatency" Text="Độ trễ: Ngoại tuyến" FontSize="13.0" FontWeight="Medium" Foreground="#E2E8F0" Margin="0,2,0,2"/>
                <Button x:Name="btnResetNetwork" Content="⚡ Khởi chạy lại kết nối" Margin="0,10,0,0"
                        FontSize="11.5" FontWeight="Bold" Background="#4A5568" Foreground="White"
                        BorderBrush="#718096" BorderThickness="1" Padding="0,6" Cursor="Hand" Click="BtnResetNetwork_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2B6CB0"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="#3182CE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
