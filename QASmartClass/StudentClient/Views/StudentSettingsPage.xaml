<Page x:Class="QASmartClass.StudentClient.Views.StudentSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cài đặt" Background="{DynamicResource Gray100}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="600" HorizontalAlignment="Center">
            <!-- Connection settings -->
            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource Gray300}" BorderThickness="1">
                <StackPanel>
                    <Grid x:Name="gridLockStatus" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🌐 Kết nối" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Gray900}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="lblLockStatus" Text="🔒 Đang khóa (Chỉ đọc)" FontSize="10.5" Foreground="#E53935" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button x:Name="btnLockUnlock" Content="🔑 Mở khóa" Grid.Column="1" Padding="12,6" FontSize="11.5" FontWeight="SemiBold"
                                Background="#78909C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="LockUnlock_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#546E7A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Inline PIN input panel -->
                    <Border x:Name="borderPinEntry" Background="#ECEFF1" CornerRadius="8" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Nhập mã PIN Giáo viên để chỉnh sửa cấu hình:" FontSize="11" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="pbPinCode" Padding="8,5" FontSize="12" VerticalAlignment="Center">
                                    <PasswordBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></PasswordBox.Resources>
                                </PasswordBox>
                                <Button Content="Xác nhận" Grid.Column="1" Padding="12,5" FontSize="11" FontWeight="Bold" Margin="8,0,0,0"
                                        Background="#1E88E5" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ConfirmPin_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#1565C0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Hủy" Grid.Column="2" Padding="12,5" FontSize="11" FontWeight="Bold" Margin="8,0,0,0"
                                        Background="#9E9E9E" Foreground="White" BorderThickness="0" Cursor="Hand" Click="CancelPin_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#757575"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Địa chỉ IP máy giáo viên" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gray800}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTeacherIP" Text="192.168.1.100" Padding="10,8" FontSize="13" Margin="0,0,0,12" BorderBrush="{DynamicResource Gray300}" IsReadOnly="True" Background="#F5F5F5">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="Cổng kết nối" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gray800}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtPort" Text="29877" Padding="10,8" FontSize="13" Width="120"
                             HorizontalAlignment="Left" Margin="0,0,0,12" BorderBrush="{DynamicResource Gray300}" IsReadOnly="True" Background="#F5F5F5">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tự động kết nối" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gray800}"/>
                            <TextBlock Text="Tự động kết nối khi mở ứng dụng" FontSize="10" Foreground="#9E9E9E"/>
                        </StackPanel>
                        <CheckBox x:Name="chkAutoConnect" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnConnect" Content="🔗 Kết nối" Padding="18,10" FontSize="13" FontWeight="Bold"
                                Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Left" Click="Connect_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#0D47A1"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="b" Property="Background" Value="#B0BEC5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <ProgressBar x:Name="prgConnecting" IsIndeterminate="True" Width="120" Height="8" Margin="16,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Profile settings -->
            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource Gray300}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="👤 Thông tin cá nhân" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Gray900}" Margin="0,0,0,16"/>

                    <Border Background="#F8F9FA" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Gray300}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Họ và tên:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Gray800}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblFullName" Text="Trần Văn B" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Gray900}" Grid.Column="1" VerticalAlignment="Center"/>

                            <TextBlock Text="Mã học sinh:" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Gray800}" Grid.Row="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblStudentCode" Margin="0,12,0,0" Text="HS003" FontSize="14" FontWeight="Bold" Foreground="#1976D2" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="* Thông tin cá nhân do Giáo viên thiết lập và quản lý." FontSize="11" FontStyle="Italic" Foreground="#757575" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Canteen wallet settings -->
            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource Gray300}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🪙 Ví Canteen" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Gray900}" Margin="0,0,0,16"/>

                    <TextBlock Text="Cảnh báo khi ví còn ít tiền hơn (VNĐ)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gray800}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtLowBalanceThreshold" Text="30000" Padding="10,8" FontSize="13" Width="150" HorizontalAlignment="Left" Margin="0,0,0,12" BorderBrush="{DynamicResource Gray300}" PreviewTextInput="NumberValidationTextBox">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>

                    <Button x:Name="btnSaveWalletSettings" Content="💾 Lưu ngưỡng cảnh báo" Padding="18,10" FontSize="13" FontWeight="Bold"
                            Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Left" Click="SaveWalletSettings_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#F57C00"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="{DynamicResource Gray300}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ℹ️ Thông tin" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Gray900}" Margin="0,0,0,12"/>
                    <Border Background="#E3F2FD" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="QA SMART CLASS — Student" FontSize="16" FontWeight="Bold" Foreground="#1976D2"/>
                            <TextBlock Text="Phiên bản 3.0.0.0" FontSize="12" Foreground="#1565C0" Margin="0,4,0,0"/>
                            <TextBlock Text="© 2025-2026 QA Education Technology" FontSize="10" Foreground="#757575" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>