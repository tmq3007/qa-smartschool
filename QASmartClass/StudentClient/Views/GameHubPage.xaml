<Page x:Class="QASmartClass.StudentClient.Views.GameHubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hệ Sinh Thái MI Mini Game" Background="#F0F2F5" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="🎮 Hệ Sinh Thái Game Học Tập (MI Ecosystem)" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1E293B"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel: Game Selection & Game Area -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Chọn Trò Chơi Phát Triển Năng Lực" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#334155"/>
                <UniformGrid Columns="4" Rows="2" Margin="0,0,0,20">
                    <Button Content="🗣️ Ngôn ngữ" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Linguistic" Background="#DBEAFE" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🔢 Logic" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Logical" Background="#FEF3C7" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🎨 Không gian" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Spatial" Background="#F0FDF4" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🎵 Âm nhạc" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Musical" Background="#FCE7F3" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🏃 Vận động" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Kinesthetic" Background="#E0E7FF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="💬 Giao tiếp" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Interpersonal" Background="#FFEDD5" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🪞 Nội tâm" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Intrapersonal" Background="#F3E8FF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🌿 Tự nhiên" Margin="5" Padding="10" Click="PlayGame_Click" Tag="Naturalistic" Background="#D1FAE5" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </UniformGrid>

                <ContentControl x:Name="GameContainer" Margin="0,0,0,20">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="ContentControl.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                
                <TextBlock x:Name="TxtFloatXp" Text="+40 XP" Foreground="#10B981" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" Opacity="0" Visibility="Hidden">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="FloatTransform" Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
            
            <!-- Right Panel: MI Profile & Leaderboard & Streak -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Daily Streak Widget -->
                <Border Grid.Row="0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔥" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Chuỗi Đăng Nhập (Daily Streak)" FontSize="12" FontWeight="SemiBold" Foreground="#D97706"/>
                            <TextBlock x:Name="TxtStreakCount" Text="0 ngày liên tiếp" FontSize="18" FontWeight="Bold" Foreground="#B45309"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TabControl for Radar Chart & Leaderboard -->
                <TabControl Grid.Row="1" Background="White" BorderThickness="0">
                    <TabItem Header="📊 Radar Năng Lực" FontWeight="SemiBold">
                        <StackPanel Margin="10">
                            <TextBlock Text="📊 Biểu Đồ Năng Lực (MI Radar)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1E293B" HorizontalAlignment="Center"/>
                            <Canvas x:Name="RadarCanvas" Width="250" Height="250" HorizontalAlignment="Center" Margin="0,5,0,10">
                                <!-- Canvas will be drawn dynamically -->
                            </Canvas>
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="12">
                                <TextBlock x:Name="TxtAiCoach" TextWrapping="Wrap" Foreground="#047857" FontWeight="SemiBold" FontSize="13" TextAlignment="Justify"/>
                            </Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="🏆 Bảng Xếp Hạng" FontWeight="SemiBold">
                        <StackPanel Margin="10">
                            <TextBlock Text="🏆 Top 10 Học Sinh XP Cao Nhất" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1E293B" HorizontalAlignment="Center"/>
                            <DataGrid x:Name="DgLeaderboard" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" Margin="0,5,0,0" SelectionUnit="Row" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hạng" Binding="{Binding Rank}" Width="50"/>
                                    <DataGridTextColumn Header="Học sinh" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="60"/>
                                    <DataGridTextColumn Header="Tổng XP" Binding="{Binding TotalXp}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Page>
