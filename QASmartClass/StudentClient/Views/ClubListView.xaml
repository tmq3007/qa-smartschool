<Page x:Class="QASmartClass.StudentClient.Views.ClubListView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Câu lạc bộ của tôi" Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <DockPanel Margin="0,0,0,20">

            <TextBlock Text="⚽ Câu lạc bộ &amp; Hoạt động ngoại khóa" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>

            <Button x:Name="BtnRefresh" Content="🔄 Làm mới" HorizontalAlignment="Right" Padding="15,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#475569" Cursor="Hand" Click="BtnRefresh_Click"/>

        </DockPanel>



        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Danh sách CLB -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    

                    <TextBlock Text="Danh sách Câu lạc bộ Trường" FontSize="18" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15"/>

                    

                    <DataGrid x:Name="DgClubs" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" SelectionChanged="DgClubs_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tên CLB" Binding="{Binding Name}" Width="2*"/>

                            <DataGridTextColumn Header="Phân loại" Binding="{Binding Category}" Width="*"/>

                            <DataGridTextColumn Header="Giáo viên PT" Binding="{Binding TeacherId}" Width="*"/>

                            <DataGridTextColumn Header="Số lượng Max" Binding="{Binding MaxMembers}" Width="80"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>



            <!-- Chi tiết CLB -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

                <StackPanel x:Name="PanelDetail" Visibility="Hidden">

                    <TextBlock x:Name="TxtClubName" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,5" TextWrapping="Wrap"/>

                    <TextBlock x:Name="TxtClubCategory" FontSize="14" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,0,0,15"/>



                    <TextBlock Text="Mô tả:" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtClubDesc" TextWrapping="Wrap" FontSize="14" Foreground="#334155" Margin="0,0,0,20"/>



                    <TextBlock Text="Giáo viên phụ trách:" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtTeacher" FontSize="14" Foreground="#334155" Margin="0,0,0,20"/>



                    <Button x:Name="BtnJoin" Content="Đăng ký tham gia" Background="#10B981" Foreground="White" Padding="15,10" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnJoin_Click">

                        <Button.Resources>

                            <Style TargetType="Border">

                                <Setter Property="CornerRadius" Value="8"/>

                            </Style>

                        </Button.Resources>

                    </Button>

                    

                    <TextBlock x:Name="TxtStatus" Text="Bạn đã là thành viên." FontSize="14" Foreground="#10B981" FontWeight="SemiBold" Margin="0,15,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>



