<Page x:Class="QASmartClass.StudentClient.Views.StudentResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Kết quả" Background="#F5F7FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
            <!-- Title Bar với nút Refresh -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Kết quả học tập cá nhân" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                <Button x:Name="btnRefresh" Content="🔄 Tải lại" HorizontalAlignment="Right" Click="btnRefresh_Click"
                        Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" 
                        Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Summary cards -->
            <UniformGrid Columns="4" Margin="-6,0,-6,16">
                <Border Background="White" CornerRadius="12" Padding="16" Margin="6" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtAvgScore" Text="—" FontSize="32" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center"/>
                        <TextBlock Text="Điểm TB" FontSize="13" Foreground="#424242" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="6" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtClassRank" Text="—" FontSize="32" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblClassRank" Text="Hạng phong trào (XP)" FontSize="13" Foreground="#424242" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="6" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtTotalDone" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bài đã làm" FontSize="13" Foreground="#424242" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="6" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtCorrectRate" Text="0%" FontSize="32" FontWeight="Bold" Foreground="#7B1FA2" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tỉ lệ đúng" FontSize="13" Foreground="#424242" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent results -->
            <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📊 Kết quả gần đây" FontSize="16" FontWeight="Bold" Foreground="#212121" Margin="0,0,0,16"/>

                    <TextBlock x:Name="txtNoResults" Text="Chưa có kết quả kiểm tra nào." FontSize="13" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>

                    <ItemsControl x:Name="lstRecentResults">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F7FA" CornerRadius="10" Padding="16" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,14,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{Binding ScoreColorStart}" Offset="0"/>
                                                    <GradientStop Color="{Binding ScoreColorEnd}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding DisplayScore}" FontSize="20" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding QuizTitle}" FontSize="15" FontWeight="Bold" Foreground="#212121" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="{Binding RatingBgColor}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding RatingText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding RatingFgColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding SubmittedAtText}" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreFractionText}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding ScoreColorStart}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Pedagogical Advice Box -->
            <Border Background="#FEF3C7" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,16,0,0">
                <DockPanel>
                    <TextBlock Text="💡 Lời khuyên học tập:" FontSize="14" FontWeight="Bold" Foreground="#92400E" Margin="0,0,10,0" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPedagogicalAdvice" Text="—" FontSize="13" Foreground="#78350F" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>