<Window x:Class="QASmartClass.StudentClient.Views.StudentShell"



        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"



        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



        Title="QA Smart Class — Giao diện Học sinh"



        WindowState="Maximized" WindowStyle="None"



        Background="#F0F2F5" AllowsTransparency="False">







    <Window.Resources>



        <!-- Dynamic resources for theme styling -->

        <SolidColorBrush x:Key="SidebarNavFg" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="SidebarBottomBg" Color="#080F1A"/>

        <SolidColorBrush x:Key="SidebarSecHeaderBg" Color="#0F2847"/>

        <SolidColorBrush x:Key="SidebarSecHeaderFgChinh" Color="#60A5FA"/>

        <SolidColorBrush x:Key="SidebarSecHeaderFgHocTap" Color="#4ADE80"/>

        <SolidColorBrush x:Key="SidebarSecHeaderFgTuongTac" Color="#F472B6"/>

        <SolidColorBrush x:Key="SidebarSecHeaderFgCaNhan" Color="#94A3B8"/>

        <SolidColorBrush x:Key="SidebarSepBg" Color="#1A3050"/>

        <SolidColorBrush x:Key="SidebarLogoFg" Color="White"/>

        <SolidColorBrush x:Key="SidebarToggleFg" Color="#64748B"/>

        <LinearGradientBrush x:Key="SidebarBg" StartPoint="0,0" EndPoint="0,1">

            <GradientStop Color="#0B1929" Offset="0"/>

            <GradientStop Color="#112240" Offset="0.5"/>

            <GradientStop Color="#0A1628" Offset="1"/>

        </LinearGradientBrush>



        <!-- Modern Student Nav Button -->



        <Style x:Key="StuNav" TargetType="Button">



            <Setter Property="Background" Value="Transparent"/>



            <Setter Property="Foreground" Value="{DynamicResource SidebarNavFg}"/>



            <Setter Property="BorderThickness" Value="0"/>



            <Setter Property="Height" Value="48"/>



            <Setter Property="Padding" Value="14,0"/>



            <Setter Property="HorizontalContentAlignment" Value="Left"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="FontSize" Value="14"/>



            <Setter Property="FontWeight" Value="SemiBold"/>



            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="bd" Background="{TemplateBinding Background}"



                                CornerRadius="0,12,12,0" Margin="0,1,10,1" Padding="{TemplateBinding Padding}">



                            <ContentPresenter VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="bd" Property="Background" Value="#1A3A6B"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>



        <Style x:Key="StuNavActive" TargetType="Button" BasedOn="{StaticResource StuNav}">



            <Setter Property="Background">



                <Setter.Value>



                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">



                        <GradientStop Color="#2563EB" Offset="0"/>



                        <GradientStop Color="#3B82F6" Offset="1"/>



                    </LinearGradientBrush>



                </Setter.Value>



            </Setter>



            <Setter Property="Foreground" Value="White"/>



            <Setter Property="FontWeight" Value="Bold"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="bd" Background="{TemplateBinding Background}"



                                CornerRadius="0,12,12,0" Margin="0,1,10,1" Padding="{TemplateBinding Padding}">



                            <ContentPresenter VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="bd" Property="Background">



                                    <Setter.Value>



                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">



                                            <GradientStop Color="#3B82F6" Offset="0"/>



                                            <GradientStop Color="#60A5FA" Offset="1"/>



                                        </LinearGradientBrush>



                                    </Setter.Value>



                                </Setter>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <!-- Section header style -->



        <Style x:Key="SectionHeader" TargetType="Border">



            <Setter Property="Margin" Value="12,8,12,4"/>



            <Setter Property="Padding" Value="10,5"/>



            <Setter Property="CornerRadius" Value="8"/>



            <Setter Property="Background" Value="{DynamicResource SidebarSecHeaderBg}"/>



        </Style>







        <!-- Separator -->



        <Style x:Key="NavSep" TargetType="Border">



            <Setter Property="Height" Value="1"/>



            <Setter Property="Background" Value="{DynamicResource SidebarSepBg}"/>



            <Setter Property="Margin" Value="18,4"/>



        </Style>



    </Window.Resources>







    <Grid>



        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- ═══ SIDEBAR ═══ -->

        <Border x:Name="sidebarBorder" Grid.Column="0" Width="236" Background="{DynamicResource SidebarBg}">



            <DockPanel>



                <!-- Logo Area -->

                <Border DockPanel.Dock="Top" Padding="14,14,14,6">

                    <Grid>

                        <StackPanel x:Name="logoTextPanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">

                            <Border x:Name="logoBorder" Width="38" Height="38" CornerRadius="10" Margin="0,0,10,0" Cursor="Hand" ToolTip="QA Smart Class — Phiên bản 4.1" PreviewMouseLeftButtonDown="Logo_MouseLeftButtonDown" PreviewMouseLeftButtonUp="Logo_MouseLeftButtonUp">

                                <Border.Background>

                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                        <GradientStop Color="#2563EB" Offset="0"/>

                                        <GradientStop Color="#60A5FA" Offset="1"/>

                                    </LinearGradientBrush>

                                </Border.Background>

                                <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="18"

                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="QA SMART CLASS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SidebarLogoFg}"/>

                                <TextBlock Text="Giao diện Học sinh" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarToggleFg}" Margin="0,2,0,0"/>

                            </StackPanel>

                        </StackPanel>

                        <Button x:Name="btnToggleSidebar" HorizontalAlignment="Right" Content="&#xE00E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SidebarToggleFg}" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="ToggleSidebar_Click" ToolTip="Thu gọn thanh điều hướng"/>

                    </Grid>

                </Border>



                <!-- Session Info Card -->

                <Border x:Name="sessionInfoCard" DockPanel.Dock="Top" Margin="10,6,10,4" CornerRadius="12" Padding="12,10">



                    <Border.Background>



                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">



                            <GradientStop Color="#0F3460" Offset="0"/>



                            <GradientStop Color="#16213E" Offset="1"/>



                        </LinearGradientBrush>



                    </Border.Background>



                    <StackPanel>



                        <DockPanel>



                            <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"



                                    VerticalAlignment="Center">



                                <Border.Background>



                                    <SolidColorBrush Color="#22C55E"/>



                                </Border.Background>



                            </Border>



                            <TextBlock x:Name="txtClassInfo" Text="Toán 10A — Tiết 3" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>



                        </DockPanel>



                        <DockPanel Margin="16,4,0,0">



                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                                <TextBlock x:Name="iconConnection" Text="&#xE779;" FontFamily="Segoe MDL2 Assets" FontSize="11"



                                           Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,5,0"/>



                                <TextBlock x:Name="txtConnectionStatus" Text="Đã kết nối" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>



                            </StackPanel>



                            <Button x:Name="btnReconnect" Content="🔄" FontSize="11" Foreground="#60A5FA" 



                                    Background="Transparent" BorderThickness="0" Cursor="Hand" 



                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"



                                    Click="Reconnect_Click" ToolTip="Nhấp vào để kết nối lại mạng"/>



                        </DockPanel>



                    </StackPanel>



                </Border>







                <!-- Bottom: Student profile -->



                <Border DockPanel.Dock="Bottom" Padding="10,10" Background="{DynamicResource SidebarBottomBg}">

                    <StackPanel>

                        <DockPanel Cursor="Hand" MouseLeftButtonDown="StudentAvatar_Click" ToolTip="Nhấp để đổi ảnh đại diện">

                            <!-- Avatar -->

                            <Border x:Name="studentAvatarBorder" DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="21"

                                    Margin="0,0,10,0" BorderBrush="#3B82F6" BorderThickness="2">

                                <Border.Background>

                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                        <GradientStop Color="#1D4ED8" Offset="0"/>

                                        <GradientStop Color="#60A5FA" Offset="1"/>

                                    </LinearGradientBrush>

                                </Border.Background>

                                <Grid>

                                    <TextBlock x:Name="txtStudentInitials" Text="HS" FontSize="15" FontWeight="Bold"

                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <Image x:Name="imgStudentAvatar" Stretch="UniformToFill" Visibility="Collapsed">

                                        <Image.Clip>

                                            <EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/>

                                        </Image.Clip>

                                    </Image>

                                </Grid>

                            </Border>



                            <StackPanel x:Name="studentTextPanel" VerticalAlignment="Center">

                                <TextBlock x:Name="txtStudentName" Text="Trần Văn B" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>

                                <TextBlock x:Name="txtStudentId" Text="Mã HS: HS003  •  PC-05" Foreground="{DynamicResource SidebarToggleFg}" FontSize="11" FontWeight="Medium" Margin="0,2,0,0"/>

                            </StackPanel>

                        </DockPanel>



                        <!-- Level Progress Bar -->

                        <StackPanel x:Name="xpPanel" Margin="0,8,0,0">

                            <DockPanel LastChildFill="True">

                                <TextBlock x:Name="lblLevel" Text="Cấp 1" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" DockPanel.Dock="Left"/>

                                <TextBlock x:Name="lblXpValue" Text="0/100 điểm" Foreground="{DynamicResource SidebarToggleFg}" FontSize="10" TextAlignment="Right"/>

                            </DockPanel>

                            <ProgressBar x:Name="pbXpProgress" Value="0" Maximum="100" Height="6" Margin="0,4,0,0" Foreground="#38BDF8" Background="#334155" BorderThickness="0">

                                <ProgressBar.Resources>

                                    <Style TargetType="Border">

                                        <Setter Property="CornerRadius" Value="2"/>

                                    </Style>

                                </ProgressBar.Resources>

                            </ProgressBar>

                        </StackPanel>

                    </StackPanel>

                </Border>







                <!-- Navigation -->



                <ScrollViewer VerticalScrollBarVisibility="Auto">



                    <StackPanel x:Name="navPanel" Margin="0,6,0,8">







                        <!-- ═══ CHÍNH ═══ -->



                        <Border Style="{StaticResource SectionHeader}">



                            <TextBlock Text="CHÍNH" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SidebarSecHeaderFgChinh}"/>



                        </Border>



                        <Button Style="{StaticResource StuNavActive}" Tag="S1" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#60A5FA"/>



                                <TextBlock Text="Trang chủ" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>



                        <Button Style="{StaticResource StuNav}" Tag="S2" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#FB923C"/>



                                <TextBlock Text="Bài giảng hôm nay" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>







                        <!-- ═══ HỌC TẬP ═══ -->



                        <Border Style="{StaticResource NavSep}"/>



                        <Border Style="{StaticResource SectionHeader}">



                            <TextBlock Text="HỌC TẬP" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SidebarSecHeaderFgHocTap}"/>



                        </Border>



                        <!-- Bảng trắng học sinh -->

                        <Button Style="{StaticResource StuNav}" Tag="S12" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#2DD4BF"/>



                                <TextBlock Text="Bảng trắng học sinh" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>



                        <Button x:Name="btnStudentQuiz" Style="{StaticResource StuNav}" Tag="S3" Click="NavButton_Click">

                            <Grid>

                                <DockPanel>

                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#F472B6"/>

                                    <TextBlock Text="Bài kiểm tra" VerticalAlignment="Center"/>

                                </DockPanel>

                                <Border x:Name="quizBadge" Visibility="Collapsed" Background="#EF4444" Width="20" Height="20" CornerRadius="10"

                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">

                                    <TextBlock x:Name="txtQuizBadge" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </Grid>

                        </Button>



                        <Button x:Name="btnStudentAssignment" Style="{StaticResource StuNav}" Tag="S4" Click="NavButton_Click">

                            <Grid>

                                <DockPanel>

                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#A78BFA"/>

                                    <TextBlock Text="Bài tập học tập" VerticalAlignment="Center"/>

                                </DockPanel>

                                <Border x:Name="assignmentBadge" Visibility="Collapsed" Background="#EF4444" Width="20" Height="20" CornerRadius="10"

                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">

                                    <TextBlock x:Name="txtAssignmentBadge" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </Grid>

                        </Button>



                        <Button Style="{StaticResource StuNav}" Tag="S5" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#FBBF24"/>



                                <TextBlock Text="Khảo sát" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>







                        <!-- ═══ TƯƠNG TÁC ═══ -->



                        <Border Style="{StaticResource NavSep}"/>



                        <Border Style="{StaticResource SectionHeader}">



                            <TextBlock Text="TƯƠNG TÁC" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SidebarSecHeaderFgTuongTac}"/>



                        </Border>



                        <Button x:Name="btnStudentMsg" Style="{StaticResource StuNav}" Tag="S6" Click="NavButton_Click">



                            <Grid>



                                <DockPanel>



                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#38BDF8"/>



                                    <TextBlock Text="Tin nhắn" VerticalAlignment="Center"/>



                                </DockPanel>



                                <Border x:Name="stuMsgBadge" Visibility="Collapsed" Background="#EF4444" Width="20" Height="20" CornerRadius="10"



                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">



                                    <TextBlock x:Name="txtStuMsgBadge" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"



                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                </Border>



                            </Grid>



                        </Button>



                        <Button Style="{StaticResource StuNav}" Tag="S7" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#34D399"/>



                                <TextBlock Text="Hỏi bài Giáo viên" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>







                        <!-- ═══ CÁ NHÂN ═══ -->



                        <Border Style="{StaticResource NavSep}"/>



                        <Border Style="{StaticResource SectionHeader}">



                            <TextBlock Text="CÁ NHÂN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SidebarSecHeaderFgCaNhan}"/>



                        </Border>



                        <Button Style="{StaticResource StuNav}" Tag="S8" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#818CF8"/>



                                <TextBlock Text="Kết quả học tập" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>



                        <Button Style="{StaticResource StuNav}" Tag="S11" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#F43F5E"/>



                                <TextBlock Text="Tiến trình học tập" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>



                        <Button Style="{StaticResource StuNav}" Tag="S9" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#94A3B8"/>



                                <TextBlock Text="Cài đặt" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>



                        <Button Style="{StaticResource StuNav}" Tag="S10" Click="NavButton_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#FACC15"/>



                                <TextBlock Text="Hướng dẫn sử dụng" VerticalAlignment="Center"/>



                            </DockPanel>



                        </Button>



                        <!-- Thoát chương trình -->

                        <Border Style="{StaticResource NavSep}"/>



                        <Button Style="{StaticResource StuNav}" Click="CloseApp_Click">



                            <DockPanel>



                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#EF4444"/>



                                <TextBlock Text="Thoát chương trình" VerticalAlignment="Center" Foreground="#FCA5A5" FontWeight="SemiBold"/>



                            </DockPanel>



                        </Button>







                    </StackPanel>



                </ScrollViewer>



            </DockPanel>



        </Border>







        <!-- ═══ CONTENT AREA ═══ -->



        <Grid x:Name="mainContentAreaGrid" Grid.Column="1">



            <Grid.RowDefinitions>



                <RowDefinition Height="52"/>



                <RowDefinition Height="*"/>



            </Grid.RowDefinitions>







            <!-- Top Bar -->



            <Border x:Name="topBarBorder" Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">



                <Border.Effect>



                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="Black" Direction="270"/>



                </Border.Effect>



                <DockPanel Margin="20,0">



                    <!-- Page Title -->



                    <TextBlock x:Name="txtPageTitle" Text="🏠 Trang chủ"



                               VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>







                    <!-- Right Controls -->



                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Re-open Broadcast Button (Focus Protection Level 2) -->

                        <Button x:Name="btnShowBroadcast" Content="📡 Xem màn hình GV" FontSize="11" FontWeight="Bold"

                                Foreground="White" Background="#7B1FA2" Padding="8,4" Margin="0,0,12,0" 

                                Cursor="Hand" Click="ShowBroadcast_Click" Visibility="Collapsed">

                            <Button.Resources>

                                <Style TargetType="Border">

                                    <Setter Property="CornerRadius" Value="6"/>

                                </Style>

                            </Button.Resources>

                        </Button>



                        <!-- Wi-Fi Network Indicator -->

                        <TextBlock x:Name="txtWifiIndicator" Text="ONLINE" FontSize="14" Foreground="#10B981"

                                   Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Đã kết nối trực tuyến"/>



                        <!-- Theme Toggle Button -->



                        <Button x:Name="btnThemeToggle" Content="DARK" FontSize="13" Foreground="#94A3B8"



                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"



                                Click="ThemeToggle_Click" VerticalAlignment="Center" ToolTip="Chuyển đổi giao diện sáng/tối"/>



                        <!-- Clock -->



                        <TextBlock x:Name="txtClock" Text="--:--" Foreground="#94A3B8" FontSize="13"



                                   Margin="0,0,16,0" VerticalAlignment="Center" FontFamily="Segoe UI"/>







                        <!-- Teacher Info Chip -->



                        <Border CornerRadius="8" Padding="10,5" Margin="0,0,8,0">



                            <Border.Background>



                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">



                                    <GradientStop Color="#ECFDF5" Offset="0"/>



                                    <GradientStop Color="#D1FAE5" Offset="1"/>



                                </LinearGradientBrush>



                            </Border.Background>



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="&#xE779;" FontFamily="Segoe MDL2 Assets" FontSize="10"



                                           Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>



                                <TextBlock x:Name="txtTeacherInfo" Text="GV: Nguyễn Văn A" FontSize="11" Foreground="#15803D" FontWeight="SemiBold"/>



                            </StackPanel>



                        </Border>







                        <!-- Hand Raise Toggle Button -->



                        <Button x:Name="btnQuickHandRaise" Content="✋ Giơ tay phát biểu" Foreground="White"



                                BorderThickness="0" Padding="12,6" FontSize="12" Cursor="Hand" FontWeight="SemiBold"



                                Margin="0,0,6,0" Click="QuickHandRaise_Click" ToolTip="Bấm để giơ tay / hạ tay phát biểu">



                            <Button.Template>



                                <ControlTemplate TargetType="Button">



                                    <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}">



                                        <Border.Background>



                                            <SolidColorBrush x:Name="bBrush" Color="#475569"/> <!-- Slate #475569 -->



                                        </Border.Background>



                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                    </Border>



                                    <ControlTemplate.Triggers>



                                        <Trigger Property="IsMouseOver" Value="True">



                                            <Setter TargetName="b" Property="Background" Value="#64748B"/>



                                        </Trigger>



                                    </ControlTemplate.Triggers>



                                </ControlTemplate>



                            </Button.Template>



                        </Button>







                        <!-- Switch to Teacher -->



                        <Button Content="👨‍🏫 Giáo viên" Foreground="White"



                                BorderThickness="0" Padding="12,6" FontSize="12" Cursor="Hand"



                                Margin="0,0,6,0" Click="SwitchToTeacher_Click" ToolTip="Chuyển sang giao diện Giáo viên">



                            <Button.Template>



                                <ControlTemplate TargetType="Button">



                                    <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}">



                                        <Border.Background>



                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">



                                                <GradientStop Color="#EA580C" Offset="0"/>



                                                <GradientStop Color="#F97316" Offset="1"/>



                                            </LinearGradientBrush>



                                        </Border.Background>



                                        <ContentPresenter HorizontalAlignment="Center"/>



                                    </Border>



                                    <ControlTemplate.Triggers>



                                        <Trigger Property="IsMouseOver" Value="True">



                                            <Setter TargetName="b" Property="Background">



                                                <Setter.Value>



                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">



                                                        <GradientStop Color="#C2410C" Offset="0"/>



                                                        <GradientStop Color="#EA580C" Offset="1"/>



                                                    </LinearGradientBrush>



                                                </Setter.Value>



                                            </Setter>



                                        </Trigger>



                                    </ControlTemplate.Triggers>



                                </ControlTemplate>



                            </Button.Template>



                        </Button>







                        <!-- Switch to Bảng tương tác -->



                        <Button Content="🖊️ Bảng tương tác" Foreground="White"



                                BorderThickness="0" Padding="12,6" FontSize="12" Cursor="Hand"



                                Margin="0,0,6,0" Click="SwitchToScreen_Click" ToolTip="Chuyển sang Bảng tương tác">



                            <Button.Template>



                                <ControlTemplate TargetType="Button">



                                    <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}">



                                        <Border.Background>



                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">



                                                <GradientStop Color="#2563EB" Offset="0"/>



                                                <GradientStop Color="#3B82F6" Offset="1"/>



                                            </LinearGradientBrush>



                                        </Border.Background>



                                        <ContentPresenter HorizontalAlignment="Center"/>



                                    </Border>



                                    <ControlTemplate.Triggers>



                                        <Trigger Property="IsMouseOver" Value="True">



                                            <Setter TargetName="b" Property="Background">



                                                <Setter.Value>



                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">



                                                        <GradientStop Color="#1D4ED8" Offset="0"/>



                                                        <GradientStop Color="#2563EB" Offset="1"/>



                                                    </LinearGradientBrush>



                                                </Setter.Value>



                                            </Setter>



                                        </Trigger>



                                    </ControlTemplate.Triggers>



                                </ControlTemplate>



                            </Button.Template>



                        </Button>





                    </StackPanel>



                </DockPanel>



            </Border>







            <!-- Content + Toast Overlay -->



            <Grid Grid.Row="1">



                <Frame x:Name="contentFrame" NavigationUIVisibility="Hidden"/>



                <!-- RAM DB Cảnh báo Banner (màu cam) -->

                <Border x:Name="ramDbWarningBanner" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" 

