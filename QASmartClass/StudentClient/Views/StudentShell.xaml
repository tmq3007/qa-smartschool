                    <TextBlock x:Name="txtTelemetryJitter" Grid.Row="2" Grid.Column="1" Text="0.0 ms" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" TextAlignment="Right" Margin="0,2,0,2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Frame Drop:" FontSize="11" Foreground="#94A3B8" Margin="0,2,8,2"/>
