                        Visibility="Collapsed" Height="Auto" Width="Auto" MaxWidth="500">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="⚠" Foreground="#E65100" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <TextBlock Text="Chế độ học tập dự phòng (Không lưu trữ cục bộ)" Foreground="#E65100" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>



                <!-- Toast Notification Panel -->



                <StackPanel x:Name="stuToastPanel" HorizontalAlignment="Right" VerticalAlignment="Top"



                            Margin="0,12,20,0" Width="360"/>



            </Grid>



