<Page x:Class="QASmartClass.StudentClient.Views.StudentGuidePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hướng Dẫn Sử Dụng"
      FontFamily="Segoe UI">



    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Modern Expander Toggle Button -->

        <Style x:Key="ExpanderToggleButton" TargetType="ToggleButton">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border Background="Transparent">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" x:Name="Arrow" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" 

                                           FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/>

                                <Setter TargetName="Arrow" Property="Foreground" Value="#3B82F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Modern Expander Style -->

        <Style x:Key="GuideExpander" TargetType="Expander">

            <Setter Property="Background" Value="White"/>

            <Setter Property="Margin" Value="0,0,0,16"/>

            <Setter Property="BorderBrush" Value="#E2E8F0"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Expander">

                        <Border Background="{TemplateBinding Background}" 

                                BorderBrush="{TemplateBinding BorderBrush}" 

                                BorderThickness="{TemplateBinding BorderThickness}" 

                                CornerRadius="12">

                            <Border.Effect>

                                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="8" ShadowDepth="2"/>

                            </Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition x:Name="ContentRow" Height="0"/>

                                </Grid.RowDefinitions>

                                

                                <ToggleButton x:Name="HeaderSite" Grid.Row="0"

                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"

                                              Style="{StaticResource ExpanderToggleButton}"

                                              Padding="20">

                                    <ContentPresenter ContentSource="Header"/>

                                </ToggleButton>

                                

                                <Border x:Name="ContentSite" Grid.Row="1" Padding="20,0,20,20" 

                                        BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Margin="20,0,20,0" Visibility="Collapsed">

                                    <ContentPresenter Margin="0,16,0,0"/>

                                </Border>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsExpanded" Value="True">

                                <Setter TargetName="ContentRow" Property="Height" Value="Auto"/>

                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>

                                <Setter Property="BorderBrush" Value="#BAE6FD"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="BorderBrush" Value="#CBD5E1"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="IconBox" TargetType="Border">

            <Setter Property="Width" Value="48"/>

            <Setter Property="Height" Value="48"/>

            <Setter Property="CornerRadius" Value="12"/>

            <Setter Property="Margin" Value="0,0,16,0"/>

        </Style>



        <Style x:Key="StepText" TargetType="TextBlock">

            <Setter Property="FontSize" Value="15"/>

            <Setter Property="Foreground" Value="#475569"/>

            <Setter Property="TextWrapping" Value="Wrap"/>

            <Setter Property="Margin" Value="0,0,0,12"/>

            <Setter Property="LineHeight" Value="22"/>

        </Style>

    </Page.Resources>



    <Grid Background="#F8FAFC">

        <ScrollViewer Padding="32" VerticalScrollBarVisibility="Auto">

            <StackPanel MaxWidth="850" HorizontalAlignment="Center">

                

                <!-- Hero Header -->

                <Border Background="#1E293B" CornerRadius="16" Padding="32" Margin="0,0,0,32">

                    <Border.Effect>

                        <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="20" ShadowDepth="10"/>

                    </Border.Effect>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">

                            <TextBlock Text="Cẩm Nang Trực Quan" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

                            <TextBlock Text="Khám phá cách tương tác và học tập hiệu quả trên QA SmartClass. Nhấn vào từng mục bên dưới để xem chi tiết hướng dẫn." 

                                       FontSize="15" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="24"/>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <!-- Thanh tìm kiếm hiện đại -->
                                <Border CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Width="300" Height="38">
                                    <Grid>
                                        <TextBox x:Name="txtSearch" 
                                                 Background="Transparent" 
                                                 BorderThickness="0"
                                                 Padding="12,0,32,0" 
                                                 VerticalContentAlignment="Center" 
                                                 FontSize="14"
                                                 GotFocus="TxtSearch_GotFocus" 
                                                 LostFocus="TxtSearch_LostFocus"
                                                 KeyUp="TxtSearch_KeyUp"/>
                                        <TextBlock x:Name="lblSearchPlaceholder" 
                                                   Text="Tìm kiếm hướng dẫn..." 
                                                   Foreground="#94A3B8" 
                                                   IsHitTestVisible="False" 
                                                   VerticalAlignment="Center" 
                                                   Margin="14,0,0,0" 
                                                   FontSize="14"/>
                                        <Button x:Name="btnClearSearch" 
                                                Content="&#xE8BB;" 
                                                FontFamily="Segoe MDL2 Assets" 
                                                FontSize="12" 
                                                Width="32" 
                                                Height="32" 
                                                Background="Transparent" 
                                                BorderBrush="Transparent" 
                                                Foreground="#94A3B8"
                                                HorizontalAlignment="Right" 
                                                Margin="0,0,4,0" 
                                                Visibility="Collapsed" 
                                                Click="BtnClearSearch_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Nút Khởi chạy Help Tour -->
                                <Button x:Name="btnStartHelpTour" 
                                        Content="🚀 Hướng dẫn trực quan" 
                                        Click="BtnStartHelpTour_Click" 
                                        Height="38" 
                                        Padding="16,0" 
                                        Margin="16,0,0,0" 
                                        Background="#3B82F6" 
                                        Foreground="White" 
                                        BorderBrush="Transparent" 
                                        FontWeight="Bold"
                                        FontSize="14">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                        </StackPanel>

                        <TextBlock x:Name="lblHeaderBulb" Grid.Column="1" Text="💡" FontSize="80" VerticalAlignment="Center" Margin="32,0,0,0"/>

                    </Grid>

                </Border>



                <!-- ITEMS CONTROL CHO DANH SÁCH HƯỚNG DẪN -->
                <ItemsControl ItemsSource="{Binding Guides}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Style="{StaticResource GuideExpander}" 
                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBox}" Background="{Binding IconBgColor}" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding IconCode}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StepText}" Text="{Binding ContentText}"/>
                                    
                                    <!-- Hình ảnh thực tế sẽ hiển thị ở đây nếu có ImagePath -->
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="0,16,0,0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>



                <!-- Footer -->

                <TextBlock Text="Chúc bạn có những giờ học thú vị và hiệu quả cùng QA SmartClass!" 

                           FontSize="15" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,16,0,48"/>



            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>

