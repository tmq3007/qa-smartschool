<Page x:Class="QASmartClass.StudentClient.Views.StudentQuizPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Kiểm tra / Quiz" Background="{StaticResource LightBrush}">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header area wrapper -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <!-- Custom Anti-Cheating Alert Banner (Phase 4) -->
            <Border x:Name="borderCheatingAlert" Visibility="Collapsed" Background="#EF4444" CornerRadius="12" Padding="20,12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="⚠️ CẢNH BÁO GIAN LẬN:" FontWeight="Bold" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Bạn vừa rời khỏi màn hình làm bài! Hành vi này đã được ghi nhận và báo cáo lên giáo viên." Foreground="White" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Header bar -->
            <Border Background="White" CornerRadius="12" Padding="20,14"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel>                    <TextBlock x:Name="txtQuizTitle" Text="Chưa có bài kiểm tra" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkBrush}"/>
                        <TextBlock x:Name="txtQuizInfo" Text="Đang chờ giáo viên gửi bài kiểm tra..." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Timer -->
                        <Border x:Name="timerBorder" Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtTimer" Text="05:00" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btnZoomInFont" Content="🔍 A+" MinWidth="40" Height="40" Padding="10,0" FontSize="12" Margin="0,0,4,0" Background="#E0E0E0" BorderThickness="0" Cursor="Hand" Click="ZoomInFont_Click"/>
                        <Button x:Name="btnZoomOutFont" Content="🔍 A-" MinWidth="40" Height="40" Padding="10,0" FontSize="12" Margin="0,0,8,0" Background="#E0E0E0" BorderThickness="0" Cursor="Hand" Click="ZoomOutFont_Click"/>
                        <Button x:Name="btnSubmitQuiz" Content="📤 Nộp bài" Padding="16,8" FontSize="13"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="SubmitQuiz_Click" Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
 
        <!-- 🎯 Focus indicator from teacher -->
        <Border x:Name="focusIndicator" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PrimaryBrush}" CornerRadius="10" Padding="20,14" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="🎯" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel>
                    <TextBlock x:Name="txtFocusTitle" Text="GV yêu cầu tập trung" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtFocusDetail" Text="Hãy đọc kỹ câu hỏi được đánh dấu bên dưới" FontSize="14" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="btnCloseFocus" DockPanel.Dock="Right" Content="✕" FontSize="16" 
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Top" Padding="6" Click="CloseFocus_Click" ToolTip="Đóng"/>
            </DockPanel>
        </Border>
 
        <!-- Quiz content area -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="emptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource LightBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chưa có bài kiểm tra" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                               Margin="0,16,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="GV sẽ gửi bài kiểm tra khi bắt đầu — hãy sẵn sàng!" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
 
                <!-- Questions scroll area (hidden until quiz starts) -->
                <ScrollViewer x:Name="quizScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="24,16">
                    <StackPanel x:Name="questionsPanel">
                        <!-- Demo questions - will be generated dynamically -->
                    </StackPanel>
                </ScrollViewer>
                <!-- Auto save status indicator -->
                <TextBlock x:Name="TxtAutoSaveStatus" Text="💾 Đã tự động lưu nháp" FontSize="13" FontWeight="SemiBold" 
                           Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,24,12" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Custom Streak Congratulation Overlay -->
        <Grid x:Name="streakPopup" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#B0000000">
            <Border x:Name="streakPopupBorder" Background="White" CornerRadius="16" Padding="30" Width="360" Height="260"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#F59E0B" BorderThickness="3">
                <Border.Effect>
                    <DropShadowEffect x:Name="streakPopupEffect" BlurRadius="30" ShadowDepth="0" Color="#F59E0B" RenderingBias="Performance"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="streakPopupTransform"/>
                </Border.RenderTransform>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🔥 SIÊU CẤP COMBO 🔥" FontSize="22" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="🎉 🎆 🎇" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtStreakMessage" Text="Chúc mừng em đã trả lời đúng liên tiếp 3 câu hỏi!" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Foreground="#1E293B" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Button Content="Tuyệt vời!" Width="120" Padding="10,6" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand" Click="CloseStreakPopup_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>