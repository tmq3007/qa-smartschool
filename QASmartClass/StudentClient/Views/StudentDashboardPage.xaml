<Page x:Class="QASmartClass.StudentClient.Views.StudentDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Trang chủ" Background="#F5F7FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
            <!-- Welcome -->
            <Border Background="White" CornerRadius="12" Padding="24,20" Margin="0,0,0,16"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <DockPanel>
                    <StackPanel>
                        <TextBlock x:Name="txtWelcome" Text="Xin chào, Trần Văn B 👋" FontSize="20" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock x:Name="txtDate" Text="" FontSize="13" Foreground="#555555" Margin="0,4,0,0" FontWeight="Medium"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#E8F5E9" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Đang kết nối" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Đăng ký chỗ ngồi -->
            <Border Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💺 Số ghế phòng máy của bạn:" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,12,0"/>
                    <TextBox x:Name="txtSeatInput" Width="60" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button x:Name="btnRegisterSeat" Content="Xác nhận ghế" Padding="12,4" FontSize="13" FontWeight="Bold" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand" Click="RegisterSeat_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1565C0"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="lblSeatStatus" Text="Chưa đăng ký ghế" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#757575"/>
                </StackPanel>
            </Border>

            <!-- Stats cards -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <!-- Bài giảng -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,6,0"
                        BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonDown="GoToLesson_Click" ToolTip="Xem bài giảng hôm nay">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="36" Height="36" CornerRadius="8" Background="#E3F2FD">
                                <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#1976D2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtLessonCount" DockPanel.Dock="Right" Text="3" FontSize="28" FontWeight="Bold"
                                       Foreground="#1976D2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Bài giảng hôm nay" FontSize="13" Foreground="#424242" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Quiz -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="6,0"
                        BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonDown="GoToQuiz_Click" ToolTip="Xem bài kiểm tra">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="36" Height="36" CornerRadius="8" Background="#FFF3E0">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtQuizCount" DockPanel.Dock="Right" Text="1" FontSize="28" FontWeight="Bold"
                                       Foreground="#E65100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Bài kiểm tra chờ" FontSize="13" Foreground="#424242" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Bài nộp -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="6,0"
                        BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonDown="GoToSubmit_Click" ToolTip="Xem bài đã nộp">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="36" Height="36" CornerRadius="8" Background="#E8F5E9">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtSubmitCount" DockPanel.Dock="Right" Text="5" FontSize="28" FontWeight="Bold"
                                       Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Bài đã nộp" FontSize="13" Foreground="#424242" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Điểm TB -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="6,0,0,0"
                        BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonDown="GoToResults_Click" ToolTip="Xem kết quả học tập">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="36" Height="36" CornerRadius="8" Background="#F3E5F5">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#7B1FA2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtAvgScore" DockPanel.Dock="Right" Text="8.5" FontSize="28" FontWeight="Bold"
                                       Foreground="#7B1FA2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Điểm trung bình" FontSize="13" Foreground="#424242" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Current lesson / Activity -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Current lesson -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📖 Bài giảng đang diễn ra" FontSize="16" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,12"/>
                        <Border Background="#F5F7FA" CornerRadius="10" Padding="16" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="txtCurrentLessonClass" Text="Toán 10A — Tiết 3" FontSize="17" FontWeight="Bold" Foreground="#1E3A8A"/>
                                <TextBlock x:Name="txtCurrentLessonTitle" Text="Hàm số bậc nhất — Bất đẳng thức" FontSize="14" FontWeight="Medium" Foreground="#2D3748" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="#E8F2FF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtCurrentLessonTeacher" Text="GV: Nguyễn Văn A" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                    </Border>
                                    <Border Background="#FFF2E6" CornerRadius="6" Padding="8,4">
                                        <TextBlock x:Name="txtCurrentLessonSlide" Text="Slide 5/12" FontSize="12" FontWeight="SemiBold" Foreground="#C2410C"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Quick actions -->
                        <WrapPanel Margin="0,12,0,0">
                            <Border Background="#DCFCE7" CornerRadius="8" Padding="14,10" Margin="0,0,10,6" Cursor="Hand"
                                    MouseLeftButtonDown="GoToHandRaise_Click" ToolTip="Giơ tay hỏi giáo viên">
                                <TextBlock Text="✋ Giơ tay hỏi" FontSize="13" Foreground="#15803D" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#DBEAFE" CornerRadius="8" Padding="14,10" Margin="0,0,10,6" Cursor="Hand"
                                    MouseLeftButtonDown="GoToChat_Click" ToolTip="Gửi tin nhắn cho giáo viên">
                                <TextBlock Text="💬 Gửi tin nhắn" FontSize="13" Foreground="#1D4ED8" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#FFEDD5" CornerRadius="8" Padding="14,10" Margin="0,0,10,6" Cursor="Hand"
                                    MouseLeftButtonDown="GoToSubmit_Click" ToolTip="Nộp bài tập">
                                <TextBlock Text="📎 Nộp bài" FontSize="13" Foreground="#C2410C" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔔 Thông báo" FontSize="16" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,12"/>
                        <!-- Notification items -->
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📝 Bài kiểm tra mới" FontSize="13" FontWeight="Bold" Foreground="#B45309"/>
                                <TextBlock Text="GV gửi Quiz — Hàm số bậc nhất" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="2 phút trước" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#D1FAE5" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📁 Tài liệu mới" FontSize="13" FontWeight="Bold" Foreground="#047857"/>
                                <TextBlock Text="GV phát file: BaiTap_Chuong3.pdf" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="10 phút trước" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#DBEAFE" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="💬 Tin nhắn từ GV" FontSize="13" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <TextBlock Text="Các em mở SGK trang 45 nhé" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="15 phút trước" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F3E8FF" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="🏆 Kết quả Quiz" FontSize="13" FontWeight="Bold" Foreground="#6B21A8"/>
                                <TextBlock Text="Bạn đạt 9/10 điểm — Xếp hạng #3" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="30 phút trước" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
