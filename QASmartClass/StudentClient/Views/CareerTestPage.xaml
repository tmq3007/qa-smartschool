<Page x:Class="QASmartClass.StudentClient.Views.CareerTestPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Trắc nghiệm Hướng nghiệp" Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Text="🎯 Trắc nghiệm Hướng nghiệp MBTI &amp; Holland" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

        <TextBlock Text="Lựa chọn các câu hỏi dưới đây để khám phá bản thân và nhận gợi ý ngành nghề phù hợp nhất." FontSize="14" Foreground="#64748B" Margin="0,0,0,20"/>



        <!-- Trắc nghiệm (Mock UI) -->

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="350"/>

                </Grid.ColumnDefinitions>



                <!-- Panel trắc nghiệm -->

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">

                    <StackPanel Margin="0,0,10,0">

                        <!-- Câu 1 -->

                        <TextBlock Text="Câu 1: Trong một bữa tiệc, bạn thường:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>

                        <RadioButton x:Name="RbQ1A" Content="A. Trò chuyện với nhiều người, kể cả người lạ" FontSize="14" Margin="0,5" GroupName="Q1"/>

                        <RadioButton x:Name="RbQ1B" Content="B. Chỉ nói chuyện với vài người bạn thân" FontSize="14" Margin="0,5" GroupName="Q1"/>

                        

                        <Border Height="1" Background="#E2E8F0" Margin="0,15"/>



                        <!-- Câu 2 -->

                        <TextBlock Text="Câu 2: Bạn thích làm việc theo:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>

                        <RadioButton x:Name="RbQ2A" Content="A. Kế hoạch rõ ràng, chi tiết" FontSize="14" Margin="0,5" GroupName="Q2"/>

                        <RadioButton x:Name="RbQ2B" Content="B. Linh hoạt, tùy cơ ứng biến" FontSize="14" Margin="0,5" GroupName="Q2"/>



                        <Border Height="1" Background="#E2E8F0" Margin="0,15"/>



                        <!-- Câu 3 -->

                        <TextBlock Text="Câu 3: Khi giải quyết vấn đề, bạn tin tưởng vào:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>

                        <RadioButton x:Name="RbQ3A" Content="A. Kinh nghiệm thực tế và số liệu cụ thể" FontSize="14" Margin="0,5" GroupName="Q3"/>

                        <RadioButton x:Name="RbQ3B" Content="B. Trực giác và ý tưởng sáng tạo mới" FontSize="14" Margin="0,5" GroupName="Q3"/>



                        <Border Height="1" Background="#E2E8F0" Margin="0,15"/>



                        <!-- Câu 4 -->

                        <TextBlock Text="Câu 4: Khi đưa ra quyết định, bạn ưu tiên:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>

                        <RadioButton x:Name="RbQ4A" Content="A. Logic, tính công bằng và khách quan" FontSize="14" Margin="0,5" GroupName="Q4"/>

                        <RadioButton x:Name="RbQ4B" Content="B. Cảm xúc cá nhân và sự hòa hợp của mọi người" FontSize="14" Margin="0,5" GroupName="Q4"/>



                        <Border Height="1" Background="#E2E8F0" Margin="0,15"/>



                        <!-- Câu 5 -->

                        <TextBlock Text="Câu 5: Bạn cảm thấy hứng thú nhất với công việc:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>

                        <RadioButton x:Name="RbQ5A" Content="A. Lắp ráp, sửa chữa máy móc hoặc làm việc ngoài trời (R)" FontSize="14" Margin="0,5" GroupName="Q5"/>

                        <RadioButton x:Name="RbQ5B" Content="B. Nghiên cứu khoa học, phân tích số liệu (I)" FontSize="14" Margin="0,5" GroupName="Q5"/>

                        <RadioButton x:Name="RbQ5C" Content="C. Sáng tác nghệ thuật, viết lách, thiết kế (A)" FontSize="14" Margin="0,5" GroupName="Q5"/>



                        <Border Height="1" Background="#E2E8F0" Margin="0,15"/>



                        <!-- Câu 6 -->

                        <TextBlock Text="Câu 6: Trong công việc nhóm, vai trò yêu thích của bạn là:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#1E293B"/>

                        <RadioButton x:Name="RbQ6A" Content="A. Hỗ trợ, tư vấn và giúp đỡ các thành viên (S)" FontSize="14" Margin="0,5" GroupName="Q6"/>

                        <RadioButton x:Name="RbQ6B" Content="B. Thuyết phục đối tác, tổ chức và điều hành (E)" FontSize="14" Margin="0,5" GroupName="Q6"/>

                        <RadioButton x:Name="RbQ6C" Content="C. Lập bảng kế hoạch, sắp xếp và lưu trữ hồ sơ (C)" FontSize="14" Margin="0,5" GroupName="Q6"/>



                        <Border Height="1" Background="#E2E8F0" Margin="0,20"/>



                        <Button x:Name="BtnSubmit" Content="Nộp bài &amp; Xem kết quả" Background="#8B5CF6" Foreground="White" Padding="20,10" BorderThickness="0" HorizontalAlignment="Left" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="BtnSubmit_Click">

                            <Button.Resources>

                                <Style TargetType="Border">

                                    <Setter Property="CornerRadius" Value="8"/>

                                </Style>

                            </Button.Resources>

                        </Button>

                    </StackPanel>

                </ScrollViewer>



                <!-- Panel Kết quả (ẩn mặc định) -->

                <Border x:Name="PanelResult" Grid.Column="1" Background="#F8FAFC" CornerRadius="10" Padding="15" Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="Kết Quả Của Bạn" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                        

                        <TextBlock Text="Kiểu MBTI:" FontSize="13" Foreground="#64748B"/>

                        <TextBlock x:Name="TxtMbti" Text="INTJ" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,5"/>

                        <TextBlock Text="(Nhà Khoa Học - Chiến Lược Gia)" FontSize="13" Foreground="#475569" FontStyle="Italic" Margin="0,0,0,15"/>



                        <TextBlock Text="Holland Code (RIASEC):" FontSize="13" Foreground="#64748B"/>

                        <TextBlock x:Name="TxtHolland" Text="IRC (Investigative - Realistic - Conventional)" FontSize="14" FontWeight="SemiBold" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,0,0,20"/>



                        <TextBlock Text="Top 3 Ngành Nghề Phù Hợp:" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                        

                        <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="Career_Click" Tag="1">

                            <TextBlock x:Name="TxtCareer1" Text="1. Kỹ sư phần mềm" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" TextDecorations="Underline"/>

                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="Career_Click" Tag="2">

                            <TextBlock x:Name="TxtCareer2" Text="2. Chuyên viên phân tích dữ liệu" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" TextDecorations="Underline"/>

                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="Career_Click" Tag="3">

                            <TextBlock x:Name="TxtCareer3" Text="3. Nghiên cứu khoa học" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" TextDecorations="Underline"/>

                        </Border>



                        <TextBlock Text="* Kết quả đã được lưu vào E-Portfolio của bạn." FontSize="11" Foreground="#94A3B8" Margin="0,15,0,0" FontStyle="Italic" TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>



