<Page x:Class="QASmartClass.StudentClient.Views.StudentChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tin nhắn" Background="#F5F7FA"
      FontFamily="Segoe UI, Arial, Helvetica">

    <Page.Resources>
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="VibrateStickerAnim">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="6" Duration="0:0:0.05" AutoReverse="True" RepeatBehavior="2x"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT SIDEBAR — matching teacher layout ═══ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <DockPanel Grid.Row="0" Margin="14,12,14,8">
                    <StackPanel>
                        <TextBlock Text="💬 Tin nhắn lớp học" FontSize="18.5" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock x:Name="txtOnlineCount" Text="🟢 Đang trực tuyến" FontSize="10.5" Foreground="#616161" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Search box -->
                <Border Grid.Row="1" Margin="12,0,12,8" Background="#F5F7FA" CornerRadius="10" Padding="10,6">
                    <Grid>
                        <TextBlock x:Name="searchPlaceholder" Text="🔍 Tìm kiếm..." FontSize="12" Foreground="#BDBDBD"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" FontSize="12"
                                 VerticalContentAlignment="Center" TextChanged="Search_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Filter tabs -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8">
                    <Button x:Name="tabAll" Content="📋 Tất cả" FontSize="11" Padding="10,5"
                            Style="{StaticResource SideBtn}" Background="#1976D2" Foreground="White"
                            Margin="0,0,4,0" Click="TabAll_Click"/>
                    <Button x:Name="tabGroup" Content="🏫 Cả lớp" FontSize="11" Padding="10,5"
                            Style="{StaticResource SideBtn}" Background="#F5F5F5" Foreground="#616161"
                            Margin="0,0,4,0" Click="TabGroup_Click"/>
                    <Button x:Name="tabPrivate" Content="🔒 Riêng" FontSize="11" Padding="10,5"
                            Style="{StaticResource SideBtn}" Background="#F5F5F5" Foreground="#616161"
                            Click="TabPrivate_Click"/>
                </StackPanel>

                <!-- Sort options -->
                <Border Grid.Row="3" Margin="12,0,12,6" Background="#FAFAFA" CornerRadius="8" Padding="4,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sắp xếp:" FontSize="10" Foreground="#616161" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <Button x:Name="sortOnline" Content="🟢 Online" FontSize="10" Padding="6,3"
                                Style="{StaticResource SideBtn}" Background="#E8F5E9" Foreground="#2E7D32"
                                Margin="0,0,3,0" Click="SortOnline_Click"/>
                        <Button x:Name="sortName" Content="A→Z" FontSize="10" Padding="6,3"
                                Style="{StaticResource SideBtn}" Background="#F5F5F5" Foreground="#616161"
                                Margin="0,0,3,0" Click="SortName_Click"/>
                        <Button x:Name="sortRecent" Content="🕐 Mới" FontSize="10" Padding="6,3"
                                Style="{StaticResource SideBtn}" Background="#F5F5F5" Foreground="#616161"
                                Margin="0,0,3,0" Click="SortRecent_Click"/>
                        <Button x:Name="sortUnread" Content="🔴 Chưa đọc" FontSize="10" Padding="6,3"
                                Style="{StaticResource SideBtn}" Background="#F5F5F5" Foreground="#616161"
                                Click="SortUnread_Click"/>
                    </StackPanel>
                </Border>

                <!-- Channel list -->
                <ListBox x:Name="channelList" Grid.Row="4" BorderThickness="0" Background="Transparent"
                         Padding="6,4" SelectionChanged="Channel_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0"
                                        Background="{Binding AvatarBg}">
                                    <TextBlock Text="{Binding AvatarText}" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>

                                <!-- Name + Last message + Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15.5" FontWeight="SemiBold" Foreground="#212121"/>
                                    <TextBlock Text="{Binding LastMessage}" FontSize="11.5" Foreground="#757575" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastMessage}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#BDBDBD" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Time + Unread badge -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastTimeStr}" FontSize="10" Foreground="#BDBDBD"
                                               HorizontalAlignment="Right"/>
                                    <Border CornerRadius="9" MinWidth="18" Height="18"
                                            Background="#EF5350" Margin="0,3,0,0" HorizontalAlignment="Right"
                                            Padding="5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding UnreadCount}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State UI -->
                <Border x:Name="panelEmptyState" Grid.Row="4" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📖" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Chưa có cuộc hội thoại nào" FontSize="13" FontWeight="SemiBold" Foreground="#757575" HorizontalAlignment="Center"/>
                        <TextBlock Text="Học sinh trực tuyến sẽ hiển thị tại đây" FontSize="11" Foreground="#616161" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Grid Splitter co giãn Sidebar học sinh -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" Background="#E0E0E0" ShowsPreview="True"/>

        <!-- ═══ RIGHT SIDE — Chat Area ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat header — matching teacher layout -->
            <Border Grid.Row="0" Background="White" Padding="16,10,16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Right: action buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📢 Thông báo" Style="{StaticResource SideBtn}"
                                Background="#FFF3E0" Foreground="#E65100" FontSize="11"
                                Margin="0,0,4,0"/>
                        <Button Content="📜 Lịch sử" Style="{StaticResource SideBtn}"
                                Background="#E8EAF6" Foreground="#283593" FontSize="11"
                                Margin="0,0,4,0"/>
                        <Button x:Name="btnClearChat" Content="🗑️" ToolTip="Xóa tin nhắn" Style="{StaticResource SideBtn}"
                                Background="#FFEBEE" Foreground="#C62828" FontSize="11"
                                Visibility="Collapsed"
                                Click="ClearChat_Click"/>
                    </StackPanel>

                    <!-- Left: avatar + info -->
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="chatAvatar" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2E7D32" Offset="0"/>
                                    <GradientStop Color="#66BB6A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="chatAvatarText" Text="👥" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtChatTitle" Text="Cả lớp" FontSize="19" FontWeight="Bold" Foreground="#1A1A1A"/>
                            <TextBlock x:Name="txtChatSubtitle" Text="Nhắn tin chung với GV và cả lớp" FontSize="13.5" Foreground="#616161"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Sub-header -->
            <Border Grid.Row="1" Background="#FAFBFC" Padding="16,5" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock x:Name="txtStats" DockPanel.Dock="Right" Text="0 tin nhắn" FontSize="10" Foreground="#616161" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E3F2FD" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                            <TextBlock Text="💬 Trò chuyện" FontSize="10.5" FontWeight="SemiBold" Foreground="#1976D2"/>
                        </Border>
                        <Border Background="#F5F5F5" CornerRadius="10" Padding="10,3">
                            <TextBlock x:Name="txtMembers" Text="👥 0 thành viên" FontSize="10.5" Foreground="#757575"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Messages area -->
            <ScrollViewer Grid.Row="2" x:Name="chatScroll" VerticalScrollBarVisibility="Auto" Background="#F0F2F5" Padding="16,8">
                <StackPanel x:Name="messagesPanel"/>
            </ScrollViewer>

            <!-- Input area — Enhanced (matching teacher) -->
            <Border Grid.Row="3" Background="White" Padding="10,8,10,8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Quick feedback reactions panel -->
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,8">
                        <TextBlock Text="Phản hồi nhanh:" VerticalAlignment="Center" FontSize="11" Foreground="#757575" Margin="0,0,10,0"/>
                        <Button x:Name="btnToggleReactionPopover" Content="😊 Phản hồi nhanh" Style="{StaticResource SideBtn}" Background="#E3F2FD" Foreground="#1565C0" Padding="12,5" Click="btnToggleReactionPopover_Click"/>
                        <Popup x:Name="popQuickReactions" PlacementTarget="{Binding ElementName=btnToggleReactionPopover}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnReactionUnderstand" Content="👍 Đã hiểu" Style="{StaticResource SideBtn}" Background="#E8F5E9" Foreground="#2E7D32" Padding="10,5" Margin="0,0,4,0" Click="ReactionBtn_Click">
                                        <Button.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Button.RenderTransform>
                                    </Button>
                                    <Button x:Name="btnReactionConfused" Content="😕 Chưa hiểu" Style="{StaticResource SideBtn}" Background="#FFF3E0" Foreground="#E65100" Padding="10,5" Margin="0,0,4,0" Click="ReactionBtn_Click">
                                        <Button.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Button.RenderTransform>
                                    </Button>
                                    <Button x:Name="btnReactionHelp" Content="🙋 Cần trợ giúp" Style="{StaticResource SideBtn}" Background="#E8EAF6" Foreground="#283593" Padding="10,5" Margin="0,0,4,0" Click="ReactionBtn_Click">
                                        <Button.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Button.RenderTransform>
                                    </Button>
                                    <Button x:Name="btnReactionCongrats" Content="👏 Tuyệt vời" Style="{StaticResource SideBtn}" Background="#FCE4EC" Foreground="#C2185B" Padding="10,5" Click="ReactionBtn_Click">
                                        <Button.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Button.RenderTransform>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: attach + feedback emojis -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="➕" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Đính kèm tệp"
                                    Style="{StaticResource SideBtn}" Background="Transparent"
                                    Foreground="#757575" Padding="6,4" Margin="0,0,2,0"
                                    Click="AttachFile_Click"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Height="20" Margin="4,0,8,0"/>
                            <Button x:Name="btnEmojiLight" Content="💡" FontSize="15" ToolTip="Đã hiểu bài" Style="{StaticResource SideBtn}" Margin="0,0,3,0" Click="FeedbackEmoji_Click"/>
                            <Button x:Name="btnEmojiQuestion" Content="❓" FontSize="15" ToolTip="Chưa hiểu rõ" Style="{StaticResource SideBtn}" Margin="0,0,3,0" Click="FeedbackEmoji_Click"/>
                            <Button x:Name="btnEmojiRaise" Content="🙋" FontSize="15" ToolTip="Muốn phát biểu" Style="{StaticResource SideBtn}" Margin="0,0,3,0" Click="FeedbackEmoji_Click"/>
                            <Button x:Name="btnEmojiWait" Content="⏳" FontSize="15" ToolTip="Cần thêm thời gian" Style="{StaticResource SideBtn}" Click="FeedbackEmoji_Click"/>
                        </StackPanel>

                        <!-- Text input with placeholder -->
                        <Border x:Name="txtMessageBorder" Grid.Column="1" Background="#F5F7FA" CornerRadius="20" Padding="14,0" Margin="4,0">
                            <Grid>
                                <TextBlock x:Name="inputPlaceholder" Text="Nhập nội dung tin nhắn và nhấn Enter để gửi..."
                                           FontSize="14" Foreground="#BDBDBD" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="txtMessage" Background="Transparent" BorderThickness="0"
                                         FontSize="14.5" VerticalContentAlignment="Center"
                                         AcceptsReturn="False" KeyDown="TxtMessage_KeyDown"
                                         TextChanged="TxtMessage_TextChanged"
                                         Padding="0,8" MaxLength="500"/>
                            </Grid>
                        </Border>

                        <!-- Right: emoji/attach/send -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="😊" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Biểu cảm"
                                    Style="{StaticResource SideBtn}" Background="Transparent"
                                    Foreground="#757575" Padding="5,4" Margin="2,0"
                                    Click="ShowEmoji_Click"/>
                            <Button Content="👍" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Thích"
                                    Style="{StaticResource SideBtn}" Background="Transparent"
                                    Foreground="#757575" Padding="5,4" Margin="2,0"
                                    Click="QuickLike_Click"/>
                            <Button Content="📎" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Đính kèm ảnh / file"
                                    Style="{StaticResource SideBtn}" Background="Transparent"
                                    Foreground="#757575" Padding="5,4" Margin="2,0"
                                    Click="AttachMedia_Click"/>
                            <Button Content="🎤" FontSize="15" FontFamily="Segoe UI Emoji" ToolTip="Ghi âm giọng nói"
                                    Style="{StaticResource SideBtn}" Background="Transparent"
                                    Foreground="#757575" Padding="5,4" Margin="2,0"
                                    Visibility="Collapsed"
                                    Click="VoiceRecord_Click"/>
                            <Button Content="😃" FontSize="16" FontFamily="Segoe UI Emoji" ToolTip="Sticker"
                                    Style="{StaticResource SideBtn}" Background="Transparent"
                                    Foreground="#757575" Padding="5,4" Margin="2,0,4,0"
                                    Click="ShowSticker_Click"/>

                            <!-- Send button -->
                            <Button x:Name="btnSendMessage" Width="44" Height="44" Margin="4,0,0,0"
                                    Click="SendMessage_Click" ToolTip="Gửi tin nhắn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="22" Width="44" Height="44">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1976D2" Offset="0"/>
                                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="▶" FontSize="15" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>