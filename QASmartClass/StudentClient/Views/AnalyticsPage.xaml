<Page x:Class="QASmartClass.StudentClient.Views.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tiến trình học tập" Background="#F0F2F5">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Center">
            
            <!-- Header -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="30" Margin="0,0,16,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="btnRefresh" DockPanel.Dock="Right" Content="🔄 Tải lại" Click="btnRefresh_Click" 
                            Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                            FontWeight="Bold" Height="35" Width="100" VerticalAlignment="Center" Margin="10,0,0,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnExportPdf" DockPanel.Dock="Right" Content="📥 Xuất báo cáo PDF" Click="btnExportPdf_Click" 
                            Background="#0284C7" Foreground="White" FontWeight="Bold" Height="35" Width="160"
                            VerticalAlignment="Center" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Phân tích &amp; Tiến trình học tập" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Theo dõi điểm số, điểm mạnh/yếu và thành tựu của bạn" FontSize="14" Foreground="#64748B"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dashboard Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left Column: Chart & Weak Areas -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    
                    <!-- Trend Card -->
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20" MinHeight="120">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Xu hướng học tập" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtTrend" Text="Đang tải dữ liệu..." FontSize="24" FontWeight="Bold" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Border>

                    <!-- Score Timeline Chart (Native WPF) -->
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Biểu đồ điểm số gần đây" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,20"/>
                            
                            <!-- Bộ lọc Học kỳ và Môn học -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Học kỳ:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cbSemesterFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Height="32">
                                        <ComboBoxItem Content="Tất cả học kỳ" Tag="All"/>
                                        <ComboBoxItem Content="Học kỳ 1" Tag="HK1"/>
                                        <ComboBoxItem Content="Học kỳ 2" Tag="HK2"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Môn học:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cbSubjectFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Height="32">
                                        <ComboBoxItem Content="Tất cả môn học"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Placeholder when no chart data -->
                            <Border x:Name="borderNoChartData" Background="#F8FAFC" CornerRadius="8" Height="252" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed" Padding="20">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📚" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Chưa có điểm số cho môn học này trong Học kỳ đã chọn. Hãy cố gắng làm bài tập sắp tới nhé!" 
                                               FontSize="13" Foreground="#64748B" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="gridChartArea" Height="252" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Y Axis Labels -->
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="10" FontSize="11" Foreground="#64748B" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="5" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="0" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                
                                <!-- Chart Area with Gridlines (Row 1) -->
                                <Grid Grid.Column="1" Grid.Row="1">
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" VerticalAlignment="Top"/>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" VerticalAlignment="Center"/>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                </Grid>
                                
                                <!-- Chart Items (RowSpan 3 to overlay Row 0, 1, 2) -->
                                <ItemsControl Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" x:Name="chartTimeline">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding Topic}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="200"/>
                                                    <RowDefinition Height="32"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Score text on top of bar (Row 0) -->
                                                <TextBlock Grid.Row="0" Text="{Binding ScoreText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ColorStart}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                           
                                                <!-- Bar (Row 1) -->
                                                <Border Grid.Row="1" Width="24" Height="{Binding ChartHeight}"
                                                        CornerRadius="4,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="{Binding ColorStart}" Offset="0"/>
                                                            <GradientStop Color="{Binding ColorMid}" Offset="0.7"/>
                                                            <GradientStop Color="{Binding ColorEnd}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                
                                                <!-- Subject Label (Row 2) -->
                                                <TextBlock Grid.Row="2" Text="{Binding Subject}" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" 
                                                           TextWrapping="Wrap" MaxWidth="60" Height="32" TextAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Achievements & Weak Areas -->
                <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="10,0,0,0">
                    
                    <!-- Achievements -->
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🏆 Thành tựu" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
                            <ItemsControl x:Name="listAchievements">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                                BorderBrush="#E2E8F0" BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Icon}" FontSize="24" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AchievementName}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="txtNoAchievements" Text="Chưa có thành tựu nào. Hãy làm bài tập để mở khóa nhé!" 
                                       Foreground="#94A3B8" FontStyle="Italic" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Weak Areas (Cần cải thiện) -->
                    <Border x:Name="cardWeakAreas" Background="#FEF2F2" CornerRadius="12" Padding="20" BorderBrush="#FECACA" BorderThickness="1" Visibility="Collapsed" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="⚠️ Cần cải thiện" FontSize="16" FontWeight="SemiBold" Foreground="#991B1B" Margin="0,0,0,16"/>
                            <ItemsControl x:Name="listWeakAreas">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                                BorderBrush="#FCA5A5" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold" Foreground="#991B1B"/>
                                                <TextBlock Text="{Binding Topic}" FontSize="12" Foreground="#B91C1C"/>
                                                <TextBlock Text="{Binding AvgText}" FontSize="11" Foreground="#DC2626" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Commendation / Good Status (Phong độ học tập) -->
                    <Border x:Name="cardNoWeakAreas" Background="#ECFDF5" CornerRadius="12" Padding="20" BorderBrush="#A7F3D0" BorderThickness="1" Visibility="Collapsed" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🌟 Phong độ học tập" FontSize="16" FontWeight="SemiBold" Foreground="#065F46" Margin="0,0,0,16"/>
                            <TextBlock Text="🎉 Tuyệt vời! Bạn đang hoàn thành tốt tất cả các chủ đề học tập và không có chủ đề nào bị yếu. Hãy tiếp tục giữ vững phong độ nhé!" 
                                       Foreground="#047857" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
