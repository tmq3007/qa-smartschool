<Page x:Class="QASmartClass.StudentClient.Views.GoalSettingPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Muc tieu hoc tap" Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <DockPanel Grid.Row="0" Margin="0,0,0,16">

            <TextBlock Text="🎯 Đặt Mục Tiêu Học Tập" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>

            <Button x:Name="BtnAdd" Content="＋ Thêm mục tiêu" Click="BtnAdd_Click"

                    DockPanel.Dock="Right" HorizontalAlignment="Right"

                    FontSize="13" Padding="12,6" Background="#10B981"

                    Foreground="White" BorderThickness="0"/>

        </DockPanel>



        <!-- AI Suggestion -->

        <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,0,0,14">

            <StackPanel>

                <TextBlock Text="💡 Gợi ý AI" FontSize="14" FontWeight="SemiBold" Foreground="#1D4ED8"/>

                <TextBlock x:Name="TxtAiSuggestion" Text="Đang phân tích..." FontSize="12"

                           Foreground="#3B82F6" TextWrapping="Wrap" Margin="0,4,0,0"/>

            </StackPanel>

        </Border>



        <!-- Goals List -->

        <ItemsControl x:Name="LstGoals" Grid.Row="2">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,10"

                            BorderBrush="#E2E8F0" BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="120"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="{Binding SubjectLine}" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">

                                    <Border Background="{Binding StatusBg}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">

                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusFg}" FontWeight="SemiBold"/>

                                    </Border>

                                    <TextBlock Text="{Binding SemesterText}" FontSize="11" Foreground="#94A3B8"/>

                                </StackPanel>

                                <!-- Progress bar -->

                                <Grid Height="8" Margin="0,2,0,0">

                                    <Border Background="#F1F5F9" CornerRadius="4"/>

                                    <Border Background="{Binding ProgressBrush}" CornerRadius="4"

                                            Width="{Binding ProgressWidth}" HorizontalAlignment="Left"/>

                                </Grid>

                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock Text="{Binding ScoreDisplay}" FontSize="20" FontWeight="Bold"

                                           Foreground="{Binding ProgressBrush}" HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding TargetDisplay}" FontSize="11" Foreground="#94A3B8"

                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Grid>

</Page>



