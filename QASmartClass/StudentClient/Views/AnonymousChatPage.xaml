<Page x:Class="QASmartClass.StudentClient.Views.AnonymousChatPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Góc chia sẻ Ẩn danh" Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Text="🎭 Góc chia sẻ Ẩn danh (Mọi thông tin đều được bảo mật tuyệt đối)" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>



        <!-- Form gui cau hoi -->

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <StackPanel>

                <TextBlock Text="Bạn đang gặp khó khăn gì?" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>

                <ComboBox x:Name="CbCategory" Height="35" FontSize="15" Margin="0,0,0,10">

                    <ComboBoxItem Content="Áp lực học tập" Tag="Study" IsSelected="True"/>

                    <ComboBoxItem Content="Mối quan hệ bạn bè" Tag="Friends"/>

                    <ComboBoxItem Content="Tâm lý / Cảm xúc" Tag="Psychology"/>

                    <ComboBoxItem Content="Vấn đề khác" Tag="Other"/>

                </ComboBox>

                <TextBox x:Name="TxtQuestion" Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontSize="15" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="0,0,0,10"/>

                <Button Content="Gửi Ẩn Danh" Height="40" Background="#3B82F6" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSend_Click"/>

            </StackPanel>

        </Border>



        <!-- Lich su -->

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <TextBlock Text="Lịch sử trò chuyện" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                

                <ListView Grid.Row="1" x:Name="LvHistory" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">

                                <StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                                        <TextBlock Text="{Binding Category}" FontWeight="Bold" Foreground="#64748B" Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" FontSize="13" Foreground="#94A3B8"/>

                                    </StackPanel>

                                    <TextBlock Text="{Binding Question}" FontSize="15" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    

                                    <Border Background="#E0E7FF" CornerRadius="8" Padding="10" Visibility="{Binding HasAnswer}">

                                        <StackPanel>

                                            <TextBlock Text="Chuyên viên tâm lý phản hồi:" FontSize="13" FontWeight="SemiBold" Foreground="#4338CA" Margin="0,0,0,5"/>

                                            <TextBlock Text="{Binding Answer}" FontSize="14" Foreground="#312E81" TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

    </Grid>

</Page>



