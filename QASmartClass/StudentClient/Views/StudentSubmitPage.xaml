<Page x:Class="QASmartClass.StudentClient.Views.StudentSubmitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nộp bài" Background="#F5F7FA" AllowDrop="True"
      DragEnter="Page_DragEnter" DragOver="Page_DragOver"
      DragLeave="Page_DragLeave" Drop="Page_Drop">

    <Page.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0,0,0,3.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7,7,2,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: Main content ═══ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📤 Nộp file" Style="{StaticResource ActionBtn}"
                                Padding="12,8" Background="#1976D2" Foreground="White"
                                Click="SubmitFile_Click" Margin="0,0,6,0"/>
                        <Button Content="📝 Viết bài" Style="{StaticResource ActionBtn}"
                                Padding="12,8" Background="#7B1FA2" Foreground="White"
                                Click="WriteInline_Click" Margin="0,0,6,0"/>
                        <Button Content="📂 Thư mục" Style="{StaticResource ActionBtn}"
                                Padding="12,8" Background="#E3F2FD" Foreground="#1565C0"
                                Click="OpenFolder_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="📁 Phát / Thu bài" FontSize="20" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock x:Name="txtSubtitle" Text="Nhận tài liệu từ GV • Nộp bài làm"
                                   FontSize="13" Foreground="#616161" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Assignment Info from GV -->
            <Border x:Name="assignmentPanel" Grid.Row="1" Background="#E3F2FD" CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                    BorderBrush="#90CAF9" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="📋 Yêu cầu bài tập từ GV" FontSize="13" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock x:Name="txtDeadline" DockPanel.Dock="Right" Text="" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="txtAssignment" TextWrapping="Wrap" FontSize="13" Foreground="#212121"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="txtCountdown" Text="" FontSize="12" Foreground="#E65100" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Stats Bar -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <UniformGrid Columns="3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtReceivedCount" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="#1976D2" HorizontalAlignment="Center"/>
                        <TextBlock Text="📥 Nhận" FontSize="13" Foreground="#666" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtSubmittedCount" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="#4CAF50" HorizontalAlignment="Center"/>
                        <TextBlock Text="📤 Đã nộp" FontSize="13" Foreground="#666" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtPendingCount" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="#FF9800" HorizontalAlignment="Center"/>
                        <TextBlock Text="⚠️ Chưa gửi" FontSize="13" Foreground="#666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- File List with Tabs -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="10,10,0,0" Padding="12,8">
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="tabReceived" Content="📥 Tài liệu nhận" Style="{StaticResource ActionBtn}"
                                    Background="#E3F2FD" Foreground="#1565C0" Margin="0,0,6,6"
                                    Click="TabReceived_Click"/>
                            <Button x:Name="tabSubmitted" Content="📤 Bài đã nộp" Style="{StaticResource ActionBtn}"
                                    Background="#F5F5F5" Foreground="#666" Margin="0,0,6,6"
                                    Click="TabSubmitted_Click"/>
                            <Button x:Name="tabEditor" Content="📝 Soạn bài" Style="{StaticResource ActionBtn}"
                                    Background="#F5F5F5" Foreground="#666" Margin="0,0,6,6"
                                    Click="TabEditor_Click"/>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="fileListPanel" Margin="10,6,10,10"/>
                    </ScrollViewer>

                    <!-- Inline Editor (hidden by default) -->
                    <Grid x:Name="editorPanel" Grid.Row="1" Visibility="Collapsed" Margin="10,6,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="txtEditorTitle" Grid.Row="0" Text="Bài làm" FontSize="14"
                                 FontWeight="SemiBold" Padding="10,8" Margin="0,0,0,6"
                                 BorderBrush="#E0E0E0"/>
                        <TextBox x:Name="txtEditorContent" Grid.Row="1" TextWrapping="Wrap"
                                 AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                                 FontSize="14" FontFamily="Segoe UI" Padding="10,8" BorderBrush="#E0E0E0"
                                 Text="" GotFocus="EditorContent_GotFocus" LostFocus="EditorContent_LostFocus" Foreground="Gray"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBlock Text="🎯 Mục tiêu:" FontSize="12" Foreground="#616161" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cboWordTarget" Width="80" FontSize="11" SelectedIndex="0" VerticalAlignment="Center" Margin="0,0,10,0" SelectionChanged="WordTarget_SelectionChanged">
                                <ComboBoxItem Content="Tự do"/>
                                <ComboBoxItem Content="50 từ"/>
                                <ComboBoxItem Content="100 từ"/>
                                <ComboBoxItem Content="150 từ"/>
                                <ComboBoxItem Content="200 từ"/>
                                <ComboBoxItem Content="300 từ"/>
                            </ComboBox>
                            <ProgressBar x:Name="pbWordProgress" Width="120" Height="8" Minimum="0" Maximum="100" Value="0"
                                         VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0" Foreground="#2196F3"/>
                            <TextBlock x:Name="txtTargetPercent" Text="" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" Foreground="#1565C0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <TextBlock x:Name="txtAutosaveStatus" Text="" FontSize="12" FontStyle="Italic" Foreground="#2E7D32"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock x:Name="txtWordCount" Text="0 từ" FontSize="12" FontWeight="SemiBold" Foreground="#757575"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="📤 Nộp bài viết" Style="{StaticResource ActionBtn}"
                                    Background="#4CAF50" Foreground="White" Padding="14,8"
                                    Click="SubmitInline_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Progress + Drop Zone -->
            <Border Grid.Row="4" Margin="0,8,0,0" Background="White" CornerRadius="8" Padding="12,8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <DockPanel>
                    <Button x:Name="btnSyncOffline" DockPanel.Dock="Right" Content="🔄 Đồng bộ ngoại tuyến" 
                            Style="{StaticResource ActionBtn}" Background="#FF9800" Foreground="White" 
                            Padding="10,6" Margin="10,0,0,0" FontSize="12" Click="SyncOffline_Click" Visibility="Collapsed"/>
                    <StackPanel VerticalAlignment="Center">
                        <ProgressBar x:Name="progressBar" Height="5" Value="0"
                                     Background="#F5F5F5" Foreground="#4CAF50" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtStatus" Text="📂 Sẵn sàng · Có thể kéo thả file vào trang này để nộp"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#424242"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ RIGHT: Guide ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Guide -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💡 Hướng dẫn" FontSize="14" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,8"/>

                    <TextBlock Text="📥 NHẬN TÀI LIỆU:" FontSize="13" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#555" Margin="0,0,0,6"
                               Text="• GV phát bài → tự động nhận file&#10;• Tab &quot;Tài liệu nhận&quot; → Nhấn &quot;Mở&quot;&#10;• File lưu tại thư mục Tài liệu"/>

                    <TextBlock Text="📤 NỘP BÀI:" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#555" Margin="0,0,0,6"
                               Text="Cách 1: &quot;Nộp file&quot; → Chọn file bài làm&#10;Cách 2: &quot;Viết bài&quot; → Soạn trực tiếp&#10;Cách 3: Kéo thả file vào trang này"/>

                    <TextBlock Text="📝 SOẠN TRỰC TIẾP:" FontSize="13" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#555" Margin="0,0,0,6"
                               Text="• Tab &quot;Soạn bài&quot; → Viết nội dung&#10;• Đặt tên file → Nhấn &quot;Nộp bài viết&quot;&#10;• File .txt tự tạo và nộp cho GV"/>

                    <Border Background="#E8F5E9" CornerRadius="6" Padding="8" Margin="0,2,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#2E7D32"
                                   Text="✅ File nộp sẽ tự động gửi tới GV. Kiểm tra trạng thái ở tab &quot;Bài đã nộp&quot;. Nếu hiển thị &quot;Chưa gửi&quot;, hãy nhấn &quot;Đồng bộ ngoại tuyến&quot; khi có kết nối."/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Recent Activity -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📊 Hoạt động gần đây" FontSize="14" FontWeight="Bold"
                               Foreground="#212121" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="activityList"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Drop Overlay -->
        <Border x:Name="dropOverlay" Grid.ColumnSpan="2" Background="#601976D2" CornerRadius="12"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center"
                           FontFamily="Segoe UI Emoji"/>
                <TextBlock Text="Thả file để nộp bài" FontSize="18" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="File sẽ tự động nộp cho GV" FontSize="12"
                           Foreground="#BBDEFB" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>