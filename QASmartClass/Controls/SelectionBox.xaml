<UserControl x:Class="QASmartTouch.Controls.SelectionBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="300"
             Background="Transparent">
    
    <!-- Selection Box Container with Dashed Border -->
    <Grid x:Name="SelectionBorder"
          IsManipulationEnabled="True"
          ManipulationStarting="SelectionBorder_ManipulationStarting"
          ManipulationDelta="SelectionBorder_ManipulationDelta"
          ManipulationCompleted="SelectionBorder_ManipulationCompleted">
        
        <!-- Dashed Rectangle Border (QC_4.2_IFP86) -->
        <Rectangle Stroke="#FF00BFFF"
                   StrokeThickness="3"
                   StrokeDashArray="6 3"
                   RadiusX="2"
                   RadiusY="2"
                   Fill="Transparent"/>
        
        <!-- Smart Snap Guide Line (Visible when snapping to 0/90/180/270 degrees) -->
        <Line x:Name="SnapLine"
              X1="0" Y1="0" X2="0" Y2="0"
              Stroke="#2ECC71"
              StrokeThickness="2"
              StrokeDashArray="4 2"
              Visibility="Collapsed"
              IsHitTestVisible="False"/>

        <!-- Live Scaling Tooltip (% and px size) -->
        <Border x:Name="ScaleTooltip"
                Background="#D9000000"
                CornerRadius="6"
                Padding="8,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-36,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="txtScaleTooltip"
                       Text="100% (0 x 0 px)"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Live Rotation Angle Tooltip (Degree °) -->
        <Border x:Name="AngleTooltip"
                Background="#D9000000"
                CornerRadius="6"
                Padding="8,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-56,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="txtAngleTooltip"
                       Text="0°"
                       Foreground="#2ECC71"
                       FontSize="12"
                       FontWeight="Bold"/>
        </Border>
        
        <!-- 4 Corner Square Resize Handles (16x16 visual, DeepSkyBlue) -->
        <Rectangle x:Name="TopLeftHandle"
                   Width="16" Height="16"
                   Fill="#FF00BFFF"
                   Stroke="White"
                   StrokeThickness="2"
                   RadiusX="3" RadiusY="3"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="-8,-8,0,0"
                   Cursor="SizeNWSE"
                   MouseDown="ResizeHandle_MouseDown"
                   MouseMove="ResizeHandle_MouseMove"
                   MouseUp="ResizeHandle_MouseUp"
                   Tag="TopLeft"/>
            
        <Rectangle x:Name="TopRightHandle"
                   Width="16" Height="16"
                   Fill="#FF00BFFF"
                   Stroke="White"
                   StrokeThickness="2"
                   RadiusX="3" RadiusY="3"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,-8,-8,0"
                   Cursor="SizeNESW"
                   MouseDown="ResizeHandle_MouseDown"
                   MouseMove="ResizeHandle_MouseMove"
                   MouseUp="ResizeHandle_MouseUp"
                   Tag="TopRight"/>
            
        <Rectangle x:Name="BottomLeftHandle"
                   Width="16" Height="16"
                   Fill="#FF00BFFF"
                   Stroke="White"
                   StrokeThickness="2"
                   RadiusX="3" RadiusY="3"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="-8,0,0,-8"
                   Cursor="SizeNESW"
                   MouseDown="ResizeHandle_MouseDown"
                   MouseMove="ResizeHandle_MouseMove"
                   MouseUp="ResizeHandle_MouseUp"
                   Tag="BottomLeft"/>
            
        <Rectangle x:Name="BottomRightHandle"
                   Width="16" Height="16"
                   Fill="#FF00BFFF"
                   Stroke="White"
                   StrokeThickness="2"
                   RadiusX="3" RadiusY="3"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,-8,-8"
                   Cursor="SizeNWSE"
                   MouseDown="ResizeHandle_MouseDown"
                   MouseMove="ResizeHandle_MouseMove"
                   MouseUp="ResizeHandle_MouseUp"
                   Tag="BottomRight"/>
            
        <!-- Rotate Handle (Top Center) -->
        <Ellipse x:Name="RotateHandle"
                 Width="20" Height="20"
                 Fill="#FF00BFFF"
                 Stroke="White"
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,-34,0,0"
                 Cursor="Hand"
                 MouseDown="RotateHandle_MouseDown"
                 MouseMove="RotateHandle_MouseMove"
                 MouseUp="RotateHandle_MouseUp">
            <Ellipse.ToolTip>
                <ToolTip Content="Kéo để xoay"/>
            </Ellipse.ToolTip>
        </Ellipse>
            
        <!-- Connection Line from Rotate Handle -->
        <Line x:Name="RotateConnectionLine"
              X1="0" Y1="-34"
              X2="0" Y2="0"
              Stroke="#FF00BFFF"
              StrokeThickness="1.5"
              StrokeDashArray="3 2"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              IsHitTestVisible="False"/>
    </Grid>
</UserControl>
