<UserControl x:Class="QASmartTouch.Controls.ExitConfirmModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
            <Border x:Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding Path=(Tag), RelativeSource={RelativeSource TemplatedParent}, FallbackValue=18}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <!--
        QC_4.2 Hộp thoại Xác nhận Thoát Ứng dụng
        Theo thiết kế Stitch chuẩn (Project 15016715420923662033).
    -->
    <Grid Background="#59000000">
        <Border Width="460" MaxWidth="520"
                Background="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="2"
                CornerRadius="22"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical">
                <!-- Nội dung thông báo -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" Background="#FEE2E2" CornerRadius="16" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#DC2626" Data="M13,14H11V9H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Xác nhận thoát ứng dụng" FontSize="16" FontWeight="Bold" Foreground="#1E2533"/>
                        <TextBlock Text="Còn dữ liệu chưa lưu, bạn có muốn lưu bài giảng (.qasc) trước khi thoát về màn hình đăng nhập không?"
                                   FontSize="12" Foreground="#44464E" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Grid>

                <!-- 3 Nút hành động -->
                <Border BorderBrush="#E1E8ED" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Hủy (Ở lại) -->
                        <Button x:Name="btnCancel" Height="38" Padding="14,0" Margin="0,0,8,0"
                                Background="#FFFFFF" BorderBrush="#E1E8ED" BorderThickness="1"
                                Cursor="Hand" Focusable="False" Template="{StaticResource PillButtonTemplate}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#747D8C" Margin="0,0,5,0"/>
                                <TextBlock Text="Hủy (Ở lại)" FontSize="12" FontWeight="SemiBold" Foreground="#747D8C"/>
                            </StackPanel>
                        </Button>

                        <!-- Không (Thoát luôn) -->
                        <Button x:Name="btnExitWithoutSave" Height="38" Padding="14,0" Margin="0,0,8,0"
                                Background="#FFFFFF" BorderBrush="#FCA5A5" BorderThickness="1"
                                Cursor="Hand" Focusable="False" Template="{StaticResource PillButtonTemplate}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⇥" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,5,0"/>
                                <TextBlock Text="Không (Thoát luôn)" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Button>

                        <!-- Có (Lưu .qasc) -->
                        <Button x:Name="btnExitWithSave" Height="38" Padding="16,0"
                                Background="#2E86DE" BorderThickness="0"
                                Cursor="Hand" Focusable="False" Template="{StaticResource PillButtonTemplate}">
                            <Button.Effect>
                                <DropShadowEffect Color="#2E86DE" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Có (Lưu .qasc)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
