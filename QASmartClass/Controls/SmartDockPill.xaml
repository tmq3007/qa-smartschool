<UserControl x:Class="QASmartTouch.Controls.SmartDockPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             SnapsToDevicePixels="True">
    <!--
        QC_4.2 SMART TOUCH: Floating Bottom Center Dock Pill
        Thiết kế theo chuẩn Stitch mới nhất (Project 15016715420923662033).
        - Đặt chính giữa đáy màn hình (HorizontalAlignment="Center", VerticalAlignment="Bottom")
        - Bao gồm: [+ Chèn], Thước, Compa, Eke, Điều hướng trang/bảng ([<] Bảng X/Y [>] [+]),
          Chỉ số Zoom (100%), Hẹn giờ, Đèn soi, Màn che, DESKTOP, Thoát.
        - Khung xổ lên Chèn nội dung & học liệu (6 nhóm chuyên đề).
        - Menu mini Zoom & Cảm ứng chạm (Đa chạm vs Cử chỉ).
        - Giữ nguyên nhãn thương hiệu tiếng Anh: DESKTOP.
    -->
    <UserControl.Resources>
        <!-- Template chung: viền bo tròn, hỗ trợ chuột và chạm cảm ứng mượt mà -->
        <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
            <Border x:Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding Path=(Tag), RelativeSource={RelativeSource TemplatedParent}, FallbackValue=18}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="PillBtnBase" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{DynamicResource InterFont}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Thẻ bo góc bóng mờ kiểu kính (Glassmorphism) -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1E2A3A" Direction="270" ShadowDepth="4" BlurRadius="24" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Bottom">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 1. POPUP MINI ZOOM & CẢM ỨNG (Hiện khi chạm vào [100%])     -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="popoverZoomTouch"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1.5"
                    CornerRadius="18"
                    Padding="6,4"
                    Margin="0,0,0,8">
                <Border.Effect>
                    <DropShadowEffect Color="#1E2A3A" Direction="270" ShadowDepth="3" BlurRadius="16" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Thu nhỏ (−) -->
                    <Button x:Name="btnZoomOut" Style="{StaticResource PillBtnBase}" Tag="14"
                            Width="30" Height="30" ToolTip="Thu nhỏ (Ctrl -)">
                        <TextBlock Text="−" FontSize="18" FontWeight="Bold" Foreground="#44464E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Reset 100% -->
                    <Button x:Name="btnZoomReset" Style="{StaticResource PillBtnBase}" Tag="12"
                            Height="28" Padding="8,2" Margin="3,0" Background="#F1F2F6"
                            ToolTip="Đặt lại 100% (Ctrl 0)">
                        <TextBlock x:Name="txtMiniZoomReset" Text="100%" FontSize="11.5" FontWeight="Bold" Foreground="#2E86DE" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Phóng to (+) -->
                    <Button x:Name="btnZoomIn" Style="{StaticResource PillBtnBase}" Tag="14"
                            Width="30" Height="30" ToolTip="Phóng to (Ctrl +)">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#44464E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Vừa màn hình (Fit) -->
                    <Button x:Name="btnZoomFit" Style="{StaticResource PillBtnBase}" Tag="14"
                            Width="30" Height="30" Margin="2,0,0,0" ToolTip="Vừa khung hình">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#44464E" Data="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Phân cách dọc -->
                    <Border Width="1" Height="18" Background="#E1E8ED" Margin="6,0"/>

                    <!-- Chuyển chế độ cảm ứng: Đa chạm (Multi) vs Cử chỉ (Single + 2-finger pan) -->
                    <Button x:Name="btnTouchModeToggle" Style="{StaticResource PillBtnBase}" Tag="14"
                            Height="28" Padding="8,2" Background="#F1F2F6"
                            ToolTip="Chế độ cảm ứng: Nhấn để đổi Đa chạm ↔ Cử chỉ 2 ngón">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,4,0">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="iconTouchMode" Fill="#44464E"
                                          Data="M21,11A1,1 0 0,0 20,10A1,1 0 0,0 19,11V15.5L18.06,14.56C17.67,14.17 17.04,14.17 16.65,14.56L15.71,15.5L18.82,21.68C19.18,22.4 19.92,22.86 20.73,22.86H21.5A2.5,2.5 0 0,0 24,20.36V14A1,1 0 0,0 23,13A1,1 0 0,0 22,14V12A1,1 0 0,0 21,11M13,2A1,1 0 0,0 12,3V10.5L11.06,9.56C10.67,9.17 10.04,9.17 9.65,9.56L8.71,10.5L11.82,16.68C12.18,17.4 12.92,17.86 13.73,17.86H14.5A2.5,2.5 0 0,0 17,15.36V9A1,1 0 0,0 16,8A1,1 0 0,0 15,9V4A1,1 0 0,0 14,3A1,1 0 0,0 13,2M5,6A1,1 0 0,0 4,7V14.5L3.06,13.56C2.67,13.17 2.04,13.17 1.65,13.56L0.71,14.5L3.82,20.68C4.18,21.4 4.92,21.86 5.73,21.86H6.5A2.5,2.5 0 0,0 9,19.36V13A1,1 0 0,0 8,12A1,1 0 0,0 7,13V8A1,1 0 0,0 6,7A1,1 0 0,0 5,6Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="txtTouchMode" Text="Đa chạm" FontSize="11.5" FontWeight="SemiBold" Foreground="#44464E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 2. BẢNG XỔ LÊN: CHÈN NỘI DUNG & HỌC LIỆU (6 Nhóm chuyên đề) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="flyoutInsertContent"
                    Visibility="Collapsed"
                    Style="{StaticResource GlassCardStyle}"
                    Padding="14"
                    Margin="0,0,0,8"
                    MaxWidth="920"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical">
                    <!-- Tiêu đề & Nút đóng -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#4F46E5" Margin="0,0,8,0"/>
                            <TextBlock Text="CHÈN NỘI DUNG &amp; HỌC LIỆU" FontSize="12.5" FontWeight="Bold" Foreground="#1E2533"/>
                            <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="6 Nhóm chuyên đề" FontSize="10.5" FontWeight="Bold" Foreground="#4F46E5"/>
                            </Border>
                        </StackPanel>
                        <Button x:Name="btnCloseFlyout" Style="{StaticResource PillBtnBase}" Tag="12"
                                Width="26" Height="26" HorizontalAlignment="Right" ToolTip="Đóng">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#747D8C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Hàng Tab chuyên đề 1 -> 6 -->
                    <StackPanel x:Name="flyoutTabsHost" Orientation="Horizontal" Margin="0,0,0,8"/>

                    <!-- Hàng Công cụ tương ứng với Tab đang chọn -->
                    <Border Background="#FFFFFF" BorderBrush="#E1E8ED" BorderThickness="1" CornerRadius="16" Padding="8">
                        <WrapPanel x:Name="flyoutToolsHost" Orientation="Horizontal"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 3. THANH DOCK PILL CHÍNH (Horizontal Floating Capsule)      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCardStyle}"
                    Background="#FFFFFF"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1.5"
                    CornerRadius="26"
                    Padding="6,4"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#1E2A3A" Direction="270" ShadowDepth="4" BlurRadius="22" Opacity="0.18"/>
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Nút [+ Chèn] (Màu Indigo nổi bật) -->
                    <Button x:Name="btnInsertLauncher" Style="{StaticResource PillBtnBase}" Tag="20"
                            Height="40" Padding="14,0" Background="#4F46E5"
                            ToolTip="Chèn nội dung &amp; học liệu giảng dạy">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="17" Height="17" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#FFFFFF" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Chèn" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Phân cách dọc -->
                    <Border Width="1" Height="22" Background="#E1E8ED" Margin="6,0"/>

                    <!-- Cụm công cụ vẽ nhanh: Thước, Compa, Eke -->
                    <Button x:Name="btnToolRuler" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="10,0" ToolTip="Thước kẻ thẳng">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#2E86DE" Data="M2,7H22V17H2V7M4,9V12H5V9H7V11H8V9H10V12H11V9H13V11H14V9H16V12H17V9H19V11H20V9H20V15H4V9Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Thước" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnToolCompass" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="10,0" ToolTip="Compa vẽ hình tròn">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#2E86DE" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Compa" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnToolSetSquare" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="10,0" ToolTip="Eke tam giác vuông">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#2E86DE" Data="M2,2V22H22L2,2M5,7.8L16.2,19H5V7.8Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Eke" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Phân cách dọc -->
                    <Border Width="1" Height="22" Background="#E1E8ED" Margin="6,0"/>

                    <!-- Cụm Điều hướng Trang Bảng & Zoom (Trong khung nền nhẹ) -->
                    <Border Background="#F1F2F6" CornerRadius="20" Padding="4,2" Margin="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Bảng trước [<] -->
                            <Button x:Name="btnBoardPrev" Style="{StaticResource PillBtnBase}" Tag="14"
                                    Width="28" Height="28" ToolTip="Trang bảng trước">
                                <TextBlock Text="❮" FontSize="11" FontWeight="Bold" Foreground="#747D8C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Nhãn Bảng X/Y -->
                            <Button x:Name="btnBoardBadge" Style="{StaticResource PillBtnBase}" Tag="14"
                                    Height="28" Padding="10,0" Background="#2E86DE"
                                    ToolTip="Xem danh sách các trang bảng">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FFFFFF" Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="txtBoardIndicator" Text="Bảng 1/1" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Bảng sau [>] -->
                            <Button x:Name="btnBoardNext" Style="{StaticResource PillBtnBase}" Tag="14"
                                    Width="28" Height="28" ToolTip="Trang bảng tiếp theo">
                                <TextBlock Text="❯" FontSize="11" FontWeight="Bold" Foreground="#747D8C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Thêm bảng mới [+] -->
                            <Button x:Name="btnBoardAdd" Style="{StaticResource PillBtnBase}" Tag="14"
                                    Width="28" Height="28" Margin="2,0,0,0" Background="#FFFFFF"
                                    ToolTip="Thêm trang bảng mới">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#2E86DE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Phân cách dọc trong cụm -->
                            <Border Width="1" Height="16" Background="#DCDDE1" Margin="5,0"/>

                            <!-- Chỉ số Zoom [100%] (Chạm vào để bật Popup mini Zoom & Cảm ứng) -->
                            <Button x:Name="btnZoomLauncher" Style="{StaticResource PillBtnBase}" Tag="14"
                                    Height="28" Padding="8,0" Background="#FFFFFF"
                                    ToolTip="Tỷ lệ thu phóng bảng. Nhấp để chỉnh mức zoom &amp; đa chạm">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="13" Height="13" Margin="0,0,3,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#D97706" Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="txtZoomPercent" Text="100%" FontSize="11.5" FontWeight="Bold" Foreground="#2F3542" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Phân cách dọc -->
                    <Border Width="1" Height="22" Background="#E1E8ED" Margin="6,0"/>

                    <!-- Cụm Tiện ích: Hẹn giờ, Đèn soi, Màn che -->
                    <Button x:Name="btnUtilTimer" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="10,0" ToolTip="Đồng hồ đếm ngược hẹn giờ làm bài">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#D97706" Data="M12,20A7,7 0 0,1 5,13A7,7 0 0,1 12,6A7,7 0 0,1 19,13A7,7 0 0,1 12,20M19.03,7.39L20.45,5.97C20,5.46 19.55,5 19.04,4.56L17.62,6C16.07,4.74 14.12,4 12,4A9,9 0 0,0 3,13A9,9 0 0,0 12,22C17,22 21,17.97 21,13C21,10.88 20.26,8.93 19.03,7.39M11,14H13V8H11V14Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Hẹn giờ" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnUtilSpotlight" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="10,0" ToolTip="Đèn rọi tâm điểm (Spotlight)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#4F46E5" Data="M9,21C9,21.5 9.5,22 10,22H14C14.5,22 15,21.5 15,21V20H9V21M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Đèn soi" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnUtilCurtain" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="10,0" ToolTip="Màn che tập trung bài giảng">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#334155" Data="M4,4H20V6H4V4M4,7H11V19H4V7M13,7H20V19H13V7Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Màn che" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Phân cách dọc -->
                    <Border Width="1" Height="22" Background="#E1E8ED" Margin="6,0"/>

                    <!-- Chế độ DESKTOP (Ràng buộc giữ nguyên từ khóa tiếng Anh) -->
                    <Button x:Name="btnDesktopMode" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="12,0" ToolTip="Chế độ ghi chú trực tiếp trên Desktop Windows">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#2E86DE" Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="DESKTOP" FontSize="12" FontWeight="Bold" Foreground="#2F3542" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thoát (Đỏ mềm mại) -->
                    <Button x:Name="btnExit" Style="{StaticResource PillBtnBase}" Tag="18"
                            Height="38" Padding="12,0" Margin="3,0,0,0" Background="#FEE2E2"
                            ToolTip="Thoát phiên làm việc">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,4,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#DC2626" Data="M16.56,5.44L15.15,6.85C16.89,8.37 18,10.56 18,13A6,6 0 0,1 12,19A6,6 0 0,1 6,13C6,10.56 7.11,8.37 8.84,6.84L7.43,5.43C5.31,7.29 4,10 4,13A8,8 0 0,0 12,21A8,8 0 0,0 20,13C20,10 18.68,7.29 16.56,5.44M11,1V13H13V1H11Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Thoát" FontSize="12" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
