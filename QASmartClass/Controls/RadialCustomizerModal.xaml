<UserControl x:Class="QASmartTouch.Controls.RadialCustomizerModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             SnapsToDevicePixels="True">
    <!--
        QC_4.2 Hộp thoại Tùy biến Vòng tròn Radial - 6 Múi Tùy Chọn
        Theo thiết kế Stitch chuẩn (Project 15016715420923662033).
    -->
    <Grid Background="#59000000">
        <Border Width="640" MaxWidth="720"
                Background="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="2"
                CornerRadius="26"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="8" BlurRadius="36" Opacity="0.32"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical">
                <!-- Tiêu đề & Nút đóng -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" Background="#EEF2FF" CornerRadius="14" Margin="0,0,12,0">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#4F46E5" Data="M3,3H11V11H3V3M5,5V9H9V5H5M13,3H21V11H13V3M15,5V9H19V5H15M3,13H11V21H3V13M5,15V19H9V15H5M18,13V16H21V18H18V21H16V18H13V16H16V13H18Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tùy biến Vòng tròn Radial" FontSize="16" FontWeight="Bold" Foreground="#1E2533"/>
                            <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="6 Múi Tùy Chọn" FontSize="11" FontWeight="Bold" Foreground="#4F46E5"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Kéo hoặc chạm để gán công cụ yêu thích vào 6 múi tròn theo thói quen giảng dạy."
                                   FontSize="11.5" Foreground="#747D8C" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnClose" Grid.Column="2" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                            VerticalAlignment="Top" ToolTip="Đóng">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#747D8C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- 2 Cột: Cột trái (6 Múi) - Cột phải (Kho công cụ) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: 6 Múi tròn -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E1E8ED" BorderThickness="1" CornerRadius="18" Padding="14">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Vị trí 6 múi tròn" FontSize="12.5" FontWeight="Bold" Foreground="#1E2533"/>
                                <TextBlock x:Name="txtSlotHint" Text="Chọn múi để đổi" FontSize="10.5" Foreground="#747D8C" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel x:Name="slotsHost" Orientation="Vertical"/>
                        </StackPanel>
                    </Border>

                    <!-- Cột phải: Kho công cụ để thêm -->
                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E1E8ED" BorderThickness="1" CornerRadius="18" Padding="14">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Kho công cụ để thêm" FontSize="12.5" FontWeight="Bold" Foreground="#1E2533"/>
                                <TextBlock x:Name="txtCandidateHint" Text="Chạm để gán vào M2" FontSize="10.5" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Right"/>
                            </Grid>

                            <ScrollViewer MaxHeight="265" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="candidatesHost" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Chân trang: Khôi phục mặc định - Hủy - Lưu cấu hình -->
                <Grid>
                    <Button x:Name="btnResetDefault" Height="36" Padding="12,0" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↺" FontSize="14" FontWeight="Bold" Foreground="#747D8C" Margin="0,0,5,0"/>
                            <TextBlock Text="Khôi phục mặc định" FontSize="12" FontWeight="SemiBold" Foreground="#747D8C"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnCancel" Height="38" Padding="18,0" Margin="0,0,8,0"
                                Background="#F1F2F6" BorderThickness="0" Cursor="Hand" Focusable="False">
                            <TextBlock Text="Hủy" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3542"/>
                        </Button>

                        <Button x:Name="btnSave" Height="38" Padding="20,0"
                                Background="#2E86DE" BorderThickness="0" Cursor="Hand" Focusable="False">
                            <Button.Effect>
                                <DropShadowEffect Color="#2E86DE" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="Lưu cấu hình" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
