<UserControl x:Class="QASmartTouch.Controls.ContextToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="400">

    <UserControl.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
                         Color="Black" 
                         Opacity="0.3" 
                         BlurRadius="12" 
                         ShadowDepth="4"/>
    </UserControl.Resources>

    <!-- Context Toolbar Container -->
    <Border Background="#D9000000"
            CornerRadius="25"
            Padding="8,6"
            Effect="{StaticResource DropShadowEffect}">

        <Border.Resources>
            <!-- Button Style -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#55FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Resources>

        <!-- Toolbar Buttons (Tier 1 Micro Bar + Tier 2 Advanced Panel) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- 🎨 Color Picker with 5-Color Popover & Smart OCR Candidates Popover -->
            <Grid Margin="2,0">
                <Button x:Name="btnColor"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnColor_Click"
                        PreviewTouchDown="btnColor_PreviewTouchDown"
                        ToolTip="Đổi màu nét vẽ nhanh (1-Click)">
                    <Border Width="20" Height="20" 
                            CornerRadius="4"
                            BorderBrush="White"
                            BorderThickness="2">
                        <Border.Background>
                            <SolidColorBrush x:Name="ColorPreview" Color="Black"/>
                        </Border.Background>
                    </Border>
                </Button>

                <!-- 5-Color Quick Palette Popover -->
                <Popup x:Name="ColorPalettePopup" StaysOpen="False" Placement="Top" VerticalOffset="-8">
                    <Border Background="#F51E272E" CornerRadius="12" Padding="6,4" Effect="{StaticResource DropShadowEffect}">
                        <StackPanel Orientation="Horizontal">
                            <Button Width="26" Height="26" Margin="3" Background="#E74C3C" BorderThickness="0" Click="ColorOption_Click" Tag="#E74C3C" ToolTip="Màu Đỏ">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="13"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="26" Height="26" Margin="3" Background="#2ECC71" BorderThickness="0" Click="ColorOption_Click" Tag="#2ECC71" ToolTip="Màu Xanh lá">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="13"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="26" Height="26" Margin="3" Background="#3498DB" BorderThickness="0" Click="ColorOption_Click" Tag="#3498DB" ToolTip="Màu Xanh dương">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="13"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="26" Height="26" Margin="3" Background="#F1C40F" BorderThickness="0" Click="ColorOption_Click" Tag="#F1C40F" ToolTip="Màu Vàng">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="13"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="26" Height="26" Margin="3" Background="#2C3E50" BorderThickness="0" Click="ColorOption_Click" Tag="#2C3E50" ToolTip="Màu Đen">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="13"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Smart OCR Handwriting Candidates Popover -->
                <Popup x:Name="HandwritingCandidatesPopup" StaysOpen="False" Placement="Top" VerticalOffset="-12">
                    <Border Background="#F51E272E" CornerRadius="12" Padding="8,6" Effect="{StaticResource DropShadowEffect}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="💡 Chọn dạng hiển thị mong muốn:" Foreground="#BDC3C7" FontSize="11" Margin="2,0,2,4"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="CandidatesContainer" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- 📏 Stroke Thickness Button (Tier 1 Direct Access) -->
            <Button x:Name="btnThickness"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="btnThickness_Click"
                    PreviewTouchDown="btnThickness_PreviewTouchDown"
                    ToolTip="Độ dày nét">
                <TextBlock Text="📏" FontSize="16"/>
            </Button>

            <!-- 📋 Copy Button (Tier 1 Direct Access) -->
            <Button x:Name="btnCopy"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="btnCopy_Click"
                    PreviewTouchDown="btnCopy_PreviewTouchDown"
                    ToolTip="Sao chép (Ctrl+C)">
                <TextBlock Text="📋" FontSize="16"/>
            </Button>

            <!-- 🗑️ Delete Button -->
            <Button x:Name="btnDelete"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="btnDelete_Click"
                    PreviewTouchDown="btnDelete_PreviewTouchDown"
                    ToolTip="Xóa (Delete)">
                <TextBlock Text="🗑️" FontSize="16"/>
            </Button>

            <!-- ⋮ More Menu Button (Tier 2 Toggle) -->
            <!-- TẠM ẨN: Tính năng mở rộng (...) cho bản thử nghiệm nội bộ (bảo toàn code, không xóa) -->
            <Button x:Name="btnMore"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="btnMore_Click"
                    PreviewTouchDown="btnMore_PreviewTouchDown"
                    ToolTip="Tính năng mở rộng (...)"
                    Visibility="Collapsed">
                <TextBlock Text="⋮" FontSize="18" FontWeight="Bold"/>
            </Button>

            <!-- Tier 2 Advanced Tools Container (Collapsed by default for clean Tier 1 UI) -->
            <StackPanel x:Name="AdvancedToolsPanel" Orientation="Horizontal" Visibility="Collapsed">
                <Rectangle Width="1" Height="24" Fill="#33FFFFFF" Margin="4,0"/>

                <Button x:Name="btnRecognizeHandwriting"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnRecognizeHandwriting_Click"
                        ToolTip="Nhận dạng chữ viết">
                    <TextBlock Text="✍️" FontSize="16"/>
                </Button>

                <Button x:Name="btnLock"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnLock_Click"
                        ToolTip="Khóa/Mở khóa">
                    <TextBlock x:Name="txtLockIcon" Text="🔓" FontSize="16"/>
                </Button>

                <Button x:Name="btnBringToFront"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnBringToFront_Click"
                        ToolTip="Đưa lên trên">
                    <TextBlock Text="⬆️" FontSize="14"/>
                </Button>

                <Button x:Name="btnSendToBack"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnSendToBack_Click"
                        ToolTip="Đưa xuống dưới">
                    <TextBlock Text="⬇️" FontSize="14"/>
                </Button>

                <Button x:Name="btnRotate90"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnRotate90_Click"
                        ToolTip="Xoay 90°">
                    <TextBlock Text="🔄" FontSize="16"/>
                </Button>

                <Button x:Name="btnFlipHorizontal"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnFlipHorizontal_Click"
                        ToolTip="Lật ngang (Trái ⇄ Phải)">
                    <TextBlock Text="↔️" FontSize="16"/>
                </Button>

                <Button x:Name="btnFlipVertical"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnFlipVertical_Click"
                        ToolTip="Lật dọc (Trên ⇄ Dưới)">
                    <TextBlock Text="↕️" FontSize="16"/>
                </Button>

                <Button x:Name="btnSpotlight"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="btnSpotlight_Click"
                        ToolTip="Tiêu điểm (Spotlight)">
                    <TextBlock Text="🔦" FontSize="16"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
