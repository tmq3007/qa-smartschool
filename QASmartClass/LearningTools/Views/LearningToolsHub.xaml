<Page x:Class="QASmartClass.LearningTools.Views.LearningToolsHub"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Gray100}">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER (Gradient) ═══ -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                    <GradientStop Color="#1A237E" Offset="0"/>
                    <GradientStop Color="#283593" Offset="0.5"/>
                    <GradientStop Color="#3949AB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Search bar -->
                <Border DockPanel.Dock="Right" Background="#FFFFFF20" CornerRadius="10" Padding="12,8"
                        Width="280" BorderBrush="#FFFFFF30" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="13"
                                 VerticalAlignment="Center" Foreground="White" CaretBrush="White"
                                 TextChanged="Search_Changed"
                                 Tag="Tìm kiếm công cụ..." GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                    </DockPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📚 Bộ Công Cụ Học Tập" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="70+ công cụ tra cứu, luyện tập &amp; kiểm tra cho mọi môn học" FontSize="12" Foreground="#B3C4FF" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ CATEGORY CARDS ═══ -->
        <WrapPanel x:Name="categoryPanel" Grid.Row="1" Margin="0,0,0,16"/>

        <!-- ═══ TOOL LIST ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="toolListPanel"/>
        </ScrollViewer>

        <!-- ═══ TOOL DETAIL (overlay when a tool is opened) ═══ -->
        <Border x:Name="toolDetailPanel" Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource Gray100}" Visibility="Collapsed">
            <DockPanel>
                <!-- Top bar: Back + Teaching Actions -->
                <Border DockPanel.Dock="Top" Padding="0,0,0,8">
                    <DockPanel>
                        <!-- Back button (LEFT) -->
                        <Button x:Name="btnBack" Content="← Quay lại Bộ Công Cụ" 
                                FontSize="13" Background="Transparent" BorderThickness="0"
                                Foreground="#1976D2" Cursor="Hand" HorizontalAlignment="Left"
                                Padding="8,6" Click="BackToHub_Click"/>

                        <!-- Teaching Actions toolbar (RIGHT) -->
                        <StackPanel x:Name="teachingActionsPanel" DockPanel.Dock="Right"
                                    Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <!-- Main Area: Tool on left, Student Submissions on right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="colSubmission" Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl x:Name="toolHost" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                    <Border x:Name="bdSubmissionSidebar" Grid.Column="1" Width="260" Margin="10,0,0,0"
                            Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <Button Content="✕" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                        Foreground="#757575" Cursor="Hand" Click="HideSubmissions_Click"/>
                                <TextBlock Text="📥 BÀI NỘP CỦA HỌC SINH" FontSize="11" FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ListView x:Name="lvSubmissions" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="4,8" Width="220">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="👤" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                    <Button Content="✕" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" 
                                                            Foreground="#D32F2F" Cursor="Hand" Click="RejectSubmission_Click" 
                                                            ToolTip="Bác bỏ ý kiến này" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TimeString}" FontSize="10" Foreground="#9E9E9E" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding StudentName}" FontWeight="Bold" FontSize="12" Foreground="#333333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" Foreground="#555555" TextWrapping="Wrap" Margin="18,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Page>
