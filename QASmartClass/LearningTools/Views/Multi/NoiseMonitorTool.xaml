<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.NoiseMonitorTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="White">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E88E5" Offset="0"/>
                    <GradientStop Color="#1565C0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🚦" FontSize="32" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Radar Tiếng Ồn" FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="{DynamicResource OutfitFont}"/>
                    <TextBlock Text="Tự động đo mức độ ồn và nhắc nhở lớp học trật tự" FontSize="15" FontWeight="Medium" Foreground="#E3F2FD" FontFamily="{DynamicResource InterFont}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (Deep Navy/Blue themed) -->
            <Grid Grid.Column="0" Background="#0F1E36">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚦" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextRadar" Text="Đo tiếng ồn" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#1E88E5"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="0">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="16">
                    <StackPanel Background="Transparent">
<Border Background="#F4F6F8" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="📖 Hướng Dẫn Sử Dụng Radar Tiếng Ồn" FontSize="18" FontWeight="Bold" Foreground="#1565C0" FontFamily="{DynamicResource OutfitFont}" Margin="0,0,0,16"/>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1." FontSize="14" FontWeight="Bold" Foreground="#1E88E5"/>
                                    <TextBlock Grid.Column="1" Text="Kết nối Microphone: Cắm và kiểm tra kết nối thiết bị thu âm của máy tính trước khi khởi động radar." FontSize="14" Foreground="#37474F" TextWrapping="Wrap"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="2." FontSize="14" FontWeight="Bold" Foreground="#1E88E5"/>
                                    <TextBlock Grid.Column="1" Text="Định chuẩn phòng học: Yêu cầu cả lớp giữ im lặng trong 3 giây, nhấn nút 'Định Chuẩn Lại' để hệ thống đo đạc và lọc tiếng ồn nền (noise floor)." FontSize="14" Foreground="#37474F" TextWrapping="Wrap"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="3." FontSize="14" FontWeight="Bold" Foreground="#1E88E5"/>
                                    <TextBlock Grid.Column="1" Text="Thiết lập ngưỡng báo động: Kéo thanh trượt đặt Ngưỡng cao hơn tiếng ồn nền khoảng 15-20 dB. Nếu tiếng ồn thực tế vượt quá ngưỡng này, radar sẽ chuyển đỏ và phát cảnh báo." FontSize="14" Foreground="#37474F" TextWrapping="Wrap"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="4." FontSize="14" FontWeight="Bold" Foreground="#1E88E5"/>
                                    <TextBlock Grid.Column="1" Text="Cơ chế chuỗi phần thưởng: Nếu lớp học giữ trật tự liên tục dưới ngưỡng, chuỗi trật tự sẽ tăng lên và tự động mở khóa các Ngôi sao vàng ⭐ làm phần thưởng thi đua cho cả lớp." FontSize="14" Foreground="#37474F" TextWrapping="Wrap"/>
                                </Grid>

                                <Border Height="1" Background="#E0E0E0" Margin="0,4,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="Mẹo sư phạm: Giáo viên có thể trình chiếu bảng đo tiếng ồn lên màn hình lớn và tổ chức cuộc thi đua 'Lớp học trật tự nhận 5 sao' để khuyến khích tinh thần tự giác của học sinh." FontSize="13" FontStyle="Italic" Foreground="#2E7D32" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: ĐO TIẾNG ỒN CHÍNH -->
                <Grid x:Name="viewPractice" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MAIN CONTENT (Radar + Face) -->
                    <Viewbox Grid.Row="0" MaxWidth="600" MaxHeight="600" Margin="20">
                        <Grid Width="500" Height="500">
                            
                            <!-- Background Circle (The Radar Area) -->
                            <Ellipse x:Name="RadarBg" Width="420" Height="420" Fill="#F5F5F5" Stroke="#E0E0E0" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Gamification Panel -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0">
                                <Border CornerRadius="12" Padding="12,8" Background="#E0FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="txtStreak" Text="Chuỗi trật tự: 0 🔥" FontSize="14" FontWeight="Bold" Foreground="#E65100" FontFamily="{DynamicResource OutfitFont}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtStars" Text="" FontSize="18" Foreground="#FFD54F" FontFamily="{DynamicResource OutfitFont}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Dynamic Wave Rings (Centered 동심) -->
                            <Ellipse x:Name="Wave3" Width="400" Height="400" Stroke="#4CAF50" StrokeThickness="2" Opacity="0.1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="scaleWave3" ScaleX="1.0" ScaleY="1.0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Wave2" Width="300" Height="300" Stroke="#4CAF50" StrokeThickness="4" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="scaleWave2" ScaleX="1.0" ScaleY="1.0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Wave1" Width="200" Height="200" Stroke="#4CAF50" StrokeThickness="6" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="scaleWave1" ScaleX="1.0" ScaleY="1.0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Center Face (Changes based on noise) -->
                            <Grid Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Base face circle -->
                                <Ellipse x:Name="FaceBg" Fill="#4CAF50">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#4CAF50"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                
                                <!-- TextBlock with Emojis as it scales perfectly and requires no complex SVG paths -->
                                <TextBlock x:Name="txtFace" Text="😀" FontSize="140" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Noise Level Text -->
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,70">
                                <TextBlock x:Name="txtDecibel" Text="45 dB" FontSize="48" FontWeight="Bold" Foreground="#424242" HorizontalAlignment="Center" FontFamily="{DynamicResource OutfitFont}"/>
                                <TextBlock x:Name="txtStatus" Text="Lớp học đang rất trật tự" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" FontFamily="{DynamicResource OutfitFont}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Viewbox>

                    <!-- CONTROLS & SETTINGS -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="24,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Ngưỡng Báo Động:" FontSize="18" FontWeight="Bold" Foreground="#616161" FontFamily="{DynamicResource InterFont}"/>
                                        <TextBlock x:Name="txtThreshold" Text="75 dB" FontSize="18" FontWeight="Bold" Foreground="#E53935" FontFamily="{DynamicResource OutfitFont}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    
                                    <!-- Threshold Slider -->
                                    <Slider x:Name="sliderThreshold" Minimum="40" Maximum="100" Value="75" Margin="0,0,20,0" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderThreshold_ValueChanged"/>
                                </StackPanel>

                                <!-- Controls -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Toggle Auto Shush -->
                                    <ToggleButton x:Name="btnAutoShush" Content="🔊 Tự động Suỵt: BẬT" FontSize="16" FontWeight="SemiBold" FontFamily="{DynamicResource InterFont}" Cursor="Hand" Padding="15,10" Background="#E8F5E9" Foreground="#388E3C" BorderThickness="0" Margin="0,0,0,10" IsChecked="True" Checked="BtnAutoShush_Checked" Unchecked="BtnAutoShush_Unchecked">
                                        <ToggleButton.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </ToggleButton.Resources>
                                    </ToggleButton>

                                    <!-- Manual Recalibrate -->
                                    <Button x:Name="btnCalibrate" Content="🎯 Định Chuẩn Lại" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource InterFont}" Cursor="Hand" Padding="15,10" Background="#E3F2FD" Foreground="#1E88E5" BorderThickness="0" Margin="0,0,0,10" Click="BtnCalibrate_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Start/Stop Radar -->
                                    <Button x:Name="btnStartStop" Content="⏸ Tạm Dừng Radar" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource InterFont}" Cursor="Hand" Padding="15,10" Background="#FFEBEE" Foreground="#D32F2F" BorderThickness="0" Click="BtnStartStop_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- CELEBRATION OVERLAY -->
                    <Border x:Name="pnlCelebration" Grid.Row="0" Grid.RowSpan="2" Background="#E5E8F5E9" CornerRadius="16" BorderBrush="#81C784" BorderThickness="2" Panel.ZIndex="90" Visibility="Collapsed" Opacity="0" Margin="40" RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.3" Color="#4CAF50"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="scaleCelebration" ScaleX="0.8" ScaleY="0.8"/>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="🎉 LỚP HỌC XUẤT SẮC! 🎉" FontSize="32" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" FontFamily="{DynamicResource OutfitFont}"/>
                            <TextBlock Text="Đã duy trì chuỗi trật tự 25 🔥 và mở khóa trọn vẹn 5 ⭐" FontSize="18" FontWeight="Medium" Foreground="#37474F" HorizontalAlignment="Center" Margin="0,15,0,25" FontFamily="{DynamicResource InterFont}" TextWrapping="Wrap"/>
                            <TextBlock Text="⭐⭐⭐⭐⭐" FontSize="48" Foreground="#FFD54F" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Hãy tiếp tục giữ gìn không khí học tập này nhé!" FontSize="15" FontStyle="Italic" Foreground="#558B2F" HorizontalAlignment="Center" FontFamily="{DynamicResource InterFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- CALIBRATION OVERLAY -->
                    <Border x:Name="pnlCalibration" Grid.Row="0" Grid.RowSpan="2" Background="#F0FFFFFF" Panel.ZIndex="100" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎯 Định chuẩn phòng học" FontSize="32" FontWeight="Bold" Foreground="#1E88E5" HorizontalAlignment="Center" FontFamily="{DynamicResource OutfitFont}"/>
                            <TextBlock Text="Yêu cầu cả lớp giữ im lặng trong 3 giây để máy đo..." FontSize="20" Foreground="#616161" HorizontalAlignment="Center" Margin="0,15,0,25" FontFamily="{DynamicResource InterFont}"/>
                            <ProgressBar x:Name="progCalibration" Width="400" Height="25" Margin="0,0,0,20" Maximum="3" Value="0" Foreground="#4CAF50"/>
                            <TextBlock x:Name="txtCalibrationLevel" Text="Đang đo: -- dB" FontSize="28" FontWeight="SemiBold" Foreground="#424242" HorizontalAlignment="Center" FontFamily="{DynamicResource OutfitFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- NO MICROPHONE WARNING OVERLAY -->
                    <Border x:Name="pnlNoMicrophone" Grid.Row="0" Grid.RowSpan="2" Background="#F0FFFFFF" Panel.ZIndex="110" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="⚠️ Không tìm thấy Microphone" FontSize="30" FontWeight="Bold" Foreground="#E53935" HorizontalAlignment="Center" FontFamily="{DynamicResource OutfitFont}"/>
                            <TextBlock Text="Vui lòng kết nối thiết bị thu âm để sử dụng công cụ." FontSize="18" Foreground="#616161" HorizontalAlignment="Center" Margin="0,15,0,25" FontFamily="{DynamicResource InterFont}" TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button x:Name="btnRetryMic" Content="🔄 Thử lại (Quét mic)" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource InterFont}" Cursor="Hand" Padding="20,10" Background="#1E88E5" Foreground="White" BorderThickness="0" Click="BtnRetryMic_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>