<UserControl x:Class="QASmartClass.LearningTools.Views.Multi.FocusTimerTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="Transparent"
             x:Name="focusToolRoot">

    <UserControl.Resources>
        <!-- Preset Button Style -->
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                BorderBrush="#404040" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64B5F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ambient Sound Button Style -->
        <Style x:Key="AmbientBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="14" 
                                BorderBrush="#404040" BorderThickness="1.5">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B3A4B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4FC3F7"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#64B5F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Start/Pause/Reset) -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="30,14"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="16" Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Master-Detail Layout -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,15,0,8">
            <TextBlock Text="{DynamicResource FocusTimer_Title}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" 
                        HorizontalAlignment="Center" FontFamily="{StaticResource OutfitFont}"/>
            <TextBlock Text="{DynamicResource FocusTimer_Subtitle}" FontSize="14" 
                        Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="{StaticResource InterFont}"/>
        </StackPanel>

        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (Dark themed) -->
            <Grid Grid.Column="0" Background="#161622">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Ghi chú" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextFocus" Text="Tập trung" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#26263F"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & GHI CHÚ -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Background="Transparent" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#FFE0B2" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<Border Background="#1E1E26" CornerRadius="14" Padding="24,20" BorderBrush="#333344" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📖 HƯỚNG DẪN TỪNG BƯỚC DUY TRÌ TẬP TRUNG (POMODORO)" FontSize="15" FontWeight="Bold" Foreground="#64B5F6" Margin="0,0,0,16"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="#B0BEC5" LineHeight="22">
                                    • <Run FontWeight="Bold" Foreground="#64B5F6">Bước 1: Thiết lập thời gian:</Run> Rê chuột kéo cung tròn hoặc bấm các phím Preset bên phải để chọn thời lượng phiên (mặc định 25 phút).&#x0a;&#x0a;
                                    • <Run FontWeight="Bold" Foreground="#64B5F6">Bước 2: Bật âm thanh thư giãn:</Run> Bật nhạc sóng não, tiếng mưa rơi ở khay âm thanh để lọc tiếng ồn phòng học.&#x0a;&#x0a;
                                    • <Run FontWeight="Bold" Foreground="#64B5F6">Bước 3: Bắt đầu làm việc:</Run> Nhấp nút &quot;Bắt Đầu&quot; và cam kết tập trung 100% cho đến khi chuông reo nghỉ giải lao.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: KHU VỰC TẬP TRUNG CHÍNH -->
                <Grid x:Name="viewPractice" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/> <!-- Quote -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MaxWidth="860" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CENTER: Timer Ring -->
                            <Viewbox Grid.Row="0" MaxWidth="500" MaxHeight="500" Margin="40,10,10,10">
                                <Grid Width="400" Height="400">
                                    <!-- Background Ring (Track) -->
                                    <Ellipse Width="360" Height="360" StrokeThickness="12" 
                                             Stroke="#252530" Fill="Transparent" 
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Progress Ring (Arc) — drawn via code-behind -->
                                    <Canvas x:Name="RingCanvas" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Interactive Ring Overlay -->
                                    <Ellipse x:Name="RingInteractionOverlay" Width="400" Height="400" Fill="Transparent" Cursor="Hand" 
                                             MouseLeftButtonDown="Ring_MouseDown" MouseMove="Ring_MouseMove" 
                                             MouseLeftButtonUp="Ring_MouseUp" MouseLeave="Ring_MouseLeave"/>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- State Badge -->
                                        <Border x:Name="borderStateBadge" Background="#1E88E5" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <TextBlock x:Name="txtSessionLabel" Text="FOCUS" FontSize="12" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource OutfitFont}"/>
                                        </Border>
                                        
                                        <!-- Time Numbers -->
                                        <TextBlock x:Name="txtTime" Text="25:00" FontSize="62" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" FontFamily="{StaticResource OutfitFont}"/>
                                        
                                        <!-- Session Count Text -->
                                        <TextBlock x:Name="txtSessionCount" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,4" FontFamily="{StaticResource InterFont}"/>

                                        <!-- Circular Session Counters -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                            <Ellipse x:Name="dot1" Width="8" Height="8" Fill="#303040" Margin="3,0"/>
                                            <Ellipse x:Name="dot2" Width="8" Height="8" Fill="#303040" Margin="3,0"/>
                                            <Ellipse x:Name="dot3" Width="8" Height="8" Fill="#303040" Margin="3,0"/>
                                            <Ellipse x:Name="dot4" Width="8" Height="8" Fill="#303040" Margin="3,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <!-- BOTTOM: Interactive Goals List -->
                            <Grid Grid.Row="1" Margin="25,5,10,15" MinWidth="320" MaxWidth="500" HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource FocusTimer_SyncClass}" Background="Transparent" Foreground="#64B5F6" BorderThickness="0" Cursor="Hand" Click="BtnClassProgress_Click" FontSize="12" FontFamily="{StaticResource InterFont}"/>
                                    <TextBlock Text="{DynamicResource FocusTimer_MyGoals}" FontSize="15" Foreground="{DynamicResource TextSecondary}" FontFamily="{StaticResource OutfitFont}" FontWeight="SemiBold"/>
                                </DockPanel>
                                
                                <Border Grid.Row="1" CornerRadius="8" Background="#12121A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="120">
                                    <ListBox x:Name="lstGoals" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsCompleted}" Grid.Column="0" 
                                                          Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource InterFont}" FontSize="13"
                                                          Checked="GoalCheck_Changed" Unchecked="GoalCheck_Changed" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </CheckBox>
                                                <Button Grid.Column="1" Content="✕" Foreground="#E57373" Background="Transparent" 
                                                         BorderThickness="0" Cursor="Hand" Click="BtnDeleteGoal_Click" Margin="8,3,4,0"
                                                         VerticalAlignment="Top" FontWeight="Bold" FontSize="11" x:Name="btnDeleteGoal"
                                                         Visibility="{Binding ElementName=focusToolRoot, Path=DeleteGoalVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                                <Grid Grid.Row="2" x:Name="gridGoalInput" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="txtNewGoal" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrush}" 
                                                 Padding="8,5" FontFamily="{StaticResource InterFont}" FontSize="13"
                                                 KeyDown="TxtNewGoal_KeyDown" MaxLength="80"/>
                                        <TextBlock IsHitTestVisible="False" Text="{DynamicResource FocusTimer_GoalPlaceholder}" 
                                                   VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondary}" 
                                                   FontFamily="{StaticResource InterFont}" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtNewGoal}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" Content="Thêm" Background="#1E88E5" Foreground="White" 
                                            Padding="12,5" Margin="6,0,0,0" Click="BtnAddGoal_Click" FontFamily="{StaticResource InterFont}"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- RIGHT PANEL: Controls -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                                      VerticalAlignment="Center" Margin="10,5,25,5">
                            <StackPanel Width="280" VerticalAlignment="Top">
                                
                                <!-- Preset Time Selection -->
                                <TextBlock Text="{DynamicResource FocusTimer_PresetFocus}" FontSize="15" Foreground="{DynamicResource TextSecondary}" 
                                           FontFamily="{StaticResource OutfitFont}" FontWeight="SemiBold" Margin="5,0,0,6"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min5}" Tag="5" Click="PresetTime_Click"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min10}" Tag="10" Click="PresetTime_Click"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min15}" Tag="15" Click="PresetTime_Click"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min25}" Tag="25" Click="PresetTime_Click" x:Name="btnPreset25"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min45}" Tag="45" Click="PresetTime_Click"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min60}" Tag="60" Click="PresetTime_Click"/>
                                </WrapPanel>

                                <!-- Break Time -->
                                <TextBlock Text="{DynamicResource FocusTimer_PresetBreak}" FontSize="15" Foreground="{DynamicResource TextSecondary}" 
                                           FontFamily="{StaticResource OutfitFont}" FontWeight="SemiBold" Margin="5,15,0,6"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min3}" Tag="3" Click="PresetBreak_Click"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min5}" Tag="5" Click="PresetBreak_Click" x:Name="btnBreak5"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min10}" Tag="10" Click="PresetBreak_Click"/>
                                    <Button Style="{StaticResource PresetBtn}" Content="{DynamicResource FocusTimer_Min15}" Tag="15" Click="PresetBreak_Click"/>
                                </WrapPanel>

                                <!-- Ambient Sound -->
                                <TextBlock Text="{DynamicResource FocusTimer_AmbientSound}" FontSize="15" Foreground="{DynamicResource TextSecondary}" 
                                           FontFamily="{StaticResource OutfitFont}" FontWeight="SemiBold" Margin="5,15,0,6"/>
                                <WrapPanel>
                                    <ToggleButton x:Name="btnSoundRain" Style="{StaticResource AmbientBtn}" Content="🌧️" 
                                                  ToolTip="{DynamicResource FocusTimer_TooltipRain}" Click="AmbientSound_Click" Tag="rain"/>
                                    <ToggleButton x:Name="btnSoundFire" Style="{StaticResource AmbientBtn}" Content="🔥" 
                                                  ToolTip="{DynamicResource FocusTimer_TooltipFire}" Click="AmbientSound_Click" Tag="fire"/>
                                    <ToggleButton x:Name="btnSoundWave" Style="{StaticResource AmbientBtn}" Content="🌊" 
                                                  ToolTip="{DynamicResource FocusTimer_TooltipWave}" Click="AmbientSound_Click" Tag="wave"/>
                                    <ToggleButton x:Name="btnSoundBird" Style="{StaticResource AmbientBtn}" Content="🐦" 
                                                  ToolTip="{DynamicResource FocusTimer_TooltipBird}" Click="AmbientSound_Click" Tag="bird"/>
                                </WrapPanel>

                                <!-- Volume Slider -->
                                <DockPanel Margin="5,8,5,0">
                                    <TextBlock Text="🔊" FontSize="16" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="sliderVolume" Minimum="0" Maximum="100" Value="40" 
                                            VerticalAlignment="Center" ValueChanged="SliderVolume_ValueChanged"/>
                                </DockPanel>

                                <!-- Auto-Start Break -->
                                <CheckBox x:Name="chkAutoStartBreak" Content="Tự động chuyển sang nghỉ" 
                                          Foreground="{DynamicResource TextSecondary}" Margin="5,12,0,0" FontFamily="{StaticResource InterFont}"
                                          Checked="ChkAutoStartBreak_Changed" Unchecked="ChkAutoStartBreak_Changed"/>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <Button x:Name="btnStart" Style="{StaticResource ActionBtn}" 
                                            Content="{DynamicResource FocusTimer_BtnStart}" Background="#4CAF50" Foreground="White" Click="BtnStart_Click"/>
                                    <Button x:Name="btnReset" Style="{StaticResource ActionBtn}" 
                                            Content="{DynamicResource FocusTimer_BtnReset}" Background="#424242" Foreground="#BDBDBD" Click="BtnReset_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- FOOTER: Quote -->
                    <Border Grid.Row="1" Margin="40,10,40,10" Padding="15,8" Background="#15FFFFFF" CornerRadius="10">
                        <TextBlock x:Name="txtQuote" 
                                   Text="💡 &quot;Kỷ luật là cầu nối giữa mục tiêu và thành tựu.&quot; — Jim Rohn" 
                                   FontSize="14" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" 
                                   HorizontalAlignment="Center" FontFamily="{StaticResource InterFont}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>

        <!-- POPUP: Class Progress -->
        <Popup x:Name="popupProgress" Placement="Center" PlacementTarget="{Binding ElementName=focusToolRoot}" 
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Width="360" Height="400" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="{DynamicResource FocusTimer_ClassProgressTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    
                    <!-- Progress List -->
                    <ListBox Grid.Row="1" x:Name="lstClassProgress" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left: Student Name and Target -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding StudentName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding CurrentTask}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    
                                    <!-- Right: Progress Indicator -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding ProgressPercentText}" FontSize="13" FontWeight="Bold" Foreground="#64B5F6" Width="36" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Footer: Close Button -->
                    <Button Grid.Row="2" Content="{DynamicResource FocusTimer_BtnClose}" Background="#2A2A2A" Foreground="White" Width="100" Padding="8,6" Margin="0,10,0,0" Click="BtnCloseProgress_Click" HorizontalAlignment="Center" BorderBrush="#404040" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>