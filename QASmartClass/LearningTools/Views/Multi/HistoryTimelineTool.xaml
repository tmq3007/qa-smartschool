<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.HistoryTimelineTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{DynamicResource SurfaceBackground}"
             Foreground="{DynamicResource TextPrimary}">

    <controls:BaseToolControl.Resources>
        <Style x:Key="CatBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{DynamicResource InterFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{DynamicResource InterFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:BaseToolControl.Resources>

    <!-- ROOT: Sidebar + Content side by side -->
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/> <!-- Col 0: Sidebar -->
            <ColumnDefinition Width="2"/>   <!-- Col 1: Separator -->
            <ColumnDefinition Width="*"/>   <!-- Col 2: Main Area -->
            <!-- Detail Panel (slide in from right) -->
            <ColumnDefinition x:Name="DetailColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ COLUMN 0: SIDEBAR ═══ -->
        <Grid Grid.Column="0" Background="#E8EAF6">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
            <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                     SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Ghi chú" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock x:Name="menuTextTimeline" Text="Tiến trình lịch sử" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Grid>

        <!-- ═══ COLUMN 1: SEPARATOR ═══ -->
        <Border Grid.Column="1" Background="#C5CAE9"/>

        <!-- ═══ COLUMN 2: MAIN AREA ═══ -->
        <Grid Grid.Column="2" Margin="16">
            
            <!-- VIEW 0: HƯỚNG DẪN & GHI CHÚ -->
            <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Background="White" Margin="12">
                    <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Cột 1: Dành cho Giáo viên -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,16"/>
                                <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                            </StackPanel>
                            <!-- Đường chia giữa -->
                            <Border Grid.Column="1" Background="#FFE0B2" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                            <!-- Cột 2: Dành cho Học sinh -->
                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
<Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#C5CAE9" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⏳ Hướng Dẫn Sử Dụng Dải Thời Gian" FontSize="20" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,20"/>
                            
                            <TextBlock Text="Bước 1: Xem dòng thời gian" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,2"/>
                            <TextBlock Text="• Dùng chuột kéo ngang hoặc vuốt màn hình cảm ứng để di chuyển qua các mốc thời gian." FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Bước 2: Xem chi tiết sự kiện" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,2"/>
                            <TextBlock Text="• Nhấp chọn vào bất kỳ thẻ sự kiện nào trên dòng thời gian để hiển thị bảng thông tin chi tiết đầy đủ ở bên phải." FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Bước 3: Lọc sự kiện" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,2"/>
                            <TextBlock Text="• Click chọn các danh mục (Việt Nam, Thế giới, Khoa học, Văn hóa) ở thanh lọc phía trên để hiển thị các sự kiện mong muốn." FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Bước 4: Tìm kiếm nhanh" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,2"/>
                            <TextBlock Text="• Nhập từ khóa (tên sự kiện, nhân vật, năm) vào ô tìm kiếm ở góc phải để lọc nhanh các mốc lịch sử tương ứng." FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Bước 5: Tự soạn sự kiện cá nhân" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,2"/>
                            <TextBlock Text="• Nhấn nút '+ Thêm sự kiện', điền đầy đủ các thông tin (chọn kỷ nguyên Sau CN hoặc Trước CN tương ứng) và lưu lại. Sự kiện tự thiết kế sẽ được lưu vĩnh viễn vào cơ sở dữ liệu." FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Button Style="{StaticResource ActionBtn}" Content="Bắt đầu học ngay" Background="#1A237E" Foreground="White" HorizontalAlignment="Left" Click="BtnCloseHelp_Click"/>
                        </StackPanel>
                    </Border>
                
</StackPanel>
            </ScrollViewer>

            <!-- VIEW 1: TIẾN TRÌNH LỊCH SỬ -->
            <Grid x:Name="viewPractice" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Padding="20,16" CornerRadius="8,8,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1A237E" Offset="0"/>
                            <GradientStop Color="#283593" Offset="0.5"/>
                            <GradientStop Color="#3949AB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⏳ Dải Thời Gian Lịch Sử" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Nhấp vào sự kiện để xem chi tiết đầy đủ" FontSize="14" Foreground="#9FA8DA" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionBtn}" Content="❔ Hướng dẫn"
                                    Background="#2196F3" Foreground="White" Click="BtnShowHelp_Click"/>
                            <Button Style="{StaticResource ActionBtn}" Content="➕ Thêm sự kiện"
                                    Background="#FFC107" Foreground="#3E2723" Click="BtnAddEvent_Click"/>
                            <Button Style="{StaticResource ActionBtn}" Content="🗑️ Xóa hết"
                                    Background="#EF5350" Foreground="White" Click="BtnClearAll_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CATEGORY FILTER BAR -->
                <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <!-- Search Bar -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="🔍 Tìm kiếm:" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtSearch" Width="220" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     FontSize="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"
                                     TextChanged="TxtSearch_TextChanged"
                                     ToolTip="Nhập tên sự kiện, năm hoặc nhân vật để tìm kiếm..."/>
                        </StackPanel>

                        <!-- Category Filters -->
                        <StackPanel x:Name="filterButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="📂 Lọc:" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="btnAll" Style="{StaticResource CatBtn}" Content="Tất cả"
                                    Background="#1A237E" Foreground="White" BorderBrush="#1A237E" Tag="all" Click="FilterCategory_Click"/>
                            <Button Style="{StaticResource CatBtn}" Content="Việt Nam"
                                    Background="#FFF3E0" Foreground="#E65100" BorderBrush="#FFB74D" Tag="vietnam" Click="FilterCategory_Click"/>
                            <Button Style="{StaticResource CatBtn}" Content="🌍 Thế giới"
                                    Background="#E3F2FD" Foreground="#1565C0" BorderBrush="#90CAF9" Tag="world" Click="FilterCategory_Click"/>
                            <Button Style="{StaticResource CatBtn}" Content="🔬 Khoa học"
                                    Background="#E8F5E9" Foreground="#2E7D32" BorderBrush="#A5D6A7" Tag="science" Click="FilterCategory_Click"/>
                            <Button Style="{StaticResource CatBtn}" Content="🎨 Văn hóa"
                                    Background="#FCE4EC" Foreground="#C62828" BorderBrush="#EF9A9A" Tag="culture" Click="FilterCategory_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- TIMELINE SCROLLVIEW -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              x:Name="TimelineScroll" PanningMode="HorizontalOnly">
                    <Grid x:Name="TimelineContainer" MinHeight="400" Margin="40,20,40,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Central Axis -->
                        <Border Grid.Row="1" Height="6" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C5CAE9" Offset="0"/>
                                    <GradientStop Color="#7986CB" Offset="0.3"/>
                                    <GradientStop Color="#3F51B5" Offset="0.7"/>
                                    <GradientStop Color="#1A237E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel x:Name="TopEventsPanel" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                        <StackPanel x:Name="YearMarkersPanel" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <StackPanel x:Name="BottomEventsPanel" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
            <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
            </Border>
        </Grid>

        <!-- ═══ COLUMN 3: DETAIL PANEL (SLIDE IN FROM RIGHT) ═══ -->
        <Border Grid.Column="3" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                x:Name="DetailPanel" Width="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="-4" Opacity="0.15" Direction="180" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Panel Header -->
                <Border x:Name="DetailHeaderBand" Grid.Row="0" Padding="20,16">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="18"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                Cursor="Hand" VerticalAlignment="Top" Click="BtnCloseDetail_Click"/>
                        <StackPanel>
                            <TextBlock x:Name="txtDetailYear" Text="Năm" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                            <TextBlock x:Name="txtDetailTitle" Text="Tiêu đề" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Detail Content (Scrollable) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,10">
                    <StackPanel x:Name="DetailContentPanel" Margin="20,16,20,20">
                        <!-- Content built dynamically in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ADD EVENT DIALOG (Overlay stretching across columns) -->
        <Grid x:Name="DialogOverlay" Grid.ColumnSpan="4" Visibility="Collapsed">
            <Border Background="#80000000"/>
            <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="16" Padding="30" Width="460"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📝 Thêm Sự Kiện Mới" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandPrimary}" Margin="0,0,0,15"/>

                    <TextBlock Text="Năm (Sử dụng dấu trừ '-' hoặc ComboBox cho năm TCN):" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtYear" FontSize="16" Padding="10,8" Grid.Column="0" Margin="0,0,8,0"
                                 BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"/>
                        <ComboBox x:Name="cmbEra" FontSize="14" Padding="8,6" Width="140" Grid.Column="1" VerticalContentAlignment="Center"
                                  Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}">
                            <ComboBoxItem Content="Sau CN (AD)" Tag="ad" IsSelected="True"/>
                            <ComboBoxItem Content="Trước CN (TCN)" Tag="bce"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Tiêu đề sự kiện:" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTitle" FontSize="16" Padding="10,8"
                             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <TextBlock Text="Mô tả ngắn:" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescription" FontSize="14" Padding="10,8"
                             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" AcceptsReturn="True" Height="70" Margin="0,0,0,12"/>

                    <TextBlock Text="Nội dung chi tiết:" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDetail" FontSize="13" Padding="10,8"
                             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" AcceptsReturn="True" Height="90" Margin="0,0,0,12"/>

                    <TextBlock Text="Nhân vật chính:" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtFigures" FontSize="14" Padding="10,8"
                             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <TextBlock Text="Ý nghĩa lịch sử:" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtSignificance" FontSize="13" Padding="10,8"
                             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" AcceptsReturn="True" Height="70" Margin="0,0,0,12"/>

                    <TextBlock Text="Danh mục:" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbCategory" FontSize="14" Padding="8,6" Margin="0,0,0,20"
                              Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}">
                        <ComboBoxItem Content="Việt Nam" Tag="vietnam" IsSelected="True"/>
                        <ComboBoxItem Content="🌍 Thế giới" Tag="world"/>
                        <ComboBoxItem Content="🔬 Khoa học" Tag="science"/>
                        <ComboBoxItem Content="🎨 Văn hóa" Tag="culture"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionBtn}" Content="Hủy" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextSecondary}" Click="BtnCancelDialog_Click"/>
                        <Button Style="{StaticResource ActionBtn}" Content="✅ Lưu" Background="#4CAF50" Foreground="White" Click="BtnSaveEvent_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</controls:BaseToolControl>