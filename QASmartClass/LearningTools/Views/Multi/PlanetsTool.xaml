<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.PlanetsTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">
 
    <controls:BaseToolControl.Resources>
        <!-- Cosmos Custom Slider Style -->
        <Style x:Key="CosmosSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="Track" Height="6" CornerRadius="3" Background="#2E314E" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="#3F51B5" BorderThickness="0" Height="6"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Height="6"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#8C9EFF" Stroke="#3F51B5" StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:BaseToolControl.Resources>
 
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
 
        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (Cosmos themed) -->
            <Grid Grid.Column="0" Background="#0D0E1A">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪐" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextOrbit" Text="Hệ Mặt Trời" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#3F51B5"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="0">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="16">
                    <StackPanel Background="Transparent">
<Border Background="#0D0E1A" CornerRadius="16" Padding="28,24" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🪐 HƯỚNG DẪN KHÁM PHÁ HỆ MẶT TRỜI" FontSize="20" FontWeight="Bold" Foreground="#8C9EFF" Margin="0,0,0,16"/>
                                <TextBlock Text="Chào mừng bạn đến với mô hình Hệ Mặt Trời tương tác 3D trực quan! Công cụ này cho phép giáo viên và học sinh quan sát chuyển động tự quay và quay quanh quỹ đạo của các hành tinh trong Thái Dương Hệ theo tỉ lệ thời gian và quỹ đạo mô phỏng." TextWrapping="Wrap" FontSize="14" Foreground="#9FA8DA" Margin="0,0,0,15" LineHeight="20"/>

                                <!-- Dành cho Giáo viên -->
                                <Border BorderBrush="#3F51B5" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#1A1C33">
                                    <StackPanel>
                                        <TextBlock Text="👩‍🏫 DÀNH CHO GIÁO VIÊN (HỖ TRỢ GIẢNG DẠY)" FontSize="15" FontWeight="Bold" Foreground="#8C9EFF" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Giảng dạy định luật Kepler: Bật chế độ 'Quỹ đạo elip Kepler' để minh họa hình ảnh quỹ đạo elip thực tế của các hành tinh thay vì đường tròn hoàn hảo." TextWrapping="Wrap" FontSize="13" Foreground="#C5CAE9" Margin="0,0,0,6"/>
                                        <TextBlock Text="• So sánh các thông số vật lý: Nhấp chọn lần lượt các hành tinh đất đá (Thủy tinh, Kim tinh, Trái Đất, Hỏa tinh) và hành tinh khí khổng lồ (Mộc tinh, Thổ tinh) để học sinh so sánh đường kính, nhiệt độ trung bình và số lượng vệ tinh." TextWrapping="Wrap" FontSize="13" Foreground="#C5CAE9" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Minh họa tương quan kích thước: Nhấn mạnh rằng kích thước hành tinh và khoảng cách đã được hiệu chỉnh tối ưu hóa để có thể quan sát trực quan trên cùng màn hình." TextWrapping="Wrap" FontSize="13" Foreground="#C5CAE9"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dành cho Học sinh -->
                                <Border BorderBrush="#388E3C" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#070714">
                                    <StackPanel>
                                        <TextBlock Text="🎒 DÀNH CHO HỌC SINH (HỌC TẬP KHÁM PHÁ)" FontSize="15" FontWeight="Bold" Foreground="#81C784" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Điều chỉnh tốc độ quay: Sử dụng thanh trượt 'Tốc độ mô phỏng' để đẩy nhanh chu kỳ chuyển động, giúp quan sát rõ chu kỳ quay của các hành tinh ở xa như Hải Vương Tinh." TextWrapping="Wrap" FontSize="13" Foreground="#9FA8DA" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Xem bảng dữ liệu hành tinh: Khi nhấp vào một hành tinh đang quay, hệ thống sẽ tạm dừng và hiển thị chi tiết các thuộc tính vật lý của hành tinh đó ở góc phải màn hình." TextWrapping="Wrap" FontSize="13" Foreground="#9FA8DA" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Trực quan hóa vệ tinh: Quan sát các vệ tinh nhỏ (như Mặt Trăng của Trái Đất) quay quanh hành tinh mẹ tương ứng." TextWrapping="Wrap" FontSize="13" Foreground="#9FA8DA"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hướng dẫn kỹ thuật -->
                                <Border BorderBrush="#FBC02D" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#1D1D10">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ THÔNG TIN QUỸ ĐẠO KEPLER" FontSize="15" FontWeight="Bold" Foreground="#FFF59D" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Chế độ Kepler vẽ quỹ đạo elip chính xác dựa trên tâm sai (eccentricity) thực tế của mỗi hành tinh." FontSize="13" Foreground="#C5CAE9" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Nút 'Hiện tên hành tinh' bật/tắt nhãn văn bản hiển thị trực tiếp để dễ dàng nhận biết." FontSize="13" Foreground="#C5CAE9" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Có thể kéo thả chuột để dịch chuyển camera hoặc sử dụng con lăn chuột để zoom xa/gần toàn bộ hệ Mặt Trời." TextWrapping="Wrap" FontSize="13" Foreground="#C5CAE9"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: HỆ MẶT TRỜI CHÍNH -->
                <Grid x:Name="viewPractice" Visibility="Visible" Background="#070714">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER – Cosmos gradient -->
                    <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#1F2937">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0D0E1A" Offset="0"/>
                                <GradientStop Color="#1A1C33" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="🪐 Mô Phỏng Hệ Mặt Trời &amp; Các Hành Tinh" FontSize="18" FontWeight="Bold" Foreground="#8C9EFF"/>
                                <TextBlock Text="Mô phỏng chu kỳ quỹ đạo và thông số khoa học thời gian thực" FontSize="13" Foreground="#9FA8DA" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="🪐" FontSize="36" VerticalAlignment="Center" Opacity="0.2" Margin="12,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <!-- SIMULATION CANVAS AREA -->
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <!-- Tutorial Tooltip overlay -->
                        <Border x:Name="TutorialTooltip" Background="#FF6D00" CornerRadius="8" Padding="14,10" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="100" BorderThickness="1" BorderBrush="#FFAB40" IsHitTestVisible="False">
                            <TextBlock Text="💡 Chạm vào một hành tinh bất kỳ để khám phá chi tiết!" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </Border>
 
                        <!-- Zoom Container -->
                        <Grid x:Name="ZoomContainer" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
 
                            <Canvas x:Name="SolarSystemCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" Width="0" Height="0">
                                <!-- Sun -->
                                <Ellipse x:Name="SunNode" Width="76" Height="76" Canvas.Left="-38" Canvas.Top="-38" Stroke="#FFD54F" StrokeThickness="2">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#FFF59D" Offset="0.2"/>
                                            <GradientStop Color="#FBC02D" Offset="0.8"/>
                                            <GradientStop Color="#F57F17" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FFB300" BlurRadius="30" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <!-- Planets will be injected here via code-behind -->
                            </Canvas>
                        </Grid>
 
                        <!-- CONTROL PANEL -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20" Background="#F20D0E1A" CornerRadius="12" Padding="16,12" BorderThickness="1.5" BorderBrush="#3F51B5" Panel.ZIndex="150" Width="260">
                            <StackPanel>
                                <TextBlock Text="BẢNG ĐIỀU KHIỂN" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                
                                <!-- Play/Pause Button -->
                                <Button x:Name="BtnPlayPause" Content="Tạm Dừng" Click="BtnPlayPause_Click" Background="#3F51B5" Foreground="White" FontSize="13" FontWeight="Bold" Padding="8,6" Margin="0,0,0,10" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                
                                <!-- Speed Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="Tốc độ mô phỏng:" Foreground="#C5CAE9" FontSize="12"/>
                                        <TextBlock x:Name="TxtSpeedRatio" Text="1.0x" Foreground="#8C9EFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Grid.Row="1" x:Name="SliderSpeed" Style="{StaticResource CosmosSliderStyle}" Minimum="0.2" Maximum="5.0" Value="1.0" SmallChange="0.1" LargeChange="0.5" ValueChanged="SliderSpeed_ValueChanged"/>
                                </Grid>
                                
                                <!-- Checkbox Nhãn tên & Kepler -->
                                <CheckBox x:Name="ChkShowLabels" Content="Hiện tên hành tinh" Checked="ChkShowLabels_Checked" Unchecked="ChkShowLabels_Unchecked" Foreground="#C5CAE9" FontSize="12" Margin="0,5,0,5" Cursor="Hand"/>
                                <CheckBox x:Name="ChkKeplerMode" Content="Quỹ đạo elip Kepler" Checked="ChkKeplerMode_Checked" Unchecked="ChkKeplerMode_Unchecked" Foreground="#C5CAE9" FontSize="12" Margin="0,5,0,10" Cursor="Hand"/>
 
                                <Border BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <TextBlock Text="* Khoảng cách và kích cỡ đã được hiệu chỉnh để dễ quan sát trực quan" Foreground="#9FA8DA" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
 
                        <!-- POPUP: Planet Info -->
                        <Border x:Name="PlanetDetailPopup" Visibility="Collapsed" Background="#F2070714" CornerRadius="16" Padding="20" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Center" Width="320" Panel.ZIndex="200" BorderThickness="1.5" BorderBrush="#3F51B5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="550">
                                <StackPanel>
                                    <TextBlock x:Name="txtPopupIcon" Text="🌍" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtPopupNameVi" Text="Trái Đất" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtPopupNameEn" Text="Earth" FontSize="15" Foreground="#9FA8DA" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    
                                    <Border Background="#12FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderThickness="0.5" BorderBrush="#2A2F45">
                                        <TextBlock x:Name="txtPopupFacts" Text="Hành tinh duy nhất có sự sống." FontSize="14" Foreground="#E2E8F0" TextWrapping="Wrap" FontStyle="Italic"/>
                                    </Border>
 
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường kính:" Foreground="#9FA8DA" FontSize="14" FontWeight="SemiBold" Margin="0,5,12,5"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtPopupDiameter" Text="12,756 km" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Khối lượng:" Foreground="#9FA8DA" FontSize="14" FontWeight="SemiBold" Margin="0,5,12,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPopupMass" Text="1.0 x Trái Đất" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
 
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Nhiệt độ TB:" Foreground="#9FA8DA" FontSize="14" FontWeight="SemiBold" Margin="0,5,12,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtPopupTemp" Text="15°C" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
 
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Chu kỳ quay:" Foreground="#9FA8DA" FontSize="14" FontWeight="SemiBold" Margin="0,5,12,5"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtPopupOrbit" Text="365 ngày" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                                        
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Vệ tinh:" Foreground="#9FA8DA" FontSize="14" FontWeight="SemiBold" Margin="0,5,12,5"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtPopupMoons" Text="1" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
 
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Trọng lực:" Foreground="#9FA8DA" FontSize="14" FontWeight="SemiBold" Margin="0,5,12,5"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtPopupGravity" Text="1.0 g" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
 
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Loại hành tinh:" Foreground="#9FA8DA" FontSize="14" FontWeight="SemiBold" Margin="0,5,12,5"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtPopupType" Text="Đất đá" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                                    </Grid>
 
                                    <Button Content="Đóng bảng thông tin" Click="BtnClosePopup_Click" Background="#263238" Foreground="White" Padding="15,10" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
 
                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
        
        <!-- COMPATIBILITY HOOKS -->
        <TabControl x:Name="mainTabControl" Visibility="Collapsed"/>
    </Grid>
</controls:BaseToolControl>