<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.LiteratureTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">
    
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER (Gradient) ═══ -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FCE4EC" Offset="0"/>
                    <GradientStop Color="#F8BBD0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📖 Tác Phẩm Văn Học" FontSize="20" FontWeight="Bold" Foreground="#AD1457"/>
                    <TextBlock Text="Lớp 9-12 • Sơ đồ tư duy tác phẩm • Khám phá Văn học Việt Nam &amp; Thế giới" FontSize="14" Foreground="#EC407A" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="📖" FontSize="32" VerticalAlignment="Center" Opacity="0.3" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#FCE4EC">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Sơ đồ tác phẩm" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#F8BBD0"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#FFE0B2" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: SƠ ĐỒ TÁC PHẨM -->
                <Grid x:Name="viewPractice" Background="#F3E5F5" ClipToBounds="True" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOOLBOX -->
                    <Border Grid.Row="0" Background="White" Padding="12" Margin="12,12,12,8" CornerRadius="12" BorderBrush="#E1BEE7" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Bấm để thêm thẻ mới:" FontSize="15" FontWeight="SemiBold" Foreground="#8E24AA" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            
                            <Button x:Name="btnToolRoot" Background="#FCE4EC" BorderBrush="#F06292" BorderThickness="1" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" Click="BtnAddNode_Click" Tag="Root">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👑" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Nhân vật chính" FontSize="14" FontWeight="Bold" Foreground="#D81B60" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnToolEvent" Background="#E8EAF6" BorderBrush="#7986CB" BorderThickness="1" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" Click="BtnAddNode_Click" Tag="Event">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sự kiện" FontSize="14" FontWeight="Bold" Foreground="#3949AB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnToolClear" Background="#FFEBEE" BorderBrush="#D32F2F" BorderThickness="1" Padding="12,8" Margin="32,0,0,0" Cursor="Hand" Click="BtnClear_Click">
                                <TextBlock Text="🗑 Xóa Bản Đồ" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center"/>
                            </Button>

                            <Border Height="24" Width="1" Background="#D0D0D0" Margin="16,0"/>
                            <TextBlock Text="Biểu tượng:" FontSize="13" FontWeight="SemiBold" Foreground="#8E24AA" VerticalAlignment="Center" Margin="8,0,6,0"/>
                            <Button Content="📖" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                            <Button Content="🔬" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                            <Button Content="🧪" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                            <Button Content="🎨" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                            <Button Content="📝" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                            <Button Content="💡" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                            <Button Content="⭐" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                            <Button Content="🏆" Padding="6,4" Margin="0,0,2,0" FontSize="13" Cursor="Hand" Click="Emoji_Click" ToolTip="Nhấp chọn thẻ và bấm emoji này để chèn"/>
                        </StackPanel>
                    </Border>

                    <!-- CANVAS WORKSPACE -->
                    <Border Grid.Row="1" Background="White" Margin="12,0,12,12" CornerRadius="12" BorderBrush="#E1BEE7" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="literatureScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" IsManipulationEnabled="True" ManipulationStarting="ScrollViewer_ManipulationStarting" ManipulationDelta="ScrollViewer_ManipulationDelta">
                                <Canvas x:Name="MindmapCanvas" Background="Transparent"
                                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                        MouseMove="Canvas_MouseMove"
                                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                    <!-- Connector lines will be added here -->
                                    
                                    <!-- Ghost Preview -->
                                    <Border x:Name="GhostPreview" Width="140" Height="60" CornerRadius="8" BorderThickness="2" BorderBrush="#BA68C8" Background="#44E1BEE7" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="200">
                                        <TextBlock Text="Thả vào đây" FontSize="12" Foreground="#8E24AA" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                    </Border>
                                </Canvas>
                            </ScrollViewer>

                            <!-- Floating Zoom Panel -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Background="White" CornerRadius="18" Padding="6" BorderBrush="#E0E0E0" BorderThickness="1" Panel.ZIndex="500">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnZoomOut" Width="28" Height="28" Cursor="Hand" Click="BtnZoomOut_Click" ToolTip="Thu nhỏ sơ đồ">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#E0E0E0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="➖" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>

                                    <Button x:Name="btnZoomReset" Width="50" Height="28" Cursor="Hand" Click="BtnZoomReset_Click" ToolTip="Reset tỷ lệ về 100%">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#E0E0E0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock x:Name="txtZoomPercent" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="#1976D2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>

                                    <Button x:Name="btnZoomIn" Width="28" Height="28" Cursor="Hand" Click="BtnZoomIn_Click" ToolTip="Phóng to sơ đồ">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#E0E0E0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="➕" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tutorial Tooltip (Chuyển IsHitTestVisible thành True để click được nút đóng) -->
                            <Border x:Name="TutorialTooltip" Background="#8E24AA" CornerRadius="8" Padding="16,10" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="300" IsHitTestVisible="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="💡 Hướng dẫn Mindmap:" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="1. Thêm thẻ từ menu trên cùng.&#x0a;2. Rê chuột lên thẻ sẽ thấy nút [+] nhỏ, kéo từ đó sang thẻ khác để tạo liên kết.&#x0a;3. Kéo thả thẻ tự do để thiết kế sơ đồ." Foreground="#E1BEE7" FontSize="14"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="❌" Background="Transparent" Foreground="White" BorderThickness="0" Margin="12,0,0,0" VerticalAlignment="Top" Cursor="Hand" Click="BtnCloseTutorial_Click" ToolTip="Ẩn hướng dẫn"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>