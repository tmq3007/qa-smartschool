<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.TextbookTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="White">
 
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
 
        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (Light Library themed) -->
            <Grid Grid.Column="0" Background="#ECEFF1">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📚" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextBook" Text="Thư viện sách" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#3A7BD5"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="0">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="16">
                    <StackPanel Background="Transparent">
<Border Background="White" CornerRadius="16" Padding="28,24" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="❓ HƯỚNG DẪN SỬ DỤNG THƯ VIỆN SÁCH" FontSize="20" FontWeight="Bold" Foreground="#3A7BD5" Margin="0,0,0,16"/>
                                <TextBlock Text="Chào mừng bạn đến với Thư viện sách giáo khoa tương tác! Công cụ giúp học sinh dễ dàng tra cứu, đọc sách điện tử và ôn tập lý thuyết thông qua hệ thống bài học được thiết kế trực quan sinh động." TextWrapping="Wrap" FontSize="14" Foreground="#424242" Margin="0,0,0,15" LineHeight="20"/>

                                <!-- Dành cho Giáo viên -->
                                <Border BorderBrush="#3A7BD5" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#E3F2FD">
                                    <StackPanel>
                                        <TextBlock Text="👩‍🏫 DÀNH CHO GIÁO VIÊN (HỖ TRỢ HƯỚNG DẪN)" FontSize="15" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Phân loại bài giảng: Lọc sách theo Lớp (từ Lớp 1 đến Lớp 12) và bộ sách cụ thể (Cánh Diều, Kết Nối Tri Thức, Chân Trời Sáng Tạo) để giao bài học tương ứng cho học sinh." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Hỗ trợ đọc tương tác: Hướng dẫn học sinh sử dụng tính năng nhấp đúp hoặc bôi đen văn bản để ghi chú các định nghĩa, định lý quan trọng." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Trình chiếu lớp học: Sử dụng các phiên bản sách giáo khoa chuẩn trực tiếp trong tiết học thay thế cho sách giấy truyền thống." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dành cho Học sinh -->
                                <Border BorderBrush="#388E3C" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#E8F5E9">
                                    <StackPanel>
                                        <TextBlock Text="🎒 DÀNH CHO HỌC SINH (HỌC TẬP CHỦ ĐỘNG)" FontSize="15" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Bước 1: Chọn Lớp &amp; Lọc sách: Sử dụng thanh chọn lớp và bộ lọc môn học/bộ sách ở đầu trang để tìm nhanh tài liệu môn học của mình." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Bước 2: Tìm kiếm thông minh: Nhập tên sách hoặc từ khóa môn học vào ô tìm kiếm để lọc nhanh bìa sách trên kệ." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Bước 3: Đọc và ghi chú: Click vào bìa sách để bắt đầu đọc nội dung điện tử tương tác. Kết hợp làm các bài tập trắc nghiệm tự luyện kèm theo sách." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hướng dẫn kỹ thuật -->
                                <Border BorderBrush="#FBC02D" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#FFFDE7">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ PHÂN LOẠI KÝ HIỆU BỘ SÁCH &amp; LOẠI SÁCH" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,0,0,8"/>
                                        <TextBlock Text="• SGK: Sách Giáo Khoa (Màu xanh dương) - SBT: Sách Bài Tập (Màu xanh lá)" FontSize="13" Foreground="#333333" Margin="0,0,0,4"/>
                                        <TextBlock Text="• VBT: Vở Bài Tập (Màu cam) - SGV: Sách Giáo Viên (Màu tím)" FontSize="13" Foreground="#333333" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Phím tắt bàn phím ảo: Khi tìm kiếm trên màn hình cảm ứng, có thể click trực tiếp vào ô tìm kiếm để hiển thị khay gõ chữ TouchTextPad." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: THƯ VIỆN SÁCH -->
                <Grid x:Name="viewPractice" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="Auto"/>  <!-- Grade Tabs -->
                        <RowDefinition Height="Auto"/>  <!-- Filter Bar -->
                        <RowDefinition Height="Auto"/>  <!-- Stats Bar -->
                        <RowDefinition Height="*"/>     <!-- Book Grid -->
                    </Grid.RowDefinitions>

                    <!-- HEADER – Blue gradient -->
                    <Border Grid.Row="0" Padding="25,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3A7BD5" Offset="0"/>
                                <GradientStop Color="#4A90E2" Offset="0.5"/>
                                <GradientStop Color="#5BA3F5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Fill="White" 
                                      Data="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"
                                      Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="THƯ VIỆN SÁCH GIÁO KHOA TƯƠNG TÁC" 
                                               FontSize="22" FontWeight="ExtraBold" Foreground="White"/>
                                    <TextBlock x:Name="txtHeaderSub" 
                                               Text="Chọn sách để bắt đầu học tập" 
                                               FontSize="13" Foreground="#D0E8FF" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Total badge -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#FFFFFF30" CornerRadius="8" Padding="10,5">
                                <TextBlock x:Name="txtTotalBadge" Text="📚 0 sách" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- GRADE TABS -->
                    <Border Grid.Row="1" Background="#F5F7FA" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📘 Lớp:" FontSize="15" FontWeight="Bold"
                                      Foreground="#2F3542" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="gradeTabsPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- FILTER BAR -->
                    <Border Grid.Row="2" Background="White" Padding="16,10" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search box -->
                            <Border Grid.Column="0" Background="#F8F9FA" CornerRadius="8" Margin="0,0,12,0">
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Fill="#95A5A6" 
                                         Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                         Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSearch" Grid.Column="1"
                                            Background="Transparent" BorderThickness="0" FontSize="14.5" FontWeight="Medium"
                                            VerticalAlignment="Center" TextChanged="txtSearch_TextChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="Tìm kiếm sách..." Foreground="#95A5A6" FontSize="14.5" FontWeight="Medium"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <!-- Series filter tabs -->
                            <StackPanel x:Name="seriesTabsPanel" Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0"/>
                            <!-- Type filter tabs -->
                            <StackPanel x:Name="typeTabsPanel" Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0"/>
                            <!-- Subject dropdown -->
                            <ComboBox x:Name="cmbSubject" Grid.Column="3" Width="185" Height="38"
                                     FontSize="14.5" FontWeight="SemiBold" SelectionChanged="cmbSubject_SelectionChanged">
                                <ComboBoxItem Content="Tất cả môn học" IsSelected="True"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- STATS BAR -->
                    <Border Grid.Row="3" Background="#FAFBFC" Padding="16,6" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock x:Name="txtStats" FontSize="13.5" FontWeight="Medium" Foreground="#95A5A6" VerticalAlignment="Center"
                                      Text="📜 Đang tải..."/>
                            <!-- Sort options -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Sắp xếp:" FontSize="13.5" FontWeight="SemiBold" Foreground="#95A5A6" 
                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbSort" Width="160" Height="32" FontSize="13.5" FontWeight="SemiBold"
                                         SelectionChanged="cmbSort_SelectionChanged">
                                    <ComboBoxItem Content="Theo tên A-Z" IsSelected="True" Tag="name_asc"/>
                                    <ComboBoxItem Content="Theo tên Z-A" Tag="name_desc"/>
                                    <ComboBoxItem Content="Theo môn học" Tag="subject"/>
                                    <ComboBoxItem Content="Theo bộ sách" Tag="series"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- BOOK GRID -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="bookCardsPanel" Margin="16,12" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
        
        <!-- COMPATIBILITY HOOKS -->
        <TabControl x:Name="mainTabControl" Visibility="Collapsed"/>
    </Grid>
</controls:BaseToolControl>