<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.PeriodicTableTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="White">
 
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
 
        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#ECEFF1">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTable" Text="Bảng tuần hoàn" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#1E88E5"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="0">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="16">
                    <StackPanel Background="Transparent">
<Border Background="White" CornerRadius="16" Padding="28,24" BorderBrush="#E0E0E0" BorderThickness="1" MaxWidth="1200" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="❓ HƯỚNG DẪN SỬ DỤNG BẢNG TUẦN HOÀN" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                <TextBlock Text="Chào mừng bạn đến với Bảng tuần hoàn các nguyên tố hóa học tương tác! Công cụ trực quan giúp học sinh ghi nhớ cấu trúc nguyên tử, số hiệu nguyên tử, chu kỳ, nhóm và các thuộc tính hóa lý của 118 nguyên tố." TextWrapping="Wrap" FontSize="14" Foreground="#424242" Margin="0,0,0,15" LineHeight="20"/>

                                <!-- Dành cho Giáo viên -->
                                <Border BorderBrush="#1565C0" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#E3F2FD">
                                    <StackPanel>
                                        <TextBlock Text="👩‍🏫 DÀNH CHO GIÁO VIÊN (HỖ TRỢ GIẢNG DẠY)" FontSize="15" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Trực quan hóa cấu trúc bảng tuần hoàn: Sử dụng các mã màu phân loại nhóm nguyên tố (Kim loại kiềm, Halogen, Khí hiếm...) để học sinh dễ nhận biết tính chất tương đồng." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Giảng dạy chuyên sâu: Nhấp nút '🔎 Mở rộng toàn màn hình' để hiển thị giao diện bảng tuần hoàn tương tác hoàn chỉnh. Bạn có thể chọn từng nguyên tố để hiển thị hình vẽ cấu hình electron lớp ngoài cùng và độ âm điện tương ứng." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Thiết kế bài tập: Gợi ý học sinh phân tích xu hướng biến thiên tính kim loại - phi kim dọc theo chu kỳ và nhóm." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dành cho Học sinh -->
                                <Border BorderBrush="#388E3C" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#E8F5E9">
                                    <StackPanel>
                                        <TextBlock Text="🎒 DÀNH CHO HỌC SINH (HỌC TẬP TỰ TRA CỨU)" FontSize="15" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Bước 1: Xem nhanh sơ đồ: Quan sát bảng tóm tắt nhanh ở Tab 'Bảng tuần hoàn' để nắm được vị trí của các họ Lantanit, Actinit và các cột nhóm nguyên tố." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Bước 2: Học cấu hình chi tiết: Nhấn nút mở rộng toàn màn hình, chọn các nguyên tố quen thuộc (như H, C, O, Fe) để xem khối lượng nguyên tử và cấu hình electron chi tiết của chúng." TextWrapping="Wrap" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Bước 3: Liên hệ thực tế: Sang Tab 'Ứng dụng thực tế' để tìm hiểu vai trò của các nhóm nguyên tố trong đời sống như chế tạo pin Lithium, vỏ tàu vũ trụ Titanium hoặc các khí trơ chiếu sáng." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hướng dẫn kỹ thuật -->
                                <Border BorderBrush="#FBC02D" BorderThickness="4,0,0,0" Padding="12,5" Margin="0,0,0,15" Background="#FFFDE7">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ THÔNG SỐ VÀ PHÂN LOẠI MÀU SẮC" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Kim loại kiềm (Cam), Kim loại kiềm thổ (Vàng cát), Phi kim (Xanh da trời), Halogen (Vàng chanh), Khí hiếm (Xanh lá nhạt)." FontSize="13" Foreground="#333333" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Lantanit (Vàng nhạt), Actinit (Nâu đất), Kim loại chuyển tiếp (Xanh xám), Kim loại khác (Bạc)." FontSize="13" Foreground="#333333" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Z đại diện cho số hiệu nguyên tử (Atomic Number), tương đương với số proton trong hạt nhân." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: BẢNG TUẦN HOÀN CHÍNH -->
                <Grid x:Name="viewPractice" Visibility="Visible" MaxWidth="1200" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER – Blue gradient -->
                    <Border Grid.Row="0" Padding="20,14" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1565C0" Offset="0"/>
                                <GradientStop Color="#1E88E5" Offset="0.5"/>
                                <GradientStop Color="#42A5F5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🧪 Bảng Tuần Hoàn Các Nguyên Tố Hóa Học" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Bảng Tuần Hoàn Tương Tác — Bảng tra cứu nguyên tố thu gọn" FontSize="13" Foreground="#BBDEFB" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="btnOpenFull" Content="🔎 Mở rộng toàn màn hình" FontSize="14" 
                                        FontWeight="SemiBold" Padding="16,10" Cursor="Hand" 
                                        Foreground="White" Background="#1565C0" BorderThickness="0" Click="BtnOpenFull_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- TABLE CONTENT -->
                    <Border Grid.Row="1" x:Name="ContentHost" ClipToBounds="True" Margin="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TablePanel" Margin="0"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Center" Margin="20" Visibility="Collapsed" MaxWidth="1600">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>