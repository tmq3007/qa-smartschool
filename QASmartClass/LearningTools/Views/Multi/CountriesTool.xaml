<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.CountriesTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <controls:BaseToolControl.Resources>
        <!-- Style for ToggleButton -->
        <Style x:Key="ModernToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                    <Setter Property="BorderBrush" Value="#A5D6A7"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#81C784"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for RadioButton -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ContinentGroup"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F8E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:BaseToolControl.Resources>

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER (Gradient + Search) ═══ -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E8F5E9" Offset="0"/>
                    <GradientStop Color="#C8E6C9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="White" CornerRadius="8" Padding="10,6,10,6" Width="220" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtCountrySearch" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="14"
                                 VerticalAlignment="Center" TextChanged="CountrySearch_Changed"/>
                        <Button x:Name="btnClearSearch" Grid.Column="2" Content="❌" FontSize="10" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" VerticalAlignment="Center" Click="ClearSearch_Click" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🌍 Nước &amp; Thủ Đô" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock Text="Lớp 6-9 • 200+ quốc gia &amp; vùng lãnh thổ • Số liệu diện tích cập nhật • Đố Vui Tương Tác" FontSize="14" Foreground="#2E7D32" Margin="0,3,0,0" Opacity="0.8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E8F5E9">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTable" Text="Danh sách quốc gia" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#C8E6C9"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#FFE0B2" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: DANH SÁCH QUỐC GIA (TRA CỨU) -->
                <Grid x:Name="grdNormalMode" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Continent filter + teaching helpers -->
                        <RowDefinition Height="Auto"/> <!-- Table Header -->
                        <RowDefinition Height="*"/>    <!-- List of countries -->
                    </Grid.RowDefinitions>
                    
                    <!-- Filters & Helpers -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#E0E0E0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Châu lục: " FontSize="14" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <WrapPanel x:Name="pnlContinentFilters" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="tabAll" Content="Tất cả" Style="{StaticResource TabButtonStyle}" IsChecked="True" Checked="ContinentFilter_Changed" Tag="All"/>
                                        <RadioButton Content="Châu Á" Style="{StaticResource TabButtonStyle}" Checked="ContinentFilter_Changed" Tag="Châu Á"/>
                                        <RadioButton Content="Châu Âu" Style="{StaticResource TabButtonStyle}" Checked="ContinentFilter_Changed" Tag="Châu Âu"/>
                                        <RadioButton Content="Châu Mỹ" Style="{StaticResource TabButtonStyle}" Checked="ContinentFilter_Changed" Tag="Châu Mỹ"/>
                                        <RadioButton Content="Châu Phi" Style="{StaticResource TabButtonStyle}" Checked="ContinentFilter_Changed" Tag="Châu Phi"/>
                                        <RadioButton Content="Châu Đại Dương" Style="{StaticResource TabButtonStyle}" Checked="ContinentFilter_Changed" Tag="Châu Đại Dương"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="💡 Dạy học: " FontSize="14" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ToggleButton x:Name="btnHideCapitals" Content="🙈 Ẩn Thủ Đô" Style="{StaticResource ModernToggleStyle}" Margin="0,0,8,0" Checked="FlashcardOption_Changed" Unchecked="FlashcardOption_Changed"/>
                                    <ToggleButton x:Name="btnHideAreas" Content="🙈 Ẩn Diện Tích" Style="{StaticResource ModernToggleStyle}" Margin="0,0,8,0" Checked="FlashcardOption_Changed" Unchecked="FlashcardOption_Changed"/>
                                    <ToggleButton x:Name="btnGameMode" Content="🎮 Chơi Game" Style="{StaticResource ModernToggleStyle}" Checked="GameMode_Checked" Unchecked="GameMode_Unchecked"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Table Header -->
                    <Border Grid.Row="1" x:Name="bdrTableHeader" Background="#E8F5E9" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/> 
                                <ColumnDefinition Width="2*"/> 
                                <ColumnDefinition Width="2*"/> 
                                <ColumnDefinition Width="1.5*"/> 
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cờ/Mã" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Quốc Gia" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Thủ Đô" FontWeight="Bold" FontSize="14" Foreground="#2E7D32"/>
                            <TextBlock Grid.Column="3" Text="Diện Tích" FontWeight="Bold" FontSize="14" Foreground="#2E7D32"/>
                        </Grid>
                    </Border>
                    
                    <!-- List of countries -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="lstCountries" Background="Transparent" BorderThickness="0" Margin="0,0,0,12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/> 
                                            <ColumnDefinition Width="2*"/> 
                                            <ColumnDefinition Width="2*"/> 
                                            <ColumnDefinition Width="1.5*"/> 
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="24" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FlagEmoji}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#333333" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        
                                        <!-- Capital (Grid with Mask and Text) -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Capital}" FontSize="14" Foreground="#555555" Visibility="{Binding ShowCapitalText}"/>
                                            <Border Background="#FFE082" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Visibility="{Binding ShowCapitalMask}" Cursor="Hand" MouseLeftButtonDown="RevealCapital_Click">
                                                <TextBlock Text="👁️ Hiện" FontSize="11" FontWeight="Bold" Foreground="#E65100"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Area (Grid with Mask and Text) -->
                                        <Grid Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Area}" FontSize="14" Foreground="#555555" Visibility="{Binding ShowAreaText}"/>
                                            <Border Background="#FFE082" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Visibility="{Binding ShowAreaMask}" Cursor="Hand" MouseLeftButtonDown="RevealArea_Click">
                                                <TextBlock Text="👁️ Hiện" FontSize="11" FontWeight="Bold" Foreground="#E65100"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- bdrNoResults: No search results UI -->
                        <Border x:Name="bdrNoResults" Background="White" CornerRadius="8" Padding="20" Margin="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="😕" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="Không tìm thấy quốc gia phù hợp!" FontSize="16" FontWeight="SemiBold" Foreground="#757575" Margin="0,8,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Vui lòng thử từ khóa khác hoặc thay đổi bộ lọc châu lục." FontSize="13" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>

                <!-- GAME MODE (Lồng đè trong content area) -->
                <Grid x:Name="grdGameMode" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="10" Padding="24" BorderThickness="1" BorderBrush="#E0E0E0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="*"/>    
                                <RowDefinition Height="Auto"/> 
                            </Grid.RowDefinitions>
                            
                            <!-- Stat header -->
                            <Border Grid.Row="0" Margin="0,0,0,16" Background="#FAFAFA" Padding="16,10" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                        <TextBlock Text="⏱️ THỜI GIAN" FontSize="12" Foreground="Gray" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtGameTimer" Text="60s" FontSize="28" FontWeight="Bold" Foreground="#D32F2F"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="🏆 ĐIỂM SỐ" FontSize="12" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtGameScore" Text="0 XP" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="🔥 COMBO STREAK" FontSize="12" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="txtGameStreak" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Question area: pnlGamePlay -->
                            <StackPanel x:Name="pnlGamePlay" Grid.Row="1" VerticalAlignment="Center">
                                <Border Background="#E8F5E9" CornerRadius="100" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,16" BorderBrush="#A5D6A7" BorderThickness="2">
                                    <TextBlock x:Name="txtGameQuestionFlag" Text="🇻🇳" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="txtGameQuestionText" Text="Thủ đô của Việt Nam là gì?" FontSize="22" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center"/>
                                
                                <!-- 4 options: gridGameAnswers -->
                                <UniformGrid x:Name="gridGameAnswers" Columns="2" Rows="2" Width="600" Height="140" HorizontalAlignment="Center">
                                    <Button x:Name="btnAnswerA" Content="Option A" Margin="8" Padding="12" FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="AnswerButton_Click"/>
                                    <Button x:Name="btnAnswerB" Content="Option B" Margin="8" Padding="12" FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="AnswerButton_Click"/>
                                    <Button x:Name="btnAnswerC" Content="Option C" Margin="8" Padding="12" FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="AnswerButton_Click"/>
                                    <Button x:Name="btnAnswerD" Content="Option D" Margin="8" Padding="12" FontSize="16" FontWeight="SemiBold" Cursor="Hand" Click="AnswerButton_Click"/>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Game Over area: pnlGameEnd -->
                            <StackPanel x:Name="pnlGameEnd" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="txtGameEndMedal" Text="🥇" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtGameEndMedalName" Text="Huy chương Vàng" FontSize="18" FontWeight="Bold" Foreground="#FFB300" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock x:Name="txtGameEndResult" Text="Bạn đạt 100 XP!" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                <Button Content="🔄 Chơi Lại" Width="160" Padding="14,10" Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Click="RestartGame_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Quit button -->
                            <Button Grid.Row="2" Content="🚪 Thoát Trò Chơi" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="20,10" Background="#F44336" Foreground="White" BorderThickness="0" Cursor="Hand" Click="QuitGame_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>