<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.DynasTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">
             
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER (Gradient) ═══ -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" Margin="0,0,0,16" BorderBrush="#D7CCC8" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EFEBE9" Offset="0"/>
                    <GradientStop Color="#D7CCC8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="txtTitle" Text="🏛️ Triều Đại Lịch Sử" FontSize="22" FontWeight="Bold" Foreground="#4E342E"/>
                    <TextBlock x:Name="txtSubtitle" Text="Lớp 9-12 • Timeline Việt Nam &amp; Thế giới" FontSize="14" Foreground="#8D6E63" Margin="0,4,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="btnHelp" Content="❓ Hướng dẫn" Padding="12,6" Margin="12,0" 
                            Background="#8D6E63" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand" Click="BtnShowHelp_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock Text="🏛️" FontSize="36" VerticalAlignment="Center" Opacity="0.3" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#EFEBE9">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Ghi chú" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTimeline" Text="Tiến trình lịch sử" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#D7CCC8"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & GHI CHÚ -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#FFE0B2" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#D7CCC8" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock x:Name="txtHelpTitle" Text="🏛️ HƯỚNG DẪN SỬ DỤNG TIỆN ÍCH" FontSize="18" FontWeight="Bold" Foreground="#4E342E" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                                
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock x:Name="txtHelpStep1" Text="1️⃣ Chọn Tab 'Tiến trình lịch sử' để xem dòng chảy thời gian của Việt Nam và Thế giới." FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#3F2A25"/>
                                    <TextBlock x:Name="txtHelpStep2" Text="2️⃣ Cuộn chuột để xem các triều đại được liệt kê theo thứ tự lịch sử." FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#3F2A25"/>
                                    <TextBlock x:Name="txtHelpStep3" Text="3️⃣ Rê chuột qua các thẻ triều đại để hiển thị các công cụ hỗ trợ của Giáo viên." FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#3F2A25"/>
                                    <TextBlock x:Name="txtHelpStep4" Text="4️⃣ Chuyển sang Tab 'Ứng dụng thực tế' để xem các đề mục khảo cổ, gia phả và điện ảnh." FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#3F2A25"/>
                                    <TextBlock x:Name="txtHelpStep5" Text="5️⃣ Nhấp chọn từng đề mục ở cột trái để xem mô tả chi tiết và hình ảnh minh họa cỡ lớn." FontSize="14" TextWrapping="Wrap" Foreground="#3F2A25"/>
                                </StackPanel>

                                <Button x:Name="btnHelpClose" Content="Bắt đầu học ngay" Padding="20,8" Background="#4E342E" Foreground="White" 
                                        FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand" Click="BtnCloseHelp_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: TIẾN TRÌNH LỊCH SỬ -->
                <ScrollViewer x:Name="viewPractice" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel x:Name="dynastyPanel" Margin="12"/>
                </ScrollViewer>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>