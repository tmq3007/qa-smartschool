<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Multi.FormulasTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="#F5F5FA">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#FFF3E0">
                <!-- Multi Category: Orange hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE0B2"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E65100"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Ghi chú" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📐" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextFormulas" Text="Bảng công thức" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#FFE0B2"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & GHI CHÚ -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#FFE0B2" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#FFE0B2" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💡 Hướng dẫn sử dụng nhanh:" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,12"/>
                                <TextBlock Text="• Bước 1: Chọn tab môn học hoặc nhập từ khóa vào ô tìm kiếm để lọc công thức." FontSize="13.5" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBlock Text="• Bước 2: Click vào thẻ công thức để xem chi tiết (định nghĩa, ví dụ thực tế, ghi chú sư phạm, hình minh họa)." FontSize="13.5" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBlock Text="• Bước 3: Click vào nút 📋 Copy trên thẻ để sao chép nhanh công thức vào bộ nhớ tạm." FontSize="13.5" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBlock Text="• Bước 4: Click nút 🎯 Ôn tập nhanh để thử thách trí nhớ bằng các câu hỏi trắc nghiệm." FontSize="13.5" Foreground="#374151" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: BẢNG CÔNG THỨC -->
                <ScrollViewer x:Name="viewPractice" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Visible">
                    <StackPanel Margin="8">
                        <!-- ═══ HEADER ═══ -->
                        <Border CornerRadius="14" Padding="20,16" Margin="0,0,0,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E65100" Offset="0"/>
                                    <GradientStop Color="#F57C00" Offset="0.5"/>
                                    <GradientStop Color="#FF9800" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="📐 Bảng Công Thức Tham Khảo" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Hệ thống 50+ công thức môn Toán, Lý, Hóa bám sát chương trình GDPT 2018" 
                                           FontSize="14" Foreground="#FFE0B2" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ TÌM KIẾM ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,0,12"
                                BorderBrush="#E3E8EE" BorderThickness="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="🎯 Ôn tập nhanh" Click="StartQuiz_Click"
                                        Background="#1565C0" Foreground="White" FontWeight="Bold" FontSize="13"
                                        Padding="12,4" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Grid>
                                    <TextBox x:Name="txtSearch" FontSize="16" Padding="6,4" Background="Transparent" BorderThickness="0"
                                             MaxLength="100" TextChanged="Search_Changed" ToolTip="Tìm công thức..."/>
                                    <TextBlock x:Name="txtSearchPlaceholder" IsHitTestVisible="False" Text="Nhập tên công thức, môn học hoặc từ khóa để tìm kiếm nhanh..." 
                                               FontSize="16" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- ═══ SUBJECT TABS ═══ -->
                        <WrapPanel x:Name="subjectPanel" Margin="0,0,0,4"/>

                        <!-- ═══ FORMULAS ═══ -->
                        <StackPanel x:Name="formulasSections"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ DETAIL OVERLAY ═══ -->
        <Grid x:Name="detailOverlay" Visibility="Collapsed">
            <!-- Backdrop -->
            <Border Background="#99000000" MouseLeftButtonDown="CloseDetail_Click"/>
            
            <!-- Detail Card -->
            <Border x:Name="detailCard" Background="White" CornerRadius="18" MaxWidth="720" MaxHeight="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" x:Name="detailHeader" CornerRadius="18,18,0,0" Padding="24,18,24,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1565C0" Offset="0"/>
                                <GradientStop Color="#1976D2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="CloseDetail_Click" Cursor="Hand"
                                    VerticalAlignment="Top">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#33FFFFFF" CornerRadius="14" Width="32" Height="32">
                                            <TextBlock Text="✕" FontSize="14" Foreground="White" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="detailTitle" Text="" FontSize="20" FontWeight="Bold" 
                                           Foreground="White"/>
                                <TextBlock x:Name="detailFormula" Text="" FontSize="26" FontWeight="Bold" 
                                           Foreground="#BBDEFB" Margin="0,4,0,0"
                                          />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,14,24,20">
                        <StackPanel x:Name="detailBody"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ═══ QUIZ OVERLAY ═══ -->
        <Grid x:Name="quizOverlay" Visibility="Collapsed">
            <!-- Backdrop -->
            <Border Background="#99000000" MouseLeftButtonDown="CloseQuiz_Click"/>
            
            <!-- Quiz Card -->
            <Border x:Name="quizCard" Background="White" CornerRadius="18" MaxWidth="520" MinHeight="380" Height="Auto"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
 
                    <!-- Header -->
                    <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="24,18" Background="#1565C0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="CloseQuiz_Click" Cursor="Hand"
                                    VerticalAlignment="Top">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#33FFFFFF" CornerRadius="14" Width="32" Height="32">
                                            <TextBlock Text="✕" FontSize="14" Foreground="White" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="🎯 Thử Thách Trắc Nghiệm Công Thức" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="quizStatsHeader" Text="Câu hỏi: 1/5 • Điểm số: 0" FontSize="12" Foreground="#BBDEFB" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
 
                    <!-- Body bọc trong ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="quizQuestion" Text="Công thức nào sau đây dùng để tính..." 
                                       FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            
                            <!-- Answers Options Panel -->
                            <StackPanel x:Name="quizOptions"/>

                            <TextBlock x:Name="quizFeedback" Text="" FontSize="14" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            
                            <Button x:Name="btnNextQuestion" Content="Câu hỏi tiếp theo ➔" Click="NextQuestion_Click"
                                    Background="#0F766E" Foreground="White" FontWeight="Bold" FontSize="13" Height="36"
                                    Margin="0,10,0,0" Cursor="Hand" Visibility="Collapsed">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</controls:BaseToolControl>