<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Thinking.ChessTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{DynamicResource Gray100}">

    <!-- QC_4.2_LAYOUT_GRID Constraint: Root grid MUST stretch horizontally without MaxWidth -->
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER BANNER (Chess.com Inspired Dark Theme Header) -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#262421" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#262421" Offset="0"/>
                    <GradientStop Color="#312E2B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#81B64C" CornerRadius="6" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="NewGame_Click" ToolTip="Bắt đầu ván cờ mới (New Game)">
                        <TextBlock Text="➕ Ván mới" FontSize="14" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#363431" CornerRadius="6" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="FlipBoard_Click" ToolTip="Lật bàn cờ (Flip Board)">
                        <TextBlock Text="🔄 Lật bàn cờ" FontSize="14" Foreground="#BAB8B6" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#9C27B0" CornerRadius="6" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="ExportPGN_Click" ToolTip="Xuất file PGN (Portable Game Notation)">
                        <TextBlock Text="📜 Export PGN" FontSize="14" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#FF9800" CornerRadius="6" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="CreateTournament_Click" ToolTip="Tạo Giải đấu Lớp/Trường">
                        <TextBlock Text="🏆 Tạo Giải đấu" FontSize="14" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#363431" CornerRadius="6" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="Undo_Click" ToolTip="Hoàn tác (Undo)">
                        <TextBlock Text="↩️ Hoàn tác" FontSize="14" Foreground="#BAB8B6" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#A72828" CornerRadius="6" Padding="14,8" Cursor="Hand"
                            MouseLeftButtonDown="Resign_Click" ToolTip="Đầu hàng (Resign)">
                        <TextBlock Text="🏳️ Đầu hàng" FontSize="14" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="♟️ Cờ Vua Chiến Thuật &amp; Giao Diện Quân Cờ Đa Theme Sư Phạm" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Border Background="#81B64C" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VECTOR HD THEMES" FontSize="10" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tự chọn 3 Bộ Theme Quân cờ (Classic Unicode, Staunton Pro Wood, High-Contrast Neo) &amp; Hiệu ứng Phát sáng Nước đi" FontSize="13" Foreground="#BAB8B6" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN MASTER-DETAIL CONTENT -->
        <Grid Grid.Row="1" Background="#262421">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (5 TABS) -->
            <Grid Grid.Column="0" Background="#312E2B">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#3D3A37"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#81B64C"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{DynamicResource SidebarListBoxItemStyle}">
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Khai cuộc" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♟️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPlay" Text="Bàn Cờ Vua Pro" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextAnalysis" Text="Game Review &amp; AI" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏆" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTournament" Text="Giải Đấu Trường Học" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#3D3A37"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">

                <!-- VIEW 1: HƯỚNG DẪN & KHAI CUỘC (MaxWidth="1400") -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="#312E2B" Margin="12" MaxWidth="1400">
                        <Border Background="#262421" CornerRadius="12" Padding="24,20" Margin="0,0,0,16" BorderBrush="#3D3A37" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#81B64C" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="👨‍🏫 DÀNH CHO GIÁO VIÊN" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Phương pháp Giảng dạy Cờ Vua" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="• Mục tiêu Sư phạm:" FontWeight="Bold" Foreground="#81B64C" Margin="0,4,0,2"/>
                                    <TextBlock Text="Phát triển tư duy phân tích, khả năng tính toán nước đi trước, tính kiên nhẫn và khả năng chấp nhận thất bại để rút kinh nghiệm." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,0,0,8"/>

                                    <TextBlock Text="• Quy trình 4 bước dạy Cờ Vua hiệu quả:" FontWeight="Bold" Foreground="#81B64C" Margin="0,4,0,2"/>
                                    <TextBlock Text="1. Giới thiệu giá trị quân cờ &amp; đường đi chuẩn (Tốt=1, Mã=3, Tượng=3, Xe=5, Hậu=9)." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                    <TextBlock Text="2. Hướng dẫn 3 nguyên tắc khai cuộc: Chiếm trung tâm, phát triển Mã &amp; Tượng, nhập thành bảo vệ Vua." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                    <TextBlock Text="3. Cho học sinh luyện tập giải bài tập Thế cờ (Puzzles) chiếu bí sau 1-2 nước." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                    <TextBlock Text="4. Tổ chức thi đấu nội bộ trên chế độ SMART TOUCH hoặc 2 Người chơi." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="#3D3A37" Margin="12,0"/>

                                <!-- Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#1976D2" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="🎓 DÀNH CHO HỌC SINH" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Mẹo &amp; Quy Tắc Di Chuyển Quân Cờ" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <UniformGrid Columns="2" Margin="0,4,0,8">
                                        <Border Background="#3D3A37" CornerRadius="8" Padding="10" Margin="4">
                                            <StackPanel>
                                                <TextBlock Text="♙ Tốt (Pawn)" FontWeight="Bold" Foreground="#81B64C"/>
                                                <TextBlock Text="Đi thẳng 1 ô (nước đầu 2 ô), bắt chéo 1 ô. Khi tới hàng 8 được phong cấp." FontSize="11" TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#3D3A37" CornerRadius="8" Padding="10" Margin="4">
                                            <StackPanel>
                                                <TextBlock Text="♘ Mã (Knight)" FontWeight="Bold" Foreground="#81B64C"/>
                                                <TextBlock Text="Đi hình chữ L (2 ô thẳng + 1 ô ngang). Là quân duy nhất nhảy qua quân khác." FontSize="11" TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#3D3A37" CornerRadius="8" Padding="10" Margin="4">
                                            <StackPanel>
                                                <TextBlock Text="♗ Tượng (Bishop)" FontWeight="Bold" Foreground="#81B64C"/>
                                                <TextBlock Text="Đi đường chéo không giới hạn ô. Mỗi Tượng giữ nguyên màu ô suốt ván." FontSize="11" TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#3D3A37" CornerRadius="8" Padding="10" Margin="4">
                                            <StackPanel>
                                                <TextBlock Text="♖ Xe (Rook)" FontWeight="Bold" Foreground="#81B64C"/>
                                                <TextBlock Text="Đi ngang &amp; ngang thẳng không giới hạn. Kết hợp với Vua để Nhập thành." FontSize="11" TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#3D3A37" CornerRadius="8" Padding="10" Margin="4">
                                            <StackPanel>
                                                <TextBlock Text="♕ Hậu (Queen)" FontWeight="Bold" Foreground="#81B64C"/>
                                                <TextBlock Text="Quân mạnh nhất! Đi được cả đường thẳng và chéo không giới hạn." FontSize="11" TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#3D3A37" CornerRadius="8" Padding="10" Margin="4">
                                            <StackPanel>
                                                <TextBlock Text="♔ Vua (King)" FontWeight="Bold" Foreground="#81B64C"/>
                                                <TextBlock Text="Quân quan trọng nhất! Đi 1 ô mọi hướng. Bị chiếu bí = Thua cuộc!" FontSize="11" TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: BÀN CỜ VUA CHESS.COM STYLE WITH EVAL BAR (CHÍNH) -->
                <Grid x:Name="viewPlay" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KHU VỰC BÀN CỜ + EVALUATION BAR (BÊN TRÁI) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- REAL-TIME EVALUATION ADVANTAGE BAR -->
                        <Border Width="16" Height="512" Background="#262421" CornerRadius="4" Margin="0,0,12,0" BorderBrush="#3D3A37" BorderThickness="1" ToolTip="Thanh đánh giá ưu thế trận đấu (Evaluation Bar)">
                            <Grid x:Name="gridEvalBar">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="rowEvalBlack" Height="1*"/>
                                    <RowDefinition x:Name="rowEvalWhite" Height="1*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#363431" CornerRadius="3,3,0,0"/>
                                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="0,0,3,3"/>
                                <TextBlock x:Name="txtEvalScore" Text="0.0" FontSize="9" FontWeight="Bold" Foreground="#81B64C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#312E2B" CornerRadius="12" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <StackPanel>
                                    <!-- PLAYER CARD TOP (BLACK / OPPONENT) -->
                                    <Border Background="#262421" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#363431" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtTimerBlack" Text="05:00" FontSize="18" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#363431" CornerRadius="20" Width="36" Height="36" Margin="0,0,10,0">
                                                    <TextBlock Text="🤖" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="txtPlayerBlackName" Text="Máy (AI Bot)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                        <TextBlock x:Name="txtPlayerBlackRating" Text=" (Elo 1200 🥇)" FontSize="13" Foreground="#BAB8B6"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <StackPanel x:Name="spCapturedBlack" Orientation="Horizontal"/>
                                                        <TextBlock x:Name="txtMaterialDiffBlack" Text="" FontSize="11" FontWeight="Bold" Foreground="#81B64C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- TỌA ĐỘ BÀN CỜ -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Top Files -->
                                        <UniformGrid Grid.Row="0" Grid.Column="1" Columns="8" Height="18">
                                            <TextBlock Text="a" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="b" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="c" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="d" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="e" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="f" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="g" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="h" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                        </UniformGrid>

                                        <!-- Left Ranks -->
                                        <UniformGrid Grid.Row="1" Grid.Column="0" Rows="8" Width="18">
                                            <TextBlock Text="8" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="7" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="6" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="5" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="4" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="3" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="2" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="1" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                        </UniformGrid>

                                        <!-- BÀN CỜ 8x8 CHESS.COM STYLE (#EEEED2 & #769656) -->
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#363431" BorderThickness="3" CornerRadius="4">
                                            <Grid x:Name="gridChessBoard" Width="512" Height="512">
                                                <!-- Dynamic 8x8 cells generated in C# -->
                                            </Grid>
                                        </Border>

                                        <!-- Right Ranks -->
                                        <UniformGrid Grid.Row="1" Grid.Column="2" Rows="8" Width="18">
                                            <TextBlock Text="8" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="7" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="6" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="5" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="4" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="3" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="2" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="1" Foreground="#BAB8B6" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                        </UniformGrid>

                                        <!-- Bottom Files -->
                                        <UniformGrid Grid.Row="2" Grid.Column="1" Columns="8" Height="18">
                                            <TextBlock Text="a" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="b" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="c" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="d" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="e" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="f" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="g" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="h" Foreground="#BAB8B6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                        </UniformGrid>
                                    </Grid>

                                    <!-- PLAYER CARD BOTTOM (WHITE / YOU) -->
                                    <Border Background="#262421" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#363431" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtTimerWhite" Text="05:00" FontSize="18" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#81B64C" CornerRadius="20" Width="36" Height="36" Margin="0,0,10,0">
                                                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="txtPlayerWhiteName" Text="Người chơi (Trắng)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                        <TextBlock x:Name="txtPlayerWhiteRating" Text=" (Elo 1420 🥇)" FontSize="13" Foreground="#BAB8B6"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <StackPanel x:Name="spCapturedWhite" Orientation="Horizontal"/>
                                                        <TextBlock x:Name="txtMaterialDiffWhite" Text="" FontSize="11" FontWeight="Bold" Foreground="#81B64C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- OVERLAY CHỌN PHONG CẤP TỐT -->
                                <Grid x:Name="gridPromotionOverlay" Background="#CC000000" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Background="#312E2B" CornerRadius="12" Padding="20" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#81B64C" BorderThickness="2">
                                        <StackPanel>
                                            <TextBlock Text="👑 PHONG CẤP TỐT" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="Chọn quân cờ bạn muốn phong cấp:" FontSize="13" Foreground="#BAB8B6" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                            <UniformGrid Columns="2" Height="100">
                                                <Button Content="♕ Hậu (Queen)" Click="PromoteToQueen_Click" Margin="4" Background="#81B64C" Foreground="White" FontWeight="Bold"/>
                                                <Button Content="♖ Xe (Rook)" Click="PromoteToRook_Click" Margin="4" Background="#363431" Foreground="White" FontWeight="Bold"/>
                                                <Button Content="♗ Tượng (Bishop)" Click="PromoteToBishop_Click" Margin="4" Background="#363431" Foreground="White" FontWeight="Bold"/>
                                                <Button Content="♘ Mã (Knight)" Click="PromoteToKnight_Click" Margin="4" Background="#363431" Foreground="White" FontWeight="Bold"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- PANEL ĐIỀU KHIỂN & MOVES LOG + GAME REVIEW (BÊN PHẢI) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- CARD 1: THIẾT LẬP CHẾ ĐỘ ĐẤU & THEME QUÂN CỜ -->
                        <Border Grid.Row="0" Background="#312E2B" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#3D3A37" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🎮 Chế Độ Chơi &amp; Giao Diện Quân Cờ" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Chế độ:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#BAB8B6" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="cboGameMode" Grid.Column="1" SelectionChanged="CboGameMode_SelectionChanged" Padding="8,4">
                                        <ComboBoxItem Content="🧑‍🤝‍🧑 2 Người chơi (Pass &amp; Play)" IsSelected="True"/>
                                        <ComboBoxItem Content="🤖 Đấu với Máy (AI Engine)"/>
                                        <ComboBoxItem Content="🎓 Dạy Khai Cuộc Tương Tác (Opening Masterclass)"/>
                                        <ComboBoxItem Content="🧩 Giải Thách Thức Thế Cờ (Chess Puzzles)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme quân:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#BAB8B6" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="cboPieceTheme" Grid.Column="1" SelectionChanged="CboPieceTheme_SelectionChanged" Padding="8,4">
                                        <ComboBoxItem Content="👑 Classic Unicode HD (Chuẩn Chess.com)" IsSelected="True"/>
                                        <ComboBoxItem Content="🪵 Staunton Pro Wood (Gỗ Tự Nhiên)"/>
                                        <ComboBoxItem Content="✨ Neo-Classic High-Contrast Vector (Độ tương phản cao)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid x:Name="panelAILevel" Margin="0,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Độ khó AI:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#BAB8B6" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="cboAILevel" Grid.Column="1" SelectionChanged="CboAILevel_SelectionChanged" Padding="8,4">
                                        <ComboBoxItem Content="🟢 Dễ (Tập chơi - Minimax D1)"/>
                                        <ComboBoxItem Content="🟡 Trung Bình (Minimax D2 + Position)" IsSelected="True"/>
                                        <ComboBoxItem Content="🔴 Khó (Stockfish 18 Lite Alpha-Beta D4)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid x:Name="panelPuzzles" Margin="0,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Chọn bài học:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#BAB8B6" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="cboPuzzles" Grid.Column="1" SelectionChanged="CboPuzzles_SelectionChanged" Padding="8,4">
                                        <ComboBoxItem Content="🧩 Bài 1: Chiếu bí 1 nước (Scholar's Mate)"/>
                                        <ComboBoxItem Content="🧩 Bài 2: Chiếu bí 1 nước (Back Rank Mate)"/>
                                        <ComboBoxItem Content="🧩 Bài 3: Chiếu bí 2 nước (Smothered Mate)"/>
                                        <ComboBoxItem Content="🎓 Khai cuộc 1: Italian Game (1. e4 e5 2. Nf3 Nc6 3. Bc4)"/>
                                        <ComboBoxItem Content="🎓 Khai cuộc 2: Ruy Lopez (1. e4 e5 2. Nf3 Nc6 3. Bb5)"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: TRẠNG THÁI KHAI CUỘC & STOCKFISH ENGINE -->
                        <Border Grid.Row="1" Background="#312E2B" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#3D3A37" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="txtOpeningName" Text="📖 Italian Game: Anti-Fried Liver Defense" FontSize="13" FontWeight="Bold" Foreground="#81B64C"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtAISthinking" Text="🤖 Máy đang tính... " FontSize="12" Foreground="#FF9800" FontWeight="Bold" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtStockfishLabel" Text="⚙️ Stockfish 18 Lite" FontSize="12" Foreground="#81B64C" FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="txtTurnIndicator" Text="Lượt đi: Trắng (White)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="txtStatusMessage" Text="Bắt đầu trận đấu. Chọn quân cờ để di chuyển!" FontSize="12" Foreground="#BAB8B6" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: MOVES TABLE WITH PER-MOVE EXECUTION TIMES -->
                        <Border Grid.Row="2" Background="#312E2B" CornerRadius="12" Padding="16" BorderBrush="#3D3A37" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="📜 Move History &amp; Time (SAN)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="txtMoveCount" Text="0 nước" FontSize="12" Foreground="#81B64C" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ListBox x:Name="lstMoveHistory" Grid.Row="1" BorderThickness="1" BorderBrush="#3D3A37" Background="#262421" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                                
                                <!-- BOTTOM MOVE NAVIGATION BAR -->
                                <UniformGrid Grid.Row="2" Columns="4" Margin="0,8,0,0" Height="36">
                                    <Button Content="⏮️" Click="FirstMove_Click" Background="#363431" Foreground="White" FontWeight="Bold" ToolTip="Nước đầu tiên"/>
                                    <Button Content="◀️" Click="PrevMove_Click" Background="#363431" Foreground="White" FontWeight="Bold" ToolTip="Nước trước đó"/>
                                    <Button Content="▶️" Click="NextMove_Click" Background="#363431" Foreground="White" FontWeight="Bold" ToolTip="Nước tiếp theo"/>
                                    <Button Content="⏭️" Click="LastMove_Click" Background="#363431" Foreground="White" FontWeight="Bold" ToolTip="Nước mới nhất"/>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- CARD 4: REAL-TIME DYNAMIC MOVE CLASSIFICATION BADGES -->
                        <Border Grid.Row="3" Background="#312E2B" CornerRadius="12" Padding="14" Margin="0,12,0,0" BorderBrush="#81B64C" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Border Background="#00BCD4" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                        <TextBlock x:Name="badgeBrilliant" Text="!! 0 Brilliant" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#81B64C" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                        <TextBlock x:Name="badgeBest" Text="★ 0 Best" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#4CAF50" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                        <TextBlock x:Name="badgeExcellent" Text="👍 0 Excellent" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#E57373" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="badgeBlunder" Text="?? 0 Blunder" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <Button x:Name="btnGameReview" Content="⭐ Game Review" Click="GameReview_Click" Padding="12" Background="#81B64C" Foreground="White" FontWeight="Bold" FontSize="15" Height="42"/>

                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Button Content="➕ New 10 min" Click="NewGame_Click" Padding="6" Margin="0,0,4,0" Background="#363431" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    <Button Content="🔄 Rematch" Click="Rematch_Click" Padding="6" Margin="4,0,0,0" Background="#363431" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- BOTTOM UTILITY TOOLBAR (Chess.com Bottom Icons) -->
                        <UniformGrid Grid.Row="4" Columns="6" Margin="0,8,0,0" Height="36">
                            <Button Content="🔗" Click="ExportFEN_Click" Background="#363431" Foreground="White" ToolTip="Chia sẻ PGN / FEN"/>
                            <Button Content="⚙️" Click="Settings_Click" Background="#363431" Foreground="White" ToolTip="Cài đặt Bàn cờ"/>
                            <Button Content="🔍" Click="GameReview_Click" Background="#363431" Foreground="White" ToolTip="Soi ván đấu"/>
                            <Button Content="🤍" Click="Favorite_Click" Background="#363431" Foreground="White" ToolTip="Lưu yêu thích"/>
                            <Button Content="💬" Click="Annotation_Click" Background="#363431" Foreground="White" ToolTip="Ghi chú sư phạm"/>
                            <Button Content="🔄" Click="FlipBoard_Click" Background="#363431" Foreground="White" ToolTip="Lật bàn cờ"/>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <!-- VIEW 3: GAME REVIEW & ANALYSIS ENGINE (NEW TAB 3 - MaxWidth="1400") -->
                <ScrollViewer x:Name="viewAnalysis" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Background="#312E2B" Margin="12" MaxWidth="1400">
                        <Border Background="#262421" CornerRadius="12" Padding="24,20" Margin="0,0,0,16" BorderBrush="#81B64C" BorderThickness="2">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Border DockPanel.Dock="Right" Background="#81B64C" CornerRadius="6" Padding="12,6">
                                        <TextBlock x:Name="txtAccuracyScore" Text="Accuracy: 100%" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="⭐ DYNAMIC GAME REVIEW &amp; PHÂN TÍCH THỜI GIAN THỰC" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Tự động tính toán điểm Accuracy % &amp; Phân loại Nước đi Thiên tài (!!), Tối ưu (★), Xuất sắc (👍)" FontSize="13" Foreground="#BAB8B6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Background="#312E2B" CornerRadius="8" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock x:Name="txtBrilliantStat" Text="!! 0 Brilliant" Foreground="#00BCD4" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="Nước đi thiên tài hy sinh quân hợp lý!" FontSize="11" Foreground="#BAB8B6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#312E2B" CornerRadius="8" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock x:Name="txtBestStat" Text="★ 0 Best" Foreground="#81B64C" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="Nước đi tối ưu nhất theo Stockfish." FontSize="11" Foreground="#BAB8B6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#312E2B" CornerRadius="8" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock x:Name="txtExcellentStat" Text="👍 0 Excellent" Foreground="#4CAF50" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="Nước đi xuất sắc duy trì ưu thế." FontSize="11" Foreground="#BAB8B6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#312E2B" CornerRadius="8" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock x:Name="txtBlunderStat" Text="?? 0 Blunder" Foreground="#E57373" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="Sai lầm nghiêm trọng cần khắc phục." FontSize="11" Foreground="#BAB8B6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="#312E2B" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="💡 LỜI KHUYÊN SƯ PHẠM TỪ THUẬT TOÁN ĐÁNH GIÁ:" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="txtPedagogicalAdvice" Text="• Chưa có dữ liệu nước đi. Hãy bắt đầu ván cờ và di chuyển quân để hệ thống phân tích!" TextWrapping="Wrap" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 4: HỆ THỐNG GIẢI ĐẤU TRƯỜNG HỌC (NEW TAB 4 - MaxWidth="1400") -->
                <ScrollViewer x:Name="viewTournament" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Background="#312E2B" Margin="12" MaxWidth="1400">
                        <!-- BANNER GIẢI ĐẤU -->
                        <Border Background="#262421" CornerRadius="12" Padding="24,20" Margin="0,0,0,16" BorderBrush="#81B64C" BorderThickness="2">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="➕ Tạo Giải Đấu Mới" Click="CreateTournament_Click" Padding="14,8" Background="#81B64C" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                <StackPanel>
                                    <TextBlock Text="🏆 HỆ THỐNG QUẢN LÝ GIẢI ĐẤU CỜ VUA TRƯỜNG HỌC" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Tổ chức Giải Cờ vua Lớp học, Giải Vô địch Toàn trường, Giao lưu Thầy &amp; Trò và Giải Cán bộ Giáo viên" FontSize="13" Foreground="#BAB8B6" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 4 MÔ HÌNH THI ĐẤU SƯ PHẠM -->
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <!-- Mô hình 1: Lớp học -->
                            <Border Background="#262421" CornerRadius="10" Padding="16" Margin="6" BorderBrush="#3D3A37" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#81B64C" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="CẤP LỚP HỌC" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="🏫 Giải Cờ Vua Lớp Học (Classroom League)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <TextBlock Text="• Thể thức: Vòng tròn 1 lượt (Round Robin) hoặc Hệ Thụy Sĩ 5 vòng (Swiss System)." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,2,0,4"/>
                                    <TextBlock Text="• Tự động bốc thăm chia cặp ngẫu nhiên &amp; theo điểm số." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Xếp hạng Elo học sinh theo lớp &amp; cấp Chứng nhận Điện tử." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                </StackPanel>
                            </Border>

                            <!-- Mô hình 2: Toàn trường -->
                            <Border Background="#262421" CornerRadius="10" Padding="16" Margin="6" BorderBrush="#3D3A37" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#1976D2" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="CẤP TRƯỜNG" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="🏆 Giải Vô Địch Cờ Vua Toàn Trường" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <TextBlock Text="• Thể thức: Chia Bảng đấu (Group Stage) chọn 8 tay cờ vào Sơ đồ Loại trực tiếp (Knockout Bracket)." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,2,0,4"/>
                                    <TextBlock Text="• Thi đấu liên lớp giữa các Khối (Khối 6, 7, 8, 9 hoặc Cấp 1, 2, 3)." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Tự động tính điểm đồng đội cho từng Lớp." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                </StackPanel>
                            </Border>

                            <!-- Mô hình 3: Thầy & Trò -->
                            <Border Background="#262421" CornerRadius="10" Padding="16" Margin="6" BorderBrush="#3D3A37" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#FF9800" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="GIAO LƯU" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="👨‍🏫🤝🎓 Giao Lưu Cờ Vua Thầy &amp; Trò" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <TextBlock Text="• Thể thức 1: Đấu biểu diễn đồng thời (Simul) – Giáo viên đấu 5-10 học sinh cùng lúc." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,2,0,4"/>
                                    <TextBlock Text="• Thể thức 2: Đấu Chấp quân (Odds Match) – Thầy chấp Xe/Mã/Tốt tạo thế cân bằng cho trò." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Tăng cường gắn kết tình cảm Thầy - Trò trong môi trường học đường." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                </StackPanel>
                            </Border>

                            <!-- Mô hình 4: Giáo viên & Cán bộ -->
                            <Border Background="#262421" CornerRadius="10" Padding="16" Margin="6" BorderBrush="#3D3A37" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#9C27B0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="CÔNG ĐOÀN" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="👔 Giải Cờ Vua Cán Bộ Giáo Viên" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <TextBlock Text="• Giải đấu thể thao trí tuệ dành cho Cán bộ, Giáo viên &amp; Nhân viên nhà trường." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,2,0,4"/>
                                    <TextBlock Text="• Thi đấu giao lưu nhân dịp 20/11, Ngày Hội Thể Thao Công Đoàn." TextWrapping="Wrap" Foreground="#BAB8B6" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Lưu trữ lịch sử ván đấu &amp; Bảng Vàng Vinh Danh Thầy Cô xuất sắc." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- BẢNG LỊCH THI ĐẤU & KẾT QUẢ MẪU -->
                        <Border Background="#262421" CornerRadius="12" Padding="20" BorderBrush="#3D3A37" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="📊 BẢNG XẾP HẠNG &amp; LỊCH THI ĐẤU HIỆN TẠI" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Cập nhật tự động" FontSize="12" Foreground="#81B64C" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Bảng xếp hạng Lớp -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="🏆 Bảng Xếp Hạng Giải Học Sinh Khối 8" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,6"/>
                                        <ListBox x:Name="lstTournamentRankings" Height="140" Background="#312E2B" Foreground="White" BorderBrush="#3D3A37" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Cặp đấu tiếp theo -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="⚔️ Lịch Bốc Thăm Vòng Tiếp Theo" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,6"/>
                                        <ListBox x:Name="lstPairings" Height="140" Background="#312E2B" Foreground="White" BorderBrush="#3D3A37" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,8,0,0">
                                    <Button Content="🎲 Bốc Thăm Tự Động" Click="AutoPairing_Click" Padding="8" Margin="4" Background="#81B64C" Foreground="White" FontWeight="Bold"/>
                                    <Button Content="📜 Xuất Giấy Chứng Nhận" Click="ExportCertificate_Click" Padding="8" Margin="4" Background="#1976D2" Foreground="White" FontWeight="Bold"/>
                                    <Button Content="📊 Báo Cáo Giải Đấu" Click="ExportTournamentReport_Click" Padding="8" Margin="4" Background="#363431" Foreground="White" FontWeight="Bold"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 5: ỨNG DỤNG THỰC TẾ (MaxWidth="1400") -->
                <ScrollViewer x:Name="viewPractical" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Background="#312E2B" Margin="12" MaxWidth="1400">
                        <Border Background="#262421" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#3D3A37" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🌍 ỨNG DỤNG TƯ DUY CỜ VUA TRONG HỌC TẬP &amp; CUỘC SỐNG" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                                <UniformGrid Columns="2">
                                    <Border Background="#3D3A37" CornerRadius="10" Padding="16" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="🎯 1. Tư Duy Lập Kế Hoạch &amp; Chiến Lược" FontSize="15" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,6"/>
                                            <TextBlock Text="Trong Cờ vua, mỗi nước đi đều hướng tới kế hoạch tổng thể. Điều này giúp học sinh rèn luyện tư duy đặt mục tiêu ngắn hạn - dài hạn trong học tập và công việc." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#3D3A37" CornerRadius="10" Padding="16" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="⚡ 2. Ra Quyết Định Dưới Áp Lực" FontSize="15" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,6"/>
                                            <TextBlock Text="Đồng hồ đếm giờ buộc học sinh phải đánh giá rủi ro và ra quyết định chính xác ngay cả khi bị giới hạn thời gian (tương tự khi làm bài thi trắc nghiệm)." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#3D3A37" CornerRadius="10" Padding="16" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="🔍 3. Phân Tích Nguyên Nhân &amp; Hậu Quả" FontSize="15" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,6"/>
                                            <TextBlock Text="Mỗi sai lầm trên bàn cờ đều mang lại bài học tức thì. Học sinh học cách chịu trách nhiệm với quyết định của mình và điều chỉnh chiến thuật linh hoạt." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#3D3A37" CornerRadius="10" Padding="16" Margin="6">
                                        <StackPanel>
                                            <TextBlock Text="🧠 4. Phát Triển Trí Thông Minh Không Gian (Spatial Intelligence)" FontSize="15" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,6"/>
                                            <TextBlock Text="Hình dung trước 2-3 nước đi trong đầu nâng cao khả năng tưởng tượng hình học không gian, hỗ trợ đắc lực cho các môn Toán, Vật lý &amp; Tin học." TextWrapping="Wrap" Foreground="#BAB8B6"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
