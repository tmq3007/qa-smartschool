<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Thinking.MemoryGameTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">
             
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E8F5E9" Offset="0"/>
                    <GradientStop Color="#C8E6C9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#1B5E20" CornerRadius="8" Padding="12,8" Cursor="Hand"
                        MouseLeftButtonDown="NewGame_Click" VerticalAlignment="Center">
                    <TextBlock Text="🔄 Ván mới" FontSize="13" Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="🃏 Memory Game – Lật Thẻ Nhớ" FontSize="20" FontWeight="Bold" Foreground="#1B5E20"/>
                    <TextBlock Text="Mọi cấp • Từ vựng, Công thức, Nguyên tố • Rèn trí nhớ" FontSize="13" Foreground="#388E3C" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E8F5E9">
                <!-- Thinking Category: Pink hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#F8BBD0"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#AD1457"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn Học" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🃏" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPlay" Text="Trò Chơi Lật Thẻ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#C8E6C9"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- Tab 1: Hướng Dẫn Học -->
                <ScrollViewer x:Name="contentGuide" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="12">
                        <!-- Guide Header -->
                        <Border Background="#E8F5E9" CornerRadius="12" Padding="24,18" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📖 Hướng Dẫn Sử Dụng &amp; Ý Nghĩa Sư Phạm" FontSize="20" FontWeight="Bold" Foreground="#1B5E20"/>
                                <TextBlock Text="Học tập tích cực qua phương pháp lật thẻ nhớ (Flashcards) để tăng cường trí nhớ dài hạn." FontSize="14" Foreground="#2E7D32" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Steps -->
                        <TextBlock Text="🎯 Quy trình 4 bước đơn giản:" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,10"/>
                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#C8E6C9" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="1️⃣ Chọn Chủ đề" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Lựa chọn Toán học, Hóa học, Tiếng Anh hoặc Vật lý tại thanh menu bên phải." FontSize="13" Foreground="#555" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#C8E6C9" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="2️⃣ Di chuột" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Di chuột qua thẻ bài. Thẻ sẽ sáng lên để báo hiệu có thể click chọn lật thẻ." FontSize="13" Foreground="#555" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#C8E6C9" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="3️⃣ Lật tìm cặp" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Click lật thẻ câu hỏi và thẻ đáp án khớp nhau. Nếu sai, thẻ tự úp lại sau 0.8s." FontSize="13" Foreground="#555" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#C8E6C9" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="4️⃣ Speedrun" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Tìm đủ 8 cặp trong thời gian ngắn nhất và số lượt ít nhất để lưu bảng điểm." FontSize="13" Foreground="#555" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Sample Data / Examples Table -->
                        <TextBlock Text="📊 Ví dụ các Cặp thẻ học tập mẫu:" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Table Header -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#F1F8E9" Padding="8,6" BorderBrush="#C8E6C9" BorderThickness="0,0,0,2">
                                    <TextBlock Text="Chủ đề" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#F1F8E9" Padding="8,6" BorderBrush="#C8E6C9" BorderThickness="0,0,0,2">
                                    <TextBlock Text="Thẻ Câu hỏi (Q)" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="#F1F8E9" Padding="8,6" BorderBrush="#C8E6C9" BorderThickness="0,0,0,2">
                                    <TextBlock Text="Thẻ Đáp án (A)" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Background="#F1F8E9" Padding="8,6" BorderBrush="#C8E6C9" BorderThickness="0,0,0,2">
                                    <TextBlock Text="Mô tả / Ý nghĩa sư phạm" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                                </Border>

                                <!-- Row 1 -->
                                <Border Grid.Row="1" Grid.Column="0" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="🔢 Phép tính" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="7 × 8" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="56" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Luyện tập nhân nhẩm cửu chương nâng cao không trùng kết quả." FontSize="13" Foreground="#555" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Row 2 -->
                                <Border Grid.Row="2" Grid.Column="0" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="🧪 Nguyên tố" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Fe" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Iron" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Đồng bộ danh pháp IUPAC tiếng Anh chuẩn GDPT 2018 và phát âm TTS." FontSize="13" Foreground="#555" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Row 3 -->
                                <Border Grid.Row="3" Grid.Column="0" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Từ vựng" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="teacher" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="giáo viên" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Học từ vựng song ngữ và nghe giọng đọc tiếng Anh của máy tính." FontSize="13" Foreground="#555" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Row 4 -->
                                <Border Grid.Row="4" Grid.Column="0" Padding="8,6">
                                    <TextBlock Text="📐 Công thức" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Padding="8,6">
                                    <TextBlock Text="U = I×R" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" Padding="8,6">
                                    <TextBlock Text="Hiệu điện thế" FontSize="13.5" Foreground="#1B5E20" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" Padding="8,6">
                                    <TextBlock Text="Ghi nhớ công thức Vật lý/Toán học đúng chuẩn quy ước ký hiệu SGK Việt Nam." FontSize="13" Foreground="#555" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 2: Trò chơi Lật Thẻ -->
                <Grid x:Name="contentPlay" Visibility="Collapsed" MaxWidth="1050" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cards grid -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,16,0"
                            BorderBrush="#C8E6C9" BorderThickness="1">
                        <UniformGrid x:Name="cardsPanel" Columns="4" Rows="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Right panel -->
                    <StackPanel Grid.Column="1">
                        <!-- Theme -->
                        <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📚 Chủ đề" FontSize="14" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,8"/>
                                <ComboBox x:Name="cboTheme" SelectedIndex="0" SelectionChanged="Theme_Changed" Padding="6,4">
                                    <ComboBoxItem Content="🔢 Phép tính" FontSize="14"/>
                                    <ComboBoxItem Content="🧪 Nguyên tố" FontSize="14"/>
                                    <ComboBoxItem Content="Từ vựng" FontSize="14"/>
                                    <ComboBoxItem Content="📐 Công thức" FontSize="14"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Score -->
                        <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="txtMoves" Text="📊 Lượt: 0" FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                                <TextBlock x:Name="txtTimer" Text="⏱️ Thời gian: 0s" FontSize="16" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtPairs" Text="✅ Cặp: 0/8" FontSize="16" Foreground="#388E3C" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtStatus" Text="🎮 Sẵn sàng" FontSize="15" Foreground="#757575" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Step-by-Step Guide -->
                        <Border Background="#F1F8E9" CornerRadius="10" Padding="14,12" BorderBrush="#C8E6C9" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 Chỉ dẫn từng bước:" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="1️⃣ Chọn chủ đề muốn học bên trên." FontSize="12.5" Foreground="#3E2723" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="2️⃣ Click lật một thẻ bài để xem nội dung." FontSize="12.5" Foreground="#3E2723" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="3️⃣ Tìm và click lật thẻ còn lại ghép thành cặp đúng." FontSize="12.5" Foreground="#3E2723" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="4️⃣ Hoàn thành tất cả 8 cặp thẻ trong thời gian ngắn nhất." FontSize="12.5" Foreground="#3E2723" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tab 3: Ứng dụng thực tế -->
                <Border x:Name="viewPractical" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
