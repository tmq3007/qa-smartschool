<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Thinking.MentalMathTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <controls:BaseToolControl.Resources>
        <Style x:Key="ScratchRadioBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </controls:BaseToolControl.Resources>

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER (Gradient) -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E8F5E9" Offset="0"/>
                    <GradientStop Color="#C8E6C9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblLevel" Text="Cấp độ:" Foreground="#2E7D32" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="cboLevel" Width="140" SelectedIndex="0" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0">
                        <ComboBoxItem x:Name="cboLevelItemEasy" Content="Dễ (1-20)"/>
                        <ComboBoxItem x:Name="cboLevelItemMedium" Content="Vừa (1-100)"/>
                        <ComboBoxItem x:Name="cboLevelItemHard" Content="Khó (Nhẩm)"/>
                        <ComboBoxItem x:Name="cboLevelItemExpert" Content="Chuyên gia"/>
                    </ComboBox>
                    <Button x:Name="btnSoundToggle" Content="🔊" Width="36" Height="30" FontSize="16" FontWeight="Bold" 
                            Background="Transparent" BorderThickness="0" Foreground="#2E7D32" Cursor="Hand" Click="SoundToggle_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnToggleScratchPad" Content="📝 Bảng nháp" Padding="12,6" FontSize="14" FontWeight="Bold" 
                            Background="Transparent" Foreground="#2E7D32" BorderBrush="#2E7D32" BorderThickness="1.5" Cursor="Hand" Click="BtnToggleScratchPad_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="txtTitle" Text="⚡ Tính Nhẩm Nhanh" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock x:Name="txtSubtitle" Text="Mọi cấp độ • Luyện tính nhẩm theo level • Thi tốc độ" FontSize="14" Foreground="#388E3C" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E8F5E9">
                <!-- Thinking Category: Pink hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#F8BBD0"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#AD1457"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Ghi chú" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Luyện tính nhẩm" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#C8E6C9"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 1: HƯỚNG DẪN & GHI CHÚ -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#F8BBD0" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#AD1457" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#F8BBD0" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<!-- Khối hướng dẫn -->
                        <Border Background="#E8F5E9" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#C8E6C9" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Ý NGHĨA &amp; MẸO TÍNH NHẨM NHANH" FontWeight="Bold" Foreground="#1B5E20" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="18">
                                    Luyện tính nhẩm là một phương pháp rèn luyện trí não vô cùng hiệu quả, giúp nâng cao độ nhạy bén với các con số, tăng cường trí nhớ ngắn hạn và xây dựng nền tảng toán học vững chắc cho học sinh.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🎯 Quy tắc các Cấp độ:" FontSize="15" FontWeight="Bold" Foreground="#1B5E20" Margin="0,4,0,8"/>
                        <TextBlock Text="• Cấp Dễ: Cộng trừ các số trong phạm vi 20." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="• Cấp Vừa: Cộng trừ phạm vi 100, nhân chia bảng cửu chương." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="• Cấp Khó: Cộng trừ phạm vi 1000, nhân chia nhẩm với số có 1 chữ số." FontSize="13.5" Foreground="#424242" Margin="4,2"/>

                        <TextBlock Text="🚀 Mẹo tính nhẩm nhanh (Cấp chuyên gia):" FontSize="15" FontWeight="Bold" Foreground="#E65100" Margin="0,12,0,8"/>
                        
                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#3E2723" LineHeight="18">
                                <Run FontWeight="Bold" Foreground="#E65100" Text="» Nhân với 11:"/> Cộng hai chữ số của số cần nhân rồi viết tổng đó vào giữa. (Ví dụ: 35 × 11 = 3 [3+5] 5 = 385).
                            </TextBlock>
                        </Border>

                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#3E2723" LineHeight="18">
                                <Run FontWeight="Bold" Foreground="#E65100" Text="» Nhân với 5:"/> Chia đôi số chẵn rồi nhân 10. (Ví dụ: 84 × 5 = [84÷2] × 10 = 420).
                            </TextBlock>
                        </Border>

                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#3E2723" LineHeight="18">
                                <Run FontWeight="Bold" Foreground="#E65100" Text="» Bình phương đuôi 5:"/> Lấy chữ số hàng chục nhân với số liền sau nó, rồi ghép đuôi 25 vào sau kết quả. (Ví dụ: 35² = [3×4] ghép 25 = 1225).
                            </TextBlock>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: KHU VỰC LUYỆN TÍNH NHẨM -->
                <Grid x:Name="viewWorkspace" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Score bar -->
                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,10,16,10" Margin="0,0,0,16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <TextBlock x:Name="txtScore" Text="Điểm: 0" FontSize="16" FontWeight="Bold" 
                                               Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock x:Name="txtStreak" Text="🔥 0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" 
                                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock x:Name="txtLevel" Text="Level: Dễ" FontSize="16" FontWeight="Bold" Foreground="#388E3C"
                                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                                </StackPanel>
                                
                                <!-- Sound and Reset Buttons -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="btnExport" Content="📥 Xuất CSV" FontSize="13" FontWeight="Bold" Padding="8,4" Height="30" Margin="0,0,8,0"
                                            Foreground="White" BorderThickness="0" Cursor="Hand" Click="ExportCsv_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#475569"/>
                                                <Style.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Style.Resources>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#334155"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="btnReset" Content="🔄 Đặt lại" FontSize="13" FontWeight="Bold" Padding="8,4" Height="30"
                                            Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" Cursor="Hand" Click="ResetAll_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Style.Resources>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#C8E6C9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtTimer" Text="⏱️ 00:00" FontSize="16" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Question area -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="spQuestionArea" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Instruction Card -->
                                <Border x:Name="brdInstructions" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16" Width="480" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#CCCCCC" BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="lblInstrTitle" Text="💡 HƯỚNG DẪN &amp; MẸO TÍNH NHẨM NHANH" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="lblInstrEasy" Text="• Cấp Dễ: Cộng trừ các số trong phạm vi 20." FontSize="14" Foreground="#424242" Margin="0,2"/>
                                        <TextBlock x:Name="lblInstrMedium" Text="• Cấp Vừa: Cộng trừ phạm vi 100, nhân chia bảng cửu chương." FontSize="14" Foreground="#424242" Margin="0,2"/>
                                        <TextBlock x:Name="lblInstrHard" Text="• Cấp Khó: Cộng trừ phạm vi 1000, nhân chia nhẩm với số có 1 chữ số." FontSize="14" Foreground="#424242" Margin="0,2"/>
                                        <TextBlock x:Name="lblInstrExpert" Text="• Cấp Chuyên gia: Áp dụng các mẹo toán học đặc biệt để nhẩm:" FontSize="14" FontWeight="Bold" Foreground="#E65100" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="lblInstrExpert1" Text="  » Nhân với 11: Cộng hai chữ số rồi viết ở giữa (VD: 35 × 11 = 3[8]5 = 385)." FontSize="13" Foreground="#616161" Margin="10,1"/>
                                        <TextBlock x:Name="lblInstrExpert2" Text="  » Nhân với 5: Chia đôi số chẵn rồi nhân 10 (VD: 84 × 5 = 42 × 10 = 420)." FontSize="13" Foreground="#616161" Margin="10,1"/>
                                        <TextBlock x:Name="lblInstrExpert3" Text="  » Bình phương đuôi 5: Lấy số đầu nhân số liền sau rồi ghép 25 (VD: 35² = [3×4]25 = 1225)." FontSize="13" Foreground="#616161" Margin="10,1"/>
                                        <TextBlock x:Name="lblInstrExpert4" Text="  » Bình phương từ 11 đến 30: Phản xạ nhớ nhanh các số chính phương." FontSize="13" Foreground="#616161" Margin="10,1"/>
                                    </StackPanel>
                                </Border>
                                 
                                <!-- Leaderboard Card -->
                                <Border x:Name="brdLeaderboard" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" Width="480" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#CCCCCC" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="lblLeaderboardHeader" Text="🏆 BẢNG VÀNG THÀNH TÍCH (TOP 5)" FontSize="15" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        
                                        <!-- Trạng thái trống -->
                                        <TextBlock x:Name="txtEmptyLeaderboard" Text="Chưa có thành tích nào được ghi nhận. Hãy chơi để chinh phục bảng xếp hạng!" 
                                                   FontSize="14" FontStyle="Italic" Foreground="#9E9E9E" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
                                        
                                        <!-- Bảng hiển thị Top 5 -->
                                        <Grid x:Name="gridLeaderboard">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Headers -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="lblLeaderboardRank" Text="Hạng" FontWeight="Bold" FontSize="13" Foreground="#757575"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblLeaderboardLevel" Text="Cấp độ" FontWeight="Bold" FontSize="13" Foreground="#757575"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="lblLeaderboardScore" Text="Điểm" FontWeight="Bold" FontSize="13" Foreground="#757575"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="lblLeaderboardTime" Text="Thời gian" FontWeight="Bold" FontSize="13" Foreground="#757575"/>
                                            <TextBlock Grid.Row="0" Grid.Column="4" x:Name="lblLeaderboardDate" Text="Ngày lưu" FontWeight="Bold" FontSize="13" Foreground="#757575"/>
                                            
                                            <Border Grid.Row="0" Grid.ColumnSpan="5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,4,0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,10,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock x:Name="txtQuestion" Grid.Row="0" Text="Nhấn 'Bắt đầu' để chơi" FontSize="18" FontWeight="SemiBold" Foreground="#757575"
                                               HorizontalAlignment="Center" Margin="0,0,0,6" TextAlignment="Center"/>
                                    
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock x:Name="txtMathExpr" Text="" FontSize="36" FontWeight="Bold" Foreground="#1B5E20"
                                                   VerticalAlignment="Center" TextAlignment="Center"/>
                                        <Button x:Name="btnHint" Content="💡" FontSize="20" Margin="10,0,0,0" Padding="6,2"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                                Visibility="Collapsed" Click="BtnHint_Click">
                                            <Button.ToolTip>
                                                <ToolTip x:Name="ttHint" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" HasDropShadow="True" Padding="8,6">
                                                    <TextBlock x:Name="txtHintContent" Text="Gợi ý mẹo nhẩm nhanh" FontSize="13" Foreground="#3E2723" FontWeight="Medium" MaxWidth="300" TextWrapping="Wrap"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    
                                    <TextBox x:Name="txtAnswer" Grid.Row="2" FontSize="36" Width="180" Padding="8,4" TextAlignment="Center"
                                             BorderBrush="#81C784" BorderThickness="0,0,0,3" Background="Transparent"
                                             FontWeight="Bold" Visibility="Collapsed" KeyDown="Answer_KeyDown" MaxLength="6"
                                             InputMethod.IsInputMethodEnabled="False"/>

                                    <TextBlock x:Name="txtFeedback" Grid.Row="3" Text="" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                    <TextBlock x:Name="txtMedal" Grid.Row="4" Text="" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button x:Name="btnStart" Content="▶ Bắt đầu" FontSize="16" FontWeight="Bold"
                                    Padding="24,12,24,12" Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="Start_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B5E20"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- SCRATCHPAD PANEL -->
                    <Border x:Name="brdScratchPad" Grid.Column="1" Width="350" Margin="16,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                        </Border.Effect>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header -->
                            <Border Grid.Row="0" Background="#F8FAFC" Padding="12,10" CornerRadius="12,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="❌" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToggleScratchPad_Click" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblScratchTitle" Text="📝 Bảng nháp" FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            
                            <!-- Canvas -->
                            <InkCanvas Grid.Row="1" x:Name="scratchCanvas" EditingMode="Ink">
                                <InkCanvas.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#FAF8F5">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,20,20"/>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing>
                                                    <GeometryDrawing.Pen>
                                                        <Pen Brush="#E2E8F0" Thickness="0.5"/>
                                                    </GeometryDrawing.Pen>
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <LineGeometry StartPoint="0,20" EndPoint="20,20"/>
                                                            <LineGeometry StartPoint="20,0" EndPoint="20,20"/>
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </InkCanvas.Background>
                            </InkCanvas>
                            
                            <!-- Footer controls -->
                            <Border Grid.Row="2" Background="#F8FAFC" Padding="10,8" CornerRadius="0,0,12,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <RadioButton x:Name="radScratchPen" Content="🖊️ Bút" IsChecked="True" Style="{StaticResource ScratchRadioBtn}" Click="ScratchMode_Click" Tag="Pen"/>
                                        <RadioButton x:Name="radScratchEraser" Content="🧽 Tẩy" Style="{StaticResource ScratchRadioBtn}" Click="ScratchMode_Click" Tag="Eraser"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="btnSubmitScratch" Content="📤 Nộp nháp" Margin="0,0,8,0" Padding="8,4" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Cursor="Hand" Click="BtnSubmitScratch_Click" FontSize="12" FontWeight="SemiBold">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="btnClearScratch" Content="🗑️ Xóa nháp" Padding="8,4" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnClearScratch_Click" FontSize="12" FontWeight="SemiBold">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW 3: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
