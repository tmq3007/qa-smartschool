<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Thinking.IqQuizTool"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
                           Background="{StaticResource Gray100}">

    <controls:BaseToolControl.Resources>
        <Style x:Key="ScratchRadioBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumpadBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#AD1457"/>
            <Setter Property="BorderBrush" Value="#F8BBD0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FCE4EC"/>
                    <Setter Property="BorderBrush" Value="#EC407A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F8BBD0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </controls:BaseToolControl.Resources>

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- === HEADER === -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FCE4EC" Offset="0"/>
                    <GradientStop Color="#F8BBD0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblIqMode" Text="Chế độ:" Foreground="#AD1457" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="cboIqMode" Width="120" SelectedIndex="0" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0"/>
                    <TextBlock x:Name="lblIqLevel" Text="Độ khó:" Foreground="#AD1457" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cboIqLevel" Width="140" SelectedIndex="0" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0"/>
                    <Button x:Name="btnIqSound" Content="🔊" Width="36" Height="30" FontSize="16" FontWeight="Bold" 
                            Background="Transparent" BorderThickness="0" Foreground="#AD1457" Cursor="Hand" Click="IqSound_Click"/>
                    <Button x:Name="btnToggleScratchPad" Content="📝 Bảng nháp" Padding="12,6" Margin="10,0,0,0" FontSize="14" FontWeight="Bold" 
                            Background="#AD1457" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnToggleScratchPad_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D81B60"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="txtIqTitle" Text="🧠 Luyện IQ &amp; Logic" FontSize="20" FontWeight="Bold" Foreground="#AD1457"/>
                    <TextBlock x:Name="txtIqSubtitle" Text="Dãy số • Suy luận tương tự • Logic • Phân loại" FontSize="14" Foreground="#EC407A" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#FCE4EC">
                <!-- Thinking Category: Pink hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#F8BBD0"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#AD1457"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧠" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Luyện tập IQ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#F8BBD0"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 1: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#F8BBD0" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#AD1457" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#F8BBD0" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<!-- Ý nghĩa & Lợi ích -->
                        <Border Background="#FCE4EC" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#F8BBD0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 NGUỒN GỐC &amp; LỢI ÍCH CỦA LUYỆN TƯ DUY" FontWeight="Bold" Foreground="#AD1457" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="18">
                                    Giải đố IQ và các bài tập tư duy logic là phương pháp hàng đầu để rèn luyện não bộ. Nó giúp kích thích các bán cầu não, cải thiện tốc độ phản xạ nhận thức, tăng cường khả năng tập trung và củng cố tư duy toán học, hình học không gian cho học sinh.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🛠️ HƯỚNG DẪN 3 BƯỚC THAM GIA THỬ THÁCH" FontWeight="Bold" Foreground="#212121" FontSize="13" Margin="0,4,0,8"/>

                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <Border Background="#AD1457" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="1" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333">
                                    <Run FontWeight="Bold" Text="Chọn Chế độ &amp; Độ khó:"/> Phía trên cùng giao diện, chọn Chế độ chơi (15 câu hoặc Vô hạn) và Độ khó khởi điểm phù hợp (Dễ, Trung bình, Khó, Cực khó).
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <Border Background="#AD1457" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="2" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333">
                                    <Run FontWeight="Bold" Text="Bắt đầu và Trả lời:"/> Bấm nút <Run FontWeight="Bold" Foreground="#AD1457" Text="▶ Bắt đầu"/> bên dưới. Trả lời bằng cách nhập số trực tiếp qua bàn phím hoặc bảng số ảo ảo trực quan trên màn hình. Nhấn phím <Run FontWeight="SemiBold" Text="Enter"/> hoặc nút <Run FontWeight="SemiBold" Text="✔️"/> để gửi câu trả lời.
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,16">
                            <DockPanel>
                                <Border Background="#AD1457" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="3" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333">
                                    <Run FontWeight="Bold" Text="Sử dụng Bảng Nháp:"/> Nếu gặp câu hỏi phức tạp về dãy số hoặc logic, bấm nút <Run FontWeight="Bold" Foreground="#AD1457" Text="📝 Bảng nháp"/> ở góc trên để vẽ nháp bằng bút cảm ứng. Khi hoàn thành trò chơi, bạn có thể xem biểu đồ tiến trình năng lực và kỷ lục của mình!
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: KHU VỰC LUYỆN TẬP IQ -->
                <Grid x:Name="viewWorkspace" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,10" Margin="0,0,0,12" BorderBrush="#F8BBD0" BorderThickness="1">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtIqScore" Text="Điểm: 0/0" FontSize="18" FontWeight="Bold" Foreground="#AD1457" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtIqSyncStatus" Text="☁️ Trực tuyến" FontSize="12" Foreground="#4CAF50" FontWeight="SemiBold" Margin="12,2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="spIqLives" Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="lblIqLives" Text="Mạng: " FontSize="14" FontWeight="SemiBold" Foreground="#EC407A" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtIqLives" Text="❤️❤️❤️" FontSize="16" Foreground="#E91E63" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="ttIqLives" X="0" Y="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" x:Name="txtIqProgress" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#757575" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtIqCurrentLevel" Text="🟢 Cấp độ: Dễ" FontSize="14" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="spIqQuestionArea" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
                                <TextBlock x:Name="txtIqQuestion" Text="Nhấn 'Bắt đầu' để chơi" FontSize="22" FontWeight="Bold" Foreground="#212121"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock x:Name="txtIqSequence" Text="" FontSize="36" FontWeight="Bold" Foreground="#1A237E"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                                <TextBox x:Name="txtIqAnswer" FontSize="28" Width="250" Padding="12,8" TextAlignment="Center"
                                         BorderBrush="#F48FB1" BorderThickness="0,0,0,3" Background="Transparent"
                                         FontWeight="SemiBold" Visibility="Collapsed" KeyDown="IqAnswer_KeyDown" MaxLength="30"
                                         InputMethod.IsInputMethodEnabled="False"/>

                                <UniformGrid x:Name="grdIqNumpad" Columns="3" Width="220" Margin="0,15,0,0" Visibility="Collapsed" HorizontalAlignment="Center">
                                    <Button Content="7" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="7"/>
                                    <Button Content="8" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="8"/>
                                    <Button Content="9" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="9"/>
                                    
                                    <Button Content="4" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="4"/>
                                    <Button Content="5" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="5"/>
                                    <Button Content="6" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="6"/>
                                    
                                    <Button Content="1" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="1"/>
                                    <Button Content="2" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="2"/>
                                    <Button Content="3" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="3"/>
                                    
                                    <Button Content="❌" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="Backspace" ToolTip="Xóa lùi"/>
                                    <Button Content="0" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="0"/>
                                    <Button Content="✔️" Style="{StaticResource NumpadBtnStyle}" Click="Numpad_Click" Tag="Enter" ToolTip="Xác nhận"/>
                                </UniformGrid>

                                <StackPanel x:Name="mcIqPanel" HorizontalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Vùng kết quả cuối game: Biểu đồ & Bảng xếp hạng -->
                                <WrapPanel x:Name="spIqEndGame" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10" Visibility="Collapsed">
                                    <!-- Biểu đồ tiến trình thích ứng -->
                                    <Border x:Name="brdIqChart" Width="480" Height="220" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" 
                                            CornerRadius="8" Margin="0,0,16,0" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Canvas x:Name="cvsIqChart" Background="Transparent"/>
                                        </Grid>
                                    </Border>

                                    <!-- Bảng xếp hạng kỷ lục Top 5 -->
                                    <Border x:Name="brdIqLeaderboard" Width="360" Height="220" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" 
                                            CornerRadius="8" Padding="12,8" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="txtIqLeaderboardHeader" Text="🏆 Kỷ Lục Cá Nhân (Top 5)" FontSize="13" FontWeight="Bold" Foreground="#AD1457" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                            <ListView x:Name="lsvIqLeaderboard" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Độ khó" Width="80" DisplayMemberBinding="{Binding Difficulty}"/>
                                                        <GridViewColumn Header="Điểm" Width="60" DisplayMemberBinding="{Binding ScoreDisplay}"/>
                                                        <GridViewColumn Header="Thời gian" Width="70" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                                        <GridViewColumn Header="Ngày chơi" Width="110" DisplayMemberBinding="{Binding DateDisplay}"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                            <TextBlock x:Name="txtIqLeaderboardEmpty" Grid.Row="1" Text="Chưa có kỷ lục nào. Hãy chơi để ghi nhận!" FontSize="12" Foreground="#9E9E9E" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </WrapPanel>

                                <TextBlock x:Name="txtIqFeedback" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button x:Name="btnIqStart" Content="▶ Bắt đầu (15 câu)" FontSize="16"
                                    Padding="24,12,24,12" Background="#AD1457" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="IqStart_Click"/>
                            <Button x:Name="btnIqExportPdf" Content="📄 Xuất báo cáo PDF" FontSize="16"
                                    Padding="24,12,24,12" Background="#0288D1" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Margin="12,0,0,0" Visibility="Collapsed" Click="BtnIqExportPdf_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- SCRATCHPAD PANEL -->
                    <Border x:Name="brdScratchPad" Grid.Column="1" Width="350" Margin="16,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                        </Border.Effect>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header -->
                            <Border Grid.Row="0" Background="#F8FAFC" Padding="12,10" CornerRadius="12,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="❌" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToggleScratchPad_Click" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblScratchTitle" Text="📝 Bảng nháp" FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            
                            <!-- Canvas -->
                            <InkCanvas Grid.Row="1" x:Name="scratchCanvas" EditingMode="Ink">
                                <InkCanvas.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#FAF8F5">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,20,20"/>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing>
                                                    <GeometryDrawing.Pen>
                                                        <Pen Brush="#E2E8F0" Thickness="0.5"/>
                                                    </GeometryDrawing.Pen>
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <LineGeometry StartPoint="0,20" EndPoint="20,20"/>
                                                            <LineGeometry StartPoint="20,0" EndPoint="20,20"/>
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </InkCanvas.Background>
                            </InkCanvas>
                            
                            <!-- Footer controls -->
                            <Border Grid.Row="2" Background="#F8FAFC" Padding="10,8" CornerRadius="0,0,12,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <RadioButton x:Name="radScratchPen" Content="🖊️ Bút" IsChecked="True" Style="{StaticResource ScratchRadioBtn}" Click="ScratchMode_Click" Tag="Pen"/>
                                        <RadioButton x:Name="radScratchEraser" Content="🧽 Tẩy" Style="{StaticResource ScratchRadioBtn}" Click="ScratchMode_Click" Tag="Eraser"/>
                                        <StackPanel x:Name="spScratchColors" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Button x:Name="btnColorBlack" Width="18" Height="18" Margin="2,0" Background="Black" BorderThickness="1" BorderBrush="#CBD5E1" Click="ScratchColor_Click" Tag="#000000" ToolTip="Màu Đen">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button x:Name="btnColorBlue" Width="18" Height="18" Margin="2,0" Background="#2196F3" BorderThickness="1" BorderBrush="#CBD5E1" Click="ScratchColor_Click" Tag="#2196F3" ToolTip="Màu Xanh Dương">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button x:Name="btnColorRed" Width="18" Height="18" Margin="2,0" Background="#F44336" BorderThickness="1" BorderBrush="#CBD5E1" Click="ScratchColor_Click" Tag="#F44336" ToolTip="Màu Đỏ">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button x:Name="btnColorGreen" Width="18" Height="18" Margin="2,0" Background="#4CAF50" BorderThickness="1" BorderBrush="#CBD5E1" Click="ScratchColor_Click" Tag="#4CAF50" ToolTip="Màu Xanh Lá">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="btnSubmitScratch" Content="📤 Nộp nháp" Margin="0,0,8,0" Padding="8,4" Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0" Cursor="Hand" Click="BtnSubmitScratch_Click" FontSize="12" FontWeight="SemiBold">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="btnClearScratch" Content="🗑️ Xóa nháp" Padding="8,4" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnClearScratch_Click" FontSize="12" FontWeight="SemiBold">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW 3: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Toast thông báo thăng cấp/giảm cấp độ khó -->
        <Border x:Name="brdIqToast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                Background="#E1F5FE" BorderBrush="#0288D1" BorderThickness="1.5" CornerRadius="20" 
                Padding="24,12" Margin="0,0,0,100" IsHitTestVisible="False" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ttIqToast" Y="30"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtIqToastIcon" Text="📈" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtIqToastMsg" Text="Tăng độ khó!" FontSize="16" FontWeight="Bold" Foreground="#01579B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Canvas Confetti dùng chung cho ăn mừng mốc điểm -->
        <Canvas x:Name="cvsIqConfetti" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Background="Transparent"/>
    </Grid>
</controls:BaseToolControl>
