<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Thinking.SudokuTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">
             
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FCE4EC" Offset="0"/>
                    <GradientStop Color="#F8BBD0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#880E4F" CornerRadius="8" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="NewGame_Click" ToolTip="Bắt đầu ván mới">
                        <TextBlock Text="🔄 Ván mới" FontSize="14" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{StaticResource BrandPrimary}" CornerRadius="8" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="Hint_Click" ToolTip="Gợi ý 1 ô">
                        <TextBlock Text="💡 Gợi ý" FontSize="14" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#2E7D32" CornerRadius="8" Padding="14,8" Cursor="Hand"
                            MouseLeftButtonDown="Check_Click" ToolTip="Kiểm tra đáp án">
                        <TextBlock Text="✅ Kiểm tra" FontSize="14" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="🧩 Sudoku – Tư Duy Logic" FontSize="20" FontWeight="Bold" Foreground="#880E4F"/>
                    <TextBlock Text="Mọi cấp • 4×4, 6×6, 9×9 • Gợi ý, kiểm tra" FontSize="13" Foreground="#AD1457" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#FCE4EC">
                <!-- Thinking Category: Pink hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#F8BBD0"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#AD1457"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPlay" Text="Trò chơi Sudoku" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#F8BBD0"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 1: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#F8BBD0" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#AD1457" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#F8BBD0" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<!-- Khối ý nghĩa -->
                        <Border Background="#FCE4EC" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#F8BBD0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Ý NGHĨA CỦA TRÒ CHƠI SUDOKU" FontWeight="Bold" Foreground="#880E4F" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="18">
                                    Sudoku là trò chơi câu đố sắp xếp số theo logic kinh điển. Nó giúp học sinh phát triển khả năng tập trung, tư duy phân tích, suy luận logic và khả năng kiên trì giải quyết các vấn đề phức tạp.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🛠️ QUY TẮC CHƠI CƠ BẢN" FontWeight="Bold" Foreground="#212121" FontSize="14" Margin="0,4,0,8"/>

                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333" LineHeight="18">
                                <Run FontWeight="Bold" Foreground="#880E4F" Text="• Quy tắc chung:"/> Điền các số từ 1 đến N (với N là kích thước bảng 4, 6 hoặc 9) vào các ô trống sao cho mỗi số chỉ xuất hiện đúng một lần duy nhất trên mỗi hàng ngang, mỗi cột dọc và mỗi ô vuông nhỏ (vùng con).
                            </TextBlock>
                        </Border>

                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333" LineHeight="18">
                                <Run FontWeight="Bold" Foreground="#880E4F" Text="• Chọn kích thước bảng:"/> Bên cột phải tab Trò chơi, bạn có thể chọn kích thước bảng phù hợp: 
                                <LineBreak/>» <Run FontWeight="Bold" Text="4 × 4"/> (Dễ, chia làm 4 vùng con 2×2)
                                <LineBreak/>» <Run FontWeight="Bold" Text="6 × 6"/> (Trung bình, chia làm 6 vùng con 2×3)
                                <LineBreak/>» <Run FontWeight="Bold" Text="9 × 9"/> (Khó, chia làm 9 vùng con 3×3)
                            </TextBlock>
                        </Border>

                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333" LineHeight="18">
                                <Run FontWeight="Bold" Foreground="#880E4F" Text="• Thao tác chơi:"/> Nhấp chuột vào ô trống bất kỳ trên bảng lưới, sau đó gõ số tương ứng từ bàn phím hoặc nhấn vào bảng số ảo trực quan ở bên phải màn hình.
                            </TextBlock>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: TRÒ CHƠI SUDOKU -->
                <Grid x:Name="viewWorkspace" Visibility="Collapsed" MaxWidth="1100" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sudoku grid – centered, fills available space -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0"
                            BorderBrush="#880E4F" BorderThickness="2.5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid x:Name="sudokuGrid"/>
                            </Viewbox>
                            <Canvas x:Name="confettiCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <!-- Right panel – controls & status wrapped in ScrollViewer to prevent overflow and center vertically -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <StackPanel Margin="0,10,0,10">
                            <!-- Size selector -->
                            <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📐 Kích thước bảng" FontSize="15" FontWeight="Bold" 
                                               Foreground="#424242" Margin="0,0,0,10"/>
                                    <StackPanel>
                                        <RadioButton x:Name="rb4" Content="  4 × 4  (Dễ)" GroupName="size" 
                                                     Margin="0,0,0,6" FontSize="14" FontWeight="Bold"
                                                     Checked="Size_Changed"/>
                                        <RadioButton x:Name="rb6" Content="  6 × 6  (Trung bình)" GroupName="size" 
                                                     Margin="0,0,0,6" FontSize="14" FontWeight="Bold"
                                                     Checked="Size_Changed"/>
                                        <RadioButton x:Name="rb9" Content="  9 × 9  (Khó)" GroupName="size" 
                                                     IsChecked="True" FontSize="14" FontWeight="Bold"
                                                     Checked="Size_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Status -->
                            <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="txtStatus" Text="🎮 Sẵn sàng" FontSize="18" 
                                               FontWeight="Bold" Foreground="#880E4F" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtProgress" Text="" FontSize="14" 
                                               FontWeight="SemiBold" Foreground="#757575" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Number pad for quick input -->
                            <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🔢 Nhập nhanh" FontSize="15" FontWeight="Bold" 
                                               Foreground="#424242" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="numPad" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Tips -->
                            <Border Background="#FFF3E0" CornerRadius="10" Padding="16,12"
                                    BorderBrush="#FFE0B2" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💡 Hướng dẫn" FontSize="15" FontWeight="Bold" 
                                               Foreground="{StaticResource BrandAccent}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="tipRow" Text="• Mỗi hàng: số 1-N không lặp" FontSize="13" 
                                               FontWeight="SemiBold" Foreground="#795548" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="tipCol" Text="• Mỗi cột: số 1-N không lặp" FontSize="13" 
                                               FontWeight="SemiBold" Foreground="#795548" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="tipBox" Text="• Mỗi ô vuông nhỏ: số 1-N không lặp" FontSize="13" 
                                               FontWeight="SemiBold" Foreground="#795548" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Click ô trống → nhập số hoặc bấm numpad" FontSize="13" 
                                               FontWeight="SemiBold" Foreground="#795548" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Info panel for additional content -->
                            <StackPanel x:Name="infoPanel" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 3: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
