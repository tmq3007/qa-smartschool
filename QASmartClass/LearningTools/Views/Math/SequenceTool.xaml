<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.SequenceTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER (Gradient + Reset) ═══ -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E0F2F1" Offset="0"/>
                    <GradientStop Color="#B2DFDB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="📊 Cấp Số Cộng &amp; Cấp Số Nhân" FontSize="20" FontWeight="Bold" Foreground="#00695C"/>
                <TextBlock Text="Lớp 11 • Tính số hạng tổng quát Uₙ, tổng Sₙ và biểu diễn đồ thị trực quan" FontSize="14" Foreground="#00796B" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E0F2F1">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextAP" Text="Cấp số cộng" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✖️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGP" Text="Cấp số nhân" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#B2DFDB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C5CAE9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C5CAE9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: CẤP SỐ CỘNG -->
                <ScrollViewer x:Name="viewAP" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Input & Presets -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Input Section -->
                            <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#B2DFDB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,12">
                                        <Run Text="Uₙ = U₁ + (n-1)d    Sₙ = n(U₁+Uₙ)/2"/>
                                    </TextBlock>
                                    <TextBlock Text="📝 Chọn bài toán và nhập thông số" FontSize="15" FontWeight="Bold" Foreground="#757575" Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,0,0,16">
                                        <ComboBox x:Name="cbAP_Mode" FontSize="15" Padding="8,6" SelectionChanged="APMode_SelectionChanged" SelectedIndex="0">
                                            <ComboBoxItem Content="Tìm Uₙ và Sₙ (Bài toán xuôi)"/>
                                            <ComboBoxItem Content="Tìm U₁ khi biết d, n, Uₙ"/>
                                            <ComboBoxItem Content="Tìm U₁ khi biết d, n, Sₙ"/>
                                            <ComboBoxItem Content="Tìm công sai d khi biết U₁, n, Uₙ"/>
                                            <ComboBoxItem Content="Tìm công sai d khi biết U₁, n, Sₙ"/>
                                            <ComboBoxItem Content="Tìm số số hạng n khi biết U₁, d, Uₙ"/>
                                            <ComboBoxItem Content="Tìm số số hạng n khi biết U₁, d, Sₙ"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="borderAP_U1" Grid.Row="0" Grid.Column="0" Background="#E0F2F1" CornerRadius="12" Padding="12,8" Margin="0,0,8,10">
                                            <StackPanel>
                                                <TextBlock Text="U₁" FontSize="16" FontWeight="Bold" Foreground="#00695C"/>
                                                <TextBox x:Name="txtAP_U1" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="AP_Changed" Text="3"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="borderAP_D" Grid.Row="0" Grid.Column="1" Background="#E0F2F1" CornerRadius="12" Padding="12,8" Margin="0,0,8,10">
                                            <StackPanel>
                                                <TextBlock Text="d (công sai)" FontSize="16" FontWeight="Bold" Foreground="#00897B"/>
                                                <TextBox x:Name="txtAP_D" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="AP_Changed" Text="5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="borderAP_N" Grid.Row="0" Grid.Column="2" Background="#E0F2F1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="n (số số hạng)" FontSize="16" FontWeight="Bold" Foreground="#00796B"/>
                                                <TextBox x:Name="txtAP_N" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="AP_Changed" Text="10"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="borderAP_Un" Grid.Row="1" Grid.Column="0" Background="#E0F2F1" CornerRadius="12" Padding="12,8" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Uₙ (số hạng thứ n)" FontSize="16" FontWeight="Bold" Foreground="#00695C"/>
                                                <TextBox x:Name="txtAP_Un" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="AP_Changed" Text="48"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="borderAP_Sn" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#E0F2F1" CornerRadius="12" Padding="12,8" Margin="0,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Sₙ (tổng n số hạng đầu)" FontSize="16" FontWeight="Bold" Foreground="#00897B"/>
                                                <TextBox x:Name="txtAP_Sn" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="AP_Changed" Text="255"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="⚡ Ví dụ nhanh" FontSize="16" FontWeight="SemiBold" Foreground="#00695C" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="apPresetPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Quiz -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#B2DFDB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="✏️ Tự luyện tập (Quiz)" FontSize="16" FontWeight="SemiBold" Foreground="#00695C" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="lblAP_QuizQuestion" Text="Câu hỏi đang tải..." FontSize="14" TextWrapping="Wrap" Foreground="#37474F" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                            <TextBox x:Name="txtAP_QuizAnswer" FontSize="16" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="Kiểm tra" Background="#00695C" Foreground="White" FontWeight="Bold" Padding="8,4" Click="APQuizCheck_Click" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                        <Button Content="Đề mới" Background="Transparent" Foreground="#00796B" BorderThickness="0" Cursor="Hand" Click="APQuizNew_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblAP_QuizFeedback" Text="" FontSize="14" FontWeight="Bold" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- History -->
                            <Border x:Name="borderAP_History" Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🕒 Lịch sử tính toán" FontSize="16" FontWeight="SemiBold" Foreground="#00695C" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="apHistoryPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Results & Graph -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#B2DFDB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✅ Kết quả tính toán" FontSize="18" FontWeight="Bold" Foreground="#00897B"/>
                                        <Button Grid.Column="1" Content="📤 Xuất bài giải" Background="Transparent" Foreground="#00796B" BorderThickness="0" Cursor="Hand" Click="APExport_Click" FontSize="14" FontWeight="SemiBold"/>
                                    </Grid>
                                    <StackPanel x:Name="apResultPanel"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#E0F2F1" CornerRadius="14" Padding="16,12" Margin="0,0,0,0" Cursor="Hand" MouseLeftButtonDown="OpenGraph_AP" BorderBrush="#80CBC4" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị" FontSize="16" FontWeight="Bold" Foreground="#00695C"/>
                                        <TextBlock Text="Uₙ = U₁ + (n−1)d – biểu diễn các điểm thẳng hàng" FontSize="14" Foreground="#00897B"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <!-- Close AP ScrollViewer -->
            </Grid>

            <!-- VIEW 2: CẤP SỐ NHÂN -->
            <ScrollViewer x:Name="viewGP" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Grid.Column="2" Margin="16">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Input & Presets -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <!-- Input Section -->
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#FFCCBC" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <TextBlock FontSize="22" FontWeight="Bold" Foreground="#BF360C" Margin="0,0,0,12">
                                    <Run Text="Uₙ = U₁·qⁿ⁻¹    Sₙ = U₁(qⁿ-1)/(q-1)"/>
                                </TextBlock>
                                <TextBlock Text="📝 Chọn bài toán và nhập thông số" FontSize="15" FontWeight="Bold" Foreground="#757575" Margin="0,0,0,12"/>
                                <StackPanel Margin="0,0,0,16">
                                    <ComboBox x:Name="cbGP_Mode" FontSize="15" Padding="8,6" SelectionChanged="GPMode_SelectionChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Tìm Uₙ và Sₙ (Bài toán xuôi)"/>
                                        <ComboBoxItem Content="Tìm U₁ khi biết q, n, Uₙ"/>
                                        <ComboBoxItem Content="Tìm U₁ khi biết q, n, Sₙ"/>
                                        <ComboBoxItem Content="Tìm công bội q khi biết U₁, n, Uₙ"/>
                                        <ComboBoxItem Content="Tìm công bội q khi biết U₁, n, Sₙ"/>
                                        <ComboBoxItem Content="Tìm số số hạng n khi biết U₁, q, Uₙ"/>
                                        <ComboBoxItem Content="Tìm số số hạng n khi biết U₁, q, Sₙ"/>
                                    </ComboBox>
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="borderGP_U1" Grid.Row="0" Grid.Column="0" Background="#FBE9E7" CornerRadius="12" Padding="12,8" Margin="0,0,8,10">
                                        <StackPanel>
                                            <TextBlock Text="U₁" FontSize="16" FontWeight="Bold" Foreground="#BF360C"/>
                                            <TextBox x:Name="txtGP_U1" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="GP_Changed" Text="2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="borderGP_Q" Grid.Row="0" Grid.Column="1" Background="#FBE9E7" CornerRadius="12" Padding="12,8" Margin="0,0,8,10">
                                        <StackPanel>
                                            <TextBlock Text="q (công bội)" FontSize="16" FontWeight="Bold" Foreground="#D84315"/>
                                            <TextBox x:Name="txtGP_Q" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="GP_Changed" Text="3"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="borderGP_N" Grid.Row="0" Grid.Column="2" Background="#FBE9E7" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="n (số số hạng)" FontSize="16" FontWeight="Bold" Foreground="#E64A19" />
                                            <TextBox x:Name="txtGP_N" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="GP_Changed" Text="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="borderGP_Un" Grid.Row="1" Grid.Column="0" Background="#FBE9E7" CornerRadius="12" Padding="12,8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Uₙ (số hạng thứ n)" FontSize="16" FontWeight="Bold" Foreground="#BF360C"/>
                                            <TextBox x:Name="txtGP_Un" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="GP_Changed" Text="4374"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="borderGP_Sn" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#FBE9E7" CornerRadius="12" Padding="12,8" Margin="0,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Sₙ (tổng n số hạng đầu)" FontSize="16" FontWeight="Bold" Foreground="#D84315"/>
                                            <TextBox x:Name="txtGP_Sn" FontSize="18" Padding="6,4" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="GP_Changed" Text="6560"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Presets -->
                        <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="⚡ Ví dụ nhanh" FontSize="16" FontWeight="SemiBold" Foreground="#BF360C" Margin="0,0,0,12"/>
                                <WrapPanel x:Name="gpPresetPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Quiz -->
                        <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#FFCCBC" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="✏️ Tự luyện tập (Quiz)" FontSize="16" FontWeight="SemiBold" Foreground="#BF360C" Margin="0,0,0,10"/>
                                <TextBlock x:Name="lblGP_QuizQuestion" Text="Câu hỏi đang tải..." FontSize="14" TextWrapping="Wrap" Foreground="#37474F" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                        <TextBox x:Name="txtGP_QuizAnswer" FontSize="16" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Kiểm tra" Background="#BF360C" Foreground="White" FontWeight="Bold" Padding="8,4" Click="GPQuizCheck_Click" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <Button Content="Đề mới" Background="Transparent" Foreground="#E64A19" BorderThickness="0" Cursor="Hand" Click="GPQuizNew_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="lblGP_QuizFeedback" Text="" FontSize="14" FontWeight="Bold" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- History -->
                        <Border x:Name="borderGP_History" Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🕒 Lịch sử tính toán" FontSize="16" FontWeight="SemiBold" Foreground="#BF360C" Margin="0,0,0,12"/>
                                <WrapPanel x:Name="gpHistoryPanel"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#FFCCBC" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✅ Kết quả tính toán" FontSize="18" FontWeight="Bold" Foreground="#D84315"/>
                                    <Button Grid.Column="1" Content="📤 Xuất bài giải" Background="Transparent" Foreground="#E64A19" BorderThickness="0" Cursor="Hand" Click="GPExport_Click" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <StackPanel x:Name="gpResultPanel"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FBE9E7" CornerRadius="14" Padding="16,12" Margin="0,0,0,0" Cursor="Hand" MouseLeftButtonDown="OpenGraph_GP" BorderBrush="#FFAB91" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Xem đồ thị" FontSize="16" FontWeight="Bold" Foreground="#BF360C"/>
                                    <TextBlock Text="Uₙ = U₁·qⁿ⁻¹ – biểu diễn các điểm theo hàm mũ" FontSize="14" Foreground="#D84315"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- VIEW 3: PRACTICAL APPLICATIONS -->
            <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Visibility="Collapsed" Grid.Column="2" Margin="16">
                <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
            </Border>
        </Grid>
    </Grid>
</controls:BaseToolControl>
