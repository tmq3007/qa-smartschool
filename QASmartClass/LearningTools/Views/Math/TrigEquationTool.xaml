<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.TrigEquationTool"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
              Background="#F5F5FA">
    <Grid x:Name="mainGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border x:Name="headerBorder" Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="12,12,12,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4A148C" Offset="0"/>
                    <GradientStop Color="#7B1FA2" Offset="0.5"/>
                    <GradientStop Color="#9C27B0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="📐 Giải Phương Trình Lượng Giác" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="5 dạng: Cơ bản • sin(kx+f)=a • Bậc 2 • a·sinx+b·cosx=c • Tích – Graph" 
                           FontSize="11" Foreground="#CE93D8" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ CONTENT AREA WITH TABS ═══ -->
        <!-- CONTENT AREA WITH SIDEBAR -->
        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR MENU (Trig Equation/Purple themed) -->
            <Border Grid.Column="0" Background="White" CornerRadius="14" Margin="0,0,12,0" Padding="8,12"
                    BorderBrush="#E1BEE7" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>

                <!-- Math Category: Blue hover/selected -->
                <Border.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Border.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Tính toán &amp; Ví dụ" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn chi tiết" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- SEPARATOR -->
            <Border Grid.Column="1" Background="#E0E0E0" Margin="0,0,12,0"/>

            <!-- TAB CONTENTS -->
            <Grid Grid.Column="2">
                <!-- Tab 1 Content: Calculator -->
                <ScrollViewer x:Name="contentCalc" VerticalScrollBarVisibility="Auto" Padding="0" Visibility="Visible">
                    <StackPanel Margin="0,4,0,0">
                        <!-- CHỌN DẠNG PT -->
                        <TextBlock Text="👉 Chọn dạng phương trình" FontSize="14" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="typePanel" Margin="0,0,0,16"/>

                        <!-- NHẬP + KẾT QUẢ -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- LEFT -->
                            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,8,0"
                                    BorderBrush="#E1BEE7" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="txtInputTitle" Text="📝 Nhập" FontSize="16" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,12"/>
                                    <!-- Dynamic: funcPanel for basic, inputPanel for advanced -->
                                    <WrapPanel x:Name="funcPanel" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="inputPanel"/>
                                    <TextBlock Text="⚡ Ví dụ nhanh" FontSize="14" FontWeight="SemiBold" Foreground="#757575" Margin="0,12,0,8"/>
                                    <WrapPanel x:Name="presetPanel"/>
                                </StackPanel>
                            </Border>
                            <!-- RIGHT -->
                            <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="24,20" Margin="8,0,0,0"
                                    BorderBrush="#E1BEE7" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="✅ Nghiệm" FontSize="16" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,12"/>
                                    <Border x:Name="resultCard" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" Background="#F3E5F5">
                                        <StackPanel>
                                            <TextBlock x:Name="txtResultLabel" Text="Nghiệm tổng quát" FontSize="12" Foreground="#757575"/>
                                            <TextBlock x:Name="txtResult" Text="" FontSize="16" FontWeight="Bold" Foreground="#4A148C"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="24"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="specialCard" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" Background="#E8F5E9">
                                        <StackPanel>
                                            <TextBlock Text="✅ Nghiệm trong [0; 2π)" FontSize="12" Foreground="#2E7D32"/>
                                            <TextBlock x:Name="txtSpecial" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#1B5E20"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="condCard" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" Background="#FFF3E0">
                                        <TextBlock x:Name="txtCondition" Text="" FontSize="14" Foreground="{StaticResource BrandAccent}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Background="#E3F2FD" CornerRadius="12" Padding="12,10" Cursor="Hand"
                                            MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📈" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Xem đồ thị" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                                <TextBlock Text="Hàm lượng giác + nghiệm" FontSize="12" Foreground="#1976D2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- BƯỚC GIẢI -->
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#E3E8EE" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📐 Giải chi tiết" FontSize="16" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,12"/>
                                <StackPanel x:Name="stepsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- LÝ THUYẾT -->
                        <Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#E3E8EE" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📐 Công thức lượng giác" FontSize="16" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,12"/>
                                <StackPanel x:Name="theoryPanel"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 2 Content: Instructions -->
                <ScrollViewer x:Name="contentGuide" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Center" Margin="8">
                        <!-- Guide Title Card -->
                        <Border Background="#F3E5F5" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E1BEE7" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="txtTitleGuide" Text="📖 Hướng Dẫn Sử Dụng Chi Tiết &amp; Dữ Liệu Mẫu" FontSize="18" FontWeight="Bold" Foreground="#7B1FA2"/>
                                <TextBlock x:Name="txtSubtitleGuide" Text="Quy trình đơn giản giúp giáo viên giảng dạy và học sinh tự học phương trình lượng giác hiệu quả." FontSize="13" Foreground="#8E24AA" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.8*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Steps (Timeline layout) -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="🗺️ Quy trình tự học" FontSize="15" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,10"/>
                                
                                <!-- Step 1 -->
                                <Border Background="#FDF8FF" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F3E5F5" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#7B1FA2" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="step1Title" Text="Chọn dạng phương trình" FontWeight="Bold" FontSize="14" Foreground="#4A148C" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="step1Desc" Text="Chọn 1 trong 5 dạng phương trình lượng giác phổ thông trên thanh lựa chọn đầu tiên." FontSize="13" Foreground="#555555" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 2 -->
                                <Border Background="#FDF8FF" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F3E5F5" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#7B1FA2" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="step2Title" Text="Nhập hệ số hoặc chọn ví dụ nhanh" FontWeight="Bold" FontSize="14" Foreground="#4A148C" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="step2Desc" Text="Nhập hệ số trực tiếp hoặc click vào nút 'Ví dụ nhanh' để nạp ngay đề bài mẫu bám sát đề thi." FontSize="13" Foreground="#555555" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 3 -->
                                <Border Background="#FDF8FF" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F3E5F5" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#7B1FA2" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="step3Title" Text="Kiểm tra điều kiện &amp; Nghiệm" FontWeight="Bold" FontSize="14" Foreground="#4A148C" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="step3Desc" Text="Đọc kỹ điều kiện có nghiệm (thẻ màu cam), tập nghiệm tổng quát (thẻ màu tím) và nghiệm thuộc [0; 2π) (thẻ màu xanh)." FontSize="13" Foreground="#555555" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 4 -->
                                <Border Background="#FDF8FF" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F3E5F5" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#7B1FA2" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="step4Title" Text="Xem giải chi tiết &amp; Đồ thị" FontWeight="Bold" FontSize="14" Foreground="#4A148C" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="step4Desc" Text="Nhấp chuột vào 'Xem giải chi tiết' để học phương pháp biến đổi và 'Xem đồ thị' để đối chiếu hình học trực quan." FontSize="13" Foreground="#555555" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Right: Guide Details / Sample Data Table -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="📊 Bảng Dữ Liệu Mẫu &amp; Ví Dụ Minh Họa" FontSize="15" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,10"/>
                                
                                <Border Background="White" CornerRadius="12" BorderBrush="#E1BEE7" BorderThickness="1" Padding="16">
                                    <StackPanel>
                                        <!-- Dạng 1 -->
                                        <Border Background="#FDF8FF" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="📐 Dạng 1: Cơ bản (sin x = -0.5)" FontWeight="Bold" FontSize="13" Foreground="#4A148C"/>
                                                <TextBlock Text="• Đầu vào: Dạng Cơ bản, Hàm sin, giá trị a = -0.5" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Tập nghiệm: x = -π/6 + k2π và x = 7π/6 + k2π (k∈ℤ)" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dạng 2 -->
                                        <Border Background="#FDF8FF" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="🔄 Dạng 2: Chứa pha (sin(2x + π/3) = 0.5)" FontWeight="Bold" FontSize="13" Foreground="#4A148C"/>
                                                <TextBlock Text="• Đầu vào: Dạng Mở rộng, k = 2, φ = 1.0472 (π/3), a = 0.5" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Tập nghiệm: x = -π/12 + kπ và x = π/4 + kπ (k∈ℤ)" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dạng 3 -->
                                        <Border Background="#FDF8FF" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="📊 Dạng 3: Bậc hai lượng giác (2sin²x - 3sinx + 1 = 0)" FontWeight="Bold" FontSize="13" Foreground="#4A148C"/>
                                                <TextBlock Text="• Đầu vào: Dạng Bậc 2, Hệ số a = 2, b = -3, c = 1" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Tập nghiệm: x = π/2 + k2π, x = π/6 + k2π, x = 5π/6 + k2π (k∈ℤ)" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dạng 4 -->
                                        <Border Background="#FDF8FF" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="➕ Dạng 4: Bậc nhất sin và cos (sinx + √3·cosx = 1)" FontWeight="Bold" FontSize="13" Foreground="#4A148C"/>
                                                <TextBlock Text="• Đầu vào: Dạng Tổng hợp, Hệ số a = 1, b = 1.7321 (√3), c = 1" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Tập nghiệm: x = -π/6 + k2π và x = π/2 + k2π (k∈ℤ)" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dạng 5 -->
                                        <Border Background="#FDF8FF" CornerRadius="8" Padding="10" Margin="0,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="✖️ Dạng 5: Tích lượng giác (sinx · cosx = 0.25)" FontWeight="Bold" FontSize="13" Foreground="#4A148C"/>
                                                <TextBlock Text="• Đầu vào: Dạng Tích, Hệ số a = 0.25" FontSize="13" Foreground="#666666" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Tập nghiệm: x = π/12 + kπ và x = 5π/12 + kπ (k∈ℤ)" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 3 Content: Practical Applications -->
                <Border x:Name="viewPractical" Visibility="Collapsed" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="20">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
        <!-- Invisible elements to maintain 100% compatibility with unit tests -->
        <Grid Visibility="Collapsed">
            <Border x:Name="tabCalc" Tag="calc"><TextBlock x:Name="tabCalcText"/></Border>
            <Border x:Name="tabGuide" Tag="guide"><TextBlock x:Name="tabGuideText"/></Border>
            <Border x:Name="tabApp" Tag="app"><TextBlock x:Name="tabAppText"/></Border>
        </Grid>
    </Grid>
</controls:BaseToolControl>