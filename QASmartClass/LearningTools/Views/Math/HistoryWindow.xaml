<Window x:Class="QASmartClass.LearningTools.Views.Math.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📖 Lịch Sử Đạo Hàm" Height="520" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📜 Lịch Sử Phát Triển Của Đạo Hàm" FontSize="22" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16" HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🍎 Isaac Newton (1642 - 1727)" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,6"/>
                        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#212121" LineHeight="20">
                            Nhà vật lý và toán học vĩ đại người Anh. Ông phát minh ra giải tích (ông gọi là &quot;phương pháp thông lượng&quot; - fluxions) từ nhu cầu giải quyết các bài toán vật lý, tiêu biểu là tính toán vận tốc tức thời (đạo hàm của quãng đường theo thời gian) và gia tốc của các thiên thể trong vũ trụ.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="✍️ Gottfried Wilhelm Leibniz (1646 - 1716)" FontSize="16" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,6"/>
                        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#212121" LineHeight="20">
                            Nhà triết học và toán học vĩ đại người Đức. Leibniz độc lập phát minh ra giải tích cùng thời điểm với Newton. Khác với Newton tiếp cận từ vật lý, Leibniz tiếp cận từ hình học (tìm hệ số góc tiếp tuyến của đường cong). Ông là người phát minh ra các ký hiệu toán học tuyệt vời mà cả thế giới ngày nay vẫn đang dùng: ký hiệu đạo hàm dy/dx và ký hiệu tích phân ∫.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🚀 Ứng dụng thực tiễn của Đạo hàm" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,6"/>
                        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="#212121" LineHeight="20">
                            Ngày nay, đạo hàm không chỉ dùng trong toán học lý thuyết mà còn là nền tảng cốt lõi của:<LineBreak/>
                            • <Bold>Vật lý học:</Bold> Xác định vận tốc v(t) = s'(t) và gia tốc a(t) = v'(t) = s''(t).<LineBreak/>
                            • <Bold>Kinh tế học:</Bold> Phân tích tốc độ thay đổi biên, tối ưu hóa doanh thu và cực đại hóa lợi nhuận.<LineBreak/>
                            • <Bold>Trí tuệ nhân tạo (AI):</Bold> Thuật toán lan truyền ngược (Backpropagation) và tối ưu hóa độ dốc Gradient Descent sử dụng đạo hàm riêng để tinh chỉnh hàng triệu trọng số mạng neural, giúp máy học học hỏi chính xác.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Đóng cửa sổ" Width="120" Height="44" Margin="0,16,0,0" FontSize="14" FontWeight="Bold"
                Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Close_Click" HorizontalAlignment="Center">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
