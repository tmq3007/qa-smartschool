<Window x:Class="QASmartClass.LearningTools.Views.Math.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="📈 Đồ thị – QA SmartClass"
        Width="1024" Height="700" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Background="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="16,10,16,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E3F2FD" Offset="0"/>
                    <GradientStop Color="#BBDEFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Close Button -->
                <Button DockPanel.Dock="Right" Content="✕ Đóng" Click="Close_Click" Cursor="Hand"
                        FontSize="14" Padding="14,10" Background="#C62828" Foreground="White"
                        BorderThickness="0" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Fullscreen Button -->
                <Button x:Name="btnFullscreen" DockPanel.Dock="Right" Content="⛶ Toàn màn hình" Click="Fullscreen_Click" Cursor="Hand"
                        FontSize="14" Padding="14,10" Background="{StaticResource BrandPrimary}" Foreground="White"
                        BorderThickness="0" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="F11">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Screenshot Button -->
                <Button x:Name="btnScreenshot" DockPanel.Dock="Right" Content="📷 Chụp đồ thị" Click="Screenshot_Click" Cursor="Hand"
                        FontSize="14" Padding="14,10" Background="#00695C" Foreground="White"
                        BorderThickness="0" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="Ctrl+S">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#00897B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2D / 3D Toggle Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <RadioButton x:Name="btnMode2D" Content="Đồ thị 2D" IsChecked="True" GroupName="GraphMode" Click="btnMode2D_Click" Height="38" Padding="12,0" VerticalContentAlignment="Center" Cursor="Hand" Foreground="Black">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" Background="#E0E0E0" BorderBrush="#BDBDBD" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#0D47A1"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#BDBDBD"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsChecked" Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton x:Name="btnMode3D" Content="Đồ thị 3D" GroupName="GraphMode" Click="btnMode3D_Click" Height="38" Padding="12,0" VerticalContentAlignment="Center" Cursor="Hand" Foreground="Black">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" Background="#E0E0E0" BorderBrush="#BDBDBD" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#0D47A1"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#BDBDBD"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsChecked" Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <!-- Info -->
                <StackPanel>
                    <TextBlock x:Name="txtTitle" Text="📈 Đồ thị" FontSize="18" FontWeight="Bold" Foreground="#0D47A1"/>
                    <TextBlock x:Name="txtInfo" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ WEBVIEW2 ═══ -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="webView" DefaultBackgroundColor="White"/>
            
            <!-- Fallback UI cứu hộ khi thiếu WebView2 -->
            <Grid x:Name="fallbackGrid" Visibility="Collapsed" Background="#F5F7FA">
                <Border Background="White" CornerRadius="16" BorderBrush="#E5E9F0" BorderThickness="1" Margin="40" Padding="30"
                        MaxWidth="600" MaxHeight="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#CCCCCC" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️ LỖI KHỞI TẠO WEBVIEW2" FontSize="20" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Không tìm thấy thành phần Microsoft Edge WebView2 Runtime trên máy tính này." FontSize="14" Foreground="#333333" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Đây là thư viện hệ thống bắt buộc dùng để vẽ đồ thị Desmos và mô phỏng STEM. Vui lòng thực hiện tải và cài đặt để kích hoạt tính năng." FontSize="13" Foreground="#666666" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,25"/>
                        
                        <Button x:Name="btnDownload" Content="📥 Tải WebView2 Runtime (Microsoft)" Padding="20,12" Background="#1976D2" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="DownloadWebView2_Click" HorizontalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <TextBlock Text="Hoặc liên hệ Kỹ thuật viên phòng máy trạm để được cài đặt offline." FontSize="12" Foreground="#999999" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
