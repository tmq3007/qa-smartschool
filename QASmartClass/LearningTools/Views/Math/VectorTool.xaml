<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.VectorTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             xmlns:wpfmath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
             Background="{StaticResource Gray100}"
             FontFamily="Times New Roman">
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E3F2FD" Offset="0"/>
                    <GradientStop Color="#BBDEFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🏹 Công cụ học tập Vectơ" FontSize="20" FontWeight="Bold" Foreground="#0D47A1"/>
                <TextBlock Text="Lớp 10 • Cộng trừ vectơ, tích vô hướng, tích của một số với vectơ, góc" FontSize="13" Foreground="#1565C0" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- CONTENT AREA WITH SIDEBAR -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR MENU (Vector/Blue themed) -->
            <Border Grid.Column="0" Background="White" CornerRadius="14" Margin="0,0,12,0" Padding="8,12"
                    BorderBrush="#BBDEFB" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>

                <!-- Math Category: Blue hover/selected -->
                <Border.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Border.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Tính toán &amp; Đồ thị" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn chi tiết" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- SEPARATOR -->
            <Border Grid.Column="1" Background="#E0E0E0" Margin="0,0,12,0"/>

            <!-- TAB CONTENTS -->
            <Grid Grid.Column="2">
                <!-- Tab 1 Content: Calculator -->
                <ScrollViewer x:Name="contentCalc" VerticalScrollBarVisibility="Auto" Padding="0" Visibility="Visible">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Input & Settings -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Mode Selector -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                        <TextBlock Text="📋 Chọn chức năng" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <Border x:Name="btnReset" CornerRadius="6" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="1" Padding="10,4" Cursor="Hand" MouseLeftButtonDown="Reset_Click" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔄 " FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Reset" FontSize="12" FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                    <WrapPanel x:Name="modePanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Input Section -->
                            <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="txtModeTitle" Text="➕ Phép toán vectơ 2D" FontSize="20"
                                               FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,16"/>

                                    <!-- Two vectors input (2D) -->
                                    <StackPanel x:Name="twoVecInput">
                                        <wpfmath:FormulaControl Formula="\vec{a} = (x_1, y_1)" Scale="16" Foreground="#1565C0" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="x₁ =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtX1" FontSize="18" Padding="10,6" FontWeight="SemiBold"
                                                     Width="75" BorderBrush="#90CAF9" BorderThickness="0,0,0,2"
                                                     Background="#F0F7FF" TextChanged="Input_Changed" Text="3"/>
                                            <TextBlock Text="   y₁ =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="16,0,8,0"/>
                                            <TextBox x:Name="txtY1" FontSize="18" Padding="10,6" FontWeight="SemiBold"
                                                     Width="75" BorderBrush="#90CAF9" BorderThickness="0,0,0,2"
                                                     Background="#F0F7FF" TextChanged="Input_Changed" Text="4"/>
                                        </StackPanel>
 
                                        <wpfmath:FormulaControl Formula="\vec{b} = (x_2, y_2)" Scale="16" Foreground="#1565C0" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="x₂ =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtX2" FontSize="18" Padding="10,6" FontWeight="SemiBold"
                                                     Width="75" BorderBrush="#90CAF9" BorderThickness="0,0,0,2"
                                                     Background="#F0F7FF" TextChanged="Input_Changed" Text="-1"/>
                                            <TextBlock Text="   y₂ =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="16,0,8,0"/>
                                            <TextBox x:Name="txtY2" FontSize="18" Padding="10,6" FontWeight="SemiBold"
                                                     Width="75" BorderBrush="#90CAF9" BorderThickness="0,0,0,2"
                                                     Background="#F0F7FF" TextChanged="Input_Changed" Text="2"/>
                                        </StackPanel>
                                    </StackPanel>
 
                                    <!-- Scalar input -->
                                    <StackPanel x:Name="scalarInput" Visibility="Collapsed">
                                        <wpfmath:FormulaControl Formula="\vec{a} = (x, y)" Scale="16" Foreground="#1565C0" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="x =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtSX" FontSize="18" Padding="10,6" FontWeight="SemiBold"
                                                     Width="75" BorderBrush="#90CAF9" BorderThickness="0,0,0,2"
                                                     Background="#F0F7FF" TextChanged="Input_Changed" Text="3"/>
                                            <TextBlock Text="   y =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="16,0,8,0"/>
                                            <TextBox x:Name="txtSY" FontSize="18" Padding="10,6" FontWeight="SemiBold"
                                                     Width="75" BorderBrush="#90CAF9" BorderThickness="0,0,0,2"
                                                     Background="#F0F7FF" TextChanged="Input_Changed" Text="4"/>
                                            <TextBlock Text="   k =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="16,0,8,0"/>
                                            <TextBox x:Name="txtK" FontSize="18" Padding="10,6" FontWeight="SemiBold"
                                                     Width="75" BorderBrush="#90CAF9" BorderThickness="0,0,0,2"
                                                     Background="#F0F7FF" TextChanged="Input_Changed" Text="2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="⚡ Ví dụ nhanh" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="presetPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Results & Analysis -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <!-- Results -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="✅ Kết quả &amp; Phân tích" FontSize="18" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="resultPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Formula Reference -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📖 Lý Thuyết Vectơ" FontSize="18" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="formulaPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Graph Button -->
                            <Border Background="#E3F2FD" CornerRadius="14" Padding="16,12" Margin="0,0,0,0" Cursor="Hand"
                                    MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị trực quan" FontSize="16" FontWeight="Bold" Foreground="#0D47A1"/>
                                        <TextBlock Text="Biểu diễn hình học và quan hệ các vectơ" FontSize="13" Foreground="#1565C0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Tab 2 Content: Instructions -->
                <ScrollViewer x:Name="contentGuide" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                        <!-- Guide Title Card -->
                        <Border Background="#E3F2FD" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#BBDEFB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📖 Hướng Dẫn Sử Dụng Chi Tiết" FontSize="18" FontWeight="Bold" Foreground="#0D47A1"/>
                                <TextBlock Text="Quy trình từng bước trực quan và các ví dụ cụ thể giúp giáo viên &amp; học sinh dễ dàng học tập chủ đề Vectơ (Toán 10 GDPT 2018)." FontSize="13" Foreground="#1565C0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Concept Table Card -->
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#BBDEFB" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📊 Bảng Tóm Tắt Phép Toán &amp; Tính Chất Vectơ" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Table Header -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#1565C0" Padding="8,6" CornerRadius="4,0,0,0"><TextBlock Text="Đặc tính" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#1565C0" Padding="8,6"><TextBlock Text="➕ Phép toán 2 Vectơ" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Row="0" Grid.Column="2" Background="#1565C0" Padding="8,6" CornerRadius="0,4,0,0"><TextBlock Text="✖️ Nhân số với Vectơ" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/></Border>

                                    <!-- Row 1: Formula -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8"><TextBlock Text="Công thức cơ bản" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="a⃗ + b⃗ = (x₁+x₂, y₁+y₂)" FontSize="12" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Text="a⃗ − b⃗ = (x₁−x₂, y₁−y₂)" FontSize="11" Foreground="#424242" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="k·a⃗ = (kx, ky)" FontSize="12" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Text="(Co dãn và đảo hướng)" FontSize="11" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 2: Magnitude -->
                                    <Border Grid.Row="2" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8"><TextBlock Text="Độ dài" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="|a⃗| = √(x₁² + y₁²)" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="|b⃗| = √(x₂² + y₂²)" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="|k·a⃗| = |k|·√(x² + y²)" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="= |k|·|a⃗|" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 3: Angle -->
                                    <Border Grid.Row="3" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8"><TextBlock Text="Góc hình học" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="cos(a⃗,b⃗) = (a⃗·b⃗) / (|a⃗|·|b⃗|)" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Góc giữa 2 vectơ (0° đến 180°)" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="α = atan2(y, x)" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Góc với trục hoành Ox" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 4: Relation -->
                                    <Border Grid.Row="4" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="0,0,1,0" Padding="8" CornerRadius="0,0,0,4"><TextBlock Text="Quan hệ đặc biệt" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,0" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Cùng phương: x₁y₂ − y₁x₂ = 0" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Vuông góc: x₁x₂ + y₁y₂ = 0" FontSize="11" Foreground="#00796B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="2" Padding="8" CornerRadius="0,0,4,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Cùng hướng: k &gt; 0" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Ngược hướng: k &lt; 0" FontSize="11" Foreground="#C62828" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Steps (Timeline layout) -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <!-- Step 1 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Chọn chế độ vận hành" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="Nhấn chọn Phép toán 2 Vectơ (a⃗ ⊕ b⃗) hoặc Phép toán một số nhân vectơ (k·a⃗) ở phần đầu tiên." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 2 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nhập tọa độ chuẩn xác" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="Nhập các số nguyên hoặc số thực vào hộp nhập. Hệ thống sẽ tự động bắt sự kiện và tính toán kết quả theo thời gian thực." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 3 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nhìn kết quả dạng căn thức" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="Phần hiển thị kết quả hỗ trợ hiển thị độ dài vectơ dưới dạng căn thức tối giản (ví dụ: 2√2 thay vì số thập phân lẻ) để dễ đối chiếu SGK." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 4 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
