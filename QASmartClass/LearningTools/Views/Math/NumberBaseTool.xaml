<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.NumberBaseTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER (Gradient + Reset) ═══ -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFF3E0" Offset="0"/>
                    <GradientStop Color="#FFE0B2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource BrandAccent}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="ResetAll_Click" ToolTip="Xóa tất cả">
                    <TextBlock Text="🔄 Reset" FontSize="15" Foreground="White" FontWeight="Bold"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Base_Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandAccent}"/>
                    <TextBlock Text="{DynamicResource Base_Subtitle}" FontSize="14" FontWeight="SemiBold" Foreground="#FB8C00" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#FFF3E0">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextConvert" Text="Chuyển đổi cơ số" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextCalc" Text="Phép tính nhị phân" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextAscii" Text="Bảng ASCII" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#FFE0B2"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C5CAE9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C5CAE9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: CONVERTER -->
                <ScrollViewer x:Name="viewConvert" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="8">
                        <!-- Formula card -->
                        <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E65100" Offset="0"/>
                                            <GradientStop Color="#FB8C00" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="2ⁿ" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Base_SubTitleConvert}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccent}"/>
                                    <TextBlock Text="{DynamicResource Base_TipConvert}" FontSize="14" Foreground="#90A4AE" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="converterPanel"/>
                        <TextBlock x:Name="txtConvertWarning" Foreground="Red" FontSize="14" FontWeight="Bold" Margin="8,4,8,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: PHÉP TÍNH NHỊ PHÂN -->
                <ScrollViewer x:Name="viewCalc" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Formula & Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Formula card -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#FFE0B2" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#E65100" Offset="0"/>
                                                <GradientStop Color="#FB8C00" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="⊕" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Base_CalcHeader}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandAccent}"/>
                                        <TextBlock Text="{DynamicResource Base_CalcSub}" FontSize="14" Foreground="#90A4AE" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Base_InputHeader}" FontSize="16" FontWeight="Bold" Foreground="#757575" Margin="0,0,0,16"/>

                                    <!-- Operand A -->
                                    <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Base_NumA}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtBinA" Grid.Column="1" FontSize="22" Padding="12,10" FontWeight="Bold" TextChanged="BinCalc_Changed" BorderBrush="#FFCC80" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Operator -->
                                    <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Base_Operator}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cboBinOp" Grid.Column="1" Width="160" HorizontalAlignment="Left" FontSize="18" VerticalContentAlignment="Center" FontWeight="Bold" SelectedIndex="0" SelectionChanged="BinCalc_Changed">
                                                <ComboBoxItem Content="+"/>
                                                <ComboBoxItem Content="-"/>
                                                <ComboBoxItem Content="AND"/>
                                                <ComboBoxItem Content="OR"/>
                                                <ComboBoxItem Content="XOR"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Bit Width -->
                                    <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Base_BitWidth}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cboBinWidth" Grid.Column="1" Width="160" HorizontalAlignment="Left" FontSize="18" VerticalContentAlignment="Center" FontWeight="Bold" SelectedIndex="0" SelectionChanged="BinCalc_Changed">
                                                <ComboBoxItem Content="Auto"/>
                                                <ComboBoxItem Content="8-bit"/>
                                                <ComboBoxItem Content="16-bit"/>
                                                <ComboBoxItem Content="32-bit"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Operand B -->
                                    <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Base_NumB}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtBinB" Grid.Column="1" FontSize="22" Padding="12,10" FontWeight="Bold" TextChanged="BinCalc_Changed" BorderBrush="#FFCC80" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Results -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <StackPanel x:Name="binCalcResultPanel"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VIEW 3: BẢNG ASCII -->
                <Grid x:Name="viewAscii" Margin="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: ASCII Grid -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Base_AsciiHeader}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" Margin="0,0,0,12"/>
                            <!-- Search box -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="🔍 Tìm kiếm:" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#757575"/>
                                <TextBox x:Name="txtSearchAscii" FontSize="15" Padding="8,6" MaxLength="6" TextChanged="SearchAscii_TextChanged" BorderBrush="#FFE0B2" BorderThickness="1"/>
                            </DockPanel>
                            <WrapPanel x:Name="asciiPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Right: Detail Panel -->
                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" VerticalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Panel Header -->
                            <TextBlock Grid.Row="0" Text="Ký Tự Được Chọn" FontSize="16" FontWeight="Bold" Foreground="#757575" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <!-- Big character display -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Border Width="90" Height="90" Background="#F5F7FA" CornerRadius="45" BorderBrush="#FFCC80" BorderThickness="1">
                                        <TextBlock x:Name="lblSelectedChar" Text="SP" FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="btnSpeakAscii" Content="🔊" Click="SpeakAscii_Click" Width="36" Height="36" Margin="8,0,0,0" Background="#FFF3E0" Foreground="{StaticResource BrandAccent}" BorderThickness="0" Cursor="Hand" FontSize="16" VerticalAlignment="Bottom">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="18"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                                <!-- Detailed rows -->
                                <Border Background="#F5F7FA" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Thập phân (Dec)" FontSize="14" FontWeight="SemiBold" Foreground="#757575"/>
                                        <TextBlock x:Name="lblSelectedDec" Grid.Column="1" Text="32" FontSize="16" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="#F5F7FA" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hexadecimal" FontSize="14" FontWeight="SemiBold" Foreground="#757575"/>
                                        <TextBlock x:Name="lblSelectedHex" Grid.Column="1" Text="0x20" FontSize="16" FontWeight="Bold" Foreground="#6A1B9A" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="#F5F7FA" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Nhị phân (Bin)" FontSize="14" FontWeight="SemiBold" Foreground="#757575"/>
                                        <TextBlock x:Name="lblSelectedBin" Grid.Column="1" Text="00100000" FontSize="16" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="#F5F7FA" CornerRadius="8" Padding="12" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Phân loại ký tự" FontSize="13" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="lblSelectedType" Text="Khoảng trắng (Space)" FontSize="14" FontWeight="Bold" Foreground="#333333" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- Copy button in panel -->
                            <Button Grid.Row="2" Content="📋 Sao chép ký tự" Click="CopySelectedChar_Click" Padding="10,12" Background="#FFF3E0" Foreground="{StaticResource BrandAccent}" FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW 4: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Toast notification overlay -->
        <Border x:Name="toastBorder" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Padding="20,10" CornerRadius="20" Background="#323232" Visibility="Collapsed" Opacity="0" Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtToastMessage" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</controls:BaseToolControl>