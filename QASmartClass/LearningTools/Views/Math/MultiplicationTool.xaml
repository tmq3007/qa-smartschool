<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.MultiplicationTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E3F2FD" Offset="0"/>
                    <GradientStop Color="#BBDEFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1976D2" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonDown="ExportImage_Click" ToolTip="Xuất tất cả bảng dạng ảnh nền trắng">
                        <TextBlock Text="📷 Xuất ảnh" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📢 Bảng Cửu Chương" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock Text="Lớp 2-5 • Học từng bảng nhân từ 1 đến 10 • Nhấn bảng để phóng to"
                               FontSize="14" Foreground="#1565C0" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT (Master-Detail Grid) ═══ -->
        <Grid x:Name="mainContentGrid" Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E3F2FD">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Ví dụ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextAll" Text="Tất cả bảng" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextSingle" Text="Xem từng bảng" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🃏" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextFlash" Text="Flash Cards" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextQuiz" Text="Quiz tốc độ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#BBDEFB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & VÍ DỤ -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C5CAE9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C5CAE9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: TẤT CẢ CÁC BẢNG -->
                <ScrollViewer x:Name="viewAllTables" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <WrapPanel x:Name="wrapAllTables" Orientation="Horizontal" Margin="8"/>
                </ScrollViewer>

                <!-- VIEW 2: TỪNG BẢNG CHI TIẾT -->
                <Grid x:Name="viewSingleTable" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Selector: Bảng nhân mấy -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,8" Margin="8,4,8,8">
                        <StackPanel>
                            <TextBlock Text="Chọn bảng nhân:" FontSize="13" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="wrapSelector" Orientation="Horizontal"/>
                        </StackPanel>
                    </Border>
                    <!-- Detail view of selected table -->
                    <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border x:Name="borderSingleTable" Background="White" CornerRadius="14" Padding="24,16" Margin="8,0,8,8" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel x:Name="pnlSingleTable"/>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 3: FLASH CARDS -->
                <Grid x:Name="viewFlash" Margin="20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Flash card table selector -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Bảng nhân:" FontSize="13" Foreground="#616161" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cboFlashTable" Width="120" SelectedIndex="0" SelectionChanged="FlashTableChanged"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MinHeight="200" Cursor="Hand" MouseLeftButtonDown="FlashCard_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="Black"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="txtFlashQuestion" Text="7 × 8 = ?" FontSize="42" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtFlashAnswer" Text="Nhấn để xem đáp án" FontSize="16" Foreground="#5A5A5A" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="⏭️ Tiếp theo" FontSize="13" Padding="16,8" Margin="4" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand" Click="FlashNext_Click"/>
                        <Button Content="🔀 Ngẫu nhiên" FontSize="13" Padding="16,8" Margin="4" Background="#7B1FA2" Foreground="White" BorderThickness="0" Cursor="Hand" Click="FlashRandom_Click"/>
                    </StackPanel>
                </Grid>

                <!-- VIEW 4: QUIZ TỐC ĐỘ -->
                <Grid x:Name="viewQuiz" Margin="20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Score bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,10" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" x:Name="txtQuizScore" Text="Điểm: 0/0" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" x:Name="txtQuizTimer" Text="⏱️ 00:00" FontSize="14" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Bảng nhân:" FontSize="12" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cboQuizTable" Width="120" SelectedIndex="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Question -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="txtQuizQuestion" Text="Nhấn 'Bắt đầu' để chơi" FontSize="36" FontWeight="Bold" Foreground="#1A237E" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox x:Name="txtQuizAnswer" MaxLength="3" FontSize="28" Width="150" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" BorderThickness="0,0,0,3" BorderBrush="#1976D2" Background="Transparent" KeyDown="QuizAnswer_KeyDown" LostFocus="QuizAnswer_LostFocus" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtQuizInstruction" Text="Mẹo: Nhập kết quả rồi nhấn Enter (hoặc nút OK trên bàn phím ảo) để trả lời." FontSize="13" Foreground="#757575" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <!-- Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnQuizStart" Content="▶️ Bắt đầu (10 câu)" FontSize="13" Padding="16,8" Margin="4" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" Click="QuizStart_Click"/>
                    </StackPanel>
                </Grid>

                <!-- VIEW 5: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Image preview overlay (hidden by default) -->
        <Border x:Name="imageOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Background="#F5F5F5" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" CornerRadius="10,10,0,0" Padding="12,10,12,10">
                    <DockPanel>
                        <TextBlock Text="📢 Bảng Cửu Chương – Ảnh nền trắng" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Background="#4CAF50" CornerRadius="6" Padding="12,6,12,6" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="CopyImage_Click" ToolTip="Copy ảnh vào clipboard">
                                <TextBlock Text="📋 Copy ảnh" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#1976D2" CornerRadius="6" Padding="12,6,12,6" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="SaveImage_Click" ToolTip="Lưu ảnh thành tệp tin PNG/JPG">
                                <TextBlock Text="💾 Lưu ảnh" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#E53935" CornerRadius="6" Padding="12,6,12,6" Cursor="Hand" MouseLeftButtonDown="CloseImage_Click" ToolTip="Đóng xem ảnh">
                                <TextBlock Text="✕ Đóng" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#E0E0E0">
                    <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Padding="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15"/>
                        </Border.Effect>
                        <Image x:Name="imgPreview" Stretch="None"/>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</controls:BaseToolControl>
