<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.QuadraticTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="#F5F5FA">

        <Grid x:Name="rootGrid" HorizontalAlignment="Stretch" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
            <Border Grid.Row="0"  CornerRadius="14" Padding="20,16" Margin="0,0,0,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1B5E20" Offset="0"/>
                        <GradientStop Color="#2E7D32" Offset="0.5"/>
                        <GradientStop Color="#43A047" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📐 Giải Phương Trình Bậc 2" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="ax² + bx + c = 0 • Tính Δ, nghiệm x1 x2 • Đồ thị Parabol • Lý thuyết • Lịch sử giải" 
                                   FontSize="12" Foreground="#A5D6A7" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="btnSubmit" Grid.Column="1" Content="Nộp Bài Giải 📤" 
                            VerticalAlignment="Center" Padding="14,8" Background="#E8F5E9" Foreground="#2E7D32" 
                            BorderThickness="0" Cursor="Hand" Click="BtnSubmit_Click" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT AREA WITH SIDEBAR -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR MENU (Quadratic/Green themed) -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" Margin="0,0,12,0" Padding="8,12"
                        BorderBrush="#C8E6C9" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>

                <!-- Math Category: Blue hover/selected -->
                <Border.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Border.Resources>
                    <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                             SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                        <ListBoxItem IsSelected="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧮" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock x:Name="menuTextPractice" Text="Tính toán &amp; Đồ thị" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📖" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn sử dụng" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌍" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <!-- SEPARATOR -->
                <Border Grid.Column="1" Background="#E0E0E0" Margin="0,0,12,0"/>

                <!-- TAB CONTENTS -->
                <Grid Grid.Column="2">
                    <!-- Tab 1 Content: Calculator -->
                    <ScrollViewer x:Name="contentCalc" VerticalScrollBarVisibility="Auto" Padding="0" Visibility="Visible">
                        <StackPanel Margin="0,8">
                <!-- NHẬP HỆ Số + KẾT QUẢ -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Nhập hệ số -->
                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,6,0"
                            BorderBrush="#C8E6C9" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📝 Nhập hệ số" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>

                            <!-- Chỉ dẫn nhanh từng bước -->
                            <Border Background="#F1F8E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="💡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#2E7D32" TextWrapping="Wrap" LineHeight="16">
                                        <Run FontWeight="Bold" Text="Chỉ dẫn nhanh:"/>
                                        <LineBreak/>
                                        <Run Text="1. Nhập các hệ số a (≠ 0), b, c."/>
                                        <LineBreak/>
                                        <Run Text="2. Tích chọn nghiệm phức (nếu cần)."/>
                                        <LineBreak/>
                                        <Run Text="3. Xem các bước giải và Đỉnh Parabol bên dưới."/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ax² + bx + c = 0 -->
                            <Border Background="#F1F8E9" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Margin="0,0,2,0">
                                        <TextBlock Text="a" FontSize="12" Foreground="#558B2F" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBox x:Name="txtCoeffA" Width="65" FontSize="18" Padding="8,6" Text="1" TextAlignment="Center"
                                                 FontWeight="Bold" TextChanged="SolveQuadratic_Changed"
                                                 Background="White" Foreground="#1B5E20"/>
                                    </StackPanel>
                                    <TextBlock Text="x² +" FontSize="16" Foreground="#333" VerticalAlignment="Bottom" Margin="4,0,4,10"
                                               FontWeight="SemiBold"/>
                                    <StackPanel Margin="0,0,2,0">
                                        <TextBlock Text="b" FontSize="12" Foreground="#558B2F" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBox x:Name="txtCoeffB" Width="65" FontSize="18" Padding="8,6" Text="-5" TextAlignment="Center"
                                                 FontWeight="Bold" TextChanged="SolveQuadratic_Changed"
                                                 Background="White" Foreground="{StaticResource BrandPrimary}"/>
                                    </StackPanel>
                                    <TextBlock Text="x +" FontSize="16" Foreground="#333" VerticalAlignment="Bottom" Margin="4,0,4,10"
                                               FontWeight="SemiBold"/>
                                    <StackPanel>
                                        <TextBlock Text="c" FontSize="12" Foreground="#558B2F" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBox x:Name="txtCoeffC" Width="65" FontSize="18" Padding="8,6" Text="6" TextAlignment="Center"
                                                 FontWeight="Bold" TextChanged="SolveQuadratic_Changed"
                                                 Background="White" Foreground="#C62828"/>
                                    </StackPanel>
                                    <TextBlock Text="= 0" FontSize="16" Foreground="#333" VerticalAlignment="Bottom" Margin="6,0,0,10"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Tùy chọn Nghiệm Phức -->
                            <CheckBox x:Name="chkShowComplex" Content="Hiển thị nghiệm phức (THPT)"
                                      FontSize="12" Foreground="#2E7D32" Margin="0,0,0,12" FontWeight="SemiBold"
                                      Checked="SolveQuadratic_Changed" Unchecked="SolveQuadratic_Changed" IsChecked="False"/>

                            <!-- PRESET buttons -->
                            <TextBlock Text="⚡ Ví dụ nhanh" FontSize="12" Foreground="#757575" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="presetPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT: Kết quả -->
                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20,16" Margin="6,0,0,0"
                            BorderBrush="#C8E6C9" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📋 Kết quả" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>

                            <!-- Delta -->
                            <Border x:Name="deltaCard" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Biệt thức Δ" FontSize="12" FontWeight="SemiBold" Foreground="#757575"/>
                                    <TextBlock x:Name="txtDelta" Text="Δ = b² - 4ac = 1" FontSize="15" FontWeight="Bold" 
                                               Foreground="#558B2F" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Nghiệm -->
                            <Border x:Name="resultCard" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="N nghiệm" FontSize="12" FontWeight="SemiBold" Foreground="#757575"/>
                                    <TextBlock x:Name="txtQuadResult" Text="x1 = 2,  x2 = 3" FontSize="16" FontWeight="Bold" 
                                               Foreground="#1B5E20" Margin="0,3,0,0" TextWrapping="Wrap"
                                              />
                                </StackPanel>
                            </Border>

                            <!-- Phân tích -->
                            <Border Background="#FFF8E1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="🔬 Phân tích nhân tử" FontSize="12" FontWeight="SemiBold" Foreground="#F57F17"/>
                                    <TextBlock x:Name="txtFactored" Text="" FontSize="13" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrandAccent}" Margin="0,3,0,0" TextWrapping="Wrap"
                                              />
                                </StackPanel>
                            </Border>

                            <!-- Đỉnh parabol -->
                            <Border Background="#E3F2FD" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="📍 Đỉnh Parabol" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBlock x:Name="txtVertex" Text="" FontSize="13" FontWeight="SemiBold" 
                                               Foreground="#0D47A1" Margin="0,3,0,0"
                                              />
                                </StackPanel>
                            </Border>

                            <!-- Nút Xem đồ thị -->
                            <Border Background="#F3E5F5" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                    MouseLeftButtonDown="OpenGraph_Click"
                                    BorderBrush="#CE93D8" BorderThickness="1"
                                    x:Name="btnGraph" ToolTip="Mở đồ thị Parabol trên Graph Calculator">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị" FontSize="12" FontWeight="Bold" Foreground="#7B1FA2"/>
                                        <TextBlock Text="Mở parabol trên Graph Calculator" FontSize="11" Foreground="#9C27B0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- BƯỚC GIẢI CHI TIẾT -->
                <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,14"
                        BorderBrush="#E3E8EE" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📝 Các bước giải chi tiết" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,10"/>
                        <StackPanel x:Name="stepsPanel"/>
                    </StackPanel>
                </Border>

                <!-- BẢNG CÔNG THỨC -->
                <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,14"
                        BorderBrush="#E3E8EE" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📖 Lý thuyết – Phương trình bậc 2" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="theoryPanel" Margin="0,4,0,0" ItemWidth="280"/>
                    </StackPanel>
                </Border>

                <!-- LỊCH SỬ GIẢI -->
                <Border Background="White" CornerRadius="14" Padding="20,16"
                        BorderBrush="#E3E8EE" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="btnClearHistory" DockPanel.Dock="Right" Content="🗑️ Xóa" 
                                    FontSize="11" Padding="8,4" Background="#FFF3E0" Foreground="{StaticResource BrandAccent}"
                                    BorderThickness="0" Cursor="Hand" Click="ClearHistory_Click"/>
                            <TextBlock Text="📜 Lịch sử giải" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                        </DockPanel>
                        <StackPanel x:Name="historyPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
                    </ScrollViewer>

            <!-- Tab 2 Content: Guide -->
            <ScrollViewer x:Name="contentGuide" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" MaxHeight="600">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="4,0,0,0">
                    <!-- Guide Header -->
                    <Border Background="#E8F5E9" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📖 Hướng Dẫn Sử Dụng Công Cụ Giải Phương Trình Bậc 2" FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                            <TextBlock Text="Dành cho Giáo viên và Học sinh: Học tập, thực hành và minh họa trực quan các khái niệm liên quan đến phương trình bậc 2 (ax² + bx + c = 0) và đồ thị Parabol." FontSize="13" Foreground="#2E7D32" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Steps -->
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#E3E8EE" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🚀 Các Bước Thao Tác Trực Quan" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,12"/>
                            
                            <Border Background="#F9FBE7" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F0F4C3" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1B5E20" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bước 1: Nhập hệ số phương trình" FontWeight="Bold" FontSize="14" Foreground="#1B5E20" Margin="0,0,0,4"/>
                                        <TextBlock Text="Nhập trực tiếp các hệ số a, b, c vào các ô nhập liệu tương ứng. Chú ý hệ số a phải khác 0. Bạn có thể sử dụng phân số (VD: 1/2) hoặc số thập phân (VD: -2.5)." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#F9FBE7" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F0F4C3" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1B5E20" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bước 2: Lựa chọn hiển thị nghiệm phức" FontWeight="Bold" FontSize="14" Foreground="#1B5E20" Margin="0,0,0,4"/>
                                        <TextBlock Text="Đối với học sinh THCS, bỏ tích 'Hiển thị nghiệm phức (THPT)' để xem kết quả Vô nghiệm thực. Đối với học sinh THPT, tích chọn để hiển thị nghiệm phức dưới dạng x = u ± vi." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#F9FBE7" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F0F4C3" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1B5E20" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bước 3: Xem các bước giải và đồ thị Parabol" FontWeight="Bold" FontSize="14" Foreground="#1B5E20" Margin="0,0,0,4"/>
                                        <TextBlock Text="Xem chi tiết cách tính biệt thức Delta, tọa độ đỉnh Parabol, dạng phân tích nhân tử và bấm nút 'Xem đồ thị' để vẽ hình trực quan trên hệ trục tọa độ Oxy." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Data table -->
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📊 Bảng Bộ Số Liệu Thực Hành Mẫu" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,12"/>
                            <TextBlock Text="Sử dụng các bộ số liệu dưới đây để nhanh chóng minh họa các trường hợp nghiệm đặc biệt:" FontSize="13" Foreground="#555555" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Header Row -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#1B5E20" Padding="8,6" CornerRadius="4,0,0,0">
                                    <TextBlock Text="Trường hợp" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#1B5E20" Padding="8,6">
                                    <TextBlock Text="Hệ số (a, b, c)" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="#1B5E20" Padding="8,6" CornerRadius="0,4,0,0">
                                    <TextBlock Text="Mục đích Sư phạm &amp; Kết quả" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1 -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="1️⃣ Có 2 nghiệm phân biệt" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="1; -5; 6" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Δ = 1 > 0. Nghiệm x1 = 2, x2 = 3. Đồ thị cắt trục hoành tại 2 điểm." FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Row 2 -->
                                <Border Grid.Row="2" Grid.Column="0" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="2️⃣ Có nghiệm kép" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="1; -4; 4" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Δ = 0. Nghiệm kép x1 = x2 = 2. Đỉnh Parabol tiếp xúc trục hoành." FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Row 3 -->
                                <Border Grid.Row="3" Grid.Column="0" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="3️⃣ Vô nghiệm thực / Nghiệm phức" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="1; 2; 5" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
