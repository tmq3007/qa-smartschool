<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.LogarithmTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER (Gradient + Reset) -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E0F2F1" Offset="0"/>
                    <GradientStop Color="#B2DFDB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#00695C" CornerRadius="8" Padding="10,6" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="ResetAll_Click" ToolTip="Đặt lại giá trị mặc định">
                    <TextBlock Text="🔄 Đặt lại" FontSize="13" Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📐 Logarithm &amp; Luỹ Thừa" FontSize="20" FontWeight="Bold" Foreground="#00695C"/>
                    <TextBlock Text="Lớp 11-12 • log, ln, e^x, a^x – tra cứu &amp; tính toán" FontSize="14" Foreground="#26A69A" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E0F2F1">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng Hẫn &amp; Quy Trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextCalc" Text="Tính toán" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTable" Text="Bảng giá trị" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📐" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextFormula" Text="Công thức" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#B2DFDB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C5CAE9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C5CAE9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: TÍNH TOÁN -->
                <ScrollViewer x:Name="viewCalc" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="16">
                        <!-- Formula card -->
                        <Border Background="White" CornerRadius="12" Padding="20,14" Margin="0,0,0,16" BorderBrush="#B2DFDB" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00695C" Offset="0"/>
                                            <GradientStop Color="#26A69A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="logₐ" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="logₐx = y  ⇔  aʸ = x" FontSize="18" FontWeight="Bold" Foreground="#00695C"/>
                                    <TextBlock Text="ln(x) = logₑ(x)  •  e ≈ 2.71828  •  log₁₀(x) = lg(x)" FontSize="13" Foreground="#26A69A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Input -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <!-- Logarithm -->
                                <Border Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📐 Logarithm" FontSize="14" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,10"/>
                                        <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Cơ số a" FontSize="13" FontWeight="SemiBold" Foreground="#00695C"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtLogBase" Grid.Column="1" FontSize="18" Padding="10,8" Text="10" TextChanged="Calc_Changed" BorderBrush="#80CBC4" BorderThickness="0,0,0,2" Background="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Giá trị x" FontSize="13" FontWeight="SemiBold" Foreground="#00695C"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtLogValue" Grid.Column="1" FontSize="18" Padding="10,8" Text="100" TextChanged="Calc_Changed" BorderBrush="#80CBC4" BorderThickness="0,0,0,2" Background="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <Border CornerRadius="10" Padding="14,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#E0F2F1" Offset="0"/>
                                                    <GradientStop Color="#F1F8E9" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="txtLogResult" Text="= 2" FontSize="20" FontWeight="Bold" Foreground="#00695C" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Luy thua -->
                                <Border Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📊 Luỹ Thừa" FontSize="14" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,10"/>
                                        <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Cơ số a" FontSize="13" FontWeight="SemiBold" Foreground="#00695C"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtPowBase" Grid.Column="1" FontSize="18" Padding="10,8" Text="2" TextChanged="Calc_Changed" BorderBrush="#80CBC4" BorderThickness="0,0,0,2" Background="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Số mũ n" FontSize="13" FontWeight="SemiBold" Foreground="#00695C"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtPowExp" Grid.Column="1" FontSize="18" Padding="10,8" Text="10" TextChanged="Calc_Changed" BorderBrush="#80CBC4" BorderThickness="0,0,0,2" Background="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <Border CornerRadius="10" Padding="14,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#E0F2F1" Offset="0"/>
                                                    <GradientStop Color="#F1F8E9" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="txtPowResult" Text="= 1024" FontSize="20" FontWeight="Bold" Foreground="#00695C" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- e^x -->
                                <Border Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📊 Hàm e^x" FontSize="14" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,10"/>
                                        <Border Background="#F5F7FA" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Giá trị x" FontSize="13" FontWeight="SemiBold" Foreground="#00695C"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtExpX" Grid.Column="1" FontSize="18" Padding="10,8" Text="1" TextChanged="Calc_Changed" BorderBrush="#80CBC4" BorderThickness="0,0,0,2" Background="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <Border CornerRadius="10" Padding="14,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#E0F2F1" Offset="0"/>
                                                    <GradientStop Color="#F1F8E9" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="txtExpResult" Text="= 2.71828" FontSize="20" FontWeight="Bold" Foreground="#00695C" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Nút Graph -->
                                <Border Background="#E3F2FD" CornerRadius="10" Padding="10,8" Margin="0,12,0,0" Cursor="Hand" MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📈" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Xem đồ thị" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                            <TextBlock Text="log, ln, eˣ – đồ thị hàm số" FontSize="13" Foreground="#1976D2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Quick ref -->
                            <StackPanel Grid.Column="1" x:Name="quickRefPanel"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: BẢNG GIÁ TRỊ -->
                <ScrollViewer x:Name="viewTable" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="tablePanel" Margin="12"/>
                </ScrollViewer>

                <!-- VIEW 3: CÔNG THỨC -->
                <ScrollViewer x:Name="viewFormula" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="formulaPanel" Margin="12"/>
                </ScrollViewer>

                <!-- VIEW 4: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
