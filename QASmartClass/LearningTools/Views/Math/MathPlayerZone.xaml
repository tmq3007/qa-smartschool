<UserControl x:Class="QASmartClass.LearningTools.Views.Math.MathPlayerZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700">
    <Border x:Name="mainBorder" CornerRadius="16" BorderThickness="4" Margin="6" Background="White" BorderBrush="{StaticResource Gray300}">
        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E1F5FE">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGame" Text="Trò chơi" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#B3E5FC"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="12">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="8">
<Border Background="White" CornerRadius="12" Padding="16,14" BorderBrush="#B3E5FC" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🎮 Đấu Trường Toán Học" FontSize="16" FontWeight="Bold" Foreground="#0288D1" Margin="0,0,0,12"/>
                                <TextBlock Text="• Mục tiêu: Hoàn thành chính xác 10 câu đố tính toán hoặc so sánh số học nhanh." FontSize="13" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="• Tích lũy sao (⭐): Mỗi câu trả lời đúng được cộng sao. Trả lời đúng liên tục sẽ tạo chuỗi thắng (Streak) tăng điểm số!" FontSize="13" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="• Giáo viên kiểm tra: Trong chế độ xác nhận, giáo viên có thể bấm Đúng/Sai để chấm điểm trực tiếp cho học sinh." FontSize="13" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="👉 Bấm chọn tab [🎮 Trò chơi] để bắt đầu cuộc đua tính toán nào!" FontSize="13.5" FontWeight="SemiBold" Foreground="#E65100" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: TRÒ CHƠI -->
                <Grid x:Name="viewGame" Margin="4" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Expression -->
                        <RowDefinition Height="Auto"/> <!-- Input Area -->
                    </Grid.RowDefinitions>

                    <!-- HEADER: Score & Progress -->
                    <DockPanel Grid.Row="0">
                        <Border x:Name="playerBadge" DockPanel.Dock="Left" CornerRadius="8" Padding="12,6" Background="{StaticResource Gray100}">
                            <TextBlock x:Name="txtPlayerName" Text="Người chơi 1" FontSize="14" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="txtScore" Text="⭐ 0" FontSize="18" FontWeight="Bold" Foreground="#F57C00" Margin="0,0,16,0"/>
                            <TextBlock x:Name="txtProgress" Text="Câu 1/10" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Gray700}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- EXPRESSION AREA -->
                    <Border Grid.Row="1" Background="{StaticResource Gray100}" CornerRadius="16" Margin="0,10,0,10" Padding="12">
                        <Viewbox Stretch="Uniform" StretchDirection="Both">
                            <Grid>
                                <StackPanel x:Name="panelExpression" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="320">
                                    <!-- For Calculation -->
                                    <TextBlock x:Name="txtCalcExpr" Text="45 + 12 =" FontSize="48" FontWeight="Bold" 
                                               Foreground="{StaticResource Gray900}" HorizontalAlignment="Center" Padding="0,10,0,10" Visibility="Collapsed"/>
                                    <!-- For Comparison -->
                                    <StackPanel x:Name="panelCompExpr" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="txtCompLeft" Text="45 + 12" FontSize="42" FontWeight="Bold" Foreground="{StaticResource Gray900}" VerticalAlignment="Center" Padding="0,8,0,8"/>
                                        <Border Background="White" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource Gray300}" Padding="16,8" Margin="16,0">
                                            <TextBlock x:Name="txtCompSign" Text="?" FontSize="42" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" Padding="0,8,0,8"/>
                                        </Border>
                                        <TextBlock x:Name="txtCompRight" Text="60" FontSize="42" FontWeight="Bold" Foreground="{StaticResource Gray900}" VerticalAlignment="Center" Padding="0,8,0,8"/>
                                    </StackPanel>
                                    
                                    <!-- Feedback Message -->
                                    <TextBlock x:Name="txtFeedback" Text="Chính xác!" FontSize="24" FontWeight="Bold" Foreground="{StaticResource StateSuccess}" 
                                               HorizontalAlignment="Center" Margin="0,24,0,0" Opacity="0"/>
                                </StackPanel>

                                <!-- Victory Screen -->
                                <StackPanel x:Name="panelVictory" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MinWidth="320">
                                    <TextBlock Text="🏆" FontSize="80" HorizontalAlignment="Center"/>
                                    <TextBlock Text="HOÀN THÀNH!" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrandAccent}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock x:Name="txtFinalScore" Text="Điểm: 100" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gray800}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- INPUT AREA -->
                    <Grid Grid.Row="2" MinHeight="140">
                        <!-- Mode 1: Self Calc (Numpad) -->
                        <StackPanel x:Name="inputSelfCalc" Visibility="Collapsed" HorizontalAlignment="Center">
                            <TextBox x:Name="txtAnswer" FontSize="36" FontWeight="Bold" TextAlignment="Center" IsReadOnly="True" Focusable="False" 
                                     Width="200" Padding="8,4" BorderThickness="0,0,0,4" BorderBrush="{StaticResource BrandPrimary}" Background="Transparent" Margin="0,0,0,10"/>
                            
                            <!-- Bàn phím số Grid 4 cột x 3 hàng -->
                            <UniformGrid Columns="4" Rows="3" Width="300" Height="150" Margin="0,4,0,4">
                                <Button Content="1" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="2" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="3" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="⌫" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource Gray700}" Margin="4" BorderThickness="0" Cursor="Hand" Click="BackspaceKey_Click"/>
                                <Button Content="4" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="5" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="6" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="C" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource Gray700}" Margin="4" BorderThickness="0" Cursor="Hand" Click="ClearKey_Click"/>
                                <Button Content="7" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="8" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="9" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                                <Button Content="0" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="4" BorderThickness="0" Cursor="Hand" Click="NumKey_Click"/>
                            </UniformGrid>

                            <!-- Nút nộp bài -->
                            <Button x:Name="btnSubmitCalc" Content="Nộp bài" FontSize="18" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandAccent}" 
                                    BorderThickness="0" Padding="0,10" Margin="0,6,0,0" Width="300" Cursor="Hand" Click="BtnSubmitCalc_Click"/>
                        </StackPanel>

                        <!-- Mode 1: Self Comp (3 Buttons) -->
                        <UniformGrid x:Name="inputSelfComp" Columns="3" Visibility="Collapsed" HorizontalAlignment="Center" Width="360">
                            <Button x:Name="btnCompLess" Content="&lt;" FontSize="48" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandPrimary}" Margin="8" Padding="16,24" BorderThickness="0" Cursor="Hand" Click="BtnComp_Click"/>
                            <Button x:Name="btnCompEqual" Content="=" FontSize="48" FontWeight="Bold" Foreground="White" Background="{StaticResource Gray700}" Margin="8" Padding="16,24" BorderThickness="0" Cursor="Hand" Click="BtnComp_Click"/>
                            <Button x:Name="btnCompGreater" Content="&gt;" FontSize="48" FontWeight="Bold" Foreground="White" Background="{StaticResource BrandAccent}" Margin="8" Padding="16,24" BorderThickness="0" Cursor="Hand" Click="BtnComp_Click"/>
                        </UniformGrid>

                        <!-- Mode 2: Teacher Verification -->
                        <StackPanel x:Name="inputTeacherVerify" Visibility="Collapsed" HorizontalAlignment="Center">
                            <TextBlock Text="Cô giáo xác nhận kết quả:" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Gray700}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtTeacherHint" Text="Đáp án: 0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Gray700}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Width="300">
                                <Button x:Name="btnTeacherCorrect" Content="👍 ĐÚNG" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource StateSuccess}" Margin="8" Padding="16,20" BorderThickness="0" Cursor="Hand" Click="BtnTeacherCorrect_Click"/>
                                <Button x:Name="btnTeacherIncorrect" Content="👎 SAI" FontSize="20" FontWeight="Bold" Foreground="White" Background="{StaticResource StateError}" Margin="8" Padding="16,20" BorderThickness="0" Cursor="Hand" Click="BtnTeacherIncorrect_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- VIEW 2: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="10" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
