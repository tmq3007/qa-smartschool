<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.ConicSectionTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}"
             FontFamily="Segoe UI">
 
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
 
        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (Conic themed) -->
            <Grid Grid.Column="0" Background="#E3F2FD">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Tính toán &amp; Ví dụ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#BBDEFB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="0">
                <!-- VIEW 0: HƯỚNG DẪN CHI TIẾT -->
                <ScrollViewer x:Name="contentGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20">
                    <StackPanel>
                        <!-- Header Card -->
                        <Border Background="#E8F5E9" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#A5D6A7" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📖 Cẩm Nang Tra Cứu Đường Conic" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                                <TextBlock Text="Học nhanh lý thuyết, các đặc trưng hình học và ví dụ thực tiễn sinh động." FontSize="13" Foreground="#388E3C" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
 
                        <!-- Formula Reference Table Card -->
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📋 Bảng so sánh các đường Conic chính tắc" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
 
                                    <!-- Header Row -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#F5F7FA" Padding="8" BorderBrush="#E0E0E0" BorderThickness="1,1,1,1" CornerRadius="4,0,0,0"><TextBlock Text="Đặc trưng" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F7FA" Padding="8" BorderBrush="#E0E0E0" BorderThickness="0,1,1,1"><TextBlock Text="Elip (Ellipse)" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Row="0" Grid.Column="2" Background="#F5F7FA" Padding="8" BorderBrush="#E0E0E0" BorderThickness="0,1,1,1"><TextBlock Text="Hyperbol" FontWeight="Bold" Foreground="#0277BD" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Row="0" Grid.Column="3" Background="#F5F7FA" Padding="8" BorderBrush="#E0E0E0" BorderThickness="0,1,1,1" CornerRadius="0,4,0,0"><TextBlock Text="Parabol" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center"/></Border>
 
                                    <!-- Row 1: Equation -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="1,0,1,1" Padding="8"><TextBlock Text="Phương trình" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="x²/a² + y²/b² = 1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="(a &gt; b &gt; 0)" FontSize="10" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="x²/a² − y²/b² = 1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="(a, b &gt; 0)" FontSize="10" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="3" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="y² = 2px" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="(p &gt; 0)" FontSize="10" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
 
                                    <!-- Row 2: Relation -->
                                    <Border Grid.Row="2" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="1,0,1,1" Padding="8"><TextBlock Text="Hệ thức liên hệ" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8"><TextBlock Text="c² = a² − b²" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8"><TextBlock Text="c² = a² + b²" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="2" Grid.Column="3" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="8"><TextBlock Text="—" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#999999"/></Border>
 
                                    <!-- Row 3: Focus / Directrix -->
                                    <Border Grid.Row="3" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="1,0,1,1" Padding="8"><TextBlock Text="Tiêu điểm" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="F₁(-c, 0), F₂(c, 0)" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Tiêu cự: 2c" FontSize="10" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="F₁(-c, 0), F₂(c, 0)" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Tiêu cự: 2c" FontSize="10" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="3" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="F(p/2, 0)" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Đường chuẩn: x = -p/2" FontSize="10" Foreground="#E65100" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
 
                                    <!-- Row 4: Eccentricity -->
                                    <Border Grid.Row="4" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="1,0,1,1" Padding="8"><TextBlock Text="Tâm sai (e)" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="e = c/a" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="(0 &lt; e &lt; 1)" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,1,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="e = c/a" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="(e &gt; 1)" FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="3" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="e = 1" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text=" " FontSize="11" Foreground="#666666" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
 
                                    <!-- Row 5: Asymptotes / Note -->
                                    <Border Grid.Row="5" Grid.Column="0" Background="#F4F8FD" BorderBrush="#E3F2FD" BorderThickness="1,0,1,0" Padding="8" CornerRadius="0,0,0,4"><TextBlock Text="Đỉnh &amp; Tiệm cận" FontWeight="Bold" Foreground="#0D47A1" FontSize="12" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E3F2FD" BorderThickness="0,0,1,0" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="A₁(±a,0), B₁(0,±b)" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="Không có tiệm cận" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="2" BorderBrush="#E3F2FD" BorderThickness="0,0,1,0" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="A₁(±a,0)" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Tiệm cận: y = ±(b/a)x" FontSize="10" Foreground="#0277BD" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="3" Padding="8" CornerRadius="0,0,4,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Đỉnh: O(0,0)" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Không có tiệm cận" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
 
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
 
                            <!-- Left: Steps (Timeline layout) -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <!-- Step 1 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Chọn loại đường Conic" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="Chọn chế độ tương ứng ở khay Chọn loại đường conic: Elip 🔴, Hyperbol 📐 hoặc Parabol 🌙." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 2 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nhập hệ số hoặc chọn ví dụ nhanh" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="Nhập các số thực dương trực tiếp vào ô nhập liệu (a, b đối với Elip/Hyperbol, p đối với Parabol) hoặc bấm chọn một nút ở khay Ví dụ nhanh để tự động điền số liệu mẫu." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 3 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Xem kết quả phân tích tức thì" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="Đọc bảng kết quả tính toán chi tiết về: phương trình chính tắc, đỉnh, tiêu điểm, tâm sai, tiêu cự và đường chuẩn tương ứng." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 4 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1565C0" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Mở đồ thị tọa độ tương tác" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="Bấm nút Xem đồ thị 📈 để hiển thị đường cong conic trực quan, các đường chuẩn nét đứt và các tiêu điểm biểu diễn chuẩn xác." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Tip -->
                                <Border Background="#FFF3E0" CornerRadius="10" Padding="12" BorderBrush="#FFE0B2" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Mẹo sao chép nhanh" FontWeight="Bold" FontSize="13" Foreground="#E65100" Margin="0,0,0,4"/>
                                            <TextBlock Text="Bạn có thể bấm trực tiếp vào bất kỳ dòng kết quả phân tích nào để sao chép kết quả đó vào bộ nhớ tạm máy tính." FontSize="12" Foreground="#E65100" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
 
                            <!-- Right: Sample examples (Premium Card layout) -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <!-- Tra cứu công thức tự động -->
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderBrush="#BBDEFB" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📝 Tra cứu nhanh công thức" FontSize="14" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="formulaPanel"/>
                                    </StackPanel>
                                </Border>
 
                                <!-- Ví dụ động từ mã máy -->
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderBrush="#BBDEFB" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="💡 Tóm tắt lý thuyết &amp; Định nghĩa" FontSize="14" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="guidePanel"/>
                                    </StackPanel>
                                </Border>
 
                                <!-- Example 1 -->
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="Ví dụ 1: Elip chính tắc tiêu chuẩn" FontSize="13" FontWeight="Bold" Foreground="#2E7D32"/>
                                        </Border>
                                        <TextBlock Text="• Đầu vào: a = 5, b = 3 (thỏa mãn a &gt; b &gt; 0)" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Phương trình chính tắc: x²/25 + y²/9 = 1" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Tiêu điểm: F₁(-4, 0), F₂(4, 0) (vì c = √(25-9) = 4)" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Tâm sai: e = c/a = 0.8  |  Đường chuẩn: x = ±6.25" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    </StackPanel>
                                </Border>
 
                                <!-- Example 2 -->
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <Border Background="#E1F5FE" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="Ví dụ 2: Hyperbol chính tắc" FontSize="13" FontWeight="Bold" Foreground="#0277BD"/>
                                        </Border>
                                        <TextBlock Text="• Đầu vào: a = 3, b = 4" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Phương trình chính tắc: x²/9 − y²/16 = 1" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Tiêu điểm: F₁(-5, 0), F₂(5, 0) (vì c = √(9+16) = 5)" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Tiệm cận: y = ±(4/3)x  |  Đường chuẩn: x = ±1.8" FontSize="12" FontWeight="SemiBold" Foreground="#0277BD"/>
                                    </StackPanel>
                                </Border>
 
                                <!-- Example 3 -->
                                <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <Border Background="#FFF3E0" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="Ví dụ 3: Parabol chính tắc" FontSize="13" FontWeight="Bold" Foreground="#EF6C00"/>
                                        </Border>
                                        <TextBlock Text="• Đầu vào: p = 4 (tham số tiêu dương)" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Phương trình chính tắc: y² = 8x" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Tiêu điểm: F(2, 0)  |  Đường chuẩn: x = -2" FontSize="12" Foreground="#424242" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Mọi điểm M(x,y) thuộc Parabol có d(M, F) = d(M, chuẩn) = x + 2." FontSize="12" FontWeight="SemiBold" Foreground="#EF6C00" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
 
                <!-- VIEW 1: TÍNH TOÁN CHÍNH -->
                <ScrollViewer x:Name="contentCalc" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Visible">
                    <StackPanel>
                        <!-- HEADER inside contentCalc ScrollViewer -->
                        <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E3F2FD" Offset="0"/>
                                    <GradientStop Color="#BBDEFB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="🔵 Đường Conic — Conic Sections" FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
                                <TextBlock Text="Lớp 10 • Elip, Hyperbol, Parabol" FontSize="12" Foreground="#0D47A1" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
 
                            <!-- LEFT COLUMN: Input & Settings -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <!-- Mode Selector -->
                                <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                        BorderBrush="#BBDEFB" BorderThickness="1">
                                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="📋 Chọn loại đường conic" FontSize="16" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,12"/>
                                        <WrapPanel x:Name="modePanel"/>
                                    </StackPanel>
                                </Border>
 
                                <!-- Input Section -->
                                <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16"
                                        BorderBrush="#BBDEFB" BorderThickness="1">
                                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="txtModeTitle" Text="🔴 Elip" FontSize="20"
                                                   FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
 
                                        <!-- Ellipse: x²/a² + y²/b² = 1 -->
                                        <StackPanel x:Name="ellipseInput">
                                            <TextBlock Text="x²/a² + y²/b² = 1  (a > b > 0)" FontSize="16" FontWeight="SemiBold" Foreground="#0D47A1" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="a =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                                <TextBox x:Name="txtEA" FontSize="20" Padding="10,6" FontWeight="SemiBold"
                                                         Width="85" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#E3F2FD" TextChanged="Input_Changed" Text="5"/>
                                                <TextBlock Text="   b =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="16,0,8,0"/>
                                                <TextBox x:Name="txtEB" FontSize="20" Padding="10,6" FontWeight="SemiBold"
                                                         Width="85" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#E3F2FD" TextChanged="Input_Changed" Text="3"/>
                                            </StackPanel>
                                        </StackPanel>
 
                                        <!-- Hyperbola: x²/a² - y²/b² = 1 -->
                                        <StackPanel x:Name="hyperbolaInput" Visibility="Collapsed">
                                            <TextBlock Text="x²/a² − y²/b² = 1  (a, b > 0)" FontSize="16" FontWeight="SemiBold" Foreground="#0D47A1" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="a =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                                <TextBox x:Name="txtHA" FontSize="20" Padding="10,6" FontWeight="SemiBold"
                                                         Width="85" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#E3F2FD" TextChanged="Input_Changed" Text="3"/>
                                                <TextBlock Text="   b =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="16,0,8,0"/>
                                                <TextBox x:Name="txtHB" FontSize="20" Padding="10,6" FontWeight="SemiBold"
                                                         Width="85" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#E3F2FD" TextChanged="Input_Changed" Text="4"/>
                                            </StackPanel>
                                        </StackPanel>
 
                                        <!-- Parabola: y² = 2px -->
                                        <StackPanel x:Name="parabolaInput" Visibility="Collapsed">
                                            <TextBlock Text="y² = 2px  (p > 0)" FontSize="16" FontWeight="SemiBold" Foreground="#0D47A1" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="p =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                                <TextBox x:Name="txtPP" FontSize="20" Padding="10,6" FontWeight="SemiBold"
                                                         Width="85" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#E3F2FD" TextChanged="Input_Changed" Text="4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
 
                                <!-- Presets -->
                                <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                        BorderBrush="#BBDEFB" BorderThickness="1">
                                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="⚡ Ví dụ nhanh" FontSize="16" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,12"/>
                                        <WrapPanel x:Name="presetPanel"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
 
                            <!-- RIGHT COLUMN: Results & Analysis & Graph Button -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <!-- Results -->
                                <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                        BorderBrush="#BBDEFB" BorderThickness="1">
                                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="✅ Kết quả phân tích" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>
                                        <StackPanel x:Name="resultPanel"/>
                                    </StackPanel>
                                </Border>
 
                                <!-- Graph Button & Report Button Grid -->
                                <UniformGrid Columns="2" Margin="0">
                                    <!-- Graph Button -->
                                    <Border Background="#E3F2FD" CornerRadius="14" Padding="16,12" Margin="0,0,8,0" Cursor="Hand"
                                            MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Xem đồ thị" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                                                <TextBlock Text="Vẽ elip/hyper/parabol" FontSize="12" Foreground="#0D47A1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
 
                                    <!-- Report Button -->
                                    <Border Background="#E8F5E9" CornerRadius="14" Padding="16,12" Margin="8,0,0,0" Cursor="Hand"
                                            MouseLeftButtonDown="ExportReport_Click" BorderBrush="#A5D6A7" BorderThickness="1">
                                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📄" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Xuất báo cáo" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                                                <TextBlock Text="Lưu tệp báo cáo (*.txt)" FontSize="12" Foreground="#388E3C"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
 
                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" Visibility="Collapsed" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="20">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
