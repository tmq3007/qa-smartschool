<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.DerivativeTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">
    <Grid x:Name="mainGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
 
        <!-- HEADER -->
        <Border x:Name="headerBorder" Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E3F2FD" Offset="0"/>
                    <GradientStop Color="#BBDEFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblHeaderTitle" Text="📈 Đạo Hàm" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock x:Name="lblHeaderSub" Text="Lớp 12 • Quy tắc đạo hàm, bảng công thức, ứng dụng" FontSize="14" Foreground="#1976D2" Margin="0,4,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnHistory" Content="📖 Lịch sử toán học" Click="OpenHistory_Click" Padding="14,10" FontSize="14" FontWeight="Bold" Background="White" Foreground="{StaticResource BrandPrimary}" BorderBrush="#BBDEFB" BorderThickness="1" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="btnExport" Content="💾 Xuất ảnh" Click="Export_Click" Padding="14,10" FontSize="14" FontWeight="Bold" Background="White" Foreground="#2E7D32" BorderBrush="#C8E6C9" BorderThickness="1" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <ToggleButton x:Name="btnDarkMode" Content="☀️ Sáng" Click="ToggleDarkMode_Click" Padding="14,10" FontSize="14" FontWeight="Bold" Background="White" Foreground="#E65100" BorderBrush="#FFE0B2" BorderThickness="1" Cursor="Hand">
                        <ToggleButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></ToggleButton.Resources>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>
 
        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="1" Background="Transparent" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (Derivative themed) -->
            <Grid Grid.Column="0" Background="#E3F2FD">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Tính toán &amp; Ví dụ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#BBDEFB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="0">
                <!-- VIEW 0: HƯỚNG DẪN CHI TIẾT -->
                <ScrollViewer x:Name="contentGuide" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20">
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Guide Title Card -->
                        <Border Background="#E3F2FD" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#BBDEFB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📖 Hướng Dẫn Sử Dụng Chi Tiết" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                <TextBlock Text="Quy trình 4 bước đơn giản giúp giáo viên giảng dạy và học sinh tự học Đạo hàm hiệu quả." FontSize="13" Foreground="#1976D2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
 
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
 
                            <!-- Left: Steps (Timeline layout) -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <!-- Step 1 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimary}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Chọn chế độ đạo hàm phù hợp" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Chọn Đơn thức, Đa thức bậc 3, Hàm đặc biệt (Lượng giác, Mũ, Log) hoặc Tiếp tuyến tại khay chức năng." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 2 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimary}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nhập hệ số hoặc chọn dữ liệu mẫu" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Nhập hệ số (a, b, c, d, số mũ n) hoặc nhấp nhanh vào một trong các 'Ví dụ mẫu nhanh' để tự động nạp bài toán thực tế chuẩn." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 3 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimary}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Đọc phân tích &amp; Bảng biến thiên" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Xem kết quả đạo hàm f'(x), f''(x), các điểm cực trị (cực đại/cực tiểu) và hướng biến thiên tăng/giảm đồng biến nghịch biến sinh động ở cột phải." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 4 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimary}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Mở đồ thị &amp; Xem lời giải chi tiết" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Bấm 'Xem đồ thị' để mô phỏng tương tác Desmos hoặc 'Xem lời giải chi tiết' để xem các bước giải chi tiết bằng tiếng Việt trình bày chuẩn sư phạm." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
 
                            <!-- Right: Tips and Guides -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="💡 Phương pháp tự học tốt nhất" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                                        </Border>
                                        <TextBlock Text="• Bước 1: Hãy tự giải bài tập đạo hàm ra giấy nháp trước." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Bước 2: Nhập bài toán vào công cụ để đối chiếu kết quả đạo hàm." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Bước 3: So sánh Bảng biến thiên và các điểm cực trị để tìm ra lỗi sai." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Bước 4: Mở 'Xem lời giải chi tiết' để đối chiếu từng bước biến đổi công thức." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>
 
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <Border Background="#E1F5FE" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="💾 Tiện ích cho giáo viên" FontSize="14" FontWeight="Bold" Foreground="#0277BD"/>
                                        </Border>
                                        <TextBlock Text="• Bấm nút 'Xuất ảnh' ở góc trên để lưu ảnh bài giảng sắc nét." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                        <TextBlock Text="• File ảnh lưu định dạng PNG, dễ dàng chèn vào PowerPoint, Word làm đề thi hoặc giáo án." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Sử dụng 'Lịch sử toán học' để tìm hiểu quá trình phát triển đạo hàm của các nhà bác học Newton &amp; Leibniz giúp bài học sinh động hơn." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
 
                <!-- VIEW 1: TÍNH TOÁN CHÍNH -->
                <ScrollViewer x:Name="contentCalc" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Visible">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
 
                        <!-- LEFT COLUMN: Input & Settings -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <!-- Mode Selector -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📋 Chọn chức năng" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="modePanel"/>
                                </StackPanel>
                            </Border>
 
                            <!-- Quick Examples / Presets -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#C8E6C9" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="💡 Ví dụ mẫu nhanh (Click để tải dữ liệu)" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="btnExPower" Content="1. Đơn thức y = 3x²" Click="PresetExample_Click" Tag="power" Margin="0,0,8,6" Padding="14,10" FontSize="14" FontWeight="SemiBold" Background="#F1F8E9" Foreground="#33691E" BorderBrush="#C5E1A5" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="btnExPoly" Content="2. Cực trị y = x³ - 3x² + 2" Click="PresetExample_Click" Tag="poly" Margin="0,0,8,6" Padding="14,10" FontSize="14" FontWeight="SemiBold" Background="#E8F5E9" Foreground="#2E7D32" BorderBrush="#A5D6A7" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="btnExSpecialSin" Content="3. Hàm đặc biệt y = sin(x)" Click="PresetExample_Click" Tag="spec_sin" Margin="0,0,8,6" Padding="14,10" FontSize="14" FontWeight="SemiBold" Background="#E3F2FD" Foreground="#1565C0" BorderBrush="#90CAF9" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="btnExSpecialExp" Content="4. Hàm mũ y = eˣ" Click="PresetExample_Click" Tag="spec_exp" Margin="0,0,8,6" Padding="14,10" FontSize="14" FontWeight="SemiBold" Background="#E3F2FD" Foreground="#1565C0" BorderBrush="#90CAF9" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="btnExTangent" Content="5. Tiếp tuyến y = x³ - 3x tại x₀ = 1" Click="PresetExample_Click" Tag="tangent" Margin="0,0,8,6" Padding="14,10" FontSize="14" FontWeight="SemiBold" Background="#FFF3E0" Foreground="#E65100" BorderBrush="#FFCC80" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
 
                            <!-- Calculator Section -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="txtModeTitle" Text="📐 Tính đạo hàm — f'(x)" FontSize="20"
                                               FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,16"/>
 
                                    <StackPanel x:Name="powerInput">
                                        <TextBlock Text="f(x) = a · xⁿ (đơn thức)" FontSize="16" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="a =" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtCoeff" FontSize="20" Padding="12,8"
                                                     Width="90" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                     Background="#F5F9FF" TextChanged="Input_Changed" Text="3" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="n =" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtPower" FontSize="20" Padding="12,8"
                                                     Width="90" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                     Background="#F5F9FF" TextChanged="Input_Changed" Text="2" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
 
                                    <!-- Polynomial Input -->
                                    <StackPanel x:Name="polyInput" Visibility="Collapsed">
                                        <TextBlock Text="f(x) = ax³ + bx² + cx + d" FontSize="16" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="a" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtPolyA" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="1" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="b" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtPolyB" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="-3" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                <TextBlock Text="c" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtPolyC" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="0" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="d" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtPolyD" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="2" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
 
                                    <!-- Special Input -->
                                    <StackPanel x:Name="specialInput" Visibility="Collapsed">
                                        <TextBlock Text="Chọn loại hàm số đặc biệt:" FontSize="16" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,12"/>
                                        <WrapPanel x:Name="specialFuncPanel" Margin="0,0,0,12"/>
                                        <TextBlock x:Name="lblSpecialFormula" Text="y = sin(x)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
 
                                    <!-- Tangent Input -->
                                    <StackPanel x:Name="tangentInput" Visibility="Collapsed">
                                        <TextBlock Text="Hàm y = ax³ + bx² + cx + d tại điểm x₀" FontSize="16" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="a" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtTanA" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="1" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="b" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtTanB" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="0" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                <TextBlock Text="c" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtTanC" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="-3" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="d" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,6"/>
                                                <TextBox x:Name="txtTanD" FontSize="18" Padding="10,6" TextChanged="Input_Changed" Text="0" Background="#F5F9FF" BorderThickness="0,0,0,2" BorderBrush="#BBDEFB"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Điểm hoành độ x₀ =" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtTanX0" FontSize="20" Padding="12,8"
                                                     Width="90" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                     Background="#F5F9FF" TextChanged="Input_Changed" Text="1" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
 
                        <!-- RIGHT COLUMN: Results & Graph Button -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <!-- Results -->
                            <Border x:Name="resultsCard" Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#C8E6C9" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="lblResultsTitle" Text="✅ Kết quả &amp; Phân tích" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="resultPanel"/>
                                    
                                    <!-- Bảng Biến Thiên Section -->
                                    <StackPanel x:Name="variationPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="lblVariationTitle" Text="📊 Bảng biến thiên (Chiều biến thiên)" FontSize="14" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="variationContent"/>
                                    </StackPanel>
 
                                    <!-- Step-by-Step Solution Section -->
                                    <StackPanel Margin="0,12,0,0">
                                        <WrapPanel Margin="0,0,0,0">
                                            <Button x:Name="btnSolutionToggle" Content="🔍 Xem lời giải chi tiết" Click="ToggleSolution_Click" Padding="14,10" FontSize="14" FontWeight="Bold" Background="#F5F5F5" Foreground="#424242" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand" Margin="0,0,8,6">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="btnCopySolution" Content="📋 Sao chép lời giải" Click="CopySolution_Click" Padding="14,10" FontSize="14" FontWeight="Bold" Background="#F5F5F5" Foreground="#424242" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand" Margin="0,0,8,6">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="btnCopyLaTeX" Content="📐 Sao chép LaTeX" Click="CopyLaTeX_Click" Padding="14,10" FontSize="14" FontWeight="Bold" Background="#F5F5F5" Foreground="#424242" BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand" Margin="0,0,0,6">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </WrapPanel>
                                        <Border x:Name="solutionBorder" Background="#FFFDE7" CornerRadius="8" Padding="16" Margin="0,8,0,0" BorderBrush="#FFF9C4" BorderThickness="1" Visibility="Collapsed">
                                            <TextBlock x:Name="txtSolution" FontSize="15" TextWrapping="Wrap" Foreground="#333333" LineHeight="22"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
 
                            <!-- Formula Reference -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📖 Bảng Công Thức Đạo Hàm" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="formulaPanel"/>
                                </StackPanel>
                            </Border>
 
                            <!-- Graph Button -->
                            <Border Background="#E3F2FD" CornerRadius="14" Padding="16,12" Margin="0" Cursor="Hand"
                                    MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                                        <TextBlock Text="Hàm số + Đạo hàm + Tiếp tuyến" FontSize="12" Foreground="#1976D2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
 
                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" Visibility="Collapsed" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="20">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>