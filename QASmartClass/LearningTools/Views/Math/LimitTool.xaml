<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.LimitTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">
    <Grid x:Name="mainGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
 
        <!-- HEADER -->
        <Border x:Name="headerBorder" Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E3F2FD" Offset="0"/>
                    <GradientStop Color="#BBDEFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblHeaderTitle" Text="∞ Giới Hạn" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock x:Name="lblHeaderSub" Text="Lớp 11 • Giới hạn dãy số, hàm số, dạng vô định" FontSize="14" Foreground="#1976D2" Margin="0,4,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
 
        <!-- MAIN LAYOUT (Master-Detail) -->
        <Grid Grid.Row="1" Background="Transparent" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU (Blue themed) -->
            <Grid Grid.Column="0" Background="#E3F2FD">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractice" Text="Tính toán &amp; Lý thuyết" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#BBDEFB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="0">
                <!-- VIEW 0: HƯỚNG DẪN CHI TIẾT -->
                <ScrollViewer x:Name="contentGuide" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20">
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Guide Title Card -->
                        <Border Background="#E3F2FD" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#BBDEFB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📖 Hướng Dẫn Học Giới Hạn (Limit)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                <TextBlock Text="Quy trình 4 bước giúp bạn làm chủ lý thuyết và phương pháp tính giới hạn nhanh chóng." FontSize="13" Foreground="#1976D2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
 
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
 
                            <!-- Left: Steps -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <!-- Step 1 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimary}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Chọn chế độ giới hạn phù hợp" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Chọn Giới hạn hàm phân thức (lim f/g), Giới hạn dãy số (n → ∞), hoặc Giới hạn đặc biệt cần nhớ ở bảng chức năng." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 2 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimary}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nhập hệ số &amp; điểm hội tụ x₀" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Điền các hệ số tử số a, b, c và mẫu số d, e, f. Nhập điểm x₀ hoặc bấm nút '∞' để chuyển sang giới hạn vô cực." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Step 3 -->
                                <Border Background="#F4F8FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E3F2FD" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrandPrimary}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Đọc kết quả phân tích chi tiết" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Hệ thống tự động tính giới hạn, hiển thị nhận xét về bậc của đa thức hoặc dạng vô định (0/0), giúp học sinh hiểu sâu bản chất biến đổi." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
 
                            <!-- Right: Tips -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="💡 Phương pháp xử lý dạng vô cực" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                                        </Border>
                                        <TextBlock Text="• Nếu bậc tử lớn hơn bậc mẫu, giới hạn luôn tiến về vô cực." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Nếu bậc tử bằng bậc mẫu, giới hạn bằng tỷ lệ của hai hệ số dẫn đầu." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Nếu bậc tử nhỏ hơn bậc mẫu, giới hạn luôn bằng 0." FontSize="14" Foreground="#424242" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
 
                <!-- VIEW 1: TÍNH TOÁN CHÍNH -->
                <ScrollViewer x:Name="contentCalc" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Visible">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
 
                        <!-- LEFT COLUMN: Input & Settings -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <!-- Mode Selector -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📋 Chọn chức năng" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="modePanel"/>
                                </StackPanel>
                            </Border>
 
                            <!-- Calculator Section -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="txtModeTitle" Text="∞ Giới hạn đa thức" FontSize="18"
                                               FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,16"/>
 
                                    <!-- Polynomial limit -->
                                    <StackPanel x:Name="polyInput">
                                        <TextBlock Text="lim  f(x)/g(x)  khi x → x₀" FontSize="16" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,12"/>
                                        <TextBlock Text="Tử số: f(x) = ax² + bx + c" FontSize="15" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,12">
                                                <TextBlock Text="a =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,6,0"/>
                                                <TextBox x:Name="txtNA" FontSize="20" Padding="10,6"
                                                         Width="70" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#FFF8F0" TextChanged="Input_Changed" Text="1" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,12">
                                                <TextBlock Text="b =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,6,0"/>
                                                <TextBox x:Name="txtNB" FontSize="20" Padding="10,6"
                                                         Width="70" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#FFF8F0" TextChanged="Input_Changed" Text="-3" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,12">
                                                <TextBlock Text="c =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,6,0"/>
                                                <TextBox x:Name="txtNC" FontSize="20" Padding="10,6"
                                                         Width="70" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#FFF8F0" TextChanged="Input_Changed" Text="2" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="Mẫu số: g(x) = dx² + ex + f" FontSize="15" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,12">
                                                <TextBlock Text="d =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,6,0"/>
                                                <TextBox x:Name="txtDA" FontSize="20" Padding="10,6"
                                                         Width="70" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#FFF8F0" TextChanged="Input_Changed" Text="0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,12">
                                                <TextBlock Text="e =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,6,0"/>
                                                <TextBox x:Name="txtDB" FontSize="20" Padding="10,6"
                                                         Width="70" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#FFF8F0" TextChanged="Input_Changed" Text="1" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,12">
                                                <TextBlock Text="f =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,6,0"/>
                                                <TextBox x:Name="txtDC" FontSize="20" Padding="10,6"
                                                         Width="70" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                         Background="#FFF8F0" TextChanged="Input_Changed" Text="-1" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="x₀ =" FontSize="16" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtX0" FontSize="20" Padding="10,6"
                                                     Width="80" BorderBrush="#BBDEFB" BorderThickness="0,0,0,2"
                                                     Background="#FFF8F0" TextChanged="Input_Changed" Text="1" FontWeight="SemiBold"/>
                                            <Border x:Name="btnInfinity" Background="#E3F2FD" CornerRadius="8" Padding="14,8" Margin="12,0,0,0"
                                                    Cursor="Hand" MouseLeftButtonDown="Infinity_Click" BorderBrush="#BBDEFB" BorderThickness="1">
                                                <TextBlock x:Name="txtInfinity" Text="∞" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
 
                                    <!-- Sequence limit -->
                                    <StackPanel x:Name="seqInput" Visibility="Collapsed">
                                        <TextBlock Text="lim (aₙ) khi n → ∞" FontSize="16" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,12"/>
                                        <TextBlock Text="Chọn dạng dãy số:" FontSize="15" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,8"/>
                                        <WrapPanel x:Name="seqTypePanel"/>
                                    </StackPanel>
 
                                    <!-- Special limits -->
                                    <StackPanel x:Name="specialInput" Visibility="Collapsed">
                                        <TextBlock Text="Giới hạn đặc biệt cần nhớ" FontSize="16" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,12"/>
                                        <WrapPanel x:Name="specialPanel"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
 
                        <!-- RIGHT COLUMN: Results & Info -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <!-- Results -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#C8E6C9" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="✅ Kết quả &amp; Phân tích" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="resultPanel"/>
                                </StackPanel>
                            </Border>
 
                            <!-- Formula Reference -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16"
                                    BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📖 Lý Thuyết Giới Hạn" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="formulaPanel"/>
                                </StackPanel>
                            </Border>
 
                            <!-- Graph Button -->
                            <Border Background="#E3F2FD" CornerRadius="14" Padding="16,12" Margin="0" Cursor="Hand"
                                    MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#BBDEFB" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                        <TextBlock Text="Minh họa giới hạn hàm số" FontSize="12" Foreground="#1976D2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
 
                <!-- VIEW 2: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" Visibility="Collapsed" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="20">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>