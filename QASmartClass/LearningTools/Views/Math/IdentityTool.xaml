<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Math.IdentityTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="#F5F5F7"
             SizeChanged="IdentityTool_SizeChanged">
             
    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="0" Padding="20,14" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                    <GradientStop Color="#1A237E" Offset="0"/>
                    <GradientStop Color="#303F9F" Offset="0.5"/>
                    <GradientStop Color="#5C6BC0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="📐" FontSize="36" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Id_Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{DynamicResource Id_Subtitle}" FontSize="13" Foreground="#B3C4FF" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E8EAF6">
                <!-- Math Category: Blue hover/selected -->
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTable" Text="Bảng hằng đẳng thức" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextVerify" Text="Khảo sát &amp; Tính toán" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📐" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGeo" Text="Minh họa hình học" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTips" Text="Mẹo ghi nhớ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#C5CAE9"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C5CAE9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C5CAE9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: BẢNG HẰNG ĐẲNG THỨC -->
                <ScrollViewer x:Name="viewTable" VerticalScrollBarVisibility="Auto" Padding="4" Visibility="Collapsed">
                    <StackPanel x:Name="identityPanel" Margin="4,8,4,8"/>
                </ScrollViewer>

                <!-- VIEW 2: KHẢO SÁT & TÍNH TOÁN -->
                <ScrollViewer x:Name="viewVerify" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="12,8,12,12">
                        <!-- Input bar -->
                        <Border Background="White" CornerRadius="10" Padding="20,14" Margin="0,0,0,14" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Id_VerifyHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#1A237E" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Id_InputA}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Background="#E8EAF6" CornerRadius="8" Padding="2">
                                        <TextBox x:Name="txtA" MaxLength="8" FontSize="22" Width="90" Padding="8,4" BorderThickness="0" Background="Transparent" TextChanged="Verify_Changed" Text="3" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Id_InputB}" FontSize="18" FontWeight="Bold" Foreground="#7B1FA2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Background="#F3E5F5" CornerRadius="8" Padding="2">
                                        <TextBox x:Name="txtB" MaxLength="8" FontSize="22" Width="90" Padding="8,4" BorderThickness="0" Background="Transparent" TextChanged="Verify_Changed" Text="2" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Id_QuickLabel}" FontSize="13" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="1, 1" Tag="1|1" Click="QuickValue_Click" Margin="3" Padding="10,5" Background="#E8EAF6" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#283593"/>
                                    <Button Content="2, 3" Tag="2|3" Click="QuickValue_Click" Margin="3" Padding="10,5" Background="#E8EAF6" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#283593"/>
                                    <Button Content="5, 2" Tag="5|2" Click="QuickValue_Click" Margin="3" Padding="10,5" Background="#E8EAF6" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#283593"/>
                                    <Button Content="10, 3" Tag="10|3" Click="QuickValue_Click" Margin="3" Padding="10,5" Background="#E8EAF6" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#283593"/>
                                    <Button Content="7, 4" Tag="7|4" Click="QuickValue_Click" Margin="3" Padding="10,5" Background="#E8EAF6" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#283593"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        
                        <WrapPanel x:Name="verifyPanel" Orientation="Horizontal"/>

                        <!-- Graph -->
                        <Border Background="#E3F2FD" CornerRadius="10" Padding="10,8" Margin="0,12,0,0" Cursor="Hand" MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📈" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Id_GraphButton}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBlock Text="(a+b)² vs a²+2ab+b²" FontSize="13" Foreground="#1976D2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 3: MINH HỌA HÌNH HỌC -->
                <ScrollViewer x:Name="viewGeo" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="12,8,12,12">
                        <!-- Input bar -->
                        <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Id_SelectPrompt}" FontSize="14" FontWeight="SemiBold" Foreground="#1A237E" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="geoSelectorPanel"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Id_ValueLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="a =" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border Background="#E8EAF6" CornerRadius="8" Padding="2" Margin="0,0,16,0">
                                            <TextBox x:Name="txtGeoA" MaxLength="8" FontSize="18" Width="70" Padding="6,4" BorderThickness="0" Background="Transparent" Text="3" TextChanged="Geo_Changed" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="b =" FontSize="14" FontWeight="SemiBold" Foreground="#7B1FA2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border Background="#F3E5F5" CornerRadius="8" Padding="2">
                                            <TextBox x:Name="txtGeoB" MaxLength="8" FontSize="18" Width="70" Padding="6,4" BorderThickness="0" Background="Transparent" Text="2" TextChanged="Geo_Changed" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Explosion slider for 3D view -->
                                    <StackPanel x:Name="panel3DControls" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Id_Explosion}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="sliderExplosion" Minimum="0" Maximum="1" Value="0" Width="140" VerticalAlignment="Center" ValueChanged="SliderExplosion_ValueChanged"/>
                                        <TextBlock Text="🖱️" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{DynamicResource Id_DragRotate}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Geometric diagram -->
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="geoTitle" FontSize="18" FontWeight="Bold" Foreground="#1A237E" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Grid>
                                    <!-- 2D Canvas -->
                                    <Canvas x:Name="geoCanvas" Height="400" HorizontalAlignment="Center" ClipToBounds="True" Visibility="Visible"/>
                                    <!-- 3D Viewport -->
                                    <Grid x:Name="panel3D" Height="400" Visibility="Collapsed" Background="#F8F9FA">
                                        <Viewport3D x:Name="viewport3D" Focusable="True" Cursor="Hand"
                                                    MouseLeftButtonDown="Viewport3D_MouseLeftButtonDown"
                                                    MouseMove="Viewport3D_MouseMove"
                                                    MouseLeftButtonUp="Viewport3D_MouseLeftButtonUp"/>
                                        
                                        <!-- Color Legend Overlay -->
                                        <Border x:Name="panel3DLegend" Background="#D0FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <StackPanel Orientation="Vertical">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Rectangle Width="12" Height="12" Fill="#2196F3" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="a³" FontSize="12" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Rectangle Width="12" Height="12" Fill="#FF9800" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="3a²b" FontSize="12" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Rectangle Width="12" Height="12" Fill="#9C27B0" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="3ab²" FontSize="12" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Rectangle Width="12" Height="12" Fill="#4CAF50" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="b³" FontSize="12" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reset View Button Overlay -->
                                        <Button x:Name="btnResetView" Width="36" Height="36" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,12" Click="ResetView_Click" Cursor="Hand" ToolTip="Đặt lại góc nhìn / Reset View" Background="#E0FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFFFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#1565C0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="↺" FontSize="18" FontWeight="Bold" Foreground="#1565C0"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Explanation -->
                        <StackPanel x:Name="geoExplainPanel"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 4: MẸO GHI NHỚ -->
                <ScrollViewer x:Name="viewTips" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <WrapPanel x:Name="tipsPanel" Orientation="Horizontal" Margin="8"/>
                </ScrollViewer>

                <!-- VIEW 5: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>