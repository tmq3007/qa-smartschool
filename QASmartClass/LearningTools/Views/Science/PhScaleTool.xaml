<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Science.PhScaleTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F3E5F5" Offset="0"/>
                    <GradientStop Color="#E1BEE7" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#6A1B9A" CornerRadius="8" Padding="14,8" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="ResetAll_Click" ToolTip="Đặt lại về 0.001 mol/L">
                    <TextBlock Text="🔄 Reset" FontSize="14" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="🧪 Thang pH" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A"/>
                    <TextBlock Text="Lớp 10-12 • Axit ↔ Trung tính ↔ Kiềm • Tính pH từ [H⁺]" FontSize="14" Foreground="#AB47BC" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#F3E5F5">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C8E6C9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E7D32"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextScale" Text="Thang pH" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextCalculator" Text="Tính pH" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#E1BEE7"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C8E6C9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: pH SCALE -->
                <ScrollViewer x:Name="viewScale" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="12">
                        <StackPanel x:Name="phScalePanel"/>
                        <StackPanel x:Name="phExamplesPanel" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: CALCULATOR -->
                <ScrollViewer x:Name="viewCalculator" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Formula card -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E1BEE7" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#6A1B9A" Offset="0"/>
                                                <GradientStop Color="#AB47BC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="pH" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="pH = -log₁₀[H⁺]" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A"/>
                                        <TextBlock Text="pH + pOH = 14  •  [H⁺]×[OH⁻] = 10⁻¹⁴" FontSize="14" Foreground="#AB47BC" Margin="0,4,0,0"/>
                                        <TextBlock Text="Giá trị pH càng thấp → tính axit càng mạnh" FontSize="12" Foreground="#90A4AE" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Input -->
                            <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📝 Nhập nồng độ [H⁺] để tính pH, pOH, [OH⁻]" FontSize="14" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,16"/>
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Nồng độ [H⁺]" FontSize="14" FontWeight="SemiBold" Foreground="#6A1B9A"/>
                                                <TextBlock Text="concentration" FontSize="12" Foreground="#CE93D8" FontStyle="Italic"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtHConc" Grid.Column="1" FontSize="20" Padding="10,8" Text="0.001" FontWeight="SemiBold" TextChanged="PhCalc_Changed" BorderBrush="#CE93D8" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="mol/L" FontSize="14" Foreground="#6A1B9A" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="0,16,0,0">
                                        <DockPanel>
                                            <TextBlock Text="🎚️ Hoặc điều chỉnh nhanh bằng Thang pH" FontSize="13" FontWeight="SemiBold" Foreground="#757575"/>
                                            <TextBlock x:Name="lblSliderVal" Text="pH = 3,0" FontSize="13" FontWeight="Bold" Foreground="#6A1B9A" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Slider x:Name="sliderPhControl" Minimum="0" Maximum="14" Value="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="SliderPh_ValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Quick presets -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="⚡ Tính nhanh — chọn nồng độ" FontSize="14" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="phPresetPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Results -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <StackPanel x:Name="phCalcResultPanel"/>
                            <!-- Graph -->
                            <Border Background="#E3F2FD" CornerRadius="14" Padding="16,12" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị pH Graph" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                        <TextBlock Text="pH = −log₁₀[H⁺]" FontSize="12" Foreground="#1976D2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VIEW 3: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>