<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Science.UnitConverterTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="#F5F5FA">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F3E5F5" Offset="0"/>
                    <GradientStop Color="#E1BEE7" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="📏 Đổi Đơn Vị — Unit Converter" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A"/>
                <TextBlock Text="Hỗ trợ 10 loại đơn vị • Chiều dài, Khối lượng, Nhiệt độ, Diện tích, Thể tích, Thời gian, Năng lượng, Tốc độ, Áp suất, Dữ liệu" FontSize="14" Foreground="#8E24AA" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#F3E5F5">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C8E6C9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E7D32"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextConverter" Text="Quy đổi" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#E1BEE7"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C8E6C9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: CONVERTER -->
                <ScrollViewer x:Name="viewConverter" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                    <StackPanel Margin="0">
                        <!-- LOẠI ĐƠN VỊ -->
                        <WrapPanel x:Name="unitTypePanel" Margin="0,0,0,12"/>

                        <!-- PRESETS FOR UNIT CONVERSION -->
                        <Border Background="White" CornerRadius="12" Padding="16,10" Margin="0,0,0,12" BorderBrush="#E3E8EE" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡 Thử nhanh ví dụ mẫu:" FontSize="13.5" FontWeight="Bold" Foreground="#6A1B9A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="📏 Chiều dài địa lý (1 km → m)" Margin="0,2,8,2" Padding="8,4" Background="#F3E5F5" Foreground="#7B1FA2" BorderThickness="0" Cursor="Hand" Click="PresetConversion_Click" Tag="LengthGeo">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="⚖️ Khối lượng thương mại (1.5 tấn → kg)" Margin="0,2,8,2" Padding="8,4" Background="#FFF3E0" Foreground="#E65100" BorderThickness="0" Cursor="Hand" Click="PresetConversion_Click" Tag="MassComm">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="💾 Dung lượng công nghệ (1 GB → MB)" Margin="0,2,0,2" Padding="8,4" Background="#E0F7FA" Foreground="#00838F" BorderThickness="0" Cursor="Hand" Click="PresetConversion_Click" Tag="DataTech">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <!-- CONVERTER CHÍNH -->
                                <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,14" BorderBrush="#E3E8EE" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="txtCurrentType" Text="📏 Chiều dài" FontSize="18" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,0,0,10"/>
                                        <Border Background="#F9F9FB" CornerRadius="8" Padding="12,8" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💡 Chỉ dẫn quy đổi:" FontWeight="Bold" Foreground="#6A1B9A" FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bước 1: Chọn nhóm đơn vị (trên) ➜ Bước 2: Chọn đơn vị và Nhập số (ô TỪ) ➜ Bước 3: Xem kết quả (ô SANG)" Foreground="#555555" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- FROM -->
                                            <Border Grid.Column="0" Background="#F8FAFE" CornerRadius="12" Padding="16,12" BorderBrush="#E3E8EE" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="TỪ" FontSize="14" FontWeight="Bold" Foreground="#9E9E9E" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="cboFromUnit" FontSize="14" Padding="8,6" Margin="0,0,0,12" SelectionChanged="Convert_UnitChanged"/>
                                                    <TextBox x:Name="txtFromValue" FontSize="26" FontWeight="Bold" Text="1" Background="Transparent" BorderThickness="0" Foreground="#1A237E" TextChanged="Convert_Changed" Padding="2"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- SWAP -->
                                            <Button Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Click="SwapUnits_Click" ToolTip="Hoán đổi" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F3E5F5" CornerRadius="24" Width="48" Height="48">
                                                            <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                 <Setter TargetName="bd" Property="Background" Value="#E1BEE7"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- TO -->
                                            <Border Grid.Column="2" CornerRadius="12" Padding="16,12" BorderBrush="#CE93D8" BorderThickness="1.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#F3E5F5" Offset="0"/>
                                                        <GradientStop Color="#EDE7F6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock Text="SANG" FontSize="14" FontWeight="Bold" Foreground="#9E9E9E" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="cboToUnit" FontSize="14" Padding="8,6" Margin="0,0,0,12" SelectionChanged="Convert_UnitChanged"/>
                                                    <TextBox x:Name="txtToValue" FontSize="26" FontWeight="Bold" Foreground="#4A148C" IsReadOnly="True" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Focusable="True"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- FORMULA -->
                                        <Border Background="{StaticResource Gray100}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                                            <TextBlock x:Name="txtConvertFormula" Text="" FontSize="14" Foreground="#616161" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <!-- BẢNG QUY ĐỔI NHANH -->
                                <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,14" BorderBrush="#E3E8EE" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="📋 Bảng quy đổi nhanh" FontSize="16" FontWeight="Bold" Foreground="#4A148C" Margin="0,0,0,12"/>
                                        <StackPanel x:Name="quickRefPanel"/>
                                    </StackPanel>
                                </Border>

                                <!-- LỊCH SỬ ĐỔI -->
                                <Border Background="White" CornerRadius="14" Padding="20,16" BorderBrush="#E3E8EE" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button x:Name="btnClearHistory" DockPanel.Dock="Right" Content="🗑️ Xóa" FontSize="14" Padding="12,8" Background="#FFF3E0" Foreground="{StaticResource BrandAccent}" BorderThickness="0" Cursor="Hand" Click="ClearHistory_Click"/>
                                            <TextBlock Text="📜 Lịch sử quy đổi" FontSize="16" FontWeight="Bold" Foreground="#4A148C" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel x:Name="historyPanel"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
