<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Science.WaveSpeedTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E8F5E9" Offset="0"/>
                    <GradientStop Color="#C8E6C9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#2E7D32" CornerRadius="8" Padding="14,8" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="ResetAll_Click" ToolTip="Đặt lại tất cả">
                    <TextBlock Text="🔄 Reset" FontSize="14" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="🔊 Tốc Độ Sóng" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock Text="Lớp 11-12 • v = f·λ • Âm thanh, ánh sáng, Doppler" FontSize="14" Foreground="#1B5E20" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E8F5E9">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C8E6C9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E7D32"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextCalculator" Text="Tính toán" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌈" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextSpectrum" Text="Phổ sóng" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextConstants" Text="Hằng số" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔬" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextMedium" Text="Môi trường" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#C8E6C9"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
<!-- Guide Header -->
                        <Border Background="#E8F5E9" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📖 Hướng Dẫn Sử Dụng Công Cụ Tốc Độ Sóng" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                                <TextBlock Text="Dành cho Giáo viên và Học sinh: Tìm hiểu công thức v = f·λ, hiệu ứng Doppler, phổ sóng điện từ và khảo sát trực quan vận tốc truyền sóng trong các môi trường khác nhau." FontSize="13" Foreground="#2E7D32" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Operating steps -->
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#E3E8EE" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🚀 Các Bước Thao Tác Trực Quan" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>
                                <Border Background="#F9FBE7" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F0F4C3" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#2E7D32" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Bước 1: Chọn loại sóng và nhập các giá trị" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" Margin="0,0,0,4"/>
                                            <TextBlock Text="Chọn loại sóng (Sóng cơ hoặc Sóng điện từ) ở hộp chọn. Sau đó, nhập 2 trong 3 đại lượng: Tần số (f), Bước sóng (λ) hoặc Vận tốc (v). Giá trị còn lại sẽ tự động được tính toán." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#F9FBE7" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#F0F4C3" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#2E7D32" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Bước 2: Phân tích kết quả và Năng lượng" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" Margin="0,0,0,4"/>
                                            <TextBlock Text="Xem kết quả tính toán chi tiết hiển thị ở cột bên phải. Nếu là Sóng điện từ, hệ thống sẽ tự động tính toán thêm lượng tử năng lượng của photon (E = h·f) với định dạng số mũ chuẩn khoa học sư phạm." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Sample Data Table -->
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📊 Bảng Số Liệu Thực Hành Mẫu" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,12"/>
                                <TextBlock Text="Giáo viên và học sinh có thể sử dụng các bộ số liệu sau đây để nhanh chóng minh họa các trường hợp điển hình trong SGK:" FontSize="13" Foreground="#555555" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="5*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Header Row -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#2E7D32" Padding="8,6" CornerRadius="4,0,0,0">
                                        <TextBlock Text="Trường hợp" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#2E7D32" Padding="8,6">
                                        <TextBlock Text="Dữ liệu nhập" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" Background="#2E7D32" Padding="8,6" CornerRadius="0,4,0,0">
                                        <TextBlock Text="Mục đích Sư phạm &amp; Kết quả tự tính" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <!-- Row 1 -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <TextBlock Text="1️⃣ Âm thanh nghe được (La 4)" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <TextBlock Text="f = 440 Hz, v = 343 m/s" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" Background="#F9FBE7" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Tính ra bước sóng λ ≈ 0,78 m. Đây là tần số nốt La chuẩn phục vụ lên dây nhạc cụ." FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Border>
                                    <!-- Row 2 -->
                                    <Border Grid.Row="2" Grid.Column="0" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <TextBlock Text="2️⃣ Siêu âm chẩn đoán y tế" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <TextBlock Text="f = 5 MHz, v = 1540 m/s" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Tính ra bước sóng λ ≈ 0,31 mm. Bước sóng ngắn giúp hiển thị các cấu trúc cực nhỏ của mô." FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: CALCULATOR -->
                <ScrollViewer x:Name="viewCalculator" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Formula display -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E3F2FD" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1976D2" Offset="0"/>
                                                <GradientStop Color="#42A5F5" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="v" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}">
                                            <Run Text="v = f × λ"/>
                                        </TextBlock>
                                        <TextBlock Text="Vận tốc = Tần số × Bước sóng" FontSize="12" Foreground="#90A4AE" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Input fields -->
                            <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📝 Nhập 2 trong 3 đại lượng — giá trị còn lại sẽ tự tính" FontSize="14" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,16"/>
                                    <!-- Wave Type Selection -->
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Loại sóng" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CatScience}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="cmbWaveType" Grid.Column="1" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="WaveType_Changed" SelectedIndex="0">
                                                <ComboBoxItem Content="Sóng cơ học (Âm thanh, nước...)"/>
                                                <ComboBoxItem Content="Sóng điện từ (Ánh sáng, vô tuyến...)"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Frequency input -->
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Tần số f" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtFreq" Grid.Column="1" FontSize="20" Padding="10,8" FontWeight="SemiBold" TextChanged="Wave_Changed" BorderBrush="#90CAF9" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                            <ComboBox x:Name="cmbFreqUnit" Grid.Column="2" Width="90" Margin="10,0,0,0" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="Wave_Changed" SelectedIndex="0">
                                                <ComboBoxItem Content="Hz"/>
                                                <ComboBoxItem Content="kHz"/>
                                                <ComboBoxItem Content="MHz"/>
                                                <ComboBoxItem Content="GHz"/>
                                                <ComboBoxItem Content="THz"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Wavelength input -->
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Bước sóng λ" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtWavelength" Grid.Column="1" FontSize="20" Padding="10,8" FontWeight="SemiBold" TextChanged="Wave_Changed" BorderBrush="#A5D6A7" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                            <ComboBox x:Name="cmbWaveUnit" Grid.Column="2" Width="90" Margin="10,0,0,0" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="Wave_Changed" SelectedIndex="0">
                                                <ComboBoxItem Content="m"/>
                                                <ComboBoxItem Content="cm"/>
                                                <ComboBoxItem Content="mm"/>
                                                <ComboBoxItem Content="μm"/>
                                                <ComboBoxItem Content="nm"/>
                                                <ComboBoxItem Content="km"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Velocity input -->
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Vận tốc v" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandAccent}"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtVelocity" Grid.Column="1" FontSize="20" Padding="10,8" FontWeight="SemiBold" TextChanged="Wave_Changed" BorderBrush="#FFAB91" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                            <ComboBox x:Name="cmbVelUnit" Grid.Column="2" Width="90" Margin="10,0,0,0" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="Wave_Changed" SelectedIndex="0">
                                                <ComboBoxItem Content="m/s"/>
                                                <ComboBoxItem Content="km/h"/>
                                                <ComboBoxItem Content="km/s"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Quick presets -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="⚡ Tính nhanh — chọn để tự điền" FontSize="14" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="presetPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Results -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <!-- Results -->
                            <StackPanel x:Name="waveResultPanel" Margin="0,0,0,16"/>
                            <!-- Graph -->
                            <Border Background="#E8F5E9" CornerRadius="14" Padding="16,12" Margin="0,0,0,16" Cursor="Hand" MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#A5D6A7" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị sóng" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CatScience}"/>
                                        <TextBlock Text="y = A·sin(kx − ωt) — trực quan sóng lan truyền" FontSize="12" Foreground="#2E7D32"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Doppler effect -->
                            <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,0" BorderBrush="#FFE0B2" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🚗 Hiệu Ứng Doppler" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccent}" Margin="0,0,0,6"/>
                                    <TextBlock Text="f' = f × (v ± v_o) / (v ∓ v_s)" FontSize="16" Foreground="#BF360C" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Tốc độ nguồn v_s (m/s)" FontSize="12" Foreground="#757575" Margin="0,0,0,6"/>
                                            <TextBox x:Name="txtSourceSpeed" FontSize="16" Padding="10,8" FontWeight="SemiBold" BorderBrush="#FFCC80" BorderThickness="0,0,0,2" Background="#FFF8E1" TextChanged="Doppler_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Tốc độ người quan sát v_o (m/s)" FontSize="12" Foreground="#757575" Margin="0,0,0,6"/>
                                            <TextBox x:Name="txtObserverSpeed" FontSize="16" Padding="10,8" FontWeight="SemiBold" BorderBrush="#FFCC80" BorderThickness="0,0,0,2" Background="#FFF8E1" TextChanged="Doppler_Changed" Text="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="dopplerResultPanel" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VIEW 2: WAVE SPECTRUM -->
                <ScrollViewer x:Name="viewSpectrum" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="12">
                        <StackPanel x:Name="spectrumPanel"/>
                        <StackPanel x:Name="spectrumDetailsPanel" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 3: CONSTANTS -->
                <ScrollViewer x:Name="viewConstants" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="constantsPanel" Margin="12"/>
                </ScrollViewer>

                <!-- VIEW 4: MEDIUM -->
                <ScrollViewer x:Name="viewMedium" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="mediumPanel" Margin="12"/>
                </ScrollViewer>

                <!-- VIEW 5: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
