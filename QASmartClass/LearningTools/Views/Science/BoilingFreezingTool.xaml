<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Science.BoilingFreezingTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER (Gradient + Reset) -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FBE9E7" Offset="0"/>
                    <GradientStop Color="#FFCCBC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#BF360C" CornerRadius="8" Padding="14,8" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="ResetAll_Click" ToolTip="Đặt lại 100°C" MinHeight="38">
                    <TextBlock Text="🔄 Reset" FontSize="14" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="🌡️ Nhiệt Độ Sôi / Đông đặc" FontSize="20" FontWeight="Bold" Foreground="#BF360C"/>
                    <TextBlock Text="Lớp 10-12 • Chuyển đổi °C ↔ °F ↔ K • Bảng nhiệt độ 20+ chất" FontSize="14" Foreground="#E64A19" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#FBE9E7">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C8E6C9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E7D32"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextConverter" Text="Chuyển đổi" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTable" Text="Bảng nhiệt độ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚖️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextCompare" Text="So sánh" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#FFCCBC"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C8E6C9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<Border Background="#FBE9E7" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#FFCCBC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 ĐIỂM SÔI &amp; ĐIỂM ĐÔNG ĐẶC CỦA CÁC CHẤT" FontWeight="Bold" Foreground="#BF360C" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="18">
                                    Nhiệt độ là đại lượng đặc trưng cho động năng trung bình của các phân tử. Điểm sôi là nhiệt độ mà tại đó áp suất hơi của chất lỏng bằng áp suất khí quyển xung quanh. Điểm đông đặc là nhiệt độ mà chất lỏng chuyển sang trạng thái rắn.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🎯 Các tính năng chính:" FontSize="15" FontWeight="Bold" Foreground="#BF360C" Margin="0,4,0,8"/>
                        <TextBlock Text="1. Chuyển đổi nhiệt độ: Nhập trị số bất kỳ để tự động đổi qua lại giữa Celsius (°C), Fahrenheit (°F) và Kelvin (K)." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="2. Bảng nhiệt độ các chất: Tra cứu nhanh nhiệt độ sôi và nóng chảy của hơn 20 nguyên tố và hợp chất phổ biến." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="3. Đồ thị &amp; So sánh trực quan: Xem biểu đồ so sánh nhiệt độ sôi của các chất và nhiệt kế động hiển thị trạng thái vật lý của nước." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: CONVERTER -->
                <ScrollViewer x:Name="viewConverter" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Formula card -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#FFCCBC" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#BF360C" Offset="0"/>
                                                <GradientStop Color="#E64A19" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="T" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="18" Foreground="#BF360C">
                                            <Run Text="°F = °C × 9/5 + 32" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Text="K = °C + 273.15" FontSize="16" Foreground="#E64A19" Margin="0,4,0,0"/>
                                        <TextBlock Text="Celsius ↔ Fahrenheit ↔ Kelvin" FontSize="13" Foreground="#90A4AE" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Input fields -->
                            <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📝 Nhập nhiệt độ ở bất kỳ thang đo nào – các thang còn lại tự chuyển đổi" FontSize="15" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,16"/>

                                    <!-- Warning Banner -->
                                    <Border x:Name="brdWarning" Background="#FFEBEE" CornerRadius="12" Padding="16,10" Margin="0,0,0,12" BorderBrush="#EF9A9A" BorderThickness="1" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Nhiệt độ đã được giới hạn ở Không tuyệt đối (-273.15°C / 0 K)!" FontSize="13" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Celsius -->
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Celsius  °C" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandAccent}"/>
                                                <TextBlock Text="thang bách phân" FontSize="13" Foreground="#FFAB91" FontStyle="Italic"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtC" Grid.Column="1" FontSize="20" Padding="10,8" FontWeight="SemiBold" TextChanged="TempBox_Changed" Tag="C" BorderBrush="#FFAB91" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center" Text="100"/>
                                            <TextBlock Grid.Column="2" Text="°C" FontSize="20" Foreground="{StaticResource BrandAccent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fahrenheit -->
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Fahrenheit  °F" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}"/>
                                                <TextBlock Text="thang Hoa Kỳ" FontSize="13" Foreground="#90CAF9" FontStyle="Italic"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtF" Grid.Column="1" FontSize="20" Padding="10,8" FontWeight="SemiBold" TextChanged="TempBox_Changed" Tag="F" BorderBrush="#90CAF9" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="°F" FontSize="20" Foreground="{StaticResource BrandPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Kelvin -->
                                    <Border Background="#F5F7FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Kelvin  K" FontSize="16" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                                <TextBlock Text="thang tuyệt đối" FontSize="13" Foreground="#A5D6A7" FontStyle="Italic"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtK" Grid.Column="1" FontSize="20" Padding="10,8" FontWeight="SemiBold" TextChanged="TempBox_Changed" Tag="K" BorderBrush="#A5D6A7" BorderThickness="0,0,0,2" Background="Transparent" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="K" FontSize="20" Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Quick presets -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="⚡ Tính nhanh – chọn để tự điền" FontSize="16" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="presetPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Results -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <!-- Thermometer visual -->
                            <StackPanel x:Name="thermometerPanel" Margin="0,0,0,16"/>

                            <!-- Graph -->
                            <Border Background="#E3F2FD" CornerRadius="14" Padding="16,12" Margin="0,0,0,0" Cursor="Hand" MouseLeftButtonDown="OpenGraph_Click" BorderBrush="#90CAF9" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Xem đồ thị" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                        <TextBlock Text="°C ↔ °F ↔ K – chuyển đổi nhiệt độ" FontSize="13" Foreground="#1976D2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Educational facts card -->
                            <Border x:Name="eduCard" Background="White" CornerRadius="14" Padding="20,16" Margin="0,16,0,0" BorderBrush="#FFCCBC" BorderThickness="1" Visibility="Visible">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="💡 Kiến Thức &amp; An Toàn Sư Phạm" FontSize="16" FontWeight="Bold" Foreground="#BF360C" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtEduText" FontSize="14" TextWrapping="Wrap" Foreground="#424242" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VIEW 2: TEMPERATURE TABLE -->
                <ScrollViewer x:Name="viewTable" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="tempTablePanel" Margin="12"/>
                </ScrollViewer>

                <!-- VIEW 3: COMPARISON -->
                <ScrollViewer x:Name="viewCompare" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="comparePanel" Margin="12"/>
                </ScrollViewer>

                <!-- VIEW 4: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>