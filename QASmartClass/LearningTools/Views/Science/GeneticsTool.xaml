<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Science.GeneticsTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E8F5E9" Offset="0"/>
                    <GradientStop Color="#C8E6C9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🧬 Bảng Di Truyền — Punnett Square" FontSize="20" FontWeight="Bold" Foreground="#1B5E20"/>
                <TextBlock Text="Lớp 9-12 • Mendel, Kiểu gen, Kiểu hình, Tỉ lệ" FontSize="14" Foreground="#2E7D32" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E8F5E9">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C8E6C9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E7D32"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextSimulator" Text="Mô phỏng &amp; Lai Mendel" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#C8E6C9"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12" MaxWidth="1600" HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C8E6C9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<TextBlock Text="💡 Hướng Dẫn Tính Toán Kiểu Gen &amp; Bảng Punnett" FontSize="20" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="📐 Quy Trình Thao Tác Trực Quan" FontSize="16" FontWeight="Bold" Foreground="#212121" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#43A047" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Nhập Kiểu Gen Bố" FontWeight="Bold" FontSize="13" Foreground="#1B5E20" Margin="0,0,0,4"/>
                                    <TextBlock Text="Điền kiểu gen của Bố vào ô ♂ Bố (Ví dụ: Aa hoặc AaBb)." FontSize="11" Foreground="#424242" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Grid.Column="1" Text="➔" FontSize="20" Foreground="#B0BEC5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <Border Grid.Column="2" Background="#FCE4EC" BorderBrush="#F48FB1" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#AD1457" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Nhập Kiểu Gen Mẹ" FontWeight="Bold" FontSize="13" Foreground="#AD1457" Margin="0,0,0,4"/>
                                    <TextBlock Text="Điền kiểu gen của Mẹ vào ô ♀ Mẹ (Ví dụ: Aa hoặc AaBb)." FontSize="11" Foreground="#424242" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Grid.Column="3" Text="➔" FontSize="20" Foreground="#B0BEC5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <Border Grid.Column="4" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E88E5" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Xem Bảng Punnett" FontWeight="Bold" FontSize="13" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                    <TextBlock Text="Bảng Punnett tự động tạo tổ hợp giao tử và các ô kiểu gen F1." FontSize="11" Foreground="#424242" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Grid.Column="5" Text="➔" FontSize="20" Foreground="#B0BEC5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <Border Grid.Column="6" Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#FB8C00" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Đọc Tỉ Lệ &amp; Quy Luật" FontWeight="Bold" FontSize="13" Foreground="#E65100" Margin="0,0,0,4"/>
                                    <TextBlock Text="Xem thống kê Tỉ lệ kiểu gen, Tỉ lệ kiểu hình và Quy luật Mendel tương ứng." FontSize="11" Foreground="#424242" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Genetics Terminology -->
                        <TextBlock Text="📖 Tra Cứu Thuật Ngữ Di Truyền Cơ Bản" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,12"/>
                        <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="Alen &amp; Gen" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Alen (Allele): Các trạng thái khác nhau của một gen (VD: alen trội A, alen lặn a)." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Cặp alen: Gồm 2 alen cùng thuộc 1 gen nằm trên cặp NST tương đồng (VD: AA, Aa, aa)." FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4">
                                    <TextBlock Text="Đồng hợp &amp; Dị hợp" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Đồng hợp (Homozygous): Cặp alen gồm 2 alen giống nhau (VD: AA là đồng hợp trội, aa là đồng hợp lặn)." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Dị hợp (Heterozygous): Cặp alen gồm 2 alen khác nhau (VD: Aa)." FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="Kiểu gen &amp; Kiểu hình" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Kiểu gen (Genotype): Tổ hợp toàn bộ các alen của cơ thể (VD: AaBb)." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Kiểu hình (Phenotype): Tập hợp các tính trạng biểu hiện ra ngoài (VD: Hạt vàng, trơn)." FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: SIMULATOR -->
                <ScrollViewer x:Name="viewSimulator" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📝 Nhập kiểu gen bố mẹ (VD: Aa × Aa)" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="10" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="♂ Bố" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}"/>
                                                <TextBox x:Name="txtFather" FontSize="26" Padding="8,6" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="Calc_Changed" Text="Aa" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="×" FontSize="32" FontWeight="Bold" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="16,0"/>

                                        <Border Grid.Column="2" Background="#FCE4EC" CornerRadius="10" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="♀ Mẹ" FontSize="16" FontWeight="Bold" Foreground="#AD1457"/>
                                                <TextBox x:Name="txtMother" FontSize="26" Padding="8,6" FontWeight="Bold" BorderThickness="0" Background="Transparent" TextChanged="Calc_Changed" Text="Aa" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="💡 Hỗ trợ: 1 gen (Aa), 2 gen (AaBb)" FontSize="14" Foreground="#757575" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="⚡ Ví dụ SGK" FontSize="16" FontWeight="Bold" Foreground="#212121" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="presetPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Export Tools Card -->
                            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🛠️ Báo cáo &amp; Trích xuất" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,12"/>
                                    <Border x:Name="btnExportHtml" Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="BtnExportHtml_Click">
                                        <TextBlock Text="📊 Xuất Báo Cáo Lai Mendel HTML" FontSize="13" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Punnett Square & Results -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <!-- Punnett Square -->
                            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📊 Bảng Punnett" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,12"/>
                                    <Grid x:Name="punnettGrid"/>
                                </StackPanel>
                            </Border>

                            <!-- Results -->
                            <StackPanel x:Name="resultPanel"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VIEW 2: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>