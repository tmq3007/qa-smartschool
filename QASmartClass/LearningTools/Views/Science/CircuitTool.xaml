<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Science.CircuitTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E3F2FD" Offset="0"/>
                    <GradientStop Color="#BBDEFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đặt lại tất cả" Background="#1E88E5" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="BtnResetAll_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <StackPanel>
                    <TextBlock Text="⚡ Mạch Điện — Định Luật Ohm" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/>
                    <TextBlock Text="Mô phỏng STEM • Khảo sát mối quan hệ U-I-R • Thiết kế mạch ảo • Trắc nghiệm ôn tập" FontSize="12" Foreground="#0D47A1" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E3F2FD">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C8E6C9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E7D32"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextOhm" Text="Khảo Sát Định Luật Ohm" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextSandbox" Text="Thiết Kế Mạch Tự Do" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧠" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextQuiz" Text="Bài Tập Trắc Nghiệm" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#BBDEFB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C8E6C9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<Border Background="#E3F2FD" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#BBDEFB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 ĐỊNH LUẬT OHM VÀ MÔ PHỎNG MẠCH ĐIỆN VẬT LÝ" FontWeight="Bold" Foreground="#1565C0" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="18">
                                    Định luật Ohm phát biểu rằng cường độ dòng điện đi qua một vật dẫn điện tỉ lệ thuận với hiệu điện thế giữa hai đầu vật dẫn và tỉ lệ nghịch với điện trở của vật dẫn đó: I = U/R.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🎯 Quy trình thực hành và thí nghiệm:" FontSize="15" FontWeight="Bold" Foreground="#1565C0" Margin="0,4,0,8"/>
                        <TextBlock Text="1. Khảo sát định luật Ohm: Tùy chỉnh trực quan điện áp U, điện trở R và theo dõi trị số cường độ dòng điện I tương ứng." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="2. Thiết kế mạch điện tự do: Kéo thả các thiết bị Pin, Điện trở, Bóng đèn, Công tắc và dây nối trên Canvas mô phỏng." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="3. Đánh giá kiểm tra: Thực hành các câu hỏi trắc nghiệm vật lý về lý thuyết mạch điện để ghi nhớ sâu." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: KHẢO SÁT ĐỊNH LUẬT OHM -->
                <Grid x:Name="viewOhm" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Control panel, statistics, logged table -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel>
                            <!-- Adjustable Parameters -->
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#D1E8FF" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🛠️ Điều chỉnh thông số thí nghiệm" FontSize="15" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>
                                    
                                    <!-- Voltage U -->
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel>
                                            <TextBlock Text="Hiệu điện thế U (Vôn):" FontWeight="SemiBold" FontSize="13" Foreground="#37474F"/>
                                            <TextBlock x:Name="txtSliderU" Text="12.0 V" FontWeight="Bold" FontSize="14" Foreground="#1E88E5" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider x:Name="sldVoltage" Minimum="0" Maximum="30" Value="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="SldParameters_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Resistance R -->
                                    <StackPanel Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="Điện trở R (Ôm):" FontWeight="SemiBold" FontSize="13" Foreground="#37474F"/>
                                            <TextBlock x:Name="txtSliderR" Text="6 Ω" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider x:Name="sldResistance" Minimum="1" Maximum="100" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="SldParameters_ValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live measurements & calculations -->
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#D1E8FF" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📊 Thông số mạch hiện thời" FontSize="15" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"/>
                                    
                                    <!-- Stats Box formatted for unit tests -->
                                    <Border Background="#F1F8E9" CornerRadius="8" Padding="12" BorderBrush="#C5E1A5" BorderThickness="1">
                                        <TextBlock x:Name="txtStatsDetail" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" LineHeight="24" TextWrapping="Wrap">
                                            Hiệu điện thế: 12,00 V&#x0a;Điện trở: 6,00 Ω&#x0a;Cường độ dòng điện: 2,00 A&#x0a;Công suất tiêu thụ: 24,00 W
                                        </TextBlock>
                                    </Border>

                                    <!-- Log Buttons -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnLogData" Grid.Column="0" Content="💾 Ghi số liệu" Background="#2E7D32" Foreground="White" FontWeight="Bold" Padding="0,8" Margin="0,0,6,0" Cursor="Hand" Click="BtnLogData_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="btnClearLoggedData" Grid.Column="1" Content="🗑 Xóa số liệu" Background="#D32F2F" Foreground="White" FontWeight="Bold" Padding="0,8" Margin="6,0,0,0" Cursor="Hand" Click="BtnClearLoggedData_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Logged Data Table -->
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#CFD8DC" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📋 Bảng số liệu thực hành" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,8"/>
                                    <ListView x:Name="lstLoggedData" Height="150" BorderBrush="#ECEFF1" BorderThickness="1">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Lần đo" Width="60" DisplayMemberBinding="{Binding Index}"/>
                                                <GridViewColumn Header="Hiệu điện thế U (V)" Width="120" DisplayMemberBinding="{Binding VoltageStr}"/>
                                                <GridViewColumn Header="Cường độ I (A)" Width="100" DisplayMemberBinding="{Binding CurrentStr}"/>
                                                <GridViewColumn Header="Điện trở R (Ω)" Width="100" DisplayMemberBinding="{Binding ResistanceStr}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: OxyPlot V-I graph & schematic -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Circuit Schematic Drawing -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#CFD8DC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔌 Sơ đồ mạch điện ảo" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,8"/>
                                <Canvas x:Name="SchematicCanvas" Height="130" Background="#FAFAFA">
                                    <Rectangle Canvas.Left="20" Canvas.Top="60" Width="10" Height="20" Fill="#37474F"/>
                                    <Rectangle Canvas.Left="35" Canvas.Top="50" Width="4" Height="40" Fill="#37474F"/>
                                    <TextBlock Text="U" Canvas.Left="15" Canvas.Top="25" FontWeight="Bold" Foreground="#1E88E5"/>
                                    <Line X1="39" Y1="70" X2="120" Y2="70" Stroke="#37474F" StrokeThickness="2"/>
                                    <Line X1="20" Y1="70" X2="20" Y2="110" Stroke="#37474F" StrokeThickness="2"/>
                                    <Line X1="20" Y1="110" X2="300" Y2="110" Stroke="#37474F" StrokeThickness="2"/>
                                    <Line X1="300" Y1="110" X2="300" Y2="70" Stroke="#37474F" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="120" Canvas.Top="55" Width="30" Height="30" Fill="#FFF9C4" Stroke="#FBC02D" StrokeThickness="2"/>
                                    <TextBlock Text="A" Canvas.Left="131" Canvas.Top="60" FontWeight="Bold" FontSize="14" Foreground="#FF8F00"/>
                                    <TextBlock x:Name="txtSchematicI" Text="2,00 A" Canvas.Left="115" Canvas.Top="90" FontWeight="Bold" Foreground="#FF8F00"/>
                                    <Line X1="150" Y1="70" X2="200" Y2="70" Stroke="#37474F" StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="200" Canvas.Top="58" Width="50" Height="24" Fill="#E8F5E9" Stroke="#2E7D32" StrokeThickness="2"/>
                                    <TextBlock Text="R" Canvas.Left="221" Canvas.Top="61" FontWeight="Bold" Foreground="#2E7D32"/>
                                    <TextBlock x:Name="txtSchematicR" Text="6 Ω" Canvas.Left="215" Canvas.Top="35" FontWeight="Bold" Foreground="#2E7D32"/>
                                    <Line X1="250" Y1="70" X2="300" Y2="70" Stroke="#37474F" StrokeThickness="2"/>
                                    <Line X1="185" Y1="70" X2="185" Y2="20" Stroke="#1976D2" StrokeThickness="1.5" StrokeDashArray="2 2"/>
                                    <Line X1="265" Y1="70" X2="265" Y2="20" Stroke="#1976D2" StrokeThickness="1.5" StrokeDashArray="2 2"/>
                                    <Line X1="185" Y1="20" X2="205" Y2="20" Stroke="#1976D2" StrokeThickness="1.5"/>
                                    <Line X1="245" Y1="20" X2="265" Y2="20" Stroke="#1976D2" StrokeThickness="1.5"/>
                                    <Ellipse Canvas.Left="205" Canvas.Top="5" Width="40" Height="30" Fill="#E3F2FD" Stroke="#1976D2" StrokeThickness="2"/>
                                    <TextBlock Text="V" Canvas.Left="221" Canvas.Top="11" FontWeight="Bold" FontSize="14" Foreground="#1976D2"/>
                                    <TextBlock x:Name="txtSchematicU" Text="12.0 V" Canvas.Left="210" Canvas.Top="-17" FontWeight="Bold" Foreground="#1976D2"/>
                                </Canvas>
                            </StackPanel>
                        </Border>

                        <!-- OxyPlot Graph View -->
                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12" BorderBrush="#CFD8DC" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="📈 Đồ thị đặc trưng Vôn - Ampe (V-I)" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,6"/>
                                <oxy:PlotView x:Name="VIPlot" Grid.Row="1" Background="White" MinHeight="250"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 2: THIẾT KẾ MẠCH ĐIỆN TỰ DO -->
                <Grid x:Name="viewSandbox" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TOOLBOX -->
                        <Border Grid.Row="0" Background="White" Padding="12" Margin="0,0,0,8" CornerRadius="12" BorderBrush="#CFD8DC" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                            </Border.Effect>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Thêm linh kiện:" FontSize="14" FontWeight="Bold" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Background="#FFF9C4" BorderBrush="#FBC02D" BorderThickness="1" Padding="10,6" Margin="0,2,6,2" Cursor="Hand" Click="BtnAddTool_Click" Tag="Battery">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔋" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Pin" FontSize="12" FontWeight="Bold" Foreground="#F57F17" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" Padding="10,6" Margin="0,2,6,2" Cursor="Hand" Click="BtnAddTool_Click" Tag="Resistor">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🟩" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Điện Trở" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#FFFDE7" BorderBrush="#FFF176" BorderThickness="1" Padding="10,6" Margin="0,2,6,2" Cursor="Hand" Click="BtnAddTool_Click" Tag="Bulb">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💡" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Bóng Đèn" FontSize="12" FontWeight="Bold" Foreground="#F57F17" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#ECEFF1" BorderBrush="#90A4AE" BorderThickness="1" Padding="10,6" Margin="0,2,6,2" Cursor="Hand" Click="BtnAddTool_Click" Tag="Switch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕹️" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Công Tắc" FontSize="12" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#E0F7FA" BorderBrush="#4DD0E1" BorderThickness="1" Padding="10,6" Margin="0,2,6,2" Cursor="Hand" Click="BtnAddTool_Click" Tag="Ammeter">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏱️" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ampe Kế" FontSize="12" FontWeight="Bold" Foreground="#006064" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Height="20" Background="#CFD8DC" Margin="12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="🔌 Mạch mẫu:" FontSize="14" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cboCircuitPresets" Width="200" VerticalAlignment="Center" FontSize="12.5" Padding="6,4" SelectionChanged="CboCircuitPresets_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="-- Chọn mạch mẫu --"/>
                                    <ComboBoxItem Content="Mạch cơ bản (1 Pin + 1 Đèn + 1 Công tắc)"/>
                                    <ComboBoxItem Content="Mạch nối tiếp (1 Pin + 2 Đèn nối tiếp)"/>
                                    <ComboBoxItem Content="Mạch song song (1 Pin + 2 Đèn song song)"/>
                                    <ComboBoxItem Content="Cầu phân áp (Khảo sát Ohm nối tiếp)"/>
                                    <ComboBoxItem Content="Đoản mạch cảnh báo (Nguy hiểm chập điện)"/>
                                </ComboBox>
                                <Button Background="#FFE4E1" BorderBrush="#FFC0CB" BorderThickness="1" Padding="12,6" Margin="16,2,0,2" Cursor="Hand" Click="BtnClear_Click">
                                    <TextBlock Text="🗑 Xóa Toàn Bộ Mạch" FontSize="12" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center"/>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <!-- CANVAS WORKSPACE -->
                        <Border Grid.Row="1" Background="White" Margin="0,0,0,0" CornerRadius="12" BorderBrush="#CFD8DC" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Canvas x:Name="CircuitCanvas" Background="Transparent" 
                                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                        MouseMove="Canvas_MouseMove"
                                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                    <Line x:Name="PreviewWire" Visibility="Collapsed" Stroke="#1976D2" StrokeThickness="4" StrokeDashArray="4 2"/>
                                </Canvas>
                                <Border x:Name="TutorialTooltip" Background="#FF6D00" CornerRadius="8" Padding="16,10" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="100">
                                    <StackPanel>
                                        <TextBlock Text="💡 Hướng dẫn ghép mạch:" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="1. Bấm nút phía trên để thêm linh kiện vào bảng.&#x0a;2. Click vòng tròn đỏ cực (+) hoặc đen cực (-) để bắt đầu đi dây, nối sang vòng tròn của linh kiện khác.&#x0a;3. Kéo chuột trái để di chuyển linh kiện. Nhấp chuột vào linh kiện để thay đổi thông số hoặc xóa." Foreground="#FFE0B2" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TutorialHand" Text="👆" FontSize="40" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Panel.ZIndex="150" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="HandTranslate" X="0" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right: Inspector Panel -->
                    <Border Grid.Column="1" Background="White" Margin="12,0,0,0" CornerRadius="12" BorderBrush="#CFD8DC" BorderThickness="1" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock x:Name="txtInspectorPlaceholder" Text="Chưa chọn linh kiện nào.&#x0a;Hãy click vào một linh kiện trên bảng để chỉnh thông số." FontSize="13" Foreground="#78909C" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel x:Name="panelInspector" Visibility="Collapsed">
                                <TextBlock Text="⚙️ Thuộc tính linh kiện" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                <Border Background="#ECEFF1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Loại linh kiện:" FontSize="12" Foreground="#546E7A"/>
                                        <TextBlock x:Name="txtInspectorType" Text="Bóng đèn" FontSize="15" FontWeight="Bold" Foreground="#37474F" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="stackInspectorSlider" Margin="0,0,0,20">
                                    <DockPanel>
                                        <TextBlock x:Name="txtInspectorSliderLabel" Text="Điện trở:" FontSize="13" FontWeight="SemiBold" Foreground="#37474F"/>
                                        <TextBlock x:Name="txtInspectorValue" Text="10 Ω" FontSize="14" FontWeight="Bold" Foreground="#1E88E5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="sldInspectorParam" Minimum="1" Maximum="200" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="SldInspectorParam_ValueChanged"/>
                                </StackPanel>
                                <Border x:Name="borderInspectorState" Background="#E8F5E9" CornerRadius="6" Padding="10" Margin="0,0,0,20" Visibility="Collapsed">
                                    <TextBlock x:Name="txtInspectorState" Text="Dòng điện: 0,00 A" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                </Border>
                                <Button x:Name="btnDeleteSelected" Content="🗑 Xóa linh kiện" Background="#D32F2F" Foreground="White" FontWeight="Bold" Padding="0,10" Cursor="Hand" Click="BtnDeleteSelected_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW 3: TRẮC NGHIỆM ĐỊNH LUẬT OHM -->
                <ScrollViewer x:Name="viewQuiz" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid Margin="0,10,0,0" HorizontalAlignment="Center" MaxWidth="1600">
                        <Border Background="White" CornerRadius="14" Padding="24" BorderBrush="#B2DFDB" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="🧠 Bài tập củng cố Định luật Ohm" FontSize="18" FontWeight="Bold" Foreground="#00695C"/>
                                    <TextBlock x:Name="txtQuizProgress" Text="Câu hỏi 1 / 5" FontSize="14" FontWeight="Bold" Foreground="#00796B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ProgressBar x:Name="pbQuiz" Height="8" Minimum="0" Maximum="5" Value="1" Foreground="#009688" Background="#E0F2F1" Margin="0,0,0,20">
                                    <ProgressBar.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                                <StackPanel x:Name="panelQuizActive">
                                    <Border Background="#F5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                        <TextBlock x:Name="txtQuizQuestion" Text="Câu hỏi ở đây?" FontSize="16" FontWeight="SemiBold" Foreground="#37474F" TextWrapping="Wrap" LineHeight="24"/>
                                    </Border>
                                    <StackPanel Margin="0,0,0,20">
                                        <RadioButton x:Name="rbOptA" GroupName="QuizOpts" Content="Đáp án A" FontSize="14" Margin="0,6" Foreground="#37474F" Checked="RbOpt_Checked"/>
                                        <RadioButton x:Name="rbOptB" GroupName="QuizOpts" Content="Đáp án B" FontSize="14" Margin="0,6" Foreground="#37474F" Checked="RbOpt_Checked"/>
                                        <RadioButton x:Name="rbOptC" GroupName="QuizOpts" Content="Đáp án C" FontSize="14" Margin="0,6" Foreground="#37474F" Checked="RbOpt_Checked"/>
                                        <RadioButton x:Name="rbOptD" GroupName="QuizOpts" Content="Đáp án D" FontSize="14" Margin="0,6" Foreground="#37474F" Checked="RbOpt_Checked"/>
                                    </StackPanel>
                                    <Border x:Name="borderQuizFeedback" CornerRadius="8" Padding="12" Margin="0,0,0,20" Visibility="Collapsed">
                                        <TextBlock x:Name="txtQuizFeedback" Text="Giải thích chi tiết" FontSize="13.5" TextWrapping="Wrap" LineHeight="20"/>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnCheckAnswer" Grid.Column="0" Content="✔️ Kiểm tra đáp án" Background="#00796B" Foreground="White" FontWeight="Bold" Padding="0,12" Cursor="Hand" Click="BtnCheckAnswer_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="btnNextQuestion" Grid.Column="1" Content="Câu tiếp theo ➡️" Background="#009688" Foreground="White" FontWeight="Bold" Padding="16,12" Margin="12,0,0,0" Visibility="Collapsed" Cursor="Hand" Click="BtnNextQuestion_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="panelQuizComplete" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20">
                                    <TextBlock Text="🎉 Hoàn Thành Bài Kiểm Tra!" FontSize="22" FontWeight="Bold" Foreground="#004D40" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtQuizScore" Text="Điểm số: 5 / 5" FontSize="18" FontWeight="Bold" Foreground="#00796B" HorizontalAlignment="Center" Margin="0,12,0,20"/>
                                    <Button Content="🔄 Làm lại trắc nghiệm" Background="#00796B" Foreground="White" FontWeight="Bold" Padding="24,12" Cursor="Hand" Click="BtnRetryQuiz_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- VIEW 4: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
