<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Science.MolecularGeneticsTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E8F5E9" Offset="0"/>
                    <GradientStop Color="#C8E6C9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🧬 Di Truyền Phân Tử &amp; Đột Biến Gen" FontSize="20" FontWeight="Bold" Foreground="#1B5E20"/>
                <TextBlock Text="Lớp 9-12 • Phiên mã, Dịch mã, Phân tích đột biến điểm &amp; Liên kết Hydro" FontSize="14" Foreground="#2E7D32" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E8F5E9">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C8E6C9"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E7D32"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4">


                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧬" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextSimulator" Text="Trình mô phỏng" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#C8E6C9"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12" MaxWidth="1000" HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#C8E6C9" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="📖 HƯỚNG DẪN HỌC TẬP DI TRUYỀN PHÂN TỬ" FontSize="22" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tìm hiểu về cơ chế phiên mã, dịch mã và tác động của các đột biến gen điểm." FontSize="14" Foreground="#424242" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                        
                        <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#C8E6C9" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📋 HƯỚNG DẪN THAO TÁC TRỰC QUAN TỪNG BƯỚC" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Bước 1" FontSize="12" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="📝 Nhập DNA Gốc" FontSize="14" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,8"/>
                                            <TextBlock Text="Nhập trình tự nucleotit mạch gốc (3'→5') vào ô màu xanh dương. Ví dụ: TAC GGX TTA XGA ATT." FontSize="12.5" Foreground="#333" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#FFEBEE" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Bước 2" FontSize="12" FontWeight="Bold" Foreground="#B71C1C" Margin="0,0,0,4"/>
                                            <TextBlock Text="⚡ Nhập DNA Đột Biến" FontSize="14" FontWeight="Bold" Foreground="#B71C1C" Margin="0,0,0,8"/>
                                            <TextBlock Text="Nhập chuỗi đột biến tương ứng vào ô màu đỏ, hoặc nhấp chọn một nút Preset ví dụ đột biến nhanh." FontSize="12.5" Foreground="#333" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#FFF8E1" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Bước 3" FontSize="12" FontWeight="Bold" Foreground="#F57F17" Margin="0,0,0,4"/>
                                            <TextBlock Text="📊 So Sánh Trực Quan" FontSize="14" FontWeight="Bold" Foreground="#F57F17" Margin="0,0,0,8"/>
                                            <TextBlock Text="Quan sát bản đồ đối chiếu dọc. Các ô đột biến đổi sang màu đỏ." FontSize="12.5" Foreground="#333" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#E8F5E9" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Bước 4" FontSize="12" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,4"/>
                                            <TextBlock Text="🔎 Phân Tích Kết Quả" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                            <TextBlock Text="Xem loại đột biến (sai nghĩa, vô nghĩa...), diễn giải cơ chế sinh học phân tử." FontSize="12.5" Foreground="#333" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: SIMULATOR -->
                <ScrollViewer x:Name="viewSimulator" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Inputs & Presets -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <!-- DNA Inputs -->
                            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📝 Nhập trình tự gen" FontSize="14" FontWeight="SemiBold" Foreground="#1B5E20" Margin="0,0,0,12"/>
                                    
                                    <!-- Wild-type DNA -->
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#757575" Margin="0,0,0,4">
                                        <Run>Mạch gốc DNA (3' ➔ 5'):</Run>
                                    </TextBlock>
                                    <Border x:Name="borderWild" Background="#E3F2FD" CornerRadius="8" Padding="10,6" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#BBDEFB">
                                        <TextBox x:Name="txtWild" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" BorderThickness="0" Background="Transparent" TextChanged="Input_Changed" Text="TACGGXTTAXGAATT"/>
                                    </Border>

                                    <!-- Mutant DNA -->
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#757575" Margin="0,0,0,4">
                                        <Run>Mạch đột biến DNA (3' ➔ 5'):</Run>
                                    </TextBlock>
                                    <Border x:Name="borderMutant" Background="#FFEBEE" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#FFCDD2">
                                        <TextBox x:Name="txtMutant" FontSize="16" FontWeight="Bold" Foreground="#B71C1C" BorderThickness="0" Background="Transparent" TextChanged="Input_Changed" Text="TACGGXATAXGAATT"/>
                                    </Border>

                                    <TextBlock Text="💡 Chỉ chấp nhận nucleotit: A, T, G, X (hoặc C)." FontSize="13" Foreground="#757575" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                     <TextBlock Text="⚡ Các ví dụ đột biến điểm" FontSize="16" FontWeight="Bold" Foreground="#212121" Margin="0,0,0,12"/>
                                    <WrapPanel x:Name="presetPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Teacher Mode & Export Tools Card -->
                            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#C8E6C9" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🛠️ Công cụ Sư phạm &amp; Báo cáo" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="chkTeacherMode" Content="Chế độ giáo viên (Ẩn kết quả đột biến)" FontSize="13" FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,12" Checked="Input_Changed" Unchecked="Input_Changed"/>
                                    <Border x:Name="btnExportHtml" Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="BtnExportHtml_Click">
                                        <TextBlock Text="📊 Xuất Báo Cáo Thực Hành HTML" FontSize="13" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Visual Map & Results -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <!-- Visual Mapping Card -->
                            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📊 Bản đồ so sánh trực quan dọc bộ ba" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,16"/>
                                    
                                    <WrapPanel Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                            <Border Width="12" Height="12" Background="#E3F2FD" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="DNA gốc" FontSize="11" Foreground="#555555"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                            <Border Width="12" Height="12" Background="#FFF3E0" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="ARN thông tin" FontSize="11" Foreground="#555555"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                            <Border Width="12" Height="12" Background="#E8F5E9" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Axit amin" FontSize="11" Foreground="#555555"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                            <Border Width="12" Height="12" Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Vị trí đột biến" FontSize="11" Foreground="#555555"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- Container for Frozen Labels and Scrollable Grid -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" x:Name="labelsGrid" VerticalAlignment="Top"/>
                                        <ScrollViewer x:Name="visualGridScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12">
                                            <StackPanel x:Name="visualGridPanel" Orientation="Vertical" Margin="0"/>
                                        </ScrollViewer>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Results Analysis -->
                            <StackPanel x:Name="resultPanel"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VIEW 2: PRACTICAL APPLICATIONS -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
