<UserControl x:Class="QASmartClass.LearningTools.Views.Workplace.KpiOkrTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- === HEADER === -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBackground}" Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnTemplate" Content="🎯 Template ▼" Padding="10,6" Margin="0,0,6,0" FontSize="13" Cursor="Hand" Click="Template_Click"/>
                    <Button x:Name="btnExport" Content="📷 Export PNG" Padding="10,6" Margin="0,0,6,0" FontSize="13" Cursor="Hand" Click="Export_Click"/>
                    <Button x:Name="btnClear" Content="🗑️ Làm lại" Padding="10,6" FontSize="13" Cursor="Hand" Click="Clear_Click"/>
                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="📈 Bảng Theo Dõi KPI &amp; OKR" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Đo lường tiến độ mục tiêu bằng phần trăm hoàn thành" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="{DynamicResource SidebarBackground}">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#B2DFDB"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#00796B"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextWorkspace" Text="Thiết lập mục tiêu &amp; Đo lường" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 1: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#B2DFDB" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#00796B" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#B2DFDB" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<!-- Nguồn gốc & Ý nghĩa -->
                        <Border Background="{DynamicResource SidebarBackground}" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 NGUỒN GỐC &amp; Ý NGHĨA" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtToolMeaning" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" LineHeight="18"/>
                                <TextBlock Text="🌍 ÁP DỤNG THỰC TẾ" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtToolApplication" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondary}" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🛠️ HƯỚNG DẪN 4 BƯỚC THIẾT LẬP MỤC TIÊU" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,4,0,8"/>
                        
                        <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <Border Background="{DynamicResource BrandPrimary}" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="1" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#333333">
                                    <Run FontWeight="Bold" Text="Chọn mục tiêu lớn:"/> Bấm chọn nhanh từ menu <Run FontWeight="Bold" Foreground="#00796B" Text="🎯 Template mẫu ▼"/>, hoặc tự điền vào ô "Mục tiêu lớn".
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <Border Background="{DynamicResource BrandPrimary}" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="2" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondary}">
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Đặt chỉ số đo lường (KR):"/> Bấm <Run FontWeight="Bold" Foreground="{DynamicResource BrandPrimary}" Text="➕ Thêm chỉ số"/> và điền hành động có CON SỐ kèm đơn vị cụ thể.
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <Border Background="{DynamicResource BrandPrimary}" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="3" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondary}">
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Nhập số liệu:"/> Điền số cần đạt ở ô Mục tiêu, số đã làm ở ô Thực tế. Lỗi định dạng sẽ báo viền đỏ.
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,16">
                            <DockPanel>
                                <Border Background="{DynamicResource BrandPrimary}" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="4" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondary}">
                                    <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Theo dõi &amp; Báo cáo:"/> Biểu đồ tự vẽ khi click ra ngoài. Nhấn <Run FontWeight="Bold" Foreground="{DynamicResource BrandPrimary}" Text="📷 Export PNG"/> để lưu ảnh báo cáo phẳng.
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    
</StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: KHU VỰC THAO TÁC / WORKSPACE -->
                <Grid x:Name="viewWorkspace" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Thiết lập OKR -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Mục tiêu lớn:" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtObjective" FontSize="15" Padding="8,6" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Nhập mục tiêu lớn học tập (VD: Đạt học lực giỏi học kỳ 1)"/>
                            </DockPanel>

                            <!-- Data Rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Chỉ số (Key Results / KPI)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="Mục tiêu" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Thực tế" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel x:Name="dataPanel"/>
                                    <Button Content="➕ Thêm chỉ số hành động" Padding="8" FontSize="13" Cursor="Hand" Click="AddRow_Click" Background="{DynamicResource SidebarHeaderBackground}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Row="2" Content="🔄 CẬP NHẬT DASHBOARD" Padding="12" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="Update_Click" Background="{DynamicResource BrandPrimary}" Foreground="White" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT: Dashboard Visual -->
                    <Border x:Name="dashboardBorder" Grid.Column="1" Background="{DynamicResource SurfaceBackground}" CornerRadius="10" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="DASHBOARD TIẾN ĐỘ" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <Border Grid.Row="1" Background="{DynamicResource SidebarHeaderBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="lblObjDisplay" Text="[Chưa nhập Mục tiêu]" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tiến độ tổng:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border x:Name="trackTotal" Grid.Column="1" Height="18" CornerRadius="9" Background="{DynamicResource SidebarBackground}">
                                            <Border x:Name="barTotal" HorizontalAlignment="Left" CornerRadius="9" Background="{DynamicResource BrandPrimary}" Width="0"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" x:Name="txtTotalPct" Text="0%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="scrollDashboard" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="cardsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW 3: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
