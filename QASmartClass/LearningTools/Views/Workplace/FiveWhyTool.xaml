<UserControl x:Class="QASmartClass.LearningTools.Views.Workplace.FiveWhyTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- === HEADER === -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Right: actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnTemplate" Content="🎯 Template mẫu ▼" Padding="10,6" Margin="0,0,6,0" FontSize="14" MinHeight="36" Cursor="Hand" Click="Template_Click" ToolTip="Chọn template phân tích mẫu"/>
                    <Button x:Name="btnExport" Content="📷 Export PNG" Padding="10,6" Margin="0,0,6,0" FontSize="14" MinHeight="36" Cursor="Hand" Click="Export_Click" ToolTip="Chụp phân tích thành ảnh PNG"/>
                    <Button x:Name="btnClear" Content="🗑️ Xóa tất cả" Padding="10,6" FontSize="14" MinHeight="36" Cursor="Hand" Click="Clear_Click" ToolTip="Xóa toàn bộ phân tích"/>
                </StackPanel>

                <!-- Left: title -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🔍 Phân Tích 5 Why – 1 How" FontSize="20" FontWeight="Bold" Foreground="#00796B"/>
                    <TextBlock Text="Tìm nguyên nhân gốc rễ bằng chuỗi câu hỏi liên tiếp" FontSize="14" Foreground="#757575" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#F1F8E9">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#B2DFDB"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#00796B"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextWorkspace" Text="Phân tích &amp; Biểu đồ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#E0E0E0"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 1: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#B2DFDB" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#00796B" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#B2DFDB" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<!-- panelGuideText container is required for potential FontSize zooming if needed -->
                        <StackPanel x:Name="panelGuideText" Background="White">
                            <!-- Nguồn gốc & Ý nghĩa -->
                            <Border Background="#E3F2FD" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#BBDEFB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="lblOriginTitle" Text="💡 NGUỒN GỐC &amp; Ý NGHĨA" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtToolMeaning" TextWrapping="Wrap" FontSize="14" Foreground="#424242" Margin="0,0,0,10" LineHeight="18"/>
                                    <TextBlock x:Name="lblAppTitle" Text="🌍 ÁP DỤNG THỰC TẾ" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtToolApplication" TextWrapping="Wrap" FontSize="14" Foreground="#424242" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Ví dụ mẫu -->
                            <Border Background="#E8F5E9" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#A5D6A7" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="lblGuideExampleTitle" Text="📝 VÍ DỤ MẪU TRỰC QUAN (HỌC TẬP)" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,6"/>
                                    <Grid Margin="0,4,0,0" Grid.IsSharedSizeScope="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GuideLabelGroup"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="guideProblemLabel" Text="📋 Vấn đề:" FontWeight="Bold" Foreground="#C62828" Margin="0,0,10,6" FontSize="14"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="guideProblemVal" Text="Kết quả thi học kỳ môn Toán bị sa sút" Foreground="#212121" Margin="0,0,0,6" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="guideWhy1Label" Text="❓ Why 1:" FontWeight="Bold" Foreground="#00796B" Margin="0,0,10,6" FontSize="14"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="guideWhy1Val" Text="Không ôn thi đúng hạn, sát ngày thi mới bắt đầu học" Foreground="#212121" Margin="0,0,0,6" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="guideWhy2Label" Text="❓ Why 2:" FontWeight="Bold" Foreground="#00796B" Margin="0,0,10,6" FontSize="14"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="guideWhy2Val" Text="Trì hoãn việc ôn bài, ưu tiên các trò chơi điện tử" Foreground="#212121" Margin="0,0,0,6" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" x:Name="guideWhy3Label" Text="❓ Why 3:" FontWeight="Bold" Foreground="#00796B" Margin="0,0,10,6" FontSize="14"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="guideWhy3Val" Text="Cảm thấy nản lòng trước lượng kiến thức ôn tập lớn" Foreground="#212121" Margin="0,0,0,6" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="guideWhy4Label" Text="❓ Why 4:" FontWeight="Bold" Foreground="#00796B" Margin="0,0,10,6" FontSize="14"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="guideWhy4Val" Text="Không lập kế hoạch ôn tập chia nhỏ theo từng ngày" Foreground="#212121" Margin="0,0,0,6" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" x:Name="guideWhy5Label" Text="🎯 Why 5 (Gốc rễ):" FontWeight="Bold" Foreground="#E65100" Margin="0,0,10,6" FontSize="14"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="guideWhy5Val" Text="Thiếu phương pháp quản lý mục tiêu cá nhân (chưa dùng sơ đồ tư duy hay kế hoạch)" Foreground="#212121" Margin="0,0,0,6" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" x:Name="guideHowLabel" Text="✅ Giải pháp How:" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="guideHowVal" Text="Áp dụng phương pháp Pomodoro và chia nhỏ kế hoạch ôn thi thành 5 đầu việc mỗi ngày" Foreground="#212121" FontSize="14" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Quy trình thực hiện trực quan -->
                            <TextBlock x:Name="lblWorkflowTitle" Text="🛠️ QUY TRÌNH THỰC HIỆN TRỰC QUAN" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,8" FontSize="14"/>
                            <UniformGrid Columns="4" Margin="0,0,0,8">
                                <Border Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock x:Name="step1Header" Text="Bước 1" FontWeight="Bold" Foreground="#C62828" FontSize="11"/>
                                        <TextBlock x:Name="step1Title" Text="📋 Vấn Đề" FontWeight="Bold" Foreground="#C62828" FontSize="14" Margin="0,2,0,4"/>
                                        <TextBlock x:Name="step1Desc" Text="Ghi rõ tình huống cụ thể gặp phải (VD: điểm kém, trễ hạn...)" FontSize="12" Foreground="#37474F" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock x:Name="step2Header" Text="Bước 2" FontWeight="Bold" Foreground="#EF6C00" FontSize="11"/>
                                        <TextBlock x:Name="step2Title" Text="❓ Chuỗi 5 Why" FontWeight="Bold" Foreground="#EF6C00" FontSize="14" Margin="0,2,0,4"/>
                                        <TextBlock x:Name="step2Desc" Text="Liên tục đặt câu hỏi 'Tại sao?' cho câu trả lời trước đó." FontSize="12" Foreground="#37474F" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#E0F2F1" BorderBrush="#80CBC4" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock x:Name="step3Header" Text="Bước 3" FontWeight="Bold" Foreground="#00695C" FontSize="11"/>
                                        <TextBlock x:Name="step3Title" Text="🎯 Gốc Rễ" FontWeight="Bold" Foreground="#00695C" FontSize="14" Margin="0,2,0,4"/>
                                        <TextBlock x:Name="step3Desc" Text="Tìm ra nguyên nhân cốt lõi (thường ở câu Why thứ 5)." FontSize="12" Foreground="#37474F" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock x:Name="step4Header" Text="Bước 4" FontWeight="Bold" Foreground="#2E7D32" FontSize="11"/>
                                        <TextBlock x:Name="step4Title" Text="✅ Giải Pháp How" FontWeight="Bold" Foreground="#2E7D32" FontSize="14" Margin="0,2,0,4"/>
                                        <TextBlock x:Name="step4Desc" Text="Đề xuất 1 giải pháp cụ thể để khắc phục triệt để." FontSize="12" Foreground="#37474F" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: KHU VỰC THAO TÁC / WORKSPACE -->
                <ScrollViewer x:Name="viewWorkspace" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="4" Visibility="Collapsed">
                    <StackPanel x:Name="mainPanel" HorizontalAlignment="Stretch">
                        <!-- Problem Statement -->
                        <Border Background="#E0F2F1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderBrush="#00796B" BorderThickness="2">
                            <StackPanel>
                                <TextBlock x:Name="lblProblemTitle" Text="📋 Vấn Đề Cần Phân Tích" FontSize="16" FontWeight="Bold" Foreground="#00796B" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtProblem" FontSize="20" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" BorderBrush="#B2DFDB" BorderThickness="1" Background="White" Foreground="#212121" ToolTip="Mô tả vấn đề bạn muốn phân tích"/>
                            </StackPanel>
                        </Border>

                        <!-- Why Chain Container -->
                        <StackPanel x:Name="whyChainPanel"/>

                        <!-- Add Why Button -->
                        <Button x:Name="btnAddWhy" Content="➕ Thêm câu Why" Padding="12,8" Margin="40,4,0,8" FontSize="15" MinHeight="36" Cursor="Hand" Click="AddWhy_Click" HorizontalAlignment="Left" ToolTip="Thêm một cấp Why nữa"/>

                        <!-- How Solution -->
                        <Border x:Name="howSection" Background="#E8F5E9" CornerRadius="10" Padding="16,12" Margin="0,8,0,16" BorderBrush="#2E7D32" BorderThickness="2">
                            <StackPanel>
                                <TextBlock x:Name="lblHowTitle" Text="✅ HOW — GIẢI PHÁP" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,8"/>
                                <TextBlock x:Name="lblHowSubtitle" Text="Làm thế nào để giải quyết nguyên nhân gốc rễ?" FontSize="13" Foreground="#757575" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtHow" FontSize="20" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" BorderBrush="#A5D6A7" BorderThickness="1" Background="White" Foreground="#212121"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary Section -->
                        <Border x:Name="summarySection" Background="#FAFAFA" CornerRadius="10" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="lblSummaryTitle" Text="📊 TÓM TẮT PHÂN TÍCH" FontSize="16" FontWeight="Bold" Foreground="#00796B" Margin="0,0,0,10"/>
                                <StackPanel x:Name="summaryContent"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 3: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>