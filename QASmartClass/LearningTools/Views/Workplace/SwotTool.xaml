<UserControl x:Class="QASmartClass.LearningTools.Views.Workplace.SwotTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="White">

    <UserControl.Resources>
        <!-- Base Add Button Style -->
        <Style x:Key="SwotAddButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- S Style (Green) -->
        <Style x:Key="SwotAddButtonS" TargetType="Button" BasedOn="{StaticResource SwotAddButton}">
            <Setter Property="Background" Value="#C8E6C9"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A5D6A7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- W Style (Yellow) -->
        <Style x:Key="SwotAddButtonW" TargetType="Button" BasedOn="{StaticResource SwotAddButton}">
            <Setter Property="Background" Value="#FFF9C4"/>
            <Setter Property="Foreground" Value="#E65100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF59D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- O Style (Blue) -->
        <Style x:Key="SwotAddButtonO" TargetType="Button" BasedOn="{StaticResource SwotAddButton}">
            <Setter Property="Background" Value="#BBDEFB"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#90CAF9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- T Style (Red) -->
        <Style x:Key="SwotAddButtonT" TargetType="Button" BasedOn="{StaticResource SwotAddButton}">
            <Setter Property="Background" Value="#FFCDD2"/>
            <Setter Property="Foreground" Value="#B71C1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF9A9A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- === HEADER === -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnStrategy" Content="💡 Gợi ý chiến lược" Style="{StaticResource ModernButton}" Padding="12,8" Margin="0,0,6,0" FontSize="13" Cursor="Hand" Click="Strategy_Click" ToolTip="Gợi ý chiến lược SO/WO/ST/WT"/>
                    <Button x:Name="btnTemplate" Content="🎯 Template ▼" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,6,0" FontSize="13" Cursor="Hand" Click="Template_Click"/>
                    <Button x:Name="btnExport" Content="📷 Export PNG" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,6,0" FontSize="13" Cursor="Hand" Click="Export_Click"/>
                    <Button x:Name="btnClear" Content="🗑️ Xóa tất cả" Style="{StaticResource DangerButton}" Padding="12,8" FontSize="13" Cursor="Hand" Click="Clear_Click"/>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🎯 Phân Tích SWOT" FontSize="20" FontWeight="Bold" Foreground="#00796B"/>
                    <TextBlock Text="Đánh giá Điểm mạnh – Điểm yếu – Cơ hội – Thách thức" FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#F1F8E9">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#B2DFDB"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#00796B"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Hướng dẫn &amp; Ghi chú" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Thực hành Phân Tích" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#E0E0E0"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 1: HƯỚNG DẪN & GHI CHÚ -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#B2DFDB" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#00796B" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#B2DFDB" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
<!-- Khối ý nghĩa & nguồn gốc -->
                        <Border Background="#E3F2FD" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#BBDEFB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 NGUỒN GỐC &amp; Ý NGHĨA" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtToolMeaning" TextWrapping="Wrap" FontSize="13" Foreground="#424242" Margin="0,0,0,8"/>
                                <TextBlock Text="🌍 ÁP DỤNG THỰC TẾ" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtToolApplication" TextWrapping="Wrap" FontSize="13" Foreground="#424242"/>
                            </StackPanel>
                        </Border>

                        <!-- Khối hướng dẫn thao tác trực quan từng bước -->
                        <Border Background="#FFF3E0" CornerRadius="6" Padding="12,10" Margin="0,0,0,10" BorderBrush="#FFE0B2" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 HƯỚNG DẪN THAO TÁC TRỰC QUAN TỪNG BƯỚC" FontWeight="Bold" Foreground="#E65100" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="1️⃣ Nhập tên chủ đề cần phân tích vào ô '📋 Đối tượng phân tích' (Ví dụ: Dự án gom giấy vụn lớp 10A, Lựa chọn nghề thiết kế đồ họa, Bản thân em năm học mới...)." FontSize="13" Foreground="#424242" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="2️⃣ Nhập các mục phân tích vào Ma trận SWOT 2x2 ở dưới:" FontSize="13" Foreground="#424242" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="      • Cách 1 (Nhanh): Nhấp vào '🎯 Template ▼' trên thanh tiêu đề và chọn một mẫu có sẵn phù hợp với chủ đề để tham khảo cách viết." FontSize="13" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                <TextBlock Text="      • Cách 2 (Tự viết): Nhấp nút '+ Thêm mục' dưới góc tương ứng, gõ chữ rồi nhấn phím 'Enter' trên bàn phím để tự động thêm nhanh dòng mới tiếp theo." FontSize="13" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                <TextBlock Text="      • Xóa bớt: Nhấp ký hiệu '✕' ở bên phải mỗi dòng để xóa mục viết sai." FontSize="13" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="3️⃣ Nhấp nút '💡 Gợi ý chiến lược' để hệ thống tự động liên kết chéo các yếu tố S-W-O-T thành giải pháp hành động cụ thể (SO, WO, ST, WT) hiển thị ở cuối trang." FontSize="13" Foreground="#424242" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="4️⃣ Nhấp nút '📷 Export PNG' để tải về ảnh báo cáo SWOT nền trắng sắc nét để nộp bài hoặc thuyết trình trước lớp học." FontSize="13" Foreground="#424242" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock TextWrapping="Wrap" FontSize="13" FontWeight="Normal" Foreground="#424242">
                            <Run FontWeight="Bold" Text="Cách điền 4 ô phân tích:"/>&#x0a;
                            • <Run FontWeight="SemiBold" Foreground="#2E7D32" Text="💚 S (Điểm mạnh - Nội bộ):"/> Những gì bạn đang làm rất tốt, kỹ năng/môn học nổi trội của bạn.&#x0a;
                            • <Run FontWeight="SemiBold" Foreground="#F57F17" Text="💛 W (Điểm yếu - Nội bộ):"/> Những mặt hạn chế, thói quen xấu hoặc kiến thức bạn còn hổng.&#x0a;
                            • <Run FontWeight="SemiBold" Foreground="#1565C0" Text="💙 O (Cơ hội - Bên ngoài):"/> Những yếu tố tích cực từ gia đình, nhà trường, xã hội mang lại lợi thế cho bạn.&#x0a;
                            • <Run FontWeight="SemiBold" Foreground="#C62828" Text="💔 T (Thách thức - Bên ngoài):"/> Những khó khăn, rủi ro khách quan từ hoàn cảnh bên ngoài.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: THỰC HÀNH PHÂN TÍCH -->
                <ScrollViewer x:Name="viewPractice" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="mainPanel" HorizontalAlignment="Stretch">
                        <Border x:Name="exportArea" Background="White" CornerRadius="10" Padding="4">
                            <StackPanel>
                                <!-- Subject input -->
                                <Border Background="#ECEFF1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                        BorderBrush="#B0BEC5" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock Text="📋 Đối tượng phân tích:" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#455A64" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtSubject" FontSize="15" Padding="8,6" Style="{StaticResource ModernTextBox}"
                                                 BorderBrush="#B2DFDB" BorderThickness="1" Background="White"/>
                                    </DockPanel>
                                </Border>

                                <!-- SWOT Matrix 2x2 -->
                                <Grid x:Name="swotGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- S - Strengths -->
                                    <Border x:Name="borderS" Grid.Row="0" Grid.Column="0" CornerRadius="10,0,0,0" Margin="0,0,2,2"
                                            Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="2,2,1,1" Padding="12" MinHeight="200">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="💚 S — Strengths" FontSize="16" FontWeight="Bold" Foreground="#2E7D32"/>
                                                <TextBlock Text=" (Điểm mạnh)" FontSize="13" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="Yếu tố NỘI BỘ tích cực" FontSize="12" FontWeight="SemiBold" Foreground="#81C784" Margin="0,2,0,8"/>
                                            <TextBlock x:Name="lblPlaceholderS" Text="VD: Giao tiếp tốt, Ngoại ngữ giỏi..." FontSize="13" FontStyle="Italic" Foreground="#A5D6A7" Margin="4,0,0,8"/>
                                            <StackPanel x:Name="panelS"/>
                                            <Button Content="+ Thêm mục" Style="{StaticResource SwotAddButtonS}" Click="AddS_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- W - Weaknesses -->
                                    <Border x:Name="borderW" Grid.Row="0" Grid.Column="1" CornerRadius="0,10,0,0" Margin="2,0,0,2"
                                            Background="#FFF8E1" BorderBrush="#FFC107" BorderThickness="1,2,2,1" Padding="12" MinHeight="200">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="💛 W — Weaknesses" FontSize="16" FontWeight="Bold" Foreground="#F57F17"/>
                                                <TextBlock Text=" (Điểm yếu)" FontSize="13" FontWeight="Bold" Foreground="#FFC107" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="Yếu tố NỘI BỘ tiêu cực" FontSize="12" FontWeight="SemiBold" Foreground="#FFD54F" Margin="0,2,0,8"/>
                                            <TextBlock x:Name="lblPlaceholderW" Text="VD: Thiếu tập trung, Tính chần chừ..." FontSize="13" FontStyle="Italic" Foreground="#FFE082" Margin="4,0,0,8"/>
                                            <StackPanel x:Name="panelW"/>
                                            <Button Content="+ Thêm mục" Style="{StaticResource SwotAddButtonW}" Click="AddW_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- O - Opportunities -->
                                    <Border x:Name="borderO" Grid.Row="1" Grid.Column="0" CornerRadius="0,0,0,10" Margin="0,2,2,0"
                                            Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="2,1,1,2" Padding="12" MinHeight="200">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="💙 O — Opportunities" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                                                <TextBlock Text=" (Cơ hội)" FontSize="13" FontWeight="Bold" Foreground="#2196F3" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="Yếu tố BÊN NGOÀI tích cực" FontSize="12" FontWeight="SemiBold" Foreground="#64B5F6" Margin="0,2,0,8"/>
                                            <TextBlock x:Name="lblPlaceholderO" Text="VD: Học bổng mới, Mạng lưới bạn bè..." FontSize="13" FontStyle="Italic" Foreground="#90CAF9" Margin="4,0,0,8"/>
                                            <StackPanel x:Name="panelO"/>
                                            <Button Content="+ Thêm mục" Style="{StaticResource SwotAddButtonO}" Click="AddO_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- T - Threats -->
                                    <Border x:Name="borderT" Grid.Row="1" Grid.Column="1" CornerRadius="0,0,10,0" Margin="2,2,0,0"
                                            Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1,1,2,2" Padding="12" MinHeight="200">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="💔 T — Threats" FontSize="16" FontWeight="Bold" Foreground="#C62828"/>
                                                <TextBlock Text=" (Thách thức)" FontSize="13" FontWeight="Bold" Foreground="#F44336" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="Yếu tố BÊN NGOÀI tiêu cực" FontSize="12" FontWeight="SemiBold" Foreground="#EF9A9A" Margin="0,2,0,8"/>
                                            <TextBlock x:Name="lblPlaceholderT" Text="VD: Nguy cơ thất nghiệp, Cạnh tranh cao..." FontSize="13" FontStyle="Italic" Foreground="#EF9A9A" Margin="4,0,0,8"/>
                                            <StackPanel x:Name="panelT"/>
                                            <Button Content="+ Thêm mục" Style="{StaticResource SwotAddButtonT}" Click="AddT_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Strategy Section -->
                                <Border x:Name="strategySection" Background="#FAFAFA" CornerRadius="10" Padding="16,12" Margin="0,16,0,0"
                                        BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="💡 GỢI Ý CHIẾN LƯỢC" FontSize="16" FontWeight="Bold" Foreground="#00796B" Margin="0,0,0,10"/>
                                        <StackPanel x:Name="strategyContent"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 3: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="contentApp" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

