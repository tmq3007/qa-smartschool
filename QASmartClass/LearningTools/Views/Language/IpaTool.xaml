<controls:BaseToolControl x:Class="QASmartClass.LearningTools.Views.Language.IpaTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QASmartClass.LearningTools.Controls"
             Background="{StaticResource Gray100}">

    <Grid x:Name="rootGrid" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="0" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E0F2F1" Offset="0"/>
                    <GradientStop Color="#B2DFDB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📖 Bảng Phiên Âm IPA" FontSize="18" FontWeight="Bold" Foreground="#00695C"/>
                    <TextBlock Text="Lớp 6-12 • Nguyên âm, Phụ âm • Quiz phát âm • Minimal Pairs" FontSize="13" Foreground="#26A69A" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === MAIN CONTENT (Master-Detail) === -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: SIDEBAR MENU -->
            <Grid Grid.Column="0" Background="#E0F2F1">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E1BEE7"/>
                    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#6A1B9A"/>
                </Grid.Resources>
                <ListBox x:Name="sideMenu" BorderThickness="0" Background="Transparent" 
                         SelectionChanged="SideMenu_SelectionChanged" Margin="4"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">

                    <ListBoxItem IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextGuide" Text="Hướng dẫn &amp; Quy trình" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗣️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextTable" Text="Bảng phiên âm IPA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextQuiz" Text="Trắc nghiệm IPA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextMinPairs" Text="Cặp âm tối thiểu" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="menuTextPractical" Text="Ứng dụng thực tế" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <!-- ĐƯỜNG PHÂN TÁCH -->
            <Border Grid.Column="1" Background="#B2DFDB"/>

            <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
            <Grid Grid.Column="2" Margin="16">
                <!-- VIEW 0: HƯỚNG DẪN & QUY TRÌNH -->
                <ScrollViewer x:Name="viewGuide" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Background="White" Margin="12">
                        <Border Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,16" BorderBrush="#E1BEE7" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Cột 1: Dành cho Giáo viên -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="👩‍🏫 Dành cho Giáo viên (Teacher Mode)" FontSize="16" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Rê chuột vào nội dung cần trình chiếu, bấm [🎯 Focus] để phóng to trên màn hình học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Bấm [🖊️ Bảng trắng] để chụp ảnh nội dung đưa vào bảng vẽ minh họa." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Bấm [📊 Xuất lịch sử (Excel)] ở tiêu đề để xuất kết quả làm bài của học sinh." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                                <!-- Đường chia giữa -->
                                <Border Grid.Column="1" Background="#E1BEE7" Width="1" Margin="10,0" VerticalAlignment="Stretch"/>
                                <!-- Cột 2: Dành cho Học sinh -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="🧑‍🎓 Dành cho Học sinh (Student Mode)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                                    <TextBlock Text="• Bước 1: Đọc hướng dẫn bên dưới, sau đó chọn tab chức năng phù hợp trên sidebar." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 2: Thực hành các bài tập theo yêu cầu của giáo viên." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="• Bước 3: Kiểm tra kết quả và hoàn thành bài tập." FontSize="13.5" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Khối hướng dẫn -->
                        <Border Background="#E0F2F1" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#B2DFDB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 BẢNG PHIÊN ÂM QUỐC TẾ IPA LÀ GÌ?" FontWeight="Bold" Foreground="#00695C" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#424242" LineHeight="18">
                                    IPA (International Phonetic Alphabet) là hệ thống ký hiệu âm vị chuẩn quốc tế. Thành thạo bảng IPA giúp người học phát âm tiếng Anh chính xác tuyệt đối, cải thiện kỹ năng nghe và tự tin giao tiếp chuẩn bản xứ.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🎯 Quy trình luyện tập 3 bước:" FontSize="15" FontWeight="Bold" Foreground="#00695C" Margin="0,4,0,8"/>
                        <TextBlock Text="1. Học cách phát âm: Bấm chọn từng ký tự IPA để nghe phát âm mẫu và xem các từ ví dụ minh họa kèm nghĩa." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="2. So sánh cặp âm tối thiểu (Minimal Pairs): Phân biệt hai âm tương đồng dễ gây nhầm lẫn để cải thiện độ chuẩn xác." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                        <TextBlock Text="3. Trắc nghiệm kiểm tra (Quiz): Làm bài test nhanh 10 câu ngẫu nhiên để đánh giá phản xạ nhận dạng âm IPA của bản thân." FontSize="13.5" Foreground="#424242" Margin="4,2"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: BẢNG IPA -->
                <ScrollViewer x:Name="viewTable" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="ipaPanel" Margin="8" HorizontalAlignment="Center"/>
                </ScrollViewer>

                <!-- VIEW 2: QUIZ IPA -->
                <Grid x:Name="viewQuiz" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="txtIpaScore" Text="Điểm: 0/0" FontSize="18" FontWeight="Bold" Foreground="#00695C"/>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1600">
                        <TextBlock x:Name="txtIpaQ" Text="Luyện tập nhận diện âm IPA" FontSize="26" FontWeight="Bold" Foreground="#1A237E"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtIpaHint" Text="Bấm nút bên dưới để bắt đầu bài trắc nghiệm 10 câu ngẫu nhiên" FontSize="14" Foreground="#757575" HorizontalAlignment="Center" Margin="0,6,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel x:Name="mcIpaPanel" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtIpaFeedback" Text="" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,20"/>
                        <Button x:Name="btnIpaStart" Content="✏️ Bắt đầu (10 câu)" FontSize="16" FontWeight="Bold"
                                Padding="30,12" Background="#00695C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Center" Click="IpaQuizStart_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- VIEW 3: MINIMAL PAIRS -->
                <ScrollViewer x:Name="viewMinPairs" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="minPairsPanel" Margin="12" HorizontalAlignment="Center"/>
                </ScrollViewer>

                <!-- VIEW 4: ỨNG DỤNG THỰC TẾ -->
                <Border x:Name="viewPractical" HorizontalAlignment="Stretch" Margin="20" Visibility="Collapsed">
                    <controls:PracticalAppViewer x:Name="practicalAppViewer" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:BaseToolControl>
