                ("Chem", "⚡ Oxi hóa – Khử & Nhiệt luyện", "Fe2O3 + CO -> Fe + CO2", ""),

                ("Chem", "🧬 Kim loại + Axit (Thường & Đặc nóng)", "Zn + HCl -> ZnCl2 + H2", ""),
