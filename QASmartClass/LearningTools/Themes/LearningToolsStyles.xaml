<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         QA SmartClass — LearningTools Shared Styles v3.0
         Ngày tạo: 2026-07-07
         
         SIDEBAR LISTBOX ITEM STYLE
         Dùng chung cho TẤT CẢ Learning Tools có sidebar menu.
         ⚠️ KHÔNG sửa đổi mà không review toàn bộ 70+ tools.
         
         Cách sử dụng trong tool XAML:
         ┌──────────────────────────────────────────────────────┐
         │  <Grid.Resources>                                     │
         │    <SolidColorBrush x:Key="SidebarHoverBrush"         │
         │                     Color="#C5CAE9"/>                  │
         │    <SolidColorBrush x:Key="SidebarSelectedBrush"      │
         │                     Color="{StaticResource             │
         │                             BrandPrimaryColor}"/>     │
         │  </Grid.Resources>                                    │
         │                                                        │
         │  <ListBox ItemContainerStyle=                          │
         │    "{StaticResource SidebarListBoxItemStyle}" ... />   │
         └──────────────────────────────────────────────────────┘
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════ SIDEBAR LISTBOX ITEM STYLE ═══════════════ -->
    <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
        <!-- Touch target: Padding 12,14 đảm bảo chiều cao ≥ 44px (v4.1 requirement) -->
        <Setter Property="Padding" Value="12,14"/>
        <!-- Margin 2,4 tạo gap giữa các items, tránh bấm nhầm -->
        <Setter Property="Margin" Value="2,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border CornerRadius="8" 
                            Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Hover: Dùng DynamicResource để mỗi tool override màu riêng
                 Mỗi tool phải khai báo SidebarHoverBrush trong Grid.Resources
                 Fallback: #C5CAE9 (BrandPrimary light) nếu không khai báo -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" 
                        Value="{DynamicResource SidebarHoverBrush}"/>
            </Trigger>
            <!-- Selected: Dùng DynamicResource SidebarSelectedBrush
                 Mỗi tool phải khai báo SidebarSelectedBrush trong Grid.Resources
                 Fallback: BrandPrimary (#1565C0) nếu không khai báo -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" 
                        Value="{DynamicResource SidebarSelectedBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════ DEFAULT SIDEBAR BRUSHES (FALLBACK) ═══════════════ -->
    <!-- Các tool PHẢI override bằng local resources trong Grid.Resources 
         để có màu riêng theo Category (Math=Blue, Science=Green, etc.) -->
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#C5CAE9"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>

</ResourceDictionary>
