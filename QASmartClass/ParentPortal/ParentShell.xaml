<Window x:Class="QASmartClass.ParentPortal.ParentShell"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="QA SmartSchool — Cổng Phụ huynh" 

        Width="1100" Height="700" WindowStartupLocation="CenterScreen"

        Background="#F0F2F5" FontFamily="Segoe UI">



    <Window.Resources>

        <Style x:Key="NavBtnStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#CBD5E1"/>

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Padding" Value="14,11"/>

            <Setter Property="Margin" Value="0,2"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bg" Property="Background" Value="#FFFFFF15"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- ═══ SIDEBAR ═══ -->

        <Border Grid.Column="0" CornerRadius="0,16,16,0">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                    <GradientStop Color="#1E3A5F" Offset="0"/>

                    <GradientStop Color="#0D1B2A" Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

            <StackPanel>

                <!-- Logo -->

                <StackPanel Margin="20,24,20,8">

                    <TextBlock Text="🏫 QA SmartSchool" FontSize="20" FontWeight="Bold" Foreground="White"/>

                    <TextBlock Text="Cổng Phụ huynh" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>

                </StackPanel>



                <!-- Student Info Card -->

                <Border Background="#FFFFFF10" CornerRadius="10" Margin="16,8,16,20" Padding="14">

                    <StackPanel>

                        <TextBlock x:Name="txtStudentName" Text="..." FontSize="15" FontWeight="SemiBold" Foreground="White"/>

                        <TextBlock x:Name="txtClassName" Text="..." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>

                        <TextBlock x:Name="txtParentName" Text="..." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>

                    </StackPanel>

                </Border>



                <Border Height="1" Background="#FFFFFF15" Margin="16,0"/>



                <!-- Nav Items -->

                <StackPanel Margin="12,16,12,0">

                    <Button x:Name="btnDashboard" Tag="dashboard" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="📊  Tổng quan" />

                    <Button x:Name="btnGrades" Tag="grades" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="📝  Bảng điểm" />

                    <Button x:Name="btnAttendance" Tag="attendance" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="📅  Điểm danh" />

                    <Button x:Name="btnTimetable" Tag="timetable" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="📆  Lịch học" />

                    <Button x:Name="btnBulletin" Tag="bulletin" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="📢  Thông báo" />

                    <Button x:Name="btnTuition" Tag="tuition" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="💳  Học phí" />

                    <Button x:Name="btnNotification" Tag="notification" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}">

                        <DockPanel>

                            <TextBlock Text="🔔  Thông báo" VerticalAlignment="Center"/>

                            <Border x:Name="BadgeNotif" Background="#EF4444" CornerRadius="10" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed" HorizontalAlignment="Right">

                                <TextBlock x:Name="TxtBadgeCount" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>

                            </Border>

                        </DockPanel>

                    </Button>

                    

                    <Border Height="1" Background="#FFFFFF10" Margin="0,8"/>

                    

                    <Button x:Name="btnFamilyGame" Tag="familygame" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="🎮  Family Game" />

                    <Button x:Name="btnMessages" Tag="messages" Click="NavItem_Click" Style="{StaticResource NavBtnStyle}"

                            Content="💬  Nhắn tin GV" />

                </StackPanel>



                <!-- Logout -->

                <Button Content="🚪  Đăng xuất" Click="Logout_Click" Margin="12,40,12,0"

                        Background="#FFFFFF10" Foreground="#94A3B8" FontSize="13"

                        Padding="12,10" HorizontalContentAlignment="Left"

                        Cursor="Hand" BorderThickness="0">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">

                                <ContentPresenter/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </StackPanel>

        </Border>



        <!-- ═══ CONTENT AREA ═══ -->

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="0"/>

    </Grid>

</Window>





