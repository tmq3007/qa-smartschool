<Page x:Class="QASmartClass.ParentPortal.Views.ParentTimetablePage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Lịch học" FontFamily="Segoe UI" Background="#F8FAFC">



    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Text="📆 Thời Khóa Biểu Tuần" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>



        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">

            <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

            <Grid x:Name="TimetableGrid">

                <Grid.RowDefinitions>

                    <RowDefinition Height="45"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="80"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>



                <!-- Headers -->

                <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" Padding="5"><TextBlock Text="Tiết" FontWeight="Bold" FontSize="14" Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="0" Grid.Column="1" Background="#EFF6FF" Padding="5"><TextBlock Text="Thứ 2" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="0" Grid.Column="2" Background="#EFF6FF" Padding="5"><TextBlock Text="Thứ 3" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="0" Grid.Column="3" Background="#EFF6FF" Padding="5"><TextBlock Text="Thứ 4" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="0" Grid.Column="4" Background="#EFF6FF" Padding="5"><TextBlock Text="Thứ 5" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="0" Grid.Column="5" Background="#EFF6FF" Padding="5"><TextBlock Text="Thứ 6" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="0" Grid.Column="6" Background="#FFF7ED" Padding="5"><TextBlock Text="Thứ 7" FontWeight="Bold" FontSize="14" Foreground="#C2410C" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>



                <!-- Tiết labels -->

                <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" Padding="5"><TextBlock Text="Tiết 1" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" Padding="5"><TextBlock Text="Tiết 2" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="3" Grid.Column="0" Background="#F8FAFC" Padding="5"><TextBlock Text="Tiết 3" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="4" Grid.Column="0" Background="#F8FAFC" Padding="5"><TextBlock Text="Tiết 4" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

                <Border Grid.Row="5" Grid.Column="0" Background="#F8FAFC" Padding="5"><TextBlock Text="Tiết 5" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>

            </Grid>

        </Border>

    </Grid>

</Page>



