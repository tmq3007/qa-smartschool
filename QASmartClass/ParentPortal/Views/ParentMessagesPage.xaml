<Page x:Class="QASmartClass.ParentPortal.Views.ParentMessagesPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Nhắn tin GV" Background="#F0F2F5" FontFamily="Segoe UI">



    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">

            <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <StackPanel>

                <TextBlock Text="💬 Nhắn tin với Giáo viên" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>

                <TextBlock x:Name="txtInfo" Text="..." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>

            </StackPanel>

        </Border>



        <!-- Messages List -->

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="listMessages">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="4,4" Padding="12,8" CornerRadius="10"

                                    Background="{Binding BgColor}" HorizontalAlignment="{Binding Alignment}">

                                <StackPanel MaxWidth="500">

                                    <TextBlock Text="{Binding SenderLabel}" FontSize="11" FontWeight="SemiBold" 

                                               Foreground="{Binding LabelColor}" Margin="0,0,0,2"/>

                                    <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#1E293B" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#94A3B8" 

                                               HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Border>



        <!-- Compose -->

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtMessage" Grid.Column="0" FontSize="14" Padding="12,10" 

                         VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#E2E8F0"

                         Text="" ToolTip="Nhập tin nhắn gửi giáo viên...">

                    <TextBox.Resources>

                        <Style TargetType="Border">

                            <Setter Property="CornerRadius" Value="8"/>

                        </Style>

                    </TextBox.Resources>

                </TextBox>

                <Button Grid.Column="1" Content="📤 Gửi" Click="SendMessage_Click" Margin="8,0,0,0"

                        Background="#3B82F6" Foreground="White" FontSize="14" FontWeight="SemiBold"

                        Padding="20,10" Cursor="Hand" BorderThickness="0">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>

    </Grid>

</Page>



