<Page x:Class="QASmartClass.ParentPortal.Views.ParentAttendancePage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Điểm danh" FontFamily="Segoe UI" Background="#F8FAFC">



    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Text="📅 Lịch Sử Điểm Danh" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

        

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">

            <TextBlock Text="Tháng:" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <ComboBox x:Name="CbMonth" Width="100" Height="35" FontSize="15" SelectionChanged="CbMonth_SelectionChanged"/>

            <TextBlock Text="Tổng kết:" FontSize="15" VerticalAlignment="Center" Margin="20,0,10,0"/>

            <Border Background="#DCFCE7" CornerRadius="8" Padding="10,5">

                <TextBlock x:Name="TxtSummary" Text="..." FontSize="14" Foreground="#16A34A"/>

            </Border>

        </StackPanel>



        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="350"/>

            </Grid.ColumnDefinitions>



            <!-- Lịch tháng -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">

                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

                <Calendar x:Name="AttendanceCalendar" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

            </Border>



            <!-- Danh sách ngày vắng -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">

                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03"/></Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Text="📋 Nhật ký chuyên cần" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                    <ListView Grid.Row="1" x:Name="LvAbsences" BorderThickness="0" Background="Transparent">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8" Margin="0,0,0,5">

                                    <StackPanel>

                                        <TextBlock Text="{Binding DateDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="#DC2626"/>

                                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#92400E"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>



