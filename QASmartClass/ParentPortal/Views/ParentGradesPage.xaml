<Page x:Class="QASmartClass.ParentPortal.Views.ParentGradesPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Bảng điểm" Background="#F0F2F5" FontFamily="Segoe UI">



    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">

        <StackPanel MaxWidth="900" HorizontalAlignment="Center">



            <!-- Header -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">

                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

                <StackPanel>

                    <TextBlock Text="📝 Bảng điểm chi tiết" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>

                    <TextBlock x:Name="txtStudentInfo" Text="..." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>

                </StackPanel>

            </Border>



            <!-- Grades Table -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <!-- Table Header -->

                    <Grid Background="#F8FAFC" Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="2*"/>

                            <ColumnDefinition Width="1*"/>

                            <ColumnDefinition Width="1*"/>

                            <ColumnDefinition Width="1*"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Môn học" FontWeight="SemiBold" FontSize="13" Foreground="#64748B" Padding="12,8"/>

                        <TextBlock Grid.Column="1" Text="Loại điểm" FontWeight="SemiBold" FontSize="13" Foreground="#64748B" Padding="8"/>

                        <TextBlock Grid.Column="2" Text="Điểm" FontWeight="SemiBold" FontSize="13" Foreground="#64748B" Padding="8" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="3" Text="Ngày" FontWeight="SemiBold" FontSize="13" Foreground="#64748B" Padding="8" HorizontalAlignment="Right"/>

                    </Grid>



                    <!-- Grades List -->

                    <ItemsControl x:Name="listGrades">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,6">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="2*"/>

                                            <ColumnDefinition Width="1*"/>

                                            <ColumnDefinition Width="1*"/>

                                            <ColumnDefinition Width="1*"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Subject}" FontSize="13" Foreground="#1E293B" Padding="12,4"/>

                                        <TextBlock Grid.Column="1" Text="{Binding GradeType}" FontSize="12" Foreground="#64748B" Padding="8,4"/>

                                        <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="14" FontWeight="Bold" 

                                                   Foreground="{Binding ScoreColor}" Padding="8,4" HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="12" Foreground="#94A3B8" 

                                                   Padding="8,4" HorizontalAlignment="Right"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <TextBlock x:Name="txtNoGrades" Text="Chưa có dữ liệu điểm." FontSize="14" Foreground="#94A3B8" 

                               Margin="12,16" Visibility="Collapsed"/>

                </StackPanel>

            </Border>

            <!-- P1-05: Biểu đồ tiến bộ theo tuần -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <DockPanel Margin="0,0,0,14">

                        <TextBlock Text="📈 Biểu đồ tiến bộ theo tuần" FontSize="18"

                                   FontWeight="Bold" Foreground="#1E293B"/>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"

                                    HorizontalAlignment="Right" VerticalAlignment="Center">

                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">

                                <TextBlock x:Name="TxtClassAvg" Text="TB lớp: —"

                                           FontSize="11" Foreground="#1D4ED8" FontWeight="SemiBold"/>

                            </Border>

                            <TextBlock x:Name="TxtTrend" Text="" FontSize="12"

                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </DockPanel>



                    <!-- Bar chart container -->

                    <ItemsControl x:Name="ChartBars">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="65"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="55"/>

                                        <ColumnDefinition Width="30"/>

                                    </Grid.ColumnDefinitions>

                                    <!-- Week label -->

                                    <TextBlock Text="{Binding WeekLabel}" FontSize="11"

                                               Foreground="#64748B" VerticalAlignment="Center"/>

                                    <!-- Bar background + filled bar -->

                                    <Border Grid.Column="1" Height="20" CornerRadius="4"

                                            Background="#F1F5F9" VerticalAlignment="Center" Margin="4,0">

                                        <Grid>

                                            <Rectangle Height="20" Fill="{Binding BarBrush}"

                                                       Width="{Binding BarWidth}"

                                                       HorizontalAlignment="Left"

                                                       RadiusX="4" RadiusY="4"/>

                                            <!-- Class average marker line -->

                                            <Border HorizontalAlignment="Left"

                                                    Margin="{Binding ClassAvgMargin}"

                                                    Width="2" Background="#1D4ED8" Opacity="0.5"/>

                                        </Grid>

                                    </Border>

                                    <!-- Score text -->

                                    <TextBlock Grid.Column="2" Text="{Binding ScoreDisplay}"

                                               FontSize="12" FontWeight="Bold"

                                               Foreground="{Binding BarBrush}"

                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                    <!-- Trend arrow -->

                                    <TextBlock Grid.Column="3" Text="{Binding Arrow}"

                                               FontSize="14" VerticalAlignment="Center"

                                               HorizontalAlignment="Center"/>

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <!-- Legend -->

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,4,0"/>

                        <TextBlock Text="Tăng" FontSize="11" Foreground="#64748B" Margin="0,0,12,0"/>

                        <Border Width="12" Height="12" CornerRadius="2" Background="#EF4444" Margin="0,0,4,0"/>

                        <TextBlock Text="Giảm" FontSize="11" Foreground="#64748B" Margin="0,0,12,0"/>

                        <Border Width="2" Height="12" Background="#1D4ED8" Opacity="0.5" Margin="0,0,4,0"/>

                        <TextBlock Text="TB lớp" FontSize="11" Foreground="#64748B"/>

                    </StackPanel>



                    <!-- No data message -->

                    <TextBlock x:Name="TxtNoChart" Text="Chưa đủ dữ liệu để hiển thị biểu đồ."

                               FontSize="13" Foreground="#94A3B8" Margin="0,8"

                               HorizontalAlignment="Center" Visibility="Collapsed"/>

                </StackPanel>

            </Border>



        </StackPanel>

    </ScrollViewer>

</Page>





