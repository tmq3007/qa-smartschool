<Page x:Class="QASmartClass.ParentPortal.Views.ParentDashboardPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Tổng quan" Background="#F0F2F5" FontFamily="Segoe UI">



    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">

        <StackPanel MaxWidth="900" HorizontalAlignment="Center">



            <!-- Header -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>

                </Border.Effect>

                <DockPanel>

                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="#10B981" Offset="0"/>

                                <GradientStop Color="#059669" Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                        <TextBlock Text="👨‍👩‍👧" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="txtGreeting" Text="Xin chào, Phụ huynh 👋" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>

                        <TextBlock x:Name="txtSubtitle" Text="Con em: ..." FontSize="13" Foreground="#64748B"/>

                    </StackPanel>

                    <!-- P1-06: Badge thông báo chưa đọc -->

                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"

                                VerticalAlignment="Center" Orientation="Horizontal">

                        <Border Background="#FEF2F2" CornerRadius="20" Padding="12,6"

                                Cursor="Hand" MouseLeftButtonUp="BtnViewNotifs_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="🔔" FontSize="16" VerticalAlignment="Center"/>

                                <Border Background="#EF4444" CornerRadius="10" Padding="5,2"

                                        Margin="4,0,0,0" x:Name="TxtNotifBadgeBorder" Visibility="Collapsed">

                                    <TextBlock x:Name="TxtNotifBadgeText" Text="0" FontSize="11" Foreground="White" FontWeight="Bold"/>

                                </Border>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </DockPanel>

            </Border>



            <!-- P1-06: Panel cảnh báo Early Warning -->

            <Border x:Name="PanelWarning" Background="#FEF2F2" CornerRadius="10"

                    BorderBrush="#FCA5A5" BorderThickness="1" Padding="16,12"

                    Margin="0,0,0,16" Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="⚠️ Cảnh báo từ nhà trường" FontSize="14"

                               FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,4"/>

                    <TextBlock x:Name="TxtWarningDetail" Text="" FontSize="13"

                               Foreground="#B91C1C" TextWrapping="Wrap"/>

                </StackPanel>

            </Border>







            <!-- Stats Grid -->

            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">

                <!-- Điểm TB -->

                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0">

                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtAvgScore" Text="—" FontSize="26" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <TextBlock Text="Điểm TB" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- Điểm danh -->

                <Border Background="White" CornerRadius="12" Padding="16" Margin="4,0">

                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="✅" FontSize="28" HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtAttendance" Text="—" FontSize="26" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <TextBlock Text="Có mặt" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- Hạnh kiểm -->

                <Border Background="White" CornerRadius="12" Padding="16" Margin="4,0">

                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="⭐" FontSize="28" HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtConduct" Text="—" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <TextBlock Text="Hạnh kiểm" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- Bài tập -->

                <Border Background="White" CornerRadius="12" Padding="16" Margin="8,0,0,0">

                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtPending" Text="—" FontSize="26" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <TextBlock Text="Chưa nộp" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </UniformGrid>



            <!-- Attendance Detail -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <TextBlock Text="📅 Điểm danh tháng này" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">

                            <TextBlock x:Name="txtPresent" Text="0" FontSize="22" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>

                            <TextBlock Text="Có mặt" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                            <TextBlock x:Name="txtLate" Text="0" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>

                            <TextBlock Text="Đi trễ" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">

                            <TextBlock x:Name="txtAbsent" Text="0" FontSize="22" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>

                            <TextBlock Text="Vắng" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Border>



            <!-- P1-06: Inbox thông báo từ nhà trường -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">

                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04"/></Border.Effect>

                <StackPanel>

                    <DockPanel Margin="0,0,0,12">

                        <TextBlock Text="🔔 Thông báo từ nhà trường" FontSize="16"

                                   FontWeight="SemiBold" Foreground="#1E293B"/>

                        <TextBlock x:Name="TxtNotifCount" Text="..."

                                   FontSize="12" Foreground="#64748B"

                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    </DockPanel>

                    <ListBox x:Name="LstNotifications" BorderThickness="0"

                             Background="Transparent" MaxHeight="200" FontSize="13">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6"

                                        Background="#F8FAFC">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"

                                                   FontSize="13" Foreground="#1E293B"/>

                                        <TextBlock Text="{Binding TimeStr}" FontSize="11"

                                                   Foreground="#94A3B8" Margin="0,3,0,0"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding" Value="0"/>

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                            </Style>

                        </ListBox.ItemContainerStyle>

                    </ListBox>

                </StackPanel>

            </Border>



        </StackPanel>

    </ScrollViewer>



</Page>



