<Page x:Class="QASmartClass.ParentPortal.Views.ParentNotificationPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Hộp thư Thông báo" Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <TextBlock Text="🔔 Hộp thư Thông báo" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>



        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">

            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05"/></Border.Effect>

            <ListView x:Name="LvNotifications" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SelectionChanged="LvNotifications_SelectionChanged">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border Background="{Binding BgColor}" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                                    <TextBlock Text="{Binding StatusIcon}" Margin="0,0,10,0"/>

                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                </StackPanel>

                                <TextBlock Text="{Binding Content}" FontSize="15" FontWeight="{Binding FontWeight}" Foreground="#334155" TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>

    </Grid>

</Page>



