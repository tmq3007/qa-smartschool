<Page x:Class="QASmartClass.ParentPortal.Views.ParentLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Đăng nhập Phụ huynh" 
      FontFamily="Segoe UI">

    <Grid x:Name="MainGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#1E3A5F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Content Card -->
        <Border Background="White" 
                CornerRadius="15" 
                Width="500" 
                Padding="50,40" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" 
                                  Direction="270" 
                                  ShadowDepth="3" 
                                  BlurRadius="15" 
                                  Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo Section -->
                <StackPanel Orientation="Horizontal" 
                          HorizontalAlignment="Center" 
                          Margin="0,0,0,20">
                    <!-- Graduation Cap Icon -->
                    <Viewbox Width="40" Height="40" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="LoginIcon"
                                  Fill="#2E86DE" 
                                  Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z"/>
                        </Canvas>
                    </Viewbox>
                    <!-- Logo Text -->
                    <TextBlock x:Name="LoginAppName"
                              Text="QA SmartSchool" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="#2E86DE"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Welcome Text -->
                <TextBlock Text="Cổng thông tin Phụ huynh" 
                          FontSize="18" 
                          FontWeight="SemiBold"
                          Foreground="#2F3542"
                          HorizontalAlignment="Center" 
                          Margin="0,0,0,5"/>
                
                <TextBlock Text="Hệ thống kết nối Nhà trường và Gia đình" 
                          FontSize="13" 
                          Foreground="#747D8C"
                          HorizontalAlignment="Center" 
                          Margin="0,0,0,20"/>

                <!-- Chỉ dẫn từng bước đăng nhập -->
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,20" BorderBrush="#BFDBFE" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Hướng dẫn đăng nhập:" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" Margin="0,0,0,4"/>
                        <TextBlock Text="1. Nhập Mã học sinh (ví dụ: HS001) được cấp." FontSize="12" Foreground="#1E40AF"/>
                        <TextBlock Text="2. Nhập Số điện thoại phụ huynh khớp hồ sơ học bạ." FontSize="12" Foreground="#1E40AF"/>
                        <TextBlock x:Name="TxtGuidanceStep3" Text="3. Nhấn 'Đăng Nhập' để truy cập." FontSize="12" Foreground="#1E40AF"/>
                    </StackPanel>
                </Border>

                <!-- Test Account Selector (Only visible in Test mode) -->
                <StackPanel x:Name="PnlTestAccounts" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="🔑 Chọn nhanh tài khoản Test (CSDL):" Style="{StaticResource FormLabel}" Foreground="#2563EB" FontWeight="Bold"/>
                    <ComboBox x:Name="CboTestAccounts" Height="40" FontSize="14" Padding="10,6"
                              SelectionChanged="CboTestAccounts_SelectionChanged"/>
                </StackPanel>

                <!-- Mã học sinh -->
                <TextBlock Text="Mã học sinh:" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtStudentCode" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" FontSize="15"/>

                <!-- SĐT Phụ huynh -->
                <TextBlock Text="Số điện thoại phụ huynh:" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtParentPhone" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" FontSize="15"/>

                <!-- PIN/Mật khẩu Phụ huynh (Chỉ hiện khi chế độ bảo mật cao hoạt động) -->
                <StackPanel x:Name="PnlParentPin" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Mã PIN / Mật khẩu phụ huynh:" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="PswParentPin" Style="{StaticResource ModernPasswordBox}" FontSize="15"/>
                </StackPanel>

                <!-- Remember -->
                <CheckBox x:Name="ChkRemember" Content="Ghi nhớ đăng nhập" Style="{StaticResource ModernCheckBox}" Margin="0,5,0,0"/>

                <!-- Error -->
                <TextBlock x:Name="TxtError" Text="" FontSize="12" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"/>

                <!-- Login button -->
                <Button x:Name="BtnLogin" Content="Đăng Nhập" Style="{StaticResource ModernButton}" Height="45" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0" Cursor="Hand" Click="BtnLogin_Click" IsDefault="True"/>

                <TextBlock Text="Liên hệ nhà trường nếu quên thông tin" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
