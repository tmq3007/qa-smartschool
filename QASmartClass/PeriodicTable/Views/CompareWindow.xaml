<Window FontFamily="Segoe UI" x:Class="QASmartTouch.PeriodicTable.Views.CompareWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:local="clr-namespace:QASmartTouch.PeriodicTable.Views"

        xmlns:vm="clr-namespace:QASmartTouch.PeriodicTable.ViewModels"

        xmlns:conv="clr-namespace:QASmartTouch.PeriodicTable.Converters"

        mc:Ignorable="d"

        Title="So sánh Nguyên tố" 

        Height="700" Width="1100"

        WindowStartupLocation="CenterScreen"

        Background="#F5F7FA">

    

    <Window.DataContext>

        <vm:CompareViewModel/>

    </Window.DataContext>

    

    <Window.Resources>

        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        <conv:CompareModeToVisibilityConverter x:Key="CompareModeToVisibilityConverter"/>

        <conv:IntToBoolConverter x:Key="IntToBoolConverter"/>

        

        <!-- Style cho ComboBox hiện đại -->

        <Style x:Key="ModernComboBox" TargetType="ComboBox">

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Padding" Value="12,8"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="BorderBrush" Value="#E0E0E0"/>

            <Setter Property="BorderThickness" Value="1"/>

        </Style>

        

        <!-- Style cho TextBlock tiêu đề -->

        <Style x:Key="HeaderText" TargetType="TextBlock">

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Foreground" Value="#1C1C1C"/>

        </Style>

        

        <!-- Style cho TextBlock giá trị -->

        <Style x:Key="ValueText" TargetType="TextBlock">

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Foreground" Value="#1C1C1C"/>

            <Setter Property="TextAlignment" Value="Center"/>

        </Style>

    </Window.Resources>

    

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        

        <!-- Header với gradient và icon -->

        <Border Grid.Row="0" Background="#0B3D91" Padding="20,15">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                

                <TextBlock Grid.Column="0" 

                           Text="⚛" 

                           FontSize="28" 

                           Foreground="White"

                           VerticalAlignment="Center"

                           Margin="0,0,15,0"/>

                

                <TextBlock Grid.Column="1" 

                           Text="SO SÁNH NGUYÊN TỐ" 

                           FontSize="22" 

                           FontWeight="Bold" 

                           Foreground="White"

                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        

        <!-- Khu vực chọn nguyên tố với card hiện đại -->

        <Border Grid.Row="1" Background="White" 

                Margin="20,20,20,0" 

                Padding="25,20" 

                CornerRadius="8">

            <Border.Effect>

                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="2"/>

            </Border.Effect>

            

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                

                <!-- Toggle cho số nguyên tố so sánh -->

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">

                    <RadioButton Content=" 📊 So sánh 2 nguyên tố" 

                                 GroupName="CompareModeGroup"

                                 IsChecked="{Binding CompareMode, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"

                                 Margin="0,0,20,0"

                                 FontSize="14"

                                 FontWeight="SemiBold"

                                 Foreground="#0B3D91"/>

                    <RadioButton Content=" 📈 So sánh 3 nguyên tố" 

                                 GroupName="CompareModeGroup"

                                 IsChecked="{Binding CompareMode, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}"

                                 FontSize="14"

                                 FontWeight="SemiBold"

                                 Foreground="#0B3D91"/>

                </StackPanel>

                

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="60"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="60" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                

                <!-- Nguyên tố 1 -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="🔽 Chọn nguyên tố 1" 

                               Style="{StaticResource HeaderText}"

                               Margin="0,0,0,12"/>

                    <ComboBox ItemsSource="{Binding AllElements}"

                              SelectedItem="{Binding Element1}"

                              DisplayMemberPath="DisplayName"

                              Style="{StaticResource ModernComboBox}"

                              Height="40"/>

                    

                    <!-- Card thông tin nguyên tố 1 -->

                    <Border CornerRadius="6" 

                            Padding="15" 

                            Margin="0,15,0,0">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Background" Value="{Binding Element1.Color, Converter={StaticResource ColorToBrushConverter}}"/>

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Element1}" Value="{x:Null}">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <Border.Effect>

                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="1"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">

                                <Run Text="{Binding Element1.Symbol, Mode=OneWay}"/>

                            </TextBlock>

                            <TextBlock Text="{Binding Element1.Name}" 

                                       FontSize="14" 

                                       FontWeight="SemiBold"

                                       HorizontalAlignment="Center"

                                       Margin="0,5,0,0"/>

                            <TextBlock HorizontalAlignment="Center" 

                                       FontSize="12" 

                                       Margin="0,8,0,0"

                                       Opacity="0.8">

                                <Run Text="Z = "/><Run Text="{Binding Element1.AtomicNumber, Mode=OneWay}"/>

                                <Run Text=" | "/><Run Text="{Binding Element1.AtomicMass, StringFormat=F3, Mode=OneWay}"/>

                            </TextBlock>

                            <TextBlock Text="{Binding Element1.Category}" 

                                       FontSize="11" 

                                       HorizontalAlignment="Center"

                                       Margin="0,5,0,0"

                                       FontStyle="Italic"

                                       Opacity="0.7"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                

                <!-- Icon VS ở giữa với nút đổi chỗ -->

                <StackPanel Grid.Column="1" 

                            VerticalAlignment="Center" 

                            HorizontalAlignment="Center">

                    <TextBlock Text="VS" 

                               FontSize="20" 

                               FontWeight="Bold" 

                               Foreground="#0B3D91"

                               HorizontalAlignment="Center"

                               Margin="0,0,0,10"/>

                    <Button Content="🔄" 

                            Width="40" 

                            Height="40"

                            FontSize="18"

                            Background="#009688"

                            Foreground="White"

                            BorderThickness="0"

                            Cursor="Hand"

                            ToolTip="Đổi vị trí hai nguyên tố"

                            Command="{Binding SwapElementsCommand}">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="20"

                                                    BorderThickness="0">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#00796B"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </StackPanel>

                

                <!-- Nguyên tố 2 -->

                <StackPanel Grid.Column="2">

                    <TextBlock Text="🔽 Chọn nguyên tố 2" 

                               Style="{StaticResource HeaderText}"

                               Margin="0,0,0,12"/>

                    <ComboBox ItemsSource="{Binding AllElements}"

                              SelectedItem="{Binding Element2}"

                              DisplayMemberPath="DisplayName"

                              Style="{StaticResource ModernComboBox}"

                              Height="40"/>

                    

                    <!-- Card thông tin nguyên tố 2 -->

                    <Border CornerRadius="6" 

                            Padding="15" 

                            Margin="0,15,0,0">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Background" Value="{Binding Element2.Color, Converter={StaticResource ColorToBrushConverter}}"/>

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Element2}" Value="{x:Null}">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <Border.Effect>

                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="1"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">

                                <Run Text="{Binding Element2.Symbol, Mode=OneWay}"/>

                            </TextBlock>

                            <TextBlock Text="{Binding Element2.Name}" 

                                       FontSize="14" 

                                       FontWeight="SemiBold"

                                       HorizontalAlignment="Center"

                                       Margin="0,5,0,0"/>

                            <TextBlock HorizontalAlignment="Center" 

                                       FontSize="12" 

                                       Margin="0,8,0,0"

                                       Opacity="0.8">

                                <Run Text="Z = "/><Run Text="{Binding Element2.AtomicNumber, Mode=OneWay}"/>

                                <Run Text=" | "/><Run Text="{Binding Element2.AtomicMass, StringFormat=F3, Mode=OneWay}"/>

                            </TextBlock>

                            <TextBlock Text="{Binding Element2.Category}" 

                                       FontSize="11" 

                                       HorizontalAlignment="Center"

                                       Margin="0,5,0,0"

                                       FontStyle="Italic"

                                       Opacity="0.7"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                

                <!-- VS Icon thứ 2 (chỉ hiện khi mode 3 nguyên tố) -->

                <StackPanel Grid.Column="3" VerticalAlignment="Center" 

                            Visibility="{Binding CompareMode, Converter={StaticResource CompareModeToVisibilityConverter}}">

                    <TextBlock Text="VS" 

                               FontSize="24" 

                               FontWeight="Bold" 

                               Foreground="#0B3D91" 

                               HorizontalAlignment="Center"

                               Margin="0,0,0,10"/>

                    <Ellipse Width="40" Height="40" Fill="#0B3D91" Opacity="0.1"/>

                </StackPanel>

                

                <!-- Nguyên tố 3 -->

                <StackPanel Grid.Column="4" Visibility="{Binding CompareMode, Converter={StaticResource CompareModeToVisibilityConverter}}">

                    <TextBlock Text="🔽 Chọn nguyên tố 3" 

                               Style="{StaticResource HeaderText}"

                               Margin="0,0,0,12"/>

                    <ComboBox ItemsSource="{Binding AllElements}"

                              SelectedItem="{Binding Element3}"

                              DisplayMemberPath="DisplayName"

                              Style="{StaticResource ModernComboBox}"

                              Height="40"/>

                    

                    <!-- Card thông tin nguyên tố 3 -->

                    <Border CornerRadius="6" 

                            Padding="15" 

                            Margin="0,15,0,0">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Background" Value="{Binding Element3.Color, Converter={StaticResource ColorToBrushConverter}}"/>

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Element3}" Value="{x:Null}">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <Border.Effect>

                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="1"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center">

                                <Run Text="{Binding Element3.Symbol, Mode=OneWay}"/>

                            </TextBlock>

                            <TextBlock Text="{Binding Element3.Name}" 

                                       FontSize="14" 

                                       FontWeight="SemiBold"

                                       HorizontalAlignment="Center"

                                       Margin="0,5,0,0"/>

                            <TextBlock HorizontalAlignment="Center" 

                                       FontSize="12" 

                                       Margin="0,8,0,0"

                                       Opacity="0.8">

                                <Run Text="Z = "/><Run Text="{Binding Element3.AtomicNumber, Mode=OneWay}"/>

                                <Run Text=" | "/><Run Text="{Binding Element3.AtomicMass, StringFormat=F3, Mode=OneWay}"/>

                            </TextBlock>

                            <TextBlock Text="{Binding Element3.Category}" 

                                       FontSize="11" 

                                       HorizontalAlignment="Center"

                                       Margin="0,5,0,0"

                                       FontStyle="Italic"

                                       Opacity="0.7"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                </Grid>

            </Grid>

        </Border>

        

        <!-- Tab + Bảng so sánh với thiết kế hiện đại -->

        <Border Grid.Row="2" Background="White" 

                Margin="20,20,20,0" 

                CornerRadius="8">

            <Border.Effect>

                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="2"/>

            </Border.Effect>

            

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                

                <!-- Tab Navigation với màu sắc nổi bật -->

                <Border Grid.Row="0" 

                        Background="#F0F0F0" 

                        Padding="20,15"

                        CornerRadius="8,8,0,0">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- Tab Tính chất chung - Màu xanh -->

                        <RadioButton Content="🔷 Tính chất chung" 

                                     IsChecked="True"

                                     GroupName="TabGroup"

                                     Tag="General"

                                     Checked="Tab_Checked"

                                     Style="{StaticResource {x:Type RadioButton}}"

                                     Margin="0,0,12,0">

                            <RadioButton.Template>

                                <ControlTemplate TargetType="RadioButton">

                                    <Border x:Name="Border" 

                                            Background="#E3F2FD" 

                                            Padding="18,10"

                                            CornerRadius="6"

                                            BorderThickness="2"

                                            BorderBrush="Transparent">

                                        <Border.Effect>

                                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="5" ShadowDepth="1"/>

                                        </Border.Effect>

                                        <TextBlock Text="{TemplateBinding Content}" 

                                                   FontSize="14"

                                                   FontWeight="SemiBold"

                                                   Foreground="#1976D2"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsChecked" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>

                                            <Setter TargetName="Border" Property="BorderBrush" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="BorderThickness" Value="3"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="TextBlock.FontWeight" Value="Bold"/>

                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#BBDEFB"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#1976D2"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </RadioButton.Template>

                        </RadioButton>

                        

                        <!-- Tab Tính chất vật lý - Màu cam -->

                        <RadioButton Content="🔶 Tính chất vật lý" 

                                     GroupName="TabGroup"

                                     Tag="Physical"

                                     Checked="Tab_Checked"

                                     Style="{StaticResource {x:Type RadioButton}}"

                                     Margin="0,0,12,0">

                            <RadioButton.Template>

                                <ControlTemplate TargetType="RadioButton">

                                    <Border x:Name="Border" 

                                            Background="#FFF3E0" 

                                            Padding="18,10"

                                            CornerRadius="6"

                                            BorderThickness="2"

                                            BorderBrush="Transparent">

                                        <Border.Effect>

                                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="5" ShadowDepth="1"/>

                                        </Border.Effect>

                                        <TextBlock Text="{TemplateBinding Content}" 

                                                   FontSize="14"

                                                   FontWeight="SemiBold"

                                                   Foreground="#F57C00"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsChecked" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#FFF3E0"/>

                                            <Setter TargetName="Border" Property="BorderBrush" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="BorderThickness" Value="3"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="TextBlock.FontWeight" Value="Bold"/>

                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#FFE0B2"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#F57C00"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </RadioButton.Template>

                        </RadioButton>

                        

                        <!-- Tab Tính chất hóa học - Màu xanh lá -->

                        <RadioButton Content="🔬 Tính chất hóa học" 

                                     GroupName="TabGroup"

                                     Tag="Chemical"

                                     Checked="Tab_Checked"

                                     Style="{StaticResource {x:Type RadioButton}}"

                                     Margin="0,0,12,0">

                            <RadioButton.Template>

                                <ControlTemplate TargetType="RadioButton">

                                    <Border x:Name="Border" 

                                            Background="#E8F5E9" 

                                            Padding="18,10"

                                            CornerRadius="6"

                                            BorderThickness="2"

                                            BorderBrush="Transparent">

                                        <Border.Effect>

                                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="5" ShadowDepth="1"/>

                                        </Border.Effect>

                                        <TextBlock Text="{TemplateBinding Content}" 

                                                   FontSize="14"

                                                   FontWeight="SemiBold"

                                                   Foreground="#388E3C"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsChecked" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#E8F5E9"/>

                                            <Setter TargetName="Border" Property="BorderBrush" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="BorderThickness" Value="3"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="TextBlock.FontWeight" Value="Bold"/>

                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#C8E6C9"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#388E3C"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </RadioButton.Template>

                        </RadioButton>

                        

                        <!-- Tab Tính chất nguyên tử - Màu tím -->

                        <RadioButton Content="⚛ Tính chất nguyên tử" 

                                     GroupName="TabGroup"

                                     Tag="Atomic"

                                     Checked="Tab_Checked"

                                     Style="{StaticResource {x:Type RadioButton}}">

                            <RadioButton.Template>

                                <ControlTemplate TargetType="RadioButton">

                                    <Border x:Name="Border" 

                                            Background="#F3E5F5" 

                                            Padding="18,10"

                                            CornerRadius="6"

                                            BorderThickness="2"

                                            BorderBrush="Transparent">

                                        <Border.Effect>

                                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="5" ShadowDepth="1"/>

                                        </Border.Effect>

                                        <TextBlock Text="{TemplateBinding Content}" 

                                                   FontSize="14"

                                                   FontWeight="SemiBold"

                                                   Foreground="#7B1FA2"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsChecked" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#F3E5F5"/>

                                            <Setter TargetName="Border" Property="BorderBrush" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="BorderThickness" Value="3"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#FF6B00"/>

                                            <Setter TargetName="Border" Property="TextBlock.FontWeight" Value="Bold"/>

                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter TargetName="Border" Property="Background" Value="#E1BEE7"/>

                                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="#7B1FA2"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </RadioButton.Template>

                        </RadioButton>

                    </StackPanel>

                </Border>

                

                <!-- Bảng so sánh -->

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        

                        <!-- Header bảng -->

                        <Border Grid.Row="0" Background="#0B3D91">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="280"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                

                                <Border Grid.Column="0" Padding="15,14">

                                    <TextBlock Text="Thuộc tính" 

                                               FontWeight="Bold" 

                                               Foreground="White" 

                                               FontSize="14"

                                               VerticalAlignment="Center"/>

                                </Border>

                                

                                <Border Grid.Column="1" BorderBrush="White" BorderThickness="1,0,0,0" Padding="15,14">

                                    <TextBlock Text="{Binding Element1.NameVietnamese}" 

                                               FontWeight="Bold" 

                                               Foreground="White" 

                                               FontSize="14"

                                               VerticalAlignment="Center"

                                               HorizontalAlignment="Center"

                                               TextWrapping="NoWrap"/>

                                </Border>

                                

                                <Border Grid.Column="2" BorderBrush="White" BorderThickness="1,0,0,0" Padding="15,14">

                                    <TextBlock Text="{Binding Element2.NameVietnamese}" 

                                               FontWeight="Bold" 

                                               Foreground="White" 

                                               FontSize="14"

                                               VerticalAlignment="Center"

                                               HorizontalAlignment="Center"

                                               TextWrapping="NoWrap"/>

                                </Border>

                                

                                <Border Grid.Column="3" BorderBrush="White" BorderThickness="1,0,0,0" Padding="15,14"

                                        Visibility="{Binding CompareMode, Converter={StaticResource CompareModeToVisibilityConverter}}">

                                    <TextBlock Text="{Binding Element3.NameVietnamese}" 

                                               FontWeight="Bold" 

                                               Foreground="White" 

                                               FontSize="14"

                                               VerticalAlignment="Center"

                                               HorizontalAlignment="Center"

                                               TextWrapping="NoWrap"/>

                                </Border>

                            </Grid>

                        </Border>

                        

                        <!-- Dữ liệu so sánh với hover effect -->

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ComparisonData}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border x:Name="RowBorder" 

                                            Background="White"

                                            BorderBrush="#E0E0E0" 

                                            BorderThickness="0,0,0,1">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="280"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            

                                            <Border Grid.Column="0" Background="#F8FAFF" Padding="15,12">

                                                <TextBlock Text="{Binding Property}" 

                                                           FontWeight="SemiBold"

                                                           FontSize="13"

                                                           Foreground="#1C1C1C"

                                                           VerticalAlignment="Center"

                                                           TextWrapping="NoWrap"

                                                           TextTrimming="CharacterEllipsis"/>

                                            </Border>

                                            

                                            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="15,12">

                                                <TextBlock Text="{Binding Value1}" 

                                                           FontSize="13"

                                                           Foreground="#1C1C1C"

                                                           VerticalAlignment="Center"

                                                           HorizontalAlignment="Center"

                                                           TextWrapping="NoWrap"

                                                           TextTrimming="CharacterEllipsis"/>

                                            </Border>

                                            

                                            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="15,12">

                                                <TextBlock Text="{Binding Value2}" 

                                                           FontSize="13"

                                                           Foreground="#1C1C1C"

                                                           VerticalAlignment="Center"

                                                           HorizontalAlignment="Center"

                                                           TextWrapping="NoWrap"

                                                           TextTrimming="CharacterEllipsis"/>

                                            </Border>

                                            

                                            <Border Grid.Column="3" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="15,12"

                                                    Visibility="{Binding DataContext.CompareMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CompareModeToVisibilityConverter}}">

                                                <TextBlock Text="{Binding Value3}" 

                                                           FontSize="13"

                                                           Foreground="#1C1C1C"

                                                           VerticalAlignment="Center"

                                                           HorizontalAlignment="Center"

                                                           TextWrapping="NoWrap"

                                                           TextTrimming="CharacterEllipsis"/>

                                            </Border>

                                        </Grid>

                                    </Border>

                                    <DataTemplate.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter TargetName="RowBorder" Property="Background" Value="#E8F0FE"/>

                                        </Trigger>

                                    </DataTemplate.Triggers>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </ScrollViewer>

            </Grid>

        </Border>

        

        <!-- Nút hành động với thiết kế hiện đại -->

        <Border Grid.Row="3" 

                Background="White" 

                Padding="20,15" 

                Margin="20,20,20,20"

                CornerRadius="8">

            <Border.Effect>

                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="2"/>

            </Border.Effect>

            

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <!-- Nút In PDF -->

                <Button Content="📄 Xuất PDF" 

                        Width="130" 

                        Height="40"

                        Margin="0,0,15,0"

                        Background="#009688"

                        Foreground="White"

                        FontSize="13"

                        FontWeight="SemiBold"

                        Cursor="Hand"

                        Command="{Binding ExportPdfCommand}"

                        ToolTip="Xuất kết quả so sánh ra file PDF">

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="border"

                                                Background="{TemplateBinding Background}" 

                                                CornerRadius="6"

                                                BorderThickness="0">

                                            <Border.Effect>

                                                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="2"/>

                                            </Border.Effect>

                                            <ContentPresenter HorizontalAlignment="Center" 

                                                              VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="border" Property="Background" Value="#00796B"/>

                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">

                                                <Setter TargetName="border" Property="Background" Value="#00695C"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </Button.Style>

                </Button>

                

                <!-- Nút Đóng -->

                <Button Content="✕ Đóng" 

                        Command="{Binding CloseCommand}"

                        Width="110" 

                        Height="40"

                        Background="#F44336"

                        Foreground="White"

                        FontSize="13"

                        FontWeight="SemiBold"

                        Cursor="Hand">

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="border"

                                                Background="{TemplateBinding Background}" 

                                                CornerRadius="6"

                                                BorderThickness="0">

                                            <Border.Effect>

                                                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="2"/>

                                            </Border.Effect>

                                            <ContentPresenter HorizontalAlignment="Center" 

                                                              VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="border" Property="Background" Value="#E53935"/>

                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">

                                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </Button.Style>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>





