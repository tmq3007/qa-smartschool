<Window FontFamily="Segoe UI" x:Class="QASmartTouch.PeriodicTable.Views.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:local="clr-namespace:QASmartTouch.PeriodicTable.Views"

        xmlns:vm="clr-namespace:QASmartTouch.PeriodicTable.ViewModels"

        xmlns:conv="clr-namespace:QASmartTouch.PeriodicTable.Converters"

        mc:Ignorable="d"

        Title="Bảng Tuần Hoàn Các Nguyên Tố Hóa Học" 

        Height="800" Width="1400"

        WindowState="Maximized"

        Background="#F5F5F5">



    <Window.DataContext>

        <vm:MainViewModel/>

    </Window.DataContext>



    <Window.Resources>

        <conv:PositionConverter x:Key="PositionConverter"/>

        <conv:RowPositionConverter x:Key="RowPositionConverter"/>

        <conv:ColumnPositionConverter x:Key="ColumnPositionConverter"/>

        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        <conv:HighlightConverter x:Key="HighlightConverter"/>

        <conv:ElementOpacityConverter x:Key="ElementOpacityConverter"/>

        <conv:ElementDetailVisibilityConverter x:Key="ElementDetailVisibilityConverter"/>

        <conv:CategoryButtonOpacityConverter x:Key="CategoryButtonOpacityConverter"/>

        <conv:EqualityConverter x:Key="EqualityConverter"/>

        <conv:ValueWithUnitConverter x:Key="ValueWithUnitConverter"/>



        <!-- Element Button Style -->

        <Style x:Key="ElementButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="65"/>

            <Setter Property="Height" Value="65"/>

            <Setter Property="Margin" Value="1"/>

            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BorderElement" 

                                Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"

                                BorderThickness="0"

                                CornerRadius="3">

                            <Border.Opacity>

                                <Binding Path="OpacityValue"/>

                            </Border.Opacity>

                            <Border x:Name="HighlightBorder"

                                    Background="{Binding IsHighlighted, Converter={StaticResource HighlightConverter}}"

                                    CornerRadius="3"

                                    Opacity="0.5">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="*"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>



                                    <!-- Số hiệu nguyên tử -->

                                    <TextBlock Grid.Row="0" 

                                               FontSize="11" 

                                               FontWeight="Bold"

                                               HorizontalAlignment="Left" 

                                               VerticalAlignment="Top"

                                               Margin="3,2,0,0"

                                               Foreground="Black">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text" Value="{Binding AtomicNumber}"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding AtomicNumber}" Value="0">

                                                        <Setter Property="Text" Value=""/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>



                                    <!-- Ký hiệu nguyên tố -->

                                    <TextBlock Grid.Row="1" 

                                               Text="{Binding Symbol}" 

                                               FontSize="20" 

                                               FontWeight="Bold"

                                               HorizontalAlignment="Center" 

                                               VerticalAlignment="Center"

                                               Foreground="Black"/>



                                    <!-- Khối lượng nguyên tử (tùy chọn) -->

                                    <TextBlock Grid.Row="2" 

                                               Text="{Binding AtomicMass, StringFormat=F3}" 

                                               FontSize="9.5" 

                                               FontWeight="Bold"

                                               HorizontalAlignment="Center" 

                                               VerticalAlignment="Bottom"

                                               Margin="0,0,0,2"

                                               Foreground="Black"

                                               Opacity="0.7"/>

                                </Grid>

                            </Border>

                        </Border>



                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="BorderElement" Property="BorderThickness" Value="2"/>

                                <Setter TargetName="BorderElement" Property="BorderBrush" Value="#FF6B6B"/>

                                <Setter Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect ShadowDepth="3" BlurRadius="8" Color="Black" Opacity="0.3"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>



                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="BorderElement" Property="RenderTransform">

                                    <Setter.Value>

                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- Header với tiêu đề và thanh tìm kiếm -->

        <Border Grid.Row="0" Background="#2196F3" Padding="8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <TextBlock Grid.Column="0" 

                           Text="BẢNG TUẦN HOÀN" 

                           FontSize="24" 

                           FontWeight="Bold" 

                           Foreground="White"

                           VerticalAlignment="Center"/>



                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Nút Biểu đồ hòa tan -->

                    <!-- Nút Giới thiệu -->

                    <Button Command="{Binding OpenIntroductionCommand}"

                            Background="#1976D2"

                            Foreground="White"

                            FontWeight="Bold"

                            Height="32"

                            Width="113"

                            Cursor="Hand">

                        <Button.Style>

                            <Style TargetType="{x:Type Button}">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="5"

                                                    BorderThickness="0">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#1565C0"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📚" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Giới thiệu" FontSize="12" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Command="{Binding OpenCompareCommand}"

                            Background="#388E3C"

                            Foreground="White"

                            FontWeight="Bold"

                            Height="32"

                            Width="167"

                            Cursor="Hand">

                        <Button.Style>

                            <Style TargetType="{x:Type Button}">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="5"

                                                    BorderThickness="0">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#2E7D32"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⚖️" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>

                            <TextBlock Text="So sánh Nguyên tố" FontSize="12" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- Nút Biểu đồ hòa tan -->

                    <Button Command="{Binding OpenSolubilityCommand}"

                            Background="#1976D2"

                            Foreground="White"

                            FontWeight="Bold"

                            Height="32"

                            Width="167"

                            Margin="0,0,8,0"

                            Cursor="Hand">

                        <Button.Style>

                            <Style TargetType="{x:Type Button}">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="5"

                                                    BorderThickness="0">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#1565C0"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📊" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Bảng tính tan" FontSize="12" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Command="{Binding OpenReactivityCommand}"

                            Background="#FF6B00"

                            Foreground="White"

                            FontWeight="Bold"

                            Height="32"

                            Width="145"

                            Cursor="Hand">

                        <Button.Style>

                            <Style TargetType="{x:Type Button}">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                            <Border Background="{TemplateBinding Background}" 

                                                    CornerRadius="5"

                                                    BorderThickness="0">

                                                <ContentPresenter HorizontalAlignment="Center" 

                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#F57C00"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🧪" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>

                             <TextBlock Text="Dãy hoạt động" FontSize="12" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- Nút So sánh Nguyên tố -->



                    <!-- Nút Chuỗi phản ứng -->



                    <!-- Tìm kiếm -->

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="🔍" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="Yellow"/>

                        <TextBlock Text="Tìm kiếm:" Foreground="Yellow" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"/>

                        <TextBox x:Name="SearchBox" 

                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"

                                 Width="180" 

                                 Height="28"

                                 VerticalContentAlignment="Center"

                                 Padding="5,0"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>



        <!-- Main Content với bảng tuần hoàn -->

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="2">

            <Grid Name="PeriodicTableGrid" Background="White">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Headers -->

                <Grid Grid.Row="0" Margin="0,0,0,5">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="75"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Header "Nhóm →" và "Chu kỳ" -->

                    <StackPanel Grid.Row="0" Grid.Column="0">

                        <TextBlock Text="Nhóm →" FontWeight="Bold" FontSize="12"/>

                        <TextBlock Text="↓ Chu kỳ" FontWeight="Bold" FontSize="12"/>

                    </StackPanel>



                    <!-- Header với số nhóm 1-18 (clickable) -->

                    <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Groups}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <StackPanel Orientation="Horizontal"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Button Content="{Binding}" 

                                            Width="67" 

                                            Height="25"

                                            FontWeight="Bold" 

                                            FontSize="12"

                                            Command="{Binding DataContext.GroupSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}"

                                            Cursor="Hand">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="BorderThickness" Value="0"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}" 

                                                                    BorderBrush="{TemplateBinding BorderBrush}" 

                                                                    BorderThickness="{TemplateBinding BorderThickness}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="#E0E0E0"/>

                                                </Trigger>

                                                <DataTrigger Value="True">

                                                    <DataTrigger.Binding>

                                                        <MultiBinding Converter="{StaticResource EqualityConverter}">

                                                            <Binding Path="."/>

                                                            <Binding Path="DataContext.SelectedGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>

                                                        </MultiBinding>

                                                    </DataTrigger.Binding>

                                                    <Setter Property="Background" Value="#FFD700"/>

                                                    <Setter Property="FontWeight" Value="Bold"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                </Button>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>



                <!-- Main periodic table (rows 1-7) -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="75"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Chu kỳ labels bên trái (clickable) -->

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Periods}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <StackPanel/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Button Content="{Binding}" 

                                            Height="67" 

                                            Width="67"

                                            FontWeight="Bold" 

                                            FontSize="12"

                                            Command="{Binding DataContext.PeriodSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}"

                                            Cursor="Hand">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="BorderThickness" Value="0"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}" 

                                                                    BorderBrush="{TemplateBinding BorderBrush}" 

                                                                    BorderThickness="{TemplateBinding BorderThickness}">

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter Property="Background" Value="#E0E0E0"/>

                                                </Trigger>

                                                <DataTrigger Value="True">

                                                    <DataTrigger.Binding>

                                                        <MultiBinding Converter="{StaticResource EqualityConverter}">

                                                            <Binding Path="."/>

                                                            <Binding Path="DataContext.SelectedPeriod" RelativeSource="{RelativeSource AncestorType=Window}"/>

                                                        </MultiBinding>

                                                    </DataTrigger.Binding>

                                                    <Setter Property="Background" Value="#FFD700"/>

                                                    <Setter Property="FontWeight" Value="Bold"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                </Button>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <!-- Main elements (rows 1-7) với thông tin chi tiết nguyên tố -->

                    <Canvas Grid.Column="1" Width="1206" Height="469" 

                                Background="Transparent" 

                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown">

                        <!-- Các nguyên tố -->

                        <ItemsControl ItemsSource="{Binding MainElements}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <Canvas Width="1206" Height="469"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>



                            <ItemsControl.ItemContainerStyle>

                                <Style>

                                    <Setter Property="Canvas.Left" Value="{Binding Column, Converter={StaticResource ColumnPositionConverter}}"/>

                                    <Setter Property="Canvas.Top" Value="{Binding Row, Converter={StaticResource RowPositionConverter}}"/>

                                </Style>

                            </ItemsControl.ItemContainerStyle>



                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Style="{StaticResource ElementButtonStyle}"

                                                Command="{Binding DataContext.ElementSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                                CommandParameter="{Binding}"

                                                MouseDoubleClick="ElementButton_MouseDoubleClick"

                                                ToolTip="{Binding DisplayInfo}"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>



                        <!-- Chi tiết nguyên tố ở vị trí trung tâm (hàng 1-3) -->

                        <Border Canvas.Left="134" Canvas.Top="0" 

                                    Width="670" Height="201"

                                    Background="White" BorderThickness="0" 

                                    CornerRadius="8" Padding="15">

                            <Border.Visibility>

                                <MultiBinding Converter="{StaticResource ElementDetailVisibilityConverter}">

                                    <Binding Path="SelectedElement"/>

                                    <Binding Path="SelectedCategory"/>

                                </MultiBinding>

                            </Border.Visibility>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="130"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <!-- Ô nguyên tố lớn -->

                                <Border Grid.Column="0" 

                                            Background="{Binding SelectedElement.Color, Converter={StaticResource ColorToBrushConverter}}" 

                                            BorderThickness="0" 

                                            CornerRadius="5" Padding="5" Margin="0,0,15,0">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="*"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>



                                        <TextBlock Grid.Row="0" Text="{Binding SelectedElement.AtomicNumber}" 

                                                       FontSize="16" FontWeight="Bold" 

                                                       HorizontalAlignment="Left"/>



                                        <TextBlock Grid.Row="1" Text="{Binding SelectedElement.Symbol}" 

                                                       FontSize="48" FontWeight="Bold" 

                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                        <TextBlock Grid.Row="2" Text="{Binding SelectedElement.AtomicMass, StringFormat={}{0:F3}}" 

                                                       FontSize="14" 

                                                       HorizontalAlignment="Center"/>

                                    </Grid>

                                </Border>



                                <!-- Thông tin chi tiết -->

                                <Grid Grid.Column="1" VerticalAlignment="Center">

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>

                                    

                                    <!-- Header: Tên nguyên tố + Nút chi tiết -->

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        

                                        <!-- Tên nguyên tố -->

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="{Binding SelectedElement.Name}" 

                                                       FontSize="24" FontWeight="Bold" 

                                                       Margin="0,0,0,2"/>

                                            <TextBlock Text="{Binding SelectedElement.NameEn}" 

                                                       FontSize="15" FontStyle="Italic" 

                                                       Foreground="#999999" 

                                                       Margin="0,0,0,0"/>

                                        </StackPanel>

                                        

                                        <!-- Nút Chi tiết nguyên tố -->

                                        <Button Grid.Column="1"

                                                Content="📖 Chi tiết nguyên tố" 

                                                Click="DetailButton_Click"

                                                Background="#4F46E5" 

                                                Foreground="White"

                                                FontWeight="SemiBold"

                                                FontSize="10"

                                                Padding="10,6"

                                                Margin="10,0,0,0"

                                                BorderThickness="0"

                                                Cursor="Hand"

                                                VerticalAlignment="Top">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Setter Property="Background" Value="#4F46E5"/>

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="Button">

                                                                <Border Background="{TemplateBinding Background}" 

                                                                        CornerRadius="5"

                                                                        Padding="{TemplateBinding Padding}">

                                                                    <ContentPresenter HorizontalAlignment="Center" 

                                                                                      VerticalAlignment="Center"/>

                                                                </Border>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>

                                                    <Style.Triggers>

                                                        <Trigger Property="IsMouseOver" Value="True">

                                                            <Setter Property="Background" Value="#4338CA"/>

                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">

                                                            <Setter Property="Background" Value="#3730A3"/>

                                                        </Trigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                    </Grid>



                                    <!-- Thông tin cơ bản -->

                                    <Grid Grid.Row="1" Margin="0,8,0,0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>



                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Chu kỳ:" FontWeight="SemiBold" Margin="0,1,10,1"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedElement.Period}" Margin="0,1"/>



                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Nhóm:" FontWeight="SemiBold" Margin="0,1,10,1"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedElement.Group}" Margin="0,1"/>



                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Phân loại:" FontWeight="SemiBold" Margin="0,1,10,1"/>

                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedElement.Category}" Margin="0,1" TextWrapping="Wrap"/>



                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Nhiệt độ nóng chảy:" FontWeight="SemiBold" Margin="0,1,10,1"/>

                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,1">

                                            <Run Text="{Binding SelectedElement.MeltingPoint, StringFormat={}{0:F1}, TargetNullValue=Chưa xác định}"/>

                                            <Run Text=" "/>

                                            <Run Text="{Binding SelectedElement.MeltingPointUnit}"/>

                                        </TextBlock>



                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Nhiệt độ sôi:" FontWeight="SemiBold" Margin="0,1,10,1"/>

                                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,1">

                                            <Run Text="{Binding SelectedElement.BoilingPoint, StringFormat={}{0:F1}, TargetNullValue=Chưa xác định}"/>

                                            <Run Text=" "/>

                                            <Run Text="{Binding SelectedElement.BoilingPointUnit}"/>

                                        </TextBlock>



                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Mật độ:" FontWeight="SemiBold" Margin="0,1,10,1"/>

                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,1">

                                            <Run Text="{Binding SelectedElement.Density, StringFormat={}{0:F2}, TargetNullValue=Chưa xác định}"/>

                                            <Run Text=" "/>

                                            <Run Text="{Binding SelectedElement.DensityUnit}"/>

                                        </TextBlock>



                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Cấu hình electron:" FontWeight="SemiBold" Margin="0,1,10,1"/>

                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedElement.ElectronConfig, TargetNullValue=Chưa xác định}" Margin="0,1" FontFamily="Cambria Math, Segoe UI" FontSize="11"/>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                    </Canvas>

                </Grid>



                <!-- Lanthanides and Actinides Section -->

                <Grid Grid.Row="2" Margin="0,10,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="75"/>

                        <ColumnDefinition Width="200"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Lanthanides -->

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="*" FontWeight="Bold" FontSize="14" 

                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Nhóm Lantan" FontSize="10" 

                                   VerticalAlignment="Center"/>



                    <ItemsControl Grid.Row="0" Grid.Column="2" ItemsSource="{Binding LanthanideElements}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <StackPanel Orientation="Horizontal"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>



                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Button Style="{StaticResource ElementButtonStyle}"

                                            Command="{Binding DataContext.ElementSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}"

                                            MouseDoubleClick="ElementButton_MouseDoubleClick"

                                            ToolTip="{Binding DisplayInfo}"/>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <!-- Actinides -->

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="**" FontWeight="Bold" FontSize="14" 

                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Nhóm Actini" FontSize="10" 

                                   VerticalAlignment="Center"/>



                    <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding ActinideElements}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <StackPanel Orientation="Horizontal"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>



                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Button Style="{StaticResource ElementButtonStyle}"

                                            Command="{Binding DataContext.ElementSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}"

                                            MouseDoubleClick="ElementButton_MouseDoubleClick"

                                            ToolTip="{Binding DisplayInfo}"/>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>



                <!-- Legend -->

                <ItemsControl Grid.Row="3" ItemsSource="{Binding Categories}" 

                                  HorizontalAlignment="Center" Margin="0,8,0,0">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="{Binding ColorBrush}" BorderThickness="0" 

                                        Margin="1" Width="120" Height="28" CornerRadius="2">

                                <Border.Opacity>

                                    <MultiBinding Converter="{StaticResource CategoryButtonOpacityConverter}">

                                        <Binding Path="Name"/>

                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>

                                    </MultiBinding>

                                </Border.Opacity>

                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"

                                            Command="{Binding DataContext.CategorySelectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 

                                            CommandParameter="{Binding Name}">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="2">

                                                            <TextBlock Text="{Binding Name}" 

                                                                           HorizontalAlignment="Center" 

                                                                           VerticalAlignment="Center" 

                                                                           FontSize="11.5" 

                                                                           FontWeight="Bold" 

                                                                           Foreground="Black"/>

                                                        </Border>

                                                        <!-- Không có triggers để giữ nguyên màu nền -->

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </Button.Style>

                                </Button>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Grid>

        </Viewbox>



        <!-- Footer -->

        <Border Grid.Row="2" Background="#37474F" Padding="5">

            <TextBlock Text="Bảng tuần hoàn các nguyên tố hóa học - Phiên bản giáo dục" 

                       Foreground="White" 

                       HorizontalAlignment="Center"/>

        </Border>

    </Grid>

</Window>



