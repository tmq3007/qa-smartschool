<Window TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.CanteenReceiptWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Biên Lai Thanh Toán Canteen" Height="460" Width="320" 

        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"

        Background="#F1F5F9" FontFamily="Consolas, Cascadia Code, Courier New">

    <Grid Margin="15">

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="15" CornerRadius="4">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <TextBlock x:Name="ReceiptTxt" TextWrapping="Wrap" FontSize="11" Foreground="Black" LineHeight="16"/>

            </ScrollViewer>

        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">

            <Button Content="🖨️ In Hóa Đơn" Width="100" Height="32" Click="Print_Click" Margin="0,0,10,0" Background="#EA580C" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

            <Button Content="Đóng" Width="80" Height="32" Click="Close_Click" Background="#E2E8F0" Foreground="#334155" BorderThickness="0"/>

        </StackPanel>

    </Grid>

</Window>

