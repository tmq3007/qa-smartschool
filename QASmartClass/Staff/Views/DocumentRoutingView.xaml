<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.DocumentRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QASmartClass.Staff.ViewModels"
             Background="{StaticResource AppBackground}"
             FontFamily="Inter, Segoe UI, Arial, sans-serif">

    <UserControl.DataContext>
        <vm:DocumentRoutingViewModel/>
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#60A5FA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Luân chuyển eOffice" Style="{StaticResource StaffPageTitle}" FontFamily="Outfit, Segoe UI, Arial, sans-serif"/>
                <TextBlock Text="Gửi, phê duyệt và chuyển tiếp công văn nội bộ." Style="{StaticResource StaffPageSubtitle}" Margin="0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StaffFormCard}" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Gửi/Chuyển Tiếp Công Văn" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20" FontFamily="Outfit, Segoe UI, Arial, sans-serif"/>

                    <TextBlock Text="Tên công văn/Tờ trình:" Style="{StaticResource StaffFormLabel}"/>
                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding DocTitle, UpdateSourceTrigger=PropertyChanged}" Height="40" VerticalContentAlignment="Center" Style="{StaticResource StaffTextBox}"/>

                    <TextBlock Text="Người nhận/Phê duyệt:" Style="{StaticResource StaffFormLabel}"/>
                    <ComboBox SelectedItem="{Binding Receiver}" ItemsSource="{Binding StaffList}" Height="40" VerticalContentAlignment="Center" Style="{StaticResource StaffComboBox}"/>

                    <TextBlock Text="Nội dung trình/Ghi chú:" Style="{StaticResource StaffFormLabel}"/>
                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="6"/>

                    <TextBlock Text="Số cấp phê duyệt quy trình:" Style="{StaticResource StaffFormLabel}"/>
                    <ComboBox SelectedIndex="{Binding SelectedMaxLevelOffset}" Height="40" VerticalContentAlignment="Center" Style="{StaticResource StaffComboBox}" Margin="0,0,0,15">
                        <ComboBoxItem Content="1 Cấp duyệt (Mặc định)"/>
                        <ComboBoxItem Content="2 Cấp duyệt (Liên cấp)"/>
                        <ComboBoxItem Content="3 Cấp duyệt (Ban Giám Hiệu)"/>
                    </ComboBox>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🚀 Gửi đi" Style="{StaticResource StaffPrimaryBtn}" Command="{Binding SendDocCommand}" MinHeight="40" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="🔄 Nhập lại" Style="{StaticResource StaffOutlineBtn}" Command="{Binding ResetFormCommand}" MinHeight="40" VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- Hướng dẫn sử dụng từng bước -->
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,15,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💡 Hướng dẫn luân chuyển nhanh:" FontWeight="SemiBold" FontSize="13" Foreground="#374151" Margin="0,0,0,8"/>
                            <TextBlock Text="1. Điền Tên công văn/Tờ trình nội bộ cần duyệt." FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="2. Chọn phòng ban/cá nhân nhận công văn." FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="3. Chọn Số cấp phê duyệt (từ 1 đến 3 cấp)." FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="4. Bấm Gửi Đi để khởi chạy luồng phê duyệt eOffice." FontSize="11" Foreground="#4B5563" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StaffFormCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Hộp Thư Đến &amp; Luồng Công Văn" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15" FontFamily="Outfit, Segoe UI, Arial, sans-serif"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Tìm kiếm công văn:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBox SpellCheck.IsEnabled="False" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="40" VerticalContentAlignment="Center" Style="{StaticResource StaffTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Ý kiến / Ghi chú phản hồi khi phê duyệt:" Style="{StaticResource StaffFormLabel}" Margin="0,0,0,4"/>
                        <TextBox SpellCheck.IsEnabled="False" Text="{Binding ApproverComment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="40" VerticalContentAlignment="Center" Margin="0" ToolTip="Nhập ý kiến tại đây trước khi nhấn nút Duyệt / Từ chối / Chuyển tiếp."/>
                    </StackPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Documents}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="45">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Tên công văn" Binding="{Binding DocumentTitle}" Width="*"/>
                            <DataGridTextColumn Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn Header="Ngày gửi" Binding="{Binding SentAt, StringFormat='dd/MM HH:mm'}" Width="100"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding FriendlyStatus}" Width="90"/>
                            <DataGridTextColumn Header="Ý kiến / Nhật ký" Binding="{Binding Notes}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Hành động" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Forwarded">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Duyệt" Style="{StaticResource StaffIconBtn}" Background="#DCFCE7" Foreground="#16A34A" MinHeight="40" MinWidth="60" Padding="10,0" Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}" Margin="0,0,4,0"/>
                                            <Button Content="Từ chối" Style="{StaticResource StaffIconBtn}" Background="#FEE2E2" Foreground="#DC2626" MinHeight="40" MinWidth="60" Padding="10,0" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}" Margin="0,0,4,0"/>
                                            <Button Content="Chuyển" Style="{StaticResource StaffIconBtn}" Background="#FEF3C7" Foreground="#CA8A04" MinHeight="40" MinWidth="60" Padding="10,0" Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
