<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.CanteenPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource AppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EA580C" Offset="0"/><GradientStop Color="#FB923C" Offset="1"/></LinearGradientBrush></Border.Background>
                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ví Canteen — Máy POS" Style="{StaticResource StaffPageTitle}"/>
                    <Ellipse Width="12" Height="12" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Trạng thái kết nối phần cứng đầu đọc (Xanh: Đang kết nối, Đỏ: Lỗi)">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/> <!-- Mặc định Đỏ -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHardwareConnected}" Value="True">
                                        <Setter Property="Fill" Value="#10B981"/> <!-- Xanh lá -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
                <TextBlock Text="Quẹt thẻ, thanh toán suất ăn và theo dõi giao dịch." Style="{StaticResource StaffPageSubtitle}" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- POS Terminal -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                <Border Style="{StaticResource StaffFormCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Quẹt Thẻ / Nhập Mã HS" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBox SpellCheck.IsEnabled="False" x:Name="SearchTextBox" Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Margin="0"/>
                            <Button Grid.Column="1" Content="TÌM" Style="{StaticResource StaffPrimaryBtn}" Command="{Binding SearchStudentCommand}" Margin="10,0,0,0" Padding="10,10"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,15" TextWrapping="Wrap"/>
                        <!-- Student Info Card -->
                        <Border CornerRadius="12" Padding="18" Margin="0,0,0,15">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F8FAFC" Offset="0"/><GradientStop Color="#EFF6FF" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thông Tin Học Sinh" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding CurrentStudent.FullName, TargetNullValue='--'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding CurrentStudent.ClassName, StringFormat='Lớp: {0}', TargetNullValue='--'}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Số Dư Ví" Margin="0,15,0,3" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock Text="{Binding CurrentBalance, StringFormat='{}{0:N0} VNĐ'}" FontSize="32" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#059669"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowBalanceWarningVisible}" Value="True">
                                                        <Setter Property="Foreground" Value="#EA580C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border CornerRadius="6" Padding="8,4" Margin="0,10,0,0" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllergyWarning}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AllergyWarning}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AllergyWarning}" Foreground="#DC2626" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Width="70" Height="70" CornerRadius="35" BorderBrush="#DBEAFE" BorderThickness="2" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#EFF6FF">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Low Balance Warning Banner -->
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15"
                                Visibility="{Binding IsLowBalanceWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding LowBalanceWarningMessage}" Foreground="#EA580C" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="Chi Tiết Đơn Hàng" Style="{StaticResource StaffFormLabel}"/>
                        <TextBox x:Name="OrderDetailsTextBox" MaxLength="500" SpellCheck.IsEnabled="False" Text="{Binding OrderDetails, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}"/>
                        <TextBlock Text="Số Tiền Cần Trừ (VNĐ)" Style="{StaticResource StaffFormLabel}"/>
                        <TextBox x:Name="DeductionTextBox" PreviewTextInput="NumberOnly_PreviewTextInput" MaxLength="6" SpellCheck.IsEnabled="False" Text="{Binding DeductionAmountString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" FontSize="18" FontWeight="Bold"/>
                        <UniformGrid Columns="4" Margin="0,5,0,10" Height="42">
                            <Button Content="+10K" Command="{Binding AddAmountCommand}" CommandParameter="10000" Style="{StaticResource StaffOutlineBtn}" Margin="0,0,5,0"/>
                            <Button Content="+20K" Command="{Binding AddAmountCommand}" CommandParameter="20000" Style="{StaticResource StaffOutlineBtn}" Margin="0,0,5,0"/>
                            <Button Content="+50K" Command="{Binding AddAmountCommand}" CommandParameter="50000" Style="{StaticResource StaffOutlineBtn}" Margin="0,0,5,0"/>
                            <Button Content="Xóa" Command="{Binding ClearAmountCommand}" Style="{StaticResource StaffDangerBtn}"/>
                        </UniformGrid>
                        <Button Content="Thanh toán" Command="{Binding ProcessPaymentCommand}" FontSize="16" Padding="15,12">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StaffSuccessBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <WrapPanel Margin="0,10,0,10">
                            <CheckBox Content="Chế độ bán nhanh" IsChecked="{Binding IsQuickPayMode}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHardwareConnected}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,15,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Đầu đọc: Lỗi"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHardwareConnected}" Value="True">
                                                <Setter Property="Text" Value="Đầu đọc: Sẵn sàng"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Suất mặc định:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0"/>
                            <ComboBox x:Name="QuickPayComboBox" Text="{Binding QuickPayAmount, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="100" Height="28" Style="{StaticResource StaffComboBox}">
                                <sys:Decimal>20000</sys:Decimal>
                                <sys:Decimal>25000</sys:Decimal>
                                <sys:Decimal>30000</sys:Decimal>
                                <sys:Decimal>35000</sys:Decimal>
                                <sys:Decimal>40000</sys:Decimal>
                                <sys:Decimal>50000</sys:Decimal>
                            </ComboBox>
                        </WrapPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Tự động hiện hóa đơn" IsChecked="{Binding AutoPrintReceipt}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <Button Grid.Column="1" Content="In lại hóa đơn cuối" Style="{StaticResource StaffSecondaryBtn}" Height="30" Padding="10,0" Command="{Binding ReprintReceiptCommand}"/>
                        </Grid>
                        <!-- Step-by-step guidance card for Canteen POS -->
                        <Border CornerRadius="12" Padding="15" Margin="0,15,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Hướng dẫn sử dụng POS:" FontWeight="Bold" FontSize="13.5" Foreground="#1E40AF" Margin="0,0,0,8"/>
                                <TextBlock Text="1. Quẹt thẻ học sinh hoặc nhập mã vào ô tìm kiếm." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                <TextBlock Text="2. Đối chiếu thông tin, ảnh và cảnh báo dị ứng." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                <TextBlock Text="3. Nhập số tiền cần trừ (hoặc dùng nút cộng nhanh)." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                <TextBlock Text="4. Click 'Thanh toán' để thực hiện trừ tiền ví." FontSize="12" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                <TextBlock Text="5. Hệ thống sẽ tự động in biên lai nếu được bật." FontSize="12" Foreground="#1E3A8A"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <!-- Transaction History -->
            <Border Grid.Column="2" Style="{StaticResource StaffFormCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="10 Giao Dịch Gần Nhất" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding RecentTransactions}" Style="{StaticResource StaffListView}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Thời Gian" DisplayMemberBinding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="90"/>
                                <GridViewColumn Header="Mã HS" DisplayMemberBinding="{Binding StudentCode}" Width="80"/>
                                <GridViewColumn Header="Nội dung" DisplayMemberBinding="{Binding DisplayDetails}" Width="250"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>

        <!-- Overlay Grid mờ màu đỏ khi có cảnh báo dị ứng nặng -->
        <Grid x:Name="AllergyWarningOverlay" Panel.ZIndex="100" Background="#907F1D1D">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAllergyOverlayOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="White" CornerRadius="16" Padding="25" Width="520" BorderBrush="#EF4444" BorderThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3" Color="#EF4444"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⚠️ CẢNH BÁO DỊ ỨNG THỰC PHẨM NẶNG" FontWeight="Bold" FontSize="18" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="10" Padding="15" BorderBrush="#FEE2E2" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentStudent.FullName, StringFormat='Học sinh: {0}'}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AllergyWarning}" FontSize="14" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Kiểm tra kỹ khay ăn, đảm bảo không chứa chất gây dị ứng trước khi thanh toán!" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- Học liệu hình ảnh cỡ lớn chuẩn v4.1 -->
                        <Border Grid.Column="1" Height="120" CornerRadius="10" BorderBrush="#EF4444" BorderThickness="1.5" Background="#F1F5F9" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding StudentAvatarImageSource}" Stretch="UniformToFill"/>
                                <TextBlock Text="🏥" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EF4444" Visibility="{Binding HasNoAvatar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <CheckBox x:Name="chkAllergyConfirmed" Content="Tôi cam kết đã trực tiếp đối chiếu khay ăn và khuôn mặt học sinh" IsChecked="{Binding IsAllergyConfirmedByStaff, Mode=TwoWay}" Foreground="#475569" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Button Content="Tôi xác nhận đã kiểm tra khay ăn" Style="{StaticResource StaffSuccessBtn}" Command="{Binding ConfirmAllergyCommand}" IsEnabled="{Binding IsChecked, ElementName=chkAllergyConfirmed}" FontSize="14" Padding="20,10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
