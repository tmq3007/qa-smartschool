<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.LeaveRequestManagementView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:vm="clr-namespace:QASmartClass.Staff.ViewModels"

      Background="{StaticResource AppBackground}" >

    <UserControl.DataContext>

        <vm:LeaveRequestManagementViewModel/>

    </UserControl.DataContext>

    <Grid>

        <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">

            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">

                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="#A78BFA" Offset="1"/></LinearGradientBrush></Border.Background>

                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Quản lý Đơn Xin Nghỉ Phép" Style="{StaticResource StaffPageTitle}"/>

                <TextBlock Text="Duyệt đơn xin phép trực tuyến từ App Phụ huynh." Style="{StaticResource StaffPageSubtitle}" Margin="0"/>

            </StackPanel>

        </DockPanel>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">

                <DockPanel LastChildFill="False">

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                        <TextBlock Text="Lọc lớp học:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextPrimary}"/>

                        <ComboBox SelectedItem="{Binding SelectedClassFilter}" ItemsSource="{Binding ClassList}" Width="150" Height="32" Style="{StaticResource StaffComboBox}"/>

                    </StackPanel>

                </DockPanel>

            </Border>

            <Border Grid.Row="1" Style="{StaticResource StaffFormCard}">

                <DataGrid ItemsSource="{Binding Requests}" AutoGenerateColumns="False" CanUserAddRows="False"

                          IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"

                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="45">

                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/></DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/></DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Mã Đơn" Binding="{Binding Id}" Width="80"/>

                        <DataGridTextColumn Header="Học sinh" Binding="{Binding StudentName}" Width="150"/>

                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="80"/>

                        <DataGridTextColumn Header="Ngày nghỉ" Binding="{Binding LeaveDate, StringFormat='dddd, dd/MM/yyyy'}" Width="150"/>

                        <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*"/>

                        <DataGridTemplateColumn Header="Trạng thái" Width="100">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">

                                                        <Setter Property="Background" Value="#DCFCE7"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">

                                                        <Setter Property="Background" Value="#FFEDD5"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">

                                                        <Setter Property="Background" Value="#FEE2E2"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <TextBlock FontSize="12" FontWeight="SemiBold">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">

                                                            <Setter Property="Text" Value="Đã duyệt"/>

                                                            <Setter Property="Foreground" Value="#16A34A"/>

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">

                                                            <Setter Property="Text" Value="Chờ duyệt"/>

                                                            <Setter Property="Foreground" Value="#EA580C"/>

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">

                                                            <Setter Property="Text" Value="Từ chối"/>

                                                            <Setter Property="Foreground" Value="#DC2626"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Phê duyệt" Width="160">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <StackPanel.Style>

                                            <Style TargetType="StackPanel">

                                                <Setter Property="Visibility" Value="Visible"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">

                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">

                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </StackPanel.Style>

                                        <Button Content="Duyệt" Style="{StaticResource StaffIconBtn}" Background="#DCFCE7" Foreground="#16A34A" Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}" Margin="0,0,4,0"/>

                                        <Button Content="Từ chối" Style="{StaticResource StaffIconBtn}" Background="#FEE2E2" Foreground="#DC2626" Command="{Binding DataContext.PrepareRejectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

        

        <!-- Overlay Grid mờ che phủ toàn bộ -->

        <Grid x:Name="RejectDialogOverlay" Panel.ZIndex="100" Background="#80000000">

            <Grid.Style>

                <Style TargetType="Grid">

                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsRejectPopupOpen}" Value="True">

                            <Setter Property="Visibility" Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Grid.Style>

            <Border Background="White" CornerRadius="12" Padding="20" Width="380" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.25" Color="#000000"/>

                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="Lý do từ chối đơn nghỉ phép" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,10"/>

                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15" ToolTip="Nhập lý do từ chối chi tiết..."/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Hủy bỏ" Style="{StaticResource StaffOutlineBtn}" Command="{Binding CancelRejectCommand}" Padding="15,6" Margin="0,0,10,0"/>

                        <Button Content="Xác nhận Từ chối" Style="{StaticResource StaffDangerBtn}" Command="{Binding ConfirmRejectCommand}" Padding="15,6"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>



