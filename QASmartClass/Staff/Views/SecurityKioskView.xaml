<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.SecurityKioskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QASmartClass.Staff.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource AppBackground}"
             PreviewKeyDown="UserControl_PreviewKeyDown" >

    <UserControl.DataContext>

        <vm:SecurityKioskViewModel/>

    </UserControl.DataContext>

    <UserControl.Resources>

        <Style x:Key="BlinkingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource StaffTextBox}">
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <ColorAnimation Storyboard.TargetProperty="(TextBox.BorderBrush).(SolidColorBrush.Color)"
                                                 To="#3B82F6" Duration="0:0:1.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header with icon badge -->

        <DockPanel Grid.Row="0" Margin="0,0,0,8">

            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">

                <Border.Background>

                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                        <GradientStop Color="#1E3A8A" Offset="0"/>

                        <GradientStop Color="#3B82F6" Offset="1"/>

                    </LinearGradientBrush>

                </Border.Background>

                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Nhật ký An ninh &amp; Bảo vệ" Style="{StaticResource StaffPageTitle}"/>

                <TextBlock Text="Ghi nhận khách ra vào, sự cố an ninh và bàn giao chìa khóa/tài sản." Style="{StaticResource StaffPageSubtitle}" Margin="0"/>

            </StackPanel>

        </DockPanel>



        <!-- Main Content -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="350"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,20,0">

                <Border Style="{StaticResource StaffFormCard}" Margin="0">

                    <StackPanel>

                        <TextBlock Text="Thêm Nhật Ký Mới" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>

                    

                    <TextBlock Text="Quét nhanh QR CCCD tại đây:" Style="{StaticResource StaffFormLabel}"/>
                    <TextBox x:Name="TxtQrInput" TabIndex="1" SpellCheck.IsEnabled="False" Text="{Binding QrInputBuffer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BlinkingTextBoxStyle}" ToolTip="Để con trỏ chuột tại đây và quét/dán mã QR CCCD gắn chip"/>
                    
                    <!-- Nhãn tĩnh hướng dẫn khi mất focus -->
                    <TextBlock Text="⚠️ Vui lòng nhấp vào ô trên trước khi quét!" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=TxtQrInput, Path=IsFocused}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBlock Text="Loại sự kiện:" Style="{StaticResource StaffFormLabel}"/>
                    <ComboBox TabIndex="2" SelectedValue="{Binding SelectedEventType}" SelectedValuePath="Tag" Style="{StaticResource StaffComboBox}">
                        <ComboBoxItem Content="Khách vào cổng" Tag="CheckIn"/>
                        <ComboBoxItem Content="Khách ra cổng" Tag="CheckOut"/>
                        <ComboBoxItem Content="Bàn giao chìa khóa" Tag="KeyExchange"/>
                        <ComboBoxItem Content="Sự cố an ninh" Tag="Incident"/>
                        <ComboBoxItem Content="Khác" Tag="Other"/>
                    </ComboBox>

                    <!-- Khách ra cổng: Chọn khách từ danh sách hiện có trong trường -->
                    <TextBlock Text="Chọn khách cần Check-Out:">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StaffFormLabel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEventType}" Value="CheckOut">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox TabIndex="3" ItemsSource="{Binding ActiveVisitors}" SelectedItem="{Binding SelectedActiveVisitor}" ToolTip="Danh sách khách chưa ra cổng">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource StaffComboBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEventType}" Value="CheckOut">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding VisitorName}"/>
                                    <Run Text=" - Thẻ số: "/>
                                    <Run Text="{Binding BadgeNumber}"/>
                                    <Run Text=" (Vào lúc: "/>
                                    <Run Text="{Binding Timestamp, StringFormat='HH:mm'}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Sự kiện khác: Nhập tay người liên quan -->
                    <TextBlock Text="Người liên quan:">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StaffFormLabel}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEventType}" Value="CheckOut">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox TabIndex="4" SpellCheck.IsEnabled="False" Text="{Binding Person, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tên khách, GV, hoặc học sinh">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource StaffTextBox}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEventType}" Value="CheckOut">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Điền thông tin Check-In chi tiết -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEventType}" Value="CheckIn">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Số CCCD/Hộ chiếu (Nhập tay nếu không quét):" Style="{StaticResource StaffFormLabel}"/>
                        <TextBox TabIndex="5" SpellCheck.IsEnabled="False" Text="{Binding ManualCccd, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" ToolTip="Số CCCD gồm 12 số (hoặc số hộ chiếu)"/>

                        <TextBlock Text="Địa chỉ thường trú (Nhập tay nếu không quét):" Style="{StaticResource StaffFormLabel}"/>
                        <TextBox TabIndex="6" SpellCheck.IsEnabled="False" Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" ToolTip="Địa chỉ ghi trên CCCD hoặc nơi cư trú"/>

                        <TextBlock Text="Mục đích viếng thăm:" Style="{StaticResource StaffFormLabel}"/>
                        <ComboBox TabIndex="7" SelectedValue="{Binding VisitPurpose}" SelectedValuePath="Content" Style="{StaticResource StaffComboBox}">
                            <ComboBoxItem Content="Liên hệ công tác"/>
                            <ComboBoxItem Content="Gặp phụ huynh học sinh"/>
                            <ComboBoxItem Content="Bảo trì, sửa chữa thiết bị"/>
                            <ComboBoxItem Content="Khác"/>
                        </ComboBox>

                        <TextBlock Text="Cán bộ tiếp đón:" Style="{StaticResource StaffFormLabel}"/>
                        <ComboBox TabIndex="8" SelectedValue="{Binding SelectedHostTeacherId}" SelectedValuePath="TeacherCode" DisplayMemberPath="DisplayName" ItemsSource="{Binding Teachers}" Style="{StaticResource StaffComboBox}" ToolTip="Chọn cán bộ/giáo viên tiếp đón"/>

                        <TextBlock Text="Số thẻ khách cấp:" Style="{StaticResource StaffFormLabel}"/>
                        <TextBox TabIndex="9" SpellCheck.IsEnabled="False" Text="{Binding BadgeNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" ToolTip="Số thẻ nhựa cấp cho khách"/>

                        <!-- Nhãn thông tin mã hóa bảo mật PII -->
                        <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,15,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🔒 Thông tin cá nhân (CCCD, Địa chỉ) được tự động mã hóa bảo mật chuẩn AES-256" Foreground="#047857" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Chi tiết sự kiện:" Style="{StaticResource StaffFormLabel}"/>
                    <TextBox TabIndex="4" SpellCheck.IsEnabled="False" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Text="Tên bảo vệ ca trực:" Style="{StaticResource StaffFormLabel}"/>
                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding GuardName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" IsReadOnly="True" Background="#F1F5F9" Focusable="False"/>

                    <Button TabIndex="5" Content="🛡 Ghi Nhận Sự Kiện" Command="{Binding SaveCommand}" Margin="0,5,0,0">

                        <Button.Style>

                            <Style TargetType="Button" BasedOn="{StaticResource StaffPrimaryBtn}">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">

                                        <Setter Property="IsEnabled" Value="False"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- Khung Hướng dẫn nghiệp vụ đón tiếp chuẩn sư phạm v4.1 -->
                    <Border Margin="0,15,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <!-- Hướng dẫn Check-In -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEventType}" Value="CheckIn">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="💡 Hướng dẫn đón tiếp khách (Check-In):" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,5"/>
                                <TextBlock Text="1. Click chuột chọn ô quét QR CCCD phía trên." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                                <TextBlock Text="2. Đưa mã QR trên thẻ CCCD của khách vào trước đầu đọc." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                                <TextBlock Text="3. Chọn mục đích viếng thăm và cán bộ tiếp đón." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                                <TextBlock Text="4. Cấp thẻ nhựa và bấm [Ghi Nhận Sự Kiện]." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                            </StackPanel>

                            <!-- Hướng dẫn Check-Out -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEventType}" Value="CheckOut">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="💡 Hướng dẫn khách ra cổng (Check-Out):" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,5"/>
                                <TextBlock Text="1. Chọn đúng vị khách trong danh sách xổ xuống." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                                <TextBlock Text="2. Xác nhận thông tin và kiểm tra thẻ khách thu hồi." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                                <TextBlock Text="3. Bấm [Ghi Nhận Sự Kiện] để kết thúc ca viếng thăm." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                            </StackPanel>

                            <!-- Hướng dẫn Bàn giao chìa khóa -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEventType}" Value="KeyExchange">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="🔑 Quy trình bàn giao chìa khóa/tài sản:" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,5"/>
                                <TextBlock Text="1. Ghi rõ Tên người nhận chìa khóa ở ô Người liên quan." FontSize="11" Foreground="#047857" Margin="0,0,0,2"/>
                                <TextBlock Text="2. Nhập số chìa khóa/tên tài sản bàn giao vào Chi tiết sự kiện." FontSize="11" Foreground="#047857" Margin="0,0,0,2"/>
                                <TextBlock Text="3. Xác nhận tình trạng tài sản và bấm [Ghi Nhận Sự Kiện]." FontSize="11" Foreground="#047857" Margin="0,0,0,2"/>
                            </StackPanel>

                            <!-- Hướng dẫn Sự cố an ninh -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEventType}" Value="Incident">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="🚨 Hướng dẫn báo cáo sự cố an ninh:" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,5"/>
                                <TextBlock Text="1. Xác định rõ đối tượng liên quan (học sinh, giáo viên hoặc người lạ)." FontSize="11" Foreground="#B91C1C" Margin="0,0,0,2"/>
                                <TextBlock Text="2. Ghi chép trung thực diễn biến sự việc vào phần Chi tiết sự kiện." FontSize="11" Foreground="#B91C1C" Margin="0,0,0,2"/>
                                <TextBlock Text="3. Nếu sự cố nghiêm trọng, hãy chuyển màn hình sang 'Sổ Hành Vi / Sự Cố' để báo cáo BGH và gửi tin nhắn tới PH." FontSize="11" Foreground="#B91C1C" Margin="0,0,0,2" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Hướng dẫn loại khác -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEventType}" Value="Other">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="📝 Ghi nhận thông tin chung:" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBlock Text="Nhập đầy đủ tên người liên quan và mô tả chi tiết sự kiện để phục vụ đối chiếu." FontSize="11" Foreground="#475569" Margin="0,0,0,2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

            </Border>

        </ScrollViewer>



            <!-- Danh Sách -->

            <Border Grid.Column="1" Style="{StaticResource StaffFormCard}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <TextBlock Text="Lịch sử ghi nhận" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>



                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">

                        <TextBox SpellCheck.IsEnabled="False" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Width="220" Margin="0,0,10,0"/>

                        <Button Content="Tìm kiếm" Style="{StaticResource StaffOutlineBtn}" Padding="15,8" Command="{Binding SearchCommand}" Margin="0,0,10,0"/>

                        <Button Content="Tải lại hôm nay" Style="{StaticResource StaffPrimaryBtn}" Padding="15,8" Command="{Binding LoadTodayLogsCommand}"/>

                    </StackPanel>



                    <DataGrid ItemsSource="{Binding Logs}" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                               IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                               BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                               HeadersVisibility="Column" RowHeight="Auto" MinRowHeight="40"
                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>

                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>

                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>

                            <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>

                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Thời gian" Binding="{Binding Timestamp, StringFormat='dd/MM HH:mm'}" Width="110"/>

                            <DataGridTextColumn Header="Loại sự kiện" Binding="{Binding FriendlyEventType}" Width="120"/>

                            <DataGridTextColumn Header="Người liên quan" Binding="{Binding PersonInvolved}" Width="140"/>

                            <DataGridTextColumn Header="Chi tiết" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="MaxHeight" Value="80"/>
                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>



