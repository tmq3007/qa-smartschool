<UserControl x:Class="QASmartClass.Staff.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:QASmartClass.Staff.ViewModels"
             FontFamily="{StaticResource InterFont}" Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Effect" Value="{StaticResource StaffCardShadow}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title & Filter -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="📊 Báo Cáo Tổng Hợp Nghiệp Vụ" 
                               FontFamily="{StaticResource OutfitFont}" 
                               FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Thống kê tổng hợp hoạt động trong trường học" 
                               FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Khoảng thời gian:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}"/>
                    <ComboBox SelectedValue="{Binding SelectedPeriod, Mode=TwoWay}" MinWidth="130" Padding="6">
                        <ComboBoxItem Content="Hôm nay" IsSelected="True"/>
                        <ComboBoxItem Content="7 ngày qua"/>
                        <ComboBoxItem Content="30 ngày qua"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <!-- Row 1: Tab Control -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: Canteen & General -->
                <TabItem Header="🍴 Hoạt động &amp; Canteen">
                    <StackPanel Margin="0,15,0,0">
                        <!-- Summary Cards -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Card 1: Revenue -->
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#047857" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="💰" FontSize="36" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"/>
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu Canteen" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9"/>
                                        <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} đ'}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2: Gate Logs -->
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="🛡" FontSize="36" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"/>
                                    <StackPanel>
                                        <TextBlock Text="Lượt quét thẻ ra vào" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9"/>
                                        <TextBlock Text="{Binding TotalGateAccess, StringFormat='{}{0:N0} lượt'}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 3: Incidents -->
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#B45309" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="🚨" FontSize="36" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"/>
                                    <StackPanel>
                                        <TextBlock Text="Sự cố ghi nhận" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9"/>
                                        <TextBlock Text="{Binding PendingIncidents, StringFormat='{}{0:N0} vụ'}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </WrapPanel>

                        <!-- Details Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,16" Effect="{StaticResource StaffCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="🛍️ Top 5 suất ăn / Sản phẩm bán chạy" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding TopProducts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0} suất'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding TotalRevenueStr}" FontSize="13" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="📭 Không có dữ liệu doanh thu trong khoảng thời gian này." FontSize="13" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="0,10,0,0" Visibility="{Binding NoRevenueVisibility}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Incident summary (Nhiệm vụ 4 - maximum incidents count dynamically bound) -->
                                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" Padding="20" Effect="{StaticResource StaffCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="🚨 Mức độ nghiêm trọng của sự cố" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding IncidentSummary}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding SeverityDisplay}" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="1" Value="{Binding Count}" Maximum="{Binding DataContext.TotalIncidentsCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Height="8" Foreground="{Binding ColorHex}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} vụ'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,16" Effect="{StaticResource StaffCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ Phân bổ lượt quét thẻ ra/vào" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding GateStats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Action}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Count, StringFormat='{}{0} lượt'}" FontSize="13" Foreground="{Binding ColorHex}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="#EFF6FF" CornerRadius="12" Padding="15" BorderBrush="#BFDBFE" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="💡 Chỉ dẫn nghiệp vụ" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Doanh thu ví Canteen được cập nhật tức thì khi học sinh thanh toán tại quầy." FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Lượt quét thẻ cổng tự động đồng bộ từ thiết bị đọc thẻ thông minh RFID." FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Sử dụng bộ lọc khoảng thời gian để phân tích xu hướng hoặc xuất dữ liệu báo cáo EMIS Bộ GD&amp;ĐT." FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Tab 2: Visitors & Security -->
                <TabItem Header="🛡️ Khách tham quan &amp; An ninh">
                    <StackPanel Margin="0,15,0,0">
                        <!-- Summary Cards -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Card 1: Visitors Count -->
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="👥" FontSize="36" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"/>
                                    <StackPanel>
                                        <TextBlock Text="Tổng lượt khách viếng thăm" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9"/>
                                        <TextBlock Text="{Binding TotalVisitors, StringFormat='{}{0:N0} lượt'}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2: Active Visitors -->
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#047857" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="🏫" FontSize="36" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"/>
                                    <StackPanel>
                                        <TextBlock Text="Khách đang trong trường" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9"/>
                                        <TextBlock Text="{Binding ActiveVisitorsInSchool, StringFormat='{}{0:N0} người'}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 3: Avg Stay Duration -->
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#B45309" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="⏱️" FontSize="36" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"/>
                                    <StackPanel>
                                        <TextBlock Text="Thời gian lưu trú TB" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9"/>
                                        <TextBlock Text="{Binding AverageStayDuration, StringFormat='{}{0:N1} phút'}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </WrapPanel>

                        <!-- Details Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Active visitors list & Top hosts -->
                            <StackPanel Grid.Column="0">
                                <!-- Active visitors datagrid -->
                                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,16" Effect="{StaticResource StaffCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="🏫 Khách hiện diện trong khuôn viên trường" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                        
                                        <DataGrid ItemsSource="{Binding CurrentVisitors}" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                                  BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                                  HeadersVisibility="Column" RowHeight="38" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Giờ vào" Binding="{Binding Timestamp, StringFormat='HH:mm'}" Width="80"/>
                                                <DataGridTextColumn Header="Tên khách" Binding="{Binding VisitorName}" Width="120"/>
                                                <DataGridTextColumn Header="Thẻ số" Binding="{Binding BadgeNumber}" Width="80"/>
                                                <DataGridTextColumn Header="Mục đích" Binding="{Binding VisitPurpose}" Width="120"/>
                                                <DataGridTextColumn Header="Người tiếp" Binding="{Binding HostTeacherId}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        
                                        <TextBlock Text="📭 Hiện tại không có khách tham quan nào trong trường học." FontSize="13" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="0,10,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentVisitors.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Top Hosts -->
                                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" Padding="20" Effect="{StaticResource StaffCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="🏫 Top 5 giáo viên / Cán bộ đón tiếp nhiều khách nhất" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding TopHosts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding TeacherName}" FontSize="13" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Count, StringFormat='{}{0} lượt đón'}" FontSize="13" Foreground="#3B82F6" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Purpose distribution & Security guide -->
                            <StackPanel Grid.Column="2">
                                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,16" Effect="{StaticResource StaffCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="📊 Phân bổ mục đích chuyến thăm" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding VisitPurposes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Purpose}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="1" Value="{Binding Count}" Maximum="{Binding DataContext.TotalVisitors, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Height="8" Foreground="{Binding ColorHex}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat='{}{0}%'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="#EFF6FF" CornerRadius="12" Padding="15" BorderBrush="#BFDBFE" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ Chỉ dẫn nghiệp vụ an ninh" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Trực quan hóa dữ liệu lượng khách giúp Ban Giám Hiệu điều chỉnh bố trí nhân lực bảo vệ ca trực." FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Dữ liệu khách hiện diện được bóc tách thời gian thực để phục vụ cứu hộ cứu nạn khẩn cấp." FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Các số liệu lưu trú trung bình hỗ trợ kiểm soát chất lượng thời gian làm việc của các đối tác, bảo trì thiết bị." FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Tab 3: System Audit Logs -->
                <TabItem Header="📋 Nhật ký Kiểm toán">
                    <StackPanel Margin="0,15,0,0">
                        <!-- Filters Header -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Search bar -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Tìm kiếm nhật ký (Tên, Tác vụ, Chi tiết):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#334155"/>
                                    <TextBox Text="{Binding SearchAuditText, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>
                                
                                <!-- Action type filter -->
                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="Phân loại hành động:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#334155"/>
                                    <ComboBox ItemsSource="{Binding AuditActionTypes}" SelectedItem="{Binding SelectedAuditActionType}" Height="35"/>
                                </StackPanel>

                                <!-- Reload button -->
                                <Button Grid.Column="2" Content="🔄 Tải lại" Command="{Binding LoadAuditLogsCommand}" Height="35" Width="100" VerticalAlignment="Bottom" Style="{StaticResource StaffPrimaryBtn}"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid Display -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Danh sách Nhật ký Kiểm toán hệ thống" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="5,5,0,15"/>
                                <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="42">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                                        <DataGridTextColumn Header="Người thực hiện" Binding="{Binding ActorName}" Width="150"/>
                                        <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="150"/>
                                        <DataGridTextColumn Header="Chi Tiết" Binding="{Binding Details}" Width="*"/>
                                        <DataGridTemplateColumn Header="Bảo mật / Toàn vẹn" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding IntegrityStatus}" Foreground="{Binding IntegrityColor}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
