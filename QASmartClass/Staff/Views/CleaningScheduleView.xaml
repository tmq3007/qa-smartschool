<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.CleaningScheduleView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             xmlns:vm="clr-namespace:QASmartClass.Staff.ViewModels"

             mc:Ignorable="d" 

             d:DesignHeight="600" d:DesignWidth="800"

             Background="{StaticResource AppBackground}" >

    <UserControl.DataContext>

        <vm:CleaningScheduleViewModel/>

    </UserControl.DataContext>

    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <DockPanel Grid.Row="0" Margin="0,0,0,8">

            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">

                <Border.Background>

                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                        <GradientStop Color="#0891B2" Offset="0"/>

                        <GradientStop Color="#06B6D4" Offset="1"/>

                    </LinearGradientBrush>

                </Border.Background>

                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Checklist Vệ sinh &amp; Lao công" Style="{StaticResource StaffPageTitle}"/>

                <TextBlock Text="Theo dõi lịch trực vệ sinh các khu vực, ghi chú các hạng mục cần sửa chữa/bổ sung." Style="{StaticResource StaffPageSubtitle}" Margin="0,0,0,4"/>

                <TextBlock Text="{Binding ProgressText}" Foreground="#0891B2" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>

            </StackPanel>

        </DockPanel>



        <!-- Main Content -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="350"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Form -->

            <Border Grid.Column="0" Style="{StaticResource StaffFormCard}" Margin="0,0,20,0">

                <StackPanel>

                    <TextBlock Text="Phân công Vệ sinh" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>

                    

                    <TextBlock Text="Khu vực:" Style="{StaticResource StaffFormLabel}"/>

                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" ToolTip="Khu A, Khu vệ sinh tầng 1..."/>



                    <TextBlock Text="Ca trực:" Style="{StaticResource StaffFormLabel}"/>

                    <ComboBox SelectedValue="{Binding SelectedShift}" SelectedValuePath="Tag" Style="{StaticResource StaffComboBox}">

                        <ComboBoxItem Content="Sáng (06:00 - 11:30)" Tag="Morning"/>

                        <ComboBoxItem Content="Chiều (12:30 - 17:30)" Tag="Afternoon"/>

                        <ComboBoxItem Content="Tối (Sau giờ học)" Tag="Evening"/>

                    </ComboBox>



                    <TextBlock Text="Người phụ trách:" Style="{StaticResource StaffFormLabel}"/>

                    <ComboBox ItemsSource="{Binding JanitorProfiles}" SelectedItem="{Binding SelectedJanitor}" DisplayMemberPath="FullName" Style="{StaticResource StaffComboBox}"/>

                    

                    <TextBlock Text="Ghi chú thêm:" Style="{StaticResource StaffFormLabel}"/>

                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>



                    <Button Content="➕ Thêm Công Việc" Command="{Binding AddCommand}" Margin="0,5,0,0">

                        <Button.Style>

                            <Style TargetType="Button" BasedOn="{StaticResource StaffPrimaryBtn}">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">

                                        <Setter Property="IsEnabled" Value="False"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- Khung Hướng dẫn nghiệp vụ lao công chuẩn sư phạm v4.2 -->
                    <Border Margin="0,15,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="💡 Hướng dẫn phân công &amp; ghi nhận:" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,5"/>
                            <TextBlock Text="1. Nhập tên Khu vực cần dọn dẹp vệ sinh." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                            <TextBlock Text="2. Chọn Ca trực phù hợp (Sáng, Chiều, Tối)." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                            <TextBlock Text="3. Chọn người phụ trách từ danh sách Lao công." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                            <TextBlock Text="4. Bấm [Thêm Công Việc] để đưa vào lịch trực nhật." FontSize="11" Foreground="#1E40AF" Margin="0,0,0,2"/>
                            <TextBlock Text="5. Khi hoàn thành, bấm nút [Hoàn thành] bên cạnh dòng công việc để báo cáo tiến độ." FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Border>



            <!-- Danh Sách -->

            <Border Grid.Column="1" Style="{StaticResource StaffFormCard}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    

                    <TextBlock Text="Danh sách công việc" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>



                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">

                        <DatePicker SelectedDate="{Binding TaskDate}" Width="150" Margin="0,0,10,0"/>

                        <Button Content="✅ Hoàn thành" Style="{StaticResource StaffSuccessBtn}" Padding="15,8" Command="{Binding DoneCommand}" CommandParameter="{Binding SelectedItem, ElementName=LvTasks}"/>

                    </StackPanel>



                    <DataGrid x:Name="LvTasks" ItemsSource="{Binding Tasks}" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"

                              IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"

                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"

                              HeadersVisibility="Column" RowHeight="40">

                        <DataGrid.ColumnHeaderStyle>

                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/>

                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>

                            <Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/>

                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Khu vực" Binding="{Binding Area}" Width="150"/>

                            <DataGridTextColumn Header="Ca" Binding="{Binding FriendlyShift}" Width="80"/>

                            <DataGridTextColumn Header="Người phụ trách" Binding="{Binding JanitorName}" Width="130"/>

                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding FriendlyStatus}" Width="90"/>

                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/>

                            <DataGridTemplateColumn Header="Hành động" Width="120">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="Hoàn thành" 

                                                Command="{Binding DataContext.DoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 

                                                CommandParameter="{Binding}" 

                                                Padding="6,2" FontSize="11" Margin="4,2">

                                            <Button.Style>

                                                <Style TargetType="Button" BasedOn="{StaticResource StaffOutlineBtn}">

                                                    <Setter Property="Visibility" Value="Visible"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Status}" Value="Done">

                                                            <Setter Property="Visibility" Value="Collapsed"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>



