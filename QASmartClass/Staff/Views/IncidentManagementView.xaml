<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.IncidentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource AppBackground}" >
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DC2626" Offset="0"/><GradientStop Color="#F87171" Offset="1"/></LinearGradientBrush></Border.Background>
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ghi Nhận Sự Cố" Style="{StaticResource StaffPageTitle}"/>
                <TextBlock Text="Báo cáo và theo dõi sự cố an ninh, kỷ luật trong khuôn viên trường." Style="{StaticResource StaffPageSubtitle}" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,15,0,0">
            <!-- TAB 1: SỰ CỐ & VI PHẠM -->
            <TabItem Header="🚨 SỔ HÀNH VI / SỰ CỐ" Padding="15,6">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Form -->
                    <Border Grid.Column="0" Style="{StaticResource StaffFormCard}" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Báo Cáo Sự Cố Mới" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                            <TextBlock Text="Lọc theo lớp học:" Style="{StaticResource StaffFormLabel}"/>
                            <ComboBox ItemsSource="{Binding ClassList}" SelectedValue="{Binding SelectedClassIncident}" Style="{StaticResource StaffComboBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Mã Học Sinh (tùy chọn):" Style="{StaticResource StaffFormLabel}"/>
                            <ComboBox IsEditable="True" IsReadOnly="False" TextSearch.TextPath="DisplayName"
                                      ItemsSource="{Binding StudentsList}" SelectedValue="{Binding StudentCode}" SelectedValuePath="StudentCode"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource StaffComboBox}"/>
                            <TextBlock Text="{Binding StudentNameDisplay}" Foreground="#475569" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,10"/>
                            <TextBlock Text="Mức Độ:" Style="{StaticResource StaffFormLabel}"/>
                            <ComboBox SelectedIndex="{Binding SeverityIndex}" Style="{StaticResource StaffComboBox}">
                                <ComboBoxItem Content="1 - Nhẹ (Low)"/>
                                <ComboBoxItem Content="2 - Trung bình (Medium)"/>
                                <ComboBoxItem Content="3 - Nghiêm trọng (High)"/>
                                <ComboBoxItem Content="4 - Khẩn cấp (Critical)"/>
                            </ComboBox>
                            <TextBlock Text="Mô Tả Chi Tiết:" Style="{StaticResource StaffFormLabel}"/>
                            <TextBox SpellCheck.IsEnabled="False" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"/>
                            <Button Content="{Binding SubmitButtonText}" Command="{Binding ReportIncidentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StaffDangerBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="IsProcessing" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Hủy chỉnh sửa" Style="{StaticResource StaffSecondaryBtn}" Command="{Binding CancelEditCommand}" Visibility="{Binding CancelEditVisibility}" Margin="0,8,0,0}"/>

                            <!-- Khung Hướng dẫn nghiệp vụ sư phạm phân loại sự cố -->
                            <Border Margin="0,15,0,0" Background="#FFF5F5" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="💡 Hướng dẫn phân loại mức độ sự cố:" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Mức 1 - Nhẹ: Vi phạm nội quy nhỏ (quên đồng phục, đi muộn). Lưu hệ thống nội bộ." FontSize="11" Foreground="#991B1B" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Mức 2 - Trung bình: Gây mất trật tự, lười học bài. Ghi nhận học bạ thi đua." FontSize="11" Foreground="#991B1B" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Mức 3 - Nghiêm trọng: Va chạm vật lý, phá hỏng thiết bị. Hệ thống tự động gửi thông báo cho PH &amp; BGH." FontSize="11" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Mức 4 - Khẩn cấp: Có hành vi đe dọa an toàn học đường. Gọi ngay cho Ban giám hiệu hỗ trợ." FontSize="11" Foreground="#DC2626" FontWeight="Bold" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- List -->
                    <Border Grid.Column="1" Style="{StaticResource StaffFormCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Danh Sách Sự Cố Gần Đây" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Incidents}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="42">
                                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/></DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/></DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp, StringFormat='dd/MM HH:mm'}" Width="110"/>
                                    <DataGridTextColumn Header="Người ghi nhận" Binding="{Binding DisplayActor}" Width="130"/>
                                    <DataGridTemplateColumn Header="Mức độ" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                    <Setter Property="Background" Value="#FFE4E6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding FriendlySeverity}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Chi Tiết" Binding="{Binding FriendlyDetails}" Width="*"/>
                                    <DataGridTemplateColumn Header="Hành động" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Sửa" Style="{StaticResource StaffIconBtn}" Background="#E0F2FE" Foreground="#0284C7" Margin="0,0,5,0"
                                                            Command="{Binding DataContext.SelectForEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                    <Button Content="Báo PH" Background="#FEF3C7" Foreground="#D97706" Margin="0,0,5,0"
                                                            Command="{Binding DataContext.NotifyParentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource StaffIconBtn}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsParentNotified}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Xóa" Style="{StaticResource StaffIconBtn}" Background="#FEE2E2" Foreground="#DC2626"
                                                            Command="{Binding DataContext.DeleteIncidentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <!-- Pagination Controls -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Button Content="◀" Command="{Binding PrevPageCommand}" Style="{StaticResource StaffOutlineBtn}" Width="40" Margin="0,0,10,0"/>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondary}">
                                    <Run Text="Trang "/>
                                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Content="▶" Command="{Binding NextPageCommand}" Style="{StaticResource StaffOutlineBtn}" Width="40" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: VIỆC TỐT & TUYÊN DƯƠNG -->
            <TabItem Header="🌟 VIỆC TỐT / TUYÊN DƯƠNG" Padding="15,6">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form -->
                    <Border Grid.Column="0" Style="{StaticResource StaffFormCard}" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Khen Thưởng Việc Tốt" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                            <TextBlock Text="Lọc theo lớp học:" Style="{StaticResource StaffFormLabel}"/>
                            <ComboBox ItemsSource="{Binding ClassList}" SelectedValue="{Binding SelectedClassGoodDeed}" Style="{StaticResource StaffComboBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Mã Học Sinh (tùy chọn):" Style="{StaticResource StaffFormLabel}"/>
                            <ComboBox IsEditable="True" IsReadOnly="False" TextSearch.TextPath="DisplayName"
                                      ItemsSource="{Binding GoodDeedStudentsList}" SelectedValue="{Binding GoodDeedStudentCode}" SelectedValuePath="StudentCode"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource StaffComboBox}"/>
                            <TextBlock Text="{Binding GoodDeedStudentNameDisplay}" Foreground="#475569" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,10"/>
                            <TextBlock Text="Loại Việc Tốt:" Style="{StaticResource StaffFormLabel}"/>
                            <ComboBox SelectedValue="{Binding GoodDeedType}" SelectedValuePath="Content" Style="{StaticResource StaffComboBox}">
                                <ComboBoxItem Content="Trực nhật xuất sắc"/>
                                <ComboBoxItem Content="Nhặt được của rơi"/>
                                <ComboBoxItem Content="Giúp đỡ bạn bè"/>
                                <ComboBoxItem Content="Thành tích học tập tốt"/>
                                <ComboBoxItem Content="Tham gia phong trào tích cực"/>
                            </ComboBox>
                            <TextBlock Text="Mô Tả Chi Tiết:" Style="{StaticResource StaffFormLabel}"/>
                            <TextBox SpellCheck.IsEnabled="False" Text="{Binding GoodDeedDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <TextBlock Text="{Binding GoodDeedErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"/>
                            <Button Content="{Binding GoodDeedSubmitButtonText}" Command="{Binding ReportGoodDeedCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StaffSuccessBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="IsProcessing" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Hủy chỉnh sửa" Style="{StaticResource StaffSecondaryBtn}" Command="{Binding CancelEditGoodDeedCommand}" Visibility="{Binding CancelEditGoodDeedVisibility}" Margin="0,8,0,0}"/>
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1" Style="{StaticResource StaffFormCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Danh Sách Việc Tốt Gần Đây" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding GoodDeeds}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="42">
                                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/></DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/></DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp, StringFormat='dd/MM HH:mm'}" Width="110"/>
                                    <DataGridTextColumn Header="Người ghi nhận" Binding="{Binding DisplayActor}" Width="130"/>
                                    <DataGridTextColumn Header="Chi Tiết" Binding="{Binding FriendlyDetails}" Width="*"/>
                                    <DataGridTemplateColumn Header="Hành động" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Sửa" Style="{StaticResource StaffIconBtn}" Background="#E0F2FE" Foreground="#0284C7" Margin="0,0,5,0"
                                                            Command="{Binding DataContext.SelectGoodDeedForEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                    <Button Content="Xóa" Style="{StaticResource StaffIconBtn}" Background="#FEE2E2" Foreground="#DC2626"
                                                            Command="{Binding DataContext.DeleteGoodDeedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Id}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
