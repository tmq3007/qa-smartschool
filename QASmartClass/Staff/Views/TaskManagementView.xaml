<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.TaskManagementView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:vm="clr-namespace:QASmartClass.Staff.ViewModels"

      xmlns:sys="clr-namespace:System;assembly=System.Runtime"

      Background="{StaticResource AppBackground}" >

    <UserControl.DataContext>

        <vm:TaskManagementViewModel/>

    </UserControl.DataContext>

    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">

            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">

                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EA580C" Offset="0"/><GradientStop Color="#FB923C" Offset="1"/></LinearGradientBrush></Border.Background>

                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Giao Việc &amp; Nhiệm Vụ" Style="{StaticResource StaffPageTitle}"/>

                <TextBlock Text="Phân công công việc cho nhân viên, theo dõi tiến độ hoàn thành." Style="{StaticResource StaffPageSubtitle}" Margin="0"/>

            </StackPanel>

        </DockPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="380"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StaffFormCard}" Margin="0,0,20,0">

                <StackPanel>

                    <TextBlock FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Text" Value="Giao Việc Mới"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">

                                        <Setter Property="Text" Value="Chỉnh Sửa Công Việc"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                    <TextBlock Text="Tên công việc:" Style="{StaticResource StaffFormLabel}"/>

                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}"/>

                    <TextBlock Text="Người nhận việc:" Style="{StaticResource StaffFormLabel}"/>

                    <ComboBox SelectedItem="{Binding Assignee}" ItemsSource="{Binding StaffNames}" Style="{StaticResource StaffComboBox}"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phòng ban:" Style="{StaticResource StaffFormLabel}"/>
                            <ComboBox SelectedValue="{Binding SelectedDepartment}" SelectedValuePath="Tag" DisplayMemberPath="Name" ItemsSource="{Binding Departments}" Style="{StaticResource StaffComboBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hạn chót:" Style="{StaticResource StaffFormLabel}"/>
                            <DatePicker SelectedDate="{Binding DueDate}" Margin="0,0,0,15"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,5">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Tiết đồng bộ:" Style="{StaticResource StaffFormLabel}"/>

                            <ComboBox SelectedItem="{Binding SyncPeriod}" Style="{StaticResource StaffComboBox}">

                                <sys:Int32>1</sys:Int32>

                                <sys:Int32>2</sys:Int32>

                                <sys:Int32>3</sys:Int32>

                                <sys:Int32>4</sys:Int32>

                                <sys:Int32>5</sys:Int32>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Phòng đồng bộ:" Style="{StaticResource StaffFormLabel}"/>

                            <TextBox SpellCheck.IsEnabled="False" Text="{Binding SyncRoom, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}"/>

                        </StackPanel>

                    </Grid>

                    <TextBlock Text="Ghi chú chi tiết:" Style="{StaticResource StaffFormLabel}"/>

                    <TextBox SpellCheck.IsEnabled="False" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StaffTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                    

                    <!-- Buttons area -->

                    <StackPanel Margin="0,15,0,0">

                        <Button Content="✅ Giao Công Việc" Command="{Binding AssignCommand}">

                            <Button.Style>

                                <Style TargetType="Button" BasedOn="{StaticResource StaffSuccessBtn}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">

                                            <Setter Property="Content" Value="💾 Lưu Cập Nhật"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                        </Button>

                        <Grid Margin="0,10,0,0">

                            <Grid.Style>

                                <Style TargetType="Grid">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">

                                            <Setter Property="Visibility" Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Grid.Style>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="10"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🗑 Xóa Công Việc" Style="{StaticResource StaffDangerBtn}" Command="{Binding DeleteTaskCommand}"/>

                            <Button Grid.Column="2" Content="❌ Hủy Bỏ Sửa" Style="{StaticResource StaffOutlineBtn}" Command="{Binding CancelEditCommand}"/>

                        </Grid>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Grid.Column="1" Style="{StaticResource StaffFormCard}">

                <Grid>

                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <TextBlock Text="Theo dõi Tiến độ" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutoGenerateColumns="False" CanUserAddRows="False"

                              IsReadOnly="False" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"

                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="42">

                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaffDataGridHeader}"/></DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource StaffDataGridRow}"/></DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>

                            <DataGridTextColumn Header="Tên công việc" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>

                            <DataGridTextColumn Header="Người nhận" Binding="{Binding AssignedTo}" Width="120" IsReadOnly="True"/>

                            <DataGridTextColumn Header="Hạn chót" Binding="{Binding DueDate, StringFormat='dd/MM/yyyy'}" Width="95" IsReadOnly="True"/>

                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Thao tác" Width="100">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="Hoàn thành" 

                                                Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 

                                                CommandParameter="{Binding}" 

                                                Style="{StaticResource StaffOutlineBtn}" 

                                                Padding="6,2" FontSize="11"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>



