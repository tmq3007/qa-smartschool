                        <TextBlock x:Name="txtDbWarningMsg" Text="⚠️ Cảnh báo IT: Cơ sở dữ liệu hiện tại đạt 0 MB, vượt quá ngưỡng cho phép 0 MB. Vui lòng chạy dọn dẹp dữ liệu hoặc sao lưu!" Foreground="#991B1B" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
                <Frame Grid.Row="1" x:Name="FeatureFrame" NavigationUIVisibility="Hidden" Visibility="Hidden"/>
            </Grid>



        </Grid>



    </Grid>



