<Window TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.StaffDashboardWindow"



        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"



        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 



        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 



        xmlns:local="clr-namespace:QASmartClass.Staff.Views"



        xmlns:viewmodels="clr-namespace:QASmartClass.Staff.ViewModels"



        mc:Ignorable="d" 



        d:DesignHeight="720" d:DesignWidth="1280"



        Title="QA SmartSchool - Quản trị Nghiệp vụ Nhà trường" Background="{DynamicResource AppBackground}"



        Width="1366" Height="768"



        WindowStartupLocation="CenterScreen"



        WindowState="Maximized"



        >







    <Window.DataContext>



        <viewmodels:StaffDashboardViewModel />



    </Window.DataContext>







    <Window.Resources>

        <!-- DataTemplates to render the correct view for each ViewModel -->

        <DataTemplate DataType="{x:Type viewmodels:StaffOverviewViewModel}">

            <local:StaffOverviewView />

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:IncidentManagementViewModel}">

            <local:IncidentManagementView />

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:GateMonitorViewModel}">

            <local:GateMonitorView />

        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:CanteenPosViewModel}">

            <local:CanteenPosView />

        </DataTemplate>

    </Window.Resources>



    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto" MinWidth="210" MaxWidth="280" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <!-- ═══ SIDEBAR (Dark Gradient — cloned from StudentShell) ═══ -->

        <Border Grid.Column="0">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                    <GradientStop Color="#0B1929" Offset="0"/>

                    <GradientStop Color="#112240" Offset="0.5"/>

                    <GradientStop Color="#0A1628" Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

            <DockPanel>

                <!-- Logo Area -->

                <Border DockPanel.Dock="Top" Padding="14,14,14,6">

                    <DockPanel>

                        <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Margin="0,0,10,0">



                            <Border.Background>



                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">



                                    <GradientStop Color="#2563EB" Offset="0"/>



                                    <GradientStop Color="#60A5FA" Offset="1"/>



                                </LinearGradientBrush>



                            </Border.Background>



                            <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="18"



                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>



                        </Border>



                        <StackPanel VerticalAlignment="Center">



                            <TextBlock Text="QA SMART CLASS" FontSize="14" FontWeight="Bold" Foreground="White"/>



                            <TextBlock Text="Quản trị Nghiệp vụ" FontSize="9" Foreground="#64748B" Margin="0,2,0,0"/>



                        </StackPanel>



                    </DockPanel>



                </Border>







                <!-- Staff Info Card -->



                <Border DockPanel.Dock="Top" Margin="10,6,10,4" CornerRadius="12" Padding="12,10">



                    <Border.Background>



                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">



                            <GradientStop Color="#0F3460" Offset="0"/>



                            <GradientStop Color="#16213E" Offset="1"/>



                        </LinearGradientBrush>



                    </Border.Background>



                    <DockPanel>



                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">



                            <Border.Background><SolidColorBrush Color="#22C55E"/></Border.Background>



                        </Border>



                        <StackPanel>



                            <TextBlock x:Name="txtCardUserName" Text="Admin • Hành chính" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold"/>



                            <TextBlock Text="Đang hoạt động" Foreground="#4ADE80" FontSize="10" Margin="0,2,0,0"/>



                        </StackPanel>



                    </DockPanel>



                </Border>







                <!-- Bottom Bar -->



                <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#080F1A">



                    <StackPanel>



                        <DockPanel Margin="0,0,0,8">



                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">



                                <Border.Background>



                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">



                                        <GradientStop Color="#1D4ED8" Offset="0"/>



                                        <GradientStop Color="#60A5FA" Offset="1"/>



                                    </LinearGradientBrush>



                                </Border.Background>



                                <TextBlock x:Name="txtUserInitials" Text="AD" FontSize="12" FontWeight="Bold" Foreground="White"



                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>



                            </Border>



                            <StackPanel VerticalAlignment="Center">



                                <TextBlock x:Name="txtUserName" Text="Administrator" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>



                                <TextBlock x:Name="txtUserRole" Text="v5.4.0" Foreground="#64748B" FontSize="9" Margin="0,2,0,0"/>



                            </StackPanel>



                        </DockPanel>



                        <Button x:Name="btnLogout" Click="BtnLogout_Click" Cursor="Hand"



                                Background="Transparent" BorderThickness="1" BorderBrush="#334155"



                                Foreground="#F87171" FontSize="12" Padding="8,6" HorizontalContentAlignment="Center">



                            <Button.Template>



                                <ControlTemplate TargetType="Button">



                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"



                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">



                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                    </Border>



                                    <ControlTemplate.Triggers>



                                        <Trigger Property="IsMouseOver" Value="True">



                                            <Setter TargetName="bd" Property="Background" Value="#1C2333"/>



                                            <Setter TargetName="bd" Property="BorderBrush" Value="#F87171"/>



                                        </Trigger>



                                    </ControlTemplate.Triggers>



                                </ControlTemplate>



                            </Button.Template>



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>



                                <TextBlock Text="Đăng xuất" VerticalAlignment="Center" FontWeight="SemiBold"/>



                            </StackPanel>



                        </Button>



                    </StackPanel>



                </Border>







                <!-- ═══ NAVIGATION ═══ -->



                <ScrollViewer VerticalScrollBarVisibility="Auto">



                    <StackPanel x:Name="navMenu" Margin="0,6,0,8">







                        <!-- ─── VẬN HÀNH CHUNG ─── -->



                        <Expander Header="📦 VẬN HÀNH CHUNG" IsExpanded="True" Margin="5,2" Background="Transparent" BorderThickness="0">



                            <Expander.HeaderTemplate>



                                <DataTemplate>



                                    <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11" Foreground="#60A5FA" VerticalAlignment="Center" Margin="5,0,0,0"/>



                                </DataTemplate>



                            </Expander.HeaderTemplate>



                            <StackPanel Margin="0,2,0,0">



                                <Button x:Name="btnOverview" Style="{StaticResource StaffNavActive}" Tag="Overview" Command="{Binding NavigateToOverviewCommand}">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#60A5FA"/>



                                        <TextBlock Text="Tổng quan" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="event_calendar" Click="NavFeature_Click">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#38BDF8"/>



                                        <TextBlock Text="Lịch Công tác" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="Incidents" Command="{Binding NavigateToIncidentsCommand}">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FBBF24"/>



                                        <TextBlock Text="Sự cố &amp; Việc tốt" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="Gate" Command="{Binding NavigateToGateCommand}">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#34D399"/>



                                        <TextBlock Text="Cổng Trường (C1)" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="Canteen" Command="{Binding NavigateToCanteenCommand}">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FB923C"/>



                                        <TextBlock Text="Ví Canteen (G1)" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                            </StackPanel>



                        </Expander>







                        <!-- ─── DỊCH VỤ & BÁN TRÚ ─── -->



                        <Expander Header="💼 DỊCH VỤ &amp; BÁN TRÚ" IsExpanded="False" Margin="5,2" Background="Transparent" BorderThickness="0">



                            <Expander.HeaderTemplate>



                                <DataTemplate>



                                    <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11" Foreground="#4ADE80" VerticalAlignment="Center" Margin="5,0,0,0"/>



                                </DataTemplate>



                            </Expander.HeaderTemplate>



                            <StackPanel Margin="0,2,0,0">



                                <Button Style="{StaticResource StaffNavButton}" Tag="security" Click="NavFeature_Click">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#F87171"/>



                                        <TextBlock Text="Nhật ký Bảo vệ" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="janitor" Click="NavFeature_Click">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#2DD4BF"/>



                                        <TextBlock Text="Checklist Lao công" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="kitchen" Click="NavFeature_Click">



                                    <DockPanel Width="200">



                                        <TextBlock Text="&#xED56;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FB923C"/>



                                        <TextBlock Text="Thực đơn Bán trú" VerticalAlignment="Center"/>



                                    </DockPanel>



                                </Button>



                            </StackPanel>



                        </Expander>







                        <!-- ─── Y TẾ & AN TOÀN ─── -->



                        <Expander Header="🎈 Y TẾ &amp; AN TOÀN" IsExpanded="False" Margin="5,2" Background="Transparent" BorderThickness="0">



                            <Expander.HeaderTemplate>



                                <DataTemplate>



                                    <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11" Foreground="#F472B6" VerticalAlignment="Center" Margin="5,0,0,0"/>



                                </DataTemplate>



                            </Expander.HeaderTemplate>



                            <StackPanel Margin="0,2,0,0">



                                <Button Style="{StaticResource StaffNavButton}" Tag="counseling" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A78BFA"/><TextBlock Text="Hồ sơ Tư vấn" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="health" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#F472B6"/><TextBlock Text="Hồ sơ Sức khỏe" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="epidemic" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FB7185"/><TextBlock Text="Phòng Dịch Bệnh" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="food_safety" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xEB47;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4ADE80"/><TextBlock Text="VSATTP Canteen" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="medical_inventory" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#38BDF8"/><TextBlock Text="Kho Thuốc Y tế" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="emergency" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#EF4444"/><TextBlock Text="Báo cáo Sơ cứu" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                            </StackPanel>



                        </Expander>







                        <!-- ─── CÔNG VIỆC & ỨNG DỤNG ─── -->



                        <Expander Header="⚙️ CÔNG VIỆC &amp; ỨNG DỤNG" IsExpanded="False" Margin="5,2" Background="Transparent" BorderThickness="0">



                            <Expander.HeaderTemplate>



                                <DataTemplate>



                                    <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11" Foreground="#34D399" VerticalAlignment="Center" Margin="5,0,0,0"/>



                                </DataTemplate>



                            </Expander.HeaderTemplate>



                            <StackPanel Margin="0,2,0,0">



                                <Button Style="{StaticResource StaffNavButton}" Tag="leave_request" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A78BFA"/><TextBlock Text="Quản lý Xin nghỉ" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="mobile_app" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#34D399"/><TextBlock Text="Quản lý Mobile App" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button x:Name="btnPushNotification" Style="{StaticResource StaffNavButton}" Tag="push_notification" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FBBF24"/><TextBlock Text="Thông báo Đẩy" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="app_analytics" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#C084FC"/><TextBlock Text="Phân tích Ứng dụng" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="task_management" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FB923C"/><TextBlock Text="Giao việc &amp; Nhiệm vụ" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="staff_performance" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FBBF24"/><TextBlock Text="KPI Công việc" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="eoffice_routing" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#38BDF8"/><TextBlock Text="Luân chuyển eOffice" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                            </StackPanel>



                        </Expander>







                        <!-- ─── NHÂN SỰ & ĐOÀN ĐỘI ─── -->



                        <Expander Header="👥 NHÂN SỰ &amp; ĐOÀN ĐỘI" IsExpanded="False" Margin="5,2" Background="Transparent" BorderThickness="0">



                            <Expander.HeaderTemplate>



                                <DataTemplate>



                                    <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="5,0,0,0"/>



                                </DataTemplate>



                            </Expander.HeaderTemplate>



                            <StackPanel Margin="0,2,0,0">



                                <Button Style="{StaticResource StaffNavButton}" Tag="hr_profile" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#60A5FA"/><TextBlock Text="Hồ sơ Nhân sự" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="department_mgmt" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#2DD4BF"/><TextBlock Text="Tổ Chuyên Môn" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="award_mgmt" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#F59E0B"/><TextBlock Text="Khen Thưởng" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="hr_contract" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A78BFA"/><TextBlock Text="Hợp đồng LĐ" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="hr_leave" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4ADE80"/><TextBlock Text="Nghỉ phép" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="hr_attendance" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FB923C"/><TextBlock Text="Chấm công NV" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_dashboard" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#3B82F6"/><TextBlock Text="Tổng quan Đoàn" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_members" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FF8A65"/><TextBlock Text="Quản lý Đoàn viên" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_recruitment" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A855F7"/><TextBlock Text="Kết nạp Đoàn" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_attendance" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#8B5CF6"/><TextBlock Text="Điểm danh" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_activities" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4DB6AC"/><TextBlock Text="Hoạt động - Phong trào" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_eventreg" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8ED;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#EC4899"/><TextBlock Text="Đăng ký Sự kiện" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_emulation" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#F59E0B"/><TextBlock Text="Thi đua Đoàn viên" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_award" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#EAB308"/><TextBlock Text="Hồ sơ Khen thưởng" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_fee" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#10B981"/><TextBlock Text="Đóng Phí Đoàn" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_voting" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#EF4444"/><TextBlock Text="Bầu cử trực tuyến" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_document" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B"/><TextBlock Text="Kho Tài liệu" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                                <Button Style="{StaticResource StaffNavButton}" Tag="youth_planbudget" Click="NavFeature_Click">



                                    <DockPanel Width="200"><TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#14B8A6"/><TextBlock Text="Kế hoạch &amp; Ngân sách" VerticalAlignment="Center"/></DockPanel>



                                </Button>



                            </StackPanel>



                        </Expander>







                        <!-- ─── TÀI CHÍNH & HỆ THỐNG ─── -->



                        <Expander Header="💵 TÀI CHÍNH &amp; HỆ THỐNG" IsExpanded="False" Margin="5,2" Background="Transparent" BorderThickness="0">



                            <Expander.HeaderTemplate>



                                <DataTemplate>



                                    <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11" Foreground="#FBBF24" VerticalAlignment="Center" Margin="5,0,0,0"/>



                                </DataTemplate>



                            </Expander.HeaderTemplate>



