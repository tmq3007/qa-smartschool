<UserControl TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" x:Class="QASmartClass.Staff.Views.StaffOverviewView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:properties="clr-namespace:QASmartClass.Properties"

             mc:Ignorable="d" 

             d:DesignHeight="768" d:DesignWidth="1024" Background="Transparent" >

             

    <UserControl.Resources>

        <Style x:Key="PremiumCardStyle" TargetType="Border">

            <Setter Property="CornerRadius" Value="16"/>

            <Setter Property="Padding" Value="24"/>

            <Setter Property="Width" Value="220"/>

            <Setter Property="Height" Value="130"/>

            <Setter Property="Margin" Value="0,0,20,20"/>

            <Setter Property="Effect" Value="{StaticResource StaffCardShadow}"/>

            <Setter Property="RenderTransform">

                <Setter.Value>

                    <TranslateTransform Y="0"/>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Effect" Value="{StaticResource StaffCardHoverShadow}"/>

                    <Trigger.EnterActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"

                                                 To="-5" Duration="0:0:0.2" />

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.EnterActions>

                    <Trigger.ExitActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"

                                                 To="0" Duration="0:0:0.2" />

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.ExitActions>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>



    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>



            <!-- Header -->

            <TextBlock Grid.Row="0" Text="{Binding WelcomeMessage}" 

                        FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,30">

                <TextBlock Text="{x:Static properties:Resources.Overview_SubHeader}" FontSize="15" Foreground="{DynamicResource TextSecondary}"/>

                <TextBlock x:Name="txtDate" FontSize="15" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>

            </StackPanel>



            <!-- Dashboard Cards -->

            <WrapPanel Grid.Row="2" Orientation="Horizontal">

                <!-- Card 1: Total Events -->

                <Border Style="{StaticResource PremiumCardStyle}">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <GradientStop Color="#3B82F6" Offset="0.0" />

                            <GradientStop Color="#1D4ED8" Offset="1.0" />

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid>

                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="White" Opacity="0.12" 

                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-10" />

                        <StackPanel>

                            <TextBlock Text="{x:Static properties:Resources.Overview_CardEvents}" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9" />

                            <TextBlock Text="{Binding TotalLogs}" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- Card 2: Total Students -->

                <Border Style="{StaticResource PremiumCardStyle}">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <GradientStop Color="#10B981" Offset="0.0" />

                            <GradientStop Color="#047857" Offset="1.0" />

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid>

                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="White" Opacity="0.12" 

                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-10" />

                        <StackPanel>

                            <TextBlock Text="{x:Static properties:Resources.Overview_CardStudents}" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9" />

                            <TextBlock Text="{Binding TotalStudents}" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- Card 3: Pending -->

                <Border Style="{StaticResource PremiumCardStyle}">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <GradientStop Color="#F59E0B" Offset="0.0" />

                            <GradientStop Color="#B45309" Offset="1.0" />

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid>

                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="White" Opacity="0.12" 

                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-10" />

                        <StackPanel>

                            <TextBlock Text="{x:Static properties:Resources.Overview_CardPending}" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9" />

                            <TextBlock Text="{Binding PendingRequests}" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- Card 4: Active Staff -->

                <Border Style="{StaticResource PremiumCardStyle}">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <GradientStop Color="#8B5CF6" Offset="0.0" />

                            <GradientStop Color="#5B21B6" Offset="1.0" />

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid>

                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="White" Opacity="0.12" 

                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-10" />

                        <StackPanel>

                            <TextBlock Text="{x:Static properties:Resources.Overview_CardStaff}" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9" />

                            <TextBlock Text="{Binding ActiveStaffCount}" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- Card 5: Canteen Revenue (NEW) -->

                <Border Style="{StaticResource PremiumCardStyle}">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <GradientStop Color="#DC2626" Offset="0.0" />

                            <GradientStop Color="#991B1B" Offset="1.0" />

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid>

                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="White" Opacity="0.12" 

                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-10" />

                        <StackPanel>

                            <TextBlock Text="{x:Static properties:Resources.Overview_CardRevenue}" Foreground="White" FontSize="12" FontWeight="SemiBold" Opacity="0.9" />

                            <TextBlock Text="{Binding TodayRevenue}" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />

                        </StackPanel>

                    </Grid>

                </Border>

            </WrapPanel>



            <!-- Quick Actions (NEW) -->

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,25">

                <TextBlock Text="⚡ Lối tắt:" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Content="+ Sự cố" Style="{StaticResource StaffOutlineBtn}" Padding="14,6" FontSize="12" Margin="0,0,8,0" Click="QuickIncident_Click"/>

                <Button Content="🛡 Quẹt thẻ" Style="{StaticResource StaffOutlineBtn}" Padding="14,6" FontSize="12" Margin="0,0,8,0" Click="QuickGate_Click"/>

                <Button Content="📋 Giao việc" Style="{StaticResource StaffOutlineBtn}" Padding="14,6" FontSize="12" Margin="0,0,8,0" Click="QuickTask_Click"/>

                <Button Content="📥 Xuất BC" Style="{StaticResource StaffOutlineBtn}" Padding="14,6" FontSize="12" Click="QuickExport_Click"/>

            </StackPanel>



            <!-- ═══ BGH EXECUTIVE DASHBOARD ═══ -->

            <Grid Grid.Row="4" Margin="0,0,0,25">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Chấm công hôm nay -->

                <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource SurfaceBackground}" CornerRadius="16" Padding="20" Effect="{StaticResource StaffCardShadow}" Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="📊 Chấm công hôm nay" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">

                                <TextBlock x:Name="txtOnTime" Text="{Binding AttendanceOnTime}" FontSize="28" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>

                                <TextBlock Text="Đúng giờ" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                                <TextBlock x:Name="txtLate" Text="{Binding AttendanceLate}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>

                                <TextBlock Text="Đi muộn" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">

                                <TextBlock x:Name="txtAbsent" Text="{Binding AttendanceAbsent}" FontSize="28" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>

                                <TextBlock Text="Nghỉ phép" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                        <!-- Progress bar -->

                        <Grid Height="8" Margin="0,4,0,0">

                            <Border Background="#E5E7EB" CornerRadius="4"/>

                            <Border x:Name="barOnTime" Background="#10B981" CornerRadius="4" HorizontalAlignment="Left" Width="180"/>

                        </Grid>

                    </StackPanel>

                </Border>



                <!-- Sự kiện sắp tới -->

                <Border Grid.Column="2" Grid.Row="0" Background="{DynamicResource SurfaceBackground}" CornerRadius="16" Padding="20" Effect="{StaticResource StaffCardShadow}" Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="📅 Sự kiện sắp tới" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding UpcomingEvents}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <DockPanel Margin="0,0,0,8">

                                        <Border DockPanel.Dock="Left" Background="#DBEAFE" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">

                                            <TextBlock Text="{Binding DateLabel}" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>

                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    </DockPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <TextBlock x:Name="txtNoEvents" Text="Chưa có sự kiện" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontStyle="Italic"

                                   Visibility="{Binding NoEventsVisibility}"/>

                    </StackPanel>

                </Border>



                <!-- Cảnh báo nhanh -->

                <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Background="#FEF3C7" CornerRadius="12" Padding="16" Margin="0,0,0,16">

                    <DockPanel>

                        <TextBlock DockPanel.Dock="Left" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel>

                            <TextBlock Text="Cảnh báo hệ thống" FontSize="13" FontWeight="Bold" Foreground="#92400E"/>

                            <TextBlock x:Name="txtAlerts" Text="{Binding AlertSummary}" FontSize="12" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        </StackPanel>

                    </DockPanel>

                </Border>

            </Grid>



            <!-- Bottom Section: Activities & Analytics -->

            <Grid Grid.Row="5">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="30"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>



                <!-- Recent Activities Section -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Hoạt Động Gần Đây" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="16" Padding="24" Effect="{StaticResource StaffCardShadow}" MinHeight="250">

                        <StackPanel>

                            <!-- ItemsControl for Recent Activities -->

                            <ItemsControl ItemsSource="{Binding RecentActivities}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,0,16">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="Auto" />

                                            </Grid.ColumnDefinitions>

                                            <Border Background="#DBEAFE" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center">

                                                <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#2563EB"/>

                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="14" />

                                                <TextBlock Text="{Binding FriendlyDetails}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="35" TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </StackPanel>



                <!-- Analytics Section -->

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Thống Kê Truyền Thông (Top 5 Bảng tin)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />

                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="16" Padding="24" Effect="{StaticResource StaffCardShadow}" MinHeight="250">

                        <StackPanel>

                            <ItemsControl ItemsSource="{Binding TopBulletins}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,0,16">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="Auto" />

                                            </Grid.ColumnDefinitions>

                                            

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">

                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Audience, StringFormat='Đối tượng: {0}'}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>

                                            </StackPanel>

                                            

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">

                                                <TextBlock Text="👁️" FontSize="14" Margin="0,0,5,0" Foreground="#64748B" VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding ViewCount}" FontWeight="Bold" Foreground="#334155" FontSize="14" VerticalAlignment="Center"/>

                                            </StackPanel>



                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                                <TextBlock Text="❤️" FontSize="14" Margin="0,0,5,0" Foreground="#EF4444" VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding LikeCount}" FontWeight="Bold" Foreground="#334155" FontSize="14" VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- Nhật ký Kiểm toán Bảo mật (Giai đoạn 2) -->
            <StackPanel Grid.Row="6" Margin="0,30,0,0">
                <TextBlock Text="🛡️ Nhật Ký Kiểm Toán Bảo Mật" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="16" Padding="24" Effect="{StaticResource StaffCardShadow}">
                    <StackPanel>
                        <!-- ItemsControl for Audit Logs Timeline -->
                        <ItemsControl ItemsSource="{Binding AuditLogsTimeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Timeline circle indicator -->
                                        <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" StrokeThickness="2" Stroke="#E2E8F0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Action}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" />
                                                <!-- Flag indicator -->
                                                <Border x:Name="flagBadge" Background="{Binding FlagBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="{Binding FlagVisibility}">
                                                    <TextBlock Text="{Binding FlagText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ActorInfo}" Foreground="#64748B" FontSize="11" FontStyle="Italic" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding TimestampString}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <TextBlock x:Name="txtNoAuditLogs" Text="Chưa có hoạt động kiểm toán hệ thống" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontStyle="Italic"
                                   Visibility="{Binding NoAuditLogsVisibility}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

    </ScrollViewer>

</UserControl>

