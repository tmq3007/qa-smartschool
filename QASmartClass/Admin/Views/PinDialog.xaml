<Window x:Class="QASmartClass.Admin.Views.PinDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Admin Authentication" Height="200" Width="300"

        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"

        Background="#0F172A" AllowsTransparency="True" FontFamily="Inter, Segoe UI">



    <Border BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="20">

        <StackPanel VerticalAlignment="Center">

            <TextBlock x:Name="lblTitle" Text="🔒 YÊU CẦU QUYỀN TRUY CẬP" Foreground="#10B981" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            

            <PasswordBox x:Name="txtPin" PasswordChar="•" FontSize="18" Padding="8,4" 

                         Background="#1E293B" Foreground="White" BorderBrush="#334155" 

                         HorizontalContentAlignment="Center" Margin="0,0,0,16" KeyDown="txtPin_KeyDown"/>

            

            <TextBlock x:Name="txtError" Text="Mã PIN không đúng!" Foreground="#EF4444" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8"/>

            

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="10"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="HỦY" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" Padding="0,8" Cursor="Hand" Click="Cancel_Click"/>

                <Button Grid.Column="2" x:Name="btnConfirm" Content="XÁC NHẬN" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="0,8" Cursor="Hand" Click="Confirm_Click"/>

            </Grid>

        </StackPanel>

    </Border>

</Window>

