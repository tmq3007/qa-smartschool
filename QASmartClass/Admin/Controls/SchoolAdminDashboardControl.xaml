<UserControl x:Class="QASmartClass.Admin.Controls.SchoolAdminDashboardControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             mc:Ignorable="d" 

             d:DesignHeight="700" d:DesignWidth="1000"

             Background="#0F172A" FontFamily="Inter, Segoe UI">



    <UserControl.Resources>

        <Style x:Key="KpiCardStyle" TargetType="Border">

            <Setter Property="Background" Value="#1E293B"/>

            <Setter Property="CornerRadius" Value="12"/>

            <Setter Property="Padding" Value="20"/>

            <Setter Property="Margin" Value="10"/>

            <Setter Property="BorderBrush" Value="#334155"/>

            <Setter Property="BorderThickness" Value="1"/>

        </Style>

        

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#94A3B8"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Margin" Value="0,0,20,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border Background="{TemplateBinding Background}" Padding="10,5" CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsChecked" Value="True">

                    <Setter Property="Foreground" Value="#38BDF8"/>

                    <Setter Property="Background" Value="#1E293B"/>

                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Foreground" Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="ActionButton" TargetType="Button">

            <Setter Property="Background" Value="#1E293B"/>

            <Setter Property="Foreground" Value="#38BDF8"/>

            <Setter Property="BorderBrush" Value="#334155"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="16,10"/>

            <Setter Property="Margin" Value="0,0,0,8"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" 

                                BorderBrush="{TemplateBinding BorderBrush}" 

                                BorderThickness="{TemplateBinding BorderThickness}" 

                                CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#334155"/>

                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>



    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

        <Grid MinWidth="960" MinHeight="600">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <Border Grid.Row="0" Background="#1E293B" Padding="20,15" BorderBrush="#334155" BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <Path Data="{StaticResource SchoolIcon}" Fill="White" Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="QUẢN TRỊ TRƯỜNG HỌC" Foreground="White" FontSize="20" FontWeight="Black"/>

                        <TextBlock Text="Trường THPT Mẫu - Giám sát tổng thể hệ thống" Foreground="#94A3B8" FontSize="14"/>

                    </StackPanel>

                </StackPanel>

                

                <Button Grid.Column="1" Content="Tải Lại Dữ Liệu" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="Bold" Cursor="Hand" Click="btnRefresh_Click"/>

            </Grid>

        </Border>



        <!-- KPI Cards -->

        <Grid Grid.Row="1" Margin="10,10,10,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Card 1 -->

            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">

                <StackPanel>

                    <TextBlock Text="Tổng Thiết Bị" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <TextBlock x:Name="txtTotalDevices" Text="120" Foreground="White" FontSize="32" FontWeight="Black"/>

                        <TextBlock Text="máy" Foreground="#94A3B8" FontSize="16" Margin="5,0,0,5" VerticalAlignment="Bottom"/>

                    </StackPanel>

                    <TextBlock Text="↑ 5 máy mới tuần này" Foreground="#10B981" FontSize="12" Margin="0,5,0,0"/>

                </StackPanel>

            </Border>



            <!-- Card 2 -->

            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">

                <StackPanel>

                    <TextBlock Text="Đang Hoạt Động" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <TextBlock x:Name="txtActiveDevices" Text="45" Foreground="#10B981" FontSize="32" FontWeight="Black"/>

                        <TextBlock Text="/ 120" Foreground="#94A3B8" FontSize="16" Margin="5,0,0,5" VerticalAlignment="Bottom"/>

                    </StackPanel>

                    <TextBlock Text="3 Phòng đang học" Foreground="#38BDF8" FontSize="12" Margin="0,5,0,0"/>

                </StackPanel>

            </Border>



            <!-- Card 3 -->

            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">

                <StackPanel>

                    <TextBlock Text="Tổng Giáo Viên" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <TextBlock x:Name="txtTotalTeachers" Text="24" Foreground="White" FontSize="32" FontWeight="Black"/>

                        <TextBlock Text="người" Foreground="#94A3B8" FontSize="16" Margin="5,0,0,5" VerticalAlignment="Bottom"/>

                    </StackPanel>

                    <TextBlock Text="Giờ giảng: 350h" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0"/>

                </StackPanel>

            </Border>



            <!-- Card 4 -->

            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">

                <StackPanel>

                    <TextBlock Text="Tổng Học Sinh" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <TextBlock x:Name="txtTotalStudents" Text="1,250" Foreground="White" FontSize="32" FontWeight="Black"/>

                        <TextBlock Text="HS" Foreground="#94A3B8" FontSize="16" Margin="5,0,0,5" VerticalAlignment="Bottom"/>

                    </StackPanel>

                    <TextBlock Text="30 Lớp" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>



        <!-- Main Content Panel (Sub-tabs) -->

        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Margin="20,10,20,20" BorderBrush="#334155" BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                

                <!-- Sub Tab Navigation -->

                <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,10">

                    <StackPanel Orientation="Horizontal">

                        <RadioButton IsChecked="True" GroupName="SchoolTabs" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ChartIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Báo cáo Sử Dụng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SchoolTabs" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource TeacherIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý Giáo Viên" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SchoolTabs" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource StudentIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý Học Sinh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SchoolTabs" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ComputerIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý Phòng Máy" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SchoolTabs" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GearIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cấu Hình" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="SchoolTabs" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ScrollIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Nhật ký Hệ thống" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="SchoolTabs" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" Tag="6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HeartPulseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sức khỏe Hệ thống" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>

                </Border>

                

                <!-- Content View -->

                <Grid Grid.Row="1" Margin="20">

                    <!-- Tab 0: Báo Cáo -->

                    <Grid x:Name="tabReport" Visibility="Visible">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="2*"/>

                            <ColumnDefinition Width="1*"/>

                        </Grid.ColumnDefinitions>

                        

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">

                            <TextBlock Text="Biểu Đồ Sử Dụng 7 Ngày Qua" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Border Background="#0F172A" Height="300" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">

                                <!-- Labeled Chart with Axes -->

                                <Grid Margin="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Y-Axis Labels -->
                                    <Grid Grid.Column="0" Margin="0,0,5,25">
                                        <TextBlock Text="100%" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                        <TextBlock Text="50%" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Text="0%" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                        <TextBlock Text="% Tương tác" FontFamily="Inter" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-15,0,0"/>
                                    </Grid>

                                    <!-- Chart Bars + X-Axis -->
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="25"/>
                                        </Grid.RowDefinitions>

                                        <!-- Bars -->
                                        <Grid Grid.Row="0" Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Grid lines -->
                                            <Border Grid.ColumnSpan="7" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Height="1" VerticalAlignment="Top"/>
                                            <Border Grid.ColumnSpan="7" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Height="1" VerticalAlignment="Center"/>
                                            <Border Grid.ColumnSpan="7" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Height="1" VerticalAlignment="Bottom"/>

                                            <Border Grid.Column="0" Background="#38BDF8" Width="24" Height="120" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/>
                                            <Border Grid.Column="1" Background="#38BDF8" Width="24" Height="180" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/>
                                            <Border Grid.Column="2" Background="#38BDF8" Width="24" Height="100" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/>
                                            <Border Grid.Column="3" Background="#38BDF8" Width="24" Height="220" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/>
                                            <Border Grid.Column="4" Background="#38BDF8" Width="24" Height="150" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/>
                                            <Border Grid.Column="5" Background="#38BDF8" Width="24" Height="70" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/>
                                            <Border Grid.Column="6" Background="#38BDF8" Width="24" Height="200" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/>
                                        </Grid>

                                        <!-- X-Axis -->
                                        <Border Grid.Row="1" BorderBrush="#334155" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Thứ 2" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Thứ 3" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Thứ 4" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="Thứ 5" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="Thứ 6" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="Thứ 7" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="CN" FontFamily="Inter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                            </Border>

                        </StackPanel>

                        

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Giáo Viên Áp Dụng Sư Phạm Đa Dạng" FontFamily="Inter" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Border Background="#0F172A" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">

                                <StackPanel>

                                    <TextBlock Text="1. Nguyễn Văn Hùng - 12 công cụ" FontFamily="Inter" Foreground="#10B981" FontWeight="Bold" Margin="0,5"/>

                                    <TextBlock Text="2. Trần Thị Mai - 10 công cụ" FontFamily="Inter" Foreground="White" Margin="0,5"/>

                                    <TextBlock Text="3. Lê Tuấn Anh - 8 công cụ" FontFamily="Inter" Foreground="White" Margin="0,5"/>

                                    <TextBlock Text="4. Phạm Văn Cường - 7 công cụ" FontFamily="Inter" Foreground="White" Margin="0,5"/>

                                    <TextBlock Text="5. Đỗ Thị Lan - 6 công cụ" FontFamily="Inter" Foreground="White" Margin="0,5"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>

                    

                    <!-- Tab 1: Giáo Viên -->

                    <Grid x:Name="tabTeacher" Visibility="Collapsed" Margin="20">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                            <Button Click="BtnAddTeacher_Click" Style="{StaticResource ActionButton}" Background="#10B981" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource PlusIcon}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thêm Giáo Viên Mới" FontFamily="Inter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BtnRefreshTeacher_Click" Style="{StaticResource ActionButton}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RefreshIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Làm mới" FontFamily="Inter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                        <DataGrid x:Name="dgTeachers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="White" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mã GV" Binding="{Binding TeacherCode}" Width="100"/>

                                <DataGridTextColumn Header="Họ Tên" Binding="{Binding FullName}" Width="200"/>

                                <DataGridTextColumn Header="Môn Học" Binding="{Binding Subject}" Width="150"/>

                                <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding Phone}" Width="150"/>

                                <DataGridTemplateColumn Header="Hành Động" Width="150">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Click="BtnEditTeacher_Click" Margin="0,0,5,0" Padding="5,2" Background="#3B82F6" Foreground="White" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource EditIcon}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Sửa" FontFamily="Inter" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>                                                <Button Click="BtnDeleteTeacher_Click" Padding="5,2" Background="#EF4444" Foreground="White" BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource CloseIcon}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Xóa" FontFamily="Inter" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>



                    <!-- Tab 2: Học Sinh -->

                    <Grid x:Name="tabStudent" Visibility="Collapsed" Margin="20">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                            <TextBox x:Name="txtSearchStudent" Width="200" Padding="5" Margin="0,0,10,0" ToolTip="Tìm kiếm (VD: Nguyễn)"/>
                            <Button Click="BtnSearchStudent_Click" Style="{StaticResource ActionButton}" Background="#3B82F6" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SearchIcon}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tìm" FontFamily="Inter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BtnImportExcel_Click" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Background="#10B981" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FolderIcon}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Import Excel" FontFamily="Inter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BtnDownloadTemplate_Click" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Background="#334155" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DownloadIcon}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tải Excel Mẫu" FontFamily="Inter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="dgStudents" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="White" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mã HS" Binding="{Binding StudentCode}" Width="100"/>

                                <DataGridTextColumn Header="Họ Tên" Binding="{Binding FullName}" Width="200"/>

                                <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="100"/>

                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>

                                <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="100"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                    <!-- Tab 4: Cấu Hình Hệ Thống -->
                    <Grid x:Name="tabSettings" Visibility="Collapsed" Margin="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Path Data="{StaticResource GearIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CẤU HÌNH THÔNG SỐ HỆ THỐNG" FontFamily="Inter" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Border Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Chế độ giám sát Sơ đồ phòng máy (Topology Sync Mode)" FontFamily="Inter" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock Text="Lưu ý: Lựa chọn chế độ quét phù hợp với băng thông và hiệu năng thực tế của phòng máy trường." FontFamily="Inter" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"/>
                                    
                                    <RadioButton x:Name="radActiveScan" Foreground="White" FontSize="13" Margin="0,5" GroupName="TopologyMode" ToolTip="[QUÉT CHỦ ĐỘNG] Thực hiện ping trực tiếp đến IP máy trạm để lấy trạng thái thời gian thực. Khuyến nghị: Sử dụng cho mạng LAN dây cáp ổn định.">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
