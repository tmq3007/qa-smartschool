                                    <TextBlock Text="Khoảng thời gian" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbLogPeriod" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="34" SelectedIndex="0">
                                        <ComboBoxItem Content="Hôm nay" Tag="Today"/>
                                        <ComboBoxItem Content="7 ngày qua" Tag="7Days"/>
                                        <ComboBoxItem Content="30 ngày qua" Tag="30Days"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Nút Lọc -->
                                <Button Grid.Column="3" Style="{StaticResource ActionButton}" Margin="10,16,0,0" Height="34" Padding="20,0" Click="BtnFilterAuditLogs_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SearchIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Lọc" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Nút Xuất file -->
                                <Button Grid.Column="4" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="10,16,0,0" Height="34" Padding="20,0" Click="BtnExportAuditLogs_Click" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource FolderIcon}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Xuất Báo Cáo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <!-- Bảng hiển thị DataGrid -->
                        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                            <DataGrid x:Name="dgAuditLogs" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" Background="#1E293B" RowBackground="#1E293B" AlternatingRowBackground="#162032"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                                      Foreground="White" HeadersVisibility="Column" MinRowHeight="38"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#0F172A"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#334155"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="150"/>
                                    <DataGridTextColumn Header="Người Thực Hiện" Binding="{Binding Actor}" Width="150"/>
                                    <DataGridTextColumn Header="Hành Động" Binding="{Binding Action}" Width="180"/>
                                    <DataGridTextColumn Header="Chi Tiết Sự Kiện" Binding="{Binding Details}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="MaxHeight" Value="60"/>
                                                <Setter Property="ToolTip" Value="{Binding Details}"/>
                                                <Setter Property="Padding" Value="5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Tab 3: Quản lý Phòng Máy (IT-Lab v4.1) -->
                    <Grid x:Name="tabComputerLab" Visibility="Collapsed" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel điều khiển và KPI phía trên -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Chọn phòng và Bộ lọc -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,15,0">
                                    <TextBlock Text="Chọn Phòng Máy" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cboLabRoom" Width="130" Height="34" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155" SelectionChanged="CboLabRoom_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Lọc trạng thái" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cboStatusFilter" Width="130" Height="34" Padding="6" Background="#0F172A" Foreground="White" BorderBrush="#334155" SelectedIndex="0" SelectionChanged="CboStatusFilter_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả máy" Tag="All"/>
                                        <ComboBoxItem Content="Đang Online" Tag="Online"/>
                                        <ComboBoxItem Content="Đang Offline" Tag="Offline"/>
                                        <ComboBoxItem Content="Đang Bảo trì" Tag="Faulty"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- KPI Cards nhỏ cho Phòng Máy -->
                            <UniformGrid Grid.Column="1" Rows="1" Columns="4" Margin="10,0,0,0">
                                <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="5,0" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Tổng Máy" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtLabTotal" Text="0" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="5,0" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Online" Foreground="#10B981" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtLabOnline" Text="0" Foreground="#10B981" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="5,0" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Offline" Foreground="#F87171" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtLabOffline" Text="0" Foreground="#F87171" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="5,0" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Bảo Trì" Foreground="#F59E0B" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtLabFaulty" Text="0" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>

                        <!-- Nội dung 2 cột -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cột trái: DataGrid máy trạm -->
                            <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,15,0">
                                <DataGrid x:Name="dgLabDevices" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#1E293B"
                                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                                          Foreground="White" HeadersVisibility="Column" MinRowHeight="36" SelectionChanged="DgLabDevices_SelectionChanged"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#334155"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#334155"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Máy" Binding="{Binding MachineId}" Width="110"/>
                                        <DataGridTextColumn Header="Tên Hiển Thị" Binding="{Binding DisplayName}" Width="160"/>
                                        <DataGridTextColumn Header="Loại Thiết Bị" Binding="{Binding NodeType}" Width="130"/>
                                        <DataGridTextColumn Header="Địa chỉ IP (LAN)" Binding="{Binding IpAddress}" Width="130"/>
                                        <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                                         <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                                             <Ellipse.Style>
                                                                 <Style TargetType="Ellipse">
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Status}" Value="Online">
                                                                             <Setter Property="Fill" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                             <Setter Property="Fill" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Status}" Value="Faulty">
                                                                             <Setter Property="Fill" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Ellipse.Style>
                                                         </Ellipse>
                                                         <TextBlock FontSize="12">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Status}" Value="Online">
                                                                             <Setter Property="Foreground" Value="#10B981"/>
                                                                             <Setter Property="Text" Value="Đang chạy"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                             <Setter Property="Foreground" Value="#EF4444"/>
                                                                             <Setter Property="Text" Value="Ngoại tuyến"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Status}" Value="Faulty">
                                                                             <Setter Property="Foreground" Value="#F59E0B"/>
                                                                             <Setter Property="Text" Value="Bảo trì"/>
                                                                         </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Cột phải: Lệnh điều khiển -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <!-- Card Máy đang chọn -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="ĐIỀU KHIỂN THIẾT BỊ" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="txtSelectedDeviceName" Text="Chưa chọn máy trạm" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="txtSelectedDeviceIp" Text="IP: ---.---.---.---" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,10"/>

                                        <Button Style="{StaticResource ActionButton}" Height="34" Margin="0,0,0,6" Click="BtnWOLSingle_Click"
                                                AutomationProperties.Name="Wake-on-LAN bật máy"
                                                AutomationProperties.HelpText="Gửi gói tin Magic Packet để bật máy trạm đang chọn">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Wake-on-LAN (Bật)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ActionButton}" Height="34" Margin="0,0,0,6" Click="BtnShutdownSingle_Click"
                                                AutomationProperties.Name="Tắt máy đang chọn"
                                                AutomationProperties.HelpText="Gửi lệnh tắt máy từ xa tới máy trạm đang chọn">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Shutdown (Tắt)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ActionButton}" Height="34" Margin="0,0,0,6" Click="BtnRestartSingle_Click"
                                                AutomationProperties.Name="Khởi động lại máy đang chọn"
                                                AutomationProperties.HelpText="Gửi lệnh khởi động lại từ xa tới máy trạm đang chọn">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Restart (Khởi động lại)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ActionButton}" Height="34" Margin="0,0,0,6" Click="BtnLockSingle_Click"
                                                AutomationProperties.Name="Khóa màn hình máy đang chọn"
                                                AutomationProperties.HelpText="Gửi lệnh khóa màn hình tới máy trạm đang chọn">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource LockIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Lock Screen (Khóa)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnToggleMaintenance" Style="{StaticResource ActionButton}" Height="34" Click="BtnToggleMaintenance_Click"
                                                AutomationProperties.Name="Vào Bảo Trì hoặc Mở Khóa máy đang chọn"
                                                AutomationProperties.HelpText="Bật hoặc tắt chế độ bảo trì cho máy trạm đang chọn">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GearIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Vào Bảo Trì / Mở Khóa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Card Điều khiển Đồng loạt -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ĐIỀU KHIỂN ĐỒNG LOẠT PHÒNG MÁY" Foreground="#EF4444" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                        
                                        <Button Style="{StaticResource ActionButton}" Height="34" Margin="0,0,0,6" Click="BtnWOLAll_Click"
                                                AutomationProperties.Name="Bật toàn bộ phòng máy"
                                                AutomationProperties.HelpText="Gửi gói tin Magic Packet tới toàn bộ các máy trạm trong phòng máy">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource BoltIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bật toàn bộ phòng máy" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ActionButton}" Height="34" Margin="0,0,0,6" Click="BtnShutdownAll_Click"
                                                AutomationProperties.Name="Tắt toàn bộ phòng máy"
                                                AutomationProperties.HelpText="Gửi lệnh tắt máy từ xa tới toàn bộ các máy trạm trong phòng máy">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tắt toàn bộ phòng máy" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ActionButton}" Height="34" Click="BtnLockAll_Click"
                                                AutomationProperties.Name="Khóa toàn bộ phòng máy"
                                                AutomationProperties.HelpText="Gửi lệnh khóa màn hình tới toàn bộ các máy trạm trong phòng máy">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource LockIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Khóa toàn bộ phòng máy" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Tab 6: Sức khỏe Hệ thống -->
                    <Grid x:Name="tabSystemHealth" Visibility="Collapsed" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Diagnostic Cards -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Chỉ số Sức khỏe &amp; Cấu hình Hệ thống" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                                <!-- Database Health Card -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Data="{StaticResource SaveIcon}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CƠ SỞ DỮ LIỆU &amp; LƯU TRỮ" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="160" MaxWidth="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Kích thước Cơ sở dữ liệu:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblDbSize" Grid.Row="0" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chế độ SQLite WAL:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblDbWalMode" Grid.Row="1" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="SQLite Busy Timeout:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblDbTimeout" Grid.Row="2" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tổng số bản ghi nhật ký:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblDbLogCount" Grid.Row="3" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Network Health Card -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Data="{StaticResource AntennaIcon}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ĐƯỜNG TRUYỀN &amp; TRÌNH CHIẾU" Foreground="#10B981" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="160" MaxWidth="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Địa chỉ IP Giáo viên:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblTeacherIp" Grid.Row="0" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Đường truyền Multicast:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblMulticastStatus" Grid.Row="1" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Định dạng nén luồng hình:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblCompressionFormat" Grid.Row="2" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Keep-Alive Timeout:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblKeepAliveTimeout" Grid.Row="3" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Security &amp; Sandbox Card -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Data="{StaticResource ShieldIcon}" Fill="#F59E0B" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="BẢO MẬT &amp; ĐỘC LẬP HỆ THỐNG" Foreground="#F59E0B" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="160" MaxWidth="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Chế độ Single Instance:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblSingleInstanceMode" Grid.Row="0" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Mã hóa bảo vệ cấu hình:" Foreground="#94A3B8" Margin="0,4"/>
                                            <TextBlock x:Name="lblConfigEncryption" Grid.Row="1" Grid.Column="1" Text="---" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Quick Actions Panel -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Thao tác nhanh IT-Admin" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Border Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <Button x:Name="btnOptimizeDb" Style="{StaticResource ActionButton}" Height="36" Click="BtnOptimizeDb_Click"
                                            AutomationProperties.Name="Tối ưu hóa cơ sở dữ liệu"
                                            AutomationProperties.HelpText="Chạy lệnh VACUUM để thu hồi dung lượng trống trong SQLite">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource BoltIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tối ưu hóa Database (Vacuum)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Thu hồi dung lượng trống, dọn phân mảnh SQLite." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Button x:Name="btnTestMulticast" Style="{StaticResource ActionButton}" Height="36" Click="BtnTestMulticast_Click"
                                            AutomationProperties.Name="Kiểm tra kết nối Multicast"
                                            AutomationProperties.HelpText="Kiểm tra gói tin UDP Multicast xem có bị tường lửa chặn không">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource SearchIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Test Cổng Multicast &amp; Ping" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Kiểm tra gói tin UDP Multicast, xem cổng có bị tường lửa chặn." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <Button x:Name="btnClearOldLogs" Style="{StaticResource ActionButton}" Height="36" Click="BtnClearOldLogs_Click"
                                            AutomationProperties.Name="Dọn dẹp nhật ký cũ"
                                            AutomationProperties.HelpText="Xóa các bản ghi nhật ký kiểm toán cũ hơn 30 ngày để tối ưu CSDL">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource TrashIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Dọn dẹp Nhật ký cũ (&gt;30 ngày)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Xóa các log kiểm toán quá hạn để giữ CSDL tinh gọn." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Mock tab for unfinished pages -->
                    <TextBlock x:Name="tabMock" Text="Tính năng đang được phát triển..." Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ScrollViewer>
</UserControl>
