<UserControl x:Class="QASmartClass.Admin.Controls.SchoolDirectorDashboard"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             Background="#F1F5F9">

    

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">

        <StackPanel MaxWidth="1200" HorizontalAlignment="Center">

            

            <!-- Header Section -->

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,24">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.05" Color="Black"/>

                </Border.Effect>

                <DockPanel>

                    <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="16" Margin="0,0,16,0">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="#0F172A" Offset="0"/>

                                <GradientStop Color="#334155" Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                        <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="28" 

                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Dashboard Ban Giám Hiệu" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>

                        <TextBlock Text="Tổng quan tình hình sử dụng QA SmartClass toàn trường" FontSize="14" Foreground="#64748B"/>

                    </StackPanel>

                    

                    <Button Content="📄 Xuất Báo Cáo" DockPanel.Dock="Right" HorizontalAlignment="Right"

                            Background="#3B82F6" Foreground="White" Padding="16,10" BorderThickness="0" 

                            Cursor="Hand" FontWeight="SemiBold" Click="ExportReport_Click"/>

                </DockPanel>

            </Border>



            <!-- KPI Cards -->

            <UniformGrid Columns="4" Margin="0,0,0,24">

                <!-- KPI 1 -->

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0">

                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Tỷ lệ GV sử dụng" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtUsageRate" Text="85%" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" Margin="0,8,0,0"/>

                        <TextBlock Text="↑ 12% so với tháng trước" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <!-- KPI 2 -->

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0">

                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Điểm TB Toàn trường" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtAvgScore" Text="7.8" FontSize="32" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,8,0,0"/>

                        <TextBlock Text="Dựa trên 1,200 bài kiểm tra" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <!-- KPI 3 -->

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0">

                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Bài giảng mới tháng này" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtNewLessons" Text="142" FontSize="32" FontWeight="Bold" Foreground="#10B981" Margin="0,8,0,0"/>

                        <TextBlock Text="↑ 24 bài so với tháng trước" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <!-- KPI 4 -->

                <Border Background="White" CornerRadius="12" Padding="20">

                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Tổng giờ giảng dạy" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtTotalHours" Text="3,450" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" Margin="0,8,0,0"/>

                        <TextBlock Text="Bao gồm cả phiên tương tác" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

            </UniformGrid>



            <!-- Main Content Area -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>



                <!-- Left Column: Activity Chart -->

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0" MinHeight="350">

                    <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.05" Color="Black"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Tần suất sử dụng theo Tuần" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,20"/>

                        <Grid Height="250">

                            <!-- Background Grid Lines -->

                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" VerticalAlignment="Center" Margin="0,0,0,125"/>

                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" VerticalAlignment="Top"/>

                            

                            <!-- Fake Chart Data using native WPF -->

                            <ItemsControl x:Name="chartUsage">

                                <ItemsControl.ItemsPanel>

                                    <ItemsPanelTemplate>

                                        <UniformGrid Rows="1"/>

                                    </ItemsPanelTemplate>

                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid>

                                            <Border Width="40" Height="{Binding ChartHeight}" VerticalAlignment="Bottom"

                                                    CornerRadius="4,4,0,0" Margin="10,0">

                                                <Border.Background>

                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                                                        <GradientStop Color="#3B82F6" Offset="0"/>

                                                        <GradientStop Color="#60A5FA" Offset="1"/>

                                                    </LinearGradientBrush>

                                                </Border.Background>

                                            </Border>

                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#64748B"

                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Grid>

                    </StackPanel>

                </Border>



                <!-- Right Column: Top Teachers -->

                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">

                    <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.05" Color="Black"/></Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Giáo viên tích cực nhất" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>

                        <ItemsControl x:Name="listTopTeachers">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,12">

                                        <DockPanel>

                                            <Border Width="36" Height="36" CornerRadius="18" Background="#E2E8F0" Margin="0,0,12,0" DockPanel.Dock="Left">

                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                            <StackPanel VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A"/>

                                                <TextBlock Text="{Binding Subject}" FontSize="11" Foreground="#64748B"/>

                                            </StackPanel>

                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Hours}" FontWeight="Bold" Foreground="#3B82F6" 

                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        </DockPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </Grid>



        </StackPanel>

    </ScrollViewer>

</UserControl>

