<Window x:Class="QASmartClass.Admin.Controls.AdminRequestOverlay"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Yêu cầu từ Admin" Height="250" Width="450"

        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"

        Background="#CC0F172A" AllowsTransparency="True" FontFamily="Segoe UI" Topmost="True">

    

    <Border BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="12" Background="#1E293B" Padding="24">

        <StackPanel VerticalAlignment="Center">

            <!-- Header -->

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">

                <TextBlock Text="⚠️" FontSize="24" Margin="0,0,8,0"/>

                <TextBlock Text="YÊU CẦU CHUYỂN CHẾ ĐỘ" Foreground="#F59E0B" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>

            </StackPanel>

            

            <!-- Message -->

            <TextBlock x:Name="txtMessage" Text="Quản trị viên (Admin) đang yêu cầu chuyển màn hình. Bạn có đồng ý không?" 

                       Foreground="White" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

            

            <!-- Countdown -->

            <TextBlock x:Name="txtCountdown" Text="Tự động hủy sau: 60s" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            

            <!-- Buttons -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnReject" Content="TỪ CHỐI" Background="#334155" Foreground="White" BorderThickness="0" Padding="0,10" FontWeight="Bold" Cursor="Hand" Click="Reject_Click"/>

                <Button Grid.Column="2" x:Name="btnAccept" Content="CHẤP NHẬN" Background="#10B981" Foreground="White" BorderThickness="0" Padding="0,10" FontWeight="Bold" Cursor="Hand" Click="Accept_Click"/>

            </Grid>

        </StackPanel>

    </Border>

</Window>

