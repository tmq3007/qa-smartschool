<UserControl x:Class="QASmartClass.Admin.Controls.NetworkTopologyControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             mc:Ignorable="d" 

             d:DesignHeight="600" d:DesignWidth="800"

             Background="#0F172A" FontFamily="Segoe UI">



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="60"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- TOOLBAR -->

        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                

                <StackPanel Orientation="Horizontal" Grid.Column="0">

                    <TextBlock Text="🏢 Phòng:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox x:Name="cboRooms" Width="150" Height="30" SelectionChanged="cboRooms_SelectionChanged" 

                              Background="#0F172A" Foreground="White" BorderBrush="#334155"/>

                              

                    <Border Width="1" Background="#334155" Margin="15,5"/>

                    

                    <ToggleButton x:Name="btnEditMode" Content="Sửa Sơ Đồ" Height="30" Padding="15,0" 

                                  Background="#334155" Foreground="White" BorderThickness="0" Click="btnEditMode_Click"/>

                </StackPanel>

                

                <StackPanel Orientation="Horizontal" Grid.Column="2" x:Name="panelEditTools" Visibility="Collapsed">

                    <Button Content="Sắp xếp tự động" Height="30" Padding="15,0" Margin="0,0,10,0" 

                            Background="#334155" Foreground="White" BorderThickness="0" Click="btnAutoLayout_Click"/>

                    <Button Content="Xuất PNG" Height="30" Padding="15,0" Margin="0,0,10,0" 

                            Background="#334155" Foreground="White" BorderThickness="0" Click="btnExportPng_Click"/>

                    <Button Content="LƯU SƠ ĐỒ" Height="30" Padding="15,0" 

                            Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="btnSave_Click"/>

                </StackPanel>

            </Grid>

        </Border>



        <!-- TOPOLOGY CANVAS -->

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

            <Canvas x:Name="DrawCanvas" Width="2000" Height="1500" Background="#0F172A"

                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"

                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"

                    MouseMove="Canvas_MouseMove"/>

        </ScrollViewer>



        <!-- INFO PANEL -->

        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="15" x:Name="panelInfo" Visibility="Collapsed">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                

                <Border Width="50" Height="50" CornerRadius="25" x:Name="infoStatusColor" Background="#4CAF50" VerticalAlignment="Center" Margin="0,0,15,0"/>

                

                <StackPanel Grid.Column="1">

                    <TextBlock x:Name="txtInfoName" Text="Máy PC-01" Foreground="White" FontSize="18" FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                        <TextBlock Text="Trạng thái: " Foreground="#94A3B8"/>

                        <TextBlock x:Name="txtInfoStatus" Text="Đang Online" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,15,0"/>

                        

                        <TextBlock Text="IP: " Foreground="#94A3B8"/>

                        <TextBlock x:Name="txtInfoIp" Text="192.168.1.50" Foreground="White" Margin="0,0,15,0"/>

                        

                        <TextBlock Text="Học sinh: " Foreground="#94A3B8"/>

                        <TextBlock x:Name="txtInfoStudent" Text="Nguyễn Văn A" Foreground="White"/>

                    </StackPanel>
                    
                    <StackPanel x:Name="panelTroubleshoot" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="🛠️ HƯỚNG DẪN KHẮC PHỤC SỰ CỐ TỪNG BƯỚC:" Foreground="#F59E0B" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="txtTroubleshootGuide" Text="1. Kiểm tra nguồn..." Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12" LineHeight="18"/>
                    </StackPanel>
                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>

