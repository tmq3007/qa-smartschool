<Window x:Class="QASmartTouch.Forms.AboutDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Giới thiệu QA SmartTouch"

        WindowStyle="None" AllowsTransparency="True" Background="Transparent"

        WindowStartupLocation="CenterOwner"

        Width="480" Height="520"

        ResizeMode="NoResize"

        ShowInTaskbar="False">

    

    <Border CornerRadius="12" Background="#1A1A2E" BorderBrush="#2E86DE" BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="#2E86DE"/>

        </Border.Effect>

        

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <!-- Title Bar -->

            <Border Grid.Row="0" Background="#16213E" CornerRadius="12,12,0,0" 

                    Padding="16,10" MouseLeftButtonDown="TitleBar_MouseDown">

                <Grid>

                    <TextBlock Text="Giới thiệu" Foreground="#8E9AAF" FontSize="12"/>

                    <Button Content="✕" HorizontalAlignment="Right" 

                            Width="28" Height="28" FontSize="14"

                            Background="Transparent" Foreground="#8E9AAF" 

                            BorderThickness="0" Cursor="Hand"

                            Click="CloseButton_Click">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Foreground" Value="#E74C3C"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </Grid>

            </Border>



            <!-- Content -->

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,20,30,10">

                <StackPanel>

                    <!-- Logo -->

                    <Border Width="80" Height="80" CornerRadius="18" 

                            Background="#2E86DE" HorizontalAlignment="Center" Margin="0,0,0,16">

                        <TextBlock Text="✏️" FontSize="40" 

                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>



                    <!-- App Name -->

                    <TextBlock Text="QA SmartTouch" FontSize="26" FontWeight="Bold" 

                               Foreground="White" HorizontalAlignment="Center"/>

                    <TextBlock Text="Bảng trắng tương tác thông minh" FontSize="12"

                               Foreground="#8E9AAF" HorizontalAlignment="Center" 

                               FontStyle="Italic" Margin="0,2,0,12"/>



                    <!-- Version Info -->

                    <Border Background="#16213E" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition/>

                                <RowDefinition/>

                                <RowDefinition/>

                                <RowDefinition/>

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Phiên bản" Foreground="#8E9AAF" FontSize="11"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbVersion" Text="3.0.0" 

                                       Foreground="#2E86DE" FontSize="11" FontWeight="SemiBold"/>



                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nền tảng" Foreground="#8E9AAF" FontSize="11" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="1" Text="WPF / .NET 8.0" 

                                       Foreground="White" FontSize="11" Margin="0,4,0,0"/>



                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ngày phát hành" Foreground="#8E9AAF" FontSize="11" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbBuildDate" Text="04/2026" 

                                       Foreground="White" FontSize="11" Margin="0,4,0,0"/>



                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Hệ điều hành" Foreground="#8E9AAF" FontSize="11" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="tbOS" Text="Windows 10/11" 

                                       Foreground="White" FontSize="11" Margin="0,4,0,0"/>

                        </Grid>

                    </Border>



                    <!-- Features -->

                    <TextBlock Text="TÍNH NĂNG CHÍNH" Foreground="#2E86DE" FontSize="11" 

                               FontWeight="Bold" Margin="0,0,0,8"/>

                    

                    <WrapPanel Margin="0,0,0,16">

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="✏️ Viết tay" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="🔤 OCR AI" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="🌐 Dịch 100+ ngôn ngữ" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="🔊 Text-to-Speech" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="📐 Thước + Compa 3D" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="📊 Biểu đồ" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="🧊 Hình 3D" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="🧪 STEM Tools" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                        <Border Background="#16213E" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">

                            <TextBlock Text="🎥 Quay màn hình" Foreground="#8E9AAF" FontSize="10"/>

                        </Border>

                    </WrapPanel>



                    <!-- Credits -->

                    <TextBlock Text="NHÀ PHÁT TRIỂN" Foreground="#2E86DE" FontSize="11" 

                               FontWeight="Bold" Margin="0,0,0,8"/>

                    

                    <TextBlock Foreground="#8E9AAF" FontSize="11" LineHeight="20">

                        <Run Text="QA Smart School JSC" FontWeight="SemiBold" Foreground="White"/>

                        <LineBreak/>

                        <Run Text="Giải pháp trường học thông minh tích hợp AI"/>

                        <LineBreak/>

                        <Run Text="🌐 qasmartschool.edu.vn"/>

                        <LineBreak/>

                        <Run Text="📧 support@qasmartschool.edu.vn"/>

                    </TextBlock>

                </StackPanel>

            </ScrollViewer>



            <!-- Footer -->

            <Border Grid.Row="2" Background="#16213E" CornerRadius="0,0,12,12" Padding="20,12">

                <TextBlock Text="© 2026 QA Smart School. All rights reserved." 

                           Foreground="#4A5568" FontSize="10" HorizontalAlignment="Center"/>

            </Border>

        </Grid>

    </Border>

</Window>

