<Window x:Class="QASmartTouch.Forms.Form2_7_3DTetrahedronEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chức năng vẽ hình tứ diện 3D (Tetrahedron)" 
        Height="720" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Label Text Style -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern TabItem Style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="#ECEFF1" 
                                CornerRadius="8,8,0,0" 
                                Margin="0,0,4,0" 
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1,1,1,0"
                                BorderBrush="#CFD8DC">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,3,1,0"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset View Button Style -->
        <Style x:Key="PresetViewButton" TargetType="Button">
            <Setter Property="Background" Value="#F0F4F8"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Footer Action Button Styles -->
        <Style x:Key="FooterConfirmButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterCloseButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterSecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEFF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterInfoButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0277BD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="60"/>
            <!-- 1: Main Content -->
            <RowDefinition Height="*"/>
            <!-- 2: Fixed Footer Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="20,10" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <!-- Tetrahedron Icon -->
                            <Path Data="M12,2 L21,19 L3,19 Z" Fill="#2196F3" Opacity="0.3"/>
                            <Path Data="M12,2 L12,14 L3,19 Z" Fill="#64B5F6"/>
                            <Path Data="M12,2 L12,14 L21,19 Z" Fill="#1976D2"/>
                            <Path Data="M3,19 L12,14 L21,19 Z" Fill="#1565C0"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Chức năng vẽ hình tứ diện 3D (Tetrahedron)" 
                                   FontSize="17" 
                                   FontWeight="Bold" 
                                   Foreground="#212121"/>
                        <TextBlock Text="Công cụ hỗ trợ giảng dạy hình học không gian trực quan" 
                                   FontSize="12" 
                                   Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top-Right Close Button -->
                <Button Grid.Column="1" 
                        Content="✕" 
                        Width="36" Height="36" 
                        FontSize="16" 
                        FontWeight="Bold"
                        Background="Transparent" 
                        Foreground="#757575"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="BtnClose_Click"
                        ToolTip="Đóng cửa sổ">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="15,12,15,10">
            <Grid.ColumnDefinitions>
                <!-- Left: Canvas Area -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Tabs Control Panel -->
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CANVAS AREA -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#CFD8DC" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="0,0,10,0">
                <Grid ClipToBounds="True">
                    <!-- 3D Drawing Canvas with Direct Touch / Mouse Drag -->
                    <Canvas x:Name="TetrahedronCanvas" 
                            Background="Transparent"
                            ClipToBounds="True"
                            Cursor="SizeAll"
                            MouseDown="TetrahedronCanvas_MouseDown"
                            MouseMove="TetrahedronCanvas_MouseMove"
                            MouseUp="TetrahedronCanvas_MouseUp"
                            MouseLeave="TetrahedronCanvas_MouseLeave"
                            TouchDown="TetrahedronCanvas_TouchDown"
                            TouchMove="TetrahedronCanvas_TouchMove"
                            TouchUp="TetrahedronCanvas_TouchUp"
                            TouchLeave="TetrahedronCanvas_TouchUp"
                            MouseWheel="TetrahedronCanvas_MouseWheel"/>

                    <!-- Floating Touch Hint Badge -->
                    <Border HorizontalAlignment="Center" 
                            VerticalAlignment="Bottom"
                            Background="#D9263238" 
                            CornerRadius="16" 
                            Padding="16,7" 
                            Margin="0,0,0,14"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖐️ Chạm &amp; kéo trực tiếp trên hình để xoay 3D" 
                                       FontSize="12" 
                                       Foreground="White" 
                                       FontWeight="Medium"/>
                            <TextBlock Text="  •  " FontSize="12" Foreground="#B0BEC5"/>
                            <TextBlock Text="🔍 Lăn chuột để phóng to / thu nhỏ" 
                                       FontSize="12" 
                                       Foreground="#ECEFF1" 
                                       FontWeight="Normal"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: TABBED CONTROL PANEL -->
            <Border Grid.Column="1" 
                    Background="White" 
                    BorderBrush="#CFD8DC" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="10">
                <TabControl BorderThickness="0" Background="Transparent">
                    
                    <!-- TAB 1: KÍCH THƯỚC & LOẠI TỨ DIỆN -->
                    <TabItem Header="📏 Kích thước" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- STATS PANEL -->
                                <Border Background="#FFF8E1" 
                                        BorderBrush="#FFB300" 
                                        BorderThickness="0,0,0,3" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📊 Thông số tứ diện hiện tại:" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#E65100"
                                                   Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Loại tứ diện:" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtType" Text="Tứ diện đều" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Độ dài cạnh (a):" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtEdgeLength" Text="150 đơn vị" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Chiều cao (h):" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtHeight" Text="122.47 đơn vị" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Bán kính ngoại tiếp (R):" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtOuterRadius" Text="91.86 đơn vị" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Bán kính nội tiếp (r):" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtInnerRadius" Text="30.62 đơn vị" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6" Background="#FFE082"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Diện tích 1 mặt:" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtFaceArea" Text="9,742.79 đơn vị²" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Diện tích toàn phần:" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtTotalArea" Text="38,971.14 đơn vị²" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="• Thể tích:" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock x:Name="txtVolume" Text="398,486.68 đơn vị³" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- TYPE SELECTION -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🔺 Kiểu hình tứ diện" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <UniformGrid Rows="2" Columns="2">
                                            <Button x:Name="btnRegular" Content="Tứ diện đều" 
                                                    Margin="0,0,4,6" Click="TypeButton_Click"
                                                    Style="{StaticResource PresetViewButton}"
                                                    Tag="regular"/>
                                            <Button x:Name="btnRight" Content="Tứ diện vuông" 
                                                    Margin="4,0,0,6" Click="TypeButton_Click"
                                                    Style="{StaticResource PresetViewButton}"
                                                    Tag="right"/>
                                            <Button x:Name="btnIsosceles" Content="Tứ diện cân" 
                                                    Margin="0,0,4,0" Click="TypeButton_Click"
                                                    Style="{StaticResource PresetViewButton}"
                                                    Tag="isosceles"/>
                                            <Button x:Name="btnCustom" Content="Tùy chỉnh" 
                                                    Margin="4,0,0,0" Click="TypeButton_Click"
                                                    Style="{StaticResource PresetViewButton}"
                                                    Tag="custom"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- DIMENSION CONTROLS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📐 Kích thước cạnh &amp; Tỉ lệ" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <!-- Edge Length -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Độ dài cạnh (a):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblEdgeLengthValue" Text="150" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="EdgeLengthSlider" 
                                                Minimum="50" Maximum="250" Value="150" 
                                                TickFrequency="10" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="SizeSlider_ValueChanged"/>

                                        <!-- Scale -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Tỉ lệ phóng to:" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblScaleValue" Text="1.0x" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="ScaleSlider" 
                                                Minimum="0.5" Maximum="2.0" Value="1.0" 
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,4"
                                                ValueChanged="SizeSlider_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: HIỂN THỊ & MÀU SẮC -->
                    <TabItem Header="🎨 Hiển thị &amp; Màu" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- DRAWING MODE -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🖼️ Chế độ vẽ &amp; Màu mặt" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Chế độ hiển thị:" Style="{StaticResource LabelText}"/>
                                            <ComboBox x:Name="cboDrawMode" FontSize="11" Width="170" HorizontalAlignment="Right"
                                                      SelectionChanged="DrawMode_Changed">
                                                <ComboBoxItem Content="Wireframe (Khung dây)" Tag="Wireframe"/>
                                                <ComboBoxItem Content="Solid (Tô màu)" Tag="Solid"/>
                                                <ComboBoxItem Content="Cả hai (Solid + Wireframe)" Tag="Both" IsSelected="True"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Chế độ màu sắc:" Style="{StaticResource LabelText}"/>
                                            <ComboBox x:Name="cboColorMode" FontSize="11" Width="170" HorizontalAlignment="Right"
                                                      SelectionChanged="ColorMode_Changed">
                                                <ComboBoxItem Content="Đơn sắc" Tag="Solid"/>
                                                <ComboBoxItem Content="Đa sắc (4 màu)" Tag="Multi" IsSelected="True"/>
                                                <ComboBoxItem Content="Gradient" Tag="Gradient"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- 4 Face Colors -->
                                        <StackPanel x:Name="pnlMultiColor" Margin="0,0,0,8">
                                            <UniformGrid Columns="2" Rows="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,4,6">
                                                    <TextBlock Text="Mặt 1:" Style="{StaticResource LabelText}" Width="45"/>
                                                    <ComboBox x:Name="cboColor1" FontSize="11" Width="110" SelectionChanged="FaceColor_Changed">
                                                        <ComboBoxItem Content="Đỏ nhạt" Tag="#FF6B6B" IsSelected="True"/>
                                                        <ComboBoxItem Content="Xanh lam" Tag="#4ECDC4"/>
                                                        <ComboBoxItem Content="Vàng" Tag="#FFD93D"/>
                                                        <ComboBoxItem Content="Xanh lá" Tag="#95E1D3"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                                    <TextBlock Text="Mặt 2:" Style="{StaticResource LabelText}" Width="45"/>
                                                    <ComboBox x:Name="cboColor2" FontSize="11" Width="110" SelectionChanged="FaceColor_Changed">
                                                        <ComboBoxItem Content="Đỏ nhạt" Tag="#FF6B6B"/>
                                                        <ComboBoxItem Content="Xanh lam" Tag="#4ECDC4" IsSelected="True"/>
                                                        <ComboBoxItem Content="Vàng" Tag="#FFD93D"/>
                                                        <ComboBoxItem Content="Xanh lá" Tag="#95E1D3"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                                    <TextBlock Text="Mặt 3:" Style="{StaticResource LabelText}" Width="45"/>
                                                    <ComboBox x:Name="cboColor3" FontSize="11" Width="110" SelectionChanged="FaceColor_Changed">
                                                        <ComboBoxItem Content="Đỏ nhạt" Tag="#FF6B6B"/>
                                                        <ComboBoxItem Content="Xanh lam" Tag="#4ECDC4"/>
                                                        <ComboBoxItem Content="Vàng" Tag="#FFD93D" IsSelected="True"/>
                                                        <ComboBoxItem Content="Xanh lá" Tag="#95E1D3"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                                    <TextBlock Text="Mặt 4:" Style="{StaticResource LabelText}" Width="45"/>
                                                    <ComboBox x:Name="cboColor4" FontSize="11" Width="110" SelectionChanged="FaceColor_Changed">
                                                        <ComboBoxItem Content="Đỏ nhạt" Tag="#FF6B6B"/>
                                                        <ComboBoxItem Content="Xanh lam" Tag="#4ECDC4"/>
                                                        <ComboBoxItem Content="Vàng" Tag="#FFD93D"/>
                                                        <ComboBoxItem Content="Xanh lá" Tag="#95E1D3" IsSelected="True"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>

                                        <!-- Opacity -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Độ trong suốt màu mặt:" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblOpacityValue" Text="90%" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="90" 
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,8"
                                                ValueChanged="OpacitySlider_ValueChanged"/>

                                        <CheckBox x:Name="chkEnableLighting" Content="Bật ánh sáng động" FontSize="11" 
                                                  IsChecked="True" Checked="Lighting_Changed" Unchecked="Lighting_Changed" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="chkBackfaceCulling" Content="Ẩn mặt sau (Backface Culling)" FontSize="11" 
                                                  IsChecked="True" Checked="BackfaceCulling_Changed" Unchecked="BackfaceCulling_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- EXTRA DISPLAY OPTIONS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="👁️ Tùy chọn chi tiết nét &amp; đỉnh" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <UniformGrid Columns="2" Rows="3" Margin="0,0,0,8">
                                            <CheckBox x:Name="chkShowEdges" Content="Hiển thị cạnh" FontSize="11" 
                                                      IsChecked="True" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,2"/>
                                            <CheckBox x:Name="chkShowVertices" Content="Hiển thị đỉnh" FontSize="11" 
                                                      IsChecked="False" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,2"/>
                                            <CheckBox x:Name="chkShowLabels" Content="Hiển thị nhãn đỉnh" FontSize="11" 
                                                      IsChecked="False" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,2"/>
                                            <CheckBox x:Name="chkShowAxis" Content="Trục tọa độ X,Y,Z" FontSize="11" 
                                                      Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,2"/>
                                            <CheckBox x:Name="chkShowFaceEdges" Content="Viền mặt" FontSize="11" 
                                                      Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,2"/>
                                            <CheckBox x:Name="chkShowNormals" Content="Vector pháp tuyến" FontSize="11" 
                                                      Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" Margin="0,2"/>
                                        </UniformGrid>

                                        <!-- Edge Width -->
                                        <Grid Margin="0,2,0,2">
                                            <TextBlock Text="Độ dày cạnh:" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblEdgeWidthValue" Text="2px" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="EdgeWidthSlider" Minimum="1" Maximum="5" Value="2" 
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Margin="0,2,0,6"
                                                ValueChanged="EdgeWidth_ValueChanged"/>

                                        <!-- Vertex Size -->
                                        <Grid Margin="0,2,0,2">
                                            <TextBlock Text="Kích thước đỉnh:" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblVertexSizeValue" Text="6px" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="VertexSizeSlider" Minimum="3" Maximum="12" Value="6" 
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Margin="0,2,0,2"
                                                ValueChanged="VertexSize_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: GÓC XOAY & QUAN SÁT -->
                    <TabItem Header="🔄 Góc xoay" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- PRESET VIEWS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Góc nhìn chuẩn nhanh" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <UniformGrid Columns="2" Rows="2">
                                            <Button Content="👁️ Chính diện" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="0,0,4,6"
                                                    Click="BtnPresetFront_Click"
                                                    ToolTip="Góc nhìn thẳng trực diện"/>
                                            <Button Content="📐 Phối cảnh 30°" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="4,0,0,6"
                                                    Click="BtnPresetPerspective_Click"
                                                    ToolTip="Góc nhìn phối cảnh sư phạm trực quan"/>
                                            <Button Content="🔝 Từ trên xuống" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="0,0,4,0"
                                                    Click="BtnPresetTop_Click"
                                                    ToolTip="Góc nhìn từ đỉnh xuống đáy"/>
                                            <Button Content="🧊 Đẳng cự 30°" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="4,0,0,0"
                                                    Click="BtnPresetIsometric_Click"
                                                    ToolTip="Góc nhìn đẳng cự kỹ thuật"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- ROTATION SLIDERS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🔄 Điều chỉnh góc xoay" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="#37474F"/>
                                            <CheckBox x:Name="chkAutoRotate" 
                                                      Content="Tự động xoay" 
                                                      FontSize="12"
                                                      Foreground="#1976D2"
                                                      FontWeight="SemiBold"
                                                      HorizontalAlignment="Right"
                                                      Checked="AutoRotate_Changed"
                                                      Unchecked="AutoRotate_Changed"/>
                                        </Grid>

                                        <!-- Auto Speed -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Tốc độ tự động xoay:" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblAutoSpeedValue" Text="1.0x" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="AutoSpeedSlider" Minimum="0.1" Maximum="3.0" Value="1.0" 
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="AutoSpeedSlider_ValueChanged"/>

                                        <!-- Rotation X -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Xoay trục X (Nghiêng lên/xuống):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblRotXValue" Text="-20°" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="RotXSlider" Minimum="-180" Maximum="180" Value="-20" 
                                                TickFrequency="15" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="RotationSlider_ValueChanged"/>

                                        <!-- Rotation Y -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Xoay trục Y (Quay trái/phải):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblRotYValue" Text="30°" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="RotYSlider" Minimum="-180" Maximum="180" Value="30" 
                                                TickFrequency="15" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="RotationSlider_ValueChanged"/>

                                        <!-- Rotation Z -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Xoay trục Z (Nghiêng mặt phẳng):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="lblRotZValue" Text="0°" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="RotZSlider" Minimum="-180" Maximum="180" Value="0" 
                                                TickFrequency="15" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,4"
                                                ValueChanged="RotationSlider_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- FOOTER: FIXED ACTION BAR (Không bao giờ bị cuộn) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="15,10">
            <Grid>
                <!-- Trái: Các nút tính năng phụ trợ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="btnReset"
                            Content="🔄 Đặt lại mặc định"
                            Style="{StaticResource FooterSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="BtnReset_Click"
                            ToolTip="Đặt lại tất cả kích thước và góc nhìn về ban đầu"/>

                    <Button x:Name="btnDownload"
                            Content="💾 Tải ảnh PNG"
                            Style="{StaticResource FooterSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="BtnDownload_Click"
                            ToolTip="Xuất hình khối tứ diện ra file ảnh chất lượng cao lưu vào máy"/>

                    <Button x:Name="btnDisplayStats"
                            Content="📋 Chèn kèm bảng thông số"
                            Style="{StaticResource FooterInfoButton}"
                            Click="btnDisplayStats_Click"
                            ToolTip="Chèn hình tứ diện kèm theo bảng chi tiết diện tích &amp; thể tích vào bài giảng"/>
                </StackPanel>

                <!-- Phải: Các nút hành động chính (To, rõ, thân thiện cảm ứng) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnClose"
                            Content="❌ Hủy bỏ"
                            Style="{StaticResource FooterCloseButton}"
                            Margin="0,0,10,0"
                            Click="BtnClose_Click"/>

                    <Button x:Name="btnConfirm"
                            Content="✅ Xác nhận chèn vào bảng"
                            Style="{StaticResource FooterConfirmButton}"
                            Click="BtnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
