<Window x:Class="QASmartTouch.Forms.FloatingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA SmartClass - DESKTOP Mode"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource InterFont}">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C5CAE9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C6BC0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9FA8DA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style (for active state) -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5C6BC0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C6BC0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C5CAE9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C6BC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <!-- Khung viền chính của Toolbar có hỗ trợ Animation Scale để bung tràn ra mượt mà -->
        <Border x:Name="mainBorder"
                Background="#E8EAF6" 
                CornerRadius="14"
                BorderBrush="#5C6BC0"
                BorderThickness="2"
                Padding="6"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="toolbarScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect Color="#263238"
                                  Direction="270"
                                  Opacity="0.3"
                                  BlurRadius="12"
                                  ShadowDepth="3"/>
            </Border.Effect>

            <!-- Panel công cụ: Hỗ trợ linh hoạt chuyển đổi Dọc (Vertical) hoặc Ngang (Horizontal) -->
            <StackPanel x:Name="toolsPanel" Orientation="Vertical">
                <!-- Exit Window Mode Button -->
                <Button x:Name="btnExit"
                        ToolTip="Thoát chế độ DESKTOP"
                        Click="btnExit_Click"
                        Margin="0,0,0,6"
                        Width="48" Height="44"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#BF616A" CornerRadius="10" x:Name="border">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#FFFFFF" 
                                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#D0717B"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#A54F57"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Pen Tool -->
                <Button x:Name="btnPen"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Bút vẽ"
                        Click="btnPen_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Mouse Mode -->
                <Button x:Name="btnMouse"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Chế độ chuột (di chuyển &amp; tương tác)"
                        Click="btnMouse_Click">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M4,0L4,20L8,16L12,24L14,23L10,15L16,15Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Clear All -->
                <Button x:Name="btnClearAll"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Xóa tất cả"
                        Click="btnClearAll_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Delete Last Stroke -->
                <Button x:Name="btnDeleteStroke"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Xóa từng nét (nét vẽ cuối)"
                        Click="btnDeleteStroke_Click">
                    <Grid>
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#37474F"
                                      Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z"/>
                            </Canvas>
                        </Viewbox>
                        <Border Background="#BF616A" CornerRadius="8"
                                Width="16" Height="16"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,2,2">
                            <TextBlock Text="-1" FontSize="10" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- Undo -->
                <Button x:Name="btnUndo"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Hoàn tác (Ctrl+Z)"
                        Click="btnUndo_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Redo -->
                <Button x:Name="btnRedo"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Làm lại (Ctrl+Y)"
                        Click="btnRedo_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Separator -->
                <Rectangle x:Name="sepTools" Height="1.5" Fill="#C5CAE9" Margin="4,6,4,6"/>

                <!-- Select Area -->
                <Button x:Name="btnSelectArea"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Cắt vùng màn hình → Đặt lên bảng vẽ"
                        Click="btnSelectArea_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M7,17V1H5V5H1V7H5V17A2,2 0 0,0 7,19H17V23H19V19H23V17M17,15H19V7C19,5.89 18.1,5 17,5H9V7H17V15Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Screenshot -->
                <Button x:Name="btnScreenshot"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Chụp ảnh màn hình"
                        Click="btnScreenshot_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Camera Toggle -->
                <Button x:Name="btnCamera"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Bật/Tắt Camera"
                        Click="btnCamera_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#37474F" 
                                  Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Record Button -->
                <Button x:Name="btnRecord"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Ghi màn hình"
                        Click="btnRecord_Click">
                    <Grid>
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="18" Height="18" 
                                         Canvas.Left="4" Canvas.Top="4"
                                         Fill="#BF616A"
                                         x:Name="recDot"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="txtRecordTime"
                                   Text="REC" 
                                   FontSize="8" 
                                   FontWeight="Bold" 
                                   Foreground="#ECEFF4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <!-- Recording Options Popup -->
        <Popup x:Name="popupRecordOptions" PlacementTarget="{Binding ElementName=btnRecord}" Placement="Right" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Margin="10,0,0,0">
            <Border Background="#2E3440" CornerRadius="8" Padding="12" BorderBrush="#5C6BC0" BorderThickness="1" Width="230">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="10" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CÀI ĐẶT GHI HÌNH" Foreground="#E5E9F0" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    
                    <RadioButton x:Name="rbScreenOnly" Content="Chỉ màn hình" Foreground="White" IsChecked="True" Margin="0,4"/>
                    <RadioButton x:Name="rbScreenAndCam" Content="Màn hình + Camera" Foreground="White" Margin="0,4"/>
                    
                    <Rectangle Height="1" Fill="#4C566A" Margin="0,8"/>
                    
                    <CheckBox x:Name="chkMicrophone" Content="Thu âm Microphone (Người nói)" Foreground="White" IsChecked="True" Margin="0,4"/>
                    <CheckBox x:Name="chkSystemAudio" Content="Thu âm máy tính (Loa/Media)" Foreground="White" IsChecked="True" Margin="0,4"/>
                    
                    <Button x:Name="btnStartRecordingOptions" Content="BẮT ĐẦU" Background="#BF616A" Foreground="White" FontWeight="Bold" Height="32" Margin="0,12,0,0" Click="btnStartRecordingOptions_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
