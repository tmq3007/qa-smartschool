<Window x:Class="QASmartTouch.Forms.FloatingToolbarWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="QA SmartClass - DESKTOP Mode"

        Width="70"

        SizeToContent="Height"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        Topmost="True"

        ShowInTaskbar="False"

        ResizeMode="NoResize"

        FontFamily="{StaticResource InterFont}">



    <Window.Resources>

        <!-- Button Style -->

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="50"/>

            <Setter Property="Height" Value="50"/>

            <Setter Property="Margin" Value="0,5,0,5"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                               CornerRadius="8"

                               BorderThickness="2"

                               BorderBrush="Transparent"

                               x:Name="border">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#C5CAE9"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#5C6BC0"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#9FA8DA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Toggle Button Style (for active state) -->

        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">

            <Setter Property="Width" Value="50"/>

            <Setter Property="Height" Value="50"/>

            <Setter Property="Margin" Value="0,5,0,5"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border Background="{TemplateBinding Background}"

                               CornerRadius="8"

                               BorderThickness="2"

                               BorderBrush="Transparent"

                               x:Name="border">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#5C6BC0"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#5C6BC0"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#C5CAE9"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#5C6BC0"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Border Background="#E8EAF6" 

            CornerRadius="12"

            BorderBrush="#5C6BC0"

            BorderThickness="2"

            Padding="10">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC"

                            Direction="90"

                            Opacity="0.2"

                            BlurRadius="10"

                            ShadowDepth="2"/>

        </Border.Effect>



        <StackPanel>

            <!-- Separator -->

            <Rectangle Height="2" Fill="#C5CAE9" Margin="5,5,5,10"/>



            <!-- Exit Window Mode Button -->

            <Button x:Name="btnExit"
                    ToolTip="Thoát chế độ DESKTOP"
                    Click="btnExit_Click"
                    Margin="0,5,0,20"
                    Width="50" Height="50"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- Nền đỏ bo góc tròn đậm tính cảnh báo -->
                        <Border Background="#BF616A" CornerRadius="10" x:Name="border">
                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <!-- Icon chữ X màu trắng tinh khiết tạo tương phản cực cao -->
                                    <Path Fill="#FFFFFF" 
                                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0717B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A54F57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>



            <!-- Pen Tool -->

            <Button x:Name="btnPen"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Bút vẽ"

                   Click="btnPen_Click">

                <Viewbox Width="30" Height="30">

                    <Canvas Width="24" Height="24">

                        <Path Fill="#37474F" 

                              Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>

                    </Canvas>

                </Viewbox>

            </Button>



            <!-- Mouse Mode (Chế độ chuột - tương tác màn hình) -->

            <Button x:Name="btnMouse"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Chế độ chuột (di chuyển &amp; tương tác)"

                   Click="btnMouse_Click">

                <Viewbox Width="28" Height="28">

                    <Canvas Width="24" Height="24">

                        <!-- Cursor arrow icon -->

                        <Path Fill="#37474F"

                              Data="M4,0L4,20L8,16L12,24L14,23L10,15L16,15Z"/>

                    </Canvas>

                </Viewbox>

            </Button>





            <!-- Clear All -->

            <Button x:Name="btnClearAll"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Xóa tất cả"

                   Click="btnClearAll_Click">

                <Viewbox Width="30" Height="30">

                    <Canvas Width="24" Height="24">

                        <Path Fill="#37474F" 

                              Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>

                    </Canvas>

                </Viewbox>

            </Button>



            <!-- Delete Last Stroke -->

            <Button x:Name="btnDeleteStroke"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Xóa từng nét (nét vẽ cuối)"

                   Click="btnDeleteStroke_Click">

                <Grid>

                    <Viewbox Width="30" Height="30">

                        <Canvas Width="24" Height="24">

                            <!--  Eraser icon -->

                            <Path Fill="#37474F"

                                  Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z"/>

                        </Canvas>

                    </Viewbox>

                    <!-- Badge "-1" -->

                    <Border Background="#BF616A" CornerRadius="9"

                            Width="18" Height="18"

                            HorizontalAlignment="Right" VerticalAlignment="Bottom"

                            Margin="0,0,2,2">

                        <TextBlock Text="-1" FontSize="11" FontWeight="Bold"

                                   Foreground="White"

                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Button>



            <!-- Undo -->

            <Button x:Name="btnUndo"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Hoàn tác (Ctrl+Z)"

                   Click="btnUndo_Click">

                <Viewbox Width="30" Height="30">

                    <Canvas Width="24" Height="24">

                        <Path Fill="#37474F" 

                              Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z"/>

                    </Canvas>

                </Viewbox>

            </Button>



            <!-- Redo -->

            <Button x:Name="btnRedo"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Làm lại (Ctrl+Y)"

                   Click="btnRedo_Click">

                <Viewbox Width="30" Height="30">

                    <Canvas Width="24" Height="24">

                        <Path Fill="#37474F" 

                              Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z"/>

                    </Canvas>

                </Viewbox>

            </Button>





            <!-- Separator -->

            <Rectangle Height="2" Fill="#C5CAE9" Margin="5,10,5,10"/>



            <!-- Select Area -->

            <Button x:Name="btnSelectArea"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Cắt vùng màn hình → Đặt lên bảng vẽ"

                   Click="btnSelectArea_Click">

                <Viewbox Width="30" Height="30">

                    <Canvas Width="24" Height="24">

                        <Path Fill="#37474F" 

                              Data="M7,17V1H5V5H1V7H5V17A2,2 0 0,0 7,19H17V23H19V19H23V17M17,15H19V7C19,5.89 18.1,5 17,5H9V7H17V15Z"/>

                    </Canvas>

                </Viewbox>

            </Button>



            <!-- Screenshot -->

            <Button x:Name="btnScreenshot"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Chụp ảnh màn hình"

                   Click="btnScreenshot_Click">

                <Viewbox Width="30" Height="30">

                    <Canvas Width="24" Height="24">

                        <Path Fill="#37474F" 

                              Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"/>

                    </Canvas>

                </Viewbox>

            </Button>







            <!-- Record Button -->

            <Button x:Name="btnRecord"

                   Style="{StaticResource ToolbarButtonStyle}"

                   ToolTip="Ghi màn hình"

                   Click="btnRecord_Click">

                <Grid>

                    <Viewbox Width="30" Height="30">

                        <Canvas Width="24" Height="24">

                            <Ellipse Width="18" Height="18" 

                                    Canvas.Left="4" Canvas.Top="4"

                                    Fill="#BF616A"

                                    x:Name="recDot"/>

                        </Canvas>

                    </Viewbox>

                    <TextBlock Text="REC" 

                              FontSize="8" 

                              FontWeight="Bold"

                              Foreground="#ECEFF4"

                              HorizontalAlignment="Center"

                              VerticalAlignment="Bottom"

                              Margin="0,0,0,5"/>

                </Grid>

            </Button>



        </StackPanel>

    </Border>

</Window>

