<Window x:Class="QASmartTouch.Forms.Form1_MainLogin"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="QASmartTouch - Đăng nhập"

        WindowState="Maximized"

        WindowStyle="None"

        Background="#F5F6FA">

    

    <Grid x:Name="MainGrid">

        <!-- Background with gradient -->

        <Grid.Background>

            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                <GradientStop Color="#E8F4F8" Offset="0"/>

                <GradientStop Color="#D6E9F5" Offset="1"/>

            </LinearGradientBrush>

        </Grid.Background>



        <!-- Close Button -->

        <Button x:Name="btnCloseWindow"

                Content="✕"

                HorizontalAlignment="Right"

                VerticalAlignment="Top"

                Margin="0,20,20,0"

                Width="40"

                Height="40"

                FontSize="20"

                FontWeight="Bold"

                Background="#EE5A6F"

                Foreground="White"

                BorderThickness="0"

                Cursor="Hand"

                Click="btnCloseWindow_Click">

            <Button.Template>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}" 

                            CornerRadius="20">

                        <ContentPresenter HorizontalAlignment="Center" 

                                        VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>

            </Button.Template>

            <Button.Style>

                <Style TargetType="Button">

                    <Setter Property="Background" Value="#EE5A6F"/>

                    <Style.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter Property="Background" Value="#D63447"/>

                        </Trigger>

                    </Style.Triggers>

                </Style>

            </Button.Style>

        </Button>



        <!-- Main Content Container -->

        <Border Background="White" 

                CornerRadius="15" 

                Width="500" 

                Padding="50,40"

                VerticalAlignment="Center"

                HorizontalAlignment="Center">

            <Border.Effect>

                <DropShadowEffect Color="#CCCCCC" 

                                Direction="270" 

                                ShadowDepth="3" 

                                BlurRadius="15" 

                                Opacity="0.3"/>

            </Border.Effect>



            <StackPanel>

                <!-- Logo Section -->

                <StackPanel Orientation="Horizontal" 

                          HorizontalAlignment="Center" 

                          Margin="0,0,0,20">

                    <!-- Graduation Cap Icon -->

                    <Viewbox Width="40" Height="40" Margin="0,0,10,0">

                        <Canvas Width="24" Height="24">

                            <Path x:Name="LoginIcon"

                                  Fill="#2E86DE" 

                                  Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z"/>

                        </Canvas>

                    </Viewbox>

                    <!-- Logo Text -->

                    <TextBlock x:Name="LoginAppName"

                             Text="QA SmartClass" 

                             FontSize="32" 

                             FontWeight="Bold" 

                             Foreground="#2E86DE"

                             VerticalAlignment="Center"/>

                </StackPanel>



                <!-- Welcome Text -->

                <TextBlock x:Name="txtWelcome"

                         Text="Chào mừng đến với QA SmartClass" 

                         FontSize="18" 

                         FontWeight="SemiBold"

                         Foreground="#2F3542"

                         HorizontalAlignment="Center" 

                         Margin="0,0,0,5"/>

                

                <TextBlock x:Name="txtDescription"
                           Text="Nền tảng giảng dạy tương tác thông minh"  
                           FontSize="13" 
                           Foreground="#747D8C"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>



                <!-- Test Account Selector (Only visible in Test mode) -->

                <StackPanel x:Name="pnlTestAccounts" Visibility="Collapsed" Margin="0,0,0,15">

                    <TextBlock Text="🔑 Chọn nhanh tài khoản Test (CSDL)" 

                              Style="{StaticResource FormLabel}" Foreground="#2563EB" FontWeight="Bold"/>

                    <ComboBox x:Name="cboTestAccounts" Height="40" FontSize="14" Padding="10,6"

                              SelectionChanged="cboTestAccounts_SelectionChanged"/>

                </StackPanel>



                <!-- User ID Input -->

                <TextBlock Text="Tên đăng nhập" 

                         Style="{StaticResource FormLabel}"/>

                <TextBox x:Name="txtUserID" 

                       Style="{StaticResource ModernTextBox}"

                       FontSize="15"

                       Margin="0,0,0,10"/>

                

                <TextBlock x:Name="txtUserIDHint" FontSize="11" 

                          Foreground="{StaticResource InfoBrush}" 

                          Margin="0,-8,0,12"

                          Text="(Thử nghiệm)"/>



                <!-- Password Input -->

                <TextBlock Text="Mật khẩu" 

                         Style="{StaticResource FormLabel}"/>

                <PasswordBox x:Name="txtPassword" 

                            Style="{StaticResource ModernPasswordBox}"

                            FontSize="15"

                            Margin="0,0,0,10"

                            PasswordChanged="txtPassword_PasswordChanged"/>

                

                <TextBlock x:Name="txtPasswordHint" FontSize="11" 

                          Foreground="{StaticResource InfoBrush}" 

                          Margin="0,-8,0,12"

                          Text="(Thử nghiệm: PassGiaoVien01)"/>



                <!-- License Key Input -->

                <TextBlock Text="Mã kích hoạt bản quyền (License Key)" 

                          Style="{StaticResource FormLabel}"/>

                <TextBox x:Name="txtLicenseKey" 

                       Style="{StaticResource ModernTextBox}"

                       FontSize="15"

                       Margin="0,0,0,10"/>

                

                <TextBlock x:Name="txtLicenseHint" FontSize="11" 

                          Foreground="{StaticResource InfoBrush}" 

                          Margin="0,-8,0,12"

                          Text="(Thử nghiệm)"/>



                <!-- Remember Credentials Checkbox -->

                <CheckBox x:Name="chkRememberCredentials" 

                        Content="Lưu thông tin đăng nhập thử nghiệm" 

                        Style="{StaticResource ModernCheckBox}"

                        IsChecked="True"

                        Margin="0,0,0,12"/>



                <!-- License Status Display -->

                <Border Background="#F1F2F6" 

                      CornerRadius="5" 

                      Padding="12,8" 

                      Margin="0,0,0,15">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Trạng thái License: " 

                                 FontSize="12" 

                                 Foreground="{StaticResource DarkBrush}"

                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="lblLicenseStatus" 

                                 Text="Thử nghiệm" 

                                 Style="{StaticResource StatusTrial}"

                                 VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>



                <!-- Error Message -->

                <TextBlock x:Name="lblErrorMessage" 

                         Text="" 

                         Foreground="{StaticResource DangerBrush}"

                         FontSize="12"

                         TextWrapping="Wrap"

                         HorizontalAlignment="Center"

                         Margin="0,0,0,12"

                         Visibility="Collapsed"/>



                <!-- Login Progress -->

                <ProgressBar x:Name="progressLogin" 

                           Height="4" 

                           IsIndeterminate="True"

                           Margin="0,0,0,12"

                           Visibility="Collapsed"

                           Foreground="{StaticResource PrimaryBrush}"/>



                <!-- Login Button -->

                <Button x:Name="btnLogin" 

                      Content="Đăng nhập" 

                      Style="{StaticResource ModernButton}"

                      Height="45"

                      FontSize="15"

                      Margin="0,0,0,10"

                      Click="btnLogin_Click"/>



                <!-- Forgot Password Button -->

                <Button x:Name="btnForgotPassword" 

                      Content="Quên mật khẩu?" 

                      Style="{StaticResource SecondaryButton}"

                      Height="40"

                      FontSize="13"

                      Margin="0,0,0,10"

                      Click="btnForgotPassword_Click"/>



                <!-- Exit Button -->

                <Button x:Name="btnExit" 

                      Content="Thoát" 

                      Height="40"

                      FontSize="13"

                      Background="#EE5A6F"

                      Foreground="White"

                      BorderThickness="0"

                      Padding="20,10"

                      FontWeight="SemiBold"

                      Cursor="Hand"

                      Click="btnExit_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                    CornerRadius="5"

                                    Padding="{TemplateBinding Padding}">

                                <ContentPresenter HorizontalAlignment="Center" 

                                                VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Background" Value="#EE5A6F"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter Property="Background" Value="#D63447"/>

                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">

                                    <Setter Property="Opacity" Value="0.5"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>



                <!-- Version Info -->

                <TextBlock Text="Phiên bản 1.1.0 - Bản dựng 2025.10.16" 
                         FontSize="10" 
                         Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" 
                         Margin="0,15,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>

