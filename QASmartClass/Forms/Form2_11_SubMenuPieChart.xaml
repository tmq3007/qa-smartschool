<Window x:Class="QASmartTouch.Forms.Form2_11_SubMenuPieChart"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Biểu đồ Tròn" 

        Width="200" 

        SizeToContent="Height"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False">

    

    <Border CornerRadius="10" 

            Background="White"

            BorderBrush="#E0E0E0" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="15" ShadowDepth="3"/>

        </Border.Effect>



        <StackPanel Margin="8">

            <!-- Header -->

            <TextBlock Text="Biểu đồ Tròn" 

                       FontSize="14" 

                       FontWeight="Bold" 

                       Foreground="#2F3542"

                       Margin="8,8,8,12"/>



            <Separator Margin="0,0,0,8" Background="#E0E0E0"/>



            <!-- Option 1: Pie Chart (Biểu đồ tròn) -->

            <Button x:Name="btnPieChart"

                    Height="50"

                    Background="Transparent"

                    BorderThickness="0"

                    Cursor="Hand"

                    Click="btnPieChart_Click"

                    Margin="0,0,0,4">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="6"

                                Padding="10,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <!-- Icon: Full Pie -->

                                <Viewbox Grid.Column="0" Width="32" Height="32">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#FF6B6B" 

                                              Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12C4,16.41 7.58,20 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,6V13H18C17.5,15.24 15.47,17 13,17C10.24,17 8,14.76 8,12C8,9.53 9.76,7.5 12,7V9C10.9,9 10,9.9 10,11C10,12.1 10.9,13 12,13C13.1,13 14,12.1 14,11H11V6Z"/>

                                    </Canvas>

                                </Viewbox>



                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="Biểu đồ Tròn" 

                                               FontSize="13" 

                                               FontWeight="SemiBold"

                                               Foreground="#2F3542"/>

                                    <TextBlock Text="Pie Chart" 

                                               FontSize="10" 

                                               Foreground="#747D8C"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#F1F2F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>



            <!-- Option 2: Donut Chart (Biểu đồ vòng) -->

            <Button x:Name="btnDonutChart"

                    Height="50"

                    Background="Transparent"

                    BorderThickness="0"

                    Cursor="Hand"

                    Click="btnDonutChart_Click"

                    Margin="0,0,0,4">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="6"

                                Padding="10,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <!-- Icon: Donut -->

                                <Viewbox Grid.Column="0" Width="32" Height="32">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#4ECDC4" 

                                              Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12C4,16.41 7.58,20 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z"/>

                                    </Canvas>

                                </Viewbox>



                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="Biểu đồ Vòng" 

                                               FontSize="13" 

                                               FontWeight="SemiBold"

                                               Foreground="#2F3542"/>

                                    <TextBlock Text="Donut Chart" 

                                               FontSize="10" 

                                               Foreground="#747D8C"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#F1F2F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>



            <!-- Option 3: Semi-Circle Chart (Bán nguyệt) -->

            <Button x:Name="btnSemiCircleChart"

                    Height="50"

                    Background="Transparent"

                    BorderThickness="0"

                    Cursor="Hand"

                    Click="btnSemiCircleChart_Click"

                    Margin="0,0,0,4">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="6"

                                Padding="10,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="40"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <!-- Icon: Semi-Circle -->

                                <Viewbox Grid.Column="0" Width="32" Height="32">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#45B7D1" 

                                              Data="M12,2A10,10 0 0,1 22,12H12V2M12,14H22A10,10 0 0,1 12,24V14Z"/>

                                    </Canvas>

                                </Viewbox>



                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="Bán Nguyệt" 

                                               FontSize="13" 

                                               FontWeight="SemiBold"

                                               Foreground="#2F3542"/>

                                    <TextBlock Text="Semi-Circle" 

                                               FontSize="10" 

                                               Foreground="#747D8C"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#F1F2F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </StackPanel>

    </Border>

</Window>

