<Window x:Class="QASmartTouch.Forms.Form2_7_SubMenuBoardManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="7. Công cụ bảng" 
        Width="450" Height="255"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Window.Resources>
        <!-- Style thống nhất cho các nút công cụ bảng (Touch Friendly IFP) -->
        <Style x:Key="BoardToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E86DE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="15" 
            BorderBrush="#E1E8ED" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC" 
                              Direction="270" 
                              ShadowDepth="3" 
                              BlurRadius="15" 
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="*"/>    <!-- 1: Tools Grid -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#2E86DE" 
                                  Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M12,17L17,12L15.59,10.59L12,14.17L9.91,12.09L8.5,13.5L12,17Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Công cụ bảng" 
                              FontSize="15" 
                              FontWeight="Bold" 
                              Foreground="#2F3542"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnClose" 
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        Background="#FEE2E2"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#EE5A6F" 
                                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 6 CÔNG CỤ BẢNG SƯ PHẠM CỐT LÕI (UniformGrid 3 hàng x 2 cột) -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="3">

                <!-- 1. Đổi nền bảng -->
                <Button x:Name="btnBackgrounds" 
                        Style="{StaticResource BoardToolButtonStyle}"
                        Click="btnBackgrounds_Click"
                        ToolTip="Thay đổi màu nền hoặc mẫu kẻ ô ly bảng">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FF9800" 
                                      Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Đổi nền bảng" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 2. Màn che bảng -->
                <Button x:Name="btnCurtain" 
                        Style="{StaticResource BoardToolButtonStyle}"
                        Click="btnCurtain_Click"
                        ToolTip="Màn che bảng để ẩn hiện đáp án">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#607D8B" 
                                      Data="M20,19V3H4V19H2V21H22V19H20M6,5H18V7H6V5M6,9H18V11H6V9M6,13H18V15H6V13M6,17H18V19H6V17Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Màn che bảng" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 3. Kính lúp phóng to -->
                <Button x:Name="btnMagnifier" 
                        Style="{StaticResource BoardToolButtonStyle}"
                        Click="btnMagnifier_Click"
                        ToolTip="Kính lúp phóng to chi tiết bài học">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FF5722" 
                                      Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Kính lúp phóng to" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 4. Đèn rọi điểm nhấn -->
                <Button x:Name="btnSpotlight" 
                        Style="{StaticResource BoardToolButtonStyle}"
                        Click="btnSpotlight_Click"
                        ToolTip="Đèn rọi điểm nhấn tập trung">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#F59E0B" 
                                      Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 1,1 4,12A8,8 0 0,1 12,4M12,7A5,5 0 1,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 1,1 9,12A3,3 0 0,1 12,9Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Đèn rọi điểm nhấn" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 5. Chụp vùng màn hình -->
                <Button x:Name="btnScreenshot" 
                        Style="{StaticResource BoardToolButtonStyle}"
                        Click="btnScreenshot_Click"
                        ToolTip="Chụp một vùng trên bảng vẽ">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#00BCD4" 
                                      Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Chụp vùng bảng" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 6. Đa người dùng -->
                <Button x:Name="btnMultiUser" 
                        Style="{StaticResource BoardToolButtonStyle}"
                        Click="btnMultiUser_Click"
                        ToolTip="Chia đôi bảng cho nhiều học sinh cùng viết">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#2E86DE" 
                                      Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Đa người dùng" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3542" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </UniformGrid>
        </Grid>
    </Border>
</Window>
