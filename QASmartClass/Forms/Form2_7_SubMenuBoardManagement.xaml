<Window x:Class="QASmartTouch.Forms.Form2_7_SubMenuBoardManagement"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="7. Công cụ bảng" 

        Width="480" Height="520"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False"

        FontFamily="Segoe UI, Inter, Arial, sans-serif">



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid Margin="15">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <!-- Header -->

                <RowDefinition Height="Auto"/>

                <!-- Board List -->

                <RowDefinition Height="*"/>

                <!-- Board Controls (includes all actions) -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Grid Grid.Row="0" Margin="0,0,0,15">

                <StackPanel Orientation="Horizontal">

                    <Path Fill="#2E86DE" 

                          Data="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13Z"

                          Width="20" Height="20"

                          VerticalAlignment="Center"

                          Margin="0,0,8,0"/>

                    <TextBlock Text="7. Công cụ bảng" 

                              FontSize="16" 

                              FontWeight="Bold" 

                              Foreground="#2F3542"

                              VerticalAlignment="Center"/>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Width="30" Height="30"

                       HorizontalAlignment="Right"

                       Background="#FEE2E2"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnClose_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   CornerRadius="8">

                                <Path Fill="#EE5A6F" 

                                     Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                                     Width="14" Height="14"

                                     Stretch="Uniform"

                                     HorizontalAlignment="Center"

                                     VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>



            <!-- BOARD NAVIGATION (NEW HORIZONTAL LAYOUT) -->

            <Border Grid.Row="1" 

                   Background="#F8F9FA"

                   CornerRadius="10"

                   Padding="8"

                   Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock x:Name="txtBoardCount"

                              Text="Bảng (2/10):" 

                              FontSize="12" 

                              FontWeight="SemiBold" 

                              Foreground="#57606F"

                              Margin="0,0,0,10"/>

                    

                    <!-- Horizontal Board Buttons -->

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 

                                 VerticalScrollBarVisibility="Disabled"

                                 Height="100">

                        <StackPanel x:Name="panelBoardButtons" 

                                   Orientation="Horizontal"/>

                    </ScrollViewer>

                    

                    <!-- Active Board Info -->

                    <StackPanel x:Name="panelActiveBoardInfo" 

                               Orientation="Horizontal"

                               Margin="0,10,0,0"

                               HorizontalAlignment="Center">

                        <Path Fill="#4CAF50" 

                             Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"

                             Width="14" Height="14"

                             Margin="0,0,5,0"

                             VerticalAlignment="Center"/>

                        <TextBlock x:Name="txtActiveBoardInfo"

                                  Text="Đang hiển thị - 0 đối tượng"

                                  FontSize="11"

                                  Foreground="#4CAF50"

                                  FontWeight="SemiBold"/>

                    </StackPanel>

                </StackPanel>

            </Border>



            <!-- BOARD CONTROLS -->

            <Border Grid.Row="2"

                   Background="#F8F9FA"

                   CornerRadius="10"

                   Padding="12"

                   Margin="0,0,0,0">

                <StackPanel>

                    <TextBlock Text="Thao tác bảng" 

                              FontSize="12" 

                              FontWeight="SemiBold" 

                              Foreground="#57606F"

                              Margin="0,0,0,8"/>

                    

                    <UniformGrid Columns="3" Rows="4">

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnNewBoard_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#4CAF50" 

                                     Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Thêm bảng mới" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnDuplicateBoard_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#9C27B0" 

                                     Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Nhân bản" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnBackgrounds_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#FF9800" 

                                     Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Đổi nền" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnScreenshot_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#00BCD4" 

                                     Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Chụp vùng" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnPanCanvas_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#3F51B5" 

                                     Data="M13,6V11H18V7.75L22.25,12L18,16.25V13H13V18H16.25L12,22.25L7.75,18H11V13H6V16.25L1.75,12L6,7.75V11H11V6H7.75L12,1.75L16.25,6H13Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Di chuyển" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnResizeCanvas_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#673AB7" 

                                     Data="M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Mở rộng" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <!-- ✨ NEW: Magnifier / Kính lúp -->

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnMagnifier_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#FF5722" 

                                     Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Kính lúp" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <!-- ✨ NEW: Spotlight / Đèn soi -->

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnSpotlight_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#FF9800" 

                                     Data="M12,2A10,10 0 1,0 12,22A10,10 0 0,0 12,2M12,4A8,8 0 1,1 12,20A8,8 0 0,1 12,4M12,8A4,4 0 1,0 12,16A4,4 0 0,0 12,8Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Đèn soi" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <!-- ✨ NEW: Countdown Timer / Hẹn giờ -->

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnTimer_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#E91E63" 

                                     Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Hẹn giờ" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <!-- ✨ NEW: Pointer / Chỉ bảng -->

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnPointer_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#9C27B0" 

                                     Data="M12,2C6.5,2 2,6.5 2,12C2,17.5 6.5,22 12,22C17.5,22 22,17.5 22,12C22,6.5 17.5,2 12,2M15,16C15,16.5 14.5,17 14,17H9C8.45,17 8,16.5 8,16V11C8,10.45 8.45,10 9,10H10V7.5C10,6.67 10.67,6 11.5,6C12.33,6 13,6.67 13,7.5V10H14C14.55,10 15,10.45 15,11V16Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Chỉ bảng" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnMultiUser_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#2196F3" 

                                     Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Đa người dùng" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        

                        <Button Height="45" Margin="2"

                               Background="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnCurtain_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#9E9E9E" 

                                     Data="M6,2V22H18V2H6M14,20H10V4H14V20Z"

                                     Width="20" Height="20"

                                     Margin="0,0,8,0"/>

                                <TextBlock Text="Che màn hình" 

                                           FontSize="11"

                                           Foreground="#2F3542"

                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </UniformGrid>

                </StackPanel>

            </Border>



        </Grid>

    </Border>

</Window>

