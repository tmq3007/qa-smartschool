<Window x:Class="QASmartTouch.Forms.Form2_18_CompassTool"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compass Tool - Compa"
        Width="280" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
                          ShadowDepth="3" 
                          BlurRadius="10" 
                          Opacity="0.3"/>
    </Window.Resources>

    <Grid x:Name="MainGrid" RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CompassScale" ScaleX="1" ScaleY="1"/>
                <RotateTransform x:Name="CompassRotate" Angle="0"/>
                <TranslateTransform x:Name="CompassTranslate" X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid x:Name="CompassLayerRoot" Margin="10">
            <!-- Main Compass Visual -->
            <Grid x:Name="CompassVisual">
                <!-- Canvas for Drawing -->
                <Canvas x:Name="CompassCanvas" Width="260" Height="260" Background="Transparent">

                    <!-- Compass Arm 1 (Needle Pin Leg - LEFT at -30°) -->
                    <Path x:Name="Arm1Path"
                          Stroke="#FFC0C0C0"
                          StrokeThickness="6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                        <Path.Data>
                            <LineGeometry x:Name="Arm1Geometry" StartPoint="130,80" EndPoint="100,150"/>
                        </Path.Data>
                    </Path>

                    <!-- Compass Arm 2 (Pencil Holder Leg - RIGHT at +30°) -->
                    <Path x:Name="Arm2Path"
                          Stroke="#FFC0C0C0"
                          StrokeThickness="6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                        <Path.Data>
                            <LineGeometry x:Name="Arm2Geometry" StartPoint="130,80" EndPoint="160,150"/>
                        </Path.Data>
                    </Path>

                    <!-- Pencil Body (Yellow Cylinder) at end of Arm2 -->
                    <Rectangle x:Name="PencilBody"
                               Width="8" Height="60"
                               Fill="#FFFFA500"
                               Stroke="#FFD97706"
                               StrokeThickness="1.5"
                               Canvas.Left="166" Canvas.Top="112"
                               Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <!-- Eraser (Red hemisphere) at top of pencil -->
                    <Ellipse x:Name="Eraser"
                             Width="8" Height="8"
                             Fill="#FFEF4444"
                             Stroke="#FF991B1B"
                             StrokeThickness="1"
                             Canvas.Left="156" Canvas.Top="116"
                             Cursor="Hand"/>

                    <!-- Pencil Lead (Black cone tip) -->
                    <Polygon x:Name="PencilLead"
                             Points="160,180 156,186 164,186"
                             Fill="#FF1F2937"
                             Stroke="#FF111827"
                             StrokeThickness="1"
                             Cursor="Hand"/>

                    <!-- Center Joint (Pivot/Hinge) -->
                    <Grid x:Name="CenterJoint" Width="20" Height="20"
                          Canvas.Left="120" Canvas.Top="70">
                        <Ellipse Fill="#FFBEBEBE" Stroke="#FF808080" StrokeThickness="2"/>
                        <Ellipse Width="8" Height="8" Fill="#FF606060" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Center Point (Draggable pivot) -->
                    <Ellipse x:Name="CenterPoint"
                             Canvas.Left="125" Canvas.Top="75"
                             Width="10" Height="10"
                             Fill="#FF1E40AF"
                             Stroke="#FF1E3A8A"
                             StrokeThickness="2"
                             Cursor="Hand"/>

                    <!-- Needle Pin (sharp point at end of Arm1) -->
                    <Polygon x:Name="NeedlePin"
                             Points="100,150 96,155 104,155"
                             Fill="#FF606060"
                             Stroke="#FF303030"
                             StrokeThickness="1"/>

                    <!-- Pencil Tip Interaction Area (invisible) -->
                    <Ellipse x:Name="PencilTip"
                             Canvas.Left="152" Canvas.Top="145"
                             Width="16" Height="16"
                             Fill="Transparent"
                             Cursor="Hand"
                             MouseLeftButtonDown="PencilTip_MouseDown"
                             MouseLeftButtonUp="PencilTip_MouseUp"
                             MouseMove="PencilTip_MouseMove"/>

                    <!-- Circle Preview (dashed) -->
                    <Ellipse x:Name="CirclePreview"
                             Canvas.Left="60" Canvas.Top="60"
                             Width="140" Height="140"
                             Stroke="#B31E40AF"
                             StrokeThickness="1.5"
                             StrokeDashArray="5,3"
                             Fill="Transparent"
                             Visibility="Collapsed"/>

                    <!-- Radius Display Label -->
                    <Border x:Name="RadiusDisplay"
                            Canvas.Left="140" Canvas.Top="165"
                            Background="#E0FFFFFF"
                            BorderBrush="#FF1E40AF"
                            BorderThickness="1.5"
                            CornerRadius="3"
                            Padding="8,4"
                            Visibility="Visible">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="R = " 
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1E40AF"/>
                            <TextBlock x:Name="RadiusValue" 
                                       Text="70"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1E40AF"/>
                            <TextBlock Text=" px" 
                                       FontSize="11"
                                       Foreground="#FF64748B"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Message -->
                    <Border x:Name="StatusMessage"
                            Canvas.Left="30" Canvas.Top="10"
                            Background="#E0FFFFFF"
                            BorderBrush="#FF10B981"
                            BorderThickness="1.5"
                            CornerRadius="3"
                            Padding="10,5"
                            Visibility="Collapsed">
                        <TextBlock x:Name="StatusText" 
                                   Text=""
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF059669"/>
                    </Border>

                    <!-- Radius Input Box -->

                    <!-- Formula Display Panel -->

                    <!-- Draw Mode Panel -->

                </Canvas>
            </Grid>

            <!-- Brush Settings Popup -->
            <Popup x:Name="BrushSettingsPopup" 
                   PlacementTarget="{Binding ElementName=btnBrush}"
                   Placement="Left"
                   AllowsTransparency="True"
                   StaysOpen="False">
                <Border Background="White" 
                        BorderBrush="#FF1E40AF" 
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="12"
                        Effect="{StaticResource DropShadowEffect}">
                    <StackPanel Width="180">
                        <TextBlock Text="Cài đặt bút vẽ" 
                                   FontWeight="Bold" 
                                   FontSize="12"
                                   Foreground="#FF1E40AF"
                                   Margin="0,0,0,10"/>

                        <!-- Color Picker -->
                        <TextBlock Text="Màu sắc:" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbColor" FontSize="10" SelectionChanged="CmbColor_SelectionChanged">
                            <ComboBoxItem IsSelected="True">⚫ Đen</ComboBoxItem>
                            <ComboBoxItem>🔴 Đỏ</ComboBoxItem>
                            <ComboBoxItem>🔵 Xanh dương</ComboBoxItem>
                            <ComboBoxItem>🟢 Xanh lá</ComboBoxItem>
                            <ComboBoxItem>🟡 Vàng</ComboBoxItem>
                            <ComboBoxItem>🟣 Tím</ComboBoxItem>
                            <ComboBoxItem>🟠 Cam</ComboBoxItem>
                            <ComboBoxItem>🟤 Nâu</ComboBoxItem>
                        </ComboBox>

                        <!-- Thickness Slider -->
                        <TextBlock Text="Độ dày:" FontSize="10" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="sliderThickness" 
                                    Minimum="1" Maximum="10" 
                                    Value="2"
                                    Width="120"
                                    ValueChanged="SliderThickness_ValueChanged"/>
                            <TextBlock x:Name="txtThickness" 
                                       Text="2 px" 
                                       FontSize="10"
                                       Width="40"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Fill Checkbox -->
                        <CheckBox x:Name="chkFill" 
                                  Content="Tô màu đường tròn" 
                                  FontSize="10"
                                  Margin="0,8,0,0"
                                  Checked="ChkFill_Changed"
                                  Unchecked="ChkFill_Changed"/>

                        <!-- Dashed Checkbox -->
                        <CheckBox x:Name="chkDashed" 
                                  Content="Nét đứt (- - -)" 
                                  FontSize="10"
                                  Margin="0,4,0,0"
                                  Checked="ChkDashed_Changed"
                                  Unchecked="ChkDashed_Changed"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Control Buttons Overlay (Outside CompassVisual) -->
            <StackPanel x:Name="ButtonPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,5,5">

                <!-- Move Button -->
                <Button x:Name="btnMove"
                        Content="✥"
                        Width="26" Height="26"
                        FontSize="14"
                        ToolTip="Di chuyển (Move)"
                        Margin="0,0,0,3"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="BtnMove_MouseDown"
                        MouseLeftButtonUp="BtnMove_MouseUp"
                        MouseMove="BtnMove_MouseMove">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#E0FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FF1E40AF"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1E40AF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Lock Radius Button -->

                <!-- Brush Settings Button -->
                <Button x:Name="btnBrush"
                        Content="🎨"
                        Width="26" Height="26"
                        FontSize="12"
                        ToolTip="Cài đặt bút vẽ (Brush)"
                        Margin="0,0,0,3"
                        Click="BtnBrush_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#E0FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FF8B5CF6"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF8B5CF6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Draw Circle Button -->

                <!-- Reset Button -->

                <!-- Geometric Shapes Button -->

                <!-- Close Button -->
                <Button x:Name="btnClose"
                        Content="✕"
                        Width="26" Height="26"
                        FontSize="14"
                        ToolTip="Đóng (Close)"
                        Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#E0FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FFF44336"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF44336"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
