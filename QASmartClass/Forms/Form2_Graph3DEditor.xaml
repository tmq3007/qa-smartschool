<Window x:Class="QASmartTouch.Forms.Form2_Graph3DEditor"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:helix="http://helix-toolkit.org/wpf"

        xmlns:local="clr-namespace:QASmartTouch.Forms"

        Title="Máy vẽ đồ thị hàm số 3D"

        Width="1600" Height="900"

        WindowStartupLocation="CenterScreen"

        Background="#F5F6FA">



    <Window.Resources>

        <!-- Color to Brush Converter -->

        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        

        <!-- Button Style -->

        <Style x:Key="GraphButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#2196F3"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="15,10"/>

            <Setter Property="Margin" Value="0,5"/>

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="8"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#1976D2"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Remove Button Style -->

        <Style x:Key="RemoveButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#EF5350"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="8,5"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="5"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#D32F2F"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Insert Button Style -->

        <Style x:Key="InsertButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#4CAF50"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="20,12"/>

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="10"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#388E3C"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Slider Style -->

        <Style x:Key="ParameterSlider" TargetType="Slider">

            <Setter Property="Minimum" Value="-5"/>

            <Setter Property="Maximum" Value="5"/>

            <Setter Property="TickFrequency" Value="0.1"/>

            <Setter Property="IsSnapToTickEnabled" Value="True"/>

            <Setter Property="Height" Value="30"/>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="3*"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- Left Panel - 3D Viewport -->

        <Border Grid.Column="0" Background="#FFFFFF" Margin="10" CornerRadius="12" 

                BorderBrush="#E0E0E0" BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Title -->

                <Border Grid.Row="0" Padding="20" CornerRadius="12,12,0,0">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                            <GradientStop Color="#667EEA" Offset="0"/>

                            <GradientStop Color="#764BA2" Offset="1"/>

                        </LinearGradientBrush>

                    </Border.Background>

                    <TextBlock Text="Đồ Thị Hàm Số 3D" 

                               FontSize="24" 

                               FontWeight="Bold" 

                               Foreground="White"

                               HorizontalAlignment="Center"/>

                </Border>



                <!-- 3D Viewport -->

                <Border Grid.Row="1" Margin="10" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1">

                    <helix:HelixViewport3D x:Name="viewport3D"

                                            Background="#F9FAFB"

                                            CameraRotationMode="Trackball"

                                            ShowCoordinateSystem="True"

                                            ShowViewCube="True">

                        

                        <!-- Camera -->

                        <helix:HelixViewport3D.Camera>

                            <PerspectiveCamera Position="15,15,15" 

                                              LookDirection="-15,-15,-15" 

                                              UpDirection="0,0,1"

                                              FieldOfView="45"/>

                        </helix:HelixViewport3D.Camera>



                        <!-- Lights -->

                        <helix:DefaultLights/>



                        <!-- Axis arrows — nhỏ gọn & chuyên nghiệp -->

                        <helix:CoordinateSystemVisual3D ArrowLengths="3"/>



                        <!-- Grid -->

                        <helix:GridLinesVisual3D Width="20" Length="20" 

                                                 MinorDistance="1" 

                                                 MajorDistance="5"

                                                 Thickness="0.03"

                                                 Fill="#D1D5DB"/>



                        <!-- 3D Models will be added here dynamically -->

                        <ModelVisual3D x:Name="modelContainer"/>



                    </helix:HelixViewport3D>

                </Border>



                <!-- Camera Controls -->

                <Border Grid.Row="2" Background="#F9FAFB" Padding="15" Margin="10,0,10,10" CornerRadius="8">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button Content="🔼 Hình chiếu bằng" Click="BtnTopView_Click" 

                                Style="{StaticResource GraphButtonStyle}" Margin="5,0"/>

                        <Button Content="👁️ Hình chiếu đứng" Click="BtnFrontView_Click" 

                                Style="{StaticResource GraphButtonStyle}" Margin="5,0"/>

                        <Button Content="➡️ Hình chiếu cạnh" Click="BtnSideView_Click" 

                                Style="{StaticResource GraphButtonStyle}" Margin="5,0"/>

                        <Button Content="🔄 Đặt lại" Click="BtnResetView_Click" 

                                Style="{StaticResource GraphButtonStyle}" Margin="5,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>



        <!-- Right Panel - Controls -->

        <Border Grid.Column="1" Background="#FFFFFF" Margin="10" CornerRadius="12" 

                BorderBrush="#E0E0E0" BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="15">



                    <!-- Add Graph Button -->

                    <Button x:Name="btnAddGraph" 

                            Content="➕ Thêm Đồ Thị 3D" 

                            Style="{StaticResource GraphButtonStyle}"

                            Click="BtnAddGraph_Click"/>



                    <Separator Margin="0,10"/>



                    <!-- Graph List -->

                    <ItemsControl x:Name="graphsList" ItemsSource="{Binding}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F9FAFB" 

                                        BorderBrush="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"

                                        BorderThickness="2"

                                        CornerRadius="8" 

                                        Padding="12" 

                                        Margin="0,0,0,10">

                                    <StackPanel>

                                        <!-- Header -->

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>



                                            <!-- Visibility Toggle -->

                                            <CheckBox Grid.Column="0" 

                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"

                                                      VerticalAlignment="Center" 

                                                      Margin="0,0,10,0"/>



                                            <!-- Color Indicator -->

                                            <Border Grid.Column="1" 

                                                    Width="20" Height="20" 

                                                    CornerRadius="4"

                                                    Margin="0,0,10,0"

                                                    BorderThickness="1"

                                                    BorderBrush="#666">

                                                <Border.Background>

                                                    <SolidColorBrush Color="{Binding Color}"/>

                                                </Border.Background>

                                            </Border>



                                            <!-- ID Label -->

                                            <TextBlock Grid.Column="2" 

                                                       Text="{Binding Id, StringFormat='Đồ thị #{0}'}"

                                                       FontWeight="Bold"

                                                       FontSize="14"

                                                       VerticalAlignment="Center"/>



                                            <!-- Remove Button -->

                                            <Button Grid.Column="3" 

                                                    Content="🗑️" 

                                                    Style="{StaticResource RemoveButtonStyle}"

                                                    Click="BtnRemoveGraph_Click"

                                                    Tag="{Binding Id}"/>

                                        </Grid>



                                        <!-- Function Type Selector -->

                                        <TextBlock Text="Loại hàm số:" 

                                                   FontSize="12" 

                                                   Foreground="#666" 

                                                   Margin="0,10,0,5"/>

                                        <ComboBox SelectedValue="{Binding Type, Mode=TwoWay}"

                                                  FontSize="13"

                                                  Padding="8,5">

                                            <ComboBoxItem Content="Mặt phẳng: z = ax + by + c" Tag="Plane"/>

                                            <ComboBoxItem Content="Mặt Paraboloid: z = ax² + by² + c" Tag="Paraboloid"/>

                                            <ComboBoxItem Content="Mặt yên ngựa: z = ax² - by² + c" Tag="Saddle"/>

                                            <ComboBoxItem Content="Mặt cầu: z = √(r² - x² - y²)" Tag="Sphere"/>

                                            <ComboBoxItem Content="Mặt nón: z = a·√(x² + y²)" Tag="Cone"/>

                                            <ComboBoxItem Content="Sóng hình sin: z = a·sin(bx)·sin(cy)" Tag="SineWave"/>

                                            <ComboBoxItem Content="Mặt Gaussian: z = a·exp(...)" Tag="Gaussian"/>

                                            <ComboBoxItem Content="Mặt gợn sóng: z = a·sin(b·√(x²+y²))" Tag="Ripple"/>

                                        </ComboBox>



                                        <!-- Formula Display -->

                                        <Border Background="#E3F2FD" 

                                                CornerRadius="6" 

                                                Padding="10" 

                                                Margin="0,10,0,10">

                                            <TextBlock Text="{Binding FormulaString}"

                                                       FontFamily="Cambria Math, Segoe UI"

                                                       FontSize="12"

                                                       Foreground="#1565C0"

                                                       TextWrapping="Wrap"/>

                                        </Border>



                                        <!-- Parameter A -->

                                        <TextBlock Text="{Binding A, StringFormat='Tham số A: {0:F2}'}" 

                                                   FontSize="12" Margin="0,5,0,2"/>

                                        <Slider Value="{Binding A, Mode=TwoWay}" 

                                                Style="{StaticResource ParameterSlider}"/>



                                        <!-- Parameter B -->

                                        <TextBlock Text="{Binding B, StringFormat='Tham số B: {0:F2}'}" 

                                                   FontSize="12" Margin="0,5,0,2"/>

                                        <Slider Value="{Binding B, Mode=TwoWay}" 

                                                Style="{StaticResource ParameterSlider}"/>



                                        <!-- Parameter C -->

                                        <TextBlock Text="{Binding C, StringFormat='Tham số C: {0:F2}'}" 

                                                   FontSize="12" Margin="0,5,0,2"/>

                                        <Slider Value="{Binding C, Mode=TwoWay}" 

                                                Style="{StaticResource ParameterSlider}"/>



                                        <!-- Parameter D -->

                                        <TextBlock Text="{Binding D, StringFormat='Tham số D: {0:F2}'}" 

                                                   FontSize="12" Margin="0,5,0,2"/>

                                        <Slider Value="{Binding D, Mode=TwoWay}" 

                                                Style="{StaticResource ParameterSlider}"/>



                                        <!-- Parameter E (for Gaussian) -->

                                        <TextBlock Text="{Binding E, StringFormat='Tham số E: {0:F2}'}" 

                                                   FontSize="12" Margin="0,5,0,2"/>

                                        <Slider Value="{Binding E, Mode=TwoWay}" 

                                                Style="{StaticResource ParameterSlider}"/>



                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <Separator Margin="0,10"/>



                    <!-- Insert to Canvas Button -->

                    <Button x:Name="btnInsert" 

                            Content="✅ Chèn Vào Canvas" 

                            Style="{StaticResource InsertButtonStyle}"

                            Click="BtnInsert_Click"

                            HorizontalAlignment="Stretch"/>



                    <!-- Guide Panel -->

                    <Border Background="#FFF3E0" 

                            BorderBrush="#FF9800" 

                            BorderThickness="1"

                            CornerRadius="8" 

                            Padding="12" 

                            Margin="0,15,0,0">

                        <StackPanel>

                            <TextBlock Text="Hướng dẫn:" 

                                       FontWeight="Bold" 

                                       FontSize="13"

                                       Foreground="#E65100"

                                       Margin="0,0,0,8"/>

                            <TextBlock TextWrapping="Wrap" 

                                       FontSize="11" 

                                       Foreground="#5D4037"

                                       LineHeight="18">

                                • Chuột trái + kéo: Xoay camera<LineBreak/>

                                • Chuột phải + kéo: Pan (di chuyển)<LineBreak/>

                                • Cuộn chuột: Zoom in/out<LineBreak/>

                                • Checkbox: Ẩn/hiện đồ thị<LineBreak/>

                                • Sliders: Điều chỉnh tham số<LineBreak/>

                                • Chọn loại hàm để thay đổi công thức

                            </TextBlock>

                        </StackPanel>

                    </Border>



                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>

