<Window x:Class="QASmartTouch.Forms.Form2_16_ProtractorTool"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Protractor Tool - Thước Đo Độ"

        Width="480" Height="330"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False"

        Loaded="Window_Loaded">



    <Grid x:Name="MainGrid" RenderTransformOrigin="0.5,1.0" ClipToBounds="False">

        <Grid.RenderTransform>

            <TransformGroup>

                <ScaleTransform x:Name="ProtractorScale" ScaleX="1" ScaleY="1"/>

                <RotateTransform x:Name="ProtractorRotate" Angle="0"/>

                <TranslateTransform x:Name="ProtractorTranslate" X="0" Y="0"/>

            </TransformGroup>

        </Grid.RenderTransform>



        <Grid x:Name="ProtractorLayerRoot" Margin="20,10,20,0">

            <Grid.RowDefinitions>

                <RowDefinition Height="240"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- Main Protractor Visual -->

            <Grid x:Name="ProtractorVisual">

                <!-- Background Border -->

                <Border x:Name="ProtractorBorder"

                        Background="Transparent"

                        BorderThickness="0"

                        IsHitTestVisible="False"/>



                <!-- Canvas for Drawing Geometry -->

                <Canvas x:Name="ProtractorCanvas" Width="440" Height="240">

                    <!-- Center Point Label -->

                    <Border Canvas.Left="215" Canvas.Top="225"

                            Background="#FF2196F3"

                            Padding="8,2">

                        <TextBlock Text="O" 

                                   FontSize="14" 

                                   FontWeight="Bold"

                                   Foreground="White"/>

                    </Border>



                    <!-- Ray A Handle -->

                    <Ellipse x:Name="RayAHandle"

                             Width="16" Height="16"

                             Fill="#FFFF5722"

                             Stroke="White"

                             StrokeThickness="2"

                             Cursor="Hand"

                             MouseLeftButtonDown="RayAHandle_MouseDown"

                             MouseLeftButtonUp="RayAHandle_MouseUp"

                             MouseMove="RayAHandle_MouseMove"/>



                    <!-- Ray B Handle -->

                    <Ellipse x:Name="RayBHandle"

                             Width="16" Height="16"

                             Fill="#FF4CAF50"

                             Stroke="White"

                             StrokeThickness="2"

                             Cursor="Hand"

                             MouseLeftButtonDown="RayBHandle_MouseDown"

                             MouseLeftButtonUp="RayBHandle_MouseUp"

                             MouseMove="RayBHandle_MouseMove"/>



                    <!-- Angle Display -->

                    <Border x:Name="AngleDisplay"

                            Canvas.Left="190" Canvas.Top="100"

                            Background="#E0FFFFFF"

                            BorderBrush="#FF2196F3"

                            BorderThickness="2"

                            CornerRadius="5"

                            Padding="10,5">

                        <StackPanel>

                            <!-- ✨ NEW: Editable TextBox for angle input -->

                            <TextBox x:Name="AngleInput" 

                                     Text="0.0°"

                                     FontSize="24"

                                     FontWeight="Bold"

                                     Foreground="#FF2196F3"

                                     HorizontalAlignment="Center"

                                     BorderThickness="0"

                                     Background="Transparent"

                                     TextAlignment="Center"

                                     PreviewKeyDown="AngleInput_KeyDown"

                                     GotFocus="AngleInput_GotFocus"

                                     LostFocus="AngleInput_LostFocus"

                                     ToolTip="Click để nhập góc, Enter để áp dụng"/>

                            

                            <!-- ✨ NEW: Complement angle display -->

                            <TextBlock x:Name="ComplementText"

                                       Text="(Bù: 0.0°)"

                                       FontSize="11"

                                       Foreground="#FF9800"

                                       HorizontalAlignment="Center"

                                       Margin="0,2,0,0"/>

                            

                            <TextBlock x:Name="SnapModeText"

                                       Text="Snap: OFF"

                                       FontSize="10"

                                       Foreground="#666666"

                                       HorizontalAlignment="Center"

                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Border>

                </Canvas>

            </Grid>



            <!-- ========== CONTROL PANEL (row 1, ngay dưới thước) ========== -->

            <Border Grid.Row="1"

                    HorizontalAlignment="Center"

                    Background="#F5F8FF"

                    BorderBrush="#CCCCCC"

                    BorderThickness="1"

                    CornerRadius="6"

                    Padding="8,4,8,4"

                    Margin="0,4,0,4">

                <StackPanel Orientation="Vertical">



                    <!-- Hàng 1: Di chuyển + Vẽ hiện tại + Đóng -->

                    <StackPanel Orientation="Horizontal"

                                HorizontalAlignment="Center"

                                Margin="0,2,0,2">

                        <StackPanel.Resources>

                            <Style TargetType="Button" x:Key="CtrlBtnStyle">

                                <Setter Property="Height" Value="28"/>

                                <Setter Property="FontSize" Value="12"/>

                                <Setter Property="FontWeight" Value="SemiBold"/>

                                <Setter Property="Margin" Value="3,0"/>

                                <Setter Property="BorderThickness" Value="1"/>

                                <Setter Property="Cursor" Value="Hand"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"

                                                    BorderBrush="{TemplateBinding BorderBrush}"

                                                    BorderThickness="{TemplateBinding BorderThickness}"

                                                    CornerRadius="6">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </StackPanel.Resources>



                        <!-- Di chuyển -->

                        <Button x:Name="btnMove"

                                Content="✥"

                                Width="30" ToolTip="Di chuyển"

                                Background="#E8EEFF" BorderBrush="#667EEA"

                                Foreground="#667EEA"

                                FontSize="13"

                                Style="{StaticResource CtrlBtnStyle}"

                                Cursor="SizeAll"

                                PreviewMouseDown="btnMove_MouseDown"

                                PreviewMouseUp="btnMove_MouseUp"

                                PreviewMouseMove="btnMove_MouseMove"/>



                        <!-- Vẽ góc hiện tại -->

                        <Button x:Name="btnDrawCurrent"

                                Content="✓ Vẽ góc hiện tại"

                                Width="130" ToolTip="Vẽ góc đang hiển thị lên bảng"

                                Background="#4CAF50" BorderBrush="#388E3C"

                                Foreground="White"

                                FontSize="12"

                                Style="{StaticResource CtrlBtnStyle}"

                                Click="btnDrawCurrent_Click"/>



                        <!-- Đóng -->

                        <Button x:Name="btnClose"

                                Content="✕"

                                Width="30" ToolTip="Đóng"

                                Background="#FF6B6B" BorderBrush="#E53935"

                                Foreground="White"

                                FontSize="13"

                                Style="{StaticResource CtrlBtnStyle}"

                                Click="btnClose_Click"/>

                    </StackPanel>



                    <!-- Hàng 2: Góc nhanh -->

                    <StackPanel Orientation="Horizontal"

                                HorizontalAlignment="Center"

                                Margin="0,0,0,2">

                        <StackPanel.Resources>

                            <Style TargetType="Button" x:Key="AngleButtonStyle">

                                <Setter Property="Background" Value="#FFFFFF"/>

                                <Setter Property="BorderBrush" Value="#BBBBBB"/>

                                <Setter Property="BorderThickness" Value="1"/>

                                <Setter Property="Width" Value="42"/>

                                <Setter Property="Height" Value="24"/>

                                <Setter Property="FontSize" Value="11"/>

                                <Setter Property="FontWeight" Value="Bold"/>

                                <Setter Property="Margin" Value="2,0"/>

                                <Setter Property="Cursor" Value="Hand"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"

                                                    BorderBrush="{TemplateBinding BorderBrush}"

                                                    BorderThickness="{TemplateBinding BorderThickness}"

                                                    CornerRadius="5">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#FF2196F3"/>

                                        <Setter Property="Foreground" Value="White"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </StackPanel.Resources>



                        <Button Content="30°"  ToolTip="Vẽ góc 30°"  Click="btnDraw30_Click"  Style="{StaticResource AngleButtonStyle}"/>

                        <Button Content="45°"  ToolTip="Vẽ góc 45°"  Click="btnDraw45_Click"  Style="{StaticResource AngleButtonStyle}"/>

                        <Button Content="60°"  ToolTip="Vẽ góc 60°"  Click="btnDraw60_Click"  Style="{StaticResource AngleButtonStyle}"/>

                        <Button Content="90°"  ToolTip="Vẽ góc 90°"  Click="btnDraw90_Click"  Style="{StaticResource AngleButtonStyle}"/>

                        <Button Content="120°" ToolTip="Vẽ góc 120°" Click="btnDraw120_Click" Style="{StaticResource AngleButtonStyle}"/>

                        <Button Content="150°" ToolTip="Vẽ góc 150°" Click="btnDraw150_Click" Style="{StaticResource AngleButtonStyle}"/>

                    </StackPanel>



                </StackPanel>

            </Border>



        </Grid>

    </Grid>

</Window>

