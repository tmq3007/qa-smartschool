<Window x:Class="QASmartTouch.Forms.Form5_3_ProgressDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Đang xử lý" 

        Width="450" Height="180"

        WindowStartupLocation="CenterOwner"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False">



    <Border Background="White" 

            CornerRadius="12" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid Margin="25">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <!-- TITLE -->

            <TextBlock x:Name="txtTitle" 

                      Grid.Row="0"

                      Text="Đang xử lý..."

                      FontSize="16"

                      FontWeight="Bold"

                      Foreground="#2F3542"

                      Margin="0,0,0,15"/>



            <!-- STATUS TEXT -->

            <TextBlock x:Name="txtStatus" 

                      Grid.Row="1"

                      Text="Vui lòng đợi trong giây lát..."

                      FontSize="13"

                      Foreground="#57606F"

                      Margin="0,0,0,12"/>



            <!-- PROGRESS BAR -->

            <Grid Grid.Row="2" Margin="0,0,0,15">

                <ProgressBar x:Name="progressBar" 

                            Height="12"

                            Minimum="0"

                            Maximum="100"

                            Value="0"

                            Foreground="#2E86DE"

                            Background="#F1F2F6"

                            BorderThickness="0"/>

                <TextBlock x:Name="txtPercentage" 

                          Text="0%"

                          FontSize="10"

                          FontWeight="Bold"

                          Foreground="White"

                          HorizontalAlignment="Center"

                          VerticalAlignment="Center"/>

            </Grid>



            <!-- CANCEL BUTTON -->

            <Button x:Name="btnCancel" 

                   Grid.Row="3"

                   Content="Hủy"

                   Height="35"

                   Width="100"

                   HorizontalAlignment="Right"

                   Background="#F1F2F6"

                   Foreground="#2F3542"

                   BorderThickness="0"

                   Cursor="Hand"

                   FontSize="12"

                   Click="btnCancel_Click">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                               CornerRadius="6"

                               Padding="15,0">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Button.Template>

                <Button.Style>

                    <Style TargetType="Button">

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#E1E8ED"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Button.Style>

            </Button>



        </Grid>

    </Border>

</Window>

