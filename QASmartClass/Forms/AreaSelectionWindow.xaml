<Window x:Class="QASmartTouch.Forms.AreaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn vùng chụp"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown"
        FontFamily="{StaticResource InterFont}">

    <Grid>
        <!-- Spotlight Overlay: 4 vùng tối xung quanh selection (Phase 4 - NV 4.2) -->
        <Rectangle x:Name="OverlayTop"    Fill="#80000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
        <Rectangle x:Name="OverlayBottom" Fill="#80000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="OverlayLeft"   Fill="#80000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="OverlayRight"  Fill="#80000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- Canvas vẽ selection rectangle và crosshair -->
        <Canvas x:Name="SelectionCanvas" Background="Transparent">
            <!-- Crosshair Lines (Phase 4 - NV 4.4) -->
            <Line x:Name="CrosshairH" Stroke="White" StrokeThickness="0.5" Opacity="0.5" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Line x:Name="CrosshairV" Stroke="White" StrokeThickness="0.5" Opacity="0.5" IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- Selection Rectangle -->
            <Rectangle x:Name="SelectionRect"
                       Stroke="#5C6BC0"
                       StrokeThickness="2"
                       StrokeDashArray="5,3"
                       Fill="Transparent"
                       Visibility="Collapsed"/>

            <!-- Size Label real-time (Phase 4 - NV 4.1) -->
            <Border x:Name="SizeLabel"
                    Background="#2F3542"
                    CornerRadius="4"
                    Padding="8,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtSize"
                           Text="0 × 0"
                           FontSize="11"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Border>
        </Canvas>

        <!-- Hướng dẫn sử dụng (Phase 3 - NV 3.1 + 3.2) -->
        <Border x:Name="InstructionBorder"
                Background="#D92F3542"
                CornerRadius="8"
                Padding="15,10"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,20,0,0">
            <TextBlock x:Name="InstructionText"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       MaxWidth="700"
                       TextAlignment="Center">
                <Run Text="📌 Kéo ngón tay hoặc bút cảm ứng để chọn vùng màn hình"/><LineBreak/>
                <Run Text="📏 Vùng chọn được đặt tự động lên bảng vẽ" FontWeight="Normal" FontSize="13"/><LineBreak/>
                <Run Text="✕ Nhấn ESC hoặc nút X để hủy" FontWeight="Normal" FontSize="13"/>
            </TextBlock>
        </Border>

        <!-- Nút Hủy (Top Right) — NV 2.4: kích thước 60×60 cho cảm ứng -->
        <Button x:Name="btnCancelSelection"
                Width="60" Height="60"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,20,20,0"
                Cursor="Hand"
                Click="btnCancelSelection_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#D32F2F" CornerRadius="30" x:Name="border">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#EF5350"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
