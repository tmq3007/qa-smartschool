<Window x:Class="QASmartTouch.Forms.Form2_6_3DPrismEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chức năng vẽ hình lăng trụ 3D" 
        Height="720" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Label Text Style -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern TabItem Style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="#ECEFF1" 
                                CornerRadius="8,8,0,0" 
                                Margin="0,0,4,0" 
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1,1,1,0"
                                BorderBrush="#CFD8DC">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,3,1,0"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset View Button Style -->
        <Style x:Key="PresetViewButton" TargetType="Button">
            <Setter Property="Background" Value="#F0F4F8"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Footer Action Button Styles -->
        <Style x:Key="FooterConfirmButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterCloseButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterSecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEFF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterInfoButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0277BD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="60"/>
            <!-- 1: Main Content -->
            <RowDefinition Height="*"/>
            <!-- 2: Fixed Footer Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="20,10" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <!-- Prism Icon -->
                            <Path Data="M6,3 L18,3 L22,7 L10,7 Z" Fill="#64B5F6"/>
                            <Path Data="M6,3 L10,7 L10,21 L6,17 Z" Fill="#2196F3"/>
                            <Path Data="M10,7 L22,7 L22,21 L10,21 Z" Fill="#1976D2"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Chức năng vẽ hình lăng trụ 3D" 
                                   FontSize="17" 
                                   FontWeight="Bold" 
                                   Foreground="#212121"/>
                        <TextBlock Text="Công cụ hỗ trợ giảng dạy hình học không gian trực quan" 
                                   FontSize="12" 
                                   Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top-Right Close Button -->
                <Button Grid.Column="1" 
                        Content="✕" 
                        Width="36" Height="36" 
                        FontSize="16" 
                        FontWeight="Bold"
                        Background="Transparent" 
                        Foreground="#757575"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="Đóng cửa sổ">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="15,12,15,10">
            <Grid.ColumnDefinitions>
                <!-- Left: Canvas Area -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Tabs Control Panel -->
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CANVAS AREA -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#CFD8DC" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="0,0,10,0">
                <Grid ClipToBounds="True">
                    <!-- 3D Drawing Canvas with Direct Touch / Mouse Drag -->
                    <Canvas x:Name="canvas3D" 
                            Background="Transparent"
                            ClipToBounds="True"
                            Cursor="SizeAll"/>

                    <!-- Floating Touch Hint Badge -->
                    <Border HorizontalAlignment="Center" 
                            VerticalAlignment="Bottom"
                            Background="#D9263238" 
                            CornerRadius="16" 
                            Padding="16,7" 
                            Margin="0,0,0,14"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖐️ Chạm &amp; kéo trực tiếp trên hình để xoay 3D" 
                                       FontSize="12" 
                                       Foreground="White" 
                                       FontWeight="Medium"/>
                            <TextBlock Text="  •  " FontSize="12" Foreground="#B0BEC5"/>
                            <TextBlock Text="🔍 Lăn chuột để thay đổi chiều cao" 
                                       FontSize="12" 
                                       Foreground="#ECEFF1" 
                                       FontWeight="Normal"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: TABBED CONTROL PANEL -->
            <Border Grid.Column="1" 
                    Background="White" 
                    BorderBrush="#CFD8DC" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="10">
                <TabControl BorderThickness="0" Background="Transparent">
                    
                    <!-- TAB 1: KÍCH THƯỚC & ĐÁY -->
                    <TabItem Header="📏 Kích thước" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- STATS PANEL -->
                                <Border Background="#FFF8E1" 
                                        BorderBrush="#FFB300" 
                                        BorderThickness="0,0,0,3" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📊 Thông số hình học hiện tại:" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#E65100"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock x:Name="txtBaseType" Text="• Loại đáy: Hình vuông" FontSize="12" Foreground="#4E342E" Margin="0,2"/>
                                        <TextBlock x:Name="txtBaseSize" Text="• Cạnh đáy: 100" FontSize="12" Foreground="#4E342E" Margin="0,2"/>
                                        <TextBlock x:Name="txtHeight" Text="• Chiều cao (h): 200" FontSize="12" Foreground="#4E342E" Margin="0,2"/>
                                        <TextBlock x:Name="txtBaseEdges" Text="• Số cạnh đáy: 4" FontSize="12" Foreground="#4E342E" Margin="0,2"/>
                                        <TextBlock x:Name="txtVertices" Text="• Số đỉnh: 8" FontSize="12" Foreground="#4E342E" Margin="0,2"/>
                                        <Separator Margin="0,6" Background="#FFE082"/>
                                        <TextBlock x:Name="txtVolume" Text="• Thể tích: 2,000,000 đvtt" FontSize="12" FontWeight="Bold" Foreground="#E65100" Margin="0,2"/>
                                        <TextBlock x:Name="txtBaseArea" Text="• Diện tích đáy: 10,000 đvdt" FontSize="12" Foreground="#E65100" Margin="0,2"/>
                                        <TextBlock x:Name="txtLateralArea" Text="• Diện tích xung quanh: 80,000 đvdt" FontSize="12" Foreground="#E65100" Margin="0,2"/>
                                        <TextBlock x:Name="txtTotalArea" Text="• Diện tích toàn phần: 100,000 đvdt" FontSize="12" FontWeight="Bold" Foreground="#E65100" Margin="0,2"/>
                                    </StackPanel>
                                </Border>

                                <!-- BASE TYPE & DIMENSIONS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📐 Kiểu đáy &amp; Kích thước" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <!-- Base Type Selection -->
                                        <TextBlock Text="Hình dạng đáy:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmbBaseType" 
                                                  Height="34" 
                                                  FontSize="12"
                                                  Margin="0,0,0,10"
                                                  SelectionChanged="OnBaseTypeChanged" 
                                                  SelectedIndex="1">
                                            <ComboBoxItem Content="🔺 Tam giác (Triangle)" Tag="Triangle"/>
                                            <ComboBoxItem Content="🔲 Vuông (Square)" Tag="Square"/>
                                            <ComboBoxItem Content="⬠ Ngũ giác (Pentagon)" Tag="Pentagon"/>
                                            <ComboBoxItem Content="⬡ Lục giác (Hexagon)" Tag="Hexagon"/>
                                        </ComboBox>

                                        <!-- Base Size -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Độ dài cạnh đáy:" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding ElementName=sliderBaseSize, Path=Value, StringFormat={}{0:F0}}" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="sliderBaseSize" 
                                                Minimum="30" Maximum="150" Value="100" 
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="OnDimensionChanged"/>

                                        <!-- Height -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Chiều cao hình lăng trụ (h):" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding ElementName=sliderHeight, Path=Value, StringFormat={}{0:F0}}" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="sliderHeight" 
                                                Minimum="50" Maximum="300" Value="200" 
                                                TickFrequency="10" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="OnDimensionChanged"/>

                                        <!-- Thickness -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Độ dày nét viền:" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding ElementName=sliderThickness, Path=Value, StringFormat={}{0:F1}}" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="sliderThickness" 
                                                Minimum="0.5" Maximum="5" Value="1.5" 
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,4"
                                                ValueChanged="OnThicknessChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: HIỂN THỊ & MÀU SẮC -->
                    <TabItem Header="🎨 Hiển thị &amp; Màu" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- DRAWING MODE -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🖼️ Chế độ vẽ &amp; Nét hiển thị" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <RadioButton x:Name="rbWireframe" Content="Khung dây" 
                                                         IsChecked="True" Margin="0,0,15,0" Checked="OnDrawingModeChanged"/>
                                            <RadioButton x:Name="rbSolid" Content="Tô màu" 
                                                         Margin="0,0,15,0" Checked="OnDrawingModeChanged"/>
                                            <RadioButton x:Name="rbBoth" Content="Cả hai" 
                                                         Checked="OnDrawingModeChanged"/>
                                        </StackPanel>

                                        <!-- Hidden Edges Option -->
                                        <CheckBox x:Name="chkShowHiddenEdges" 
                                                  Content="Hiển thị nét đứt (Cạnh khuất)" 
                                                  IsChecked="True" 
                                                  FontSize="12"
                                                  Foreground="#424242"
                                                  Margin="0,2,0,6"
                                                  Checked="chkShowHiddenEdges_Click"
                                                  Unchecked="chkShowHiddenEdges_Click"/>

                                        <!-- Vertex Labels Option -->
                                        <CheckBox x:Name="chkShowVertexLabels" 
                                                  Content="Hiển thị nhãn đỉnh (A, B, C, A', B'...)" 
                                                  IsChecked="True" 
                                                  FontSize="12"
                                                  Foreground="#424242"
                                                  Margin="0,0,0,8"
                                                  Checked="chkShowVertexLabels_Click"
                                                  Unchecked="chkShowVertexLabels_Click"/>

                                        <!-- Opacity -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Độ trong suốt màu mặt:" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding ElementName=sliderOpacity, Path=Value, StringFormat={}{0:F0}%}" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="sliderOpacity" 
                                                Minimum="0" Maximum="100" Value="70" 
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,4"
                                                ValueChanged="OnOpacityChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- COLORS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎨 Bảng màu sắc" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <!-- Face Color Picker -->
                                        <TextBlock Text="Màu mặt (Face):" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="cmbFaceColor" 
                                                      Grid.Column="0"
                                                      Height="34" 
                                                      FontSize="12"
                                                      SelectedIndex="0"
                                                      SelectionChanged="OnFaceColorChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                                    BorderBrush="#999" BorderThickness="1"/>
                                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <ComboBoxItem Content="Trong suốt (Transparent)" Tag="Transparent"/>
                                                <ComboBoxItem Content="Trắng (White)" Tag="White"/>
                                                <ComboBoxItem Content="Đỏ (Red)" Tag="Red"/>
                                                <ComboBoxItem Content="Xanh lá (Green)" Tag="Green"/>
                                                <ComboBoxItem Content="Xanh dương (Blue)" Tag="Blue"/>
                                                <ComboBoxItem Content="Vàng (Yellow)" Tag="Yellow"/>
                                                <ComboBoxItem Content="Tím (Purple)" Tag="Purple"/>
                                                <ComboBoxItem Content="Cam (Orange)" Tag="Orange"/>
                                                <ComboBoxItem Content="Nâu (Brown)" Tag="Brown"/>
                                            </ComboBox>

                                            <Border Grid.Column="1" 
                                                    x:Name="FaceColorPreview"
                                                    CornerRadius="4" 
                                                    Margin="8,0,0,0"
                                                    Background="Transparent"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1"/>
                                        </Grid>

                                        <!-- Edge Color Picker -->
                                        <TextBlock Text="Màu viền (Edge):" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="cmbEdgeColor" 
                                                      Grid.Column="0"
                                                      Height="34" 
                                                      FontSize="12"
                                                      SelectedIndex="0"
                                                      SelectionChanged="OnEdgeColorChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                                    BorderBrush="#999" BorderThickness="1"/>
                                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <ComboBoxItem Content="Đen (Black)" Tag="Black"/>
                                                <ComboBoxItem Content="Trắng (White)" Tag="White"/>
                                                <ComboBoxItem Content="Đỏ (Red)" Tag="Red"/>
                                                <ComboBoxItem Content="Xanh lá (Green)" Tag="Green"/>
                                                <ComboBoxItem Content="Xanh dương (Blue)" Tag="Blue"/>
                                                <ComboBoxItem Content="Vàng (Yellow)" Tag="Yellow"/>
                                                <ComboBoxItem Content="Tím (Purple)" Tag="Purple"/>
                                                <ComboBoxItem Content="Cam (Orange)" Tag="Orange"/>
                                            </ComboBox>

                                            <Border Grid.Column="1" 
                                                    x:Name="EdgeColorPreview"
                                                    Background="Black" 
                                                    CornerRadius="4" 
                                                    Margin="8,0,0,0"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: GÓC XOAY & QUAN SÁT -->
                    <TabItem Header="🔄 Góc xoay" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- PRESET VIEWS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Góc nhìn chuẩn nhanh" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <UniformGrid Columns="2" Rows="2">
                                            <Button Content="👁️ Chính diện" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="0,0,4,6"
                                                    Click="BtnPresetFront_Click"
                                                    ToolTip="Góc nhìn thẳng trực diện"/>
                                            <Button Content="📐 Phối cảnh 60°" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="4,0,0,6"
                                                    Click="BtnPresetPerspective_Click"
                                                    ToolTip="Góc nhìn phối cảnh sư phạm trực quan"/>
                                            <Button Content="🔝 Từ trên xuống" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="0,0,4,0"
                                                    Click="BtnPresetTop_Click"
                                                    ToolTip="Góc nhìn từ đỉnh xuống đáy"/>
                                            <Button Content="🧊 Đẳng cự 30°" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="4,0,0,0"
                                                    Click="BtnPresetIsometric_Click"
                                                    ToolTip="Góc nhìn đẳng cự kỹ thuật"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- ROTATION SLIDERS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🔄 Điều chỉnh góc xoay" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="#37474F"/>
                                            <CheckBox x:Name="chkAutoRotate" 
                                                      Content="Tự động xoay" 
                                                      FontSize="12"
                                                      Foreground="#1976D2"
                                                      FontWeight="SemiBold"
                                                      HorizontalAlignment="Right"
                                                      Checked="OnAutoRotateChanged"
                                                      Unchecked="OnAutoRotateChanged"/>
                                        </Grid>

                                        <!-- Rotation X -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Xoay trục X (Nghiêng lên/xuống):" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding ElementName=sliderRotationX, Path=Value, StringFormat={}{0:F0}°}" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="sliderRotationX" 
                                                Minimum="0" Maximum="360" Value="0" 
                                                TickFrequency="15" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="OnRotationChanged"/>

                                        <!-- Rotation Y -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Xoay trục Y (Quay trái/phải):" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding ElementName=sliderRotationY, Path=Value, StringFormat={}{0:F0}°}" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="sliderRotationY" 
                                                Minimum="0" Maximum="360" Value="30" 
                                                TickFrequency="15" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="OnRotationChanged"/>

                                        <!-- Rotation Z -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Xoay trục Z (Nghiêng mặt phẳng):" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding ElementName=sliderRotationZ, Path=Value, StringFormat={}{0:F0}°}" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="sliderRotationZ" 
                                                Minimum="0" Maximum="360" Value="0" 
                                                TickFrequency="15" IsSnapToTickEnabled="True"
                                                Margin="0,4,0,4"
                                                ValueChanged="OnRotationChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- FOOTER: FIXED ACTION BAR (Không bao giờ bị cuộn) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="15,10">
            <Grid>
                <!-- Trái: Các nút tính năng phụ trợ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="btnReset"
                            Content="🔄 Đặt lại mặc định"
                            Style="{StaticResource FooterSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="btnReset_Click"
                            ToolTip="Đặt lại tất cả kích thước và góc nhìn về ban đầu"/>

                    <Button x:Name="btnDownload"
                            Content="💾 Tải ảnh PNG"
                            Style="{StaticResource FooterSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="btnDownload_Click"
                            ToolTip="Xuất hình khối lăng trụ ra file ảnh chất lượng cao lưu vào máy"/>

                    <Button x:Name="btnDisplayStats"
                            Content="📋 Chèn kèm bảng thông số"
                            Style="{StaticResource FooterInfoButton}"
                            Click="btnDisplayStats_Click"
                            ToolTip="Chèn hình lăng trụ kèm theo bảng chi tiết diện tích &amp; thể tích vào bài giảng"/>
                </StackPanel>

                <!-- Phải: Các nút hành động chính (To, rõ, thân thiện cảm ứng) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnClose"
                            Content="❌ Hủy bỏ"
                            Style="{StaticResource FooterCloseButton}"
                            Margin="0,0,10,0"
                            Click="btnClose_Click"/>

                    <Button x:Name="btnConfirm"
                            Content="✅ Xác nhận chèn vào bảng"
                            Style="{StaticResource FooterConfirmButton}"
                            Click="btnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
