<Window x:Class="QASmartTouch.Forms.Form3_3_CameraConfiguration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QASmartTouch.Controls"
        Title="Cấu hình Thiết bị Camera" 
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ComboBox Style -->
        <Style x:Key="LightComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2F3542"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Wizard Guide -->
            <RowDefinition Height="Auto"/>
            <!-- Settings -->
            <RowDefinition Height="*"/>
            <!-- Preview -->
            <RowDefinition Height="Auto"/>
            <!-- Status -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- WIZARD GUIDE -->
        <Border Grid.Row="0" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="👉 Hướng dẫn cấu hình camera 4 bước: " FontWeight="Bold" Foreground="#1565C0" FontSize="13"/>
                <TextBlock x:Name="tblStep1" Text="1️⃣ Chọn Camera" Foreground="#57606F" FontSize="13" Margin="5,0"/>
                <TextBlock Text="➔" Foreground="#1565C0" FontSize="13" Margin="10,0"/>
                <TextBlock x:Name="tblStep2" Text="2️⃣ Thiết lập thông số" Foreground="#57606F" FontSize="13" Margin="5,0"/>
                <TextBlock Text="➔" Foreground="#1565C0" FontSize="13" Margin="10,0"/>
                <TextBlock x:Name="tblStep3" Text="3️⃣ Thử nghiệm" Foreground="#57606F" FontSize="13" Margin="5,0"/>
                <TextBlock Text="➔" Foreground="#1565C0" FontSize="13" Margin="10,0"/>
                <TextBlock x:Name="tblStep4" Text="4️⃣ Lưu cấu hình" Foreground="#57606F" FontSize="13" Margin="5,0"/>
            </StackPanel>
        </Border>

        <!-- SETTINGS SECTION -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Camera Device -->
            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="Thiết bị Camera:" 
                       Foreground="#2F3542"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,15"/>
            <ComboBox x:Name="cmbCameraDevice" 
                      Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource LightComboBoxStyle}"
                      Margin="0,0,10,15"
                      SelectionChanged="cmbCameraDevice_SelectionChanged"/>
            <Button x:Name="btnRefresh"
                    Grid.Row="0" Grid.Column="2"
                    Background="#4CAF50"
                    Foreground="White"
                    Padding="15,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,15"
                    Click="btnRefresh_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="White" 
                          Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                          Width="16" Height="16"
                          Margin="0,0,5,0"/>
                    <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Resolution -->
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,15">
                <TextBlock Text="Độ phân giải:" Foreground="#2F3542" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text=" ❔" Foreground="#2E86DE" FontSize="14" FontWeight="Bold" Cursor="Help" ToolTip="Chọn độ phân giải phù hợp. Độ phân giải cao sắc nét hơn nhưng tốn tài nguyên máy, khuyên dùng 1280x720 (720p) để chạy mượt nhất."/>
            </StackPanel>
            <ComboBox x:Name="cmbResolution" 
                      Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                      Style="{StaticResource LightComboBoxStyle}"
                      Margin="0,0,0,15"
                      SelectionChanged="cmbResolution_SelectionChanged"/>

            <!-- Frame Rate -->
            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Tốc độ khung hình:" Foreground="#2F3542" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text=" ❔" Foreground="#2E86DE" FontSize="14" FontWeight="Bold" Cursor="Help" ToolTip="Tốc độ khung hình (FPS) quyết định độ mượt của chuyển động video. Khuyên dùng 30 FPS."/>
            </StackPanel>
            <ComboBox x:Name="cmbFrameRate" 
                      Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                      Style="{StaticResource LightComboBoxStyle}"
                      SelectionChanged="cmbFrameRate_SelectionChanged"/>
        </Grid>

        <!-- CAMERA PREVIEW -->
        <Border Grid.Row="2" 
                BorderBrush="#2E86DE" 
                BorderThickness="2" 
                CornerRadius="6"
                Background="#1E1E1E"
                Margin="0,0,0,15">
            <Grid>
                <!-- Preview Control -->
                <controls:CameraPreviewControl x:Name="cameraPreview"/>
                
                <!-- Placeholder (shown when no preview) -->
                <StackPanel x:Name="placeholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- Vector diagram representing proper camera placement -->
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" MaxHeight="220">
                        <Canvas Width="300" Height="170" HorizontalAlignment="Center">
                            <!-- Desktop surface -->
                            <Line X1="10" Y1="150" X2="290" Y2="150" Stroke="#555555" StrokeThickness="2"/>
                            
                            <!-- Student representation (Path body + Ellipse head) -->
                            <Path Data="M 70,150 L 70,110 Q 70,95 85,90 L 105,90 Q 120,95 120,110 L 120,150 Z" Fill="#2E86DE" Opacity="0.8"/>
                            <Ellipse Canvas.Left="82" Canvas.Top="55" Width="30" Height="30" Fill="#2E86DE"/>
                            <TextBlock Canvas.Left="67" Canvas.Top="154" Text="Học sinh" FontSize="11" Foreground="#E1E8ED" FontWeight="Bold"/>

                            <!-- Camera stand and body angled at 45 degrees -->
                            <Line X1="220" Y1="150" X2="220" Y2="70" Stroke="#777777" StrokeThickness="3"/>
                            <Path Data="M 205,65 L 235,45 L 245,60 L 215,80 Z" Fill="#FF9800"/>
                            <Ellipse Canvas.Left="203" Canvas.Top="60" Width="10" Height="10" Fill="#E91E63"/>

                            <!-- 45 degrees dashed sight line directed to the student's face -->
                            <Line X1="210" Y1="65" X2="97" Y2="70" Stroke="#FF9800" StrokeDashArray="3,3" StrokeThickness="2"/>
                            
                            <!-- Explanatory Tooltip Labels -->
                            <Border Canvas.Left="180" Canvas.Top="15" Background="#333333" CornerRadius="4" Padding="6,3">
                                <TextBlock Text="Góc nghiêng tối ưu: 45°" FontSize="10" Foreground="White"/>
                            </Border>
                            <Border Canvas.Left="125" Canvas.Top="122" Background="#333333" CornerRadius="4" Padding="6,3">
                                <TextBlock Text="Khoảng cách khuyến nghị: 50cm - 80cm" FontSize="10" Foreground="White"/>
                            </Border>
                        </Canvas>
                    </Viewbox>
                    
                    <TextBlock Text="Xem trước Camera" 
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#E1E8ED"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Nhấp 'Thử nghiệm Camera' để kiểm tra hình ảnh trực tiếp" 
                               FontSize="12"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <TextBlock x:Name="txtStatus"
                       Text="Trạng thái: Sẵn sàng" 
                       Foreground="#4CAF50"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="txtFPS"
                       Text="Khung hình/giây (FPS): 0.0" 
                       Foreground="#2E86DE"
                       FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ACTION BUTTONS -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button x:Name="btnTest"
                    Background="#2E86DE"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,10,0"
                    Click="btnTest_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="White" 
                          Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                          Width="14" Height="14"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Thử nghiệm Camera" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnStop"
                    Background="#F44336"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="btnStop_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="White" 
                          Data="M18,18H6V6H18V18Z"
                          Width="14" Height="14"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Dừng" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnSave"
                    Background="#4CAF50"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="btnSave_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="White" 
                          Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                          Width="14" Height="14"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Lưu cấu hình" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
