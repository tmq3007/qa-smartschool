<Window x:Class="QASmartTouch.Forms.CalculatorWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Calculator" 

        Height="570" Width="400"

        WindowStartupLocation="CenterScreen"

        ResizeMode="NoResize"

        Background="White">

    

    <!-- Styles -->

    <Window.Resources>

        <!-- Memory Button Style -->

        <Style x:Key="MemoryButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#666666"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Margin" Value="1"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#F0F0F0"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        

        <!-- Number Button Style -->

        <Style x:Key="NumberButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#F3F3F3"/>

            <Setter Property="Foreground" Value="Black"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="FontSize" Value="18"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Margin" Value="2"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#E0E0E0"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        

        <!-- Function Button Style -->

        <Style x:Key="FunctionButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#F3F3F3"/>

            <Setter Property="Foreground" Value="Black"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="Margin" Value="2"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#E0E0E0"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        

        <!-- Operator Button Style -->

        <Style x:Key="OperatorButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#F3F3F3"/>

            <Setter Property="Foreground" Value="Black"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="FontSize" Value="18"/>

            <Setter Property="Margin" Value="2"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#E0E0E0"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        

        <!-- Equals Button Style (Blue) -->

        <Style x:Key="EqualsButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#0078D4"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="FontSize" Value="18"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Margin" Value="2"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#005A9E"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="40"/>   <!-- Header -->

            <RowDefinition Height="100"/>  <!-- Display (increased from 80) -->

            <RowDefinition Height="40"/>   <!-- Memory buttons -->

            <RowDefinition Height="*"/>    <!-- Main grid -->

        </Grid.RowDefinitions>

        

        <!-- Header Bar -->

        <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">

            <Grid Margin="10,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                

                <TextBlock Grid.Column="0" Text="Standard" 

                          VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>

                <TextBlock x:Name="txtMemoryIndicator" Grid.Column="1" Text="" 

                          HorizontalAlignment="Right" VerticalAlignment="Center"

                          FontSize="12" Foreground="#666666" Visibility="Collapsed"/>

            </Grid>

        </Border>

        

        <!-- Display (2 lines: Expression + Result) -->

        <Border Grid.Row="1" Background="White" 

               BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"

               Padding="15">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>  <!-- Expression -->

                    <RowDefinition Height="*"/>     <!-- Result -->

                </Grid.RowDefinitions>

                

                <!-- Expression Display (Top - shows calculation) -->

                <TextBlock x:Name="txtExpression" 

                          Grid.Row="0"

                          Text="" 

                          FontSize="14" 

                          Foreground="#666666"

                          HorizontalAlignment="Right" 

                          VerticalAlignment="Top"

                          Margin="0,0,0,5"/>

                

                <!-- Result Display (Bottom - shows current value) -->

                <TextBlock x:Name="txtDisplay" 

                          Grid.Row="1"

                          Text="0" 

                          FontSize="40" 

                          FontWeight="SemiBold"

                          HorizontalAlignment="Right" 

                          VerticalAlignment="Bottom"/>

            </Grid>

        </Border>

        

        <!-- Memory Buttons -->

        <UniformGrid Grid.Row="2" Rows="1" Columns="6" Margin="5,5,5,0">

            <Button Content="MC" Click="BtnMemoryClear_Click" Style="{StaticResource MemoryButtonStyle}"/>

            <Button Content="MR" Click="BtnMemoryRecall_Click" Style="{StaticResource MemoryButtonStyle}"/>

            <Button Content="M+" Click="BtnMemoryAdd_Click" Style="{StaticResource MemoryButtonStyle}"/>

            <Button Content="M-" Click="BtnMemorySubtract_Click" Style="{StaticResource MemoryButtonStyle}"/>

            <Button Content="MS" Click="BtnMemoryStore_Click" Style="{StaticResource MemoryButtonStyle}"/>

            <Button Content="M∨" Click="BtnMemoryDropdown_Click" Style="{StaticResource MemoryButtonStyle}"/>

        </UniformGrid>

        

        <!-- Main Calculator Grid -->

        <Grid Grid.Row="3" Margin="5">

            <Grid.RowDefinitions>

                <RowDefinition/>

                <RowDefinition/>

                <RowDefinition/>

                <RowDefinition/>

                <RowDefinition/>

                <RowDefinition/>

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition/>

            </Grid.ColumnDefinitions>

            

            <!-- Row 0: Functions -->

            <Button Grid.Row="0" Grid.Column="0" Content="%" 

                   Click="BtnPercent_Click" Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="1" Content="CE" 

                   Click="BtnClearEntry_Click" Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="2" Content="C" 

                   Click="BtnClear_Click" Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="3" Content="⌫" 

                   Click="BtnBackspace_Click" Style="{StaticResource FunctionButtonStyle}"/>

            

            <!-- Row 1: Advanced -->

            <Button Grid.Row="1" Grid.Column="0" Content="¹⁄ₓ" 

                   Click="BtnReciprocal_Click" Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="1" Content="x²" 

                   Click="BtnSquare_Click" Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="2" 

                   Click="BtnSqrt_Click" Style="{StaticResource FunctionButtonStyle}">

                <Grid Width="35" Height="20">

                    <!-- Custom radical symbol with horizontal bar -->

                    <Path Data="M 3,14 L 6,10 L 9,17 L 13,3 L 32,3" 

                          Stroke="#2F3542" 

                          StrokeThickness="1.8" 

                          StrokeLineJoin="Miter"

                          VerticalAlignment="Center"

                          HorizontalAlignment="Left"/>

                    <!-- Variable x -->

                    <TextBlock Text="x" 

                              FontSize="14" 

                              Margin="18,0,0,0"

                              VerticalAlignment="Center"/>

                </Grid>

            </Button>

            <Button Grid.Row="1" Grid.Column="3" Content="÷" 

                   Click="BtnOperator_Click" Tag="/" Style="{StaticResource OperatorButtonStyle}"/>

            

            <!-- Row 2: 7 8 9 × -->

            <Button Grid.Row="2" Grid.Column="0" Content="7" 

                   Click="BtnNumber_Click" Tag="7" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="1" Content="8" 

                   Click="BtnNumber_Click" Tag="8" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="2" Content="9" 

                   Click="BtnNumber_Click" Tag="9" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="3" Content="×" 

                   Click="BtnOperator_Click" Tag="*" Style="{StaticResource OperatorButtonStyle}"/>

            

            <!-- Row 3: 4 5 6 − -->

            <Button Grid.Row="3" Grid.Column="0" Content="4" 

                   Click="BtnNumber_Click" Tag="4" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="1" Content="5" 

                   Click="BtnNumber_Click" Tag="5" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="2" Content="6" 

                   Click="BtnNumber_Click" Tag="6" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="3" Content="−" 

                   Click="BtnOperator_Click" Tag="-" Style="{StaticResource OperatorButtonStyle}"/>

            

            <!-- Row 4: 1 2 3 + -->

            <Button Grid.Row="4" Grid.Column="0" Content="1" 

                   Click="BtnNumber_Click" Tag="1" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="4" Grid.Column="1" Content="2" 

                   Click="BtnNumber_Click" Tag="2" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="4" Grid.Column="2" Content="3" 

                   Click="BtnNumber_Click" Tag="3" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="4" Grid.Column="3" Content="+" 

                   Click="BtnOperator_Click" Tag="+" Style="{StaticResource OperatorButtonStyle}"/>

            

            <!-- Row 5: +/− 0 . = -->

            <Button Grid.Row="5" Grid.Column="0" Content="+/−" 

                   Click="BtnNegate_Click" Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="5" Grid.Column="1" Content="0" 

                   Click="BtnNumber_Click" Tag="0" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="5" Grid.Column="2" Content="." 

                   Click="BtnDecimal_Click" Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="5" Grid.Column="3" Content="=" 

                   Click="BtnEquals_Click" Style="{StaticResource EqualsButtonStyle}"/>

        </Grid>

    </Grid>

</Window>

