<Window x:Class="iProSmartScreen.Forms.Form2_6_3DSphereEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎨 Chức năng vẽ hình cầu 3D" 
        Height="720" Width="1200"
        MinHeight="720" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF6674EA"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="6"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Label Text Style -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="15,10" 
               BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="30" Height="30" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <!-- Sphere Icon -->
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" 
                                    Fill="#2196F3" Opacity="0.7"/>
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" 
                                    Stroke="#1976D2" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="7" Canvas.Top="2" Width="10" Height="20" 
                                    Stroke="#1976D2" StrokeThickness="1" Opacity="0.5"/>
                            <Ellipse Canvas.Left="2" Canvas.Top="7" Width="20" Height="10" 
                                    Stroke="#1976D2" StrokeThickness="1" Opacity="0.5"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Chức năng vẽ hình cầu 3D" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="#212121"/>
                        <TextBlock Text="Công cụ hỗ trợ giảng dạy hình học không gian" 
                                  FontSize="11" 
                                  Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Background="White" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Canvas Area -->
                <ColumnDefinition Width="350"/>
                <!-- Control Panel -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: CANVAS AREA -->
            <Border Grid.Column="0" 
                   Background="White" 
                   BorderBrush="#E0E0E0" 
                   BorderThickness="1" 
                   CornerRadius="10" 
                   Margin="0,0,8,0">
                <Canvas x:Name="SphereCanvas" 
                       Background="White"
                       ClipToBounds="True"/>
            </Border>

            <!-- RIGHT: CONTROL PANEL -->
            <Border Grid.Column="1" 
                   Background="#FAFAFA" 
                   BorderBrush="#E0E0E0" 
                   BorderThickness="1" 
                   CornerRadius="10" 
                   Padding="15"
                   Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- STATS PANEL -->
                        <Border Background="#FFF3CD" 
                               BorderBrush="#FFC107" 
                               BorderThickness="0,0,0,3" 
                               CornerRadius="6" 
                               Padding="10" 
                               Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📊 Thông số hiện tại:" 
                                          FontSize="13" 
                                          FontWeight="Bold" 
                                          Foreground="#E65100"
                                          Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="• Bán kính: " FontSize="11" Foreground="#5D4037"/>
                                    <TextBlock x:Name="txtRadius" Text="100" FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="• Số vĩ tuyến: " FontSize="11" Foreground="#5D4037"/>
                                    <TextBlock x:Name="txtLatSegments" Text="16" FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="• Số kinh tuyến: " FontSize="11" Foreground="#5D4037"/>
                                    <TextBlock x:Name="txtLongSegments" Text="16" FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="• Diện tích: " FontSize="11" Foreground="#5D4037"/>
                                    <TextBlock x:Name="txtSurfaceArea" Text="125,664 đvdt" FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="• Thể tích: " FontSize="11" Foreground="#5D4037"/>
                                    <TextBlock x:Name="txtVolume" Text="4,188,790 đvtt" FontSize="11" Foreground="#E65100" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ROTATION CONTROLS -->
                        <Border Background="White" 
                               BorderBrush="#E0E0E0" 
                               BorderThickness="1" 
                               CornerRadius="6" 
                               Padding="10" 
                               Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#2196F3" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,6V14L15.2,16.2L16,14.9L12.5,13.1V6H11Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Điều khiển xoay" 
                                              FontSize="13" 
                                              FontWeight="Bold" 
                                              Foreground="#424242"/>
                                </StackPanel>

                                <!-- Rotation X -->
                                <StackPanel Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="Xoay trục X:" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="RotXValue" Text="0°" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Slider x:Name="RotXSlider" 
                                           Minimum="0" Maximum="360" 
                                           Value="0"
                                           TickFrequency="15" 
                                           IsSnapToTickEnabled="True"
                                           Margin="0,5,0,0"
                                           ValueChanged="RotationSlider_ValueChanged"/>
                                </StackPanel>

                                <!-- Rotation Y -->
                                <StackPanel Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="Xoay trục Y:" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="RotYValue" Text="60°" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Slider x:Name="RotYSlider" 
                                           Minimum="0" Maximum="360" 
                                           Value="60"
                                           TickFrequency="15" 
                                           IsSnapToTickEnabled="True"
                                           Margin="0,5,0,0"
                                           ValueChanged="RotationSlider_ValueChanged"/>
                                </StackPanel>

                                <!-- Rotation Z -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Xoay trục Z:" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="RotZValue" Text="0°" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Slider x:Name="RotZSlider" 
                                           Minimum="0" Maximum="360" 
                                           Value="0"
                                           TickFrequency="15" 
                                           IsSnapToTickEnabled="True"
                                           Margin="0,5,0,0"
                                           ValueChanged="RotationSlider_ValueChanged"/>

                                <!-- Auto Rotate -->
                                <CheckBox x:Name="chkAutoRotate" Content="🔄 Tự động xoay" 
                                          FontSize="12" 
                                          Margin="0,12,0,0"
                                          Checked="OnAutoRotateChanged"
                                          Unchecked="OnAutoRotateChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SIZE CONTROL -->
                        <Border Background="White" 
                               BorderBrush="#E0E0E0" 
                               BorderThickness="1" 
                               CornerRadius="6" 
                               Padding="10" 
                               Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#4CAF50" Data="M19,6H22V8H19V11H17V8H14V6H17V3H19V6M17,17V14H19V19H3V6H11V8H5V17H17Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Kích thước" 
                                              FontSize="13" 
                                              FontWeight="Bold" 
                                              Foreground="#424242"/>
                                </StackPanel>

                                <Grid>
                                    <TextBlock Text="Độ dài cạnh:" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="RadiusValue" Text="100" Style="{StaticResource ValueText}"/>
                                </Grid>
                                <Slider x:Name="RadiusSlider" 
                                       Minimum="50" Maximum="200" 
                                       Value="100"
                                       TickFrequency="10" 
                                       IsSnapToTickEnabled="True"
                                       Margin="0,5,0,0"
                                       ValueChanged="RadiusSlider_ValueChanged"/>
                                
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="Độ dày nét viền:" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="ThicknessValue" Text="1.5" Style="{StaticResource ValueText}"/>
                                </Grid>
                                <Slider x:Name="ThicknessSlider" 
                                       Minimum="0.5" Maximum="5" 
                                       Value="1.5"
                                       Margin="0,5,0,0"
                                       ValueChanged="ThicknessSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- SEGMENTS CONTROL -->
                        <Border Background="White" 
                               BorderBrush="#E0E0E0" 
                               BorderThickness="1" 
                               CornerRadius="6" 
                               Padding="10" 
                               Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FF9800" Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Độ mịn" 
                                              FontSize="13" 
                                              FontWeight="Bold" 
                                              Foreground="#424242"/>
                                </StackPanel>

                                <!-- Latitude Segments -->
                                <StackPanel Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="Vĩ tuyến (Latitude):" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="LatSegmentsValue" Text="16" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Slider x:Name="LatSegmentsSlider" 
                                           Minimum="8" Maximum="32" 
                                           Value="16"
                                           TickFrequency="2" 
                                           IsSnapToTickEnabled="True"
                                           Margin="0,5,0,0"
                                           ValueChanged="SegmentsSlider_ValueChanged"/>
                                </StackPanel>

                                <!-- Longitude Segments -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Kinh tuyến (Longitude):" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="LongSegmentsValue" Text="16" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Slider x:Name="LongSegmentsSlider" 
                                           Minimum="8" Maximum="32" 
                                           Value="16"
                                           TickFrequency="2" 
                                           IsSnapToTickEnabled="True"
                                           Margin="0,5,0,0"
                                           ValueChanged="SegmentsSlider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- DISPLAY MODE & COLORS -->
                        <Border Background="White" 
                               BorderBrush="#E0E0E0" 
                               BorderThickness="1" 
                               CornerRadius="6" 
                               Padding="10" 
                               Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Viewbox Width="18" Height="18" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#9C27B0" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Kiểu hiển thị" 
                                              FontSize="13" 
                                              FontWeight="Bold" 
                                              Foreground="#424242"/>
                                </StackPanel>

                                <!-- Drawing Mode -->
                                <TextBlock Text="Chế độ vẽ:" 
                                          Style="{StaticResource LabelText}" 
                                          Margin="0,0,0,5"/>
                                <ComboBox x:Name="DrawModeComboBox" 
                                         Height="32" 
                                         FontSize="12"
                                         SelectionChanged="DrawModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Khung dây (Wireframe)" IsSelected="True"/>
                                    <ComboBoxItem Content="Tô màu mặt (Solid)"/>
                                    <ComboBoxItem Content="Cả hai (Both)"/>
                                </ComboBox>

                                <!-- Edge Color Picker -->
                                <TextBlock Text="Màu viền (Edge):" 
                                          Style="{StaticResource LabelText}" 
                                          Margin="0,8,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ComboBox x:Name="EdgeColorComboBox" 
                                             Grid.Column="0"
                                             Height="32" 
                                             FontSize="12"
                                             SelectionChanged="EdgeColorComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                            Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                            BorderBrush="#999" BorderThickness="1"/>
                                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBoxItem Content="Đen (Black)" Tag="Black" IsSelected="True"/>
                                        <ComboBoxItem Content="Trắng (White)" Tag="White"/>
                                        <ComboBoxItem Content="Đỏ (Red)" Tag="Red"/>
                                        <ComboBoxItem Content="Xanh lá (Green)" Tag="Green"/>
                                        <ComboBoxItem Content="Xanh dương (Blue)" Tag="Blue"/>
                                        <ComboBoxItem Content="Vàng (Yellow)" Tag="Yellow"/>
                                        <ComboBoxItem Content="Tím (Purple)" Tag="Purple"/>
                                        <ComboBoxItem Content="Cam (Orange)" Tag="Orange"/>
                                    </ComboBox>

                                    <Border Grid.Column="1" 
                                           x:Name="EdgeColorPreview"
                                           CornerRadius="5" 
                                           Margin="10,0,0,0"
                                           BorderBrush="#CCCCCC"
                                           BorderThickness="2">
                                        <Border.Background>
                                            <SolidColorBrush Color="Black"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <!-- Face Color Picker -->
                                <TextBlock Text="Màu mặt (Face):" 
                                          Style="{StaticResource LabelText}" 
                                          Margin="0,8,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ComboBox x:Name="FaceColorComboBox" 
                                             Grid.Column="0"
                                             Height="32" 
                                             FontSize="12"
                                             SelectionChanged="FaceColorComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                            Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                            BorderBrush="#999" BorderThickness="1"/>
                                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBoxItem Content="Trong suốt (Transparent)" Tag="Transparent" IsSelected="True"/>
                                        <ComboBoxItem Content="Xanh lá (Green)" Tag="#64FF64"/>
                                        <ComboBoxItem Content="Xanh dương (Blue)" Tag="#6496FF"/>
                                        <ComboBoxItem Content="Đỏ (Red)" Tag="#FF6464"/>
                                        <ComboBoxItem Content="Vàng (Yellow)" Tag="#FFFF64"/>
                                        <ComboBoxItem Content="Cam (Orange)" Tag="#FFA500"/>
                                        <ComboBoxItem Content="Tím (Purple)" Tag="#C864FF"/>
                                        <ComboBoxItem Content="Hồng (Pink)" Tag="#FF96C8"/>
                                        <ComboBoxItem Content="Xám (Gray)" Tag="#969696"/>
                                    </ComboBox>

                                    <Border Grid.Column="1" 
                                           x:Name="FaceColorPreview"
                                           CornerRadius="5" 
                                           Margin="10,0,0,0"
                                           BorderBrush="#CCCCCC"
                                           BorderThickness="2">
                                        <Border.Background>
                                            <SolidColorBrush Color="Transparent"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ACTION BUTTONS -->
                        <StackPanel>
                            <Button x:Name="DownloadButton"
                                   Content="💾 Tải xuống hình ảnh (PNG)"
                                   Style="{StaticResource ModernButton}"
                                   Background="#4CAF50"
                                   Height="40"
                                   Margin="0,0,0,8"
                                   Click="DownloadButton_Click"/>
                            
                            <Button x:Name="ResetButton"
                                   Content="🔄 Đặt lại mặc định"
                                   Style="{StaticResource ModernButton}"
                                   Background="#FF9800"
                                   Height="35"
                                   Margin="0,0,0,8"
                                   Click="ResetButton_Click"/>
                            
                            <Button x:Name="ConfirmButton"
                                   Content="✓ Xác nhận hoàn thành"
                                   Style="{StaticResource ModernButton}"
                                   Background="#2196F3"
                                   Height="35"
                                   Margin="0,0,0,8"
                                   Click="ConfirmButton_Click"/>
                            
                            <Button x:Name="CloseButton"
                                   Content="✕ Đóng"
                                   Style="{StaticResource ModernButton}"
                                   Background="#757575"
                                   Height="35"
                                   Click="CloseButton_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Window>
