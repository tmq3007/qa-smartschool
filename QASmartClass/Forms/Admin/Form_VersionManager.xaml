<Window x:Class="QASmartTouch.Forms.Admin.Form_VersionManager"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Quản lý Phiên bản &amp; Tính năng" 

        Width="700" Height="650"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="CanResize"

        WindowStartupLocation="CenterScreen"

        MinWidth="600" MinHeight="500">



    <Window.Resources>

        <!-- TreeView Item Style -->

        <Style x:Key="FeatureTreeItemStyle" TargetType="TreeViewItem">

            <Setter Property="Padding" Value="4"/>

            <Setter Property="Margin" Value="0,2,0,2"/>

        </Style>

        

        <!-- CheckBox Style for Features -->

        <Style x:Key="FeatureCheckBoxStyle" TargetType="CheckBox">

            <Setter Property="Margin" Value="4,2"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        

        <!-- Button Style -->

        <Style x:Key="ActionButtonStyle" TargetType="Button">

            <Setter Property="Height" Value="36"/>

            <Setter Property="Padding" Value="16,8"/>

            <Setter Property="Margin" Value="4"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"

                                Background="{TemplateBinding Background}"

                                CornerRadius="8"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" 

                                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#888888" 

                            Direction="270" 

                            ShadowDepth="5" 

                            BlurRadius="20" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <!-- Header -->

                <RowDefinition Height="Auto"/>

                <!-- Version Info -->

                <RowDefinition Height="*"/>

                <!-- Feature Tree -->

                <RowDefinition Height="Auto"/>

                <!-- Footer -->

            </Grid.RowDefinitions>



            <!-- HEADER with Gradient -->

            <Border Grid.Row="0" CornerRadius="15,15,0,0">

                <Border.Background>

                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                        <GradientStop Color="#667eea" Offset="0"/>

                        <GradientStop Color="#764ba2" Offset="1"/>

                    </LinearGradientBrush>

                </Border.Background>

                

                <Grid Margin="20,15">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    

                    <StackPanel Grid.Column="0" Orientation="Horizontal">

                        <TextBlock Text="🔧" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Quản lý Phiên bản" 

                                      FontSize="18" 

                                      FontWeight="Bold" 

                                      Foreground="White"/>

                            <TextBlock Text="Quản lý phiên bản &amp; tính năng" 

                                      FontSize="12" 

                                      Foreground="#DDDDDD"/>

                        </StackPanel>

                    </StackPanel>

                    

                    <!-- Close Button -->

                    <Button x:Name="btnClose" 

                           Grid.Column="1"

                           Width="36" Height="36"

                           Background="#FFFFFF22"

                           Style="{StaticResource ActionButtonStyle}"

                           Click="btnClose_Click">

                        <TextBlock Text="✕" FontSize="16" Foreground="White"/>

                    </Button>

                </Grid>

            </Border>



            <!-- VERSION INFO SECTION -->

            <Border Grid.Row="1" 

                   Background="#F8F9FA" 

                   Margin="15,10,15,5"

                   CornerRadius="10"

                   Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    

                    <!-- Version Details -->

                    <StackPanel Grid.Column="0">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Version: " FontWeight="SemiBold" Foreground="#555"/>

                            <TextBlock x:Name="txtVersion" Text="1.0.0" FontWeight="Bold" Foreground="#2E86DE"/>

                            <TextBlock Text="   Build: " FontWeight="SemiBold" Foreground="#555" Margin="10,0,0,0"/>

                            <TextBlock x:Name="txtBuildNumber" Text="1001" Foreground="#666"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                            <TextBlock Text="Template: " FontWeight="SemiBold" Foreground="#555"/>

                            <TextBlock x:Name="txtCurrentTemplate" Text="1.0.0-public" Foreground="#4CAF50" FontWeight="SemiBold"/>

                        </StackPanel>

                    </StackPanel>

                    

                    <!-- Template Selector -->

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">

                        <ComboBox x:Name="cboTemplates" 

                                 Width="180" 

                                 Height="32"

                                 VerticalContentAlignment="Center"

                                 SelectionChanged="cboTemplates_SelectionChanged"/>

                    </StackPanel>

                    

                    <!-- Apply Button -->

                    <Button x:Name="btnApplyTemplate" 

                           Grid.Column="2"

                           Content="📥 Áp dụng Template"

                           Background="#4CAF50"

                           Foreground="White"

                           Style="{StaticResource ActionButtonStyle}"

                           Click="btnApplyTemplate_Click"/>

                </Grid>

            </Border>



            <!-- FEATURE TREE SECTION -->

            <Border Grid.Row="2" 

                   Background="#FAFAFA" 

                   Margin="15,5,15,10"

                   CornerRadius="10"

                   BorderBrush="#E5E5E5"

                   BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    

                    <!-- Section Header -->

                    <Border Grid.Row="0" Background="#F0F0F0" CornerRadius="10,10,0,0" Padding="15,10">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Quản lý Tính năng" 

                                          FontSize="14" 

                                          FontWeight="Bold" 

                                          Foreground="#333"/>

                                <TextBlock Text="Bật/tắt các tính năng theo template"

                                          FontSize="11"

                                          Foreground="#888"/>

                            </StackPanel>

                            

                            <!-- Stats -->

                            <Border Grid.Column="1" 

                                   Background="#E3F2FD" 

                                   CornerRadius="15" 

                                   Padding="12,6">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Enabled: " Foreground="#1976D2"/>

                                    <TextBlock x:Name="txtEnabledCount" Text="0" FontWeight="Bold" Foreground="#1976D2"/>

                                    <TextBlock Text=" / " Foreground="#666"/>

                                    <TextBlock x:Name="txtTotalCount" Text="0" Foreground="#666"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Border>

                    

                    <!-- Feature TreeView -->

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <TreeView x:Name="treeFeatures" 

                                 Background="Transparent"

                                 BorderThickness="0"

                                 Padding="10"

                                 ItemContainerStyle="{StaticResource FeatureTreeItemStyle}">

                            <!-- Items will be added programmatically -->

                        </TreeView>

                    </ScrollViewer>

                </Grid>

            </Border>



            <!-- FOOTER -->

            <Border Grid.Row="3" 

                   Background="#F8F9FA" 

                   CornerRadius="0,0,15,15"

                   Padding="15,12">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    

                    <!-- Left: Info -->

                    <TextBlock Grid.Column="0" 

                              x:Name="txtLastSaved"

                              Text="Chưa lưu thay đổi"

                              Foreground="#888"

                              VerticalAlignment="Center"/>

                    

                    <!-- Right: Action Buttons -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <Button x:Name="btnExportConfig" 

                               Content="📤 Export Config"

                               Background="#607D8B"

                               Foreground="White"

                               Style="{StaticResource ActionButtonStyle}"

                               Click="btnExportConfig_Click"/>

                        

                        <Button x:Name="btnResetDefault" 

                               Content="🔄 Reset Default"

                               Background="#FF9800"

                               Foreground="White"

                               Style="{StaticResource ActionButtonStyle}"

                               Click="btnResetDefault_Click"/>

                        

                        <Button x:Name="btnSaveChanges" 

                               Content="💾 Lưu thay đổi"

                               Background="#2E86DE"

                               Foreground="White"

                               Style="{StaticResource ActionButtonStyle}"

                               Click="btnSaveChanges_Click"/>

                        

                        <Button x:Name="btnCancel" 

                               Content="❌ Đóng"

                               Background="#EE5A6F"

                               Foreground="White"

                               Style="{StaticResource ActionButtonStyle}"

                               Click="btnClose_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

