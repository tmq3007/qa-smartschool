<Window x:Class="iProSmartScreen.Forms.Form2_3_SubMenuDrawShapes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chèn hình" 
        Width="650" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="White" 
            CornerRadius="15" 
            BorderBrush="#E1E8ED" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC" 
                            Direction="270" 
                            ShadowDepth="3" 
                            BlurRadius="15" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <!-- Categories Panel -->
                <ColumnDefinition Width="*"/>
                <!-- Content Panel -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: CATEGORIES -->
            <Border Grid.Column="0" 
                   Background="#F8F9FA"
                   CornerRadius="15,0,0,15"
                   BorderBrush="#E1E8ED"
                   BorderThickness="0,0,1,0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Categories Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Chèn hình" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="#2F3542"
                                  Margin="0,0,0,5"/>
                        <TextBlock Text="Insert Shapes" 
                                  FontSize="11" 
                                  Foreground="#747D8C"/>
                    </StackPanel>

                    <!-- Categories List -->
                    <StackPanel Grid.Row="1">
                        
                        <!-- Category 1: 2D Geometry - SELECTED -->
                        <Button x:Name="btnCat2DGeometry" 
                               Height="70"
                               Margin="0,0,0,8"
                               Background="#2E86DE"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="btnCategory_Click"
                               Tag="2DGeometry">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="10"
                                           Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                   Width="35" Height="35"
                                                   Background="White"
                                                   CornerRadius="8"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Opacity="0.9">
                                                <Viewbox Width="20" Height="20">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#2E86DE" 
                                                             Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Hình học 2D" 
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="White"/>
                                                <TextBlock Text="2D Geometry" 
                                                          FontSize="10"
                                                          Foreground="White"
                                                          Opacity="0.8"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Category 2: 3D Geometry -->
                        <Button x:Name="btnCat3DGeometry" 
                               Height="70"
                               Margin="0,0,0,8"
                               Background="#F1F2F6"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="btnCategory_Click"
                               Tag="3DGeometry">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="10"
                                           Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                   Width="35" Height="35"
                                                   Background="#E3F2FD"
                                                   CornerRadius="8"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0">
                                                <Viewbox Width="20" Height="20">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#2196F3" 
                                                             Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Hình học 3D" 
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#2F3542"/>
                                                <TextBlock Text="3D Geometry" 
                                                          FontSize="10"
                                                          Foreground="#747D8C"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Category 3: Charts & Table -->
                        <Button x:Name="btnCatChartsTable" 
                               Height="70"
                               Margin="0,0,0,8"
                               Background="#F1F2F6"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="btnCategory_Click"
                               Tag="ChartsTable">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="10"
                                           Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                   Width="35" Height="35"
                                                   Background="#FFF3E0"
                                                   CornerRadius="8"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0">
                                                <Viewbox Width="20" Height="20">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#FF9800" 
                                                             Data="M3,3H21V21H3V3M5,5V19H19V5H5M7,7H17V9H7V7M7,11H17V13H7V11M7,15H17V17H7V15Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Biểu đồ &amp; Bảng" 
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#2F3542"/>
                                                <TextBlock Text="Charts &amp; Table" 
                                                          FontSize="10"
                                                          Foreground="#747D8C"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Category 4: Flashcard & Notes -->
                        <Button x:Name="btnCatFlashcard" 
                               Height="70"
                               Background="#F1F2F6"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="btnCategory_Click"
                               Tag="Flashcard">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="10"
                                           Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                   Width="35" Height="35"
                                                   Background="#FFF9C4"
                                                   CornerRadius="8"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0">
                                                <Viewbox Width="20" Height="20">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#FDD835" 
                                                             Data="M3,3H21V21H3V3M5,5V19H19V5H5M7,7H11V11H7V7M13,7H17V10H13V7M17,12V16H13V12H17M11,13V17H7V13H11Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Flashcard" 
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#2F3542"/>
                                                <TextBlock Text="Flashcard &amp; Notes" 
                                                          FontSize="10"
                                                          Foreground="#747D8C"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: CONTENT -->
            <Grid Grid.Column="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- Shapes Gallery -->
                </Grid.RowDefinitions>

                <!-- Content Header -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="txtCategoryTitle" 
                                  Text="Hình học 2D" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#2F3542"
                                  Margin="0,0,0,5"/>
                        <TextBlock Text="Kéo và thả hình vào bảng để sử dụng" 
                                  FontSize="12" 
                                  Foreground="#747D8C"/>
                    </StackPanel>
                    
                    <Button x:Name="btnClose" 
                           Width="30" Height="30"
                           HorizontalAlignment="Right"
                           Background="#FEE2E2"
                           BorderThickness="0"
                           Cursor="Hand"
                           Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                       CornerRadius="8">
                                    <Path Fill="#EE5A6F" 
                                         Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                         Width="14" Height="14"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Shapes Gallery -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Sub-category tabs -->
                        <RowDefinition Height="*"/>
                        <!-- Content -->
                    </Grid.RowDefinitions>
                    
                    <!-- SUB-CATEGORY TABS (for 2D Geometry) -->
                    <StackPanel x:Name="panelSubTabs" 
                               Grid.Row="0" 
                               Orientation="Horizontal" 
                               Margin="0,0,0,15"
                               Visibility="Visible">
                        
                        <Button x:Name="btnSubLines" 
                               Content="Đường kẻ" 
                               Height="35"
                               Padding="15,0"
                               Margin="0,0,5,0"
                               Background="#2E86DE"
                               Foreground="White"
                               BorderThickness="0"
                               Cursor="Hand"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Click="btnSubCategory_Click"
                               Tag="Lines">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="8"
                                                       Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button x:Name="btnSubRectangles" 
                               Content="Chữ nhật" 
                               Height="35"
                               Padding="15,0"
                               Margin="0,0,5,0"
                               Background="#F1F2F6"
                               Foreground="#2F3542"
                               BorderThickness="0"
                               Cursor="Hand"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Click="btnSubCategory_Click"
                               Tag="Rectangles">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="8"
                                                       Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button x:Name="btnSubBasicShapes" 
                               Content="Hình cơ bản" 
                               Height="35"
                               Padding="15,0"
                               Margin="0,0,5,0"
                               Background="#F1F2F6"
                               Foreground="#2F3542"
                               BorderThickness="0"
                               Cursor="Hand"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Click="btnSubCategory_Click"
                               Tag="BasicShapes">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="8"
                                                       Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                    </StackPanel>
                    
                    <!-- CONTENT SCROLL VIEWER -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- 2D SHAPES PANEL -->
                            <StackPanel x:Name="panel2DShapes" Visibility="Visible">
                            
                            <!-- Group Title -->
                            <TextBlock x:Name="txtGroupTitle"
                                      Text="Đường kẻ - Lines" 
                                      FontSize="13" 
                                      FontWeight="SemiBold" 
                                      Foreground="#57606F"
                                      Margin="0,0,0,10"/>
                        
                        <UniformGrid Columns="5" 
                                    Margin="0,0,0,20">
                            <!-- Circle -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Circle"
                                   ToolTip="Hình tròn">
                                <Ellipse Width="40" Height="40" Fill="#2E86DE"/>
                            </Button>

                            <!-- Square -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Square"
                                   ToolTip="Hình vuông">
                                <Rectangle Width="40" Height="40" Fill="#4CAF50"/>
                            </Button>

                            <!-- Triangle -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Triangle"
                                   ToolTip="Tam giác">
                                <Polygon Points="20,5 35,40 5,40" Fill="#FF9800"/>
                            </Button>

                            <!-- Rectangle -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Rectangle"
                                   ToolTip="Hình chữ nhật">
                                <Rectangle Width="45" Height="30" Fill="#9C27B0"/>
                            </Button>

                            <!-- Hexagon -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Hexagon"
                                   ToolTip="Lục giác">
                                <Polygon Points="20,5 35,12 35,28 20,35 5,28 5,12" Fill="#00BCD4"/>
                            </Button>

                            <!-- Star -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Star"
                                   ToolTip="Ngôi sao">
                                <Path Fill="#FDD835" 
                                     Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/>
                            </Button>

                            <!-- Heart -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Heart"
                                   ToolTip="Trái tim">
                                <Path Fill="#EE5A6F" 
                                     Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"/>
                            </Button>

                            <!-- Arrow Right -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="ArrowRight"
                                   ToolTip="Mũi tên phải">
                                <Path Fill="#3F51B5" 
                                     Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z"/>
                            </Button>

                            <!-- Arrow Down -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="ArrowDown"
                                   ToolTip="Mũi tên xuống">
                                <Path Fill="#009688" 
                                     Data="M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z"/>
                            </Button>
                        </UniformGrid>

                        <!-- Lines & Arrows -->
                        <TextBlock Text="Đường nét &amp; Mũi tên" 
                                  FontSize="13" 
                                  FontWeight="SemiBold" 
                                  Foreground="#57606F"
                                  Margin="0,0,0,10"/>
                        
                        <UniformGrid Columns="5" 
                                    Margin="0,0,0,20">
                            <!-- Straight Line -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Line"
                                   ToolTip="Đường thẳng">
                                <Line X1="10" Y1="20" X2="60" Y2="20" 
                                     Stroke="#2F3542" StrokeThickness="3"/>
                            </Button>

                            <!-- Curved Line -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="CurvedLine"
                                   ToolTip="Đường cong">
                                <Path Stroke="#2F3542" StrokeThickness="3" 
                                     Data="M10,30 Q35,10 60,30"/>
                            </Button>

                            <!-- Double Arrow -->
                            <Button Width="70" Height="70" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="DoubleArrow"
                                   ToolTip="Mũi tên hai đầu">
                                <Path Fill="#2E86DE" 
                                     Data="M6.5,9L0,15.5L6.5,22L8,20.5L3.5,16H20.5L16,20.5L17.5,22L24,15.5L17.5,9L16,10.5L20.5,15H3.5L8,10.5L6.5,9Z"/>
                            </Button>
                        </UniformGrid>

                    </StackPanel>
                    
                    <!-- 3D SHAPES PANEL -->
                    <StackPanel x:Name="panel3DShapes" Visibility="Collapsed">
                        
                        <!-- 3D Basic Shapes -->
                        <TextBlock Text="Hình khối cơ bản" 
                                  FontSize="13" 
                                  FontWeight="SemiBold" 
                                  Foreground="#57606F"
                                  Margin="0,0,0,10"/>
                        
                        <UniformGrid Columns="4" 
                                    Margin="0,0,0,20">
                            <!-- Cube -->
                            <Button Width="90" Height="90" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Cube"
                                   ToolTip="Hình lập phương">
                                <StackPanel>
                                    <Viewbox Width="50" Height="50">
                                        <Canvas Width="100" Height="100">
                                            <!-- Front face -->
                                            <Polygon Points="30,40 70,40 70,80 30,80" Fill="#4CAF50" Opacity="0.7"/>
                                            <!-- Top face -->
                                            <Polygon Points="30,40 50,25 90,25 70,40" Fill="#81C784" Opacity="0.8"/>
                                            <!-- Right face -->
                                            <Polygon Points="70,40 90,25 90,65 70,80" Fill="#66BB6A" Opacity="0.9"/>
                                            <!-- Edges -->
                                            <Polyline Points="30,40 70,40 70,80 30,80 30,40" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Polyline Points="30,40 50,25 90,25 70,40" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Polyline Points="70,40 90,25 90,65 70,80" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Line X1="30" Y1="80" X2="50" Y2="65" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="50" Y1="25" X2="50" Y2="65" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="50" Y1="65" X2="90" Y2="65" Stroke="Black" StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Lập phương" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Sphere -->
                            <Button Width="90" Height="90" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Sphere"
                                   ToolTip="Hình cầu">
                                <StackPanel>
                                    <Viewbox Width="50" Height="50">
                                        <Canvas Width="100" Height="100">
                                            <Ellipse Canvas.Left="25" Canvas.Top="25" Width="50" Height="50" Fill="#2196F3" Opacity="0.7"/>
                                            <Ellipse Canvas.Left="25" Canvas.Top="25" Width="50" Height="50" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Ellipse Canvas.Left="35" Canvas.Top="25" Width="30" Height="50" Stroke="Black" StrokeThickness="1" Fill="None" Opacity="0.5"/>
                                            <Ellipse Canvas.Left="25" Canvas.Top="35" Width="50" Height="30" Stroke="Black" StrokeThickness="1" Fill="None" Opacity="0.5"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Hình cầu" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Cylinder -->
                            <Button Width="90" Height="90" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Cylinder"
                                   ToolTip="Hình trụ">
                                <StackPanel>
                                    <Viewbox Width="50" Height="50">
                                        <Canvas Width="100" Height="100">
                                            <!-- Top ellipse -->
                                            <Ellipse Canvas.Left="30" Canvas.Top="20" Width="40" Height="15" Fill="#FF9800" Opacity="0.8"/>
                                            <!-- Body -->
                                            <Rectangle Canvas.Left="30" Canvas.Top="27" Width="40" Height="40" Fill="#FFA726" Opacity="0.7"/>
                                            <!-- Bottom ellipse -->
                                            <Ellipse Canvas.Left="30" Canvas.Top="60" Width="40" Height="15" Fill="#FB8C00" Opacity="0.9"/>
                                            <!-- Edges -->
                                            <Ellipse Canvas.Left="30" Canvas.Top="20" Width="40" Height="15" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Line X1="30" Y1="27" X2="30" Y2="67" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="70" Y1="27" X2="70" Y2="67" Stroke="Black" StrokeThickness="2"/>
                                            <Ellipse Canvas.Left="30" Canvas.Top="60" Width="40" Height="15" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Hình trụ" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Cone -->
                            <Button Width="90" Height="90" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Cone"
                                   ToolTip="Hình nón">
                                <StackPanel>
                                    <Viewbox Width="50" Height="50">
                                        <Canvas Width="100" Height="100">
                                            <!-- Base ellipse -->
                                            <Ellipse Canvas.Left="30" Canvas.Top="60" Width="40" Height="15" Fill="#F44336" Opacity="0.8"/>
                                            <!-- Cone body -->
                                            <Polygon Points="50,20 30,67 70,67" Fill="#EF5350" Opacity="0.7"/>
                                            <!-- Edges -->
                                            <Ellipse Canvas.Left="30" Canvas.Top="60" Width="40" Height="15" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Line X1="50" Y1="20" X2="30" Y2="67" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="50" Y1="20" X2="70" Y2="67" Stroke="Black" StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Hình nón" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Pyramid -->
                            <Button Width="90" Height="90" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Pyramid"
                                   ToolTip="Hình chóp">
                                <StackPanel>
                                    <Viewbox Width="50" Height="50">
                                        <Canvas Width="100" Height="100">
                                            <!-- Base -->
                                            <Polygon Points="30,70 70,70 80,80 20,80" Fill="#9C27B0" Opacity="0.6"/>
                                            <!-- Left face -->
                                            <Polygon Points="50,20 30,70 20,80" Fill="#AB47BC" Opacity="0.7"/>
                                            <!-- Right face -->
                                            <Polygon Points="50,20 70,70 80,80" Fill="#BA68C8" Opacity="0.8"/>
                                            <!-- Front face -->
                                            <Polygon Points="50,20 30,70 70,70" Fill="#CE93D8" Opacity="0.9"/>
                                            <!-- Edges -->
                                            <Polygon Points="30,70 70,70 80,80 20,80" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Line X1="50" Y1="20" X2="30" Y2="70" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="50" Y1="20" X2="70" Y2="70" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="50" Y1="20" X2="20" Y2="80" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="50" Y1="20" X2="80" Y2="80" Stroke="Black" StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Hình chóp" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Prism -->
                            <Button Width="90" Height="90" 
                                   Margin="5"
                                   Background="#F1F2F6"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Click="btnShape_Click"
                                   Tag="Prism"
                                   ToolTip="Lăng trụ">
                                <StackPanel>
                                    <Viewbox Width="50" Height="50">
                                        <Canvas Width="100" Height="100">
                                            <!-- Front triangle -->
                                            <Polygon Points="50,25 30,65 70,65" Fill="#00BCD4" Opacity="0.8"/>
                                            <!-- Back triangle -->
                                            <Polygon Points="65,20 45,60 85,60" Fill="#26C6DA" Opacity="0.6"/>
                                            <!-- Bottom -->
                                            <Polygon Points="30,65 70,65 85,60 45,60" Fill="#4DD0E1" Opacity="0.7"/>
                                            <!-- Left side -->
                                            <Polygon Points="50,25 30,65 45,60 65,20" Fill="#80DEEA" Opacity="0.9"/>
                                            <!-- Edges -->
                                            <Polygon Points="50,25 30,65 70,65" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Polygon Points="65,20 45,60 85,60" Stroke="Black" StrokeThickness="2" Fill="None"/>
                                            <Line X1="50" Y1="25" X2="65" Y2="20" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="30" Y1="65" X2="45" Y2="60" Stroke="Black" StrokeThickness="2"/>
                                            <Line X1="70" Y1="65" X2="85" Y2="60" Stroke="Black" StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Lăng trụ" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>

                    </StackPanel>
                    
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Border>
</Window>
