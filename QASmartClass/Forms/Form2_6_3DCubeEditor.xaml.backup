<Window x:Class="iProSmartScreen.Forms.Form2_6_3DCubeEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎨 Chức năng vẽ khối lập phương 3D" 
        Height="720" 
        Width="1200"
        MinHeight="720"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FF6674EA">
    
    <Window.Resources>
        <!-- Style cho Slider -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="Foreground" Value="#667EEA"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>

        <!-- Style cho Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho TextBlock Label -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Style cho Value Display -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#667EEA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15,10" 
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎨 Chức năng vẽ khối lập phương 3D" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#333333"/>
                    <TextBlock Text="Công cụ hỗ trợ giảng dạy hình học không gian" 
                               FontSize="11" 
                               Foreground="#666666" 
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        x:Name="CloseButton"
                        Content="✕"
                        Width="35" 
                        Height="35"
                        FontSize="18"
                        Background="Transparent"
                        Foreground="#999999"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="White" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas Area -->
            <Border Grid.Column="0" 
                    Background="#F9F9F9" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="2" 
                    CornerRadius="10"
                    Margin="0,0,10,0">
                <Canvas x:Name="CubeCanvas" 
                        ClipToBounds="True"/>
            </Border>

            <!-- Controls Panel -->
            <ScrollViewer Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,5,0">
                <StackPanel Margin="0,0,0,20">
                    
                    <!-- Stats Panel -->
                    <Border Background="#FFF3CD" 
                            BorderBrush="#FFC107" 
                            BorderThickness="0,0,0,3" 
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="📊 Thông số hiện tại:" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       Foreground="#533F03" 
                                       Margin="0,0,0,6"/>
                            <TextBlock Foreground="#856404" FontSize="11">
                                <Run Text="• Số đỉnh: "/>
                                <Run Text="8" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Foreground="#856404" FontSize="11" Margin="0,2,0,0">
                                <Run Text="• Số cạnh: "/>
                                <Run Text="12" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Foreground="#856404" FontSize="11" Margin="0,2,0,0">
                                <Run Text="• Số mặt: "/>
                                <Run Text="6" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Foreground="#856404" FontSize="11" Margin="0,2,0,0">
                                <Run Text="• Thể tích: "/>
                                <Run x:Name="VolumeText" Text="3,375,000" FontWeight="Bold"/>
                                <Run Text=" đvtt"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Rotation Controls -->
                    <Border Background="#F5F5F5" 
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="⚙️ Điều khiển xoay" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#444444" 
                                       Margin="0,0,0,8"/>
                            
                            <!-- Rotation X -->
                            <Grid>
                                <TextBlock Text="Xoay trục X:" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="RotXValue" Text="0°" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider x:Name="RotXSlider" 
                                    Minimum="0" 
                                    Maximum="360" 
                                    Value="0" 
                                    Style="{StaticResource ModernSlider}"
                                    ValueChanged="RotationSlider_ValueChanged"/>

                            <!-- Rotation Y -->
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="Xoay trục Y:" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="RotYValue" Text="60°" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider x:Name="RotYSlider" 
                                    Minimum="0" 
                                    Maximum="360" 
                                    Value="60" 
                                    Style="{StaticResource ModernSlider}"
                                    ValueChanged="RotationSlider_ValueChanged"/>

                            <!-- Rotation Z -->
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="Xoay trục Z:" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="RotZValue" Text="0°" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider x:Name="RotZSlider" 
                                    Minimum="0" 
                                    Maximum="360" 
                                    Value="0" 
                                    Style="{StaticResource ModernSlider}"
                                    ValueChanged="RotationSlider_ValueChanged"/>

                            <!-- Auto Rotate -->
                            <CheckBox x:Name="chkAutoRotate" Content="🔄 Tự động xoay" 
                                      FontSize="12" 
                                      Margin="0,12,0,0"
                                      Checked="OnAutoRotateChanged"
                                      Unchecked="OnAutoRotateChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Size Control -->
                    <Border Background="#F5F5F5" 
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="📏 Kích thước" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#444444" 
                                       Margin="0,0,0,8"/>
                            
                            <Grid>
                                <TextBlock Text="Độ dài cạnh:" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="SizeValue" Text="150" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider x:Name="SizeSlider" 
                                    Minimum="50" 
                                    Maximum="300" 
                                    Value="150" 
                                    Style="{StaticResource ModernSlider}"
                                    ValueChanged="SizeSlider_ValueChanged"/>
                            
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="Độ dày nét viền:" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="ThicknessValue" Text="1.5" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Slider x:Name="ThicknessSlider" 
                                    Minimum="0.5" 
                                    Maximum="5" 
                                    Value="1.5" 
                                    Style="{StaticResource ModernSlider}"
                                    ValueChanged="ThicknessSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Display Mode -->
                    <Border Background="#F5F5F5" 
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="🎨 Kiểu hiển thị" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#444444" 
                                       Margin="0,0,0,6"/>
                            
                            <TextBlock Text="Chế độ vẽ:" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="DrawModeComboBox" 
                                      Height="32" 
                                      FontSize="12"
                                      SelectionChanged="DrawModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Khung dây (Wireframe)" IsSelected="True"/>
                                <ComboBoxItem Content="Tô màu mặt (Solid)"/>
                                <ComboBoxItem Content="Cả hai"/>
                            </ComboBox>

                            <!-- Face Color Picker -->
                            <TextBlock Text="Màu mặt (Face):" 
                                       Style="{StaticResource LabelText}" 
                                       Margin="0,8,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox x:Name="FaceColorComboBox" 
                                          Grid.Column="0"
                                          Height="32" 
                                          FontSize="12"
                                          SelectionChanged="FaceColorComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                        Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                        BorderBrush="#999" BorderThickness="1"/>
                                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBoxItem Content="Trong suốt (Transparent)" Tag="Transparent" IsSelected="True"/>
                                    <ComboBoxItem Content="Xanh lá (Green)" Tag="#64FF64"/>
                                    <ComboBoxItem Content="Xanh dương (Blue)" Tag="#6496FF"/>
                                    <ComboBoxItem Content="Đỏ (Red)" Tag="#FF6464"/>
                                    <ComboBoxItem Content="Vàng (Yellow)" Tag="#FFFF64"/>
                                    <ComboBoxItem Content="Cam (Orange)" Tag="#FFA500"/>
                                    <ComboBoxItem Content="Tím (Purple)" Tag="#C864FF"/>
                                    <ComboBoxItem Content="Hồng (Pink)" Tag="#FF96C8"/>
                                    <ComboBoxItem Content="Xám (Gray)" Tag="#969696"/>
                                </ComboBox>

                                <Border Grid.Column="1" 
                                        x:Name="FaceColorPreview"
                                        CornerRadius="5" 
                                        Margin="10,0,0,0"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="2">
                                    <Border.Background>
                                        <SolidColorBrush Color="Transparent"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- Edge Color Picker -->
                            <TextBlock Text="Màu viền (Edge):" 
                                       Style="{StaticResource LabelText}" 
                                       Margin="0,8,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox x:Name="EdgeColorComboBox" 
                                          Grid.Column="0"
                                          Height="32" 
                                          FontSize="12"
                                          SelectionChanged="EdgeColorComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                        Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                        BorderBrush="#999" BorderThickness="1"/>
                                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBoxItem Content="Đen (Black)" Tag="Black" IsSelected="True"/>
                                    <ComboBoxItem Content="Trắng (White)" Tag="White"/>
                                    <ComboBoxItem Content="Đỏ (Red)" Tag="Red"/>
                                    <ComboBoxItem Content="Xanh lá (Green)" Tag="Green"/>
                                    <ComboBoxItem Content="Xanh dương (Blue)" Tag="Blue"/>
                                    <ComboBoxItem Content="Vàng (Yellow)" Tag="Yellow"/>
                                    <ComboBoxItem Content="Tím (Purple)" Tag="Purple"/>
                                    <ComboBoxItem Content="Cam (Orange)" Tag="Orange"/>
                                </ComboBox>

                                <Border Grid.Column="1" 
                                        x:Name="EdgeColorPreview"
                                        Background="Black" 
                                        CornerRadius="5" 
                                        Margin="10,0,0,0"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Button x:Name="ConfirmButton"
                            Content="✓ Xác nhận hoàn thành"
                            Height="40"
                            FontSize="14"
                            Margin="0,0,0,6"
                            Click="ConfirmButton_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#11998E" Offset="0"/>
                                <GradientStop Color="#38EF7D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
                        </Button.Style>
                    </Button>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="DownloadButton"
                                Grid.Column="0"
                                Content="💾 Tải ảnh"
                                Height="35"
                                FontSize="12"
                                Background="#4ECDC4"
                                Margin="0,0,5,0"
                                Click="DownloadButton_Click"
                                Style="{StaticResource ModernButton}"/>

                        <Button x:Name="ResetButton"
                                Grid.Column="1"
                                Content="🔄 Đặt lại"
                                Height="35"
                                FontSize="12"
                                Background="#FF6B6B"
                                Margin="5,0,0,0"
                                Click="ResetButton_Click"
                                Style="{StaticResource ModernButton}"/>
                    </Grid>

                    <!-- Info Box -->
                    <Border Background="#E3F2FD" 
                            BorderBrush="#2196F3" 
                            BorderThickness="0,0,0,3" 
                            CornerRadius="6" 
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="💡 Hướng dẫn sử dụng" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       Foreground="#1976D2" 
                                       Margin="0,0,0,5"/>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="10" 
                                       Foreground="#555555" 
                                       LineHeight="16">
                                • Kéo các thanh trượt để xoay khối lập phương<LineBreak/>
                                • Thay đổi kích thước cạnh theo ý muốn<LineBreak/>
                                • Chọn chế độ hiển thị và màu cạnh<LineBreak/>
                                • Nhấn <Bold>"Xác nhận"</Bold> để áp dụng lên bảng vẽ<LineBreak/>
                                • Nhấn <Bold>"Tải ảnh"</Bold> để lưu hình vẽ<LineBreak/>
                                • Nhấn <Bold>"Đặt lại"</Bold> để về trạng thái ban đầu
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
