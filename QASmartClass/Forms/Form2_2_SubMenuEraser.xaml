<Window x:Class="QASmartTouch.Forms.Form2_2_SubMenuEraser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Công cụ Tẩy" 
        Width="310" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Inter, Segoe UI, Arial"
        ShowInTaskbar="False">

    <Border Background="White" 
            CornerRadius="15" 
            BorderBrush="#E1E8ED" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC" 
                            Direction="270" 
                            ShadowDepth="3" 
                            BlurRadius="15" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Eraser Modes & Size Slider -->
                <RowDefinition Height="Auto"/> <!-- Footer Info -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#2E86DE" 
                          Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="2. Công cụ Tẩy" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#2F3542"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Custom styled close button with hover triggers -->
                <Button x:Name="btnClose" 
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                    CornerRadius="8">
                                <Path x:Name="btnPath" Fill="#747D8C" 
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="btnPath" Property="Fill" Value="#EE5A6F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ERASER MODES & SIZE SLIDER -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <!-- Chỉ dẫn sử dụng -->
                <Border Background="#F1F2F6" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Chỉ dẫn sử dụng:" FontWeight="Bold" FontSize="11" Foreground="#2F3542" Margin="0,0,0,4"/>
                        <TextBlock Text="1. Chọn chế độ tẩy hoặc trượt chỉnh kích thước." FontSize="10" Foreground="#57606F"/>
                        <TextBlock Text="2. Vẽ lên bảng để xóa (Nhấn ❌ hoặc chạm bảng để đóng &amp; lưu)." FontSize="10" Foreground="#57606F" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Mode 1: Erase by Stroke -->
                <Button x:Name="btnEraseByStroke" 
                        Height="65"
                        Margin="0,0,0,8"
                        Background="#E3F2FD"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnEraseMode_Click"
                        Tag="Stroke">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon: Eraser (cục tẩy) -->
                                    <Border Grid.Column="0" 
                                            Width="36" Height="36"
                                            Background="#2196F3"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="White" 
                                                      Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    
                                    <!-- Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Xóa từng nét" 
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Margin="0,0,0,1"/>
                                        <TextBlock Text="Xóa từng nét vẽ riêng lẻ" 
                                                   FontSize="10"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.75"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- ✅ Phase 2.1: Hover effect -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#BBDEFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Mode 2: Erase by Point -->
                <Button x:Name="btnEraseByPoint" 
                        Height="65"
                        Margin="0,0,0,8"
                        Background="#F3E5F5"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnEraseMode_Click"
                        Tag="Point">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="10">
                                 <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon: Eraser Tip / Point (xóa theo điểm) -->
                                    <Border Grid.Column="0" 
                                            Width="36" Height="36"
                                            Background="#9C27B0"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="White" 
                                                      Data="M15.14,3C14.63,3 14.12,3.2 13.73,3.59L2.59,14.73C1.81,15.5 1.81,16.77 2.59,17.56L6.44,21.41C7.22,22.2 8.49,22.2 9.27,21.41L20.41,10.27C21.2,9.49 21.2,8.22 20.41,7.44L16.56,3.59C16.17,3.2 15.65,3 15.14,3M15.14,5.41L18.59,8.86L14.73,12.73L11.27,9.27L15.14,5.41M9.86,10.68L13.32,14.14L9.27,18.19L5.81,14.73L9.86,10.68Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    
                                    <!-- Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Xóa theo điểm" 
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Margin="0,0,0,1"/>
                                        <TextBlock Text="Xóa từng mẩu nét theo vệt tẩy" 
                                                   FontSize="10"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.75"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Hover effect -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E1BEE7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Mode 3: Clear All -->
                <Button x:Name="btnClearAll" 
                        Height="65"
                        Margin="0,0,0,12"
                        Background="#FFEBEE"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnClearAll_Click"
                        Tag="ClearAll">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon -->
                                    <Border Grid.Column="0" 
                                            Width="36" Height="36"
                                            Background="#EE5A6F"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="White" 
                                                      Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    
                                    <!-- Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Xóa toàn bộ" 
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Margin="0,0,0,1"/>
                                        <TextBlock Text="Xóa tất cả đối tượng trên bảng" 
                                                   FontSize="10"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.75"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- ✅ Phase 2.1: Hover effect -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FFCDD2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- SIZE SLIDER & DYNAMIC PREVIEW -->
                <TextBlock Text="Kích thước đầu tẩy:" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           Foreground="#57606F" 
                           Margin="0,5,0,5"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Slider x:Name="sliderSize" 
                            Grid.Column="0" 
                            Minimum="5" 
                            Maximum="50" 
                            Value="20" 
                            TickFrequency="5" 
                            IsSnapToTickEnabled="True" 
                            VerticalAlignment="Center"/>
                            
                    <!-- Size value text -->
                    <TextBlock Grid.Column="1" 
                               Text="{Binding ElementName=sliderSize, Path=Value, StringFormat={}{0}px}" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Foreground="#2E86DE" 
                               VerticalAlignment="Center" 
                               Margin="8,0,8,0" 
                               Width="42" 
                               TextAlignment="Right"/>
                               
                    <!-- Eraser visual size preview circle -->
                    <Border Grid.Column="2" 
                            Width="55" Height="55" 
                            BorderBrush="#E1E8ED" 
                            BorderThickness="1" 
                            Background="#F8F9FA" 
                            CornerRadius="8" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Ellipse Fill="#EE5A6F" 
                                     Opacity="0.55"
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Center">
                                <Ellipse.Width>
                                    <Binding ElementName="sliderSize" Path="Value"/>
                                </Ellipse.Width>
                                <Ellipse.Height>
                                    <Binding ElementName="sliderSize" Path="Value"/>
                                </Ellipse.Height>
                            </Ellipse>
                            <!-- ✅ Phase 2.4: Nhãn bán kính để giáo viên hiểu kích thước -->
                            <TextBlock Text="Bán kính" 
                                       FontSize="8" 
                                       Foreground="#A4B0BE" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,2"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- FOOTER INFO -->
            <Border Grid.Row="2" 
                    Background="#F8F9FA"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="#57606F" 
                              Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="Mẹo phím tắt:" 
                                   FontSize="11"
                                   Foreground="#57606F"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="1"
                               Text="Hoàn tác: Ctrl+Z | Tẩy: E" 
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#2E86DE"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
