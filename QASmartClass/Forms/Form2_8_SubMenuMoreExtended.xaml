<Window x:Class="QASmartTouch.Forms.Form2_8_SubMenuMoreExtended"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="8. Mở rộng" 
        Width="580" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Inter, Segoe UI, Arial"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Local Style for the 2-column menu items to save vertical space -->
        <Style x:Key="ExtendedMenuItemButton" TargetType="Button" BasedOn="{StaticResource MenuItemButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Local Style for the bottom UniformGrid buttons with bo-goc and hover -->
        <Style x:Key="BottomMenuButton" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="Background" Value="#F1F2F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E4E5EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D2D3DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="15" 
            BorderBrush="#E1E8ED" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC" 
                            Direction="270" 
                            ShadowDepth="3" 
                            BlurRadius="15" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <!-- Modern Puzzle/Extension Icon (Replaces Kebab Icon) -->
                    <Path Fill="#2E86DE" 
                          Data="M4,4H8V8H4V4M10,4H14V8H10V4M16,4H20V8H16V4M4,10H8V14H4V10M10,10H14V14H10V10M16,10H20V14H16V10M4,16H8V20H4V16M10,16H14V20H10V16M16,16H20V20H16V16Z"
                          Width="18" Height="18"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="8. Mở rộng" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#2F3542"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Modern Close Button with Hover States -->
                <Button x:Name="btnClose" 
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                    CornerRadius="8">
                                <Path x:Name="btnPath" Fill="#747D8C" 
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="btnPath" Property="Fill" Value="#EE5A6F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- CONTENT ScrollViewer (Grid 2 Cột) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Columns -->
                        <RowDefinition Height="Auto"/> <!-- UniformGrid Underneath -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 1: Hệ thống & Tệp tin -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Hệ thống &amp; Tệp tin" 
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,8"/>

                            <Button x:Name="btnSettings" 
