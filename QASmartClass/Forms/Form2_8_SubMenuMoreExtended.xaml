                            <Button x:Name="btnPrintBoard" 
                                    Style="{StaticResource ExtendedMenuItemButton}"
                                    Click="btnPrintBoard_Click"
                                    ToolTip="In trực tiếp nội dung bảng trắng ra máy in">
