<Window x:Class="QASmartTouch.Forms.HelpTourOverlay"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Help Tour"

        WindowStyle="None" AllowsTransparency="True" Background="Transparent"

        WindowStartupLocation="CenterScreen"

        Topmost="True" ShowInTaskbar="False"

        WindowState="Maximized"

        KeyDown="Window_KeyDown">

    

    <Grid x:Name="OverlayGrid">

        <!-- Semi-transparent dark overlay -->

        <Border x:Name="DarkOverlay" Background="#80000000" 

                MouseDown="DarkOverlay_MouseDown"/>



        <!-- Spotlight Hole (transparent area around target element) -->

        <Border x:Name="SpotlightBorder" 

                Background="Transparent"

                BorderBrush="#2E86DE" BorderThickness="3"

                CornerRadius="12"

                HorizontalAlignment="Left" VerticalAlignment="Top"

                IsHitTestVisible="False"

                Visibility="Collapsed">

            <Border.Effect>

                <DropShadowEffect Color="#2E86DE" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>

            </Border.Effect>

        </Border>



        <!-- Tooltip Card -->

        <Border x:Name="TooltipCard"

                Background="#1A1A2E"

                BorderBrush="#2E86DE" BorderThickness="1"

                CornerRadius="12"

                HorizontalAlignment="Left" VerticalAlignment="Top"

                MaxWidth="380" MinWidth="280"

                Visibility="Collapsed">

            <Border.Effect>

                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.4"/>

            </Border.Effect>

            

            <Grid Margin="20,16">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- Step indicator -->

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

                    <Border Background="#2E86DE" CornerRadius="10" Padding="8,2">

                        <TextBlock x:Name="tbStepNumber" Text="1/8" 

                                   Foreground="White" FontSize="11" FontWeight="Bold"/>

                    </Border>

                    <TextBlock x:Name="tbCategory" Text="Công cụ" 

                               Foreground="#6C7A89" FontSize="11" 

                               VerticalAlignment="Center" Margin="8,0,0,0"/>

                </StackPanel>



                <!-- Title -->

                <TextBlock Grid.Row="1" x:Name="tbTitle" 

                           Text="Bút viết" FontSize="18" FontWeight="Bold"

                           Foreground="White" Margin="0,0,0,6"

                           TextWrapping="Wrap"/>



                <!-- Description -->

                <TextBlock Grid.Row="2" x:Name="tbDescription"

                           Text="Chọn bút viết để bắt đầu vẽ trên bảng trắng."

                           FontSize="13" Foreground="#8E9AAF"

                           TextWrapping="Wrap" LineHeight="20"

                           Margin="0,0,0,10"/>



                <!-- Keyboard shortcut -->

                <StackPanel Grid.Row="3" x:Name="ShortcutPanel" 

                            Orientation="Horizontal" Margin="0,0,0,12"

                            Visibility="Collapsed">

                    <TextBlock Text="⌨ Phím tắt: " Foreground="#6C7A89" FontSize="11"/>

                    <Border Background="#2D3748" CornerRadius="4" Padding="6,2">

                        <TextBlock x:Name="tbShortcut" Text="P" 

                                   Foreground="#2E86DE" FontSize="11" FontWeight="Bold"/>

                    </Border>

                </StackPanel>



                <!-- Navigation buttons -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <!-- Skip button -->

                    <Button Grid.Column="0" x:Name="btnSkip" Content="Bỏ qua"

                            Background="Transparent" Foreground="#6C7A89"

                            BorderThickness="0" FontSize="12" Cursor="Hand"

                            Click="btnSkip_Click" Padding="8,6"/>



                    <!-- Back button -->

                    <Button Grid.Column="2" x:Name="btnBack" Content="← Trước"

                            Background="#2D3748" Foreground="#8E9AAF"

                            BorderThickness="0" FontSize="12" Cursor="Hand"

                            Click="btnBack_Click" Padding="12,6" Margin="0,0,6,0">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" 

                                        CornerRadius="6" Padding="{TemplateBinding Padding}">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>



                    <!-- Next button -->

                    <Button Grid.Column="3" x:Name="btnNext" Content="Tiếp →"

                            Background="#2E86DE" Foreground="White"

                            BorderThickness="0" FontSize="12" FontWeight="SemiBold"

                            Cursor="Hand" Click="btnNext_Click" Padding="16,6">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" 

                                        CornerRadius="6" Padding="{TemplateBinding Padding}">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>

            </Grid>

        </Border>



        <!-- Progress dots -->

        <StackPanel x:Name="ProgressDots" 

                    Orientation="Horizontal" 

                    HorizontalAlignment="Center" 

                    VerticalAlignment="Bottom"

                    Margin="0,0,0,30"/>

    </Grid>

</Window>

