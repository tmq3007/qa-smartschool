<Window x:Class="QASmartTouch.Forms.Form2_GraphEditor"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:oxy="http://oxyplot.org/wpf"

        Title="Graph Function Plotter"

        Width="1400" Height="800"

        WindowStartupLocation="CenterScreen"

        Background="#F5F6FA">



    <Window.Resources>

        <!-- Button Style -->

        <Style x:Key="GraphButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#2196F3"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="15,10"/>

            <Setter Property="Margin" Value="0,5"/>

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="8"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#1976D2"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Remove Button Style -->

        <Style x:Key="RemoveButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#EF5350"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="8,5"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="5"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#D32F2F"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Insert Button Style -->

        <Style x:Key="InsertButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#4CAF50"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="20,12"/>

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                CornerRadius="10"

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#388E3C"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Slider Style -->

        <Style x:Key="ParameterSlider" TargetType="Slider">

            <Setter Property="Minimum" Value="-5"/>

            <Setter Property="Maximum" Value="5"/>

            <Setter Property="TickFrequency" Value="0.5"/>

            <Setter Property="IsSnapToTickEnabled" Value="True"/>

            <Setter Property="Height" Value="30"/>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="3*"/> <!-- Graph Area -->

            <ColumnDefinition Width="1*"/> <!-- Controls -->

        </Grid.ColumnDefinitions>



        <!-- LEFT PANEL: OxyPlot Graph -->

        <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="12">

            <Border.Effect>

                <DropShadowEffect Color="#CCCCCC" Direction="315" ShadowDepth="5" BlurRadius="15" Opacity="0.3"/>

            </Border.Effect>

            <Grid Margin="10">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <!-- Graph Title -->

                <TextBlock Grid.Row="0" 

                          Text="Đồ Thị Hàm Số"

                          FontSize="24"

                          FontWeight="Bold"

                          Foreground="#2F3542"

                          Margin="10,10,10,15"

                          HorizontalAlignment="Center"/>



                <!-- OxyPlot View -->

                <oxy:PlotView x:Name="GraphPlotView" 

                             Grid.Row="1"

                             Margin="5"/>

            </Grid>

        </Border>



        <!-- RIGHT PANEL: Controls -->

        <Border Grid.Column="1" Background="White" Margin="0,15,15,15" CornerRadius="12">

            <Border.Effect>

                <DropShadowEffect Color="#CCCCCC" Direction="315" ShadowDepth="5" BlurRadius="15" Opacity="0.3"/>

            </Border.Effect>



            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="15">

                    

                    <!-- Title -->

                    <TextBlock Text="⚙️ Cấu Hình Đồ Thị"

                              FontSize="20"

                              FontWeight="Bold"

                              Foreground="#2F3542"

                              Margin="0,0,0,15"/>



                    <!-- Add Graph Button -->

                    <Button Content="➕ Thêm Đồ Thị"

                           Click="BtnAddGraph_Click"

                           Style="{StaticResource GraphButtonStyle}"/>



                    <Separator Margin="0,15"/>



                    <!-- Graphs List -->

                    <TextBlock Text="Danh Sách Đồ Thị"

                              FontSize="16"

                              FontWeight="SemiBold"

                              Foreground="#2F3542"

                              Margin="0,0,0,10"/>



                    <ItemsControl x:Name="GraphsList">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F8F9FA" 

                                       CornerRadius="8" 

                                       Padding="12"

                                       Margin="0,0,0,10">

                                    <StackPanel>

                                        <!-- Header -->

                                        <Grid Margin="0,0,0,10">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>



                                            <!-- Visibility Checkbox -->

                                            <CheckBox Grid.Column="0"

                                                     IsChecked="{Binding IsVisible}"

                                                     VerticalAlignment="Center"

                                                     Margin="0,0,8,0"/>



                                            <!-- Color Indicator & ID -->

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">

                                                <Border Width="20" Height="20" 

                                                       CornerRadius="3"

                                                       Margin="0,0,8,0"

                                                       VerticalAlignment="Center">

                                                    <Border.Background>

                                                        <SolidColorBrush Color="{Binding Color}"/>

                                                    </Border.Background>

                                                </Border>

                                                <TextBlock Text="{Binding Id, StringFormat='Đồ thị {0}'}"

                                                          FontWeight="SemiBold"

                                                          FontSize="14"

                                                          VerticalAlignment="Center"/>

                                            </StackPanel>



                                            <!-- Remove Button -->

                                            <Button Grid.Column="2"

                                                   Content="🗑️"

                                                   Click="BtnRemoveGraph_Click"

                                                   Tag="{Binding Id}"

                                                   Style="{StaticResource RemoveButtonStyle}"/>

                                        </Grid>



                                        <!-- Function Type -->

                                        <TextBlock Text="Loại hàm số:"

                                                  FontSize="12"

                                                  Foreground="#666"

                                                  Margin="0,0,0,5"/>

                                        <ComboBox x:Name="FunctionTypeCombo"

                                                 SelectedValue="{Binding Type}"

                                                 SelectionChanged="FunctionType_SelectionChanged"

                                                 Tag="{Binding Id}"

                                                 Padding="8"

                                                 Margin="0,0,0,10">

                                            <ComboBoxItem Content="y = |ax + b|" Tag="Absolute"/>

                                            <ComboBoxItem Content="y = sin(x)" Tag="Sin"/>

                                            <ComboBoxItem Content="y = cos(x)" Tag="Cos"/>

                                            <ComboBoxItem Content="y = tan(x)" Tag="Tan"/>

                                            <ComboBoxItem Content="y = a^x" Tag="Exponential"/>

                                            <ComboBoxItem Content="y = log_a(x)" Tag="Logarithm"/>

                                            <ComboBoxItem Content="y = ax³+bx²+cx+d" Tag="Cubic"/>

                                            <ComboBoxItem Content="y = (ax+b)/(cx+d)" Tag="Rational"/>

                                            <ComboBoxItem Content="y = sin(ax+b)" Tag="Composite"/>

                                        </ComboBox>



                                        <!-- Formula Display -->

                                        <Border Background="#E3F2FD" 

                                               CornerRadius="5" 

                                               Padding="8"

                                               Margin="0,0,0,10">

                                            <TextBlock Text="{Binding FormulaString}"

                                                      FontFamily="Cambria Math, Segoe UI"

                                                      FontSize="13"

                                                      TextWrapping="Wrap"/>

                                        </Border>



                                        <!-- Parameters (will be shown conditionally) -->

                                        <StackPanel x:Name="ParametersPanel">

                                            <!-- Parameter A -->

                                            <StackPanel x:Name="ParamA" Margin="0,0,0,10">

                                                <Grid>

                                                    <TextBlock Text="Hệ số a:" FontSize="12" Foreground="#666"/>

                                                    <TextBlock Text="{Binding A, StringFormat='{}{0:F1}'}" 

                                                              FontWeight="Bold"

                                                              FontSize="14"

                                                              HorizontalAlignment="Right"/>

                                                </Grid>

                                                <Slider Value="{Binding A, Mode=TwoWay}"

                                                       Style="{StaticResource ParameterSlider}"

                                                       ValueChanged="Parameter_ValueChanged"/>

                                            </StackPanel>



                                            <!-- Parameter B -->

                                            <StackPanel x:Name="ParamB" Margin="0,0,0,10">

                                                <Grid>

                                                    <TextBlock Text="Hệ số b:" FontSize="12" Foreground="#666"/>

                                                    <TextBlock Text="{Binding B, StringFormat='{}{0:F1}'}" 

                                                              FontWeight="Bold"

                                                              FontSize="14"

                                                              HorizontalAlignment="Right"/>

                                                </Grid>

                                                <Slider Value="{Binding B, Mode=TwoWay}"

                                                       Minimum="-10"

                                                       Maximum="10"

                                                       TickFrequency="0.5"

                                                       IsSnapToTickEnabled="True"

                                                       Height="30"

                                                       ValueChanged="Parameter_ValueChanged"/>

                                            </StackPanel>



                                            <!-- Parameter C -->

                                            <StackPanel x:Name="ParamC" Margin="0,0,0,10">

                                                <Grid>

                                                    <TextBlock Text="Hệ số c:" FontSize="12" Foreground="#666"/>

                                                    <TextBlock Text="{Binding C, StringFormat='{}{0:F1}'}" 

                                                              FontWeight="Bold"

                                                              FontSize="14"

                                                              HorizontalAlignment="Right"/>

                                                </Grid>

                                                <Slider Value="{Binding C, Mode=TwoWay}"

                                                       Style="{StaticResource ParameterSlider}"

                                                       ValueChanged="Parameter_ValueChanged"/>

                                            </StackPanel>



                                            <!-- Parameter D -->

                                            <StackPanel x:Name="ParamD" Margin="0,0,0,10">

                                                <Grid>

                                                    <TextBlock Text="Hệ số d:" FontSize="12" Foreground="#666"/>

                                                    <TextBlock Text="{Binding D, StringFormat='{}{0:F1}'}" 

                                                              FontWeight="Bold"

                                                              FontSize="14"

                                                              HorizontalAlignment="Right"/>

                                                </Grid>

                                                <Slider Value="{Binding D, Mode=TwoWay}"

                                                       Style="{StaticResource ParameterSlider}"

                                                       ValueChanged="Parameter_ValueChanged"/>

                                            </StackPanel>

                                        </StackPanel>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <Separator Margin="0,15"/>



                    <!-- Insert Button -->

                    <Button Content="✅ Chèn Vào Canvas"

                           Click="BtnInsert_Click"

                           Style="{StaticResource InsertButtonStyle}"/>



                    <!-- Guide -->

                    <Border Background="#FFF3E0" 

                           CornerRadius="8" 

                           Padding="12"

                           Margin="0,15,0,0">

                        <StackPanel>

                            <TextBlock Text="Hướng Dẫn"

                                      FontWeight="Bold"

                                      FontSize="14"

                                      Foreground="#E65100"

                                      Margin="0,0,0,8"/>

                            <TextBlock TextWrapping="Wrap" 

                                      FontSize="12"

                                      Foreground="#5D4037"

                                      LineHeight="18">

                                • Click "Thêm Đồ Thị" để vẽ nhiều đồ thị

                                <LineBreak/>

                                • Tick/untick để ẩn/hiện đồ thị

                                <LineBreak/>

                                • Chọn loại hàm và điều chỉnh tham số

                                <LineBreak/>

                                • Click "Chèn Vào Canvas" khi hoàn tất

                            </TextBlock>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>

