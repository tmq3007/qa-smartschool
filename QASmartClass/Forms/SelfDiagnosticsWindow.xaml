<Window x:Class="QASmartClass.Forms.SelfDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chẩn đoán sức khỏe hệ thống QA SmartClass" 
        Height="550" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Style for Premium Buttons -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E86DE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B6FCA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2C3A4B"/>
                    <Setter Property="Foreground" Value="#6C7A89"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="#4A5568" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A5568"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#121620" CornerRadius="16" BorderBrush="#2E86DE" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="*"/>    <!-- Test List -->
                <RowDefinition Height="Auto"/> <!-- Console/Info Output -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔍 CHẨN ĐOÁN HỆ THỐNG" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Kiểm tra kết nối mạng, cơ sở dữ liệu và môi trường chạy" FontSize="11" Foreground="#8E9AAF" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" FontSize="16" Foreground="#8E9AAF" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- 2. TEST LIST -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel x:Name="pnlTestItems">
                    <!-- Item 1: Database SQLite -->
                    <Border Background="#1E2530" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💾" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Cơ sở dữ liệu SQLite" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock x:Name="lblDbDetails" Text="Kiểm tra đọc, ghi và quyền truy cập file" FontSize="11" Foreground="#8E9AAF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblDbStatus" Text="Chờ test..." FontWeight="Bold" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Item 2: Server Connectivity (Ping) -->
                    <Border Background="#1E2530" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🌐" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Kết nối Server" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock x:Name="lblNetworkDetails" Text="Ping tới máy chủ giáo viên" FontSize="11" Foreground="#8E9AAF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblNetworkStatus" Text="Chờ test..." FontWeight="Bold" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Item 3: Ports Availability -->
                    <Border Background="#1E2530" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔌" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Cổng mạng truyền tin (Port)" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock x:Name="lblPortDetails" Text="Kiểm tra các cổng: 8080 (WebRTC), 9000 (Lệnh), 9001 (Tệp)" FontSize="11" Foreground="#8E9AAF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblPortStatus" Text="Chờ test..." FontWeight="Bold" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Item 4: WebView2 Runtime -->
                    <Border Background="#1E2530" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🖥️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Trình duyệt WebView2" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock x:Name="lblWebviewDetails" Text="Kiểm tra thư viện WebView2 Runtime" FontSize="11" Foreground="#8E9AAF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="lblWebviewStatus" Text="Chờ test..." FontWeight="Bold" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. CONSOLE OUTPUT -->
            <Border Grid.Row="2" Background="#0C0E14" CornerRadius="8" Padding="12" Margin="0,0,0,20" Height="80" BorderBrush="#232938" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtConsoleOutput" Text="Bấm nút 'Bắt đầu chẩn đoán' để quét hệ thống." FontSize="11" FontFamily="Consolas" Foreground="#00FF00" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- 4. ACTION BUTTONS -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="btnRun" Content="⚡ BẮT ĐẦU CHẨN ĐOÁN" Style="{StaticResource ActionButtonStyle}" Click="Run_Click" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" x:Name="btnCopy" Content="📋 Sao chép JSON" Style="{StaticResource SecondaryButtonStyle}" Click="Copy_Click" Margin="10,0,0,0" IsEnabled="False"/>
                <Button Grid.Column="2" Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click" Margin="10,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
