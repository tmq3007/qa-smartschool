<Window x:Class="QASmartTouch.Forms.Form2_5_SubMenuZoom"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="5. Thu phóng" 

        Width="300" Height="360"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False">



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid Margin="15">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <!-- Header -->

                <RowDefinition Height="Auto"/>

                <!-- Zoom Slider -->

                <RowDefinition Height="Auto"/>

                <!-- Quick Buttons -->

                <RowDefinition Height="Auto"/>

                <!-- Area Zoom -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Grid Grid.Row="0" Margin="0,0,0,15">

                <StackPanel Orientation="Horizontal">

                    <Path Fill="#2E86DE" 

                          Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z"

                          Width="18" Height="18"

                          Stretch="Uniform"

                          VerticalAlignment="Center"

                          Margin="0,0,8,0"/>

                    <TextBlock Text="5. Thu phóng" 

                              FontSize="16" 

                              FontWeight="Bold" 

                              Foreground="#2F3542"

                              VerticalAlignment="Center"/>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Style="{StaticResource CloseButton}"

                       Click="btnClose_Click"/>

            </Grid>



            <!-- ZOOM SLIDER -->

            <StackPanel Grid.Row="1" Margin="0,0,0,15">

                <Grid Margin="0,0,0,8">

                    <TextBlock Text="Mức thu phóng" 

                              FontSize="13" 

                              Foreground="#57606F"

                              VerticalAlignment="Center"/>

                    <TextBlock x:Name="txtZoomValue" 

                              Text="100%" 

                              FontSize="14"

                              FontWeight="Bold"

                              Foreground="#2E86DE"

                              HorizontalAlignment="Right"

                              VerticalAlignment="Center"/>

                </Grid>

                

                <Slider x:Name="sliderZoom" 

                       Minimum="50" Maximum="400" 

                       Value="100"

                       TickFrequency="50"

                       IsSnapToTickEnabled="True"

                       ValueChanged="sliderZoom_ValueChanged"/>

                

                <Grid Margin="0,4,0,0">

                    <TextBlock Text="50%" 

                              FontSize="10" 

                              Foreground="#A4B0BE"

                              HorizontalAlignment="Left"/>

                    <TextBlock Text="400%" 

                              FontSize="10" 

                              Foreground="#A4B0BE"

                              HorizontalAlignment="Right"/>

                </Grid>

            </StackPanel>



            <!-- QUICK BUTTONS -->

            <StackPanel Grid.Row="2" Margin="0,0,0,15">

                <TextBlock Text="Lựa chọn nhanh" 

                          FontSize="12" 

                          Foreground="#57606F"

                          Margin="0,0,0,8"/>

                

                <UniformGrid Columns="4" 

                            HorizontalAlignment="Stretch">

                    <!-- Zoom Out -->

                    <Button Width="60" Height="50" 

                           Margin="2"

                           Background="#F1F2F6"

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btnZoomOut_Click"

                           ToolTip="Thu nhỏ">

                        <StackPanel>

                            <TextBlock Text="−" 

                                      FontSize="20"

                                      FontWeight="Bold"

                                      Foreground="#2F3542"

                                      HorizontalAlignment="Center"/>

                            <TextBlock Text="Nhỏ" 

                                      FontSize="9"

                                      Foreground="#747D8C"

                                      HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- Zoom In -->

                    <Button Width="60" Height="50" 

                           Margin="2"

                           Background="#F1F2F6"

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btnZoomIn_Click"

                           ToolTip="Phóng to">

                        <StackPanel>

                            <TextBlock Text="+" 

                                      FontSize="20"

                                      FontWeight="Bold"

                                      Foreground="#2F3542"

                                      HorizontalAlignment="Center"/>

                            <TextBlock Text="Lớn" 

                                      FontSize="9"

                                      Foreground="#747D8C"

                                      HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- 100% -->

                    <Button Width="60" Height="50" 

                           Margin="2"

                           Background="#E3F2FD"

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btn100_Click"

                           ToolTip="100%">

                        <StackPanel>

                            <TextBlock Text="100%" 

                                      FontSize="13"

                                      FontWeight="Bold"

                                      Foreground="#2196F3"

                                      HorizontalAlignment="Center"/>

                            <TextBlock Text="Gốc" 

                                      FontSize="9"

                                      Foreground="#2196F3"

                                      HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- Fit -->

                    <Button Width="60" Height="50" 

                           Margin="2"

                           Background="#F1F2F6"

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btnFit_Click"

                           ToolTip="Vừa khung">

                        <StackPanel>

                            <Path Fill="#2F3542" 

                                 Data="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z"

                                 Width="16" Height="16"

                                 Stretch="Uniform"

                                 HorizontalAlignment="Center"/>

                            <TextBlock Text="Vừa" 

                                      FontSize="9"

                                      Foreground="#747D8C"

                                      HorizontalAlignment="Center"

                                      Margin="0,2,0,0"/>

                        </StackPanel>

                    </Button>

                </UniformGrid>

            </StackPanel>



            <!-- AREA ZOOM -->

            <Border Grid.Row="3" 

                   Background="#FFF9C4"

                   CornerRadius="8"

                   Padding="10">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <Path Grid.Column="0" 

                         Fill="#F57C00" 

                         Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"

                         Width="18" Height="18"

                         VerticalAlignment="Top"

                         Margin="0,0,8,0"/>



                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Mẹo: Zoom vùng chọn" 

                                  FontSize="11"

                                  FontWeight="SemiBold"

                                  Foreground="#F57C00"

                                  Margin="0,0,0,4"/>

                        <TextBlock FontSize="10"

                                  Foreground="#F57C00"

                                  TextWrapping="Wrap">

                            <Run Text="Chọn vùng để phóng to:"/>

                            <LineBreak/>

                            <Run Text="Nhấn Ctrl + Kéo chuột"/>

                        </TextBlock>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

