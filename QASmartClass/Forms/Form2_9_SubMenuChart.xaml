<Window x:Class="QASmartTouch.Forms.Form2_9_SubMenuChart"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Biểu đồ" 

        Width="560" Height="140"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False">



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid Margin="15">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Grid Grid.Row="0" Margin="0,0,0,15">

                <StackPanel Orientation="Horizontal">

                    <Path Fill="#2E86DE" 

                          Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"

                          Width="20" Height="20"

                          Stretch="Uniform"

                          VerticalAlignment="Center"

                          Margin="0,0,8,0"/>

                    <TextBlock Text="Biểu đồ" 

                              FontSize="16" 

                              FontWeight="Bold" 

                              Foreground="#2F3542"

                              VerticalAlignment="Center"/>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Style="{StaticResource CloseButton}"

                       Click="btnClose_Click"/>

            </Grid>



            <!-- CHART TYPE BUTTONS -->

            <UniformGrid Grid.Row="1" Columns="4" Rows="1">

                

                <!-- Bar Chart (Cột) -->

                <Button x:Name="btnBarChart" 

                       Margin="5"

                       Background="White"

                       BorderBrush="#E1E8ED"

                       BorderThickness="1"

                       Cursor="Hand"

                       Click="btnBarChart_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   BorderBrush="{TemplateBinding BorderBrush}"

                                   BorderThickness="{TemplateBinding BorderThickness}"

                                   CornerRadius="10"

                                   Padding="10">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- Bar Chart Icon (Green) -->

                                    <Viewbox Width="32" Height="32" Margin="0,0,0,8">

                                        <Canvas Width="24" Height="24">

                                            <Rectangle Width="4" Height="14" Canvas.Left="2" Canvas.Top="8" Fill="#57C84D"/>

                                            <Rectangle Width="4" Height="18" Canvas.Left="8" Canvas.Top="4" Fill="#57C84D"/>

                                            <Rectangle Width="4" Height="10" Canvas.Left="14" Canvas.Top="12" Fill="#57C84D"/>

                                            <Rectangle Width="4" Height="16" Canvas.Left="20" Canvas.Top="6" Fill="#57C84D"/>

                                        </Canvas>

                                    </Viewbox>

                                    <TextBlock Text="Cột" 

                                             FontSize="12" 

                                             FontWeight="SemiBold"

                                             Foreground="#2F3542"

                                             HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Line Chart (Đường) -->

                <Button x:Name="btnLineChart" 

                       Margin="5"

                       Background="White"

                       BorderBrush="#E1E8ED"

                       BorderThickness="1"

                       Cursor="Hand"

                       Click="btnLineChart_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   BorderBrush="{TemplateBinding BorderBrush}"

                                   BorderThickness="{TemplateBinding BorderThickness}"

                                   CornerRadius="10"

                                   Padding="10">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- Line Chart Icon (Blue) -->

                                    <Viewbox Width="32" Height="32" Margin="0,0,0,8">

                                        <Canvas Width="24" Height="24">

                                            <Polyline Points="2,18 8,12 14,16 20,6" 

                                                    Stroke="#2E86DE" 

                                                    StrokeThickness="2" 

                                                    StrokeLineJoin="Round"/>

                                            <Ellipse Width="4" Height="4" Canvas.Left="0" Canvas.Top="16" Fill="#2E86DE"/>

                                            <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="10" Fill="#2E86DE"/>

                                            <Ellipse Width="4" Height="4" Canvas.Left="12" Canvas.Top="14" Fill="#2E86DE"/>

                                            <Ellipse Width="4" Height="4" Canvas.Left="18" Canvas.Top="4" Fill="#2E86DE"/>

                                        </Canvas>

                                    </Viewbox>

                                    <TextBlock Text="Đường" 

                                             FontSize="12" 

                                             FontWeight="SemiBold"

                                             Foreground="#2F3542"

                                             HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Pie Chart (Tròn) -->

                <Button x:Name="btnPieChart" 

                       Margin="5"

                       Background="White"

                       BorderBrush="#E1E8ED"

                       BorderThickness="1"

                       Cursor="Hand"

                       Click="btnPieChart_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   BorderBrush="{TemplateBinding BorderBrush}"

                                   BorderThickness="{TemplateBinding BorderThickness}"

                                   CornerRadius="10"

                                   Padding="10">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- Pie Chart Icon (Orange) -->

                                    <Viewbox Width="32" Height="32" Margin="0,0,0,8">

                                        <Canvas Width="24" Height="24">

                                            <Path Fill="#FFA502" 

                                                  Data="M12,2A10,10 0 0,1 22,12H12V2Z"/>

                                            <Path Fill="#FF6348" 

                                                  Data="M12,12V22A10,10 0 0,1 2,12A10,10 0 0,1 12,2V12Z"/>

                                        </Canvas>

                                    </Viewbox>

                                    <TextBlock Text="Tròn" 

                                             FontSize="12" 

                                             FontWeight="SemiBold"

                                             Foreground="#2F3542"

                                             HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Radar/Area Chart (Vùng) -->

                <Button x:Name="btnRadarChart" 

                       Margin="5"

                       Background="White"

                       BorderBrush="#E1E8ED"

                       BorderThickness="1"

                       Cursor="Hand"

                       Click="btnRadarChart_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   BorderBrush="{TemplateBinding BorderBrush}"

                                   BorderThickness="{TemplateBinding BorderThickness}"

                                   CornerRadius="10"

                                   Padding="10">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- Radar Chart Icon (Purple) -->

                                    <Viewbox Width="32" Height="32" Margin="0,0,0,8">

                                        <Canvas Width="24" Height="24">

                                            <Polygon Points="12,4 20,10 18,18 6,18 4,10" 

                                                    Fill="#A29BFE" 

                                                    Opacity="0.6"

                                                    Stroke="#6C5CE7" 

                                                    StrokeThickness="1.5"/>

                                        </Canvas>

                                    </Viewbox>

                                    <TextBlock Text="Vùng" 

                                             FontSize="12" 

                                             FontWeight="SemiBold"

                                             Foreground="#2F3542"

                                             HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



            </UniformGrid>

        </Grid>

    </Border>

</Window>

