<Window x:Class="QASmartTouch.Forms.Form0_LoginSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA SmartSchool - Lựa chọn đăng nhập"
        WindowState="Maximized" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Card Button Style for Light Theme -->
        <Style x:Key="LoginCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="15,10"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="15" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hover effect using WPF Triggers -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2563EB" Opacity="0.12" BlurRadius="20" ShadowDepth="3"/>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>

                <!-- Focus effect for Tab navigation -->
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2.5"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2563EB" Opacity="0.1" BlurRadius="15" ShadowDepth="2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8F4F8" Offset="0"/>
                <GradientStop Color="#D6E9F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border CornerRadius="24" BorderBrush="#CBD5E1" BorderThickness="1.5"
                Width="1120" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F8FAFC">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="4" Opacity="0.25" Color="#475569"/>
            </Border.Effect>
            
            <Grid x:Name="InnerGrid" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <!-- Mode Switcher (Left) - Hidden by default for production, toggled in Settings or by shortcut -->
                    <Border x:Name="modeSwitcherBorder" CornerRadius="8" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" 
                            HorizontalAlignment="Left" VerticalAlignment="Center" Height="36" Width="220" Margin="10,10,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnReleaseMode" Grid.Column="0" Content="Phát hành" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnReleaseMode_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Margin="2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="btnTestMode" Grid.Column="1" Content="Thử nghiệm" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Click="BtnTestMode_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Margin="2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Title (Center) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1.5" 
                                CornerRadius="18" Padding="18,8" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <!-- School/Graduation Icon -->
                                        <Path Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z" Fill="#2563EB"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="HỆ SINH THÁI GIÁO DỤC QA SMART SCHOOL" 
                                           FontSize="18" FontWeight="ExtraBold" Foreground="#2563EB" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock Text="Vui lòng lựa chọn dịch vụ đăng nhập" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Buttons (Right) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0">
                        <!-- Settings Icon -->
                        <Button x:Name="btnSettings" Content="⚙️" 
                                Width="36" Height="36" FontSize="18" Margin="0,0,8,0"
                                Foreground="#475569" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="btnSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="btnClose" Content="✕" 
                                Width="36" Height="36" FontSize="16" FontWeight="Bold" 
                                Foreground="#475569" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="btnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EF4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
                
                  <UniformGrid x:Name="cardsGrid" Grid.Row="1" Columns="2" Margin="10,10,10,10">
                    <!-- Card 1: QA SmartTouch (Teacher/Whiteboard) -->
                    <Border x:Name="cardSmartTouch" Style="{StaticResource LoginCard}"
                            MouseLeftButtonDown="CardSmartTouch_Click"
                            MouseEnter="CardSmartTouch_MouseEnter" MouseLeave="CardSmartTouch_MouseLeave"
                            GotFocus="CardSmartTouch_GotFocus" LostFocus="CardSmartTouch_LostFocus"
                            KeyDown="CardSmartTouch_KeyDown">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#E0E7FF" HorizontalAlignment="Left">
                                <Viewbox Width="28" Height="28">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Fill="#2563EB"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            
                            <TextBlock Grid.Row="1" Text="QA SmartTouch" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,16,0,8"/>
                            <TextBlock Grid.Row="2" Text="Giải pháp bảng tương tác thông minh dành cho Giáo viên. Hỗ trợ giảng dạy, soạn bài giảng, tương tác trực tiếp và tổ chức các hoạt động lớp học." 
                                       FontSize="14" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top"/>
                            
                            <Border Grid.Row="3" x:Name="btnTouchLabel" Height="40" CornerRadius="8" Background="#2563EB" Margin="0,16,0,0">
                                <TextBlock x:Name="txtTouchLabel" Text="Đăng nhập Giáo viên" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Card 2: QA SmartClass (Student Client) -->
                    <Border x:Name="cardSmartClass" Style="{StaticResource LoginCard}"
                            MouseEnter="CardSmartClass_MouseEnter" MouseLeave="CardSmartClass_MouseLeave"
                            GotFocus="CardSmartClass_GotFocus" LostFocus="CardSmartClass_LostFocus"
                            KeyDown="CardSmartClass_KeyDown">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#D1FAE5" HorizontalAlignment="Left">
                                <Viewbox Width="28" Height="28">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z" Fill="#059669"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            
                            <TextBlock Grid.Row="1" Text="QA SmartClass" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,16,0,8"/>
                            <TextBlock Grid.Row="2" Text="Ứng dụng kết nối tương tác lớp học. Hỗ trợ Giáo viên tổ chức giảng dạy, phát bài tập và tương tác trực tiếp với Học sinh trong lớp học." 
                                       FontSize="14" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top"/>
                            
                            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                <Button x:Name="btnClassTeacher" Height="38" Margin="0,0,0,8" Cursor="Hand" Click="BtnClassTeacher_Click" BorderThickness="0" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="8" Background="#2563EB">
                                                <TextBlock Text="Đăng nhập Giáo viên" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnClassStudent" Height="38" Cursor="Hand" Click="BtnClassStudent_Click" BorderThickness="0" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="8" Background="#059669">
                                                <TextBlock Text="Đăng nhập Học sinh" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#047857"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
 
                    <!-- Card 3: Cổng Phụ Huynh (Parent) -->
                    <Border x:Name="cardParent" Style="{StaticResource LoginCard}" Visibility="Collapsed"
                            IsEnabled="False"
                            MouseLeftButtonDown="CardParent_Click"
                            MouseEnter="CardParent_MouseEnter" MouseLeave="CardParent_MouseLeave"
                            GotFocus="CardParent_GotFocus" LostFocus="CardParent_LostFocus"
                            KeyDown="CardParent_KeyDown">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#ECFEFF" HorizontalAlignment="Left">
                                <Viewbox Width="28" Height="28">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,16 20,18V20H4V18C4,16 7.58,14 12,14Z" Fill="#06B6D4"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            
                            <TextBlock Grid.Row="1" Text="Cổng Phụ Huynh" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,16,0,8"/>
                            <TextBlock Grid.Row="2" Text="Cổng thông tin liên lạc dành cho Phụ huynh học sinh. Xem kết quả học tập, điểm danh, nộp đơn xin nghỉ và nhắn tin trao đổi với giáo viên." 
                                       FontSize="14" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top"/>
                            
                            <Border Grid.Row="3" x:Name="btnParentLabel" Height="40" CornerRadius="8" Background="#06B6D4" Margin="0,16,0,0">
                                <TextBlock x:Name="txtParentLabel" Text="Đăng nhập Phụ huynh" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
 
                    <!-- Card 4: Cán bộ Nhân viên (Staff) -->
                    <Border x:Name="cardStaff" Style="{StaticResource LoginCard}" Visibility="Visible"
                            IsEnabled="True"
                            MouseLeftButtonDown="CardStaff_Click"
                            MouseEnter="CardStaff_MouseEnter" MouseLeave="CardStaff_MouseLeave"
                            GotFocus="CardStaff_GotFocus" LostFocus="CardStaff_LostFocus"
                            KeyDown="CardStaff_KeyDown">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#FFEDD5" HorizontalAlignment="Left">
                                <Viewbox Width="28" Height="28">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 3L2 12h3v8h14v-8h3L12 3zm0 4.5c1.38 0 2.5 1.12 2.5 2.5s-1.12 2.5-2.5 2.5-2.5-1.12-2.5-2.5 1.12-2.5 2.5-2.5zM12 18H8v-3h8v3h-4z" Fill="#EA580C"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            
                            <TextBlock Grid.Row="1" Text="Cán bộ Nhân viên" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,16,0,8"/>
                            <TextBlock Grid.Row="2" Text="Cổng nghiệp vụ dành cho Cán bộ, Nhân viên văn phòng, Bảo vệ, Y tế và Ban giám hiệu. Quản lý hành chính, báo cáo và hậu cần nhà trường." 
                                       FontSize="14" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top"/>
                            
                            <Border Grid.Row="3" x:Name="btnStaffLabel" Height="40" CornerRadius="8" Background="#EA580C" Margin="0,16,0,0">
                                <TextBlock x:Name="txtStaffLabel" Text="Đăng nhập Nhân viên" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>
                
                <!-- Footer -->
                <TextBlock Grid.Row="2" Text="QA Smart School - Chuyển đổi số toàn diện hoạt động giảng dạy và học tập" 
                           FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </Grid>
        </Border>

        <!-- Admin Settings Overlay Panel (⚙️) - Increased Height for Master Settings Options -->
        <Grid x:Name="adminOverlay" Background="#D9F8FAFC" Visibility="Collapsed" Panel.ZIndex="99">
            <Border Width="400" Height="360" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="25" Opacity="0.15" ShadowDepth="4"/>
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Cấu hình Kỹ thuật viên / Admin" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15">
                        <TextBlock Text="Khóa đối tượng sử dụng (Active User Role):" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboActiveRole" Height="34" FontSize="14" Padding="8,4" Margin="0,0,0,12">
                            <ComboBoxItem Content="Tất cả vai trò" Tag="All"/>
                            <ComboBoxItem Content="Chỉ Giáo viên" Tag="Teacher"/>
                            <ComboBoxItem Content="Chỉ Học sinh" Tag="Student"/>
                            <ComboBoxItem Content="Chỉ Phụ huynh" Tag="Parent"/>
                            <ComboBoxItem Content="Chỉ Cán bộ Nhân viên" Tag="Staff"/>
                        </ComboBox>
                        
                        <TextBlock Text="Dịch vụ chưa đăng ký bản quyền (Inactive Services):" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboShowInactiveMode" Height="34" FontSize="14" Padding="8,4">
                            <ComboBoxItem Content="Ẩn hoàn toàn (Khuyên dùng)" Tag="Hidden"/>
                            <ComboBoxItem Content="Khóa và hiển thị quảng cáo nâng cấp" Tag="LockedUpsell"/>
                        </ComboBox>
                        
                        <TextBlock Text="* Các cài đặt cấu hình sẽ được áp dụng ngay lập tức." FontSize="11" Foreground="#64748B" FontStyle="Italic" Margin="0,8,0,0"/>
                    </StackPanel>
                    
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy" Height="36" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnAdminCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="Lưu Cấu Hình" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAdminSave_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay Panel -->
        <Grid x:Name="loadingOverlay" Background="#D9F8FAFC" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="450" Height="220" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="25" Opacity="0.15" ShadowDepth="4"/>
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="HỆ THỐNG ĐANG KHỞI ĐỘNG" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                    
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15">
                        <TextBlock x:Name="lblLoadingStatus" Text="Vui lòng chờ chương trình khởi động..." Foreground="#475569" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="pbLoading" Height="8" IsIndeterminate="True" Margin="0,15,0,0" Background="#E2E8F0" Foreground="#2563EB">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
                                        <Grid x:Name="TemplateRoot">
                                            <Track x:Name="PART_Track">
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Visibility="Collapsed"/>
                                                </Track.IncreaseRepeatButton>
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Visibility="Collapsed"/>
                                                </Track.DecreaseRepeatButton>
                                            </Track>
                                            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
