<Window x:Class="QASmartTouch.Forms.Form3_1_LectureLibrary"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Thư viện bài giảng" 

        Width="1100" Height="750"

        WindowStartupLocation="CenterScreen"

        Background="#F5F7FA"

        ResizeMode="CanResize"

        MinWidth="1000" MinHeight="700">



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="70"/>

            <!-- Header -->

            <RowDefinition Height="60"/>

            <!-- Toolbar -->

            <RowDefinition Height="*"/>

            <!-- Content -->

        </Grid.RowDefinitions>



        <!-- HEADER -->

        <Border Grid.Row="0" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">

            <Grid Margin="25,0">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Path Fill="#2E86DE" 

                          Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z"

                          Width="32" Height="32"

                          Margin="0,0,15,0"/>

                    <StackPanel>

                        <TextBlock Text="Thư viện bài giảng" 

                                  FontSize="24" 

                                  FontWeight="Bold" 

                                  Foreground="#2F3542"/>

                        <TextBlock Text="Quản lý và tổ chức các bài giảng của bạn" 

                                  FontSize="12" 

                                  Foreground="#57606F"

                                  Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Width="40" Height="40"

                       HorizontalAlignment="Right"

                       Background="#FEE2E2"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnClose_Click">

                    <Path Fill="#EE5A6F" 

                         Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                         Width="18" Height="18"/>

                </Button>

            </Grid>

        </Border>



        <!-- TOOLBAR -->

        <Border Grid.Row="1" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1" Padding="25,0">

            <Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button x:Name="btnNewLecture" Height="38" Padding="15,0" Margin="0,0,8,0"

                           Background="#2E86DE" Foreground="White" BorderThickness="0" Cursor="Hand"

                           Click="btnNewLecture_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="16" Height="16" Margin="0,0,8,0"/>

                            <TextBlock Text="Tạo mới" FontSize="12" FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnOpenLecture" Height="38" Padding="15,0" Margin="0,0,8,0"

                           Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"

                           Click="btnOpenLecture_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z" Width="16" Height="16" Margin="0,0,8,0"/>

                            <TextBlock Text="Mở" FontSize="12" FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnDeleteLecture" Height="38" Padding="15,0" Margin="0,0,8,0"

                           Background="#F44336" Foreground="White" BorderThickness="0" Cursor="Hand"

                           Click="btnDeleteLecture_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="16" Height="16" Margin="0,0,8,0"/>

                            <TextBlock Text="Xóa" FontSize="12" FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnDuplicate" Height="38" Padding="15,0" Margin="0,0,8,0"

                           Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand"

                           Click="btnDuplicate_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" Data="M11,17H4A2,2 0 0,1 2,15V3A2,2 0 0,1 4,1H16V3H4V15H11V13L15,16L11,19V17M19,21V7H8V13H6V7A2,2 0 0,1 8,5H19A2,2 0 0,1 21,7V21A2,2 0 0,1 19,23H8A2,2 0 0,1 6,21V19H8V21H19Z" Width="16" Height="16" Margin="0,0,8,0"/>

                            <TextBlock Text="Sao chép" FontSize="12" FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnExport" Height="38" Padding="15,0" Margin="0,0,8,0"

                           Background="#9C27B0" Foreground="White" BorderThickness="0" Cursor="Hand"

                           Click="btnExport_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Width="16" Height="16" Margin="0,0,8,0"/>

                            <TextBlock Text="Xuất file" FontSize="12" FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnCloudSync" Height="38" Padding="15,0"

                           Background="#00BCD4" Foreground="White" BorderThickness="0" Cursor="Hand"

                           Click="btnCloudSync_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04Z" Width="16" Height="16" Margin="0,0,8,0"/>

                            <TextBlock Text="Đồng bộ" FontSize="12" FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <TextBox x:Name="txtSearch" Width="250" Height="35" FontSize="12"

                            Background="#F1F2F6" BorderThickness="0" Padding="10,0"

                            Text="Tìm kiếm bài giảng..."/>

                    <Button Width="35" Height="35" Background="#2E86DE" BorderThickness="0" Cursor="Hand"

                           Margin="8,0,0,0" Click="btnSearch_Click">

                        <Path Fill="White" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Width="16" Height="16"/>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>



        <!-- CONTENT -->

        <Grid Grid.Row="2" Margin="25,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="320"/>

            </Grid.ColumnDefinitions>



            <!-- LEFT: Lecture List -->

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0"

                   BorderBrush="#E1E8ED" BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Filters -->

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">

                        <ComboBox x:Name="cmbSortBy" Width="150" Height="35" FontSize="12" SelectedIndex="0"

                                 SelectionChanged="cmbSortBy_SelectionChanged">

                            <ComboBoxItem Content="Mới nhất"/>

                            <ComboBoxItem Content="Cũ nhất"/>

                            <ComboBoxItem Content="Tên A-Z"/>

                            <ComboBoxItem Content="Kích thước"/>

                        </ComboBox>

                        <ComboBox x:Name="cmbFilterTag" Width="150" Height="35" FontSize="12" Margin="10,0,0,0" SelectedIndex="0">

                            <ComboBoxItem Content="Tất cả"/>

                            <ComboBoxItem Content="🔴 Toán học"/>

                            <ComboBoxItem Content="🔵 Vật lý"/>

                            <ComboBoxItem Content="🟢 Hóa học"/>

                            <ComboBoxItem Content="🟡 Ngữ văn"/>

                        </ComboBox>

                        <ComboBox x:Name="cmbFilterStatus" Width="120" Height="35" FontSize="12" Margin="10,0,0,0" SelectedIndex="0">

                            <ComboBoxItem Content="Tất cả"/>

                            <ComboBoxItem Content="Bản nháp"/>

                            <ComboBoxItem Content="Đã hoàn thành"/>

                        </ComboBox>

                    </StackPanel>



                    <!-- DataGrid -->

                    <DataGrid Grid.Row="1" x:Name="dgLectures" 

                             AutoGenerateColumns="False"

                             SelectionMode="Single"

                             CanUserAddRows="False"

                             HeadersVisibility="Column"

                             Background="Transparent"

                             BorderThickness="0"

                             GridLinesVisibility="None"

                             RowHeight="60"

                             SelectionChanged="dgLectures_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="📚 Tên bài giảng" Binding="{Binding Name}" Width="*" FontSize="13"/>

                            <DataGridTextColumn Header="📅 Ngày tạo" Binding="{Binding DateCreated}" Width="120" FontSize="12"/>

                            <DataGridTextColumn Header="📊 Kích thước" Binding="{Binding Size}" Width="100" FontSize="12"/>

                            <DataGridTextColumn Header="🏷️ Tags" Binding="{Binding Tags}" Width="150" FontSize="11"/>

                            <DataGridTextColumn Header="📌 Trạng thái" Binding="{Binding Status}" Width="120" FontSize="12"/>

                        </DataGrid.Columns>

                    </DataGrid>



                    <!-- Pagination -->

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">

                        <Button Content="◀" Width="35" Height="35" Margin="0,0,5,0"

                               Background="#F1F2F6" BorderThickness="0" Cursor="Hand" Click="btnPrevPage_Click"/>

                        <TextBlock Text="Trang 1 / 5" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>

                        <Button Content="▶" Width="35" Height="35" Margin="5,0,0,0"

                               Background="#F1F2F6" BorderThickness="0" Cursor="Hand" Click="btnNextPage_Click"/>

                    </StackPanel>

                </Grid>

            </Border>



            <!-- RIGHT: Preview Panel -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"

                   BorderBrush="#E1E8ED" BorderThickness="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="panelPreview">

                        <!-- Preview will be populated when a lecture is selected -->

                        <TextBlock Text="Chi tiết bài giảng" FontSize="16" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,15"/>

                        

                        <!-- Thumbnail -->

                        <Border Background="#F1F2F6" CornerRadius="8" Height="180" Margin="0,0,0,15">

                            <TextBlock Text="📄" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>



                        <!-- Metadata -->

                        <StackPanel Margin="0,0,0,15">

                            <TextBlock Text="Tên bài giảng:" FontSize="11" Foreground="#57606F" Margin="0,0,0,3"/>

                            <TextBlock x:Name="txtPreviewName" Text="Chưa chọn bài giảng" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542" Margin="0,0,0,10"/>

                            

                            <TextBlock Text="Ngày tạo:" FontSize="11" Foreground="#57606F" Margin="0,0,0,3"/>

                            <TextBlock x:Name="txtPreviewDate" Text="--/--/----" FontSize="12" Foreground="#2F3542" Margin="0,0,0,10"/>

                            

                            <TextBlock Text="Kích thước:" FontSize="11" Foreground="#57606F" Margin="0,0,0,3"/>

                            <TextBlock x:Name="txtPreviewSize" Text="-- MB" FontSize="12" Foreground="#2F3542" Margin="0,0,0,10"/>

                            

                            <TextBlock Text="Số trang:" FontSize="11" Foreground="#57606F" Margin="0,0,0,3"/>

                            <TextBlock x:Name="txtPreviewPages" Text="--" FontSize="12" Foreground="#2F3542" Margin="0,0,0,10"/>

                            

                            <TextBlock Text="Tags:" FontSize="11" Foreground="#57606F" Margin="0,0,0,5"/>

                            <WrapPanel x:Name="panelTags" Margin="0,0,0,15">

                                <Border Background="#FEE2E2" CornerRadius="12" Padding="8,4" Margin="0,0,5,5">

                                    <TextBlock Text="Toán học" FontSize="10" Foreground="#E53E3E"/>

                                </Border>

                                <Border Background="#E0F2FE" CornerRadius="12" Padding="8,4" Margin="0,0,5,5">

                                    <TextBlock Text="Đại số" FontSize="10" Foreground="#0369A1"/>

                                </Border>

                            </WrapPanel>

                        </StackPanel>



                        <!-- Quick Actions -->

                        <TextBlock Text="Thao tác nhanh" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" Margin="0,0,0,10"/>

                        <Button Content="Mở bài giảng" Height="35" Background="#2E86DE" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8" Click="btnQuickOpen_Click"/>

                        <Button Content="Chỉnh sửa tên" Height="35" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8" Click="btnQuickRename_Click"/>

                        <Button Content="Xuất PDF" Height="35" Background="#9C27B0" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8" Click="btnQuickExport_Click"/>

                        <Button Content="Chia sẻ" Height="35" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnQuickShare_Click"/>



                        <!-- Cloud Sync Status -->

                        <Border Background="#E0F2FE" CornerRadius="8" Padding="12" Margin="0,20,0,0">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">

                                    <Path Fill="#0369A1" Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04Z" Width="16" Height="16" Margin="0,0,8,0"/>

                                    <TextBlock Text="Trạng thái đồng bộ" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>

                                </StackPanel>

                                <TextBlock x:Name="txtSyncStatus" Text="Đã đồng bộ (2 phút trước)" FontSize="10" Foreground="#047857"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>



    </Grid>

</Window>

