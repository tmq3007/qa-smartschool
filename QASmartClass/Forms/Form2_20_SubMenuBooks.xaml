<Window x:Class="QASmartTouch.Forms.Form2_20_SubMenuBooks"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:conv="clr-namespace:QASmartTouch.Converters"

        Title="Thư viện sách giáo khoa tương tác" 

        Width="1200" Height="750"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        WindowStartupLocation="CenterScreen"

        Topmost="True"

        ShowInTaskbar="False">

    <Window.Resources>
        <conv:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
    </Window.Resources>

    <Border Background="White" 

            CornerRadius="0" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <!-- Header -->

                <RowDefinition Height="Auto"/>

                <!-- Grade Tabs -->

                <RowDefinition Height="Auto"/>

                <!-- Subject Filter -->

                <RowDefinition Height="*"/>

                <!-- Book Grid -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Border Grid.Row="0" 

                   Background="#4A90E2" 

                   Padding="25,20">

                <Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Path Fill="White" 

                              Data="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"

                              Width="32" Height="32"

                              VerticalAlignment="Center"

                              Margin="0,0,15,0"/>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="THƯ VIỆN SÁCH GIÁO KHOA TƯƠNG TÁC" 

                                      FontSize="20" 

                                      FontWeight="Bold" 

                                      Foreground="White"

                                      TextAlignment="Center"/>

                            <TextBlock Text="Chọn sách để bắt đầu học tập" 

                                      FontSize="12" 

                                      Foreground="#E0E0E0"

                                      TextAlignment="Center"

                                      Margin="0,4,0,0"/>

                        </StackPanel>

                    </StackPanel>

                    <Button x:Name="btnClose" 

                           Width="36" Height="36"

                           HorizontalAlignment="Right"

                           Background="#5A9FE5"

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btnClose_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" 

                                       CornerRadius="8">

                                    <Path Fill="White" 

                                         Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                                         Width="18" Height="18"

                                         Stretch="Uniform"

                                         HorizontalAlignment="Center"

                                         VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>

            </Border>



            <!-- GRADE TABS -->

            <Border Grid.Row="1" 

                   Background="#F5F7FA" 

                   Padding="20,15">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <TextBlock Grid.Column="0" 

                              Text="Lọc theo:" 

                              FontSize="13" 

                              FontWeight="SemiBold"

                              Foreground="#2F3542"

                              VerticalAlignment="Center"

                              Margin="0,0,15,0"/>



                    <ScrollViewer Grid.Column="1" 

                                 HorizontalScrollBarVisibility="Auto" 

                                 VerticalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="gradeTabsPanel" 

                                   Orientation="Horizontal">

                            <!-- Grade tabs will be added here dynamically -->

                        </StackPanel>

                    </ScrollViewer>



                    <ComboBox x:Name="cmbSubject" 

                             Grid.Column="2"

                             Width="180"

                             Height="36"

                             FontSize="13"

                             Margin="15,0,0,0"

                             SelectionChanged="cmbSubject_SelectionChanged">

                        <ComboBoxItem Content="Tất cả môn học" IsSelected="True"/>

                    </ComboBox>

                </Grid>

            </Border>



            <!-- SEARCH BAR -->

            <Border Grid.Row="2" 

                   Background="White" 

                   Padding="20,15"

                   BorderBrush="#E1E8ED"

                   BorderThickness="0,1,0,1">

                <Border Background="#F8F9FA" 

                       CornerRadius="8">

                    <Grid Margin="12,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" 

                             Fill="#95A5A6" 

                             Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"

                             Width="18" Height="18"

                             Margin="0,0,8,0"

                             VerticalAlignment="Center"/>

                        <TextBox x:Name="txtSearch" 

                                Grid.Column="1"

                                Background="Transparent"

                                BorderThickness="0"

                                FontSize="13"

                                VerticalAlignment="Center"

                                TextChanged="txtSearch_TextChanged">

                            <TextBox.Style>

                                <Style TargetType="TextBox">

                                    <Style.Triggers>

                                        <Trigger Property="Text" Value="">

                                            <Setter Property="Background">

                                                <Setter.Value>

                                                    <VisualBrush Stretch="None" AlignmentX="Left">

                                                        <VisualBrush.Visual>

                                                            <TextBlock Text="Tìm kiếm sách theo tên, môn học..." 

                                                                      Foreground="#95A5A6" 

                                                                      FontSize="13"/>

                                                        </VisualBrush.Visual>

                                                    </VisualBrush>

                                                </Setter.Value>

                                            </Setter>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBox.Style>

                        </TextBox>

                    </Grid>

                </Border>

            </Border>



            <!-- BOOK GRID -->

            <ScrollViewer Grid.Row="3" 

                         VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="booksGrid" Margin="20">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <WrapPanel Orientation="Horizontal"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="White" 

                                   Width="180" 

                                   Margin="0,0,15,15"

                                   CornerRadius="8"

                                   BorderBrush="#E1E8ED"

                                   BorderThickness="1"

                                   Cursor="Hand"

                                   MouseLeftButtonDown="BookCard_Click"

                                   PreviewTouchUp="BookCard_TouchUp"

                                   PreviewStylusUp="BookCard_StylusUp"

                                   RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>

                                    <ScaleTransform x:Name="cardScale" ScaleX="1" ScaleY="1"/>

                                </Border.RenderTransform>

                                <Border.Effect>

                                    <DropShadowEffect x:Name="cardShadow"

                                                    Color="#CCCCCC" 

                                                    Direction="270" 

                                                    ShadowDepth="2" 

                                                    BlurRadius="8" 

                                                    Opacity="0.2"/>

                                </Border.Effect>

                                <Border.Triggers>

                                    <EventTrigger RoutedEvent="MouseEnter">

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="cardScale"

                                                               Storyboard.TargetProperty="ScaleX"

                                                               To="1.05"

                                                               Duration="0:0:0.2">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                                <DoubleAnimation Storyboard.TargetName="cardScale"

                                                               Storyboard.TargetProperty="ScaleY"

                                                               To="1.05"

                                                               Duration="0:0:0.2">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                                <DoubleAnimation Storyboard.TargetName="cardShadow"

                                                               Storyboard.TargetProperty="ShadowDepth"

                                                               To="8"

                                                               Duration="0:0:0.2"/>

                                                <DoubleAnimation Storyboard.TargetName="cardShadow"

                                                               Storyboard.TargetProperty="BlurRadius"

                                                               To="20"

                                                               Duration="0:0:0.2"/>

                                                <DoubleAnimation Storyboard.TargetName="cardShadow"

                                                               Storyboard.TargetProperty="Opacity"

                                                               To="0.4"

                                                               Duration="0:0:0.2"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="cardScale"

                                                               Storyboard.TargetProperty="ScaleX"

                                                               To="1"

                                                               Duration="0:0:0.2">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                                <DoubleAnimation Storyboard.TargetName="cardScale"

                                                               Storyboard.TargetProperty="ScaleY"

                                                               To="1"

                                                               Duration="0:0:0.2">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                                <DoubleAnimation Storyboard.TargetName="cardShadow"

                                                               Storyboard.TargetProperty="ShadowDepth"

                                                               To="2"

                                                               Duration="0:0:0.2"/>

                                                <DoubleAnimation Storyboard.TargetName="cardShadow"

                                                               Storyboard.TargetProperty="BlurRadius"

                                                               To="8"

                                                               Duration="0:0:0.2"/>

                                                <DoubleAnimation Storyboard.TargetName="cardShadow"

                                                               Storyboard.TargetProperty="Opacity"

                                                               To="0.2"

                                                               Duration="0:0:0.2"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                </Border.Triggers>

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="240"/>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>



                                    <!-- Book Cover -->

                                    <Grid Grid.Row="0">

                                        <!-- Background -->

                                        <Rectangle Fill="#F0F0F0"/>

                                        

                                        <!-- Book Cover Image -->

                                        <Image Stretch="UniformToFill" Source="{Binding CoverImagePath, Converter={StaticResource ImagePathToBitmapConverter}, ConverterParameter=200, IsAsync=True}" />

                                        

                                        <!-- Badge -->

                                        <Border Background="#4A90E2" 

                                               CornerRadius="4"

                                               HorizontalAlignment="Left"

                                               VerticalAlignment="Top"

                                               Margin="8">

                                            <TextBlock Text="{Binding BookType}" 

                                                      FontSize="10" 

                                                      FontWeight="Bold"

                                                      Foreground="White"

                                                      Margin="8,4"/>

                                        </Border>



                                        <!-- Grade Badge -->

                                        <Border Background="#FF6B6B" 

                                               Width="32" Height="32"

                                               CornerRadius="16"

                                               HorizontalAlignment="Right"

                                               VerticalAlignment="Top"

                                               Margin="8">

                                            <TextBlock Text="{Binding Grade}"

                                                      FontSize="12" 

                                                      FontWeight="Bold"

                                                      Foreground="White"

                                                      HorizontalAlignment="Center"

                                                      VerticalAlignment="Center"/>

                                        </Border>

                                    </Grid>



                                    <!-- Book Info -->

                                    <StackPanel Grid.Row="1" Margin="12,10">

                                        <TextBlock Text="{Binding Name}" 

                                                  FontSize="12" 

                                                  FontWeight="SemiBold"

                                                  Foreground="#2F3542"

                                                  TextWrapping="Wrap"

                                                  MaxHeight="36"

                                                  TextTrimming="CharacterEllipsis"/>

                                        <TextBlock FontSize="10" 

                                                  Foreground="#95A5A6"

                                                  Margin="0,4,0,0">

                                            <Run Text="{Binding Subject}"/>

                                            <Run Text=" • "/>

                                            <Run Text="Lớp "/>

                                            <Run Text="{Binding Grade}"/>

                                        </TextBlock>

                                        <TextBlock Text="{Binding Publisher}"

                                                  FontSize="10" 

                                                  Foreground="#95A5A6"

                                                  Margin="0,2,0,0"/>

                                    </StackPanel>



                                    <!-- Action Button -->

                                    <Button Grid.Row="2" 

                                           Content="Xem ngay" 

                                           Background="#4A90E2"

                                           Foreground="White"

                                           BorderThickness="0"

                                           Height="36"

                                           FontSize="12"

                                           FontWeight="SemiBold"

                                           Cursor="Hand"

                                           Margin="12,0,12,12"

                                           Click="btnViewBook_Click"

                                           Tag="{Binding}">

                                        <Button.Template>

                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}" 

                                                       CornerRadius="6">

                                                    <ContentPresenter HorizontalAlignment="Center" 

                                                                     VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Button.Template>

                                    </Button>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>

