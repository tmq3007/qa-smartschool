<Window x:Class="QASmartTouch.Forms.Form2_7_SubMenuZoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thu phóng" 
        Width="600" Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Border Background="#1E1E1E" 
            CornerRadius="12" 
            BorderBrush="#404040" 
            BorderThickness="1"
            Padding="15,10">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="270" 
                            ShadowDepth="5" 
                            BlurRadius="20" 
                            Opacity="0.6"/>
        </Border.Effect>

        <UniformGrid Rows="1" Columns="7">
            
            <!-- 1x Button -->
            <Button x:Name="btn1x" Width="70" Height="70" Background="#2E2E2E" Margin="5" Cursor="Hand" Click="btnZoomLevel_Click" Tag="1">
                <StackPanel>
                    <Path Fill="White" Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="1x" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <!-- 2x Button -->
            <Button x:Name="btn2x" Width="70" Height="70" Background="#2E2E2E" Margin="5" Cursor="Hand" Click="btnZoomLevel_Click" Tag="2">
                <StackPanel>
                    <Path Fill="White" Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="2x" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <!-- 3x Button -->
            <Button x:Name="btn3x" Width="70" Height="70" Background="#2E2E2E" Margin="5" Cursor="Hand" Click="btnZoomLevel_Click" Tag="3">
                <StackPanel>
                    <Path Fill="White" Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="3x" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <!-- 4x Button -->
            <Button x:Name="btn4x" Width="70" Height="70" Background="#2E2E2E" Margin="5" Cursor="Hand" Click="btnZoomLevel_Click" Tag="4">
                <StackPanel>
                    <Path Fill="White" Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="4x" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <!-- Zoom In (+) -->
            <Button x:Name="btnZoomIn" Width="70" Height="70" Background="#2E2E2E" Margin="5" Cursor="Hand" Click="btnZoomIn_Click">
                <Border CornerRadius="50" Width="70" Height="70">
                    <TextBlock Text="+" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>

            <!-- Zoom Out (-) -->
            <Button x:Name="btnZoomOut" Width="70" Height="70" Background="#2E2E2E" Margin="5" Cursor="Hand" Click="btnZoomOut_Click">
                <Border CornerRadius="50" Width="70" Height="70">
                    <TextBlock Text="-" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>

            <!-- Zoom Area -->
            <Button x:Name="btnZoomArea" Width="70" Height="70" Background="#2E2E2E" Margin="5" Cursor="Hand" Click="btnZoomArea_Click" ToolTip="Thu phóng vùng (Kéo chọn vùng cần phóng to)">
                <Canvas Width="40" Height="40">
                    <Rectangle Width="18" Height="18" Canvas.Left="6" Canvas.Top="6" Stroke="#2196F3" StrokeThickness="2" StrokeDashArray="2,2"/>
                    <Ellipse Width="20" Height="20" Canvas.Left="18" Canvas.Top="14" Stroke="White" StrokeThickness="2"/>
                    <Line X1="32" Y1="28" X2="38" Y2="34" Stroke="White" StrokeThickness="2"/>
                </Canvas>
            </Button>

        </UniformGrid>
    </Border>
</Window>
