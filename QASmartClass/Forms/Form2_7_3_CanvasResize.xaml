<Window x:Class="QASmartTouch.Forms.Form2_7_3_CanvasResize"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Mở rộng kích thước bảng" 

        Width="520" Height="500"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False"

        FontFamily="Segoe UI, Inter, Arial, sans-serif">



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid Margin="20">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Grid Grid.Row="0" Margin="0,0,0,20">

                <StackPanel Orientation="Horizontal">

                    <Path Fill="#673AB7" 

                          Data="M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91Z"

                          Width="24" Height="24"

                          VerticalAlignment="Center"

                          Margin="0,0,10,0"/>

                    <TextBlock Text="Mở rộng kích thước bảng" 

                              FontSize="18" 

                              FontWeight="Bold" 

                              Foreground="#2F3542"

                              VerticalAlignment="Center"/>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Width="32" Height="32"

                       HorizontalAlignment="Right"

                       Background="#FEE2E2"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnClose_Click">

                    <Path Fill="#EE5A6F" 

                         Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                         Width="16" Height="16"/>

                </Button>

            </Grid>



            <!-- CONTENT -->

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- Current Size -->

                    <Border Background="#F8F9FA"

                           CornerRadius="8"

                           Padding="15"

                           Margin="0,0,0,20">

                        <StackPanel>

                            <TextBlock Text="Kích thước hiện tại" 

                                      FontSize="12" 

                                      FontWeight="SemiBold" 

                                      Foreground="#57606F"

                                      Margin="0,0,0,8"/>

                            <TextBlock x:Name="txtCurrentSize"

                                      Text="1920 × 1080 px"

                                      FontSize="16"

                                      FontWeight="Bold"

                                      Foreground="#2F3542"/>

                        </StackPanel>

                    </Border>



                    <!-- Presets -->

                    <TextBlock Text="Kích thước có sẵn" 

                              FontSize="13" 

                              FontWeight="SemiBold" 

                              Foreground="#57606F"

                              Margin="0,0,0,10"/>

                    

                    <UniformGrid Columns="2" Rows="4" Margin="0,0,0,20">

                        <!-- A4 Portrait -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="2480,3508">

                            <StackPanel>

                                <TextBlock Text="A4 (Dọc)" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="2480 × 3508 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>



                        <!-- A4 Landscape -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="3508,2480">

                            <StackPanel>

                                <TextBlock Text="A4 (Ngang)" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="3508 × 2480 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>



                        <!-- A3 Portrait -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="3508,4961">

                            <StackPanel>

                                <TextBlock Text="A3 (Dọc)" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="3508 × 4961 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>



                        <!-- A3 Landscape -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="4961,3508">

                            <StackPanel>

                                <TextBlock Text="A3 (Ngang)" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="4961 × 3508 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>



                        <!-- 16:9 HD -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="1920,1080">

                            <StackPanel>

                                <TextBlock Text="🖥️ HD (16:9)" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="1920 × 1080 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>



                        <!-- 16:9 Full HD -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="2560,1440">

                            <StackPanel>

                                <TextBlock Text="🖥️ 2K (16:9)" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="2560 × 1440 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>



                        <!-- 4:3 -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="1600,1200">

                            <StackPanel>

                                <TextBlock Text="4:3" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="1600 × 1200 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>



                        <!-- Square -->

                        <Button Height="60" Margin="4"

                               Background="White"

                               BorderBrush="#DFE4EA"

                               BorderThickness="1"

                               Cursor="Hand"

                               Click="btnPreset_Click"

                               Tag="2000,2000">

                            <StackPanel>

                                <TextBlock Text="Vuông (1:1)" 

                                          FontSize="12"

                                          FontWeight="SemiBold"

                                          Foreground="#2F3542"

                                          Margin="0,0,0,4"/>

                                <TextBlock Text="2000 × 2000 px" 

                                          FontSize="10"

                                          Foreground="#747D8C"/>

                            </StackPanel>

                        </Button>

                    </UniformGrid>



                    <!-- Custom Size -->

                    <TextBlock Text="Kích thước tùy chỉnh" 

                              FontSize="13" 

                              FontWeight="SemiBold" 

                              Foreground="#57606F"

                              Margin="0,0,0,10"/>

                    

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Chiều rộng (px)" 

                                      FontSize="11"

                                      Foreground="#747D8C"

                                      Margin="0,0,0,4"/>

                            <TextBox x:Name="txtWidth"

                                    Height="40"

                                    FontSize="14"

                                    Padding="10"

                                    Text="1920"

                                    BorderBrush="#DFE4EA"

                                    BorderThickness="1"/>

                        </StackPanel>



                        <TextBlock Grid.Column="1"

                                  Text="×"

                                  FontSize="20"

                                  FontWeight="Bold"

                                  Foreground="#747D8C"

                                  VerticalAlignment="Center"

                                  Margin="10,20,10,0"/>



                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Chiều cao (px)" 

                                      FontSize="11"

                                      Foreground="#747D8C"

                                      Margin="0,0,0,4"/>

                            <TextBox x:Name="txtHeight"

                                    Height="40"

                                    FontSize="14"

                                    Padding="10"

                                    Text="1080"

                                    BorderBrush="#DFE4EA"

                                    BorderThickness="1"/>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </ScrollViewer>



            <!-- ACTIONS -->

            <StackPanel Grid.Row="2" 

                       Orientation="Horizontal" 

                       HorizontalAlignment="Right"

                       Margin="0,20,0,0">

                <Button Content="Hủy" 

                       Width="100" Height="40"

                       Margin="0,0,10,0"

                       Background="#F1F2F6"

                       Foreground="#2F3542"

                       BorderThickness="0"

                       FontSize="13"

                       FontWeight="SemiBold"

                       Cursor="Hand"

                       Click="btnClose_Click"/>

                

                <Button Content="Áp dụng" 

                       Width="100" Height="40"

                       Background="#673AB7"

                       Foreground="White"

                       BorderThickness="0"

                       FontSize="13"

                       FontWeight="SemiBold"

                       Cursor="Hand"

                       Click="btnApply_Click"/>

            </StackPanel>



        </Grid>

    </Border>

</Window>

