<Window x:Class="QASmartTouch.Forms.AdminPasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận Quyền Quản trị" 
        Width="400" Height="220"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Hệ thống đang khóa cài đặt. Vui lòng nhập mật khẩu quản trị để tiếp tục:" 
                   FontSize="14" 
                   Foreground="#2F3542" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,15"/>

        <PasswordBox x:Name="pbPassword" 
                     Grid.Row="1" 
                     Height="40" 
                     FontSize="14" 
                     VerticalContentAlignment="Center" 
                     Margin="0,0,0,20"
                     KeyDown="pbPassword_KeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" 
                    Content="Hủy" 
                    Width="100" Height="35" 
                    Background="#F1F2F6" Foreground="#2F3542" 
                    BorderThickness="0" Cursor="Hand" 
                    Margin="0,0,10,0" 
                    Click="btnCancel_Click"/>
            <Button x:Name="btnConfirm" 
                    Content="Xác nhận" 
                    Width="110" Height="35" 
                    Background="#4CAF50" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" FontWeight="Bold" 
                    Click="btnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
