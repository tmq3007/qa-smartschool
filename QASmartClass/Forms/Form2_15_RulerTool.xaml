<Window x:Class="QASmartTouch.Forms.Form2_15_RulerTool"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Thước Kẻ 30cm" 

        Width="1650" Height="1650"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        Topmost="True"

        ResizeMode="NoResize"

        UseLayoutRounding="True"

        SnapsToDevicePixels="True"

        ClipToBounds="False">



    <!-- Button Style Resource -->

    <Window.Resources>

        <Style x:Key="RulerButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#667EEA"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                                CornerRadius="4" Padding="0">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#5568D3"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>



    <Grid ClipToBounds="False">

        <!-- ✨ RulerLayer: Centered container for rotation -->

        <Grid x:Name="RulerLayerRoot" 

              HorizontalAlignment="Center"

              VerticalAlignment="Center"

              RenderTransformOrigin="0.5,0.5"

              ClipToBounds="False"

              UseLayoutRounding="True" 

              SnapsToDevicePixels="True">



            <Grid.RenderTransform>

                <TransformGroup>

                    <ScaleTransform x:Name="RulerScale" ScaleX="1" ScaleY="1"/>

                    <RotateTransform x:Name="RulerRotate" Angle="0"/>

                    <TranslateTransform x:Name="RulerTranslate" X="0" Y="0"/>

                </TransformGroup>

            </Grid.RenderTransform>

            

            <!-- ✨ BORDERED CONTAINER - All rotates together -->

            <Border x:Name="RulerMainBorder"

                    Background="Transparent"

                    BorderBrush="#667EEA"

                    BorderThickness="2"

                    CornerRadius="6"

                    Padding="0">

                <Border.Effect>

                    <DropShadowEffect Color="Black" Opacity="0.15" 

                                      ShadowDepth="3" BlurRadius="10"/>

                </Border.Effect>

                

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/> <!-- Control Panel -->

                        <RowDefinition Height="*"/>    <!-- Ruler -->

                    </Grid.RowDefinitions>

                    

                    <!-- ✨ CONTROL PANEL (Top) -->

                    <Border Grid.Row="0" 

                            Background="#667EEA"

                            CornerRadius="4,4,0,0"

                            Height="42">

                        <StackPanel Orientation="Horizontal" Margin="5,0">

                            

                            <!-- Angle Display -->

                            <Border Background="#5568D3" 

                                    CornerRadius="4" 

                                    Padding="10,0" 

                                    Margin="0,5,8,5"

                                    MinWidth="60">

                                <TextBlock x:Name="txtAngle" 

                                          Text="0°" 

                                          FontSize="14" 

                                          FontWeight="Bold"

                                          Foreground="White"

                                          HorizontalAlignment="Center"

                                          VerticalAlignment="Center"/>

                            </Border>

                            

                            <!-- Rotation Buttons -->

                            <Button Content="◀45°" 

                                    Width="55" Height="32" 

                                    Margin="2,5"

                                    Style="{StaticResource RulerButtonStyle}"

                                    Click="btnRotateLeft_Click"

                                    ToolTip="Xoay trái 45°"/>

                            <Button Content="▶45°" 

                                    Width="55" Height="32" 

                                    Margin="2,5"

                                    Style="{StaticResource RulerButtonStyle}"

                                    Click="btnRotateRight_Click"

                                    ToolTip="Xoay phải 45°"/>

                            <Button Content="↻90°" 

                                    Width="55" Height="32" 

                                    Margin="2,5"

                                    Style="{StaticResource RulerButtonStyle}"

                                    Click="btnRotate90_Click"

                                    ToolTip="Xoay 90°"/>

                            <Button Content="0°" 

                                    Width="45" Height="32" 

                                    Margin="2,5"

                                    Style="{StaticResource RulerButtonStyle}"

                                    Click="btnResetAngle_Click"

                                    ToolTip="Reset về 0°"/>

                            

                            <!-- Precision rotation ±1° -->

                            <Button Content="◀1°" 

                                    Width="45" Height="32" 

                                    Margin="2,5"

                                    Style="{StaticResource RulerButtonStyle}"

                                    Click="btnRotateMinus1_Click"

                                    ToolTip="Xoay trái 1°"/>

                            <Button Content="▶1°" 

                                    Width="45" Height="32" 

                                    Margin="2,5"

                                    Style="{StaticResource RulerButtonStyle}"

                                    Click="btnRotatePlus1_Click"

                                    ToolTip="Xoay phải 1°"/>

                            

                            <!-- Separator -->

                            <Rectangle Width="2" 

                                      Fill="#5568D3" 

                                      Margin="8,8,8,8"/>

                            

                            <!-- ✨ Opacity Control (Độ trong suốt) -->

                            <TextBlock Text="👁" 

                                      FontSize="14" 

                                      Foreground="White"

                                      VerticalAlignment="Center"

                                      Margin="5,0,3,0"

                                      ToolTip="Độ trong suốt"/>

                            <Slider x:Name="opacitySlider"

                                    Minimum="0.3" Maximum="1.0"

                                    Value="0.5"

                                    Width="80"

                                    VerticalAlignment="Center"

                                    Margin="0,0,5,0"

                                    ValueChanged="opacitySlider_ValueChanged"

                                    ToolTip="Điều chỉnh độ trong suốt của thước"/>

                            <TextBlock x:Name="txtOpacity"

                                      Text="50%"

                                      FontSize="10"

                                      FontWeight="Bold"

                                      Foreground="White"

                                      VerticalAlignment="Center"

                                      Width="35"

                                      Margin="0,0,5,0"/>

                            

                            <!-- Separator -->

                            <Rectangle Width="2" 

                                      Fill="#5568D3" 

                                      Margin="8,8,8,8"/>

                            

                            <!-- Existing controls -->

                            <Button x:Name="btnMove" 
                                    Content="✥" 
                                    Tag="DragHandle"
                                    Width="32" Height="32"
                                    FontSize="14"
                                    Focusable="False"
                                    Stylus.IsPressAndHoldEnabled="False"
                                    Style="{StaticResource RulerButtonStyle}"
                                    ToolTip="Di chuyển" 
                                    Margin="2,5"
                                    Cursor="SizeAll"
                                    PreviewMouseDown="btnMove_PreviewMouseDown"
                                    PreviewMouseMove="btnMove_PreviewMouseMove"
                                    PreviewMouseUp="btnMove_PreviewMouseUp"
                                    PreviewTouchDown="btnMove_PreviewTouchDown"
                                    TouchMove="btnMove_TouchMove"
                                    TouchUp="btnMove_TouchUp"/>

                            <Button x:Name="btnClose" 

                                    Content="✕" 

                                    Width="32" Height="32"

                                    FontSize="14"

                                    Style="{StaticResource RulerButtonStyle}"

                                    ToolTip="Đóng" 

                                    Margin="2,5"

                                    Click="btnClose_Click"/>

                        </StackPanel>

                    </Border>

                    

                    <!-- ✨ RULER BODY (Bottom) -->

                    <Grid Grid.Row="1" Margin="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/> <!-- Left Handle -->

                            <ColumnDefinition Width="*"/>    <!-- Ruler -->

                            <ColumnDefinition Width="Auto"/> <!-- Right Handle -->

                        </Grid.ColumnDefinitions>

                        

                        <!-- Left Handle -->

                        <Border x:Name="LeftHandle" 

                                Grid.Column="0"

                                Width="16" Height="50"

                                Background="#667EEA"

                                CornerRadius="0"

                                Cursor="SizeWE"

                                MouseDown="LeftHandle_MouseDown"

                                MouseMove="LeftHandle_MouseMove"

                                MouseUp="LeftHandle_MouseUp"

                                ToolTip="Kéo để thay đổi độ dài">

                            <Border.Effect>

                                <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="1" BlurRadius="3"/>

                            </Border.Effect>

                            <TextBlock Text="◀" 

                                      FontSize="10" 

                                      Foreground="White" 

                                      HorizontalAlignment="Center" 

                                      VerticalAlignment="Center"

                                      IsHitTestVisible="False"/>

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="Background" Value="#5568D3"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                        </Border>

                        

                        <!-- Ruler Canvas Container -->

                        <Grid Grid.Column="1">

                            <Rectangle x:Name="RulerBody" 

                                      Fill="#F0FFFFFF"

                                      Stroke="#E0E0E0" 

                                      StrokeThickness="0.5"

                                      RadiusX="0" RadiusY="0"

                                      IsHitTestVisible="False">

                                <Rectangle.Effect>

                                    <DropShadowEffect Color="Black" Opacity="0.05" ShadowDepth="1" BlurRadius="3"/>

                                </Rectangle.Effect>

                            </Rectangle>

                            

                            <Canvas x:Name="RulerCanvas"

                                    Width="960" Height="60"

                                    Background="Transparent"

                                    Cursor="Cross"

                                    MouseDown="RulerCanvas_MouseDown"

                                    MouseMove="RulerCanvas_MouseMove"

                                    MouseUp="RulerCanvas_MouseUp"

                                    MouseLeave="RulerCanvas_MouseLeave"

                                    MouseWheel="RulerCanvas_MouseWheel"

                                    MouseRightButtonDown="RulerCanvas_MouseRightButtonDown"

                                    MouseRightButtonUp="RulerCanvas_MouseRightButtonUp"/>

                        </Grid>

                        

                        <!-- Right Handle -->

                        <Border x:Name="RightHandle" 

                                Grid.Column="2"

                                Width="16" Height="50"

                                Background="#667EEA"

                                CornerRadius="0"

                                Cursor="SizeWE"

                                MouseDown="RightHandle_MouseDown"

                                MouseMove="RightHandle_MouseMove"

                                MouseUp="RightHandle_MouseUp"

                                ToolTip="Kéo để thay đổi độ dài">

                            <Border.Effect>

                                <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="1" BlurRadius="3"/>

                            </Border.Effect>

                            <TextBlock Text="▶" 

                                      FontSize="10" 

                                      Foreground="White" 

                                      HorizontalAlignment="Center" 

                                      VerticalAlignment="Center"

                                      IsHitTestVisible="False"/>

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="Background" Value="#5568D3"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        

        <!-- ✨ Preview Overlay for drawing preview lines -->

        <Canvas x:Name="PreviewOverlay"

                IsHitTestVisible="False"

                Background="Transparent"

                ClipToBounds="False"/>

    </Grid>

</Window>

