<Window x:Class="QASmartTouch.Forms.Form2_1_SubMenuPen"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Công cụ Bút viết" 

        Width="350" Height="700"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Style tùy chỉnh cho các nút chọn màu để không bị mất màu khi click/hover -->
        <Style x:Key="ColorPaletteButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Thay đổi viền thay vì đè lên màu nền gốc -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#2E86DE"/>
                                <Setter TargetName="buttonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#2E86DE"/>
                                <Setter TargetName="buttonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid Margin="15">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <!-- Header -->

                <RowDefinition Height="Auto"/>

                <!-- Brush Types -->

                <RowDefinition Height="Auto"/>

                <!-- Pen Size -->

                <RowDefinition Height="Auto"/>

                <!-- Colors -->

                <RowDefinition Height="Auto"/>

                <!-- Preview -->

                <RowDefinition Height="Auto"/>

                <!-- Footer Buttons -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Grid Grid.Row="0" Margin="0,0,0,15">

                <StackPanel Orientation="Horizontal">

                    <Path Fill="#2E86DE" 

                          Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"

                          Width="18" Height="18"

                          Stretch="Uniform"

                          VerticalAlignment="Center"

                          Margin="0,0,8,0"/>

                    <TextBlock Text="1. Công cụ Bút viết" 

                              FontSize="16" 

                              FontWeight="Bold" 

                              Foreground="#2F3542"

                              VerticalAlignment="Center"/>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Style="{StaticResource CloseButton}"

                       Click="btnClose_Click"/>

            </Grid>



            <!-- BRUSH TYPES -->

            <StackPanel Grid.Row="1" Margin="0,0,0,15">

                <TextBlock Text="🖊️ Chọn loại bút" 

                          FontSize="13" 

                          FontWeight="SemiBold" 

                          Foreground="#57606F"

                          Margin="0,0,0,10"/>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- 1. Bút viết bảng (Normal) -->

                    <Button x:Name="btnBrushNormal"

                            Grid.Column="0" Grid.Row="0"

                            Height="72" Margin="3"

                            Background="#FFF4E6" BorderThickness="0" Cursor="Hand"

                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"

                            Tag="Normal">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">

                                    <StackPanel VerticalAlignment="Center">

                                        <Viewbox Width="26" Height="26" Margin="0,0,0,4">

                                            <Canvas Width="24" Height="24">

                                                <Path Fill="#FFA500" Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>

                                            </Canvas>

                                        </Viewbox>

                                        <TextBlock Text="Bút viết bảng" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>



                    <!-- 2. Bút nhận diện hình (Shape) -->

                    <Button x:Name="btnBrushShape"

                            Grid.Column="1" Grid.Row="0"

                            Height="72" Margin="3"

                            Background="#F3E5F5" BorderThickness="0" Cursor="Hand"

                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"

                            Tag="Shape">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">

                                    <StackPanel VerticalAlignment="Center">

                                        <Viewbox Width="26" Height="26" Margin="0,0,0,4">

                                            <Canvas Width="24" Height="24">

                                                <Path Fill="#9C27B0" Data="M11,13.5V21.5H3V13.5H11M12,2L17.5,11H6.5L12,2M17.5,13A4.5,4.5 0 1,1 17.49,13Z"/>

                                            </Canvas>

                                        </Viewbox>

                                        <TextBlock Text="Bút nhận diện hình" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>



                    <!-- 3. Bút dạ quang (Highlighter) -->

                    <Button x:Name="btnBrushHighlighter"

                            Grid.Column="0" Grid.Row="1"

                            Height="72" Margin="3"

                            Background="#FFFDE7" BorderThickness="0" Cursor="Hand"

                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"

                            Tag="Highlighter">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">

                                    <StackPanel VerticalAlignment="Center">

                                        <Viewbox Width="26" Height="26" Margin="0,0,0,4">

                                            <Canvas Width="24" Height="24">

                                                <Path Fill="#FBC02D" Data="M18.5,1.15C17.97,1.15 17.46,1.34 17.07,1.73L11.26,7.55L16.91,13.2L22.73,7.39C23.5,6.61 23.5,5.35 22.73,4.56L19.89,1.73C19.5,1.34 19,1.15 18.5,1.15M10.3,8.5L4.34,14.46C3.56,15.24 3.56,16.5 4.34,17.29L7.08,20.03C7.86,20.81 9.13,20.81 9.91,20.03L15.86,14.07L10.3,8.5M2,21.5H11V23H2V21.5Z"/>

                                            </Canvas>

                                        </Viewbox>

                                        <TextBlock Text="Bút dạ quang" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>



                    <!-- 4. Bút Laser chỉ điểm (Laser) -->

                    <Button x:Name="btnBrushLaser"

                            Grid.Column="1" Grid.Row="1"

                            Height="72" Margin="3"

                            Background="#FFEBEE" BorderThickness="0" Cursor="Hand"

                            Click="btnBrushType_Click" MouseDoubleClick="btnBrushType_DoubleClick"

                            Tag="Laser">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">

                                    <StackPanel VerticalAlignment="Center">

                                        <Viewbox Width="26" Height="26" Margin="0,0,0,4">

                                            <Canvas Width="24" Height="24">

                                                <Path Fill="#E53935" Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10.02 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4.02,23.1 3.63,22.71L1.29,20.37C0.9,19.98 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 13.98,6.9 14.37,7.29Z"/>

                                            </Canvas>

                                        </Viewbox>

                                        <TextBlock Text="Bút laser (tự xóa)" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542" TextAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>


            </StackPanel>



            <!-- PEN SIZE -->

            <StackPanel Grid.Row="2" Margin="0,0,0,15">

                <TextBlock Text="Kích thước nét bút" 

                          FontSize="12" 

                          FontWeight="SemiBold" 

                          Foreground="#57606F"

                          Margin="0,0,0,10"/>

                <Slider x:Name="sliderPenSize" 

                       Minimum="1" Maximum="16" 

                       Value="5"

                       TickFrequency="1"

                       IsSnapToTickEnabled="True"

                       ValueChanged="sliderPenSize_ValueChanged"

                       Margin="0,0,0,8"/>

                <UniformGrid x:Name="panelSizeIndicators" 

                            Rows="1" Columns="16"

                            Height="20">

                    <!-- Size indicators will be generated in code-behind -->

                </UniformGrid>

            </StackPanel>



            <!-- PEN COLOR -->

            <StackPanel Grid.Row="3" Margin="0,0,0,15">

                <TextBlock Text="Màu bút" 

                          FontSize="12" 

                          FontWeight="SemiBold" 

                          Foreground="#57606F"

                          Margin="0,0,0,10"/>

                <UniformGrid Rows="4" Columns="4" 

                            Height="120">

                    <!-- Row 1 -->

                    <Button Background="#FFB7B2" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#FFB7B2" Margin="3" Cursor="Hand"/>

                    <Button Background="#FFDAC1" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#FFDAC1" Margin="3" Cursor="Hand"/>

                    <Button Background="#E2F0CB" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#E2F0CB" Margin="3" Cursor="Hand"/>

                    <Button Background="#B5EAD7" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#B5EAD7" Margin="3" Cursor="Hand"/>

                    <!-- Row 2 -->

                    <Button Background="#C7CEEA" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#C7CEEA" Margin="3" Cursor="Hand"/>

                    <Button Background="#F4CCCC" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#F4CCCC" Margin="3" Cursor="Hand"/>

                    <Button Background="#FCE5CD" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#FCE5CD" Margin="3" Cursor="Hand"/>

                    <Button Background="#D9EAD3" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#D9EAD3" Margin="3" Cursor="Hand"/>

                    <!-- Row 3 -->

                    <Button Background="#D0E0E3" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#D0E0E3" Margin="3" Cursor="Hand"/>

                    <Button Background="#CFE2F3" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#CFE2F3" Margin="3" Cursor="Hand"/>

                    <Button Background="#D9D2E9" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#D9D2E9" Margin="3" Cursor="Hand"/>

                    <Button Background="#F4D8F3" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#F4D8F3" Margin="3" Cursor="Hand"/>

                    <!-- Row 4 -->

                    <Button Background="#EAD1DC" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#EAD1DC" Margin="3" Cursor="Hand"/>

                    <Button Background="#FFF2CC" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#FFF2CC" Margin="3" Cursor="Hand"/>

                    <Button Background="#D0F0C0" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#D0F0C0" Margin="3" Cursor="Hand"/>

                    <Button Background="#AEEEEE" Style="{StaticResource ColorPaletteButtonStyle}" BorderBrush="#DFE4EA" BorderThickness="1" Click="btnColor_Click" Tag="#AEEEEE" Margin="3" Cursor="Hand"/>


                </UniformGrid>



                <!-- Custom Color -->

                <Grid Margin="0,10,0,0">

                    <Border Background="#6C7EAA" 

                           Height="35"

                           CornerRadius="8"

                           Margin="0,0,125,0">

                        <TextBlock x:Name="txtCustomColorHex" 

                                  Text="#6C7EAA" 

                                  FontSize="12"

                                  FontWeight="SemiBold"

                                  Foreground="White"

                                  VerticalAlignment="Center"

                                  HorizontalAlignment="Center"/>

                    </Border>

                    <Button Content="Chọn màu khác" 

                           MinWidth="115"

                           Height="35"

                           HorizontalAlignment="Right"

                           Background="#F1F2F6"

                           Foreground="#2F3542"

                           BorderThickness="0"

                           FontSize="11"

                           FontWeight="SemiBold"

                           Cursor="Hand"

                           Click="btnColorPicker_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" 

                                       CornerRadius="8"

                                       Padding="8">

                                    <TextBlock Text="{TemplateBinding Content}" 

                                              Foreground="{TemplateBinding Foreground}"

                                              FontSize="{TemplateBinding FontSize}"

                                              FontWeight="{TemplateBinding FontWeight}"

                                              HorizontalAlignment="Center"

                                              VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>

            </StackPanel>



            <!-- PREVIEW -->

            <StackPanel Grid.Row="4" Margin="0,0,0,15">

                <TextBlock Text="👁️ Xem trước nét vẽ" 

                          FontSize="13" 

                          FontWeight="SemiBold" 

                          Foreground="#57606F"

                          Margin="0,0,0,10"/>

                <Border Background="#F8F9FA" 

                       Height="50"

                       CornerRadius="8"

                       BorderBrush="#E1E8ED"

                       BorderThickness="1">

                    <Rectangle x:Name="rectStrokePreview" 

                              Fill="#000000"

                              Height="4"

                              VerticalAlignment="Center"

                              HorizontalAlignment="Stretch"

                              Margin="20,0"/>

                </Border>

            </StackPanel>



            <!-- FOOTER BUTTONS -->

            <Grid Grid.Row="5">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>



                <Button x:Name="btnReset" 

                       Grid.Column="0"

                       Height="40"

                       Margin="0,0,5,0"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnReset_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   CornerRadius="10">

                                <TextBlock Text="Đặt lại" 

                                          FontSize="13"

                                          FontWeight="SemiBold"

                                          Foreground="#57606F"

                                          HorizontalAlignment="Center"

                                          VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <Button x:Name="btnApply" 

                       Grid.Column="1"

                       Height="40"

                       Margin="5,0,0,0"

                       Background="#2E86DE"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnApply_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   CornerRadius="10">

                                <TextBlock Text="Áp dụng" 

                                          FontSize="13"

                                          FontWeight="SemiBold"

                                          Foreground="White"

                                          HorizontalAlignment="Center"

                                          VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>
