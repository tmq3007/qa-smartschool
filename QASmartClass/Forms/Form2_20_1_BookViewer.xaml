<Window x:Class="QASmartTouch.Forms.Form2_20_1_BookViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sách Giáo Khoa Tương Tác" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="White">
    
    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A90E2"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E1E8ED"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2F3542"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#95A5A6"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8FAFC"/>
        
        <!-- Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="6"
                               Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="6"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title (Left) -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryColor}"
                            Width="36"
                            Height="36"
                            CornerRadius="8"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="txtBookIcon"
                                  Text="📚" 
                                  FontSize="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="txtBookTitle"
                                  Text="Sách GK Tương Tác"
                                  FontSize="20"
                                  FontWeight="ExtraBold"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock x:Name="txtBookSubtitle"
                                  Text=""
                                  FontSize="14.5"
                                  FontWeight="Medium"
                                  Foreground="{StaticResource TextSecondaryColor}"/>
                    </StackPanel>
                </StackPanel>

                <!-- All Controls on Right Side -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center">
                    
                    <!-- Page Navigation Control -->
                    <TextBlock Text="Trang:" 
                               FontSize="15" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryColor}"
                               Margin="0,0,10,0"/>
                    
                    <!-- Integrated Slider Control -->
                    <Border BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            Padding="6,4"
                            Width="400">
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Previous Button -->
                            <Button x:Name="btnPrevPage"
                                    Grid.Column="0"
                                    Content="◀"
                                    Width="32" 
                                    Height="32"
                                    Style="{StaticResource IconButton}"
                                    Click="PrevPage_Click"
                                    ToolTip="Trang trước (←)"
                                    FontSize="14"
                                    Margin="0,0,6,0"/>
                            
                            <!-- Slider -->
                            <Slider x:Name="pageSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="1"
                                    TickPlacement="None"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"
                                    Height="28"
                                    ValueChanged="PageSlider_ValueChanged"
                                    Thumb.DragStarted="Slider_DragStarted"
                                    Thumb.DragCompleted="Slider_DragCompleted"
                                    ToolTip="Kéo để chuyển trang"/>
                            
                            <!-- Next Button -->
                            <Button x:Name="btnNextPage"
                                    Grid.Column="2"
                                    Content="▶"
                                    Width="32" 
                                    Height="32"
                                    Style="{StaticResource IconButton}"
                                    Click="NextPage_Click"
                                    ToolTip="Trang sau (→)"
                                    FontSize="14"
                                    Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Page Info Display -->
                    <TextBlock x:Name="txtPageInfo"
                               Text="1 / 100" 
                               FontSize="16.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Margin="10,0,16,0"
                               MinWidth="80"/>
                    
                    <!-- Action Buttons -->
                    <Button x:Name="btnRefresh"
                            Style="{StaticResource IconButton}"
                            Click="BtnRefresh_Click"
                            ToolTip="Làm mới trang (F5)"
                            Margin="0,0,6,0">
                        <TextBlock Text="🔄" FontSize="16"/>
                    </Button>
                    <Button x:Name="btnHome"
                            Style="{StaticResource IconButton}"
                            Click="BtnHome_Click"
                            ToolTip="Về trang chủ"
                            Margin="0,0,6,0">
                        <TextBlock Text="🏠" FontSize="16"/>
                    </Button>
                    <Border Width="1" 
                            Height="20" 
                            Background="{StaticResource BorderColor}"
                            Margin="0,0,6,0"/>
                    <Button x:Name="btnClose"
                            Style="{StaticResource IconButton}"
                            Click="BtnClose_Click"
                            ToolTip="Đóng (ESC)"
                            Margin="0,0,0,0">
                        <TextBlock Text="✖" FontSize="16" Foreground="#EE5A6F"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Content -->
        <Border Grid.Row="1" 
                Background="White"
                Margin="0">
            <Grid>
                <!-- Loading Indicator -->
                <Border x:Name="loadingPanel"
                        Background="#F8FAFC"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" 
                               VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryColor}"
                                Width="80"
                                Height="80"
                                CornerRadius="40"
                                Margin="0,0,0,20">
                            <TextBlock Text="📖" 
                                      FontSize="40"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Đang tải sách giáo khoa..."
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryColor}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Vui lòng chờ trong giây lát"
                                  FontSize="15"
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                        <ProgressBar IsIndeterminate="True"
                                    Width="200"
                                    Height="4"
                                    Margin="0,20,0,0"
                                    Foreground="{StaticResource PrimaryColor}"
                                    Background="{StaticResource BorderColor}"
                                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- WebView2 Control -->
                <wv2:WebView2 x:Name="webView"
                              NavigationStarting="WebView_NavigationStarting"
                              NavigationCompleted="WebView_NavigationCompleted"
                              CoreWebView2InitializationCompleted="WebView_CoreWebView2InitializationCompleted"/>
            </Grid>
        </Border>
    </Grid>
</Window>
