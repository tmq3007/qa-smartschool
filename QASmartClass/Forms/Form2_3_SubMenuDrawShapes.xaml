<Window x:Class="QASmartTouch.Forms.Form2_3_SubMenuDrawShapes"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="3. Chèn hình" 

        Width="650" Height="450"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False">



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="200"/>

                <!-- Categories Panel -->

                <ColumnDefinition Width="*"/>

                <!-- Content Panel -->

            </Grid.ColumnDefinitions>



            <!-- LEFT PANEL: CATEGORIES -->

            <Border Grid.Column="0" 

                   Background="#F8F9FA"

                   CornerRadius="15,0,0,15"

                   BorderBrush="#E1E8ED"

                   BorderThickness="0,0,1,0">

                <Grid Margin="15">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <!-- Categories Header -->

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">

                        <TextBlock Text="3. Chèn hình" 

                                  FontSize="16" 

                                  FontWeight="Bold" 

                                  Foreground="#2F3542"

                                  Margin="0,0,0,5"/>

                        <TextBlock Text="Insert Shapes" 

                                  FontSize="11" 

                                  Foreground="#747D8C"/>

                    </StackPanel>



                    <!-- Categories List -->

                    <StackPanel Grid.Row="1">

                        

                        <!-- Category 1: 2D Geometry - SELECTED -->

                        <Button x:Name="btnCat2DGeometry" 

                               Height="70"

                               Margin="0,0,0,8"

                               Background="#2E86DE"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnCategory_Click"

                               Tag="2DGeometry">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" 

                                           CornerRadius="10"

                                           Padding="10">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>



                                            <Border Grid.Column="0" 

                                                   Width="35" Height="35"

                                                   Background="White"

                                                   CornerRadius="8"

                                                   VerticalAlignment="Center"

                                                   Margin="0,0,10,0"

                                                   Opacity="0.9">

                                                <Viewbox Width="20" Height="20">

                                                    <Canvas Width="24" Height="24">

                                                        <Path Fill="#2E86DE" 

                                                             Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"/>

                                                    </Canvas>

                                                </Viewbox>

                                            </Border>



                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock Text="Hình học 2D" 

                                                          FontSize="13"

                                                          FontWeight="SemiBold"

                                                          Foreground="White"/>

                                                <TextBlock Text="2D Geometry" 

                                                          FontSize="10"

                                                          Foreground="White"

                                                          Opacity="0.8"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>



                        <!-- Category 2: 3D Geometry -->

                        <Button x:Name="btnCat3DGeometry" 

                               Height="70"

                               Margin="0,0,0,8"

                               Background="#F1F2F6"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnCategory_Click"

                               Tag="3DGeometry">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" 

                                           CornerRadius="10"

                                           Padding="10">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>



                                            <Border Grid.Column="0" 

                                                   Width="35" Height="35"

                                                   Background="#E3F2FD"

                                                   CornerRadius="8"

                                                   VerticalAlignment="Center"

                                                   Margin="0,0,10,0">

                                                <Viewbox Width="20" Height="20">

                                                    <Canvas Width="24" Height="24">

                                                        <Path Fill="#2196F3" 

                                                             Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z"/>

                                                    </Canvas>

                                                </Viewbox>

                                            </Border>



                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock Text="Hình học 3D" 

                                                          FontSize="13"

                                                          FontWeight="SemiBold"

                                                          Foreground="#2F3542"/>

                                                <TextBlock Text="3D Geometry" 

                                                          FontSize="10"

                                                          Foreground="#747D8C"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>



                        <!-- Category 3: Charts & Table -->

                        <Button x:Name="btnCatChartsTable" 

                               Height="70"

                               Margin="0,0,0,8"

                               Background="#F1F2F6"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnCategory_Click"

                               Tag="ChartsTable">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" 

                                           CornerRadius="10"

                                           Padding="10">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>



                                            <Border Grid.Column="0" 

                                                   Width="35" Height="35"

                                                   Background="#FFF3E0"

                                                   CornerRadius="8"

                                                   VerticalAlignment="Center"

                                                   Margin="0,0,10,0">

                                                <Viewbox Width="20" Height="20">

                                                    <Canvas Width="24" Height="24">

                                                        <Path Fill="#FF9800" 

                                                             Data="M3,3H21V21H3V3M5,5V19H19V5H5M7,7H17V9H7V7M7,11H17V13H7V11M7,15H17V17H7V15Z"/>

                                                    </Canvas>

                                                </Viewbox>

                                            </Border>



                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock Text="Biểu đồ &amp; Bảng" 

                                                          FontSize="13"

                                                          FontWeight="SemiBold"

                                                          Foreground="#2F3542"/>

                                                <TextBlock Text="Charts &amp; Table" 

                                                          FontSize="10"

                                                          Foreground="#747D8C"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>



                        <!-- Category 4: Flashcard & Notes -->

                        <Button x:Name="btnCatFlashcard" 

                               Height="70"

                               Background="#F1F2F6"

                               BorderThickness="0"

                               Cursor="Hand"

                               Click="btnCategory_Click"

                               Tag="Flashcard">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}" 

                                           CornerRadius="10"

                                           Padding="10">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>



                                            <Border Grid.Column="0" 

                                                   Width="35" Height="35"

                                                   Background="#FFF9C4"

                                                   CornerRadius="8"

                                                   VerticalAlignment="Center"

                                                   Margin="0,0,10,0">

                                                <Viewbox Width="20" Height="20">

                                                    <Canvas Width="24" Height="24">

                                                        <Path Fill="#FDD835" 

                                                             Data="M3,3H21V21H3V3M5,5V19H19V5H5M7,7H11V11H7V7M13,7H17V10H13V7M17,12V16H13V12H17M11,13V17H7V13H11Z"/>

                                                    </Canvas>

                                                </Viewbox>

                                            </Border>



                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock Text="Flashcard" 

                                                          FontSize="13"

                                                          FontWeight="SemiBold"

                                                          Foreground="#2F3542"/>

                                                <TextBlock Text="Flashcard &amp; Notes" 

                                                          FontSize="10"

                                                          Foreground="#747D8C"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>



                    </StackPanel>

                </Grid>

            </Border>



            <!-- RIGHT PANEL: CONTENT -->

            <Grid Grid.Column="1" Margin="15">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <!-- Header -->

                    <RowDefinition Height="*"/>

                    <!-- Shapes Gallery -->

                </Grid.RowDefinitions>



                <!-- Content Header -->

                <Grid Grid.Row="0" Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock x:Name="txtCategoryTitle" 

                                  Text="Hình học 2D" 

                                  FontSize="18" 

                                  FontWeight="Bold" 

                                  Foreground="#2F3542"

                                  Margin="0,0,0,5"/>

                        <TextBlock Text="Kéo và thả hình vào bảng để sử dụng" 

                                  FontSize="12" 

                                  Foreground="#747D8C"/>

                    </StackPanel>

                    

                    <Button x:Name="btnClose" 

                           Style="{StaticResource CloseButton}"

                           Click="btnClose_Click"/>

                </Grid>



                <!-- Shapes Gallery -->

                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <!-- Sub-category tabs -->

                        <RowDefinition Height="*"/>

                        <!-- Content -->

                    </Grid.RowDefinitions>

                    

                    <!-- SUB-CATEGORY TABS (for 2D Geometry) -->

                    <StackPanel x:Name="panelSubTabs" 

                               Grid.Row="0" 

                               Orientation="Horizontal" 

                               Margin="0,0,0,15"

                               Visibility="Visible">

                        

                        <Button x:Name="btnSubLines" 

                               Content="Đường kẻ" 

                               Height="35"

                               Padding="15,0"

                               Margin="0,0,5,0"

                               Background="#2E86DE"

                               Foreground="White"

                               BorderThickness="0"

                               Cursor="Hand"

                               FontSize="12"

                               FontWeight="SemiBold"

                               Click="btnSubCategory_Click"

                               Tag="Lines">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}" 

                                                       CornerRadius="8"

                                                       Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter HorizontalAlignment="Center" 

                                                                    VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </Button.Style>

                        </Button>

                        

                        <Button x:Name="btnSubRectangles" 

                               Content="Chữ nhật" 

                               Height="35"

                               Padding="15,0"

                               Margin="0,0,5,0"

                               Background="#F1F2F6"

                               Foreground="#2F3542"

                               BorderThickness="0"

                               Cursor="Hand"

                               FontSize="12"

                               FontWeight="SemiBold"

                               Click="btnSubCategory_Click"

                               Tag="Rectangles">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}" 

                                                       CornerRadius="8"

                                                       Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter HorizontalAlignment="Center" 

                                                                    VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </Button.Style>

                        </Button>

                        

                        <Button x:Name="btnSubBasicShapes" 

                               Content="Hình cơ bản" 

                               Height="35"

                               Padding="15,0"

                               Margin="0,0,5,0"

                               Background="#F1F2F6"

                               Foreground="#2F3542"

                               BorderThickness="0"

                               Cursor="Hand"

                               FontSize="12"

                               FontWeight="SemiBold"

                               Click="btnSubCategory_Click"

                               Tag="BasicShapes">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}" 

                                                       CornerRadius="8"

                                                       Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter HorizontalAlignment="Center" 

                                                                    VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </Button.Style>

                        </Button>

                        

                    </StackPanel>

                    

                    <!-- CONTENT SCROLL VIEWER -->

                    <ScrollViewer Grid.Row="1" 

                                 VerticalScrollBarVisibility="Auto"

                                 HorizontalScrollBarVisibility="Disabled">

                        <Grid>

                            <!-- 2D SHAPES PANEL -->

                            <StackPanel x:Name="panel2DShapes" Visibility="Visible">

                            

                                <!-- LINES PANEL (5 shapes) -->

                                <StackPanel x:Name="panelLines" Visibility="Visible">

                                    <UniformGrid Columns="5" Margin="0,0,0,20">

                                        

                                        <!-- 1. Straight Line -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="StraightLine" ToolTip="Đường thẳng">

                                            <Line X1="10" Y1="35" X2="60" Y2="35" Stroke="#2F3542" StrokeThickness="3"/>

                                        </Button>

                                        

                                        <!-- 2. Arrow Line -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="ArrowLine" ToolTip="Đường mũi tên">

                                            <Canvas Width="70" Height="70">

                                                <Line X1="10" Y1="35" X2="50" Y2="35" Stroke="#2F3542" StrokeThickness="3"/>

                                                <Polygon Points="50,30 60,35 50,40" Fill="#2F3542"/>

                                            </Canvas>

                                        </Button>

                                        

                                        <!-- 3. Double Arrow Line -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="DoubleArrowLine" ToolTip="Đường mũi tên hai đầu">

                                            <Canvas Width="70" Height="70">

                                                <Line X1="15" Y1="35" X2="55" Y2="35" Stroke="#2F3542" StrokeThickness="3"/>

                                                <Polygon Points="15,30 5,35 15,40" Fill="#2F3542"/>

                                                <Polygon Points="55,30 65,35 55,40" Fill="#2F3542"/>

                                            </Canvas>

                                        </Button>

                                        

                                        <!-- 4. Elbow Connector -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="ElbowConnector" ToolTip="Đường nối góc vuông">

                                            <Path Stroke="#2F3542" StrokeThickness="3" Fill="None"

                                                 Data="M10,15 L35,15 L35,55 L60,55"/>

                                        </Button>

                                        

                                        <!-- 5. Curved Connector -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="CurvedConnector" ToolTip="Đường nối cong">

                                            <Path Stroke="#2F3542" StrokeThickness="3" Fill="None"

                                                 Data="M10,30 Q35,10 60,30"/>

                                        </Button>

                                        

                                    </UniformGrid>

                                </StackPanel>

                                

                                <!-- RECTANGLES PANEL (5 shapes) -->

                                <StackPanel x:Name="panelRectangles" Visibility="Collapsed">

                                    <UniformGrid Columns="5" Margin="0,0,0,20">

                                        

                                        <!-- 1. Rectangle -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Rectangle" ToolTip="Hình chữ nhật">

                                            <Rectangle Width="50" Height="35" Fill="#9C27B0"/>

                                        </Button>

                                        

                                        <!-- 2. Rounded Rectangle -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="RoundedRectangle" ToolTip="Hình chữ nhật góc bo tròn">

                                            <Rectangle Width="50" Height="35" Fill="#4CAF50" RadiusX="8" RadiusY="8"/>

                                        </Button>

                                        

                                        <!-- 3. Snip Single Corner Rectangle -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="SnipSingleCornerRectangle" ToolTip="Hình chữ nhật cắt 1 góc">

                                            <Path Fill="#FF9800" Data="M10,10 L55,10 L55,45 L10,45 Z M50,10 L50,15 L55,10 Z"/>

                                        </Button>

                                        

                                        <!-- 4. Snip Diagonal Corner Rectangle -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="SnipDiagonalCornerRectangle" ToolTip="Hình chữ nhật cắt 2 góc chéo">

                                            <Path Fill="#2E86DE" Data="M10,10 L55,10 L55,40 L15,45 L10,45 Z M50,10 L50,15 L55,10 Z M10,45 L15,40 L15,45 Z"/>

                                        </Button>

                                        

                                        <!-- 5. Round Single Corner Rectangle -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="RoundSingleCornerRectangle" ToolTip="Hình chữ nhật bo 1 góc">

                                            <Path Fill="#00BCD4" Data="M10,10 L50,10 Q60,10 60,20 L60,45 L10,45 Z"/>

                                        </Button>

                                        

                                    </UniformGrid>

                                </StackPanel>

                                

                                <!-- BASIC SHAPES PANEL (10 shapes) -->

                                <StackPanel x:Name="panelBasicShapes" Visibility="Collapsed">

                                    <UniformGrid Columns="5" Margin="0,0,0,20">

                                        

                                        <!-- 1. Circle -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Circle" ToolTip="Hình tròn">

                                            <Ellipse Width="45" Height="45" Fill="#2E86DE"/>

                                        </Button>

                                        

                                        <!-- 2. Triangle -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Triangle" ToolTip="Tam giác">

                                            <Polygon Points="35,10 60,50 10,50" Fill="#FF9800"/>

                                        </Button>

                                        

                                        <!-- 3. Pentagon -->

                                        <Button x:Name="btnPentagon" Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Pentagon" ToolTip="Ngũ giác">

                                            <Polygon Points="35,10 60,25 50,50 20,50 10,25" Fill="#E91E63"/>

                                        </Button>

                                        

                                        <!-- 4. Hexagon -->

                                        <Button x:Name="btnHexagon" Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Hexagon" ToolTip="Lục giác">

                                            <Polygon Points="25,10 45,10 60,30 45,50 25,50 10,30" Fill="#00BCD4"/>

                                        </Button>

                                        

                                        <!-- 5. Star -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Star" ToolTip="Ngôi sao">

                                            <Path Fill="#FDD835" 

                                                 Data="M35,10 L40,28 L60,28 L44,40 L50,58 L35,46 L20,58 L26,40 L10,28 L30,28 Z"/>

                                        </Button>

                                        

                                        <!-- 6. Heart -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Heart" ToolTip="Trái tim">

                                            <Path Fill="#EE5A6F" 

                                                 Data="M35,55 L20,40 Q10,30 10,20 Q10,10 20,10 Q30,10 35,20 Q40,10 50,10 Q60,10 60,20 Q60,30 50,40 Z"/>

                                        </Button>

                                        

                                        <!-- 7. Diamond -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Diamond" ToolTip="Hình thoi">

                                            <Polygon Points="35,10 60,30 35,50 10,30" Fill="#9C27B0"/>

                                        </Button>

                                        

                                        <!-- 8. Parallelogram -->

                                        <Button x:Name="btnParallelogram" Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Parallelogram" ToolTip="Hình bình hành">

                                            <Polygon Points="20,15 60,15 50,45 10,45" Fill="#3F51B5"/>

                                        </Button>

                                        

                                        <!-- 9. Cross -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Cross" ToolTip="Hình chữ thập">

                                            <Path Fill="#F44336" 

                                                 Data="M25,10 L45,10 L45,25 L60,25 L60,45 L45,45 L45,60 L25,60 L25,45 L10,45 L10,25 L25,25 Z"/>

                                        </Button>

                                        

                                        <!-- 10. Cloud -->

                                        <Button Width="70" Height="70" Margin="5" Background="#F1F2F6" BorderThickness="0" Cursor="Hand"

                                               Click="btnShape_Click" Tag="Cloud" ToolTip="Đám mây">

                                            <Path Fill="#64B5F6" 

                                                 Data="M50,25 Q60,15 55,25 Q65,25 60,35 Q65,40 55,40 L20,40 Q10,40 15,30 Q10,20 20,20 Q20,15 30,15 Q35,10 45,15 Q50,15 50,25 Z"/>

                                        </Button>

                                        

                                    </UniformGrid>

                                </StackPanel>

                            

                            </StackPanel>

                    

                    <!-- 3D SHAPES PANEL -->

                    <StackPanel x:Name="panel3DShapes" Visibility="Collapsed">

                        

                        <!-- 3D Basic Shapes -->

                        <TextBlock Text="Hình khối cơ bản" 

                                  FontSize="13" 

                                  FontWeight="SemiBold" 

                                  Foreground="#57606F"

                                  Margin="0,0,0,10"/>

                        

                        <UniformGrid Columns="4" 

                                    Margin="0,0,0,20">

                            <!-- Cube -->

                            <Button Width="90" Height="90" 

                                   Margin="5"

                                   Background="#F1F2F6"

                                   BorderThickness="0"

                                   Cursor="Hand"

                                   Click="btnShape_Click"

                                   Tag="Cube"

                                   ToolTip="Hình lập phương">

                                <StackPanel>

                                    <Viewbox Width="50" Height="50">

                                        <Canvas Width="100" Height="100">

                                            <!-- Front face -->

                                            <Polygon Points="30,40 70,40 70,80 30,80" Fill="#4CAF50" Opacity="0.7"/>

                                            <!-- Top face -->

                                            <Polygon Points="30,40 50,25 90,25 70,40" Fill="#81C784" Opacity="0.8"/>

                                            <!-- Right face -->

                                            <Polygon Points="70,40 90,25 90,65 70,80" Fill="#66BB6A" Opacity="0.9"/>

                                            <!-- Edges -->

                                            <Polyline Points="30,40 70,40 70,80 30,80 30,40" Stroke="Black" StrokeThickness="2" Fill="None"/>

                                            <Polyline Points="30,40 50,25 90,25 70,40" Stroke="Black" StrokeThickness="2" Fill="None"/>

