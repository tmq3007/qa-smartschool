<Window x:Class="QASmartScreen.Forms.Form2_15_RulerTool"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thước Kẻ 30cm" 
        Width="1050" Height="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ClipToBounds="False"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">

    <!-- Button Style Resource -->
    <Window.Resources>
        <Style x:Key="RulerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#667EEA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5568D3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="False">
        <!-- ✨ RulerLayer: Layer xoay -->
        <Grid x:Name="RulerLayerRoot" 
              Margin="16,45,2,45"
              RenderTransformOrigin="0.5,0.5"
              ClipToBounds="False"
              UseLayoutRounding="True" SnapsToDevicePixels="True">

            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RulerScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="RulerRotate" Angle="0"/>
                    <TranslateTransform x:Name="RulerTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            
            <!-- ✨ 3-Column Layout: Left Handle | Ruler Body | Right Handle -->
            <Grid x:Name="RulerContainer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left Handle -->
                    <ColumnDefinition Width="*"/>    <!-- Ruler Body -->
                    <ColumnDefinition Width="Auto"/> <!-- Right Handle -->
                </Grid.ColumnDefinitions>

                <!-- ✨ LEFT HANDLE -->
                <Border x:Name="LeftHandle" 
                        Grid.Column="0"
                        Width="16" Height="50"
                        Background="#667EEA"
                        CornerRadius="4,0,0,4"
                        Cursor="SizeWE"
                        MouseDown="LeftHandle_MouseDown"
                        MouseMove="LeftHandle_MouseMove"
                        MouseUp="LeftHandle_MouseUp"
                        ToolTip="Kéo để thay đổi độ dài">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="1" BlurRadius="3"/>
                    </Border.Effect>
                    <TextBlock Text="◀" 
                              FontSize="10" 
                              Foreground="White" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"/>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5568D3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- ✨ RulerVisual: Hình thước thuần túy -->
                <Grid x:Name="RulerVisual"
                      Grid.Column="1"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True">
                    <!-- Nền thước (không viền) -->
                    <Rectangle x:Name="RulerBody" Fill="#FFFFFF" 
                               Stroke="#E0E0E0" StrokeThickness="0.5"
                               RadiusX="0" RadiusY="0"
                               IsHitTestVisible="False">
                        <Rectangle.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" ShadowDepth="2" BlurRadius="6"/>
                        </Rectangle.Effect>
                    </Rectangle>

                    <!-- Canvas vẽ vạch -->
                    <Canvas x:Name="RulerCanvas"
                            Width="960" Height="50"
                            Background="Transparent"
                            Cursor="Cross"
                            MouseDown="RulerCanvas_MouseDown"
                            MouseMove="RulerCanvas_MouseMove"
                            MouseUp="RulerCanvas_MouseUp"
                            MouseLeave="RulerCanvas_MouseLeave">

                        <!-- Label CM -->
                        <Border Canvas.Left="8" Canvas.Top="4"
                                Background="White" 
                                BorderBrush="#999" BorderThickness="0.5"
                                CornerRadius="3" Padding="4,2">
                            <TextBlock Text="CM" FontSize="7" FontWeight="Bold" Foreground="#666"/>
                        </Border>
                    </Canvas>
                </Grid>
                
                <!-- ✨ RIGHT HANDLE -->
                <Border x:Name="RightHandle" 
                        Grid.Column="2"
                        Width="16" Height="50"
                        Background="#667EEA"
                        CornerRadius="0,4,4,0"
                        Cursor="SizeWE"
                        MouseDown="RightHandle_MouseDown"
                        MouseMove="RightHandle_MouseMove"
                        MouseUp="RightHandle_MouseUp"
                        ToolTip="Kéo để thay đổi độ dài">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="1" BlurRadius="3"/>
                    </Border.Effect>
                    <TextBlock Text="▶" 
                              FontSize="10" 
                              Foreground="White" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"/>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5568D3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Grid>

        <!-- ✨ Buttons Layer OUTSIDE transform - luôn hiển thị -->
        <StackPanel x:Name="ButtonPanel"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Margin="0,-2,0,0"
                    Orientation="Horizontal" 
                    Background="#F0FFFFFF"
                    Width="120"
                    Height="42">
            <StackPanel.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="1" BlurRadius="4"/>
            </StackPanel.Effect>

            <Button x:Name="btnMove" Width="32" Height="32" 
                    Content="✥" FontSize="14" FontWeight="Bold"
                    ToolTip="Di chuyển" Margin="5,5,2,5"
                    Cursor="SizeAll"
                    PreviewMouseDown="btnMove_PreviewMouseDown"
                    PreviewMouseMove="btnMove_PreviewMouseMove"
                    PreviewMouseUp="btnMove_PreviewMouseUp"
                    Style="{StaticResource RulerButtonStyle}"/>

            <Button x:Name="btnFlip" Width="32" Height="32" 
                    Content="⇅" FontSize="14" FontWeight="Bold"
                    ToolTip="Đảo vạch" Margin="2,5"
                    Click="btnFlip_Click"
                    Style="{StaticResource RulerButtonStyle}"/>

            <Button x:Name="btnClose" Width="32" Height="32" 
                    Content="✕" FontSize="13" FontWeight="Bold"
                    Background="#FF6B6B" Foreground="White"
                    ToolTip="Đóng" Margin="2,5,5,5"
                    Click="btnClose_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E85454"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- ✨ Preview Line Overlay - Nằm TRÊN TẤT CẢ -->
        <Canvas x:Name="PreviewOverlay" 
                IsHitTestVisible="False" 
                ClipToBounds="False"
                Panel.ZIndex="99999">
            <!-- Preview lines will be added here dynamically -->
        </Canvas>
    </Grid>
</Window>
