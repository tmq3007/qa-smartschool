<Window x:Class="QASmartTouch.Forms.Form2_12_AreaChartEditor"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Ứng dụng vẽ Biểu đồ Miền" 

        Width="1400" Height="750"

        WindowStartupLocation="CenterScreen"

        Background="#F5F7FA"

        ResizeMode="CanResize">



    <Window.Resources>

        <!-- Gradient Background -->

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">

            <GradientStop Color="#667eea" Offset="0"/>

            <GradientStop Color="#764ba2" Offset="1"/>

        </LinearGradientBrush>



        <!-- Button Style -->

        <Style x:Key="ModernButton" TargetType="Button">

            <Setter Property="Background" Value="#667eea"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Padding" Value="12,8"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                                CornerRadius="6" 

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#764ba2"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20">

            <StackPanel>

                <TextBlock Text="Ứng dụng vẽ Biểu đồ Miền" 

                          FontSize="24" FontWeight="Bold" 

                          Foreground="White" Margin="0,0,0,5"/>

                <TextBlock Text="Công cụ tạo biểu đồ miền (Area Chart) chuyên nghiệp - Trực quan và đẹp mắt" 

                          FontSize="13" Foreground="White" Opacity="0.95"/>

            </StackPanel>

        </Border>



        <!-- Main Content -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="400"/>

            </Grid.ColumnDefinitions>



            <!-- Canvas Area -->

            <Border Grid.Column="0" Background="#F5F7FA" Padding="30">

                <Border Background="White" 

                        BorderBrush="#DDD" BorderThickness="2" 

                        CornerRadius="10" Padding="20">

                    <Border.Effect>

                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="15" ShadowDepth="3"/>

                    </Border.Effect>

                    <Canvas x:Name="ChartCanvas" Background="White" SizeChanged="ChartCanvas_SizeChanged"/>

                </Border>

            </Border>



            <!-- Control Panel -->

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" 

                         Background="#F0F2F5" Padding="20">

                <StackPanel>

                    

                    <!-- Panel 1: Nhập dữ liệu -->

                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"

                            BorderBrush="#667eea" BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Nhập dữ liệu biểu đồ" 

                                      FontWeight="Bold" FontSize="14" 

                                      Foreground="#2C3E50" Margin="0,0,0,15"/>

                            

                            <TextBlock Text="Tiêu đề biểu đồ:" FontSize="12" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <TextBox x:Name="TxtChartTitle" Text="Doanh thu theo tháng năm 2024" 

                                    Padding="10" FontSize="13" Margin="0,0,0,15"/>



                            <TextBlock Text="Nhãn trục X (phân cách bằng dấu phẩy):" FontSize="12" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <TextBox x:Name="TxtLabels" Text="T1, T2, T3, T4, T5, T6" 

                                    Padding="10" FontSize="13" Margin="0,0,0,15"/>



                            <TextBlock Text="Danh sách chuỗi dữ liệu" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,10"/>

                            <StackPanel x:Name="SeriesPanel"/>



                            <Button Content="➕ Thêm chuỗi dữ liệu" Style="{StaticResource ModernButton}"

                                   Background="#28A745" Click="BtnAddSeries_Click" Margin="0,10,0,0"/>



                            <TextBlock Text="Mẫu dữ liệu có sẵn" FontWeight="SemiBold" FontSize="12" Margin="0,15,0,10"/>

                            <UniformGrid Columns="2" Rows="2">

                                <Button Content="💰 Doanh thu" Margin="2" Padding="8" Click="LoadPreset" Tag="revenue"/>

                                <Button Content="🚗 Lưu lượng" Margin="2" Padding="8" Click="LoadPreset" Tag="traffic"/>

                                <Button Content="⚡ Năng lượng" Margin="2" Padding="8" Click="LoadPreset" Tag="energy"/>

                                <Button Content="📦 Bán hàng" Margin="2" Padding="8" Click="LoadPreset" Tag="sales"/>

                            </UniformGrid>

                        </StackPanel>

                    </Border>



                    <!-- Panel 2: Kiểu biểu đồ -->

                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"

                            BorderBrush="#667eea" BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Kiểu biểu đồ" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,15"/>

                            

                            <TextBlock Text="Kiểu đường:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <ComboBox x:Name="CmbLineStyle" SelectedIndex="0" Margin="0,0,0,15" SelectionChanged="OnChartPropertyChanged">

                                <ComboBoxItem Content="Đường thẳng"/>

                                <ComboBoxItem Content="Đường cong mượt"/>

                                <ComboBoxItem Content="Đường bậc thang"/>

                            </ComboBox>



                            <TextBlock Text="Kiểu vùng:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <ComboBox x:Name="CmbAreaType" SelectedIndex="0" Margin="0,0,0,15" SelectionChanged="OnChartPropertyChanged">

                                <ComboBoxItem Content="Thông thường"/>

                                <ComboBoxItem Content="Xếp chồng (Stacked)"/>

                                <ComboBoxItem Content="Phần trăm 100%"/>

                            </ComboBox>



                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Độ dày đường viền:" FontSize="12" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtLineWidth" Grid.Column="1" Text="2px" FontWeight="Bold" Foreground="#667eea"/>

                            </Grid>

                            <Slider x:Name="SliderLineWidth" Minimum="0" Maximum="6" Value="2" 

                                   TickFrequency="1" IsSnapToTickEnabled="True" 

                                   ValueChanged="OnSliderChanged" Margin="0,0,0,15"/>



                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Kích thước điểm:" FontSize="12" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtPointSize" Grid.Column="1" Text="4px" FontWeight="Bold" Foreground="#667eea"/>

                            </Grid>

                            <Slider x:Name="SliderPointSize" Minimum="0" Maximum="10" Value="4" 

                                   TickFrequency="1" IsSnapToTickEnabled="True" 

                                   ValueChanged="OnSliderChanged" Margin="0,0,0,0"/>

                        </StackPanel>

                    </Border>



                    <!-- Panel 3: Tùy chỉnh hiển thị -->

                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"

                            BorderBrush="#667eea" BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="⚙️ Tùy chỉnh hiển thị" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,15"/>

                            

                            <CheckBox x:Name="ChkShowGrid" Content="Hiển thị lưới" IsChecked="True" Margin="0,5" Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowAxes" Content="Hiển thị trục tọa độ" IsChecked="True" Margin="0,5" Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowPoints" Content="Hiển thị điểm dữ liệu" IsChecked="True" Margin="0,5" Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowValues" Content="Hiển thị giá trị" IsChecked="False" Margin="0,5" Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowLegend" Content="Hiển thị chú thích" IsChecked="True" Margin="0,5" Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkUseGradient" Content="Dùng gradient" IsChecked="True" Margin="0,5" Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                        </StackPanel>

                    </Border>



                    <!-- Panel 4: Chức năng -->

                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,0"

                            BorderBrush="#667eea" BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="🛠️ Chức năng" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,15"/>

                            <Button Content="Cập nhật biểu đồ" 
                                    Style="{StaticResource ModernButton}"
                                    Background="#0288D1" Foreground="White"
                                    Click="BtnUpdate_Click" Margin="0,0,0,10"/>
                            
                            <Button Content="Xác nhận hoàn thành" 
                                    Style="{StaticResource ModernButton}"
                                    Click="BtnConfirm_Click" Margin="0,0,0,10"
                                    Background="#1976D2" Foreground="White"/>
                            
                            <Button Content="Lưu hình ảnh PNG" 
                                    Style="{StaticResource ModernButton}"
                                    Background="#00838F" Foreground="White" Click="BtnSaveImage_Click" Margin="0,0,0,10"/>
                            
                            <Button Content="Reset về mặc định" 
                                    Style="{StaticResource ModernButton}"
                                    Background="#E65100" Foreground="White" Click="BtnReset_Click" Margin="0,0,0,10"/>

                            <Button Content="Thoát" 
                                    Style="{StaticResource ModernButton}"
                                    Background="#546E7A" Foreground="White" Click="Exit_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Panel 5: Hướng dẫn sư phạm -->
                    <Border Background="#FFF9C4" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0">
                        <Expander Header="💡 Hướng dẫn tạo nhanh biểu đồ" IsExpanded="False" Background="Transparent" BorderThickness="0">
                            <TextBlock Padding="10" FontSize="11" TextWrapping="Wrap" Foreground="#5D4037" FontFamily="Segoe UI">
                                Bước 1: Nhập tiêu đề và chọn kiểu đường thẳng hoặc cong.&#x0a;
                                Bước 2: Click 'Cấu hình series dữ liệu' hoặc tải presets dữ liệu.&#x0a;
                                Bước 3: Click 'Cập nhật biểu đồ' để xem thử thay đổi.&#x0a;
                                Bước 4: Nhấn nút màu xanh dương 'Xác nhận hoàn thành' để chèn vào bảng vẽ.
                            </TextBlock>
                        </Expander>
                    </Border>



                </StackPanel>
            </ScrollViewer>

        </Grid>

    </Grid>

</Window>

