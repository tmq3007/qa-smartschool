<Window x:Class="QASmartTouch.Forms.Form2_21_PhETSimulationBrowser"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

        Title="PhET Interactive Simulations" 

        Width="1200" Height="800"

        WindowState="Maximized"

        WindowStyle="None"

        AllowsTransparency="False"

        Background="White"

        Topmost="True"

        ShowInTaskbar="False">

    

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="60"/>  <!-- Header -->

            <RowDefinition Height="*"/>   <!-- WebView -->

            <RowDefinition Height="70"/>  <!-- Footer Controls -->

        </Grid.RowDefinitions>

        

        <!-- Header -->

        <Border Grid.Row="0" Background="#00BCD4" Padding="20,0">

            <Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Path Fill="White" 

                          Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"

                          Width="24" Height="24" Margin="0,0,10,0"/>

                    <TextBlock Text="PhET Interactive Simulations" 

                              FontSize="18" FontWeight="Bold" 

                              Foreground="White"

                              VerticalAlignment="Center"/>

                    <TextBlock Text="(University of Colorado Boulder)" 

                              FontSize="11" 

                              Foreground="#E0F7FA"

                              VerticalAlignment="Center"

                              Margin="10,0,0,0"/>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Width="40" Height="40"

                       HorizontalAlignment="Right"

                       Background="#E91E63" 

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnClose_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" 

                                   CornerRadius="8">

                                <Path Fill="White" 

                                     Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                                     Width="16" Height="16"

                                     Stretch="Uniform"

                                     HorizontalAlignment="Center"

                                     VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>

        

        <!-- WebView2 -->

        <Border Grid.Row="1" Background="White">

            <Grid>

                <!-- Loading Indicator -->

                <StackPanel x:Name="loadingPanel" 

                           VerticalAlignment="Center" 

                           HorizontalAlignment="Center"

                           Visibility="Visible">

                    <TextBlock Text="🔄" FontSize="48" 

                              HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Đang tải mô phỏng PhET..." 

                              FontSize="14" Foreground="#666"

                              HorizontalAlignment="Center"/>

                </StackPanel>

                

                <!-- WebView2 Control -->

                <wv2:WebView2 x:Name="webView" 

                             Visibility="Collapsed"/>

            </Grid>

        </Border>

        

        <!-- Footer Controls -->

        <Border Grid.Row="2" Background="#F5F5F5" 

               BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"

               Padding="20,0">

            <Grid>

                <StackPanel Orientation="Horizontal" 

                           HorizontalAlignment="Left"

                           VerticalAlignment="Center">

                    <Button x:Name="btnBack" 

                           Width="120" Height="45" Margin="0,0,10,0"

                           Background="White" BorderBrush="#BDBDBD" BorderThickness="1"

                           Cursor="Hand"

                           Click="btnBack_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="#424242" 

                                 Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"

                                 Width="16" Height="16" Margin="0,0,5,0"/>

                            <TextBlock Text="Quay lại" FontSize="12" Foreground="#424242"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnRefresh" 

                           Width="120" Height="45"

                           Background="White" BorderBrush="#BDBDBD" BorderThickness="1"

                           Cursor="Hand"

                           Click="btnRefresh_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="#424242" 

                                 Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"

                                 Width="16" Height="16" Margin="0,0,5,0"/>

                            <TextBlock Text="Tải lại" FontSize="12" Foreground="#424242"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                

                <StackPanel Orientation="Horizontal" 

                           HorizontalAlignment="Right"

                           VerticalAlignment="Center">

                    <Button x:Name="btnCapture" 

                           Width="160" Height="45" Margin="0,0,10,0"

                           Background="#4CAF50" 

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btnCapture_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" 

                                 Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"

                                 Width="18" Height="18" Margin="0,0,8,0"/>

                            <TextBlock Text="Chụp ảnh" FontSize="13" FontWeight="SemiBold" Foreground="White"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEmbed" 

                           Width="180" Height="45"

                           Background="#2196F3" 

                           BorderThickness="0"

                           Cursor="Hand"

                           Click="btnEmbed_Click">

                        <StackPanel Orientation="Horizontal">

                            <Path Fill="White" 

                                 Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"

                                 Width="18" Height="18" Margin="0,0,8,0"/>

                            <TextBlock Text="Nhúng vào bảng" FontSize="13" FontWeight="SemiBold" Foreground="White"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>

