<Window x:Class="QASmartTouch.Forms.AnnotationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotation Overlay"
        WindowStyle="None"
        Background="#01000000"
        AllowsTransparency="True"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Pen"
        ForceCursor="True"
        MouseDown="DrawingCanvas_MouseDown"
        MouseMove="DrawingCanvas_MouseMove"
        MouseUp="DrawingCanvas_MouseUp"
        StylusDown="DrawingCanvas_StylusDown"
        StylusMove="DrawingCanvas_StylusMove"
        StylusUp="DrawingCanvas_StylusUp">

    <!-- Drawing Canvas -->
    <Canvas x:Name="DrawingCanvas"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Cursor="Pen"
            ForceCursor="True">
        <!-- All strokes will be added here dynamically -->
    </Canvas>
</Window>

