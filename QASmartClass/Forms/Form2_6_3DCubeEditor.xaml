<Window x:Class="QASmartTouch.Forms.Form2_6_3DCubeEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chức năng vẽ khối lập phương 3D" 
        Height="720" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Label Text Style -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern TabItem Style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="#ECEFF1" 
                                CornerRadius="8,8,0,0" 
                                Margin="0,0,4,0" 
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1,1,1,0"
                                BorderBrush="#CFD8DC">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,3,1,0"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset View Button Style -->
        <Style x:Key="PresetViewButton" TargetType="Button">
            <Setter Property="Background" Value="#F0F4F8"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Footer Action Button Styles -->
        <Style x:Key="FooterConfirmButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterCloseButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterSecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEFF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterInfoButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0277BD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="60"/>
            <!-- 1: Main Content -->
            <RowDefinition Height="*"/>
            <!-- 2: Fixed Footer Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="20,10" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <!-- Cube Icon -->
                            <Path Data="M12,2 L21,7 L12,12 L3,7 Z" Fill="#2196F3" Opacity="0.8"/>
                            <Path Data="M3,7 L12,12 L12,22 L3,17 Z" Fill="#1976D2" Opacity="0.9"/>
                            <Path Data="M21,7 L12,12 L12,22 L21,17 Z" Fill="#1565C0"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Chức năng vẽ khối lập phương 3D" 
                                   FontSize="17" 
                                   FontWeight="Bold" 
                                   Foreground="#212121"/>
                        <TextBlock Text="Công cụ hỗ trợ giảng dạy hình học không gian trực quan" 
                                   FontSize="12" 
                                   Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top-Right Close Button -->
                <Button Grid.Column="1" 
                        Content="✕" 
                        Width="36" Height="36" 
                        FontSize="16" 
                        FontWeight="Bold"
                        Background="Transparent" 
                        Foreground="#757575"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="Đóng cửa sổ">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="15,12,15,10">
            <Grid.ColumnDefinitions>
                <!-- Left: Canvas Area -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Tabs Control Panel -->
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CANVAS AREA -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#CFD8DC" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="0,0,10,0">
                <Grid ClipToBounds="True">
                    <!-- 3D Drawing Canvas with Direct Touch / Mouse Drag -->
                    <Canvas x:Name="CubeCanvas" 
                            Background="Transparent"
                            ClipToBounds="True"
                            Cursor="SizeAll"
                            MouseDown="CubeCanvas_MouseDown"
                            MouseMove="CubeCanvas_MouseMove"
                            MouseUp="CubeCanvas_MouseUp"
                            MouseLeave="CubeCanvas_MouseLeave"
                            TouchDown="CubeCanvas_TouchDown"
                            TouchMove="CubeCanvas_TouchMove"
                            TouchUp="CubeCanvas_TouchUp"
                            TouchLeave="CubeCanvas_TouchUp"
                            MouseWheel="CubeCanvas_MouseWheel"/>

                    <!-- Floating Touch Hint Badge -->
                    <Border HorizontalAlignment="Center" 
                            VerticalAlignment="Bottom"
                            Background="#D9263238" 
                            CornerRadius="16" 
                            Padding="16,7" 
                            Margin="0,0,0,14"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖐️ Chạm &amp; kéo trực tiếp trên hình để xoay 3D" 
                                       FontSize="12" 
                                       Foreground="White" 
                                       FontWeight="Medium"/>
                            <TextBlock Text="  •  " FontSize="12" Foreground="#B0BEC5"/>
                            <TextBlock Text="🔍 Lăn chuột để phóng to / thu nhỏ" 
                                       FontSize="12" 
                                       Foreground="#ECEFF1" 
                                       FontWeight="Normal"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: TABBED CONTROL PANEL -->
            <Border Grid.Column="1" 
                    Background="White" 
                    BorderBrush="#CFD8DC" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="10">
                <TabControl BorderThickness="0" Background="Transparent">
                    
                    <!-- TAB 1: KÍCH THƯỚC -->
                    <TabItem Header="📏 Kích thước" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- STATS PANEL -->
                                <Border Background="#FFF8E1" 
                                        BorderBrush="#FFB300" 
                                        BorderThickness="0,0,0,3" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📊 Thông số hình học hiện tại:" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#E65100"
                                                   Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Số đỉnh:" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock Text="8" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Số cạnh:" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock Text="12" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="• Số mặt:" FontSize="12" Foreground="#4E342E"/>
                                            <TextBlock Text="6" FontSize="12" Foreground="#E65100" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="• Thể tích (a³):" FontSize="12" Foreground="#4E342E"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="VolumeText" Text="3,375,000" FontSize="12" Foreground="#E65100" FontWeight="Bold"/>
                                                <TextBlock Text=" đvtt" FontSize="12" Foreground="#4E342E"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SIZE CONTROL -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📐 Kích thước khối lập phương" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Độ dài cạnh (a):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="SizeValue" Text="150" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="SizeSlider" 
                                                Minimum="50" Maximum="300" 
                                                Value="150"
                                                TickFrequency="10" 
                                                IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="SizeSlider_ValueChanged"/>

                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Độ dày nét viền:" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="ThicknessValue" Text="1.5" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="ThicknessSlider" 
                                                Minimum="0.5" Maximum="5" 
                                                Value="1.5"
                                                Margin="0,4,0,4"
                                                ValueChanged="ThicknessSlider_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: HIỂN THỊ & MÀU SẮC -->
                    <TabItem Header="🎨 Hiển thị &amp; Màu" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- DISPLAY MODE -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🖼️ Chế độ vẽ &amp; Nét hiển thị" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Text="Chế độ hiển thị:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="DrawModeComboBox" 
                                                  Height="34" 
                                                  FontSize="12"
                                                  Margin="0,0,0,10"
                                                  SelectionChanged="DrawModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Khung dây (Wireframe)" IsSelected="True"/>
                                            <ComboBoxItem Content="Tô màu mặt (Solid)"/>
                                            <ComboBoxItem Content="Cả hai (Khung dây &amp; Mặt tô)"/>
                                        </ComboBox>

                                        <!-- Hidden Edges Option -->
                                        <CheckBox x:Name="chkShowHiddenEdges" 
                                                  Content="Hiển thị nét đứt (Cạnh khuất)" 
                                                  IsChecked="True" 
                                                  FontSize="12"
                                                  Foreground="#424242"
                                                  Margin="0,2,0,8"
                                                  Checked="chkShowHiddenEdges_Click"
                                                  Unchecked="chkShowHiddenEdges_Click"/>

                                        <!-- Vertex Labels Option -->
                                        <CheckBox x:Name="chkShowVertexLabels" 
                                                  Content="Hiển thị nhãn đỉnh (A, B, C...)" 
                                                  IsChecked="True" 
                                                  FontSize="12"
                                                  Foreground="#424242"
                                                  Margin="0,0,0,4"
                                                  Checked="chkShowVertexLabels_Click"
                                                  Unchecked="chkShowVertexLabels_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- COLORS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎨 Bảng màu sắc" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <!-- Face Color Picker -->
                                        <TextBlock Text="Màu mặt (Face):" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="FaceColorComboBox" 
                                                      Grid.Column="0"
                                                      Height="34" 
                                                      FontSize="12"
                                                      SelectionChanged="FaceColorComboBox_SelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                                    BorderBrush="#999" BorderThickness="1"/>
                                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <ComboBoxItem Content="Trong suốt (Transparent)" Tag="Transparent" IsSelected="True"/>
                                                <ComboBoxItem Content="Xanh lá (Green)" Tag="#64FF64"/>
                                                <ComboBoxItem Content="Xanh dương (Blue)" Tag="#6496FF"/>
                                                <ComboBoxItem Content="Đỏ (Red)" Tag="#FF6464"/>
                                                <ComboBoxItem Content="Vàng (Yellow)" Tag="#FFFF64"/>
                                                <ComboBoxItem Content="Cam (Orange)" Tag="#FFA500"/>
                                                <ComboBoxItem Content="Tím (Purple)" Tag="#C864FF"/>
                                                <ComboBoxItem Content="Hồng (Pink)" Tag="#FF96C8"/>
                                                <ComboBoxItem Content="Xám (Gray)" Tag="#969696"/>
                                            </ComboBox>

                                            <Border Grid.Column="1" 
                                                    x:Name="FaceColorPreview"
                                                    CornerRadius="4" 
                                                    Margin="8,0,0,0"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="Transparent"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <!-- Edge Color Picker -->
                                        <TextBlock Text="Màu viền (Edge):" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="EdgeColorComboBox" 
                                                      Grid.Column="0"
                                                      Height="34" 
                                                      FontSize="12"
                                                      SelectionChanged="EdgeColorComboBox_SelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                                    BorderBrush="#999" BorderThickness="1"/>
                                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" 
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <ComboBoxItem Content="Đen (Black)" Tag="Black" IsSelected="True"/>
                                                <ComboBoxItem Content="Trắng (White)" Tag="White"/>
                                                <ComboBoxItem Content="Đỏ (Red)" Tag="Red"/>
                                                <ComboBoxItem Content="Xanh lá (Green)" Tag="Green"/>
                                                <ComboBoxItem Content="Xanh dương (Blue)" Tag="Blue"/>
                                                <ComboBoxItem Content="Vàng (Yellow)" Tag="Yellow"/>
                                                <ComboBoxItem Content="Tím (Purple)" Tag="Purple"/>
                                                <ComboBoxItem Content="Cam (Orange)" Tag="Orange"/>
                                            </ComboBox>

                                            <Border Grid.Column="1" 
                                                    x:Name="EdgeColorPreview"
                                                    Background="Black" 
                                                    CornerRadius="4" 
                                                    Margin="8,0,0,0"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: GÓC XOAY & QUAN SÁT -->
                    <TabItem Header="🔄 Góc xoay" Style="{StaticResource ModernTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="Both"
                                      Padding="4,8,8,8">
                            <StackPanel>
                                <!-- PRESET VIEWS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Góc nhìn chuẩn nhanh" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#37474F"
                                                   Margin="0,0,0,8"/>

                                        <UniformGrid Columns="2" Rows="2">
                                            <Button Content="👁️ Chính diện" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="0,0,4,6"
                                                    Click="BtnPresetFront_Click"
                                                    ToolTip="Góc nhìn thẳng trực diện"/>
                                            <Button Content="📐 Phối cảnh 60°" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="4,0,0,6"
                                                    Click="BtnPresetPerspective_Click"
                                                    ToolTip="Góc nhìn phối cảnh sư phạm trực quan"/>
                                            <Button Content="🔝 Từ trên xuống" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="0,0,4,0"
                                                    Click="BtnPresetTop_Click"
                                                    ToolTip="Góc nhìn từ đỉnh xuống đáy"/>
                                            <Button Content="🧊 Đẳng cự 30°" 
                                                    Style="{StaticResource PresetViewButton}"
                                                    Margin="4,0,0,0"
                                                    Click="BtnPresetIsometric_Click"
                                                    ToolTip="Góc nhìn đẳng cự kỹ thuật"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- ROTATION SLIDERS -->
                                <Border Background="#F9FAFB" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🔄 Điều chỉnh góc xoay" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="#37474F"/>
                                            <CheckBox x:Name="chkAutoRotate" 
                                                      Content="Tự động xoay" 
                                                      FontSize="12"
                                                      Foreground="#1976D2"
                                                      FontWeight="SemiBold"
                                                      HorizontalAlignment="Right"
                                                      Checked="OnAutoRotateChanged"
                                                      Unchecked="OnAutoRotateChanged"/>
                                        </Grid>

                                        <!-- Rotation X -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Xoay trục X (Nghiêng lên/xuống):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="RotXValue" Text="0°" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="RotXSlider" 
                                                Minimum="0" Maximum="360" 
                                                Value="0"
                                                TickFrequency="15" 
                                                IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="RotationSlider_ValueChanged"/>

                                        <!-- Rotation Y -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Xoay trục Y (Quay trái/phải):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="RotYValue" Text="60°" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="RotYSlider" 
                                                Minimum="0" Maximum="360" 
                                                Value="60"
                                                TickFrequency="15" 
                                                IsSnapToTickEnabled="True"
                                                Margin="0,4,0,10"
                                                ValueChanged="RotationSlider_ValueChanged"/>

                                        <!-- Rotation Z -->
                                        <Grid Margin="0,4,0,2">
                                            <TextBlock Text="Xoay trục Z (Nghiêng mặt phẳng):" Style="{StaticResource LabelText}"/>
                                            <TextBlock x:Name="RotZValue" Text="0°" Style="{StaticResource ValueText}"/>
                                        </Grid>
                                        <Slider x:Name="RotZSlider" 
                                                Minimum="0" Maximum="360" 
                                                Value="0"
                                                TickFrequency="15" 
                                                IsSnapToTickEnabled="True"
                                                Margin="0,4,0,4"
                                                ValueChanged="RotationSlider_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- FOOTER: FIXED ACTION BAR (Không bao giờ bị cuộn) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="15,10">
            <Grid>
                <!-- Trái: Các nút tính năng phụ trợ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="ResetButton"
                            Content="🔄 Đặt lại mặc định"
                            Style="{StaticResource FooterSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="ResetButton_Click"
                            ToolTip="Đặt lại tất cả kích thước và góc nhìn về ban đầu"/>

                    <Button x:Name="DownloadButton"
                            Content="💾 Tải ảnh PNG"
                            Style="{StaticResource FooterSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="DownloadButton_Click"
                            ToolTip="Xuất hình khối lập phương ra file ảnh chất lượng cao lưu vào máy"/>

                    <Button x:Name="btnCopyStats"
                            Content="📋 Chèn kèm bảng thông số"
                            Style="{StaticResource FooterInfoButton}"
                            Click="btnCopyStats_Click"
                            ToolTip="Chèn hình lập phương kèm theo bảng chi tiết diện tích &amp; thể tích vào bài giảng"/>
                </StackPanel>

                <!-- Phải: Các nút hành động chính (To, rõ, thân thiện cảm ứng) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnClose"
                            Content="❌ Hủy bỏ"
                            Style="{StaticResource FooterCloseButton}"
                            Margin="0,0,10,0"
                            Click="CloseButton_Click"/>

                    <Button x:Name="ConfirmButton"
                            Content="✅ Xác nhận chèn vào bảng"
                            Style="{StaticResource FooterConfirmButton}"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
