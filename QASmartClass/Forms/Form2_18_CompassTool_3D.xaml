<Window x:Class="QASmartTouch.Forms.Form2_18_CompassTool_3D"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:helix="http://helix-toolkit.org/wpf"

        Title="Professional Compass Tool - 3D Demo"

        Width="600" Height="700"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="CanResize"

        Topmost="True"

        ShowInTaskbar="False"

        Loaded="Window_Loaded">

    

    <Window.Resources>

        <DropShadowEffect x:Key="DropShadowEffect" 

                          ShadowDepth="5" 

                          BlurRadius="15" 

                          Opacity="0.4"/>

        

        <Style x:Key="ControlButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="36"/>

            <Setter Property="Height" Value="36"/>

            <Setter Property="Margin" Value="4"/>

            <Setter Property="Background" Value="#F3F4F6"/>

            <Setter Property="BorderBrush" Value="#D1D5DB"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="16"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#E5E7EB"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>



    <Border Background="#FFFFFF" 

            CornerRadius="12" 

            BorderBrush="#E5E7EB" 

            BorderThickness="2"

            Effect="{StaticResource DropShadowEffect}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="50"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <!-- Title Bar -->

            <Border Grid.Row="0" 

                    CornerRadius="12,12,0,0"

                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Border.Background>

                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                        <GradientStop Color="#3B82F6" Offset="0"/>

                        <GradientStop Color="#2563EB" Offset="1"/>

                    </LinearGradientBrush>

                </Border.Background>

                <Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">

                        <TextBlock Text="🔧" FontSize="20" Margin="0,0,10,0"/>

                        <TextBlock Text="Professional Compass Tool - 3D Demo" 

                                   FontSize="16" 

                                   FontWeight="Bold" 

                                   Foreground="White"

                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    

                    <Button x:Name="btnClose"

                            Style="{StaticResource ControlButtonStyle}"

                            Content="✕"

                            Background="#EF4444"

                            Foreground="White"

                            HorizontalAlignment="Right"

                            Margin="0,0,10,0"

                            Click="BtnClose_Click"/>

                </Grid>

            </Border>



            <!-- 3D Viewport -->

            <Border Grid.Row="1" Margin="10" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1">

                <helix:HelixViewport3D x:Name="viewport3D"

                                        Background="#F9FAFB"

                                        CameraRotationMode="Trackball"

                                        ShowCoordinateSystem="True"

                                        ShowCameraInfo="True"

                                        ShowFrameRate="True"

                                        ShowViewCube="True">

                    

                    <!-- Camera -->

                    <helix:HelixViewport3D.Camera>

                        <PerspectiveCamera Position="0,-150,100" 

                                          LookDirection="0,150,-100" 

                                          UpDirection="0,0,1"

                                          FieldOfView="45"/>

                    </helix:HelixViewport3D.Camera>



                    <!-- Default Lights (will be replaced by builder) -->

                    <helix:DefaultLights/>



                    <!-- Grid Helper -->

                    <helix:GridLinesVisual3D Width="200" Length="200" 

                                             MinorDistance="10" 

                                             MajorDistance="50"

                                             Thickness="0.5"

                                             Fill="#E5E7EB"/>



                    <!-- Compass Model Container -->

                    <ModelVisual3D x:Name="compassModelVisual"/>



                </helix:HelixViewport3D>

            </Border>



            <!-- Control Panel -->

            <Border Grid.Row="2" 

                    Background="#F9FAFB" 

                    BorderBrush="#E5E7EB" 

                    BorderThickness="0,1,0,0"

                    CornerRadius="0,0,12,12"

                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Opening Angle Control -->

                    <Grid Grid.Row="0" Margin="0,5">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="140"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="80"/>

                        </Grid.ColumnDefinitions>

                        

                        <TextBlock Grid.Column="0" 

                                   Text="Opening Angle:" 

                                   VerticalAlignment="Center"

                                   FontWeight="SemiBold"/>

                        

                        <Slider Grid.Column="1" 

                                x:Name="sliderAngle"

                                Minimum="10" 

                                Maximum="180" 

                                Value="60"

                                TickFrequency="10"

                                IsSnapToTickEnabled="True"

                                VerticalAlignment="Center"

                                Margin="10,0"

                                ValueChanged="SliderAngle_ValueChanged"/>

                        

                        <TextBlock Grid.Column="2" 

                                   x:Name="txtAngleValue"

                                   Text="60°" 

                                   VerticalAlignment="Center"

                                   HorizontalAlignment="Center"

                                   FontWeight="Bold"

                                   FontSize="14"

                                   Foreground="#3B82F6"/>

                    </Grid>



                    <!-- Radius Control -->

                    <Grid Grid.Row="1" Margin="0,5">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="140"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="80"/>

                        </Grid.ColumnDefinitions>

                        

                        <TextBlock Grid.Column="0" 

                                   Text="Radius (mm):" 

                                   VerticalAlignment="Center"

                                   FontWeight="SemiBold"/>

                        

                        <Slider Grid.Column="1" 

                                x:Name="sliderRadius"

                                Minimum="10" 

                                Maximum="200" 

                                Value="50"

                                TickFrequency="10"

                                IsSnapToTickEnabled="True"

                                VerticalAlignment="Center"

                                Margin="10,0"

                                ValueChanged="SliderRadius_ValueChanged"/>

                        

                        <TextBlock Grid.Column="2" 

                                   x:Name="txtRadiusValue"

                                   Text="50 mm" 

                                   VerticalAlignment="Center"

                                   HorizontalAlignment="Center"

                                   FontWeight="Bold"

                                   FontSize="14"

                                   Foreground="#10B981"/>

                    </Grid>



                    <!-- Camera Control -->

                    <Grid Grid.Row="2" Margin="0,10,0,5">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="140"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        

                        <TextBlock Grid.Column="0" 

                                   Text="Camera View:" 

                                   VerticalAlignment="Center"

                                   FontWeight="SemiBold"/>

                        

                        <StackPanel Grid.Column="1" Orientation="Horizontal">

                            <Button Content="Top" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="80"

                                    Click="BtnViewTop_Click"/>

                            <Button Content="Front" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="80"

                                    Click="BtnViewFront_Click"/>

                            <Button Content="Side" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="80"

                                    Click="BtnViewSide_Click"/>

                            <Button Content="Isometric" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="80"

                                    Click="BtnViewIso_Click"/>

                            <Button Content="Reset" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="80"

                                    Background="#FEF3C7"

                                    Click="BtnViewReset_Click"/>

                        </StackPanel>

                    </Grid>



                    <!-- Action Buttons -->

                    <Grid Grid.Row="3" Margin="0,10,0,0">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <Button Content="📸 Export View" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="120"

                                    Height="40"

                                    Background="#8B5CF6"

                                    Foreground="White"

                                    Click="BtnExport_Click"/>

                            

                            <Button Content="🔄 Animate" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="120"

                                    Height="40"

                                    Background="#EC4899"

                                    Foreground="White"

                                    Margin="10,0,0,0"

                                    Click="BtnAnimate_Click"/>

                            

                            <Button Content="ℹ️ Info" 

                                    Style="{StaticResource ControlButtonStyle}"

                                    Width="120"

                                    Height="40"

                                    Background="#06B6D4"

                                    Foreground="White"

                                    Margin="10,0,0,0"

                                    Click="BtnInfo_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

