<Window x:Class="QASmartTouch.Forms.Form2_10_PieChartEditor"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Chức năng vẽ Biểu đồ Hình Tròn" 

        Height="750" Width="1400" 

        WindowStartupLocation="CenterScreen"

        Background="#F5F7FA"

        ResizeMode="CanResize">



    <Window.Resources>

        <!-- Button Style -->

        <Style x:Key="ModernButton" TargetType="Button">

            <Setter Property="Padding" Value="12,10"/>

            <Setter Property="Margin" Value="0,0,0,8"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" 

                                CornerRadius="6" 

                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Opacity" Value="0.9"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- TextBox Style -->

        <Style x:Key="ModernTextBox" TargetType="TextBox">

            <Setter Property="Padding" Value="10"/>

            <Setter Property="BorderBrush" Value="#DDD"/>

            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}" 

                                BorderBrush="{TemplateBinding BorderBrush}" 

                                BorderThickness="{TemplateBinding BorderThickness}" 

                                CornerRadius="6">

                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsFocused" Value="True">

                    <Setter Property="BorderBrush" Value="#667eea"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- ComboBox Style -->

        <Style x:Key="ModernComboBox" TargetType="ComboBox">

            <Setter Property="Padding" Value="10"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="BorderBrush" Value="#DDD"/>

            <Setter Property="BorderThickness" Value="2"/>

        </Style>

    </Window.Resources>



    <Grid>

        <!-- Header -->

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header Section -->

        <Border Grid.Row="0" Padding="20" Background="#FF667EEA">

            <StackPanel>

                <TextBlock Text="Chức năng vẽ Biểu đồ Hình Tròn" 

                           FontSize="24" 

                           FontWeight="Bold" 

                           Foreground="White"/>

                <TextBlock Text="Công cụ tạo biểu đồ tròn (Pie Chart) chuyên nghiệp - Trực quan và đẹp mắt" 

                           FontSize="13" 

                           Foreground="White" 

                           Opacity="0.95" 

                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>



        <!-- Main Content -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="400"/>

            </Grid.ColumnDefinitions>



            <!-- Canvas Area -->

            <Border Grid.Column="0" Padding="30" Background="#F5F7FA">

                <Border x:Name="ChartBorder"

                        Background="White" 

                        BorderBrush="#DDD" 

                        BorderThickness="0.5" 

                        CornerRadius="10" 

                        Padding="20">

                    <Border.Effect>

                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="15" ShadowDepth="4"/>

                    </Border.Effect>

                    <Canvas x:Name="ChartCanvas" Background="White" 
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="ChartCanvas_SizeChanged"/>

                </Border>

            </Border>

            <!-- Control Panel -->

            <ScrollViewer x:Name="MainScrollViewer"

                          Background="#F0F2F5" 

                          VerticalScrollBarVisibility="Auto"

                          PanningMode="Both"

                          PanningDeceleration="0.002"

                          Padding="20" Margin="990,0,10,0" Grid.ColumnSpan="2">

                <StackPanel>

                    <!-- Panel 1: Dữ liệu -->

                    <Border Background="White" 

                            CornerRadius="8" 

                            Padding="15" 

                            Margin="0,0,0,15" 

                            BorderBrush="#667eea" 

                            BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Nhập dữ liệu biểu đồ" 

                                       FontWeight="Bold" 

                                       FontSize="14" 

                                       Margin="0,0,0,15"/>



                            <TextBlock Text="Tiêu đề biểu đồ:" 

                                       FontSize="12" 

                                       FontWeight="SemiBold" 

                                       Margin="0,0,0,6"/>

                            <TextBox x:Name="TxtChartTitle" 

                                     Text="Thị phần sản phẩm năm 2024" 

                                     Style="{StaticResource ModernTextBox}" 

                                     Margin="0,0,0,15" 

                                     TextChanged="OnChartPropertyChanged"/>



                            <TextBlock Text="Dữ liệu các phần:" 

                                       FontSize="12" 

                                       FontWeight="SemiBold" 

                                       Margin="0,0,0,6"/>



                            <Border Background="#FFF9E6" 

                                    CornerRadius="4" 

                                    Padding="8" 

                                    BorderBrush="#FFC107" 

                                    BorderThickness="3,0,0,0" 

                                    Margin="0,0,0,10">

                                <TextBlock Text="Click vào ô màu để thay đổi màu sắc từng phần" 

                                           FontSize="11" 

                                           FontStyle="Italic" 

                                           Foreground="#888" 

                                           TextWrapping="Wrap"/>

                            </Border>



                            <ScrollViewer x:Name="DataEntriesScrollViewer" MaxHeight="300" 

                                          VerticalScrollBarVisibility="Auto" 

                                          PanningMode="Both"

                                          PanningDeceleration="0.002"

                                          Margin="0,0,0,10">

                                <StackPanel x:Name="DataEntriesPanel"/>

                            </ScrollViewer>



                            <Grid Margin="0,10,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition/>

                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition/>

                                    <RowDefinition/>

                                </Grid.RowDefinitions>



                                <Button Grid.Row="0" Grid.Column="0" Content="📊 Thị phần" 

                                        Padding="8" Margin="0,0,4,4" 

                                        Background="#6C757D" Foreground="White"

                                        FontSize="11" FontWeight="Bold"

                                        Click="BtnPresetMarket_Click"/>

                                <Button Grid.Row="0" Grid.Column="1" Content="💰 Chi tiêu" 

                                        Padding="8" Margin="4,0,0,4"

                                        Background="#6C757D" Foreground="White"

                                        FontSize="11" FontWeight="Bold"

                                        Click="BtnPresetExpense_Click"/>

                                <Button Grid.Row="1" Grid.Column="0" Content="👥 Độ tuổi" 

                                        Padding="8" Margin="0,4,4,0"

                                        Background="#6C757D" Foreground="White"

                                        FontSize="11" FontWeight="Bold"

                                        Click="BtnPresetAge_Click"/>

                                <Button Grid.Row="1" Grid.Column="1" Content="🌐 Trình duyệt" 

                                        Padding="8" Margin="4,4,0,0"

                                        Background="#6C757D" Foreground="White"

                                        FontSize="11" FontWeight="Bold"

                                        Click="BtnPresetBrowser_Click"/>

                            </Grid>

                        </StackPanel>

                    </Border>



                    <!-- Panel 2: Thống kê -->

                    <Border Background="White" 

                            CornerRadius="8" 

                            Padding="15" 

                            Margin="0,0,0,15"

                            BorderBrush="#667eea"

                            BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Thống kê dữ liệu" 

                                       FontWeight="Bold" 

                                       FontSize="14" 

                                       Margin="0,0,0,15"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition/>

                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition/>

                                    <RowDefinition/>

                                </Grid.RowDefinitions>



                                <Border Grid.Row="0" Grid.Column="0" Background="#F8F9FA" 

                                        CornerRadius="6" Padding="10" Margin="0,0,5,5"

                                        BorderBrush="#E0E0E0" BorderThickness="1">

                                    <StackPanel>

                                        <TextBlock Text="Tổng giá trị" FontSize="10" Foreground="#666" Margin="0,0,0,4"/>

                                        <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="16" FontWeight="Bold" Foreground="#667eea"/>

                                    </StackPanel>

                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="#F8F9FA" 

                                        CornerRadius="6" Padding="10" Margin="5,0,0,5"

                                        BorderBrush="#E0E0E0" BorderThickness="1">

                                    <StackPanel>

                                        <TextBlock Text="Số phần" FontSize="10" Foreground="#666" Margin="0,0,0,4"/>

                                        <TextBlock x:Name="TxtStatCount" Text="0" FontSize="16" FontWeight="Bold" Foreground="#667eea"/>

                                    </StackPanel>

                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="#F8F9FA" 

                                        CornerRadius="6" Padding="10" Margin="0,5,5,0"

                                        BorderBrush="#E0E0E0" BorderThickness="1">

                                    <StackPanel>

                                        <TextBlock Text="Lớn nhất" FontSize="10" Foreground="#666" Margin="0,0,0,4"/>

                                        <TextBlock x:Name="TxtStatMax" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#667eea"/>

                                    </StackPanel>

                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="#F8F9FA" 

                                        CornerRadius="6" Padding="10" Margin="5,5,0,0"

                                        BorderBrush="#E0E0E0" BorderThickness="1">

                                    <StackPanel>

                                        <TextBlock Text="Nhỏ nhất" FontSize="10" Foreground="#666" Margin="0,0,0,4"/>

                                        <TextBlock x:Name="TxtStatMin" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#667eea"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>



                    <!-- Panel 3: Kiểu biểu đồ -->

                    <Border Background="White" 

                            CornerRadius="8" 

                            Padding="15" 

                            Margin="0,0,0,15"

                            BorderBrush="#667eea"

                            BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Kiểu biểu đồ" 

                                       FontWeight="Bold" 

                                       FontSize="14" 

                                       Margin="0,0,0,15"/>



                            <TextBlock Text="Loại biểu đồ:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <ComboBox x:Name="CmbChartType" 

                                      Style="{StaticResource ModernComboBox}"

                                      Margin="0,0,0,15"

                                      SelectionChanged="OnChartPropertyChanged">

                                <ComboBoxItem Content="Biểu đồ tròn (Pie)" IsSelected="True"/>

                                <ComboBoxItem Content="Biểu đồ vòng (Donut)"/>

                                <ComboBoxItem Content="Bán nguyệt (Semi-circle)"/>

                            </ComboBox>



                            <TextBlock Text="Kiểu hiển thị:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <ComboBox x:Name="CmbDisplayStyle" 

                                      Style="{StaticResource ModernComboBox}"

                                      SelectionChanged="OnChartPropertyChanged">

                                <ComboBoxItem Content="Thông thường" IsSelected="True"/>

                                <ComboBoxItem Content="Tách rời (Exploded)"/>

                                <ComboBoxItem Content="Hiệu ứng 3D"/>

                            </ComboBox>

                        </StackPanel>

                    </Border>



                    <!-- Panel 4: Tùy chỉnh -->

                    <Border Background="White" 

                            CornerRadius="8" 

                            Padding="15" 

                            Margin="0,0,0,15"

                            BorderBrush="#667eea"

                            BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="⚙️ Tùy chỉnh hiển thị" 

                                       FontWeight="Bold" 

                                       FontSize="14" 

                                       Margin="0,0,0,15"/>



                            <!-- Kích thước -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Kích thước biểu đồ:" FontSize="12" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtSizeValue" Grid.Column="1" Text="80%" 

                                           FontWeight="Bold" Foreground="#667eea" FontSize="12"/>

                            </Grid>

                            <Slider x:Name="SliderSize" Minimum="50" Maximum="100" Value="80" 

                                    TickFrequency="5" IsSnapToTickEnabled="True"

                                    Margin="0,0,0,15"

                                    ValueChanged="OnSliderChanged"/>



                            <!-- Donut Hole -->

                            <Grid x:Name="DonutHoleGroup" Margin="0,0,0,10" Visibility="Collapsed">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Độ rộng lỗ Donut:" FontSize="12" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtDonutHoleValue" Grid.Column="1" Text="50%" 

                                           FontWeight="Bold" Foreground="#667eea" FontSize="12"/>

                            </Grid>

                            <Slider x:Name="SliderDonutHole" Minimum="20" Maximum="70" Value="50" 

                                    TickFrequency="5" IsSnapToTickEnabled="True"

                                    Margin="0,0,0,15" Visibility="Collapsed"

                                    ValueChanged="OnSliderChanged"/>



                            <!-- Góc bắt đầu -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Góc bắt đầu:" FontSize="12" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtStartAngleValue" Grid.Column="1" Text="-90°" 

                                           FontWeight="Bold" Foreground="#667eea" FontSize="12"/>

                            </Grid>

                            <Slider x:Name="SliderStartAngle" Minimum="-180" Maximum="180" Value="-90" 

                                    TickFrequency="15" IsSnapToTickEnabled="True"

                                    Margin="0,0,0,15"

                                    ValueChanged="OnSliderChanged"/>



                            <!-- Khoảng cách tách -->

                            <Grid x:Name="ExplodeDistanceGroup" Margin="0,0,0,10" Visibility="Collapsed">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Khoảng cách tách:" FontSize="12" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtExplodeDistanceValue" Grid.Column="1" Text="20px" 

                                           FontWeight="Bold" Foreground="#667eea" FontSize="12"/>

                            </Grid>

                            <Slider x:Name="SliderExplodeDistance" Minimum="5" Maximum="50" Value="20" 

                                    TickFrequency="5" IsSnapToTickEnabled="True"

                                    Margin="0,0,0,15" Visibility="Collapsed"

                                    ValueChanged="OnSliderChanged"/>



                            <!-- Checkboxes -->

                            <CheckBox x:Name="ChkShowLabels" Content="Hiển thị nhãn" 

                                      IsChecked="True" Margin="0,0,0,8"

                                      Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowPercentages" Content="Hiển thị phần trăm" 

                                      IsChecked="True" Margin="0,0,0,8"

                                      Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowValues" Content="Hiển thị giá trị" 

                                      IsChecked="False" Margin="0,0,0,8"

                                      Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowLegend" Content="Hiển thị chú thích" 

                                      IsChecked="True" Margin="0,0,0,8"

                                      Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                            <CheckBox x:Name="ChkShowShadow" Content="Hiển thị bóng đổ" 

                                      IsChecked="True" Margin="0,0,0,8"

                                      Checked="OnChartPropertyChanged" Unchecked="OnChartPropertyChanged"/>

                        </StackPanel>

                    </Border>



                    <!-- Panel 5: Chức năng -->

                    <Border Background="White" 

                            CornerRadius="8" 

                            Padding="15"

                            BorderBrush="#667eea"

                            BorderThickness="4,0,0,0">

                        <Border.Effect>

                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="⚙️ Chức năng" 

                                       FontWeight="Bold" 

                                       FontSize="14" 

                                       Margin="0,0,0,15"/>

                            <Button Content="Xác nhận hoàn thành" 

                                    Background="#1976D2"

                                    Style="{StaticResource ModernButton}"

                                    Click="BtnConfirm_Click"

                                    Height="38"

                                    FontSize="12"

                                    Margin="0,0,0,8"/>

                            <Button Content="Lưu hình ảnh PNG" 

                                    Background="#00838F"

                                    Style="{StaticResource ModernButton}"

                                    Click="BtnSaveImage_Click"

                                    Height="38"

                                    FontSize="12"

                                    Margin="0,0,0,8"/>

                            <Button Content="Reset về mặc định" 

                                    Background="#E65100"

                                    Style="{StaticResource ModernButton}"

                                    Click="BtnReset_Click"

                                    Height="38"

                                    FontSize="12"

                                    Margin="0,0,0,8"/>

                            <Button Content="Thoát" 

                                    Background="#546E7A"

                                    Style="{StaticResource ModernButton}"

                                    Click="Exit_Click"

                                    Height="38"

                                    FontSize="12"/>

                        </StackPanel>

                    </Border>



                    <!-- Panel 6: Hướng dẫn sư phạm -->

                    <Border Background="#FFF9C4" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0">

                        <Expander Header="💡 Hướng dẫn tạo nhanh biểu đồ" IsExpanded="False" Background="Transparent" BorderThickness="0">

                            <TextBlock Padding="10" FontSize="11" TextWrapping="Wrap" Foreground="#5D4037" FontFamily="Segoe UI">

                                Bước 1: Nhập tiêu đề và nhãn các trục bên trên.&#x0a;

                                Bước 2: Click 'Thêm dữ liệu' hoặc nhấn 'Preset dữ liệu mẫu'.&#x0a;

                                Bước 3: Nhập dữ liệu theo định dạng [Nhãn : Giá trị số].&#x0a;

                                Bước 4: Nhấn nút màu xanh dương 'Xác nhận hoàn thành' để chèn vào bảng vẽ.

                            </TextBlock>

                        </Expander>

                    </Border>



                </StackPanel>



            </ScrollViewer>

        </Grid>

    </Grid>

</Window>

