                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="txtHudTouchMode" Text="Đa chạm" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center"/>
