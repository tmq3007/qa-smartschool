<Window x:Class="QASmartTouch.Forms.Form2_MainDashboard"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QASmartTouch.Controls"
        Title="QASmartTouch - Dashboard"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#F5F6FA">

    

    <Grid x:Name="MainGrid">

        <Grid.RowDefinitions>

            <RowDefinition Height="50"/>      <!-- Header -->

            <RowDefinition Height="*"/>        <!-- Content (Board + Toolbar Overlay) -->

        </Grid.RowDefinitions>



        <!-- ROW 0: HEADER PANEL -->

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">

            <Grid>

                <!-- Logo iPro -->

                <StackPanel Orientation="Horizontal" 

                          HorizontalAlignment="Left" 

                          VerticalAlignment="Center"

                          Margin="20,0,0,0">

                    <!-- Graduation Cap Icon -->

                    <Viewbox x:Name="HeaderIcon" Width="30" Height="30" Margin="0,0,8,0">

                        <Canvas Width="24" Height="24">

                            <Path Fill="#2E86DE" 

                                  Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z"/>

                        </Canvas>

                    </Viewbox>

                    <!-- Logo Text -->

                    <TextBlock x:Name="HeaderAppName"

                             Text="QA SmartClass" 

                             FontSize="20" 

                             FontWeight="Bold" 

                             Foreground="#2E86DE"

                             VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>



        <!-- ROW 1: CONTENT PANEL (Canvas + Welcome State) -->

        <Grid x:Name="ContentGrid" Grid.Row="1" Background="#3D6D64" ClipToBounds="True">

            <!-- ScrollViewer for Pan/Scroll functionality -->

            <ScrollViewer x:Name="MainScrollViewer"

                         HorizontalScrollBarVisibility="Hidden"

                         VerticalScrollBarVisibility="Hidden"

                         PanningMode="None"

                         Background="Transparent"

                         ClipToBounds="False"

                         SizeChanged="MainScrollViewer_SizeChanged"
                         PreviewMouseDown="MainScrollViewer_PreviewMouseDown"
                         PreviewTouchDown="MainScrollViewer_PreviewTouchDown"
                         PreviewStylusDown="MainScrollViewer_PreviewStylusDown">

                <!-- Main Interactive Board (Canvas) -->

                <!-- OPTIMIZED FOR 86 INCH DISPLAY: Hardware acceleration + Bitmap caching -->

                <!-- ✨ ENHANCED: Stroke optimization for HDMI-connected interactive boards -->

                <Canvas x:Name="MainInteractiveBoard" 

                        Width="1920"

                        Height="1080"

                        Background="#3D6D64"

                        ClipToBounds="False"

                        UseLayoutRounding="True"

                        SnapsToDevicePixels="True"

                        RenderOptions.EdgeMode="Unspecified"

                        RenderOptions.BitmapScalingMode="HighQuality"

                        TextOptions.TextFormattingMode="Display"

                        TextOptions.TextRenderingMode="ClearType"

                        SizeChanged="MainInteractiveBoard_SizeChanged"

                        MouseDown="MainInteractiveBoard_MouseDown"

                        MouseMove="MainInteractiveBoard_MouseMove"

                        MouseUp="MainInteractiveBoard_MouseUp"

                        MouseLeave="MainInteractiveBoard_MouseLeave"

                        MouseEnter="MainInteractiveBoard_MouseEnter"
                        MouseWheel="MainInteractiveBoard_MouseWheel">
                </Canvas>

            </ScrollViewer>



            <!-- Welcome State Panel -->

            <Border x:Name="panelWelcomeState"

                    Background="Transparent"

                    HorizontalAlignment="Center"

                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Pen Icon Circle -->

                    <Border Width="120" Height="120" 

                            Background="#E3F2FD" 

                            CornerRadius="60"

                            Margin="0,0,0,20"

                            HorizontalAlignment="Center">

                        <!-- Pen Icon -->

                        <Viewbox Width="48" Height="48">

                            <Canvas Width="24" Height="24">

                                <Path Fill="#2E86DE" 

                                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>

                            </Canvas>

                        </Viewbox>

                    </Border>



                    <!-- Welcome Message -->

                    <TextBlock Text="Vui lòng chọn công cụ để viết"

                             FontSize="18"

                             FontWeight="SemiBold"

                             Foreground="#FFF9C4"

                             HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>



        <!-- TOOLBAR OVERLAY (on top of board) -->

        <Grid Grid.Row="1" Margin="0,0,0,10">

            <Border Background="White" 

                    BorderBrush="#E1E8ED" 

                    BorderThickness="1"

                    CornerRadius="15"

                    HorizontalAlignment="Center"

                    VerticalAlignment="Bottom"

                    Padding="8,6">

                <Border.Effect>

                    <DropShadowEffect Color="#CCCCCC" 

                                    Direction="90" 

                                    ShadowDepth="2" 

                                    BlurRadius="10" 

                                    Opacity="0.2"/>

                </Border.Effect>



                <StackPanel x:Name="panelTools" 

                           Orientation="Horizontal" 

                           HorizontalAlignment="Center"

                           VerticalAlignment="Center">



                <!-- Tool 1: Pen (Bút viết) -->

                <Button x:Name="btn1_Pen" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn1_Pen_Click"

                       ToolTip="Bút viết">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 2: Eraser (Tẩy) -->

                <Button x:Name="btn2_Eraser" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn2_Eraser_Click"

                       ToolTip="Tẩy (E) — Click: Kích hoạt | Click lần 2: Cài đặt">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 3: Undo (Hoàn tác) -->

                <Button x:Name="btn3_Undo" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn3_Undo_Click"

                       ToolTip="Hoàn tác">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 4: Redo (Làm lại) -->

                <Button x:Name="btn4_Redo" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn4_Redo_Click"

                       ToolTip="Làm lại">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 5: Shapes (Hình học) -->

                <Button x:Name="btn5_Shapes" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn5_Shapes_Click"

                       ToolTip="Hình học">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M18,13L22,21H14L18,13Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 6: Insert (Chèn) -->

                <Button x:Name="btn6_Inserts" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn6_Inserts_Click"

                       ToolTip="Chèn nội dung">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Note: Line Chart and Pie Chart moved to SubMenu Draw Shapes > Charts category -->



                <!-- Tool 7: Zoom (Phóng to) -->

                <Button x:Name="btn7_Zoom" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn7_Zoom_Click"

                       ToolTip="Phóng to">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 8: Select (Chọn vùng) -->

                <Button x:Name="btn8_Select" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn8_Select_Click"

                       ToolTip="Chọn vùng">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M13.64,21.97C13.14,22.21 12.54,22 12.31,21.5L10.13,16.76L7.62,18.78C7.45,18.92 7.24,19 7,19A1,1 0 0,1 6,18V3A1,1 0 0,1 7,2C7.24,2 7.47,2.09 7.64,2.23L7.65,2.22L19.14,11.86C19.57,12.22 19.62,12.85 19.27,13.27C19.12,13.45 18.91,13.57 18.7,13.61L15.54,14.23L17.74,18.96C18,19.46 17.76,20.05 17.26,20.28L13.64,21.97Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 9: Board Tools (Công cụ bảng) -->

                <Button x:Name="btn9_BoardManagement" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn9_BoardManagement_Click"

                       ToolTip="Công cụ bảng">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <!-- Whiteboard/Clipboard Icon -->

                                        <Path Fill="#2F3542" 

                                              Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M12,17L17,12L15.59,10.59L12,14.17L9.91,12.09L8.5,13.5L12,17Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 9.5: Screen Curtain (Màn che bảng) -->

                <Button x:Name="btn9_5_ScreenCurtain" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn9_5_ScreenCurtain_Click"

                       ToolTip="Màn che bảng"

                       Visibility="Collapsed">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <!-- Screen with curtain icon -->

                                        <Path Fill="#2F3542" 

                                              Data="M4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H4A2,2 0 0,1 2,16V4A2,2 0 0,1 4,2M4,6V16H20V6H4M12,8A2,2 0 0,1 14,10A2,2 0 0,1 12,12A2,2 0 0,1 10,10A2,2 0 0,1 12,8M7,22V20H17V22H7Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 10: Window Mode (Chế độ Window) -->

                <Button x:Name="btn10_WindowMode" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn10_WindowMode_Click"

                       ToolTip="Chế độ DESKTOP">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M3,12V6.75L9,5.43V11.91L3,12M20,3V11.75L10,11.9V5.21L20,3M3,13L9,13.09V19.9L3,18.75V13M20,13.25V22L10,20.09V13.1L20,13.25Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 11: Smart Class -->
                <Button x:Name="btn11_SmartClass" 
                       Width="50" Height="50" 
                       Margin="3"
                       Background="#F1F2F6"
                       BorderThickness="0"
                       Cursor="Hand"
                       Click="btn11_SmartClass_Click"
                       ToolTip="SMART CLASS">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 
                                    CornerRadius="10">
                                <Viewbox Width="25" Height="25">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#2F3542" 
                                              Data="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tool 12: More Extended (Mở rộng) -->

                <Button x:Name="btn12_MoreExtended" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#F1F2F6"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn12_MoreExtended_Click"

                       ToolTip="Mở rộng">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="#2F3542" 

                                              Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- Tool 13: Exit (Thoát) -->

                <Button x:Name="btn13_Exit" 

                       Width="50" Height="50" 

                       Margin="3"

                       Background="#EE5A6F"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btn13_Exit_Click"

                       ToolTip="Thoát">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="PART_Border" Background="{TemplateBinding Background}" 

                                    CornerRadius="10">

                                <Viewbox Width="25" Height="25">

                                    <Canvas Width="24" Height="24">

                                        <Path Fill="White" 

                                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>

                                    </Canvas>

                                </Viewbox>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



            </StackPanel>

        </Border>

        <!-- ZOOM INDICATOR HUD (Góc dưới bên phải) -->
        <Border x:Name="hudZoomIndicator"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,6"
                Background="#EE1E1E1E"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="18"
                Padding="6,4">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Zoom Out (-) -->
                <Button x:Name="btnHudZoomOut" 
                        Width="28" Height="28" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="btnHudZoomOut_Click"
                        ToolTip="Thu nhỏ (Ctrl + Lăn chuột lùi)">
                    <TextBlock Text="−" FontSize="18" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Zoom Percent Badge (Click to reset 100%) -->
                <Button x:Name="btnHudZoomReset" 
                        Background="#2A2A2A" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Margin="4,0"
                        Padding="8,2"
                        Click="btnHudZoomReset_Click"
                        ToolTip="Mức phóng to hiện tại. Nhấn để về 100% (Ctrl+0)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="txtHudZoomPercent" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#2E86DE" VerticalAlignment="Center"/>
                </Button>

                <!-- Zoom In (+) -->
                <Button x:Name="btnHudZoomIn" 
                        Width="28" Height="28" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="btnHudZoomIn_Click"
                        ToolTip="Phóng to (Ctrl + Lăn chuột tới)">
                    <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Fit to Screen (⛶) -->
                <Button x:Name="btnHudZoomFit" 
                        Width="28" Height="28" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Margin="2,0,0,0"
                        Click="btnHudZoomFit_Click"
                        ToolTip="Vừa khung hình 100%">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#AAAAAA" Data="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Separator -->
                <Border Width="1" Height="16" Background="#444444" Margin="5,0"/>

                <!-- Touch Mode: Multi-touch (🖐) vs Single-touch Gesture (✌) -->
                <Button x:Name="btnHudTouchMode" 
                        Height="28" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Margin="2,0,0,0"
                        Padding="6,2"
                        Click="btnHudTouchMode_Click"
                        ToolTip="Chế độ cảm ứng: Đa chạm (Mặc định: nhiều ngón cùng viết vẽ). Nhấn để bật Cử chỉ 2 ngón (Pinch/Pan)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PART_TouchModeBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
