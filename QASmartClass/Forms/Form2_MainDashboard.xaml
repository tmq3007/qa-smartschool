                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Multi-User Dedicated Dual Board Overlay (Umind style) -->
        <controls:MultiUserBoardOverlay x:Name="multiUserOverlay"
                                        Visibility="Collapsed"
                                        Panel.ZIndex="4000"/>

        </Grid>

    </Grid>

</Window>

