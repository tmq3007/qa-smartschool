<Window x:Class="QASmartTouch.Forms.Form2_21_ShareLectureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chia sẻ bài giảng"
        Width="540" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Border Background="White" 
            CornerRadius="16" 
            BorderBrush="#E2E8F0" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="6" BlurRadius="24" Opacity="0.18"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content (QR Code + Actions) -->
                <RowDefinition Height="Auto"/> <!-- Footer / Close -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFF7ED" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                        <Path Fill="#EA580C" 
                              Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"
                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Chia sẻ bài giảng" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Chia sẻ nội dung bảng viết qua QR Code hoặc gửi tệp tin" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="btnCloseTop" 
                        Width="32" Height="32" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                        Click="btnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                <Path Fill="#64748B" 
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel>
                    <!-- THÔNG TIN BÀI GIẢNG -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="txtLectureName" Text="Bài giảng hiện tại" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtLectureStats" Text="Tổng cộng: 1 trang bảng • Định dạng QA SmartClass" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="badgeStatus" Background="#DCFCE7" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock x:Name="txtBadgeStatus" Text="Sẵn sàng chia sẻ" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KHU VỰC QR CODE -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#CBD5E1" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Khung chứa ảnh QR -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="2" CornerRadius="12" Padding="10" Background="#FAFAFA" HorizontalAlignment="Center">
                                <Image x:Name="imgQrCode" Width="170" Height="170" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <TextBlock Text="📱 Quét mã QR trên màn hình" 
                                       FontWeight="Bold" FontSize="13" Foreground="#1E293B" 
                                       HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="Học sinh dùng điện thoại hoặc máy tính bảng để nhận bài giảng" 
                                       FontSize="11" Foreground="#64748B" 
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- CÁC HÀNH ĐỘNG CHIA SẺ -->
                    <TextBlock Text="Phương thức chia sẻ khác" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nút Sao chép liên kết -->
                        <Button Grid.Column="0" x:Name="btnCopyLink" Height="44" Cursor="Hand" Click="btnCopyLink_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Fill="#2563EB" Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Sao chép link" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Gửi Email -->
                        <Button Grid.Column="2" x:Name="btnSendEmail" Height="44" Cursor="Hand" Click="btnSendEmail_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Fill="#475569" Data="M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4M20,8L12,13L4,8V6L12,11L20,6V8Z" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Gửi qua Email" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nút Xuất tệp ra USB / Thư mục -->
                        <Button Grid.Column="0" x:Name="btnSaveToUsb" Height="44" Cursor="Hand" Click="btnSaveToUsb_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Fill="#16A34A" Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Xuất tệp USB (.qasc)" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Xuất PDF / Bộ ảnh -->
                        <Button Grid.Column="2" x:Name="btnExportPdf" Height="44" Cursor="Hand" Click="btnExportPdf_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="10" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Fill="#DB2777" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H10.5V12H13.5V15H16L12,19Z" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Xuất PDF / Ảnh..." FontSize="12" FontWeight="SemiBold" Foreground="#BE185D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Thông báo phản hồi nhẹ khi bấm thao tác -->
                    <Border x:Name="panelToast" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtToastMessage" Text="Đã sao chép liên kết vào bộ nhớ tạm!" FontSize="11" Foreground="#15803D" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. FOOTER -->
            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Button x:Name="btnCancel" 
                        HorizontalAlignment="Right" 
                        Width="100" Height="36" 
                        Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                        Click="btnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock Text="Đóng" FontSize="13" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
