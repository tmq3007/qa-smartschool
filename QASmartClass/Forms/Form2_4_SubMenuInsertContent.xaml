<Window x:Class="QASmartTouch.Forms.Form2_4_SubMenuInsertContent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chèn nội dung" 
        Width="750" Height="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial, sans-serif">

    <Window.Resources>
        <!-- Sidebar Button Style (Touch Friendly IFP) -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="8,2,8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="0,8,8,0"
                                Padding="14,0">
                            <TextBlock x:Name="txtContent" 
                                       Text="{TemplateBinding Content}"
                                       FontSize="13.5"
                                       FontWeight="Medium"
                                       Foreground="#57606F"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F2F6"/>
                                <Setter TargetName="txtContent" Property="Foreground" Value="#2F3542"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E86DE"/>
                                <Setter TargetName="txtContent" Property="Foreground" Value="#1565C0"/>
                                <Setter TargetName="txtContent" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Matrix Preset Button Style -->
        <Style x:Key="MatrixPresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Matrix Action Link Style -->
        <Style x:Key="MatrixActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Content Button Style (Touch Friendly IFP) -->
        <Style x:Key="ContentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E86DE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BBDEFB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="50"/>  <!-- Header fixed height -->

                <RowDefinition Height="1"/>   <!-- Separator line -->

                <RowDefinition Height="*"/>   <!-- Content -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Grid Grid.Row="0" Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#2E86DE" 
                                  Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Chèn nội dung" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#2F3542"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnClose" 
                        Style="{StaticResource CloseButton}"
                        Click="btnClose_Click"/>
            </Grid>



            <!-- SEPARATOR -->

            <Border Grid.Row="1" Background="#E1E8ED"/>



            <!-- MAIN CONTENT -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="260"/> <!-- Sidebar (Tăng lên 260 để tránh cắt chữ) -->

                    <ColumnDefinition Width="*"/>   <!-- Content -->

                </Grid.ColumnDefinitions>



                <!-- SIDEBAR -->

                <Border Grid.Column="0" 

                        Background="#FAFBFC"

                        BorderBrush="#E1E8ED"

                        BorderThickness="0,0,1,0"

                        CornerRadius="0,0,0,14"

                        Padding="0,15,0,15">

                    <StackPanel>

                        <RadioButton x:Name="rbCategory1" 

                                    Content="Công cụ vẽ"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    IsChecked="True"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory2" 

                                    Content="Nội dung cơ bản"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory3" 

                                    Content="Biểu đồ &amp; Đồ thị"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory4" 

                                    Content="Môn học chuyên biệt"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory5" 

                                    Content="Công nghệ &amp; Tương tác"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <!-- TẠM ẨN: 4.6 AI & Trợ lý cho bản thử nghiệm nội bộ (bảo toàn code, không xóa) -->
                        <RadioButton x:Name="rbCategory6" 

                                    Content="AI &amp; Trợ lý"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Visibility="Collapsed"

                                    Checked="Category_Changed"/>

                    </StackPanel>

                </Border>



                <!-- CONTENT AREA -->

                <ScrollViewer Grid.Column="1" 

                             VerticalScrollBarVisibility="Auto"

                             PanningMode="Both"

                             PanningDeceleration="0.002"

                             Padding="20">

                    

                    <!-- Grid wrapper to hold all category panels -->

                    <Grid>

                    

                    <!-- 4.1 CÔNG CỤ VẼ -->

                    <StackPanel x:Name="pnlCategory1" Visibility="Visible">

                        <TextBlock Text="Công cụ vẽ" 

                                  FontSize="16" 

                                  FontWeight="Bold" 

                                  Foreground="#2F3542"

                                  Margin="0,0,0,15"/>

                        

                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertRuler_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#FF9800" 
                                      Data="M1.39,18.36L3.16,20.13L20.13,3.16L18.36,1.39L15.18,4.57L16.59,5.98L15.18,7.4L13.77,5.98L12.35,7.4L14.47,9.53L13.06,10.94L10.94,8.82L9.53,10.23L10.94,11.65L9.53,13.06L8.12,11.65L6.71,13.06L8.83,15.18L7.41,16.59L5.29,14.47L3.88,15.89L5.29,17.3L3.88,18.71L2.46,17.3L1.39,18.36Z"
                                      Width="24" Height="24"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Thước kẻ" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>
                                    <TextBlock Text="Thước đo chiều dài" FontSize="11" Foreground="#57606F"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertCompass_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#E91E63" 
                                      Data="M12,2A2,2 0 0,0 10,4C10,4.74 10.4,5.39 11,5.73V7.12L7.33,18H6V20H9V18H8.62L11,10.92V12H13V10.92L15.38,18H15V20H18V18H16.67L13,7.12V5.73C13.6,5.39 14,4.74 14,4A2,2 0 0,0 12,2M12,4A0.5,0.5 0 0,1 12.5,4.5A0.5,0.5 0 0,1 12,5A0.5,0.5 0 0,1 11.5,4.5A0.5,0.5 0 0,1 12,4Z"
                                      Width="24" Height="24"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Compa" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>
                                    <TextBlock Text="Vẽ hình tròn" FontSize="11" Foreground="#57606F"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertTriangle_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#4CAF50" 
                                      Data="M3,3V21H21L3,3M5,7.83L16.17,19H13V17H11V19H9V17H7V19H5V7.83M7,11V13H9V11H7M7,15V17H9V15H7Z"
                                      Width="24" Height="24"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Eke (Thước tam giác)" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>
                                    <TextBlock Text="Thước đo góc 45°/90°" FontSize="11" Foreground="#57606F"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertProtractor_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#9C27B0" 
                                      Data="M12,4C6.5,4 2,8.5 2,14H4A8,8 0 0,1 12,6A8,8 0 0,1 20,14H22C22,8.5 17.5,4 12,4M12,9A5,5 0 0,0 7,14H9A3,3 0 0,1 12,11A3,3 0 0,1 15,14H17A5,5 0 0,0 12,9M1,16V19C1,19.6 1.4,20 2,20H22C22.6,20 23,19.6 23,19V16H21V18H19V16H17V18H15V16H13V18H11V16H9V18H7V16H5V18H3V16H1Z"
                                      Width="24" Height="24"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Thước đo độ" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>
                                    <TextBlock Text="Đo góc 0-180°" FontSize="11" Foreground="#57606F"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>



                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertKeyboard_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#607D8B" 

                                     Data="M19,10H17V8H19M19,13H17V11H19M16,10H14V8H16M16,13H14V11H16M16,17H8V15H16M7,10H5V8H7M7,13H5V11H7M8,11H10V13H8M8,8H10V10H8M11,11H13V13H11M11,8H13V10H11M20,5H4C2.89,5 2,5.89 2,7V17A2,2 0 0,0 4,19H20A2,2 0 0,0 22,17V7C22,5.89 21.1,5 20,5Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Bàn phím ảo" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Bàn phím Windows" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>

                    </StackPanel>



                    <!-- 4.2 NỘI DUNG CƠ BẢN -->

                    <StackPanel x:Name="pnlCategory2" Visibility="Collapsed">

                        <TextBlock Text="Nội dung cơ bản" 

                                  FontSize="16" 

                                  FontWeight="Bold" 

                                  Foreground="#2F3542"

                                  Margin="0,0,0,15"/>

                        

                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertTextBox_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#2E86DE" 

                                     Data="M18.5,4L19.66,8.35L18.7,8.61C18.25,7.74 17.79,6.87 17.26,6.43C16.73,6 16.11,6 15.5,6H13V16.5C13,17 13,17.5 13.33,17.75C13.67,18 14.33,18 15,18V19H9V18C9.67,18 10.33,18 10.67,17.75C11,17.5 11,17 11,16.5V6H8.5C7.89,6 7.27,6 6.74,6.43C6.21,6.87 5.75,7.74 5.3,8.61L4.34,8.35L5.5,4H18.5Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Hộp văn bản" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Chèn chữ trực tiếp vào bảng vẽ" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>



                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertTable_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#9C27B0" 

                                     Data="M3,3H21V21H3V3M5,5V9H11V5H5M13,5V9H19V5H13M5,11V15H11V11H5M13,11V15H19V11H13M5,17V19H11V17H5M13,17V19H19V17H13Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Bảng" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Ma trận quét chọn &amp; kéo thả nhanh" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>

                        <!-- 4.2.1 PANEL CHỌN NHANH MA TRẬN BẢNG (Word/PowerPoint Matrix Style) -->
                        <Border x:Name="pnlTableQuickPicker"
                                Visibility="Collapsed"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Header & Close -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📊 Chọn cỡ bảng" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock x:Name="txtTableMatrixLabel" Text=" (3 hàng x 3 cột)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="btnCloseTableQuickPicker" Content="✕" Width="22" Height="22" 
                                            HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" 
                                            Foreground="#64748B" Cursor="Hand" FontWeight="Bold"
                                            Click="btnCloseTableQuickPicker_Click"/>
                                </Grid>

                                <!-- Interactive 8x6 Grid Matrix -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6" HorizontalAlignment="Left">
                                    <Grid x:Name="gridTableMatrix" 
                                          Background="Transparent">
                                    </Grid>
                                </Border>

                                <!-- Presets Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mẫu:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Content="2 x 2" Style="{StaticResource MatrixPresetButtonStyle}" Tag="2,2" Click="BtnTablePreset_Click"/>
                                    <Button Content="3 x 3" Style="{StaticResource MatrixPresetButtonStyle}" Tag="3,3" Click="BtnTablePreset_Click"/>
                                    <Button Content="4 x 3" Style="{StaticResource MatrixPresetButtonStyle}" Tag="4,3" Click="BtnTablePreset_Click"/>
                                    <Button Content="5 x 4" Style="{StaticResource MatrixPresetButtonStyle}" Tag="5,4" Click="BtnTablePreset_Click"/>
                                </StackPanel>

                                <!-- Action Buttons: Kéo vẽ & Nâng cao -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="btnTableDragToDraw" 
                                            Content="✏️ Kéo vẽ trực tiếp trên bảng" 
                                            Style="{StaticResource MatrixActionButtonStyle}"
                                            Click="BtnTableDragToDraw_Click"/>
                                    <Button x:Name="btnTableAdvanced" 
                                            Content="⚙️ Nâng cao..." 
                                            Style="{StaticResource MatrixActionButtonStyle}"
                                            Margin="8,0,0,0"
                                            Click="BtnTableAdvanced_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>



                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertImageFile_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#FF5722" 

                                     Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Hình ảnh" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Từ file máy tính" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>



                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertImageCamera_Click" Visibility="Collapsed">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#00BCD4" 

                                     Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Camera" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Chụp ảnh trực tiếp" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>



                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertVideo_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#F44336" 

                                     Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Video" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="MP4, AVI, WMV, MOV" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>


                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnInsertImageLibrary_Click" Visibility="Collapsed">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#673AB7" 

                                     Data="M22,16V4A2,2 0 0,0 20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16M11,12L13.03,14.71L16,11L20,16H8M2,6V20A2,2 0 0,0 4,22H18V20H4V6"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Thư viện ảnh" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Ảnh có sẵn" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>

                    </StackPanel>



                    <!-- 4.3 BIỂU ĐỒ &amp; ĐỒ THỊ -->

                    <StackPanel x:Name="pnlCategory3" Visibility="Collapsed">

                        <TextBlock Text="Biểu đồ &amp; Đồ thị" 

                                  FontSize="16" 

                                  FontWeight="Bold" 

                                  Foreground="#2F3542"

                                  Margin="0,0,0,15"/>

                        

                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnChartBar_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#2196F3" 

                                     Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Biểu đồ cột" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Bar Chart" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>



                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnChartLine_Click">

                            <StackPanel Orientation="Horizontal">

                                <Path Fill="#4CAF50" 

                                     Data="M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.46,19H22V21H2V3H4V17.54L9.5,8L16,11.78Z"

                                     Width="24" Height="24"

                                     Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Biểu đồ đường" FontSize="13" FontWeight="SemiBold" Foreground="#2F3542"/>

                                    <TextBlock Text="Line Chart" FontSize="11" Foreground="#57606F"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>



                        <Button Style="{StaticResource ContentButtonStyle}" Click="btnChartPie_Click">

