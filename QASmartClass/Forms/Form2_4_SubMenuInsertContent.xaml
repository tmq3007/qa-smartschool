<Window x:Class="QASmartTouch.Forms.Form2_4_SubMenuInsertContent"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="4. Chèn nội dung" 

        Width="750" Height="550"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize"

        Topmost="True"

        ShowInTaskbar="False">



    <Window.Resources>

        <!-- Sidebar Button Style -->

        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">

            <Setter Property="Height" Value="50"/>

            <Setter Property="Margin" Value="0,0,0,5"/>

            <Setter Property="Cursor" Value="Hand"/>

            <!-- QC_4.2_TOUCH_PIPELINE: Disable focus shift + press-and-hold for IFP touch -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="border"

                                Background="Transparent"

                                BorderBrush="Transparent"

                                BorderThickness="0,0,3,0"

                                Padding="15,0">

                            <TextBlock Text="{TemplateBinding Content}"

                                      FontSize="13"

                                      FontWeight="SemiBold"

                                      Foreground="#57606F"

                                      VerticalAlignment="Center"

                                      TextWrapping="Wrap"

                                      TextTrimming="CharacterEllipsis"

                                      MaxWidth="240"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#F8F9FA"/>

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#2E86DE"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Content Button Style -->

        <Style x:Key="ContentButtonStyle" TargetType="Button">

            <Setter Property="Height" Value="60"/>

            <Setter Property="Margin" Value="0,0,0,10"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="BorderBrush" Value="#E1E8ED"/>

            <Setter Property="Cursor" Value="Hand"/>

            <!-- QC_4.2_TOUCH_PIPELINE: Disable focus shift + press-and-hold for IFP touch -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="8"

                                Padding="15,10">

                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#F8F9FA"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#2196F3"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Border Background="White" 

            CornerRadius="15" 

            BorderBrush="#E1E8ED" 

            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#CCCCCC" 

                            Direction="270" 

                            ShadowDepth="3" 

                            BlurRadius="15" 

                            Opacity="0.3"/>

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="50"/>  <!-- Header fixed height -->

                <RowDefinition Height="1"/>   <!-- Separator line -->

                <RowDefinition Height="*"/>   <!-- Content -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Grid Grid.Row="0" Margin="15,0">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Path Fill="#2E86DE" 

                          Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"

                          Width="18" Height="18"

                          VerticalAlignment="Center"

                          Margin="0,0,8,0"/>

                    <TextBlock Text="4. Chèn nội dung" 

                              FontSize="16" 

                              FontWeight="Bold" 

                              Foreground="#2F3542"

                              VerticalAlignment="Center"/>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Style="{StaticResource CloseButton}"

                       Click="btnClose_Click"/>

            </Grid>



            <!-- SEPARATOR -->

            <Border Grid.Row="1" Background="#E1E8ED"/>



            <!-- MAIN CONTENT -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="260"/> <!-- Sidebar (Tăng lên 260 để tránh cắt chữ) -->

                    <ColumnDefinition Width="*"/>   <!-- Content -->

                </Grid.ColumnDefinitions>



                <!-- SIDEBAR -->

                <Border Grid.Column="0" 

                        Background="#FAFBFC"

                        BorderBrush="#E1E8ED"

                        BorderThickness="0,0,1,0"

                        Padding="0,15,0,15">

                    <StackPanel>

                        <RadioButton x:Name="rbCategory1" 

                                    Content="4.1 Công cụ vẽ"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    IsChecked="True"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory2" 

                                    Content="4.2 Nội dung cơ bản"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory3" 

                                    Content="4.3 Biểu đồ &amp; Đồ thị"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory4" 

                                    Content="4.4 Môn học chuyên biệt"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <RadioButton x:Name="rbCategory5" 

                                    Content="4.5 Công nghệ &amp; Tương tác"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Checked="Category_Changed"/>

                        <!-- TẠM ẨN: 4.6 AI & Trợ lý cho bản thử nghiệm nội bộ (bảo toàn code, không xóa) -->
                        <RadioButton x:Name="rbCategory6" 

                                    Content="4.6 AI &amp; Trợ lý"

                                    Style="{StaticResource SidebarButtonStyle}"

                                    Visibility="Collapsed"

                                    Checked="Category_Changed"/>

                    </StackPanel>

                </Border>



                <!-- CONTENT AREA -->

                <ScrollViewer Grid.Column="1" 

                             VerticalScrollBarVisibility="Auto"

                             Padding="20">

                    

                    <!-- Grid wrapper to hold all category panels -->

