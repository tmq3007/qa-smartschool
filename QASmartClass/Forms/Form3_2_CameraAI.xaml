<Window x:Class="QASmartTouch.Forms.Form3_2_CameraAI"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:controls="clr-namespace:QASmartTouch.Controls"

        Title="Camera AI - Quản lý camera và phân tích" 

        Width="1000" Height="680"

        WindowStartupLocation="CenterScreen"

        Background="#F5F7FA"

        ResizeMode="CanResize"

        MinWidth="900" MinHeight="600">



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="70"/>

            <!-- Header -->

            <RowDefinition Height="*"/>

            <!-- Content -->

        </Grid.RowDefinitions>



        <!-- HEADER -->

        <Border Grid.Row="0" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">

            <Grid Margin="25,0">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Path Fill="#E91E63" 

                          Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"

                          Width="32" Height="32"

                          Margin="0,0,15,0"/>

                    <StackPanel>

                        <TextBlock Text="Camera AI" 

                                  FontSize="24" 

                                  FontWeight="Bold" 

                                  Foreground="#2F3542"/>

                        <TextBlock Text="Phát sóng camera tài liệu và lớp học với phân tích AI" 

                                  FontSize="12" 

                                  Foreground="#57606F"

                                  Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>

                <Button x:Name="btnClose" 

                       Width="40" Height="40"

                       HorizontalAlignment="Right"

                       Background="#FEE2E2"

                       BorderThickness="0"

                       Cursor="Hand"

                       Click="btnClose_Click">

                    <Path Fill="#EE5A6F" 

                         Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                         Width="18" Height="18"/>

                </Button>

            </Grid>

        </Border>



        <!-- CONTENT -->

        <Grid Grid.Row="1" Margin="25,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="340"/>

            </Grid.ColumnDefinitions>



            <!-- LEFT: Camera Feeds -->

            <Grid Grid.Column="0" Margin="0,0,15,0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="15"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <!-- Document Camera -->

                <Border Grid.Row="0" Background="White" CornerRadius="12" 

                       BorderBrush="#E1E8ED" BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="40"/>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="50"/>

                        </Grid.RowDefinitions>



                        <!-- Header -->

                        <Border Grid.Row="0" Background="#2E86DE" CornerRadius="12,12,0,0" Padding="15,0">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <Path Fill="White" Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z" Width="16" Height="16" Margin="0,0,8,0"/>

                                <TextBlock Text="Camera tài liệu (Document Camera)" FontSize="13" FontWeight="SemiBold" Foreground="White"/>

                                <Border Background="#4CAF50" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">

                                    <TextBlock Text="LIVE" FontSize="10" Foreground="White" FontWeight="Bold"/>

                                </Border>

                            </StackPanel>

                        </Border>



                        <!-- Video Feed -->

                        <Border Grid.Row="1" Margin="10">

                            <Grid>

                                <!-- Camera Preview Control -->

                                <controls:CameraPreviewControl x:Name="docCameraPreview"/>

                                

                                <!-- AI Overlays -->

                                <Canvas x:Name="canvasDocumentOverlay" IsHitTestVisible="False"/>

                            </Grid>

                        </Border>



                        <!-- Controls -->

                        <Border Grid.Row="2" Background="#F1F2F6" CornerRadius="0,0,12,12" Padding="10">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button x:Name="btnDocSnapshot" Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Chụp ảnh"

                                       Click="btnDocSnapshot_Click">

                                    <Path Fill="#2E86DE" Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" Width="20" Height="20"/>

                                </Button>

                                <Button x:Name="btnDocRecord" Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Quay video"

                                       Click="btnDocRecord_Click">

                                    <Path Fill="#F44336" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z" Width="20" Height="20"/>

                                </Button>

                                <Button Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Xoay"

                                       Click="btnDocRotate_Click">

                                    <Path Fill="#57606F" Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z" Width="20" Height="20"/>

                                </Button>

                                <Button Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Lật ngang"

                                       Click="btnDocFlip_Click">

                                    <Path Fill="#57606F" Data="M15.5,12L9,18.5L10.5,20L18,12.5L10.5,5L9,6.5L15.5,12M8.5,12L2,18.5L3.5,20L11,12.5L3.5,5L2,6.5L8.5,12Z" Width="20" Height="20"/>

                                </Button>

                                <Button Width="40" Height="40"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Zoom"

                                       Click="btnDocZoom_Click">

                                    <Path Fill="#57606F" Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Width="20" Height="20"/>

                                </Button>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>



                <!-- Student Camera -->

                <Border Grid.Row="2" Background="White" CornerRadius="12" 

                       BorderBrush="#E1E8ED" BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="40"/>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="50"/>

                        </Grid.RowDefinitions>



                        <!-- Header -->

                        <Border Grid.Row="0" Background="#4CAF50" CornerRadius="12,12,0,0" Padding="15,0">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <Path Fill="White" Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z" Width="18" Height="18" Margin="0,0,8,0"/>

                                <TextBlock Text="Camera học sinh (Student Camera)" FontSize="13" FontWeight="SemiBold" Foreground="White"/>

                                <Border Background="#FF9800" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">

                                    <TextBlock Text="AI" FontSize="10" Foreground="White" FontWeight="Bold"/>

                                </Border>

                            </StackPanel>

                        </Border>



                        <!-- Video Feed -->

                        <Border Grid.Row="1" Margin="10">

                            <Grid>

                                <!-- Camera Preview Control -->

                                <controls:CameraPreviewControl x:Name="studentCameraPreview"/>

                                

                                <!-- AI Face Detection Overlays -->

                                <Canvas x:Name="canvasStudentOverlay" IsHitTestVisible="False">

                                    <!-- Sample face detection boxes (will be drawn dynamically) -->

                                </Canvas>

                            </Grid>

                        </Border>



                        <!-- Controls -->

                        <Border Grid.Row="2" Background="#F1F2F6" CornerRadius="0,0,12,12" Padding="10">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Chụp ảnh"

                                       Click="btnStudentSnapshot_Click">

                                    <Path Fill="#4CAF50" Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" Width="20" Height="20"/>

                                </Button>

                                <Button x:Name="btnStudentRecord" Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Quay video"

                                       Click="btnStudentRecord_Click">

                                    <Path Fill="#F44336" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z" Width="20" Height="20"/>

                                </Button>

                                <Button Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Phát hiện khuôn mặt"

                                       Click="btnFaceDetection_Click">

                                    <Path Fill="#E91E63" Data="M9,11.75A1.25,1.25 0 0,0 7.75,13A1.25,1.25 0 0,0 9,14.25A1.25,1.25 0 0,0 10.25,13A1.25,1.25 0 0,0 9,11.75M15,11.75A1.25,1.25 0 0,0 13.75,13A1.25,1.25 0 0,0 15,14.25A1.25,1.25 0 0,0 16.25,13A1.25,1.25 0 0,0 15,11.75M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,11.71 4,11.42 4.05,11.14C6.41,10.09 8.28,8.16 9.26,5.77C11.07,8.33 14.05,10 17.42,10C18.2,10 18.95,9.91 19.67,9.74C19.88,10.45 20,11.21 20,12C20,16.41 16.41,20 12,20Z" Width="20" Height="20"/>

                                </Button>

                                <Button Width="40" Height="40" Margin="0,0,5,0"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Điểm danh tự động"

                                       Click="btnAttendance_Click">

                                    <Path Fill="#FF9800" Data="M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z" Width="20" Height="20"/>

                                </Button>

                                <Button Width="40" Height="40"

                                       Background="White" BorderThickness="0" Cursor="Hand" ToolTip="Cài đặt"

                                       Click="btnCameraSettings_Click">

                                    <Path Fill="#57606F" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Width="20" Height="20"/>

                                </Button>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

            </Grid>



            <!-- RIGHT: AI Analysis Panel -->

            <Border Grid.Column="1" Background="White" CornerRadius="12" 

                   BorderBrush="#E1E8ED" BorderThickness="1">

                <Grid>

                    <TabControl x:Name="tabAI" BorderThickness="0" Background="Transparent">

                        <!-- Tab 1: Attendance -->

                        <TabItem Header="✅ Điểm danh" FontSize="12">

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Danh sách học sinh" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                    

                                    <!-- Dynamic Student List -->

                                    <ItemsControl x:Name="lstStudents">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Border Background="{Binding BackgroundBrush}" 

                                                        BorderBrush="{Binding BorderBrush}" 

                                                        BorderThickness="2" 

                                                        CornerRadius="8" 

                                                        Padding="10" 

                                                        Margin="0,0,0,8">

                                                    <Grid>

                                                        <StackPanel Orientation="Horizontal">

                                                            <Border Background="{Binding AvatarBrush}" Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0">

                                                                <TextBlock Text="{Binding AvatarText}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>

                                                            </Border>

                                                            <StackPanel VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="#2F3542"/>

                                                                <StackPanel Orientation="Horizontal">

                                                                    <TextBlock Text="{Binding DisplayCode}" FontSize="10" Foreground="#57606F"/>

                                                                    <TextBlock Text="{Binding DisplayConfidence}" FontSize="10" Foreground="#FF9800" Margin="10,0,0,0" FontWeight="Bold"/>

                                                                </StackPanel>

                                                            </StackPanel>

                                                        </StackPanel>

                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                    </Grid>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>



                                    <!-- Action Buttons -->

                                    <Grid Margin="0,10,0,0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="10"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" x:Name="btnConfirmAIAttendance" Content="🤖 Xác nhận điểm danh AI" Height="35"

                                                Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"

                                                Click="btnConfirmAIAttendance_Click"/>

                                        <Button Grid.Column="2" Content="📊 Xuất danh sách" Height="35"

                                                Background="#2E86DE" Foreground="White" BorderThickness="0" Cursor="Hand"

                                                Click="btnExportAttendance_Click"/>

                                    </Grid>



                                </StackPanel>

                            </ScrollViewer>

                        </TabItem>



                        <!-- Tab 2: Engagement -->

                        <TabItem Header="📊 Tương tác" FontSize="12">

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Mức độ tương tác" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                    

                                    <!-- Attention Score -->

                                    <Border Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,10">

                                        <StackPanel>

                                            <TextBlock Text="Điểm chú ý" FontSize="12" Foreground="#1976D2" Margin="0,0,0,5"/>

                                            <TextBlock Text="85/100" FontSize="32" FontWeight="Bold" Foreground="#1976D2"/>

                                            <ProgressBar Value="85" Maximum="100" Height="8" Margin="0,5,0,0"/>

                                        </StackPanel>

                                    </Border>



                                    <!-- Participation Rate -->

                                    <Border Background="#F1F8E9" CornerRadius="8" Padding="15" Margin="0,0,0,10">

                                        <StackPanel>

                                            <TextBlock Text="Tỷ lệ tham gia" FontSize="12" Foreground="#689F38" Margin="0,0,0,5"/>

                                            <TextBlock Text="72%" FontSize="32" FontWeight="Bold" Foreground="#689F38"/>

                                            <ProgressBar Value="72" Maximum="100" Height="8" Margin="0,5,0,0"/>

                                        </StackPanel>

                                    </Border>



                                    <!-- Question Count -->

                                    <Border Background="#FFF3E0" CornerRadius="8" Padding="15" Margin="0,0,0,10">

                                        <StackPanel>

                                            <TextBlock Text="Số câu hỏi" FontSize="12" Foreground="#F57C00" Margin="0,0,0,5"/>

                                            <TextBlock Text="12 câu" FontSize="24" FontWeight="Bold" Foreground="#F57C00"/>

                                        </StackPanel>

                                    </Border>



                                    <!-- Chart Placeholder -->

                                    <TextBlock Text="Biểu đồ theo thời gian" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,5"/>

                                    <Border Background="#F1F2F6" Height="120" CornerRadius="8">

                                        <TextBlock Text="Chart: Attention over time" FontSize="12" Foreground="#57606F" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                </StackPanel>

                            </ScrollViewer>

                        </TabItem>



                        <!-- Tab 3: Emotion -->

                        <TabItem Header="😊 Cảm xúc" FontSize="12">

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Phân tích cảm xúc" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                    

                                    <!-- Emotion Stats -->

                                    <Border Background="#E8F5E9" CornerRadius="8" Padding="10" Margin="0,0,0,8">

                                        <Grid>

                                            <TextBlock Text="Vui vẻ" FontSize="12" VerticalAlignment="Center"/>

                                            <TextBlock Text="45%" FontSize="12" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>



                                    <Border Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,0,8">

                                        <Grid>

                                            <TextBlock Text="Bình thường" FontSize="12" VerticalAlignment="Center"/>

                                            <TextBlock Text="30%" FontSize="12" FontWeight="Bold" Foreground="#9E9E9E" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>



                                    <Border Background="#FFF3E0" CornerRadius="8" Padding="10" Margin="0,0,0,8">

                                        <Grid>

                                            <TextBlock Text="Bối rối" FontSize="12" VerticalAlignment="Center"/>

                                            <TextBlock Text="15%" FontSize="12" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>



                                    <Border Background="#FFEBEE" CornerRadius="8" Padding="10" Margin="0,0,0,8">

                                        <Grid>

                                            <TextBlock Text="Buồn ngủ" FontSize="12" VerticalAlignment="Center"/>

                                            <TextBlock Text="7%" FontSize="12" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>



                                    <Border Background="#FCE4EC" CornerRadius="8" Padding="10" Margin="0,0,0,15">

                                        <Grid>

                                            <TextBlock Text="Thất vọng" FontSize="12" VerticalAlignment="Center"/>

                                            <TextBlock Text="3%" FontSize="12" FontWeight="Bold" Foreground="#E91E63" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>



                                    <!-- Pie Chart Placeholder -->

                                    <TextBlock Text="Biểu đồ tròn" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>

                                    <Border Background="#F1F2F6" Height="150" CornerRadius="8">

                                        <Viewbox Width="100" Height="100">

                                            <TextBlock Text="🥧" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Viewbox>

                                    </Border>

                                </StackPanel>

                            </ScrollViewer>

                        </TabItem>



                        <!-- Tab 4: Settings -->

                        <TabItem Header="⚙️ Cài đặt" FontSize="12">

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Cài đặt Camera" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                    

                                    <TextBlock Text="Camera tài liệu:" FontSize="11" Foreground="#57606F" Margin="0,0,0,5"/>

