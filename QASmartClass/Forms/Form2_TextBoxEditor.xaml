<Window x:Class="QASmartTouch.Forms.Form2_TextBoxEditor"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:controls="clr-namespace:QASmartTouch.Controls"

        Title="Chèn Hộp Văn Bản"

        Width="700" Height="600"

        WindowStartupLocation="CenterScreen"

        ResizeMode="CanResize"

        Background="#F5F6FA">

    

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/> <!-- Header -->

            <RowDefinition Height="Auto"/> <!-- Templates -->

            <RowDefinition Height="*"/>    <!-- Editor -->

            <RowDefinition Height="Auto"/> <!-- Footer -->

        </Grid.RowDefinitions>

        

        <!-- Header -->

        <Border Grid.Row="0" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">

            <Grid Margin="20,15">

                <StackPanel>

                    <TextBlock Text="Chèn Hộp Văn Bản" 

                             FontSize="20" 

                             FontWeight="Bold" 

                             Foreground="#2F3542"/>

                    <TextBlock Text="Chọn mẫu có sẵn hoặc tạo hộp văn bản tùy chỉnh" 

                             FontSize="13" 

                             Foreground="#57606F"

                             Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        

        <!-- Template Selection -->

        <Border Grid.Row="1" Background="White" Padding="20,15" 

                BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">

            <StackPanel>

                <TextBlock Text="Chọn mẫu:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                

                <WrapPanel>

                    <!-- Note Template -->

                    <Button x:Name="btnNoteTemplate" 

                            Width="120" Height="80" Margin="0,0,10,10"

                            Click="NoteTemplate_Click"

                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate>

                                <Border Background="#FFFBE6" 

                                        BorderBrush="#FFC107" 

                                        BorderThickness="2"

                                        CornerRadius="8"

                                        Padding="10">

                                    <StackPanel>

                                        <TextBlock Text="📌" FontSize="28" 

                                                 HorizontalAlignment="Center"/>

                                        <TextBlock Text="Ghi chú" 

                                                 FontSize="13" 

                                                 FontWeight="SemiBold"

                                                 HorizontalAlignment="Center"

                                                 Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    

                    <!-- Warning Template -->

                    <Button x:Name="btnWarningTemplate" 

                            Width="120" Height="80" Margin="0,0,10,10"

                            Click="WarningTemplate_Click"

                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate>

                                <Border Background="#FFEBEE" 

                                        BorderBrush="#F44336" 

                                        BorderThickness="3"

                                        CornerRadius="8"

                                        Padding="10">

                                    <StackPanel>

                                        <TextBlock Text="⚠️" FontSize="28" 

                                                 HorizontalAlignment="Center"/>

                                        <TextBlock Text="Cảnh báo" 

                                                 FontSize="13" 

                                                 FontWeight="SemiBold"

                                                 HorizontalAlignment="Center"

                                                 Foreground="#B71C1C"

                                                 Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    

                    <!-- Tip Template -->

                    <Button x:Name="btnTipTemplate" 

                            Width="120" Height="80" Margin="0,0,10,10"

                            Click="TipTemplate_Click"

                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate>

                                <Border Background="#E3F2FD" 

                                        BorderBrush="#2196F3" 

                                        BorderThickness="2"

                                        CornerRadius="8"

                                        Padding="10">

                                    <StackPanel>

                                        <TextBlock Text="💡" FontSize="28" 

                                                 HorizontalAlignment="Center"/>

                                        <TextBlock Text="Mẹo" 

                                                 FontSize="13" 

                                                 FontWeight="SemiBold"

                                                 HorizontalAlignment="Center"

                                                 Foreground="#0D47A1"

                                                 Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    

                    <!-- Conclusion Template -->

                    <Button x:Name="btnConclusionTemplate" 

                            Width="120" Height="80" Margin="0,0,10,10"

                            Click="ConclusionTemplate_Click"

                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate>

                                <Border Background="#E8F5E9" 

                                        BorderBrush="#4CAF50" 

                                        BorderThickness="3"

                                        CornerRadius="8"

                                        Padding="10">

                                    <StackPanel>

                                        <TextBlock Text="✅" FontSize="28" 

                                                 HorizontalAlignment="Center"/>

                                        <TextBlock Text="Kết luận" 

                                                 FontSize="13" 

                                                 FontWeight="SemiBold"

                                                 HorizontalAlignment="Center"

                                                 Foreground="#1B5E20"

                                                 Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    

                    <!-- Definition Template -->

                    <Button x:Name="btnDefinitionTemplate" 

                            Width="120" Height="80" Margin="0,0,10,10"

                            Click="DefinitionTemplate_Click"

                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate>

                                <Border Background="White" 

                                        BorderBrush="#607D8B" 

                                        BorderThickness="3"

                                        CornerRadius="8"

                                        Padding="10">

                                    <StackPanel>

                                        <TextBlock Text="📖" FontSize="28" 

                                                 HorizontalAlignment="Center"/>

                                        <TextBlock Text="Định nghĩa" 

                                                 FontSize="13" 

                                                 FontWeight="SemiBold"

                                                 HorizontalAlignment="Center"

                                                 Foreground="#263238"

                                                 Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    

                    <!-- Custom Template -->

                    <Button x:Name="btnCustomTemplate" 

                            Width="120" Height="80" Margin="0,0,10,10"

                            Click="CustomTemplate_Click"

                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate>

                                <Border Background="White" 

                                        BorderBrush="#2E86DE" 

                                        BorderThickness="2"

                                        CornerRadius="8"

                                        Padding="10">

                                    <StackPanel>

                                        <TextBlock Text="✏️" FontSize="28" 

                                                 HorizontalAlignment="Center"/>

                                        <TextBlock Text="Tùy chỉnh" 

                                                 FontSize="13" 

                                                 FontWeight="SemiBold"

                                                 HorizontalAlignment="Center"

                                                 Foreground="#2E86DE"

                                                 Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </WrapPanel>

            </StackPanel>

        </Border>

        

        <!-- Editor -->

        <Border Grid.Row="2" Background="White" Padding="20">

            <controls:RichTextBoxControl x:Name="textBoxEditor"

                                        MinHeight="200"/>

        </Border>

        

        <!-- Footer Buttons -->

        <Border Grid.Row="3" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal" 

                       HorizontalAlignment="Right" 

                       Margin="20,15">

                

                <!-- Cancel Button -->

                <Button x:Name="btnCancel" 

                       Content="Hủy" 

                       Width="100" Height="36"

                       Margin="0,0,10,0"

                       Click="Cancel_Click"

                       Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#F1F2F6" 
                                   CornerRadius="6"
                                   BorderBrush="#DFE4EA"
                                   BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E2E4EB"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#CBD0D9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                

                <!-- Insert Button -->

                <Button x:Name="btnInsert" 

                       Content="Chèn vào bảng" 

                       Width="130" Height="36"

                       Click="Insert_Click"

                       Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#2E86DE" 
                                   CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1F70C5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Foreground" Value="White"/>

                            <Setter Property="FontWeight" Value="SemiBold"/>

                        </Style>

                    </Button.Style>

                </Button>

            </StackPanel>

        </Border>

        

    </Grid>

</Window>

