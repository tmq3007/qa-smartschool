<Window x:Class="QASmartTouch.Forms.Form3_3_Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt ứng dụng" 
        Width="850" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        ResizeMode="CanResize"
        MinWidth="750" MinHeight="550"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="70"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Fill="#2196F3" 
                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Width="28" Height="28"
                          Margin="0,0,12,0"/>
                    <TextBlock Text="Cài đặt ứng dụng" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#2F3542"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <TabControl Grid.Row="1" 
                    Margin="20"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" 
                                        Background="White" 
                                        CornerRadius="10,10,0,0"
                                        Padding="20,12"
                                        Margin="0,0,4,0"
                                        BorderBrush="#E1E8ED"
                                        BorderThickness="1,1,1,0">
                                    <TextBlock Text="{TemplateBinding Header}" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#57606F"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2E86DE"/>
                                        <Setter TargetName="Border" Property="TextBlock.Foreground" Value="White"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#2E86DE"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#F1F2F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: GENERAL -->
            <TabItem Header="Chung">
                <Border Background="White" CornerRadius="0,10,10,10" Padding="30" BorderBrush="#E1E8ED" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Ngôn ngữ" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbLanguage" Height="40" FontSize="13" Margin="0,0,0,20" SelectedIndex="0">
                                <ComboBoxItem Content="Tiếng Việt"/>
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="日本語"/>
                                <ComboBoxItem Content="한국어"/>
                                <ComboBoxItem Content="中文"/>
                            </ComboBox>

                            <TextBlock Text="Tự động lưu" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <CheckBox x:Name="chkAutoSave" Content="Tự động lưu bài giảng mỗi" FontSize="13" Margin="0,0,0,10" IsChecked="True"/>
                            <StackPanel Orientation="Horizontal" Margin="25,0,0,20">
                                <TextBox x:Name="txtAutoSaveInterval" Width="60" Height="35" Text="5" FontSize="13" VerticalContentAlignment="Center" InputScope="Number" PreviewTextInput="NumericTextBox_PreviewTextInput" GotFocus="TextBox_GotFocus"/>
                                <TextBlock Text="phút" FontSize="13" Foreground="#57606F" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="Khởi động" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <CheckBox x:Name="chkStartWithWindows" Content="Khởi động cùng Windows" FontSize="13" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkRestoreLastSession" Content="Khôi phục phiên làm việc cuối" FontSize="13" Margin="0,0,0,20" IsChecked="True"/>

                            <TextBlock Text="Hiệu suất" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Chất lượng đồ họa 3D:" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cboGraphicsQuality" Width="180" Height="30" FontSize="13" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Tự động (Khuyên dùng)" Tag="Auto"/>
                                    <ComboBoxItem Content="Thấp (Low Quality)" Tag="Low"/>
                                    <ComboBoxItem Content="Trung bình (Medium)" Tag="Medium"/>
                                    <ComboBoxItem Content="Cao (High Quality)" Tag="High"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="chkHardwareAcceleration" Content="Sử dụng tăng tốc phần cứng (Yêu cầu khởi động lại)" FontSize="13" Margin="0,0,0,10" IsChecked="True"/>
                            <CheckBox x:Name="chkReduceAnimations" Content="Giảm hiệu ứng animation" FontSize="13" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkAutoOptimizeForIntegratedGraphics" Content="Tự động tối ưu hóa đồ họa cho card tích hợp" FontSize="13" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkDisable3DAntiAliasing" Content="Tắt hiệu ứng khử răng cưa 3D (Anti-aliasing)" FontSize="13" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkReduce3DMeshResolution" Content="Giảm độ chi tiết lưới đa giác 3D (Mesh grid)" FontSize="13" Margin="0,0,0,10"/>

                            <TextBlock Text="Cập nhật" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <CheckBox x:Name="chkAutoUpdate" Content="Tự động kiểm tra cập nhật" FontSize="13" Margin="0,0,0,10" IsChecked="True"/>
                            <Button x:Name="btnCheckUpdate" Content="Kiểm tra ngay" Height="40" Width="150" HorizontalAlignment="Left" 
                                   Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                   Click="btnCheckUpdate_Click" Margin="0,0,0,20"/>

                            <TextBlock Text="Định danh Trường học" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <TextBlock Text="Mã định danh trường (Bộ GD&amp;ĐT):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtSchoolCode" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12" GotFocus="TextBox_GotFocus"/>
                            <TextBlock Text="Tên trường học:" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtSchoolName" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,20" GotFocus="TextBox_GotFocus"/>

                            <TextBlock Text="Bảo mật ứng dụng" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <CheckBox x:Name="chkEnableAdminLock" Content="Yêu cầu mật khẩu khi mở Cài đặt" FontSize="13" Margin="0,0,0,10"/>
                            <TextBlock Text="Mật khẩu quản trị mới (nhập để thay đổi):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="pbAdminPassword" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                            <TextBlock Text="Cấu hình Máy chủ kết nối" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <TextBlock Text="Địa chỉ URL máy chủ (Server URL):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtServerUrl" Grid.Column="0" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0" GotFocus="TextBox_GotFocus"/>
                                <Button x:Name="btnTestConnection" Grid.Column="1" Content="Kiểm tra kết nối" Width="130" Height="40" Background="Transparent" Foreground="#2F3542" BorderBrush="#C4D0D9" BorderThickness="1" Cursor="Hand" Click="btnTestConnection_Click"/>
                            </Grid>
                            <TextBlock Text="Chu kỳ gửi tín hiệu (Heartbeat - giây):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtHeartbeatInterval" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10" InputScope="Number" PreviewTextInput="NumericTextBox_PreviewTextInput" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 2: PERSONALIZATION -->
            <TabItem Header="Giao diện">
                <Border Background="White" CornerRadius="0,10,10,10" Padding="30" BorderBrush="#E1E8ED" BorderThickness="1">
                    <Border.Resources>
                        <Style x:Key="AccentColorButtonStyle" TargetType="Button">
                            <Setter Property="Width" Value="50"/>
                            <Setter Property="Height" Value="50"/>
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                BorderBrush="{TemplateBinding BorderBrush}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Chủ đề" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,12"/>
                            <UniformGrid Columns="3" Rows="1">
                                <RadioButton x:Name="rbThemeLight" GroupName="Theme" Content="Sáng" FontSize="13" Margin="0,0,10,0" IsChecked="True"/>
                                <RadioButton x:Name="rbThemeDark" GroupName="Theme" Content="Tối" FontSize="13" Margin="0,0,10,0"/>
                                <RadioButton x:Name="rbThemeAuto" GroupName="Theme" Content="Tự động" FontSize="13"/>
                            </UniformGrid>

                            <TextBlock Text="Màu chủ đạo" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,20,0,12"/>
                             <WrapPanel x:Name="wpAccentColors">
                                <Button Style="{StaticResource AccentColorButtonStyle}" Background="#2E86DE" BorderThickness="2" BorderBrush="#2E86DE" Click="btnAccentColor_Click" Tag="#2E86DE" ToolTip="Màu xanh dương sư phạm"/>
                                <Button Style="{StaticResource AccentColorButtonStyle}" Background="#4CAF50" BorderThickness="0" Click="btnAccentColor_Click" Tag="#4CAF50" ToolTip="Màu xanh lá trường học"/>
                                <Button Style="{StaticResource AccentColorButtonStyle}" Background="#FF9800" BorderThickness="0" Click="btnAccentColor_Click" Tag="#FF9800" ToolTip="Màu cam cảnh báo"/>
                                <Button Style="{StaticResource AccentColorButtonStyle}" Background="#E91E63" BorderThickness="0" Click="btnAccentColor_Click" Tag="#E91E63" ToolTip="Màu hồng sáng tạo"/>
                                <Button Style="{StaticResource AccentColorButtonStyle}" Background="#9C27B0" BorderThickness="0" Click="btnAccentColor_Click" Tag="#9C27B0" ToolTip="Màu tím học đường"/>
                                <Button Style="{StaticResource AccentColorButtonStyle}" Background="#00BCD4" BorderThickness="0" Click="btnAccentColor_Click" Tag="#00BCD4" ToolTip="Màu xanh ngọc dịu nhẹ"/>
                            </WrapPanel>

                            <TextBlock Text="Toolbar" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,20,0,8"/>
                            <ComboBox x:Name="cmbToolbarPosition" Height="40" FontSize="13" Margin="0,0,0,12" SelectedIndex="0">
                                <ComboBoxItem Content="Dưới cùng (Bottom)"/>
                                <ComboBoxItem Content="Trên cùng (Top)"/>
                                <ComboBoxItem Content="Bên trái (Left)"/>
                                <ComboBoxItem Content="Bên phải (Right)"/>
                            </ComboBox>
                            <CheckBox x:Name="chkShowToolbarLabels" Content="Hiển thị nhãn công cụ" FontSize="13" Margin="0,0,0,10" IsChecked="True"/>
                            <CheckBox x:Name="chkCompactToolbar" Content="Chế độ thu gọn" FontSize="13" Margin="0,0,0,20"/>

                            <TextBlock Text="Canvas" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <TextBlock Text="Nền mặc định:" FontSize="13" Foreground="#57606F" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbDefaultBackground" Height="40" FontSize="13" Margin="0,0,0,12" SelectedIndex="0">
                                <ComboBoxItem Content="Trắng"/>
                                <ComboBoxItem Content="Lưới ô ly"/>
                                <ComboBoxItem Content="Kẻ ngang"/>
                                <ComboBoxItem Content="Đen (night mode)"/>
                            </ComboBox>
                            <CheckBox x:Name="chkShowGrid" Content="Hiển thị lưới" FontSize="13" Margin="0,0,0,10" IsChecked="True"/>
                            <CheckBox x:Name="chkShowRuler" Content="Hiển thị thước đo" FontSize="13" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 3: STORAGE -->
            <TabItem Header="Lưu trữ">
                <Border Background="White" CornerRadius="0,10,10,10" Padding="30" BorderBrush="#E1E8ED" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Thư mục lưu trữ" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtStoragePath" Grid.Column="0" Height="40" FontSize="13" 
                                        Text="C:\Users\Documents\QASmartTouch" VerticalContentAlignment="Center" Margin="0,0,10,0" GotFocus="TextBox_GotFocus"/>
                                <Button Grid.Column="1" Content="Chọn..." Width="80" Height="40" 
                                       Background="#2E86DE" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                                       Click="btnBrowseStorage_Click"/>
                                <Button x:Name="btnOpenStorageDir" Grid.Column="2" Content="📁 Mở" Width="80" Height="40" 
                                       Background="#757575" Foreground="White" BorderThickness="0" Cursor="Hand"
                                       Click="btnOpenStorageDir_Click" ToolTip="Mở thư mục trên File Explorer"/>
                            </Grid>

                            <TextBlock Text="Dung lượng" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,12"/>
                            <Border Background="#F8F9FA" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Đã sử dụng" FontSize="12" Foreground="#57606F"/>
                                        <TextBlock Text="2.4 GB / 50 GB" FontSize="12" Foreground="#2F3542" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar Height="12" Value="4.8" Maximum="100" Foreground="#4CAF50"/>
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock FontSize="13" Foreground="#57606F">
                                            <Run Text="Bài giảng: 1.8 GB"/>
                                            <LineBreak/>
                                            <Run Text="🖼️ Hình ảnh: 450 MB"/>
                                            <LineBreak/>
                                            <Run Text="Video: 150 MB"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Dọn dẹp" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <Button x:Name="btnClearCache" Content="Xóa cache (120 MB)" Height="40" Width="200" HorizontalAlignment="Left" 
                                   Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"
                                   Click="btnClearCache_Click"/>
                            <Button x:Name="btnClearTemp" Content="Xóa tệp tạm (85 MB)" Height="40" Width="200" HorizontalAlignment="Left" 
                                   Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,20"
                                   Click="btnClearTemp_Click"/>

                            <TextBlock Text="Cloud Storage" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <CheckBox x:Name="chkEnableCloud" Content="Kích hoạt đồng bộ Cloud" FontSize="13" Margin="0,0,0,12"/>
                            <TextBlock Text="Tài khoản:" FontSize="13" Foreground="#57606F" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtCloudAccount" Height="40" FontSize="13" Text="user@example.com" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                            <Button x:Name="btnConnectCloud" Content="Kết nối Cloud" Height="40" Width="150" HorizontalAlignment="Left" 
                                   Background="#00BCD4" Foreground="White" BorderThickness="0" Cursor="Hand"
                                   Click="btnConnectCloud_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 4: LICENSE -->
            <TabItem Header="Bản quyền">
                <Border Background="White" CornerRadius="0,10,10,10" Padding="30" BorderBrush="#E1E8ED" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Thông tin bản quyền (Offline License)" FontSize="16" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,15"/>
                            
                            <!-- Bảng thông tin License -->
                            <Border Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Trạng thái:" FontWeight="SemiBold" Foreground="#57606F" VerticalAlignment="Center" Margin="0,6"/>
                                    <TextBlock x:Name="txtLicStatusInfo" Grid.Row="0" Grid.Column="1" Text="Đang tải..." FontWeight="Bold" Foreground="#2F3542" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Khách hàng/Trường:" FontWeight="SemiBold" Foreground="#57606F" VerticalAlignment="Center" Margin="0,6"/>
                                    <TextBlock x:Name="txtLicSchool" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#2F3542" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gói dịch vụ:" FontWeight="SemiBold" Foreground="#57606F" VerticalAlignment="Center" Margin="0,6"/>
                                    <TextBlock x:Name="txtLicType" Grid.Row="2" Grid.Column="1" Text="-" Foreground="#2F3542" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ngày bắt đầu:" FontWeight="SemiBold" Foreground="#57606F" VerticalAlignment="Center" Margin="0,6"/>
                                    <TextBlock x:Name="txtLicStart" Grid.Row="3" Grid.Column="1" Text="-" Foreground="#2F3542" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ngày hết hạn:" FontWeight="SemiBold" Foreground="#57606F" VerticalAlignment="Center" Margin="0,6"/>
                                    <TextBlock x:Name="txtLicExpiry" Grid.Row="4" Grid.Column="1" Text="-" Foreground="#2F3542" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Mã máy (Request Code)" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <TextBlock Text="Cung cấp mã này cho QA Team để nhận file license (hoặc gia hạn):" FontSize="13" Foreground="#57606F" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtRequestCode" Grid.Column="0" Height="40" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" IsReadOnly="True" Background="#F1F2F6" Foreground="#2F3542" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Copy Mã" Width="100" Height="40" Background="#2E86DE" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnCopyRequestCode_Click"/>
                            </Grid>

                            <TextBlock Text="Quản lý" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="Kích hoạt / Gia hạn (Nạp file .lic)" Height="45" Width="250" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="14" Click="btnOpenActivationDialog_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 5: CAMERA -->
            <TabItem Header="Camera">
                <Border Background="White" CornerRadius="0,10,10,10" Padding="30" BorderBrush="#E1E8ED" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Camera tài liệu" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbDocumentCamera" Height="40" FontSize="13" Margin="0,0,0,12" SelectedIndex="0">
                                <ComboBoxItem Content="USB Camera 1 (1920x1080)"/>
                                <ComboBoxItem Content="USB Camera 2 (1280x720)"/>
                                <ComboBoxItem Content="Không sử dụng"/>
                            </ComboBox>

                            <TextBlock Text="Camera học sinh" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <ComboBox x:Name="cmbStudentCamera" Height="40" FontSize="13" Margin="0,0,0,20" SelectedIndex="1">
                                <ComboBoxItem Content="Webcam 1 (1920x1080)"/>
                                <ComboBoxItem Content="Webcam 2 (1280x720)"/>
                                <ComboBoxItem Content="Không sử dụng"/>
                            </ComboBox>

                            <TextBlock Text="Chất lượng hình ảnh" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <ComboBox x:Name="cmbImageQuality" Height="40" FontSize="13" Margin="0,0,0,20" SelectedIndex="1">
                                <ComboBoxItem Content="Thấp (720p)"/>
                                <ComboBoxItem Content="Trung bình (1080p)"/>
                                <ComboBoxItem Content="Cao (4K)"/>
                            </ComboBox>

                            <TextBlock Text="AI Features" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <CheckBox x:Name="chkFaceDetection" Content="Nhận diện khuôn mặt" FontSize="13" Margin="0,0,0,10" IsChecked="True" Checked="chkAI_Checked"/>
                            <CheckBox x:Name="chkAttendanceTracking" Content="Điểm danh tự động" FontSize="13" Margin="0,0,0,10" IsChecked="True" Checked="chkAI_Checked"/>
                            <CheckBox x:Name="chkEngagementAnalysis" Content="Phân tích mức độ tập trung" FontSize="13" Margin="0,0,0,10" Checked="chkAI_Checked"/>
                            <CheckBox x:Name="chkEmotionDetection" Content="Nhận diện cảm xúc" FontSize="13" Margin="0,0,0,20" Checked="chkAI_Checked"/>

                            <TextBlock Text="Cài đặt bảo mật" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <CheckBox x:Name="chkBlurBackground" Content="Làm mờ nền (privacy mode)" FontSize="13" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkSaveRecordings" Content="Lưu video ghi hình" FontSize="13" Margin="0,0,0,10"/>
                            <TextBlock Text="Thời gian lưu trữ:" FontSize="13" Foreground="#57606F" Margin="0,10,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txtRetentionDays" Width="80" Height="35" Text="30" FontSize="13" VerticalContentAlignment="Center" InputScope="Number" PreviewTextInput="NumericTextBox_PreviewTextInput" GotFocus="TextBox_GotFocus"/>
                                <TextBlock Text="ngày" FontSize="13" Foreground="#57606F" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Text="*(Ước lượng dung lượng: ~500 MB/ngày/camera)*" FontSize="11" FontStyle="Italic" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 6: BACKUP -->
            <TabItem Header="Sao lưu">
                <Border Background="White" CornerRadius="0,10,10,10" Padding="30" BorderBrush="#E1E8ED" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Sao lưu tự động" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,8"/>
                            <CheckBox x:Name="chkAutoBackup" Content="Kích hoạt sao lưu tự động" FontSize="13" Margin="0,0,0,12" IsChecked="True"/>
                            
                            <TextBlock Text="Tần suất sao lưu:" FontSize="13" Foreground="#57606F" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbBackupFrequency" Height="40" FontSize="13" Margin="0,0,0,20" SelectedIndex="1" IsEnabled="{Binding IsChecked, ElementName=chkAutoBackup}">
                                <ComboBoxItem Content="Hàng giờ"/>
                                <ComboBoxItem Content="Hàng ngày (2:00 AM)"/>
                                <ComboBoxItem Content="Hàng tuần (Chủ nhật)"/>
                                <ComboBoxItem Content="Hàng tháng"/>
                            </ComboBox>

                            <TextBlock Text="Vị trí sao lưu" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,8"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtBackupPath" Grid.Column="0" Height="40" FontSize="13" 
                                        Text="D:\Backups\QASmartTouch" VerticalContentAlignment="Center" Margin="0,0,10,0" GotFocus="TextBox_GotFocus"/>
                                <Button Grid.Column="1" Content="Chọn..." Width="80" Height="40" 
                                       Background="#2E86DE" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                                       Click="btnBrowseBackup_Click"/>
                                <Button x:Name="btnOpenBackupDir" Grid.Column="2" Content="📁 Mở" Width="80" Height="40" 
                                       Background="#757575" Foreground="White" BorderThickness="0" Cursor="Hand"
                                       Click="btnOpenBackupDir_Click" ToolTip="Mở thư mục sao lưu trên File Explorer"/>
                            </Grid>

                            <TextBlock Text="Lịch sử sao lưu" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,10,0,12"/>
                            <Border Background="#F8F9FA" CornerRadius="10" Padding="15" Margin="0,0,0,20" Height="250">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="spBackupHistory"/>
                                </ScrollViewer>
                            </Border>

                            <Button x:Name="btnBackupNow" Content="Sao lưu ngay" Height="45" Width="180" HorizontalAlignment="Left" 
                                   Background="#2E86DE" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="14"
                                   Click="btnBackupNow_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 7: WORKSTATION -->
            <TabItem Header="Máy trạm">
                <Border Background="White" CornerRadius="0,10,10,10" Padding="30" BorderBrush="#E1E8ED" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Định danh Máy trạm phòng LAB" FontSize="14" FontWeight="Bold" Foreground="#2F3542" Margin="0,0,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/> <!-- Spacer -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left Column -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🖥️ Cài đặt Thiết bị" FontSize="13" FontWeight="Bold" Foreground="#1E3799" Margin="0,0,0,12"/>
                                    <TextBlock Text="Mã định danh máy (Machine ID):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtMachineId" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,15" GotFocus="TextBox_GotFocus"/>
                                    
                                    <TextBlock Text="Tên hiển thị của máy (Machine Name):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtMachineName" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,15" GotFocus="TextBox_GotFocus"/>

                                    <TextBlock Text="Vai trò máy (Machine Role):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbMachineRole" Height="40" FontSize="13" Margin="0,0,0,20" SelectedIndex="0">
                                        <ComboBoxItem Content="student (Học sinh)"/>
                                        <ComboBoxItem Content="teacher (Giáo viên)"/>
                                        <ComboBoxItem Content="kiosk (Bảng tin)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Right Column -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📍 Vị trí Lớp học" FontSize="13" FontWeight="Bold" Foreground="#1E3799" Margin="0,0,0,12"/>
                                    <TextBlock Text="Mã phòng học (Room ID):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtRoomId" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,15" GotFocus="TextBox_GotFocus"/>
                                    
                                    <TextBlock Text="Vị trí ghế ngồi (Seat Position):" FontSize="13" Foreground="#57606F" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtSeatPosition" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,15" GotFocus="TextBox_GotFocus"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Toast notification ở trên cùng của Grid chính -->
        <Border x:Name="borderToast" 
                Grid.Row="1" 
                Background="#2F3542" 
                CornerRadius="20" 
                Padding="20,10" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Center" 
                Margin="0,15,0,0" 
                Visibility="Collapsed" 
                Panel.ZIndex="99" 
                Opacity="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎨 " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtToastMessage" Text="Đã cập nhật giao diện thành công!" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E1E8ED" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Button x:Name="btnResetDefaults" Content="Đặt lại mặc định" Height="40" Width="150"
                       Background="#FF5722" Foreground="White" BorderThickness="0" Cursor="Hand"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Click="btnResetDefaults_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnCancel" Content="Hủy" Height="40" Width="120" Margin="0,0,10,0"
                           Background="#F1F2F6" Foreground="#2F3542" BorderThickness="0" Cursor="Hand"
                           Click="btnCancel_Click"/>
                    <Button x:Name="btnSave" Content="Lưu cài đặt" Height="40" Width="140"
                           Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"
                           Click="btnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
