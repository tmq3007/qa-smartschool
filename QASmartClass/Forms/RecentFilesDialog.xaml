<Window x:Class="QASmartTouch.Forms.RecentFilesDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Mở bài giảng gần đây"

        Width="520" Height="560"

        WindowStartupLocation="CenterOwner"

        WindowStyle="None" AllowsTransparency="True"

        Background="Transparent"

        ResizeMode="NoResize">



    <Border Background="#FAFBFC" CornerRadius="12" BorderBrush="#E1E8ED" BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="5" Opacity="0.15"/>

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="56"/>   <!-- Header -->

                <RowDefinition Height="*"/>    <!-- File list -->

                <RowDefinition Height="56"/>   <!-- Footer -->

            </Grid.RowDefinitions>



            <!-- HEADER -->

            <Border Grid.Row="0" Background="White" CornerRadius="12,12,0,0"

                    BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">

                <Grid Margin="20,0">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Path Fill="#2E86DE" 

                              Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z"

                              Width="22" Height="22"

                              Margin="0,0,10,0" Stretch="Uniform"/>

                        <TextBlock Text="Bài giảng gần đây"

                                   FontSize="16" FontWeight="Bold" 

                                   Foreground="#2F3542"

                                   VerticalAlignment="Center"/>

                    </StackPanel>



                    <!-- Close button -->

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"

                            Width="32" Height="32" Cursor="Hand"

                            Click="btnClose_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="#F1F2F6" CornerRadius="8">

                                    <Path Fill="#57606F"

                                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                                          Width="12" Height="12" Stretch="Uniform"

                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>

            </Border>



            <!-- FILE LIST -->

            <Grid Grid.Row="1" Margin="12,8,12,0">

                <!-- Empty state -->

                <StackPanel x:Name="EmptyState" 

                            HorizontalAlignment="Center" VerticalAlignment="Center"

                            Visibility="Collapsed">

                    <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Chưa có bài giảng nào" 

                               FontSize="14" Foreground="#8E9AAF" HorizontalAlignment="Center"/>

                    <TextBlock Text="Bắt đầu tạo bài giảng mới ngay!" 

                               FontSize="12" Foreground="#B0B8C4" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                </StackPanel>



                <!-- File list -->

                <ListBox x:Name="FileList" 

                         Background="Transparent" BorderThickness="0"

                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                         MouseDoubleClick="FileList_MouseDoubleClick"

                         SelectionChanged="FileList_SelectionChanged">

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Padding" Value="12,10"/>

                            <Setter Property="Margin" Value="0,2"/>

                            <Setter Property="Cursor" Value="Hand"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border x:Name="ItemBorder" 

                                                Background="White" 

                                                CornerRadius="8" 

                                                Padding="{TemplateBinding Padding}"

                                                BorderBrush="Transparent" BorderThickness="1">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F7FF"/>

                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#BDD8F3"/>

                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">

                                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3F2FD"/>

                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2E86DE"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListBox.ItemContainerStyle>



                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="36"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="28"/>

                                </Grid.ColumnDefinitions>



                                <!-- File icon -->

                                <TextBlock Grid.Column="0" Text="{Binding Icon}" 

                                           FontSize="22" VerticalAlignment="Center"/>



                                <!-- File info -->

                                <StackPanel Grid.Column="1" Margin="4,0,8,0">

                                    <TextBlock Text="{Binding DisplayName}" 

                                               FontSize="13" FontWeight="SemiBold"

                                               Foreground="#2F3542" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding FilePath}" 

                                               FontSize="10.5" Foreground="#8E9AAF"

                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                                </StackPanel>



                                <!-- Time ago -->

                                <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" 

                                           FontSize="11" Foreground="#B0B8C4"

                                           VerticalAlignment="Center" Margin="0,0,8,0"/>



                                <!-- Remove button -->

                                <Button Grid.Column="3" Width="24" Height="24"

                                        Click="btnRemoveFile_Click" 

                                        Tag="{Binding FilePath}"

                                        Cursor="Hand" ToolTip="Xóa khỏi danh sách">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="RemoveBorder" Background="Transparent" 

                                                    CornerRadius="4" Opacity="0.4">

                                                <Path Fill="#EE5A6F"

                                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"

                                                      Width="10" Height="10" Stretch="Uniform"

                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="RemoveBorder" Property="Opacity" Value="1"/>

                                                    <Setter TargetName="RemoveBorder" Property="Background" Value="#FFF0F0"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>



            <!-- FOOTER -->

            <Border Grid.Row="2" Background="White" CornerRadius="0,0,12,12"

                    BorderBrush="#E1E8ED" BorderThickness="0,1,0,0">

                <Grid Margin="16,0">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                        <Button x:Name="btnClearAll" Content="🗑 Xóa tất cả"

                                Background="Transparent" Foreground="#EE5A6F"

                                BorderThickness="0" FontSize="12" Cursor="Hand"

                                Click="btnClearAll_Click" Padding="8,4"/>

                    </StackPanel>



                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <Button x:Name="btnOpenSelected" Content="Mở file ▸"

                                Foreground="White" BorderThickness="0"

                                FontSize="13" FontWeight="SemiBold" 

                                Cursor="Hand" Click="btnOpenSelected_Click"

                                Padding="16,7" IsEnabled="False">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="OpenBorder"

                                            Background="{TemplateBinding Background}" 

                                            CornerRadius="8" Padding="{TemplateBinding Padding}">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsEnabled" Value="True">

                                            <Setter TargetName="OpenBorder" Property="Background" Value="#2E86DE"/>

                                        </Trigger>

                                        <Trigger Property="IsEnabled" Value="False">

                                            <Setter TargetName="OpenBorder" Property="Background" Value="#C8D6E5"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

